{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    ".astro/**",
    "dist-test/**",
    "dist/**",
    "packages/opui/dist/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/opui/env.d.ts",
        "packages/opui/react/elements.ts",
        "packages/opui/solid/elements.ts",
        "packages/opui/svelte/elements.ts",
        "src/env.d.ts",
        "tests/e2e/css-js.spec.ts"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["packages/opui/solid/elements.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["**/*.solid.tsx", "tests/apps/vite-solid/**/*.tsx"],
      "rules": {
        "react/error-boundaries": "off",
        "react/exhaustive-deps": "off",
        "react/globals": "off",
        "react/immutability": "off",
        "react/incompatible-library": "off",
        "react/jsx-key": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/set-state-in-render": "off",
        "react/static-components": "off",
        "react/use-memo": "off",
        "react/void-use-memo": "off"
      }
    }
  ],
  "plugins": ["oxc", "react", "typescript", "unicorn", "vue"],
  "rules": {
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-inferrable-types": "error"
  }
}
