{
  "name": "open-props-ui-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm build-components && pnpm build-examples && pnpm build-search-index && pnpm build-readme && astro build && pnpm build-skill && pnpm check-dist",
    "build-components": "node scripts/build-components.mjs",
    "build-examples": "node scripts/build-examples.mjs",
    "build-readme": "node scripts/build-readme.mjs",
    "build-search-index": "node scripts/generate-search-index.mjs",
    "build-skill": "node scripts/build-agent-skill.mjs",
    "check": "export OPUI_TEST_PAGES=1 && pnpm check:fast && pnpm build && pnpm test:package",
    "check:fast": "pnpm run --no-bail \"/^(check-(browser-support|characters|colors|components|css-vars|examples|ports)|format:check|lint|sort-css:check|test|typecheck)$/\"",
    "check-browser-support": "node scripts/check-browser-support.mjs",
    "check-components": "node scripts/check-components.mjs",
    "check-characters": "node scripts/check-characters.mjs",
    "check-colors": "node scripts/check-colors.mjs",
    "check-css-vars": "node scripts/check-css-vars.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "check-examples": "node scripts/build-examples.mjs --check",
    "check-ports": "node scripts/build-components.mjs --check",
    "dev": "astro dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings . && stylelint \"packages/opui/**/*.css\" \"src/**/*.css\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "astro preview",
    "sort-css": "node scripts/sort-css.mjs",
    "sort-css:check": "node scripts/sort-css.mjs --check",
    "test": "vitest run",
    "test:apps": "node tests/apps/prepare.ts && playwright test -c tests/apps",
    "test:e2e": "playwright test",
    "test:e2e:build": "OPUI_TEST_PAGES=1 astro build --outDir dist-test",
    "test:e2e:preview": "ASTRO_PREVIEW_BACKGROUND=1 astro preview --outDir dist-test --port 4322 --ignore-lock",
    "test:e2e:record-a11y": "A11Y_RECORD=1 playwright test a11y --project=light --project=dark --workers=1",
    "test:e2e:serve": "pnpm test:e2e:build && pnpm test:e2e:preview",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:failed": "vitest run --lastFailed --passWithNoTests",
    "test:package": "vitest run --config vitest.package.config.ts",
    "test:record-drift": "PARITY_RECORD=1 vitest run -u -t 'matches (astro|html)$'",
    "test:record-released": "RELEASED_RECORD=1 vitest run tests/unit/released-tokens.test.ts",
    "test:update": "vitest run --update",
    "typecheck": "astro sync && pnpm run --no-bail \"/^typecheck:/\"",
    "typecheck:astro": "astro check --noSync --minimumFailingSeverity warning",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "catalog:",
    "baseline-status": "^1.2.0",
    "globby": "^16.2.4",
    "microlighter": "^2.2.0",
    "minisearch": "^7.2.0",
    "open-props": "catalog:",
    "opui-css": "workspace:*",
    "typescript": "^6.0.3",
    "web-features": "catalog:"
  },
  "devDependencies": {
    "@astrojs/compiler": "^2.13.1",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@astrojs/vue": "^7.1.2",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "css-declaration-sorter": "^7.4.0",
    "diff": "^9.0.0",
    "hast-util-select": "^6.0.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "parse5": "^8.1.0",
    "postcss": "^8.5.32",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "stylelint": "^17.16.0",
    "svelte": "catalog:",
    "svelte-check": "^4.7.8",
    "unified": "^11.0.5",
    "vitest": "^5.1.0",
    "vue": "catalog:",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.9.1"
}
