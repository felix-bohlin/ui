{
  "name": "open-props-ui-docs",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "astro": "astro",
    "build": "pnpm build-search-index && pnpm check-browser-support && astro build",
    "build-search-index": "node scripts/generate-search-index.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check-components && pnpm typecheck && pnpm test && pnpm build",
    "check-browser-support": "node scripts/check-browser-support.mjs",
    "check-components": "node scripts/check-components.mjs",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings . && stylelint \"packages/opui/**/*.css\"",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:record-a11y": "A11Y_RECORD=1 playwright test a11y --project=light --workers=1",
    "test:e2e:serve": "OPUI_TEST_PAGES=1 astro build --outDir dist-test && astro preview --outDir dist-test --port 4322",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:record-drift": "PARITY_RECORD=1 vitest run",
    "test:update": "vitest run --update",
    "typecheck": "astro check && vue-tsc --noEmit -p tsconfig.vue.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "catalog:",
    "astro-expressive-code": "^0.44.0",
    "baseline-status": "^1.1.1",
    "globby": "^16.2.0",
    "highlight.js": "^11.11.1",
    "minisearch": "^7.2.0",
    "open-props": "catalog:",
    "opui-css": "workspace:*",
    "typescript": "^6.0.3",
    "web-features": "^3.30.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "^3.0.0-next.35",
    "@solidjs/web": "catalog:",
    "oxlint": "^1.85.0",
    "parse5": "^8.0.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "solid-js": "catalog:",
    "stylelint": "^17.15.0",
    "vitest": "^5.0.2",
    "vue": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
