---
import type { Props } from "./types.astro"

export const title = "Accordion"

const {
  class: className,
  markerAnimation = "rotate",
  variant,
  ...rest
} = Astro.props
---

<details
  class:list={[
    "ui-accordion",
    "ui-card",
    markerAnimation && `ui-marker-${markerAnimation}`,
    variant && `ui-${variant}`,
    className,
  ]}
  {...rest}
>
  <slot />
</details>
