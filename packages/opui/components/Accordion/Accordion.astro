---
import type { Props } from "./types.astro"

export const title = "Accordion"

const { class: className, markerAnimation, variant, ...rest } = Astro.props
---

<details
  class:list={[
    "ui-accordion",
    markerAnimation &&
      markerAnimation !== "rotate" &&
      `ui-marker-animation-${markerAnimation}`,
    variant && variant !== "plain" && `ui-${variant}`,
    className,
  ]}
  {...rest}
>
  <slot />
</details>
