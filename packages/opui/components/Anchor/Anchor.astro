---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Anchor"

const {
  alignment,
  class: className,
  id: idProp,
  style,
  trigger = "always",
  ...rest
} = Astro.props

const isHover = trigger === "hover"
const id = isHover ? (idProp ?? createId(Astro.locals)("anchor")) : undefined

const insetMap: Record<string, string> = {
  "start start": "auto 100% 100% auto",
  "start end": "auto auto 100% 100%",
  "end start": "100% 100% auto auto",
  "end end": "100% auto auto 100%",
}

const positionArea = alignment
  ? {
      "--anchor-position-area": alignment,
      "--_anchor-inset": insetMap[alignment],
    }
  : undefined
const positionAreaString = Object.entries(positionArea ?? {})
  .filter(([, value]) => value !== undefined)
  .map(([name, value]) => `${name}: ${value};`)
  .join(" ")
const mergedStyle =
  typeof style === "string" || !style
    ? `${positionAreaString}${style ?? ""}` || undefined
    : { ...positionArea, ...style }
---

<span class:list={["ui-anchor", className]} style={mergedStyle} {...rest}>
  <slot />
  <span
    class="ui-anchor-floating"
    id={id}
    popover={isHover ? "hint" : undefined}
  >
    <slot name="anchored" />
  </span>
</span>
