---
import type { Props } from "./types.astro"
import { anchorContext } from "./context.astro"
import { mergeStyle } from "../style"

export const title = "Anchor"

const {
  class: className,
  id: idProp,
  positionArea,
  style,
  trigger,
  ...rest
} = Astro.props

const isHover = trigger === "hover"
const id = isHover ? (idProp ?? undefined) : undefined
const html = await anchorContext.provide(
  { floatingId: id, popover: isHover ? "hint" : undefined },
  () => Astro.slots.render("default"),
)
---

<span
  class:list={["ui-anchor", className]}
  id={isHover ? undefined : idProp}
  style={mergeStyle({ "--ui-anchor-position-area": positionArea }, style)}
  {...rest}
>
  <Fragment set:html={html} />
</span>
