---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Anchor"

const {
  alignment,
  class: className,
  id: idProp,
  style,
  trigger = "always",
  ...rest
} = Astro.props

const isHover = trigger === "hover"
const id = isHover ? (idProp ?? createId(Astro.locals)("anchor")) : undefined

const positionArea = alignment
  ? { "--anchor-position-area": alignment }
  : undefined
const positionAreaString = Object.entries(positionArea ?? {})
  .filter(([, value]) => value !== undefined)
  .map(([name, value]) => `${name}: ${value};`)
  .join(" ")
const mergedStyle =
  typeof style === "string" || !style
    ? `${positionAreaString}${style ?? ""}` || undefined
    : { ...positionArea, ...style }
---

<span
  class:list={["ui-anchor", className]}
  id={isHover ? undefined : idProp}
  style={mergedStyle}
  {...rest}
>
  <slot />
  <span
    class="ui-anchor-floating"
    id={id}
    popover={isHover ? "hint" : undefined}
  >
    <slot name="anchored" />
  </span>
</span>
