{% macro Avatar(props = {}) %}
  {%- set rest = props | opuiRest("Avatar") -%}
  {%- set tag = "a"
    if opui.disabledLink(props.as, props.disabled)
    else props.as
    or ("a" if props.href else "div") -%}
  {{- opui.warnUnnamedControl("Avatar", props.as == "button" or props.href, opui.merge(rest, { label: props.label })) -}}
  {%- set classes = [
    "ui-avatar",
    props.shape and props.shape != "circle" and "ui-" ~ props.shape,
    props.size and props.size != "medium" and "ui-" ~ props.size,
    props.variant and props.variant != "filled" and "ui-" ~ props.variant,
    props.class
  ] | opuiClass -%}
  <{{ tag | opuiTag }}{{ opui.merge(
    { class: classes },
    opui.tagAttrs(tag, props.disabled, props.href),
    opui.defined(rest)
  ) | opuiAttributes(tag) }}>
    {%- if props.src %}{% set alt = props.label if props.label != none else '' %}<img
      {%- if props.src != none %} src="{{ props.src }}"{% endif %}
      alt="{{ alt }}">{% else %}<span aria-hidden="true">{{ caller() if caller }}</span>{% endif %}
    {%- if not props.src and props.label %}<span class="ui-sr-only">
      {{- props.label }}</span>{% endif -%}
  </{{ tag | opuiTag }}>
{%- endmacro %}
