{% macro AvatarGroup(props = {}) %}
  {%- set props = props | opuiProps("AvatarGroup") -%}
  {%- set rest = props | opuiRest("AvatarGroup") -%}
  {%- set role = props.role | default('group') -%}
  <div
    class="ui-avatar-group
      {%- if props.class %} {{ props.class }}{% endif %}"
    role="{{ role }}"
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </div>
{%- endmacro %}
