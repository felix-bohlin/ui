---
import type { Props } from "./types.astro"

import Anchor from "../Anchor/Anchor.astro"
import AnchorContent from "../Anchor/AnchorContent.astro"
import { trimEdges } from "../whitespace"

export const title = "Badge"

const {
  class: className,
  color,
  corner,
  dot,
  hideLabel,
  invisible,
  label,
  ...rest
} = Astro.props

const hidden = dot || hideLabel
const indicatorSlot = Astro.slots.has("indicator")
  ? trimEdges(await Astro.slots.render("indicator"))
  : ""
---

<Anchor
  class:list={[
    "ui-badge",
    {
      "ui-dot": dot,
      "ui-invisible": invisible,
    },
    color && `ui-${color}`,
    corner && corner !== "start-end" && `ui-${corner}`,
    className,
  ]}
  {...rest}
>
  <slot />
  <AnchorContent>
    <span class="ui-indicator"
      >{
        hidden && (
          <>
            {!dot && indicatorSlot && (
              <span aria-hidden="true" set:html={indicatorSlot} />
            )}
            {label && <span class="ui-sr-only">{label}</span>}
          </>
        )
      }{hidden ? undefined : label}<Fragment
        set:html={hidden ? "" : indicatorSlot}
      /></span
    >
  </AnchorContent>
</Anchor>
