---
import type { Props } from "./types.astro"

import Anchor from "../Anchor/Anchor.astro"

export const title = "Badge"

const {
  alignment,
  class: className,
  color,
  dot,
  invisible,
  label,
  srLabel,
  ...rest
} = Astro.props
---

<Anchor
  class:list={[
    "ui-badge",
    {
      "ui-dot": dot,
      "ui-invisible": invisible,
    },
    alignment && `ui-${alignment}`,
    color && `ui-${color}`,
    className,
  ]}
  {...rest as any}
>
  <slot />
  <span class="ui-badge-indicator" slot="anchored">
    {dot ? "" : label}
    {!dot && <slot name="indicator" />}
    {srLabel && <span class="ui-sr-only">{srLabel}</span>}
  </span>
</Anchor>
