---
import type { Props } from "./types.astro"

import Anchor from "../Anchor/Anchor.astro"
import AnchorContent from "../Anchor/AnchorContent.astro"

export const title = "Badge"

const {
  class: className,
  color,
  corner,
  dot,
  hideLabel,
  invisible,
  label,
  ...rest
} = Astro.props
---

<Anchor
  class:list={[
    "ui-badge",
    {
      "ui-dot": dot,
      "ui-invisible": invisible,
    },
    color && `ui-${color}`,
    corner && corner !== "start-end" && `ui-${corner}`,
    className,
  ]}
  {...rest}
>
  <slot />
  <AnchorContent>
    <span class="ui-indicator">
      {
        dot || hideLabel ? (
          <>
            {!dot && Astro.slots.has("indicator") && (
              <span aria-hidden="true">
                <slot name="indicator" />
              </span>
            )}
            {label && <span class="ui-sr-only">{label}</span>}
          </>
        ) : (
          <>
            {label}
            <slot name="indicator" />
          </>
        )
      }
    </span>
  </AnchorContent>
</Anchor>
