---
import type { Props } from "./types.astro"
import { mergeStyle } from "../style"

export const title = "Bar Chart"

const {
  caption,
  class: className,
  focusable,
  format = String,
  label,
  max,
  min,
  rows,
  series,
  size,
  style,
  ...rest
} = Astro.props

const values = rows?.flatMap((row) => row.values) ?? []
const chartMax = max ?? (values.length > 0 ? Math.max(0, ...values) : undefined)
const chartMin = min ?? Math.min(0, ...values)
const cellFocusable = focusable ?? (series?.length ?? 0) > 1
---

<table
  class:list={["ui-bar-chart", size && `ui-${size}`, className]}
  style={mergeStyle(
    { "--max": chartMax, "--min": chartMin !== 0 ? chartMin : undefined },
    style,
  )}
  {...rest}
>
  {caption && <caption>{caption}</caption>}
  {
    series && series.length > 0 && (
      <thead>
        <tr>
          {label ? <th scope="col">{label}</th> : <td />}
          {series.map((name) => (
            <th scope="col">{name}</th>
          ))}
        </tr>
      </thead>
    )
  }
  {
    rows && rows.length > 0 && (
      <tbody>
        {rows.map((row) => (
          <tr class:list={[row.color && `ui-${row.color}`]}>
            <th scope="row">{row.label}</th>
            {row.values.map((value) => (
              <td
                style={`--value: ${value}`}
                tabindex={cellFocusable ? 0 : undefined}
              >
                {format(value)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    )
  }
  <slot />
</table>
