---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
import { tagAttrs } from "../tag"

export const title = "Button"

const {
  as,
  class: className,
  color,
  disabled,
  href,
  iconOnly: _iconOnly,
  round,
  size,
  variant,
  ...rest
} = Astro.props

const Tag = as || (href ? "a" : "button")
---

<Tag
  class:list={[
    "ui-button",
    { "ui-round": round },
    size && `ui-${size}`,
    variant && `ui-${variant}`,
    color && `ui-${color}`,
    className,
  ]}
  {...tagAttrs(Tag, disabled, href)}
  {...rest as HTMLAttributes<"button">}
>
  <slot />
</Tag>
