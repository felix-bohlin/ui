---
import type { Props } from "./types.astro"

export const title = "Button"

const props = Astro.props as Props
const {
  as,
  class: className,
  color,
  ripple,
  rounded,
  size,
  variant,
  disabled,
  href,
  label,
  ...rest
} = props

const Tag = (as || (href ? "a" : "button")) as any
const isButton = Tag === "button"
---

<Tag
  class:list={[
    "ui-button",
    {
      "ui-ripple": ripple,
      "ui-rounded": rounded,
    },
    size && `ui-${size}`,
    variant && `ui-${variant}`,
    color && `ui-${color}`,
    className,
  ]}
  aria-disabled={!isButton && disabled ? "true" : undefined}
  aria-label={label}
  disabled={isButton ? disabled : undefined}
  href={href}
  type={isButton ? "button" : undefined}
  {...rest as any}
>
  <slot />
</Tag>
