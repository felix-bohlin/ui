---
import type { Props } from "./types.astro"

export const title = "Button Group"

const {
  class: className,
  color,
  orientation,
  scrollable,
  shrink,
  size,
  variant,
  ...rest
} = Astro.props
---

<div
  class:list={[
    "ui-button-group",
    color && `ui-${color}`,
    size && `ui-${size}`,
    variant && `ui-${variant}`,
    orientation && `ui-${orientation}`,
    { "ui-scrollable": scrollable, "ui-shrink": shrink },
    className,
  ]}
  role="group"
  {...rest}
>
  <slot />
</div>
