---
import type { Props } from "./types.astro"
import { mergeStyle } from "../style"

export const title = "Carousel"

const {
  align,
  aspectRatio,
  buttons,
  class: className,
  itemsPerView,
  markers,
  orientation,
  peek,
  persistentButtons,
  stretch,
  style,
  ...rest
} = Astro.props
---

<ul
  class:list={[
    "ui-carousel",
    {
      "ui-persistent-buttons": persistentButtons,
      "ui-peek": peek,
      "ui-stretch": stretch,
      "ui-vertical": orientation === "vertical",
      "ui-markers": markers,
    },
    align && align !== "start" && `ui-align-${align}`,
    buttons && buttons !== "inside" && `ui-buttons-${buttons}`,
    className,
  ]}
  style={mergeStyle(
    { "--_items-per-view": itemsPerView, "--_media-aspect-ratio": aspectRatio },
    style,
  )}
  {...rest}
>
  <slot />
</ul>
