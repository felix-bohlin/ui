{% macro Carousel(props = {}) %}
  {%- set rest = props | opuiRest("Carousel") -%}
  {%- set role = props.role if props.role != none else 'list' -%}
  <ul
    class="ui-carousel
      {%- if props.markers %} ui-markers{% endif %}
      {%- if props.peek %} ui-peek{% endif %}
      {%- if props.persistentButtons %} ui-persistent-buttons{% endif %}
      {%- if props.stretch %} ui-stretch{% endif %}
      {%- if props.orientation == 'vertical' %} ui-vertical{% endif %}
      {%- if props.align and props.align != 'start' %} ui-align-{{ props.align }}{% endif %}
      {%- if props.buttons and props.buttons != 'inside' %} ui-buttons-{{ props.buttons }}{% endif %}
      {%- if props.class %} {{ props.class }}{% endif %}"
    {{- { style: opui.mergeStyle({ "--_button-next-label": props.nextLabel and opui.cssString(props.nextLabel), "--_button-previous-label": props.previousLabel and opui.cssString(props.previousLabel), "--_items-per-view": props.itemsPerView, "--_marker-label": props.markerLabel and opui.counterLabel(props.markerLabel, 'ui-carousel-item'), "--_media-aspect-ratio": props.aspectRatio }, props.style) } | opuiAttributes }}
    role="{{ role }}"
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </ul>
{%- endmacro %}
