---
import type { CheckboxProps as Props } from "./types.astro"
import { renderFieldRoot } from "../Field/root.astro"

export const title = "Checkbox"

const { class: className, error, size, spread, stack, ...rest } = Astro.props

const { html, parts } = await renderFieldRoot(
  Astro.locals,
  () => Astro.slots.render("default"),
  error,
)

if (
  import.meta.env.DEV &&
  !parts.has("label") &&
  !/\saria-label(?:ledby)?=/.test(html)
) {
  console.warn(
    "[OPUI Checkbox] Missing accessible name. Add a CheckboxLabel, and set `visuallyHidden` to hide it visually.",
  )
}
---

<label
  class:list={[
    "ui-checkbox",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
      "ui-spread": spread,
    },
    className,
  ]}
  {...rest}
>
  <Fragment set:html={html} />
</label>
