---
import type { CheckboxProps as Props } from "./types.astro"
import CheckboxInput from "./CheckboxInput.astro"
import { FieldLabel, FieldEndText } from "@opui/astro"

export const title = "Checkbox"

const {
  class: className,
  error,
  hideLabel,
  size,
  spread,
  stack,
  ...inputProps
} = Astro.props

const { $id, currentFieldName } = Astro.locals
const endTextId = Astro.slots.has("end-text") ? $id("end-text") : undefined

const finalName = inputProps.name || currentFieldName
---

<label
  class:list={[
    "ui-checkbox",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
      "ui-spread": spread,
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  <CheckboxInput
    aria-describedby={endTextId}
    name={finalName}
    {...inputProps}
  />

  {
    Astro.slots.has("default") && (
      <FieldLabel hideLabel={hideLabel}>
        <slot />
      </FieldLabel>
    )
  }

  {
    Astro.slots.has("end-text") && (
      <FieldEndText id={endTextId}>
        <slot name="end-text" />
      </FieldEndText>
    )
  }
</label>
