---
import type { CheckboxProps as Props } from "./types.astro"
import CheckboxInput from "./CheckboxInput.astro"

export const title = "Checkbox"

const {
  class: className,
  error,
  hideLabel,
  name,
  size,
  spread,
  stack,
  ...rest
} = Astro.props

const { $id } = Astro.locals
const endTextId = Astro.slots.has("end-text") ? $id("end-text") : undefined
---

<label
  class:list={[
    "ui-checkbox",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
      "ui-spread": spread,
    },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  <CheckboxInput
    aria-describedby={endTextId}
    aria-invalid={error ? "true" : undefined}
    name={name}
    {...rest}
  />
  <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}><slot /></span>
  {
    Astro.slots.has("end-text") && (
      <span id={endTextId} class="ui-end-text">
        <slot name="end-text" />
      </span>
    )
  }
</label>
