---
import type { Props } from "./types.astro"
import { warnUnnamed } from "../dev"
import CheckboxInput from "./CheckboxInput.astro"

export const title = "Checkbox"

const {
  "aria-invalid": ariaInvalid,
  card,
  class: className,
  endText,
  error,
  hideLabel,
  label,
  orientation,
  size,
  spread,
  variant,
  style,
  ...rest
} = Astro.props

warnUnnamed(
  "Checkbox",
  label ||
    Astro.slots.has("default") ||
    Astro.props["aria-label"] ||
    Astro.props["aria-labelledby"],
)
---

<label
  class:list={[
    "ui-checkbox",
    {
      "ui-card": card,
      "ui-spread": spread,
    },
    card && variant && variant !== "outlined" && `ui-${variant}`,
    orientation && orientation !== "horizontal" && `ui-${orientation}`,
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <CheckboxInput {...rest} aria-invalid={error ? "true" : ariaInvalid} />
  {
    (label || Astro.slots.has("default")) && (
      <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}>
        {label}
        <slot />
      </span>
    )
  }
  {
    (endText || Astro.slots.has("end-text")) && (
      <span class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
