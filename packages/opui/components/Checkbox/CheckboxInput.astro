---
import type { CheckboxInputProps as Props } from "./types.astro"
import { fieldContext } from "../Field/context.astro"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  indeterminate,
  ...rest
} = Astro.props as Props

const field = fieldContext.get()
const describedBy =
  [field?.describedByToken, ariaDescribedBy].filter(Boolean).join(" ") ||
  undefined
---

<input
  type="checkbox"
  aria-describedby={describedBy}
  aria-invalid={field?.invalid ? "true" : ariaInvalid}
  data-indeterminate={indeterminate ? "" : undefined}
  {...rest}
/>

<script>
  import { initCheckbox } from "../../css/js/checkbox.js"
  initCheckbox()
</script>
