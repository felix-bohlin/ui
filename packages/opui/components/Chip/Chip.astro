---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
import { tagAttrs } from "../tag"

export const title = "Chip"

const {
  as,
  class: className,
  disabled,
  dot,
  href,
  label,
  multiline,
  severity,
  size,
  variant = "tonal",
  ...rest
} = Astro.props

const Tag = as || (href ? "a" : "div")
---

<Tag
  class:list={[
    "ui-chip",
    {
      "ui-dot": dot,
      "ui-multiline": multiline,
    },
    severity && `ui-${severity}`,
    size && `ui-${size}`,
    variant && `ui-${variant}`,
    className,
  ]}
  {...tagAttrs(Tag, disabled, href)}
  {...rest as HTMLAttributes<"button">}
  ><slot name="start" /><slot />{
    label && <span class="ui-text">{label}</span>
  }<slot name="end" /></Tag
>
