---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
import { tagAttrs } from "../tag"
import { cx } from "../cx"

export const title = "Chip"

const {
  as,
  class: className,
  disabled,
  dot,
  href,
  label,
  multiline,
  severity,
  size,
  variant = "tonal",
  ...rest
} = Astro.props

const Tag = as || (href ? "a" : "div")
---

<Tag
  class={cx([
    "ui-chip",
    {
      "ui-dot": dot,
      "ui-multiline": multiline,
    },
    severity && `ui-${severity}`,
    size && size !== "medium" && `ui-${size}`,
    variant !== "tonal" && `ui-${variant}`,
    className,
  ])}
  {...tagAttrs(Tag, disabled, href)}
  {...rest as HTMLAttributes<"button">}
  ><slot name="start" />{
    (label || Astro.slots.has("label")) && (
      <span class="ui-text">
        {label}
        <slot name="label" />
      </span>
    )
  }<slot name="end" /></Tag
>
