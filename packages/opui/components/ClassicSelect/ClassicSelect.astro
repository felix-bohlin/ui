---
import type { ClassicSelectProps as Props } from "./types.astro"
import { createId } from "../id"

export const title = "Classic Select"

const {
  class: className,
  disabled,
  error,
  id,
  items = [],
  label,
  name,
  required,
  size,
  endText,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const selectId = id || $id("select")
const labelId = $id("select-label")
const endTextId = endText ? $id("end-text") : undefined
---

<label
  class:list={[
    "ui-select",
    size && `ui-${size}`,
    {
      "ui-filled": variant === "filled",
    },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  {
    label && (
      <span class="ui-label" id={labelId}>
        {label}
      </span>
    )
  }
  <span class="ui-field">
    <select
      aria-describedby={endTextId}
      aria-invalid={error ? "true" : undefined}
      aria-labelledby={label || Astro.slots.has("label") ? labelId : undefined}
      disabled={disabled}
      id={selectId}
      name={name}
      required={required}
      {...rest}
    >
      {
        items.map((item) => (
          <option
            selected={item.value === value || undefined}
            value={item.value}
          >
            {item.text}
          </option>
        ))
      }
      <slot />
    </select>
  </span>
  {
    endText && (
      <span class="ui-end-text" id={endTextId}>
        {endText}
      </span>
    )
  }
</label>
