---
import type { ClassicSelectProps as Props } from "./types.astro"
import { FieldLabel, FieldEndText } from "@opui/astro"

export const title = "Classic Select"

const {
  class: className,
  error,
  items = [],
  label,
  size,
  endText,
  variant = "outlined",
  ...inputProps
} = Astro.props

const { $id } = Astro.locals
const selectId = inputProps.id || $id("select")
const labelId = $id("select-label")
---

<label
  class:list={[
    "ui-select",
    size && `ui-${size}`,
    {
      "ui-filled": variant === "filled",
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  {
    (label || Astro.slots.has("label")) && (
      <FieldLabel label={label} id={labelId}>
        <slot name="label" />
      </FieldLabel>
    )
  }
  <span class="ui-field">
    <select
      aria-labelledby={label ? labelId : undefined}
      id={selectId}
      {...inputProps}
    >
      {items.map((item) => <option value={item.value}>{item.text}</option>)}
      <slot />
    </select>
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <FieldEndText text={endText}>
        <slot name="end-text" />
      </FieldEndText>
    )
  }
</label>
