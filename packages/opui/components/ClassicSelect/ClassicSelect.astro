---
import type { ClassicSelectProps as Props } from "./types.astro"
import { createId } from "../id"
import { fieldContext } from "../FieldGroup/context.astro"

export const title = "Classic Select"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  class: className,
  disabled,
  error,
  id,
  items = [],
  label,
  name,
  required,
  size,
  endText,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const field = fieldContext.get()
const $id = createId(Astro.locals)
const selectId = id || $id("select")
const endTextId = endText ? $id("end-text") : undefined
const describedBy =
  [endTextId, ariaDescribedBy].filter(Boolean).join(" ") || undefined
---

<label
  class:list={[
    "ui-select",
    size && `ui-${size}`,
    {
      "ui-filled": variant === "filled",
    },
    className,
  ]}
>
  {label && <span class="ui-label">{label}</span>}
  <span class="ui-field">
    <select
      {...rest}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : ariaInvalid}
      disabled={disabled}
      id={selectId}
      name={name ?? field?.name}
      required={required}
    >
      {
        items.map((item) => (
          <option
            selected={item.value === value || undefined}
            value={item.value}
          >
            {item.text}
          </option>
        ))
      }
      <slot />
    </select>
  </span>
  {
    endText && (
      <span class="ui-end-text" id={endTextId}>
        {endText}
      </span>
    )
  }
</label>
