---
import Button from "../Button/Button.astro"

import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { createId } from "../id"
import { channelsFor, COLOR_SPACES } from "./channels"
import { copyPath, eyedropperPath } from "./icons"

export const title = "Color Field"

const {
  "aria-invalid": ariaInvalid,
  autoFit,
  blacknessLabel,
  blueLabel,
  chromaLabel,
  class: className,
  colorSpaceLabel = "Color space",
  contrastLabel,
  copiedLabel,
  copyLabel = "Copy",
  endText,
  error,
  eyedropperLabel = "Pick from the screen",
  greenLabel,
  hideLabel,
  hueLabel,
  id,
  invalidText,
  label,
  lightnessLabel,
  name,
  opacity,
  opacityLabel,
  p3Text,
  pickerLabel = "Pick a color",
  redLabel,
  saturationLabel,
  size,
  spread,
  srgbText,
  startText,
  style,
  swatchOnly,
  variant,
  whitenessLabel,
  wideText,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const $id = createId(Astro.locals)
const inputId = id ?? $id("color-field")
---

<opui-color-field
  blackness-label={blacknessLabel}
  blue-label={blueLabel}
  chroma-label={chromaLabel}
  class:list={["ui-color-field", { "ui-swatch-only": swatchOnly }, className]}
  contrast-label={contrastLabel}
  copied-label={copiedLabel}
  green-label={greenLabel}
  hue-label={hueLabel}
  invalid-text={invalidText}
  lightness-label={lightnessLabel}
  p3-text={p3Text}
  red-label={redLabel}
  saturation-label={saturationLabel}
  srgb-text={srgbText}
  style={style}
  whiteness-label={whitenessLabel}
  wide-text={wideText}
>
  {
    swatchOnly ? (
      <Button
        aria-describedby={rest["aria-describedby"]}
        aria-labelledby={`${inputId}-label`}
        command="toggle-popover"
        commandfor={`${inputId}-picker`}
        round
        size={size}
      >
        <span class="ui-indicator" />
      </Button>
    ) : (
      <div
        class:list={[
          "ui-text-field",
          {
            "ui-auto-fit": autoFit,
            "ui-filled": variant === "filled",
            "ui-spread": spread,
          },
          size && size !== "medium" && `ui-${size}`,
        ]}
      >
        {(label || Astro.slots.has("label")) && (
          <label
            class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}
            for={inputId}
            id={`${inputId}-label`}
          >
            {label}
            <slot name="label" />
          </label>
        )}
        {(startText || Astro.slots.has("start-text")) && (
          <span class="ui-start-text">
            {startText}
            <slot name="start-text" />
          </span>
        )}
        <span class="ui-field">
          <span class="ui-start">
            <Button
              aria-label={pickerLabel}
              command="toggle-popover"
              commandfor={`${inputId}-picker`}
              round
            >
              <span class="ui-indicator" />
            </Button>
          </span>
          <input
            autocomplete="off"
            spellcheck="false"
            {...rest}
            aria-invalid={error ? "true" : ariaInvalid}
            id={inputId}
            name={name ?? field?.name}
            type="text"
          />
        </span>
        {(endText || Astro.slots.has("end-text")) && (
          <span class="ui-end-text">
            {endText}
            <slot name="end-text" />
          </span>
        )}
      </div>
    )
  }
  <div
    aria-labelledby={`${inputId}-label`}
    class="ui-floating"
    id={`${inputId}-picker`}
    popover="auto"
    role="dialog"
  >
    <div class="ui-header">
      <span aria-hidden="true" class="ui-value"></span>
      <span class="ui-actions">
        <Button
          aria-label={eyedropperLabel}
          command="--eyedropper"
          commandfor={inputId}
          hidden
          round
          size="small"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path fill="currentColor" d={eyedropperPath}></path>
          </svg>
        </Button>
        <Button
          aria-label={copyLabel}
          command="--copy"
          commandfor={inputId}
          round
          size="small"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path fill="currentColor" d={copyPath}></path>
          </svg>
        </Button>
      </span>
      <span class="ui-sr-only" role="status"></span>
    </div>
    {
      swatchOnly && (
        <div
          class:list={[
            "ui-text-field",
            {
              "ui-auto-fit": autoFit,
              "ui-filled": variant === "filled",
              "ui-spread": spread,
            },
            size && size !== "medium" && `ui-${size}`,
          ]}
        >
          {(label || Astro.slots.has("label")) && (
            <label
              class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}
              for={inputId}
              id={`${inputId}-label`}
            >
              {label}
              <slot name="label" />
            </label>
          )}
          {(startText || Astro.slots.has("start-text")) && (
            <span class="ui-start-text">
              {startText}
              <slot name="start-text" />
            </span>
          )}
          <span class="ui-field">
            <input
              autocomplete="off"
              spellcheck="false"
              {...rest}
              aria-invalid={error ? "true" : ariaInvalid}
              id={inputId}
              name={name ?? field?.name}
              type="text"
            />
          </span>
          {(endText || Astro.slots.has("end-text")) && (
            <span class="ui-end-text">
              {endText}
              <slot name="end-text" />
            </span>
          )}
        </div>
      )
    }
    <div aria-hidden="true" class="ui-panel">
      <canvas></canvas>
    </div>
    <label class="ui-select ui-small ui-spread">
      <span class="ui-label" id={`${inputId}-space-label`}>
        {colorSpaceLabel}
      </span>
      <span class="ui-field">
        <select
          aria-describedby={`${inputId}-gamut`}
          aria-labelledby={`${inputId}-space-label`}
          id={`${inputId}-space`}
        >
          <button>
            <selectedcontent></selectedcontent>
          </button>
          <div class="ui-list">
            {
              COLOR_SPACES.map((space) => (
                <option selected={space === "oklch"} value={space}>
                  {space}
                </option>
              ))
            }
          </div>
        </select>
      </span>
    </label>
    {
      channelsFor(opacity, {
        chroma: chromaLabel,
        hue: hueLabel,
        lightness: lightnessLabel,
        opacity: opacityLabel,
      }).map((slider) => (
        <label class="ui-range" for={`${inputId}-${slider.name}`}>
          <span class="ui-label" id={`${inputId}-${slider.name}-label`}>
            {slider.label}
          </span>
          <output
            aria-live="off"
            class="ui-value"
            for={`${inputId}-${slider.name}`}
          />
          <input
            aria-labelledby={`${inputId}-${slider.name}-label`}
            data-channel={slider.channel}
            id={`${inputId}-${slider.name}`}
            max={slider.max}
            min="0"
            step={slider.step}
            type="range"
          />
        </label>
      ))
    }
    <p class="ui-description" id={`${inputId}-gamut`}></p>
    <p class="ui-footer">
      <span aria-hidden="true" data-contrast="light"></span>
      <span aria-hidden="true" data-contrast="dark"></span>
      <span class="ui-sr-only"></span>
    </p>
  </div>
</opui-color-field>

<script>
  import "../../elements/color-field.js"
</script>
