---
import type { Props } from "./types.astro"

export const title = "Control Group"

const {
  class: className,
  color,
  orientation,
  overflow,
  role,
  size,
  variant,
  ...rest
} = Astro.props
---

<div
  class:list={[
    "ui-control-group",
    {
      "ui-vertical": orientation === "vertical",
    },
    color && `ui-${color}`,
    overflow && overflow !== "wrap" && `ui-overflow-${overflow}`,
    size && size !== "medium" && `ui-${size}`,
    variant && variant !== "transparent" && `ui-${variant}`,
    className,
  ]}
  role={role ?? "group"}
  {...rest}
>
  <slot />
</div>
