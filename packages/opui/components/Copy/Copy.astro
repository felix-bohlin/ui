---
import type { Props } from "./types.astro"
// A dynamic <Tag> or a custom element lets an undefined spread value remove an attribute set before it: tests/unit/tooling-bugs.test.ts
import { defined } from "../attrs"
import { warnMissingId } from "../dev"

export const title = "Copy"

const { class: className, copiedLabel, failedLabel, id, ...rest } = Astro.props

warnMissingId("Copy", id)
---

<opui-copy
  class:list={["ui-copy", className]}
  copied-label={copiedLabel}
  failed-label={failedLabel}
  id={id}
  {...defined(rest)}
>
  <slot />
  <span class="ui-sr-only" role="status" set:html="" />
  <span aria-hidden="true" class="ui-floating" popover set:html="" />
</opui-copy>

<script>
  import "../../elements/copy.js"
</script>
