---
import type { Props } from "./types.astro"
import { warnMissingId } from "../dev"

export const title = "Copy"

const { class: className, copiedLabel, failedLabel, id, ...rest } = Astro.props

warnMissingId("Copy", id)
---

<opui-copy
  class:list={["ui-copy", className]}
  copied-label={copiedLabel}
  failed-label={failedLabel}
  id={id}
  {...rest}
>
  <slot />
  <span class="ui-sr-only" role="status"></span>
  <span aria-hidden="true" class="ui-floating" popover></span>
</opui-copy>

<script>
  import "../../elements/copy.js"
</script>
