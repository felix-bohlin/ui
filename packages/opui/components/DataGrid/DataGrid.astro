---
import { createGrid } from "./model"
import type { Props } from "./types.astro"

export const title = "Data Grid"

const {
  class: className,
  columnGroups,
  columns,
  columnsMenu,
  density,
  densityToggle,
  filters,
  footer,
  label,
  labels: customLabels,
  loading,
  maxBlockSize,
  pinEnd,
  pinStart,
  resizable,
  rows,
  selectable,
  sort,
  style,
  wrap,
  ...rest
} = Astro.props

const { $id } = Astro.locals
const expandable = Astro.slots.has("detail")
const grid = createGrid({
  columns,
  expandable,
  filters,
  labels: customLabels,
  maxBlockSize,
  rows,
  selectable,
  sort,
})
const { labels } = grid
const filterName = $id("filter")
const densityName = $id("density")
const menuId = $id("columns")
const sortName = $id("sort")
const toolbar = grid.filters.length > 0 || densityToggle || columnsMenu
const mergedStyle =
  typeof style === "string" || !style
    ? [grid.style, style].filter(Boolean).join("; ") || undefined
    : style
---

<div
  class:list={[
    "ui-data-grid",
    {
      "ui-pin-end": pinEnd,
      "ui-pin-start": pinStart,
      "ui-resizable": resizable,
      "ui-wrap": wrap,
    },
    !densityToggle && density && density !== "standard" && `ui-${density}`,
    className,
  ]}
  style={mergedStyle}
  {...rest}
>
  {
    toolbar && (
      <div class="ui-toolbar">
        {grid.filters.length > 0 && (
          <div
            aria-label={labels.filter}
            class="ui-toggle-group ui-small ui-filters"
            role="radiogroup"
          >
            <label class="ui-toggle-button">
              <input checked name={filterName} type="radio" value="" />
              {labels.all}
            </label>
            {grid.filters.map((filter) => (
              <label class="ui-toggle-button">
                <input name={filterName} type="radio" value={filter.value} />
                {filter.label}
              </label>
            ))}
          </div>
        )}
        {densityToggle && (
          <div
            aria-label={labels.density}
            class="ui-toggle-group ui-small ui-density"
            role="radiogroup"
          >
            {(["compact", "standard", "spacious"] as const).map((value) => (
              <label class="ui-toggle-button">
                <input
                  checked={(density ?? "standard") === value}
                  name={densityName}
                  type="radio"
                  value={value}
                />
                {labels[value]}
              </label>
            ))}
          </div>
        )}
        {columnsMenu && (
          <Fragment>
            <button
              class="ui-button ui-outlined ui-small"
              command="toggle-popover"
              commandfor={menuId}
              type="button"
            >
              {labels.columns}
            </button>
            <menu
              class="ui-menu ui-list ui-dense ui-columns ui-align-end"
              id={menuId}
              popover
            >
              {grid.columns
                .filter((column) => column.hideable !== false)
                .map((column) => (
                  <li>
                    <label class="ui-checkbox">
                      <input checked type="checkbox" value={column.position} />
                      {column.label}
                    </label>
                  </li>
                ))}
            </menu>
          </Fragment>
        )}
      </div>
    )
  }
  <div
    aria-busy={loading ? "true" : undefined}
    aria-label={label}
    role="table"
    tabindex="0"
  >
    <div class="ui-head" role="rowgroup">
      {
        columnGroups && (
          <div role="row">
            {grid.utilityCells.map((name) => (
              <div class={name} role="columnheader" />
            ))}
            {columnGroups.map((group) => (
              <div
                aria-colspan={group.span}
                role="columnheader"
                style={`grid-column: span ${group.span}`}
              >
                {group.label}
              </div>
            ))}
          </div>
        )
      }
      <div role="row">
        {
          selectable && (
            <div class="ui-row-select" role="columnheader">
              <span class="ui-sr-only">{labels.select}</span>
            </div>
          )
        }
        {
          expandable && (
            <div class="ui-expand" role="columnheader">
              <span class="ui-sr-only">{labels.details}</span>
            </div>
          )
        }
        {
          grid.columns.map((column) => (
            <div
              class:list={[
                { "ui-fit": column.fit, "ui-numeric": column.numeric },
              ]}
              role="columnheader"
            >
              <span>{column.label}</span>
              {column.sortable && (
                <span class="ui-sort">
                  {(["asc", "desc"] as const).map((direction) => (
                    <label>
                      <input
                        checked={grid.sorted(column, direction)}
                        name={sortName}
                        type="radio"
                        value={direction}
                      />
                      <span class="ui-sr-only">
                        {labels.sortBy} {column.label},{" "}
                        {direction === "asc"
                          ? labels.ascending
                          : labels.descending}
                      </span>
                    </label>
                  ))}
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div class="ui-body" role="rowgroup">
      {
        rows.map((row, rowIndex) => (
          <div
            data-filters={grid.rowFilters(row)}
            role="row"
            style={grid.rowStyle(row, rowIndex)}
          >
            {selectable && (
              <div class="ui-row-select" role="cell">
                <label class="ui-checkbox">
                  <input type="checkbox" />
                  <span class="ui-sr-only">
                    {labels.select} {grid.rowName(row)}
                  </span>
                </label>
              </div>
            )}
            {expandable && (
              <div class="ui-expand" role="cell">
                <details>
                  <summary>
                    <span class="ui-sr-only">
                      {labels.details} {grid.rowName(row)}
                    </span>
                  </summary>
                  <div class="ui-detail">
                    <Fragment set:html={Astro.slots.render("detail", [row])} />
                  </div>
                </details>
              </div>
            )}
            {grid.columns.map((column) => (
              <div
                class:list={[{ "ui-numeric": column.numeric }]}
                role={column.rowHeader ? "rowheader" : "cell"}
              >
                {Astro.slots.has(`cell-${column.key}`) ? (
                  <Fragment
                    set:html={Astro.slots.render(`cell-${column.key}`, [
                      row,
                      column,
                    ])}
                  />
                ) : column.editable ? (
                  <input
                    aria-label={`${column.label}, ${grid.rowName(row)}`}
                    value={String(row[column.key] ?? "")}
                  />
                ) : (
                  row[column.key]
                )}
              </div>
            ))}
          </div>
        ))
      }
      <div class="ui-empty" role="row">
        <div role="cell">{labels.empty}</div>
      </div>
    </div>
    {
      grid.hasSum && (
        <div class="ui-foot" role="rowgroup">
          <div role="row">
            {grid.utilityCells.map((name) => (
              <div class={name} role="cell" />
            ))}
            {grid.columns.map((column) =>
              column.rowHeader ? (
                <div role="rowheader">{labels.total}</div>
              ) : (
                <div
                  class:list={[
                    { "ui-numeric": column.numeric, "ui-sum": column.sum },
                  ]}
                  role="cell"
                />
              ),
            )}
          </div>
        </div>
      )
    }
  </div>
  {
    footer && (
      <div class="ui-footer">
        {selectable && (
          <span class="ui-selection">
            <span class="ui-selected-count" /> {labels.selected}
          </span>
        )}
        <span>
          <span class="ui-row-count" /> {labels.rows}
        </span>
      </div>
    )
  }
</div>
