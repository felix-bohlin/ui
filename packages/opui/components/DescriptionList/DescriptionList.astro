---
import type { Props } from "./types.astro"

export const title = "Description List"

const { bordered, class: className, orientation, ...rest } = Astro.props
---

<dl
  class:list={[
    "ui-description-list",
    bordered && `ui-bordered-${bordered}`,
    orientation && orientation !== "auto" && `ui-${orientation}`,
    className,
  ]}
  {...rest}
>
  <slot />
</dl>
