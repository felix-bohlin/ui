---
import type { Props } from "./types.astro"

export const title = "Description List"

const { class: className, leader, orientation, ...rest } = Astro.props
---

<dl
  class:list={[
    "ui-description-list",
    leader && `ui-leader-${leader}`,
    orientation && orientation !== "auto" && `ui-${orientation}`,
    className,
  ]}
  {...rest}
>
  <slot />
</dl>
