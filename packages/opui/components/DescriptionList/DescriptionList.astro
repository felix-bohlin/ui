---
import type { Props } from "./types.astro"

export const title = "Description List"

const { bordered, class: className, dotted, orientation, ...rest } = Astro.props
---

<dl
  class:list={[
    "ui-description-list",
    {
      "ui-bordered": bordered,
      "ui-dotted": dotted,
    },
    orientation && orientation !== "auto" && `ui-${orientation}`,
    className,
  ]}
  {...rest}
>
  <slot />
</dl>
