{% macro DescriptionListDescription(props = {}) %}
  {%- set props = props | opuiProps("DescriptionListDescription") -%}
  {%- set rest = props | opuiRest("DescriptionListDescription") -%}
  <dd
    {%- if props.class %} class="{{ props.class }}"{% endif %}
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </dd>
{%- endmacro %}
