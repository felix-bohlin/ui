---
import type { Props } from "./types.astro"
import { autoLabelledBy, createId } from "../id"
import { dialogContext } from "./context.astro"

export const title = "Dialog"

const { class: className, closedby, ...rest } = Astro.props

const titleId = createId(Astro.locals)("dialog-title")
const labelledBy = autoLabelledBy(rest, titleId)
const html = await dialogContext.provide({ titleId: labelledBy }, () =>
  Astro.slots.render("default"),
)
---

<dialog
  aria-labelledby={labelledBy}
  class:list={["ui-dialog", "ui-elevated", className]}
  closedby={closedby}
  {...rest}
>
  <Fragment set:html={html} />
</dialog>
