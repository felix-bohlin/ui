---
import type { Props } from "./types.astro"

export const title = "Dialog"

const { actionsAlign, class: className, closedby, ...rest } = Astro.props

const { $id } = Astro.locals
const headerId =
  Astro.slots.has("header") && !rest["aria-labelledby"]
    ? $id("dialog-header")
    : undefined
---

<dialog
  aria-labelledby={headerId}
  class:list={["ui-dialog ui-card ui-elevated", className]}
  closedby={closedby}
  {...rest}
>
  {
    Astro.slots.has("header") && (
      <hgroup id={headerId}>
        <slot name="header" />
      </hgroup>
    )
  }
  {
    Astro.slots.has("content") && (
      <div class="ui-content">
        <slot name="content" />
      </div>
    )
  }
  <slot />
  {
    Astro.slots.has("actions") && (
      <div
        class:list={["ui-actions", actionsAlign && `ui-align-${actionsAlign}`]}
      >
        <slot name="actions" />
      </div>
    )
  }
</dialog>
