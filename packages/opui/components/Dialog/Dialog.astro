---
import type { Props } from "./types.astro"
import { autoLabelledBy, createId } from "../id"
import { dialogContext } from "./context.astro"

export const title = "Dialog"

const { class: className, closedby, ...rest } = Astro.props

const headerId = createId(Astro.locals)("dialog-header")
const labelledBy = autoLabelledBy(rest, headerId)
const html = await dialogContext.provide({ headerId: labelledBy }, () =>
  Astro.slots.render("default"),
)
---

<dialog
  aria-labelledby={labelledBy}
  class:list={["ui-dialog ui-card ui-elevated", className]}
  closedby={closedby}
  {...rest}
>
  <Fragment set:html={html} />
</dialog>
