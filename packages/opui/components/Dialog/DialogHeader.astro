---
import type { DialogHeaderProps as Props } from "./types.astro"
import { dialogContext } from "./context.astro"
import { warnReplacedId } from "../dev"

const { class: className, id, ...rest } = Astro.props

const dialog = dialogContext.get()
warnReplacedId("DialogHeader", "Dialog", id, dialog?.headerId)
---

<hgroup class:list={[className]} id={dialog?.headerId ?? id} {...rest}>
  <slot />
</hgroup>
