---
import Button from "../Button/Button.astro"

import type { DialogHeaderProps as Props } from "./types.astro"
import { warnMissingId } from "../dev"
import { dialogContext } from "./context.astro"
import { closePath } from "./icons"
import { trimEdges } from "../whitespace"

const { class: className, closeLabel, ...rest } = Astro.props

const dialog = dialogContext.get()
if (closeLabel) warnMissingId("Dialog", dialog?.id)
const content = Astro.slots.has("default")
  ? trimEdges(await Astro.slots.render("default"))
  : ""
---

<div class:list={["ui-header", className]} {...rest}>
  <Fragment set:html={content} />{closeLabel && <Button
    aria-label={closeLabel}
    command="close"
    commandfor={dialog?.id}
    round
    size="small"
  >
    <slot name="close-icon">
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path fill="currentColor" d={closePath} />
      </svg>
    </slot>
  </Button>}
</div>
