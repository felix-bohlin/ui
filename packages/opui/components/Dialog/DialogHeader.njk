{% from "opui/Button.njk" import Button %}

{% macro DialogHeader(props = {}) %}
  {%- set props = props | opuiProps("DialogHeader") -%}
  {%- set rest = props | opuiRest("DialogHeader") -%}
  {%- set closeLabel = props.closeLabel | default("Close") -%}
  {%- set dialog = opui.context("Dialog") -%}
  {%- set content = (caller() if caller) | opuiTrim -%}
  {%- set target = props.commandfor | default(dialog.id) -%}
  {{- opui.warnMissingCloseTarget("DialogHeader", target, "Dialog") if props.closeButton -}}
  <div
    class="ui-header
      {%- if props.class %} {{ props.class }}{% endif %}"
    {{- rest | opuiAttributes }}>
    {{- content }}{% if props.closeButton -%}
      {% call Button({
        "aria-label": closeLabel,
        command: "close",
        commandfor: target,
        round: true,
        size: "small"
      }) -%}
        {% if props.slots.closeIcon != none %}{{ props.slots.closeIcon | safe }}{% else %}<svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"></svg>{% endif %}
      {%- endcall %}
    {%- endif -%}
  </div>
{%- endmacro %}
