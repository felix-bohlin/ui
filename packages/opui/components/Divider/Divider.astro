---
export const title = "Divider"
import type { Props } from "./types.astro"

const { align, class: className, variant, ...rest } = Astro.props
---

{
  Astro.slots.has("default") ? (
    <div
      class:list={[
        "ui-divider",
        align && align !== "center" && `ui-align-${align}`,
        variant && `ui-${variant}`,
        className,
      ]}
      {...rest}
    >
      <slot />
    </div>
  ) : (
    <hr
      class:list={["ui-divider", variant && `ui-${variant}`, className]}
      {...rest}
    />
  )
}
