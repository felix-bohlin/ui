---
import type { Props } from "./types.astro"
import { autoLabelledBy } from "../id"
import { drawerContext } from "./context.astro"

export const title = "Drawer"

const {
  backdrop = "blurred",
  class: className,
  closedby = "any",
  id,
  scrollLock,
  side = "inline-start",
  ...rest
} = Astro.props

const labelledBy = autoLabelledBy(rest, `${id}-heading`)
const html = await drawerContext.provide({ id, titleId: labelledBy }, () =>
  Astro.slots.render("default"),
)
---

<dialog
  closedby={closedby}
  class:list={[
    "ui-drawer",
    {
      "ui-backdrop-transparent": backdrop === "transparent",
      "ui-scroll-lock": scrollLock,
    },
    side && side !== "inline-start" && `ui-${side}`,
    className,
  ]}
  aria-labelledby={labelledBy}
  id={id}
  {...rest}
>
  <Fragment set:html={html} />
</dialog>
