---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Drawer"

const {
  backdrop = "blurred",
  class: className,
  closedby = "any",
  id,
  scrollLock = true,
  side = "inline-start",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const drawerId = id || $id("drawer")

let header = Astro.slots.has("header")
  ? await Astro.slots.render("header")
  : undefined
let labelledBy: string | undefined
const heading =
  header && !rest["aria-label"] && !rest["aria-labelledby"]
    ? header.match(/<h[1-6]\b[^>]*>/)?.[0]
    : undefined
if (header && heading) {
  labelledBy = heading.match(/\sid="([^"]+)"/)?.[1]
  if (!labelledBy) {
    labelledBy = `${drawerId}-heading`
    header = header.replace(
      heading,
      heading.replace(/^<h[1-6]/, (tag) => `${tag} id="${labelledBy}"`),
    )
  }
}
---

<dialog
  closedby={closedby}
  class:list={[
    "ui-drawer",
    side && `ui-${side}`,
    {
      "ui-backdrop-transparent": backdrop === "transparent",
      "ui-scroll-lock": scrollLock,
    },
    className,
  ]}
  aria-labelledby={labelledBy}
  id={drawerId}
  {...rest}
>
  {header && <Fragment set:html={header} />}

  {
    Astro.slots.has("content") && (
      <div class="ui-content">
        <slot name="content" />
      </div>
    )
  }

  <slot />

  {Astro.slots.has("footer") && <slot name="footer" />}
</dialog>
