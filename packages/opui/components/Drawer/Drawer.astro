---
import type { Props } from "./types.astro"
import { createId } from "../id"
import { drawerContext } from "./context.astro"

export const title = "Drawer"

const {
  backdrop = "blurred",
  class: className,
  closedby = "any",
  id,
  scrollLock = true,
  side = "inline-start",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const drawerId = id || $id("drawer")
const titleId = `${drawerId}-heading`
const labelledBy =
  rest["aria-label"] || rest["aria-labelledby"] ? undefined : titleId
const html = await drawerContext.provide({ id: drawerId, titleId }, () =>
  Astro.slots.render("default"),
)
---

<dialog
  closedby={closedby}
  class:list={[
    "ui-drawer",
    side && `ui-${side}`,
    {
      "ui-backdrop-transparent": backdrop === "transparent",
      "ui-scroll-lock": scrollLock,
    },
    className,
  ]}
  aria-labelledby={labelledBy}
  id={drawerId}
  {...rest}
>
  <Fragment set:html={html} />
</dialog>
