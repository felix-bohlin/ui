---
import type { Props } from "./types.astro"
import { autoLabelledBy, createId } from "../id"
import { drawerContext } from "./context.astro"

export const title = "Drawer"

const {
  backdrop = "blurred",
  class: className,
  closedby = "any",
  id,
  scrollLock = true,
  side = "inline-start",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const drawerId = id || $id("drawer")
const labelledBy = autoLabelledBy(rest, `${drawerId}-heading`)
const html = await drawerContext.provide(
  { id: drawerId, titleId: labelledBy },
  () => Astro.slots.render("default"),
)
---

<dialog
  closedby={closedby}
  class:list={[
    "ui-drawer",
    {
      "ui-backdrop-transparent": backdrop === "transparent",
      "ui-scroll-lock": scrollLock,
    },
    side && side !== "inline-start" && `ui-${side}`,
    className,
  ]}
  aria-labelledby={labelledBy}
  id={drawerId}
  {...rest}
>
  <Fragment set:html={html} />
</dialog>
