{% macro DrawerContent(props = {}) %}
  {%- set props = props | opuiProps("DrawerContent") -%}
  {%- set rest = props | opuiRest("DrawerContent") -%}
  <div
    class="ui-content
      {%- if props.class %} {{ props.class }}{% endif %}"
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </div>
{%- endmacro %}
