---
import Button from "../Button/Button.astro"

import type { DrawerHeaderProps as Props } from "./types.astro"
import { drawerContext } from "./context.astro"
import { closePath } from "./icons"

const {
  class: className,
  closeLabel = "Close",
  commandfor,
  ...rest
} = Astro.props

const drawer = drawerContext.get()
const closeAttrs =
  commandfor || drawer
    ? { command: "close", commandfor: commandfor ?? drawer?.id }
    : { onclick: "this.closest('dialog')?.close()" }
---

<div class:list={["ui-header", className]} {...rest}>
  <slot />
  <Button aria-label={closeLabel} round size="small" {...closeAttrs}>
    <svg
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 32 32"
    >
      <path fill="currentColor" d={closePath}></path>
    </svg>
  </Button>
</div>
