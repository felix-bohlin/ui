---
import Button from "../Button/Button.astro"

import type { DrawerHeaderProps as Props } from "./types.astro"

export const title = "Drawer Header"

const { class: className, commandfor, heading, ...rest } = Astro.props

const closeAttrs = commandfor
  ? { command: "close", commandfor }
  : { onclick: "this.closest('dialog').close()" }
---

<div class:list={["ui-header", className]} {...rest}>
  {heading && <span>{heading}</span>}
  <slot />
  <Button ripple rounded size="small" title="Close" {...closeAttrs}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 32 32"
    >
      <path
        fill="currentColor"
        d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
      ></path>
    </svg>
  </Button>
</div>
