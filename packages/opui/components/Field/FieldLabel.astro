---
import type { FieldLabelProps as Props } from "./types.astro"
import { fieldContext } from "./context.astro"

const { class: className, visuallyHidden, ...rest } = Astro.props

fieldContext.get()?.parts.add("label")
---

<span
  class:list={[visuallyHidden ? "ui-sr-only" : "ui-label", className]}
  {...rest}
>
  <slot />
</span>
