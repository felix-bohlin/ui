---
import type { Props } from "./types.astro"
import { fieldContext } from "./context.astro"
export const title = "Field Group"

const { class: className, direction, name, ...rest } = Astro.props

const parent = fieldContext.get()
const html = await fieldContext.provide({ name: name || parent?.name }, () =>
  Astro.slots.render("default"),
)
---

<div
  class:list={["ui-field-group", direction && `ui-${direction}`, className]}
  {...rest}
>
  <Fragment set:html={html} />
</div>
