---
import type { Props } from "./types.astro"
export const title = "Field Group"

const { class: className, direction, name, ...rest } = Astro.props

const slotHtml = (await Astro.slots.render("default")) ?? ""
const escapedName = name?.replaceAll("&", "&amp;").replaceAll('"', "&quot;")
const html = name
  ? slotHtml.replace(
      /<(input|select|textarea)\b(?![^>]*\sname=)(?![^>]*\stype="(?:button|hidden|image|reset|submit)")/g,
      (_, tag) => `<${tag} name="${escapedName}"`,
    )
  : slotHtml
---

<div
  class:list={["ui-field-group", direction && `ui-${direction}`, className]}
  {...rest}
  set:html={html}
/>
