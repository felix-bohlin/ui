---
import type { Props } from "./types.astro"
import { fieldGroupContext } from "./context.astro"
export const title = "Field Group"

const { class: className, name, orientation, ...rest } = Astro.props

const parent = fieldGroupContext.get()
const html = await fieldGroupContext.provide(
  { name: name || parent?.name },
  () => Astro.slots.render("default"),
)
---

<div
  class:list={[
    "ui-field-group",
    orientation && orientation !== "auto" && `ui-${orientation}`,
    className,
  ]}
  {...rest}
>
  <Fragment set:html={html} />
</div>
