{% macro FieldGroup(props = {}) %}
  {%- set props = props | opuiProps("FieldGroup") -%}
  {%- set rest = props | opuiRest("FieldGroup") -%}
  <div
    class="ui-field-group
      {%- if props.orientation and props.orientation != 'auto' %} ui-{{ props.orientation }}
      {%- endif %}
      {%- if props.class %} {{ props.class }}{% endif %}"
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </div>
{%- endmacro %}
