---
import type { Props } from "./types.astro"
import { cx } from "../cx"
import { warnReplacedId } from "../dev"
import { fieldsetContext } from "../Fieldset/context.astro"
export const title = "Field Legend"

const { as: Tag = "legend", class: className, id, ...rest } = Astro.props
const isLegend = Tag === "legend"
const fieldset = fieldsetContext.get()
warnReplacedId("FieldLegend", "Fieldset", id, fieldset?.legendId)
---

<Tag
  class={cx([{ "ui-legend": !isLegend }, className])}
  {...rest}
  id={fieldset?.legendId ?? id}
  ><slot
/></Tag>
