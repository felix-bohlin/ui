---
import type { Props } from "./types.astro"

export const title = "Field Start Text"

const { class: className, text, ...rest } = Astro.props
const hasContent = text || Astro.slots.has("default")
---

{
  hasContent && (
    <span class:list={["ui-start-text", className]} {...rest}>
      {text}
      <slot />
    </span>
  )
}