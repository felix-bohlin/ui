---
import type { Props } from "./types.astro"
// A dynamic <Tag> or a custom element lets an undefined spread value remove an attribute set before it: tests/unit/tooling-bugs.test.ts
import { defined } from "../attrs"
import { cx } from "../cx"
import { autoLabelledBy, createIds } from "../id"
import { fieldsetContext } from "./context.astro"

export const title = "Fieldset"

const { as: Tag = "fieldset", class: className, ...rest } = Astro.props

const isFieldset = Tag === "fieldset"
const legendId = isFieldset
  ? undefined
  : autoLabelledBy(rest, createIds(Astro.locals, "fieldset", rest.id)("legend"))
const html = await fieldsetContext.provide({ legendId }, () =>
  Astro.slots.render("default"),
)
---

<Tag
  aria-labelledby={legendId}
  class={cx(["ui-fieldset", className])}
  role={isFieldset ? undefined : "group"}
  {...defined(rest)}
>
  <Fragment set:html={html} />
</Tag>
