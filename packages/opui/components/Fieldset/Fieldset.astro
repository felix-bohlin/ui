---
import type { Props } from "./types.astro"
import { cx } from "../cx"

export const title = "Fieldset"

const { as: Tag = "fieldset", class: className, ...rest } = Astro.props
---

<Tag
  class={cx(["ui-fieldset", className])}
  role={Tag === "fieldset" ? undefined : "group"}
  {...rest}
>
  <slot />
</Tag>
