---
import Button from "../Button/Button.astro"
import Progress from "../Progress/Progress.astro"

import type { Props } from "./types.astro"
// A dynamic <Tag> or a custom element lets an undefined spread value remove an attribute set before it: tests/unit/tooling-bugs.test.ts
import { defined } from "../attrs"
import { createIds } from "../id"

export const title = "File Upload"

const {
  accept,
  class: className,
  description,
  disabled,
  id,
  items,
  label,
  multiple,
  progressLabel = "Uploading {label}",
  removeLabel = "Remove {label}",
  status,
  ...rest
} = Astro.props

const ids = createIds(Astro.locals, "file-upload", id)
const inputId = ids()
const descriptionId = description ? ids("description") : undefined
---

<opui-file-upload class:list={["ui-file-upload", className]} {...defined(rest)}>
  <div class="ui-content">
    <div class="ui-field">
      <label class="ui-label">
        <input
          accept={accept}
          aria-describedby={descriptionId}
          class="ui-sr-only"
          disabled={disabled}
          id={inputId}
          multiple={multiple}
          type="file"
        />
        <span class="ui-button ui-outlined">{label}</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        ></svg>
      </label>
      {description && <span class="ui-description" id={descriptionId}>
        {description}
      </span>}
    </div>
    {items && items.length > 0 && <ul class="ui-list">
      {items.map((item, index) => <li
        class:list={[{ "ui-error": item.state === "error" }]}
      >
        <div class="ui-start">
          {item.preview && <img alt="" src={item.preview} />}
          {item.state === "error" && item.description && (
            <button
              aria-labelledby={`${inputId}-label-${index} ${inputId}-description-${index}`}
              popovertarget={`${inputId}-description-${index}`}
              type="button"
            />
          )}
        </div>
        <div class="ui-text">
          <p dir="auto" id={`${inputId}-label-${index}`}>{item.label}</p>
          {(item.state === "queued" || item.state === "uploading") && (
            <Progress
              aria-label={progressLabel.replace("{label}", item.label)}
              value={
                item.state === "uploading" ? (item.progress ?? 0) : undefined
              }
            />
          )}
          {item.description && <p
            class="ui-description"
            id={`${inputId}-description-${index}`}
            popover={item.state === "error" ? "auto" : undefined}
          >
            {item.description}
          </p>}
        </div>
        <div class="ui-end">
          <Button
            aria-label={removeLabel.replace("{label}", item.label)}
            command="--remove"
            commandfor={inputId}
            round
            size="small"
            value={item.value}
          >
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 32 32"
            ></svg>
          </Button>
        </div>
      </li>)}
    </ul>}
  </div>
  <span class="ui-sr-only" role="status">{status}</span>
</opui-file-upload>

<script>
  import "../../elements/file-upload.js"
</script>
