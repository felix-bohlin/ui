---
import type { Props } from "./types.astro"
export const title = "List"

const {
  bordered,
  class: className,
  dense,
  flush,
  role,
  variant,
  ...rest
} = Astro.props
---

<ul
  class:list={[
    "ui-list",
    {
      "ui-bordered": bordered,
      "ui-dense": dense,
      "ui-flush": flush,
    },
    variant && variant !== "filled" && `ui-${variant}`,
    className,
  ]}
  role={role ?? "list"}
  {...rest}
>
  <slot />
</ul>
