---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"

export const title = "List Item"

const {
  as = Astro.props.href ? "a" : undefined,
  borderTop,
  class: className,
  critical,
  description,
  for: htmlFor,
  headline,
  inset,
  type,
  ...rest
} = Astro.props

const hasLabel = type === "checkbox" || type === "radio" || type === "switch"
const Tag = hasLabel ? "label" : as
const liProps = Tag && !hasLabel ? {} : rest
const tagProps = hasLabel
  ? { class: `ui-${type}`, for: htmlFor }
  : { type: Tag === "button" ? ("button" as const) : undefined, ...rest }
---

<li
  class:list={[
    {
      "ui-border-top": borderTop,
      "ui-critical": critical,
      "ui-inset": inset,
    },
    className,
  ]}
  {...liProps as HTMLAttributes<"li">}
>
  {
    // Label + checkbox/radio/switch
    // With custom tag
    Tag ? (
      <Tag {...tagProps}>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {headline || description || Astro.slots.text ? (
          <div class="ui-text">
            {headline && <p>{headline}</p>}
            {description && <p>{description}</p>}
            <slot name="text" />
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </Tag>
    ) : (
      // Without custom tag
      <>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {headline || description || Astro.slots.text ? (
          <div class="ui-text">
            {headline && <p>{headline}</p>}
            {description && <p>{description}</p>}
            <slot name="text" />
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </>
    )
  }
  <slot name="submenu" />
</li>
