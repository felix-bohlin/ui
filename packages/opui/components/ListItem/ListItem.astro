---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
import { cx } from "../cx"
import { tagAttrs } from "../tag"
import { trimEdges } from "../whitespace"

export const title = "List Item"

const {
  as,
  borderTop,
  class: className,
  color,
  description,
  disabled,
  for: htmlFor,
  href,
  inset,
  label,
  type,
  ...rest
} = Astro.props

const hasControl = type === "checkbox" || type === "radio" || type === "switch"
const Tag = hasControl ? "label" : (as ?? (href ? "a" : undefined))
const restOnItem = hasControl || !Tag
const hasLabel = !!label || Astro.slots.has("label")
const submenu = Astro.slots.has("submenu")
  ? trimEdges(await Astro.slots.render("submenu"))
  : ""
const hasDescription = !!description || Astro.slots.has("description")
---

<li
  class:list={[
    {
      "ui-border-top": borderTop,
      "ui-inset": inset,
    },
    color && `ui-${color}`,
    className,
  ]}
  {...((restOnItem ? rest : {}) as HTMLAttributes<"li">)}
>
  {
    // Label + checkbox/radio/switch
    // With custom tag
    Tag ? (
      <Tag
        class={cx([hasControl && `ui-${type}`])}
        for={hasControl ? htmlFor : undefined}
        {...(hasControl ? {} : tagAttrs(Tag, disabled, href))}
        {...(restOnItem ? {} : rest)}
      >
        {Astro.slots.has("start") && <div class="ui-start">
          <slot name="start" />
        </div>}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && <p>
              {label}
              <slot name="label" />
            </p>}
            {hasDescription && <p>
              {description}
              <slot name="description" />
            </p>}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.has("end") && <div class="ui-end">
          <slot name="end" />
        </div>}
      </Tag>
    ) : (
      // Without custom tag
      <>
        {Astro.slots.has("start") && <div class="ui-start">
          <slot name="start" />
        </div>}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && <p>
              {label}
              <slot name="label" />
            </p>}
            {hasDescription && <p>
              {description}
              <slot name="description" />
            </p>}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.has("end") && <div class="ui-end">
          <slot name="end" />
        </div>}
      </>
    )
  }<Fragment set:html={submenu} />
</li>
