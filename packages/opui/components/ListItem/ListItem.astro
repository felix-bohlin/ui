---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
// A dynamic <Tag> or a custom element lets an undefined spread value remove an attribute set before it: tests/unit/tooling-bugs.test.ts
import { defined } from "../attrs"
import { cx } from "../cx"
import { tagAttrs } from "../tag"
import { trimEdges } from "../whitespace"

export const title = "List Item"

const {
  as,
  borderTop,
  choice,
  class: className,
  color,
  description,
  disabled,
  for: htmlFor,
  href,
  inset,
  label,
  ...rest
} = Astro.props

const hasControl =
  choice === "checkbox" || choice === "radio" || choice === "switch"
const Tag = hasControl ? "label" : (as ?? (href ? "a" : undefined))
const restOnItem = hasControl || !Tag
const hasLabel = !!label || Astro.slots.has("label")
const submenu = Astro.slots.has("submenu")
  ? trimEdges(await Astro.slots.render("submenu"))
  : ""
const hasDescription = !!description || Astro.slots.has("description")
---

<li
  class:list={[
    {
      "ui-border-top": borderTop,
      "ui-inset": inset,
    },
    color && `ui-${color}`,
    className,
  ]}
  {...((restOnItem ? rest : {}) as HTMLAttributes<"li">)}
>
  {
    // Label + checkbox/radio/switch
    // With custom tag
    Tag ? (
      <Tag
        class={cx([hasControl && `ui-${choice}`])}
        for={hasControl ? htmlFor : undefined}
        {...(hasControl ? {} : tagAttrs(Tag, disabled, href))}
        {...defined(restOnItem ? {} : rest)}
      >
        {Astro.slots.has("start") && <div class="ui-start">
          <slot name="start" />
        </div>}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && <p>
              {label}
              <slot name="label" />
            </p>}
            {hasDescription && <p>
              {description}
              <slot name="description" />
            </p>}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.has("end") && <div class="ui-end">
          <slot name="end" />
        </div>}
        {Astro.slots.has("icon-checked") && <span
          aria-hidden="true"
          class="ui-icon-checked"
          ><slot name="icon-checked"
        /></span>}
      </Tag>
    ) : (
      // Without custom tag
      <>
        {Astro.slots.has("start") && <div class="ui-start">
          <slot name="start" />
        </div>}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && <p>
              {label}
              <slot name="label" />
            </p>}
            {hasDescription && <p>
              {description}
              <slot name="description" />
            </p>}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.has("end") && <div class="ui-end">
          <slot name="end" />
        </div>}
        {Astro.slots.has("icon-checked") && <span
          aria-hidden="true"
          class="ui-icon-checked"
          ><slot name="icon-checked"
        /></span>}</>
    )
  }<Fragment set:html={submenu} />
</li>
