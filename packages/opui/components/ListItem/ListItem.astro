---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"

export const title = "List Item"

const {
  as: Tag = Astro.props.href ? "a" : undefined,
  borderTop,
  class: className,
  description,
  for: htmlFor,
  headline,
  inset,
  type,
  ...rest
} = Astro.props

const hasLabel = type === "checkbox" || type === "radio" || type === "switch"
const liProps = Tag ? {} : rest
const innerProps = Tag ? rest : {}
---

<li
  class:list={[
    {
      "ui-border-top": borderTop,
      "ui-inset": inset,
    },
    className,
  ]}
  {...liProps as HTMLAttributes<"li">}
>
  {
    // Label + checkbox/radio/switch
    hasLabel ? (
      <label class={`ui-${type}`} for={htmlFor}>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {Astro.slots.text || headline || description ? (
          <div class="ui-text">
            {headline && <p>{headline}</p>}
            {description && <p>{description}</p>}
            <slot name="text" />
          </div>
        ) : null}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
        <slot />
      </label>
    ) : // With custom tag
    Tag ? (
      <Tag type={Tag === "button" ? "button" : undefined} {...innerProps}>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {headline || description || Astro.slots.text ? (
          <div class="ui-text">
            {headline && <p>{headline}</p>}
            {description && <p>{description}</p>}
            <slot name="text" />
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </Tag>
    ) : (
      // Without custom tag
      <>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {headline || description || Astro.slots.text ? (
          <div class="ui-text">
            {headline && <p>{headline}</p>}
            {description && <p>{description}</p>}
            <slot name="text" />
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </>
    )
  }
  <slot name="submenu" />
</li>
