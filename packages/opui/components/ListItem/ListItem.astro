---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"

export const title = "List Item"

const {
  as = Astro.props.href ? "a" : undefined,
  borderTop,
  class: className,
  color,
  description,
  for: htmlFor,
  inset,
  label,
  type,
  ...rest
} = Astro.props

const hasControl = type === "checkbox" || type === "radio" || type === "switch"
const Tag = hasControl ? "label" : as
const liProps = Tag && !hasControl ? {} : rest
const hasLabel = !!label || Astro.slots.has("label")
const hasDescription = !!description || Astro.slots.has("description")
const tagProps = hasControl
  ? { class: `ui-${type}`, for: htmlFor }
  : { type: Tag === "button" ? ("button" as const) : undefined, ...rest }
---

<li
  class:list={[
    {
      "ui-border-top": borderTop,
      "ui-inset": inset,
    },
    color && `ui-${color}`,
    className,
  ]}
  {...liProps as HTMLAttributes<"li">}
>
  {
    // Label + checkbox/radio/switch
    // With custom tag
    Tag ? (
      <Tag {...tagProps}>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && (
              <p>
                {label}
                <slot name="label" />
              </p>
            )}
            {hasDescription && (
              <p>
                {description}
                <slot name="description" />
              </p>
            )}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </Tag>
    ) : (
      // Without custom tag
      <>
        {Astro.slots.start && (
          <div class="ui-start">
            <slot name="start" />
          </div>
        )}
        {hasLabel || hasDescription ? (
          <div class="ui-text">
            {hasLabel && (
              <p>
                {label}
                <slot name="label" />
              </p>
            )}
            {hasDescription && (
              <p>
                {description}
                <slot name="description" />
              </p>
            )}
            <slot />
          </div>
        ) : (
          <slot />
        )}
        {Astro.slots.end && (
          <div class="ui-end">
            <slot name="end" />
          </div>
        )}
      </>
    )
  }
  <slot name="submenu" />
</li>
