{% macro ListItem(props = {}) %}
  {%- set rest = props | opuiRest("ListItem") -%}
  {%- set submenu = props.slots.submenu | opuiTrim -%}
  {%- set hasControl = props.choice == "checkbox"
    or props.choice == "radio"
    or props.choice == "switch" -%}
  {%- set tag = "label"
    if hasControl
    else ("a" if opui.disabledLink(props.as, props.disabled) else (props.as if props.as != none else ("a" if props.href else undefined))) -%}
  {%- set restOnItem = hasControl or not tag -%}
  {%- set hasLabel = (true if props.label else false) or props.slots.label != none -%}
  {%- set hasDescription = (true if props.description else false)
    or props.slots.description != none -%}
  {%- set classes = [{ "ui-border-top": props.borderTop, "ui-inset": props.inset }, props.color and 'ui-' ~ props.color, props.class] | opuiClass -%}
  <li
    {%- if classes %} class="{{ classes }}"{% endif %}
    {%- if restOnItem %}{{ rest | opuiAttributes }}{% endif %}>
    {%- if tag %}<{{ tag | opuiTag }}{{ opui.merge(
      {
        class: [hasControl and "ui-" ~ props.choice] | opuiClass,
        for: props.for if hasControl else none
      },
      {} if hasControl else opui.tagAttrs(tag, props.disabled, props.href),
      opui.defined({} if restOnItem else rest)
    ) | opuiAttributes(tag) }}>{% if props.slots.start != none %}<div class="ui-start">
        {{- props.slots.start | safe -}}
      </div>{% endif %}{% if hasLabel or hasDescription %}<div class="ui-text">
        {%- if hasLabel %}<p>{{ props.label }}{{ props.slots.label | safe }}</p>{% endif %}
        {% if hasDescription %}<p>{{ props.description }}
          {{- props.slots.description | safe }}</p>{% endif %}
        {{ caller() if caller -}}
      </div>{% else %}{{ caller() if caller }}{% endif %}
      {%- if props.slots.end != none %}<div class="ui-end">
        {{- props.slots.end | safe -}}
      </div>{% endif %}{% if props.slots.iconChecked != none -%}
        <span aria-hidden="true" class="ui-icon-checked">{{ props.slots.iconChecked | safe }}</span>
      {%- endif %}</{{ tag | opuiTag }}>{% else %}{% if props.slots.start != none %}<div class="ui-start">
      {{- props.slots.start | safe -}}
    </div>{% endif %}{% if hasLabel or hasDescription %}<div class="ui-text">
      {%- if hasLabel %}<p>{{ props.label }}{{ props.slots.label | safe }}</p>{% endif %}
      {% if hasDescription %}<p>{{ props.description }}
        {{- props.slots.description | safe }}</p>{% endif %}
      {{ caller() if caller -}}
    </div>{% else %}{{ caller() if caller }}{% endif %}
    {%- if props.slots.end != none %}<div class="ui-end">
      {{- props.slots.end | safe -}}
    </div>{% endif %}{% if props.slots.iconChecked != none -%}
      <span aria-hidden="true" class="ui-icon-checked">{{ props.slots.iconChecked | safe }}</span>
    {%- endif %}{% endif %}{{ submenu -}}
  </li>
{%- endmacro %}
