---
import type { Props } from "./types.astro"
import { createId } from "../id"
import { menuContext } from "./context.astro"

export const title = "Menu"

const {
  align,
  bordered,
  class: className,
  dense,
  id,
  items,
  placement,
  popover = "auto",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const menuId = id || $id("menu")
const rootId = menuContext.get()?.rootId ?? menuId
const html = await menuContext.provide({ rootId }, () =>
  Astro.slots.render("default"),
)
---

<menu
  class:list={[
    "ui-menu",
    "ui-list",
    {
      "ui-align-end": align === "end",
      "ui-bordered": bordered,
      "ui-dense": dense,
    },
    placement && placement !== "block-end" && `ui-${placement}`,
    className,
  ]}
  id={menuId}
  popover={popover === "auto" ? "" : popover}
  {...rest}
>
  {
    items?.map(
      ({
        borderTop,
        closeOnClick = true,
        critical,
        disabled,
        href,
        shortcut,
        text,
        ...itemRest
      }) => {
        const Tag = href ? "a" : "button"
        const closes = !href && closeOnClick && !disabled

        return (
          <li
            class:list={[
              { "ui-border-top": borderTop, "ui-critical": critical },
            ]}
          >
            <Tag
              aria-disabled={href && disabled ? "true" : undefined}
              command={closes ? "hide-popover" : undefined}
              commandfor={closes ? rootId : undefined}
              disabled={!href && disabled ? true : undefined}
              href={href && !disabled ? href : undefined}
              type={href ? undefined : "button"}
              {...itemRest}
            >
              <div class="ui-text">
                <p>{text}</p>
              </div>
              {shortcut && (
                <div class="ui-end">
                  <kbd>{shortcut}</kbd>
                </div>
              )}
            </Tag>
          </li>
        )
      },
    )
  }
  <Fragment set:html={html} />
</menu>
