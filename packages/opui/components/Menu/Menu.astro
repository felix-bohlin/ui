---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Menu"

const {
  align,
  class: className,
  dense,
  id,
  items,
  placement,
  popover = "auto",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const menuId = id || $id("menu")
---

<menu
  class:list={[
    "ui-menu",
    "ui-list",
    { "ui-align-end": align === "end", "ui-dense": dense },
    placement && placement !== "block-end" && `ui-${placement}`,
    className,
  ]}
  id={menuId}
  popover={popover === "auto" ? true : popover}
  {...rest}
>
  {
    items?.map(
      ({
        borderTop,
        closeOnClick = true,
        critical,
        disabled,
        href,
        label,
        shortcut,
        ...itemRest
      }) => {
        const Tag = href ? "a" : "button"
        const closes = !href && closeOnClick && !disabled

        return (
          <li
            class:list={[
              { "ui-border-top": borderTop, "ui-critical": critical },
            ]}
          >
            <Tag
              aria-disabled={href && disabled ? "true" : undefined}
              command={closes ? "hide-popover" : undefined}
              commandfor={closes ? menuId : undefined}
              disabled={!href && disabled ? true : undefined}
              href={href && !disabled ? href : undefined}
              type={href ? undefined : "button"}
              {...(itemRest as any)}
            >
              <div class="ui-text">
                <p>{label}</p>
              </div>
              {shortcut && (
                <div class="ui-end">
                  <kbd>{shortcut}</kbd>
                </div>
              )}
            </Tag>
          </li>
        )
      },
    )
  }
  <slot />
</menu>
