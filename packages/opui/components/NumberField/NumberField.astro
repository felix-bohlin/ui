---
import Button from "../Button/Button.astro"
import { trimEdges } from "../whitespace"

import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { createIds, idRefs } from "../id"
import { minusPath, plusPath } from "./icons"
import { cx } from "../cx"

export const title = "Number Field"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  class: className,
  decreaseLabel = "Decrease",
  endText,
  error,
  hideLabel,
  id,
  increaseLabel = "Increase",
  label,
  name,
  size,
  spread,
  startText,
  stretch,
  style,
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "number-field", id)
const inputId = ids()
const startTextId =
  startText || Astro.slots.has("start-text") ? ids("start-text") : undefined
const endTextId =
  endText || Astro.slots.has("end-text") ? ids("end-text") : undefined
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const LabelTag = label || labelSlot ? "label" : Fragment
---

<opui-number-field
  class:list={[
    "ui-number-field",
    {
      "ui-filled": variant === "filled",
      "ui-spread": spread,
      "ui-stretch": stretch,
    },
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <LabelTag class={cx([hideLabel ? "ui-sr-only" : "ui-label"])} for={inputId}
    >{label}<Fragment set:html={labelSlot}
  /></LabelTag>
  {(startText || Astro.slots.has("start-text")) && <span
    class="ui-start-text"
    id={startTextId}
  >
    {startText}
    <slot name="start-text" />
  </span>}
  <span class="ui-field">
    <span class="ui-start">
      <Button
        aria-label={decreaseLabel}
        command="--step-down"
        commandfor={inputId}
        round
      >
        <slot name="decrease-icon">
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path fill="currentColor" d={minusPath}></path>
          </svg>
        </slot>
      </Button>
    </span>
    <input
      {...rest}
      aria-describedby={idRefs(startTextId, endTextId, ariaDescribedBy)}
      aria-invalid={error ? "true" : ariaInvalid}
      id={inputId}
      name={name ?? field?.name}
      type="number"
    />
    <span class="ui-end">
      <Button
        aria-label={increaseLabel}
        command="--step-up"
        commandfor={inputId}
        round
      >
        <slot name="increase-icon">
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path fill="currentColor" d={plusPath}></path>
          </svg>
        </slot>
      </Button>
    </span>
  </span>
  {(endText || Astro.slots.has("end-text")) && <span
    class="ui-end-text"
    id={endTextId}
  >
    {endText}
    <slot name="end-text" />
  </span>}
</opui-number-field>

<script>
  import "../../elements/number-field.js"
</script>
