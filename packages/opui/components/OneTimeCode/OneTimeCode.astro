---
import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { trimEdges } from "../whitespace"

export const title = "One-Time Code"

const {
  alphanumeric,
  "aria-invalid": ariaInvalid,
  autocapitalize,
  class: className,
  endText,
  error,
  grouped,
  inputmode,
  label,
  length = 6,
  name,
  pattern,
  size,
  spellcheck,
  style,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const LabelTag = label || labelSlot ? "span" : Fragment
---

<label
  class:list={[
    "ui-text-field",
    "ui-one-time-code",
    { "ui-grouped": grouped },
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <LabelTag class="ui-label">{label}<Fragment set:html={labelSlot} /></LabelTag>
  <span class="ui-field">
    <input
      autocapitalize={
        autocapitalize ?? (alphanumeric ? "characters" : undefined)
      }
      inputmode={inputmode ?? (alphanumeric ? undefined : "numeric")}
      pattern={
        pattern ??
        (alphanumeric ? `[A-Za-z0-9]{${length}}` : `[0-9]{${length}}`)
      }
      spellcheck={spellcheck ?? (alphanumeric ? "false" : undefined)}
      {...rest}
      aria-invalid={error ? "true" : ariaInvalid}
      autocomplete="one-time-code"
      maxlength={length}
      name={name ?? field?.name}
      type="text"
    />
  </span>
  {(endText || Astro.slots.has("end-text")) && <span class="ui-end-text">
    {endText}
    <slot name="end-text" />
  </span>}
</label>
