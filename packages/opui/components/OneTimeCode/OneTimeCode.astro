---
import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { createIds, idRefs } from "../id"
import { trimEdges } from "../whitespace"

export const title = "One-Time Code"

const {
  alphanumeric,
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  autocapitalize,
  class: className,
  endText,
  error,
  grouped,
  id,
  inputmode,
  label,
  length = 6,
  name,
  pattern,
  size,
  spellcheck,
  style,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const named = Boolean(label || labelSlot)
const ids = createIds(Astro.locals, "one-time-code", id)
const inputId = named ? ids() : id
const hasEndText = Boolean(endText || Astro.slots.has("end-text"))
const endTextId = hasEndText ? ids("end-text") : undefined
---

<div
  class:list={[
    "ui-text-field",
    "ui-one-time-code",
    { "ui-grouped": grouped },
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  {named && <label class="ui-label" for={inputId}
    >{label}<Fragment set:html={labelSlot}
  /></label>}
  <span class="ui-field">
    <input
      autocapitalize={
        autocapitalize ?? (alphanumeric ? "characters" : undefined)
      }
      autocomplete="one-time-code"
      inputmode={inputmode ?? (alphanumeric ? undefined : "numeric")}
      pattern={
        pattern ??
        (alphanumeric ? `[A-Za-z0-9]{${length}}` : `[0-9]{${length}}`)
      }
      spellcheck={spellcheck ?? (alphanumeric ? "false" : undefined)}
      {...rest}
      aria-describedby={idRefs(endTextId, ariaDescribedBy)}
      aria-invalid={error ? "true" : ariaInvalid}
      id={inputId}
      maxlength={length}
      name={name ?? field?.name}
      type="text"
    />
  </span>
  {hasEndText && <span class="ui-end-text" id={endTextId}>
    {endText}
    <slot name="end-text" />
  </span>}
</div>
