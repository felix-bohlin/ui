---
import type { Props } from "./types.astro"
// A dynamic <Tag> or a custom element lets an undefined spread value remove an attribute set before it: tests/unit/tooling-bugs.test.ts
import { defined } from "../attrs"

export const title = "Password Toggle"

const { for: htmlFor, label = "Show password", ...rest } = Astro.props
---

<opui-password-toggle {...defined(rest)}>
  <button
    class="ui-button ui-round"
    type="button"
    aria-label={label}
    aria-pressed="false"
    command="--toggle-password"
    commandfor={htmlFor}
  >
    {Astro.slots.has("icon-unchecked") ? (
      <span aria-hidden="true" class="ui-icon-unchecked"
        ><slot name="icon-unchecked"
      /></span>
    ) : (
      <svg
        aria-hidden="true"
        class="ui-icon-unchecked"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      ></svg>
    )}
    {Astro.slots.has("icon-checked") ? (
      <span aria-hidden="true" class="ui-icon-checked"
        ><slot name="icon-checked"
      /></span>
    ) : (
      <svg
        aria-hidden="true"
        class="ui-icon-checked"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      ></svg>
    )}
  </button>
</opui-password-toggle>

<script>
  import "../../elements/password-toggle.js"
</script>
