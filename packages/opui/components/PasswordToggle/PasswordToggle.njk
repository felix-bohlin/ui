{% macro PasswordToggle(props = {}) %}
  {%- set rest = props | opuiRest("PasswordToggle") -%}
  {%- set label = props.label | default("Show password") -%}
  <opui-password-toggle{{ opui.defined(rest) | opuiAttributes("opui-password-toggle") }}>
    <button
      class="ui-button ui-round"
      type="button"
      {%- if label != none %} aria-label="{{ label }}"{% endif %}
      aria-pressed="false"
      command="--toggle-password"
      {%- if props.for != none %} commandfor="{{ props.for }}"{% endif %}>
      {%- if props.slots.iconUnchecked != none %}<span aria-hidden="true" class="ui-icon-unchecked">
        {{- props.slots.iconUnchecked | safe }}</span>{% else %}<svg
        aria-hidden="true"
        class="ui-icon-unchecked"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"></svg>{% endif %}
      {% if props.slots.iconChecked != none %}<span aria-hidden="true" class="ui-icon-checked">
        {{- props.slots.iconChecked | safe }}</span>{% else %}<svg
        aria-hidden="true"
        class="ui-icon-checked"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"></svg>{% endif -%}
    </button>
  </opui-password-toggle>
{%- endmacro %}
