---
import type { Props } from "./types.astro"

export const title = "Progress"

const { class: className, max, style, value, variant, ...rest } = Astro.props
---

<div
  class:list={[
    "ui-progress",
    variant && variant !== "tonal" && `ui-${variant}`,
    className,
  ]}
  style={style}
>
  <progress max={max} value={value} {...rest}>
    <slot />
  </progress>
</div>
