---
import type { RadioProps as Props } from "./types.astro"
import { FieldLabel, FieldEndText } from "@opui/astro"
import RadioInput from "./RadioInput.astro"

export const title = "Radio"

const {
  class: className,
  error,
  hideLabel,
  size,
  stack,
  ...inputProps
} = Astro.props

const { $id, currentFieldName } = Astro.locals
const endTextId = Astro.slots.has("end-text") ? $id("end-text") : undefined

const finalName = inputProps.name || currentFieldName
---

<label
  class:list={[
    "ui-radio",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  <RadioInput aria-describedby={endTextId} name={finalName} {...inputProps} />

  {
    Astro.slots.has("default") && (
      <FieldLabel hideLabel={hideLabel}>
        <slot />
      </FieldLabel>
    )
  }

  {
    Astro.slots.has("end-text") && (
      <FieldEndText id={endTextId}>
        <slot name="end-text" />
      </FieldEndText>
    )
  }
</label>
