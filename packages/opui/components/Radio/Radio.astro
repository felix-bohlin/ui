---
import type { RadioProps as Props } from "./types.astro"
import RadioInput from "./RadioInput.astro"

export const title = "Radio"

const {
  class: className,
  error,
  hideLabel,
  name,
  size,
  stack,
  ...rest
} = Astro.props

const { $id } = Astro.locals
const endTextId = Astro.slots.has("end-text") ? $id("end-text") : undefined
---

<label
  class:list={[
    "ui-radio",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
    },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  <RadioInput aria-describedby={endTextId} name={name} {...rest} />
  <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}><slot /></span>
  {
    Astro.slots.has("end-text") && (
      <span id={endTextId} class="ui-end-text">
        <slot name="end-text" />
      </span>
    )
  }
</label>
