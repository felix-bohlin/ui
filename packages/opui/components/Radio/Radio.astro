---
import type { Props } from "./types.astro"
import { hasName, warnUnnamed } from "../dev"
import RadioInput from "./RadioInput.astro"
import { cx } from "../cx"

export const title = "Radio"

const {
  "aria-invalid": ariaInvalid,
  card,
  class: className,
  endText,
  error,
  hideLabel,
  label,
  orientation,
  size,
  spread,
  style,
  variant,
  ...rest
} = Astro.props

warnUnnamed("Radio", hasName(Astro.props, Astro.slots.has("default")))
const LabelTag = label || Astro.slots.has("default") ? "span" : Fragment
---

<label
  class:list={[
    "ui-radio",
    {
      "ui-card": card,
      "ui-spread": spread,
    },
    card && variant && variant !== "outlined" && `ui-${variant}`,
    orientation && orientation !== "horizontal" && `ui-${orientation}`,
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <RadioInput {...rest} aria-invalid={error ? "true" : ariaInvalid} />
  <LabelTag class={cx([hideLabel ? "ui-sr-only" : "ui-label"])}
    >{label}<slot /></LabelTag
  >
  {
    (endText || Astro.slots.has("end-text")) && (
      <span class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
