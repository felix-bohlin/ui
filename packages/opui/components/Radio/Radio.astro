---
import type { Props } from "./types.astro"
import { warnUnnamed } from "../dev"
import { createId, idRefs } from "../id"
import RadioInput from "./RadioInput.astro"

export const title = "Radio"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  class: className,
  endText,
  error,
  hideLabel,
  size,
  spread,
  stack,
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const endTextId =
  endText || Astro.slots.has("end-text") ? $id("end-text") : undefined
const describedBy = idRefs(endTextId, ariaDescribedBy)

warnUnnamed(
  "Radio",
  Astro.slots.has("default") ||
    Astro.props["aria-label"] ||
    Astro.props["aria-labelledby"],
)
---

<label
  class:list={[
    "ui-radio",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
      "ui-spread": spread,
    },
    className,
  ]}
>
  <RadioInput
    {...rest}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : ariaInvalid}
  />
  {
    Astro.slots.has("default") && (
      <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}>
        <slot />
      </span>
    )
  }
  {
    (endText || Astro.slots.has("end-text")) && (
      <span id={endTextId} class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
