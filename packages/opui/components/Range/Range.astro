---
import type { Props } from "./types.astro"
import { createId, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { defaultValue } from "./value"

export const title = "Range"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  class: className,
  endText,
  error,
  hideLabel,
  id,
  items,
  label,
  list,
  max,
  min,
  name,
  size,
  spread,
  startText,
  step,
  style,
  value,
  valueSuffix,
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const $id = createId(Astro.locals)

const hasLabel = !!label || Astro.slots.has("label")
const hasStartText = !!startText || Astro.slots.has("start-text")
const hasEndText = !!endText || Astro.slots.has("end-text")
const hasValue = valueSuffix !== undefined || Astro.slots.has("value-text")
const hasDatalist = !!items || Astro.slots.has("datalist")
const valueText = `${value ?? defaultValue({ max, min, step })}${valueSuffix ?? ""}`

const inputId = id || (hasValue ? $id("range") : undefined)
const labelId = hasLabel ? $id("range-label") : undefined
const startTextId = hasStartText ? $id("range-start") : undefined
const endTextId = hasEndText ? $id("range-end") : undefined
const listId = list ?? (hasDatalist ? $id("range-list") : undefined)

const describedBy = idRefs(startTextId, endTextId, ariaDescribedBy)
---

<label
  class:list={[
    "ui-range",
    { "ui-spread": spread },
    size && size !== "medium" && `ui-${size}`,
    variant && variant !== "outlined" && `ui-${variant}`,
    className,
  ]}
  for={hasValue ? inputId : undefined}
  style={style}
>
  {
    hasLabel && (
      <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]} id={labelId}>
        {label}
        <slot name="label" />
      </span>
    )
  }
  {
    hasValue && (
      <output
        class="ui-value"
        data-live={Astro.slots.has("value-text") ? undefined : ""}
        for={inputId}
        data-suffix={valueSuffix}
      >
        <slot name="value-text">{valueText}</slot>
      </output>
    )
  }
  {
    hasStartText && (
      <span class="ui-start-text" id={startTextId}>
        {startText}
        <slot name="start-text" />
      </span>
    )
  }
  <input
    {...rest}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : ariaInvalid}
    aria-labelledby={labelId ?? ariaLabelledBy}
    id={inputId}
    list={listId}
    max={max}
    min={min}
    name={name ?? field?.name}
    step={step}
    type="range"
    value={value}
  />
  {
    hasDatalist && (
      <datalist aria-hidden="true" id={listId}>
        {items?.map((option) =>
          typeof option === "object" ? (
            <option value={option.value} label={option.label} />
          ) : (
            <option value={option} />
          ),
        )}
        <slot name="datalist" />
      </datalist>
    )
  }
  {
    hasEndText && (
      <span class="ui-end-text" id={endTextId}>
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>

<script>
  import { initRange } from "../../css/js/range.js"
  initRange()
</script>
