---
import type { Props } from "./types.astro"
import { createIds, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { middleValue } from "./value"

export const title = "Range"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  "aria-valuetext": ariaValueText,
  class: className,
  endText,
  error,
  hideLabel,
  id,
  items,
  label,
  list,
  max,
  min,
  name,
  size,
  spread,
  startText,
  step,
  style,
  value,
  valueSuffix,
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "range", id || undefined)

const hasLabel = !!label || Astro.slots.has("label")
const hasStartText = !!startText || Astro.slots.has("start-text")
const hasEndText = !!endText || Astro.slots.has("end-text")
const hasValueText = Astro.slots.has("value-text")
const hasValue = valueSuffix !== undefined || hasValueText
const hasDatalist = !!items || Astro.slots.has("datalist")
const current = value ?? middleValue({ max, min, step })
const readout = `${current}${valueSuffix ?? ""}`
const tick = items?.find(
  (option) =>
    typeof option === "object" && Number(option.value) === Number(current),
)
const tickLabel =
  valueSuffix || typeof tick !== "object" ? undefined : tick.label

const inputId = id || (hasValue ? ids() : undefined)
const labelId = hasLabel ? ids("label") : undefined
const startTextId = hasStartText ? ids("start-text") : undefined
const endTextId = hasEndText ? ids("end-text") : undefined
const listId = list ?? (hasDatalist ? ids("list") : undefined)

const describedBy = idRefs(startTextId, endTextId, ariaDescribedBy)
---

<label
  class:list={[
    "ui-range",
    { "ui-spread": spread },
    size && size !== "medium" && `ui-${size}`,
    variant && variant !== "outlined" && `ui-${variant}`,
    className,
  ]}
  for={hasValue ? inputId : undefined}
  style={style}
>
  {hasLabel && <span
    class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}
    id={labelId}
  >
    {label}
    <slot name="label" />
  </span>}
  {hasValue && <output
    aria-live="off"
    class="ui-value"
    data-live={hasValueText ? undefined : ""}
    for={inputId}
    data-suffix={valueSuffix}
  >
    <slot name="value-text">{readout}</slot>
  </output>}
  {hasStartText && <span class="ui-start-text" id={startTextId}>
    {startText}
    <slot name="start-text" />
  </span>}
  <input
    {...rest}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : ariaInvalid}
    aria-labelledby={labelId ?? ariaLabelledBy}
    aria-valuetext={
      ariaValueText ?? (valueSuffix && !hasValueText ? readout : tickLabel)
    }
    id={inputId}
    list={listId}
    max={max}
    min={min}
    name={name ?? field?.name}
    step={step}
    type="range"
    value={value}
  />
  {hasDatalist && <datalist aria-hidden="true" id={listId}>
    {items?.map((option) =>
      typeof option === "object" ? (
        <option value={option.value} label={option.label} />
      ) : (
        <option value={option} />
      ),
    )}
    <slot name="datalist" />
  </datalist>}
  {hasEndText && <span class="ui-end-text" id={endTextId}>
    {endText}
    <slot name="end-text" />
  </span>}
</label>

<script>
  import "../../css/js/range.js"
</script>
