---
import type { RangeProps as Props } from "./types.astro"
import { createId, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"

export const title = "Range"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  class: className,
  disabled,
  endText,
  error,
  id,
  label,
  list,
  max,
  min,
  name,
  options,
  spread,
  startText,
  step,
  style,
  value,
  valueSuffix,
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const $id = createId(Astro.locals)

const hasLabel = !!label || Astro.slots.has("default")
const hasStartText = !!startText || Astro.slots.has("start-text")
const hasEndText = !!endText || Astro.slots.has("end-text")
const hasValue = valueSuffix !== undefined || Astro.slots.has("value")
const hasDatalist = !!options || Astro.slots.has("datalist")
const defaultValue = () => {
  const minValue = Number(min ?? 0)
  const maxValue = Math.max(minValue, Number(max ?? 100))
  const stepValue = step === "any" ? 0 : Number(step ?? 1)
  const middle = minValue + (maxValue - minValue) / 2
  if (!stepValue) return middle
  const stepped =
    minValue + Math.round((middle - minValue) / stepValue) * stepValue
  return stepped > maxValue ? stepped - stepValue : stepped
}
const valueText = `${value ?? defaultValue()}${valueSuffix ?? ""}`

const inputId = id || (hasValue ? $id("range") : undefined)
const labelId = hasLabel ? $id("range-label") : undefined
const startTextId = hasStartText ? $id("range-start") : undefined
const endTextId = hasEndText ? $id("range-end") : undefined
const listId = list ?? (hasDatalist ? $id("range-list") : undefined)

const describedBy = idRefs(startTextId, endTextId, ariaDescribedBy)
---

<label
  class:list={[
    "ui-range",
    variant && `ui-${variant}`,
    { "ui-spread": spread },
    className,
  ]}
  style={style}
>
  {
    hasLabel && (
      <span class="ui-label" id={labelId}>
        {label}
        <slot />
      </span>
    )
  }
  {
    hasValue && (
      <output
        class="ui-value"
        data-live={Astro.slots.has("value") ? undefined : ""}
        for={inputId}
        data-suffix={valueSuffix}
      >
        <slot name="value">{valueText}</slot>
      </output>
    )
  }
  {
    hasStartText && (
      <span class="ui-start-text" id={startTextId}>
        {startText}
        <slot name="start-text" />
      </span>
    )
  }
  <input
    {...rest}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : ariaInvalid}
    aria-labelledby={labelId ?? ariaLabelledBy}
    disabled={disabled}
    id={inputId}
    list={listId}
    max={max}
    min={min}
    name={name ?? field?.name}
    step={step}
    type="range"
    value={value}
  />
  {
    hasDatalist && (
      <datalist id={listId}>
        {options?.map((option) =>
          typeof option === "object" ? (
            <option value={option.value} label={option.label} />
          ) : (
            <option value={option} />
          ),
        )}
        <slot name="datalist" />
      </datalist>
    )
  }
  {
    hasEndText && (
      <span class="ui-end-text" id={endTextId}>
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>

<script>
  import { initRange } from "../../css/js/range.js"
  initRange()
</script>
