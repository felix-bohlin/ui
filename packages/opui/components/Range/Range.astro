---
import type { RangeProps as Props } from "./types.astro"

export const title = "Range"

const {
  class: className,
  disabled,
  endText,
  error,
  id,
  label,
  list,
  max,
  min,
  name,
  options,
  spread,
  startText,
  step,
  value,
  valueSuffix,
  variant,
  ...rest
} = Astro.props

const { $id } = Astro.locals

const hasLabel = !!label || Astro.slots.has("default")
const hasStartText = !!startText || Astro.slots.has("start-text")
const hasEndText = !!endText || Astro.slots.has("end-text")
const hasValue = valueSuffix !== undefined || Astro.slots.has("value")
const valueText = [value, valueSuffix]
  .filter((part) => part !== undefined)
  .join("")

const inputId = id || (hasValue ? $id("range") : undefined)
const labelId = hasLabel ? $id("range-label") : undefined
const startTextId = hasStartText ? $id("range-start") : undefined
const endTextId = hasEndText ? $id("range-end") : undefined

const describedBy =
  [startTextId, endTextId].filter(Boolean).join(" ") || undefined
---

<label
  class:list={[
    "ui-range",
    variant && `ui-${variant}`,
    { "ui-spread": spread },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  {
    hasLabel && (
      <span class="ui-label" id={labelId}>
        {label}
        <slot />
      </span>
    )
  }
  {
    hasValue && (
      <output class="ui-value" for={inputId} data-suffix={valueSuffix}>
        <slot name="value">{valueText}</slot>
      </output>
    )
  }
  {
    hasStartText && (
      <span class="ui-start-text" id={startTextId}>
        {startText}
        <slot name="start-text" />
      </span>
    )
  }
  <input
    aria-describedby={describedBy}
    aria-labelledby={labelId}
    disabled={disabled}
    id={inputId}
    list={list}
    max={max}
    min={min}
    name={name}
    step={step}
    type="range"
    value={value}
    {...rest}
  />
  {
    (options || Astro.slots.has("datalist")) && (
      <datalist id={list}>
        {options?.map((option) =>
          typeof option === "object" ? (
            <option value={option.value} label={option.label} />
          ) : (
            <option value={option} />
          ),
        )}
        <slot name="datalist" />
      </datalist>
    )
  }
  {
    hasEndText && (
      <span class="ui-end-text" id={endTextId}>
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>

<script>
  // Mirror the slider's current value into its associated <output> on every
  // input event. Idempotent: each .ui-range is wired once, and ignores ranges
  // without a value display.
  for (const range of document.querySelectorAll<HTMLElement>(".ui-range")) {
    const input = range.querySelector<HTMLInputElement>('input[type="range"]')
    const output = range.querySelector<HTMLOutputElement>(
      ":scope > output.ui-value",
    )
    if (!input) continue
    const suffix = output?.dataset.suffix ?? ""
    const update = () => {
      const min = Number(input.min || 0)
      const max = Number(input.max || 100)
      const fill = ((Number(input.value) - min) / (max - min || 1)) * 100
      input.style.setProperty("--_track-fill", `${fill}%`)
      if (output) output.textContent = `${input.value}${suffix}`
    }
    input.addEventListener("input", update)
    update()
  }
</script>
