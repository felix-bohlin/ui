---
import type { Props } from "./types.astro"
import { mergeStyle, pluralLabel } from "../style"

export const title = "Rating"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  class: className,
  clearLabel = "No rating",
  disabled,
  error,
  label,
  lang,
  max = 5,
  name,
  required,
  size,
  starLabel = { one: "{count} star", other: "{count} stars" },
  style,
  value,
  ...rest
} = Astro.props

const count = Number(max)
const stars = Array.from({ length: count }, (_, index) => index + 1)
const current = Number(value)
const invalid = error ? "true" : ariaInvalid
---

{name ? (
  <fieldset
    class:list={[
      "ui-rating",
      size && size !== "medium" && `ui-${size}`,
      className,
    ]}
    disabled={disabled}
    lang={lang}
    style={style}
    {...rest}
  >
    <legend>{label}</legend>
    {!required && (
      <input
        aria-describedby={ariaDescribedBy}
        aria-invalid={invalid}
        aria-label={clearLabel}
        checked={current === 0}
        name={name}
        type="radio"
        value={0}
      />
    )}
    {stars.map((star) => (
      <input
        aria-describedby={ariaDescribedBy}
        aria-invalid={invalid}
        aria-label={pluralLabel(starLabel, star, lang)}
        checked={current === star}
        name={name}
        required={required}
        type="radio"
        value={star}
      />
    ))}
  </fieldset>
) : (
  <meter
    aria-describedby={ariaDescribedBy}
    aria-label={label}
    class:list={[
      "ui-rating",
      size && size !== "medium" && `ui-${size}`,
      className,
    ]}
    lang={lang}
    max={max}
    style={mergeStyle({ "--_max": count === 5 ? undefined : count }, style)}
    value={value ?? 0}
    {...rest}
  />
)}
