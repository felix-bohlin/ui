---
import type { Props } from "./types.astro"
import { mergeStyle } from "../style"

export const title = "Rating"

const {
  "aria-describedby": ariaDescribedBy,
  class: className,
  clearLabel = "No rating",
  disabled,
  error,
  label,
  max = 5,
  name,
  required,
  size,
  starLabel = (value: number) => (value === 1 ? "1 star" : `${value} stars`),
  style,
  value,
  ...rest
} = Astro.props

const count = Number(max)
const stars = Array.from({ length: count }, (_, index) => index + 1)
const current = Number(value)
---

{
  name ? (
    <fieldset
      class:list={["ui-rating", size && `ui-${size}`, className]}
      disabled={disabled}
      style={style}
      {...rest}
    >
      <legend>{label}</legend>
      {!required && (
        <input
          aria-describedby={ariaDescribedBy}
          aria-invalid={error ? "true" : rest["aria-invalid"]}
          aria-label={clearLabel}
          checked={current === 0}
          name={name}
          type="radio"
          value="0"
        />
      )}
      {stars.map((star) => (
        <input
          aria-describedby={ariaDescribedBy}
          aria-invalid={error ? "true" : rest["aria-invalid"]}
          aria-label={starLabel(star)}
          checked={current === star}
          name={name}
          required={required}
          type="radio"
          value={star}
        />
      ))}
    </fieldset>
  ) : (
    <meter
      aria-describedby={ariaDescribedBy}
      aria-label={label}
      class:list={["ui-rating", size && `ui-${size}`, className]}
      max={max}
      style={mergeStyle({ "--_max": count === 5 ? undefined : count }, style)}
      value={value ?? 0}
      {...rest}
    />
  )
}
