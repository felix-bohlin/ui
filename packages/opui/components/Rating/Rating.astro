---
import type { Props } from "./types.astro"
import type { HTMLAttributes } from "astro/types"
import { mergeStyle, pluralLabel } from "../style"
import { ratingOf } from "./rating"

export const title = "Rating"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-label": ariaLabel,
  class: className,
  clearLabel = "No rating",
  disabled,
  error,
  label,
  lang,
  max = 5,
  name,
  required,
  size,
  starLabel = { one: "{count} star", other: "{count} stars" },
  style,
  value,
  ...rest
} = Astro.props

const rating = ratingOf(max, value)
const invalid = error ? "true" : ariaInvalid
---

{name ? (
  <fieldset
    aria-label={ariaLabel}
    class:list={[
      "ui-rating",
      size && size !== "medium" && `ui-${size}`,
      className,
    ]}
    disabled={disabled}
    lang={lang}
    style={style}
    {...(rest as HTMLAttributes<"fieldset">)}
  >
    <legend>{label}</legend>
    {!required && (
      <input
        aria-describedby={ariaDescribedBy}
        aria-invalid={invalid}
        aria-label={clearLabel}
        checked={rating.current === 0}
        name={name}
        type="radio"
        value={0}
      />
    )}
    {rating.stars.map((star) => (
      <input
        aria-describedby={ariaDescribedBy}
        aria-invalid={invalid}
        aria-label={pluralLabel(starLabel, star, lang)}
        checked={rating.current === star}
        name={name}
        required={required}
        type="radio"
        value={star}
      />
    ))}
  </fieldset>
) : (
  <meter
    aria-describedby={ariaDescribedBy}
    aria-label={ariaLabel ?? label}
    class:list={[
      "ui-rating",
      size && size !== "medium" && `ui-${size}`,
      className,
    ]}
    lang={lang}
    max={rating.max}
    style={mergeStyle(
      { "--_max": rating.count === 5 ? undefined : rating.count },
      style,
    )}
    value={rating.value}
    {...(rest as HTMLAttributes<"meter">)}
  />
)}
