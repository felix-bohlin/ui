---
import type { SelectItem } from "./types"
import { trimEdges } from "../whitespace"
import type { Props } from "./types.astro"
import { cx } from "../cx"
import { createIds, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { sameValue } from "./selection"

export const title = "Select"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  autoFit,
  class: className,
  dense,
  endText,
  error,
  hideLabel,
  id,
  items = [],
  label,
  name,
  size,
  spread,
  startText,
  style,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const SelectedContent = "selectedcontent"
const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "select", id)
const startTextId =
  startText || Astro.slots.has("start-text") ? ids("start-text") : undefined
const endTextId =
  endText || Astro.slots.has("end-text") ? ids("end-text") : undefined
const startId = Astro.slots.has("start") ? ids("start") : undefined
const endId = Astro.slots.has("end") ? ids("end") : undefined
const topId = Astro.slots.has("top") ? ids("top") : undefined
const bottomId = Astro.slots.has("bottom") ? ids("bottom") : undefined
const describedBy = idRefs(
  startTextId,
  topId,
  startId,
  endId,
  bottomId,
  endTextId,
  ariaDescribedBy,
)
const isSelected = (item: SelectItem) =>
  value === undefined
    ? item.selected
    : Array.isArray(value)
      ? value.some((selected) => sameValue(selected, item.value))
      : sameValue(item.value, value)
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const named = Boolean(label || labelSlot)
const selectId = named ? ids() : id
---

<div
  class:list={[
    "ui-select",
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  {named && <label
    class={cx([hideLabel ? "ui-sr-only" : "ui-label"])}
    for={selectId}
    >{label}<Fragment set:html={labelSlot}
  /></label>}
  {(startText || Astro.slots.has("start-text")) && <span
    class="ui-start-text"
    id={startTextId}
  >
    {startText}
    <slot name="start-text" />
  </span>}
  <span class="ui-field">
    <select
      {...rest}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : ariaInvalid}
      aria-labelledby={ariaLabelledBy}
      id={selectId}
      name={name ?? field?.name}
    >
      <button>
        <SelectedContent />
      </button>
      <div class:list={["ui-list", { "ui-dense": dense }]}>
        {items.map((item) => <option
          selected={isSelected(item) || undefined}
          value={item.value}
        >
          {item.label}
        </option>)}
        <slot />
      </div>
    </select>
    {Astro.slots.has("start") && <span class="ui-start" id={startId}>
      <slot name="start" />
    </span>}
    {Astro.slots.has("end") && <span class="ui-end" id={endId}>
      <slot name="end" />
    </span>}
    {Astro.slots.has("top") && <span class="ui-top" id={topId}>
      <slot name="top" />
    </span>}
    {Astro.slots.has("bottom") && <span class="ui-bottom" id={bottomId}>
      <slot name="bottom" />
    </span>}
  </span>
  {(endText || Astro.slots.has("end-text")) && <span
    id={endTextId}
    class="ui-end-text"
  >
    {endText}
    <slot name="end-text" />
  </span>}
</div>
