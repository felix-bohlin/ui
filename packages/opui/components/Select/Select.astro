---
import type { SelectItem } from "./types"
import type { Props } from "./types.astro"
import { createId, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"

export const title = "Select"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  class: className,
  dense,
  endText,
  error,
  id,
  items = [],
  label,
  name,
  size,
  spread,
  startText,
  style,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const $id = createId(Astro.locals)
const labelId = $id("select-label")
const startTextId =
  startText || Astro.slots.has("start-text") ? $id("start-text") : undefined
const endTextId =
  endText || Astro.slots.has("end-text") ? $id("end-text") : undefined
const headerId = Astro.slots.has("header") ? $id("header") : undefined
const footerId = Astro.slots.has("footer") ? $id("footer") : undefined
const describedBy = idRefs(
  headerId,
  startTextId,
  endTextId,
  footerId,
  ariaDescribedBy,
)
const isSelected = (item: SelectItem) =>
  value === undefined
    ? item.selected
    : Array.isArray(value)
      ? value.some((selected) => selected === item.value)
      : item.value === value
---

<label
  class:list={[
    "ui-select",
    {
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    size && `ui-${size}`,
    className,
  ]}
  style={style}
>
  {
    (label || Astro.slots.has("label")) && (
      <span class="ui-label" id={labelId}>
        {label}
        <slot name="label" />
      </span>
    )
  }
  {
    (startText || Astro.slots.has("start-text")) && (
      <span class="ui-start-text" id={startTextId}>
        {startText}
        <slot name="start-text" />
      </span>
    )
  }
  <span class="ui-field">
    <select
      {...rest}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : ariaInvalid}
      aria-labelledby={label || Astro.slots.has("label")
        ? labelId
        : ariaLabelledBy}
      id={id}
      name={name ?? field?.name}
    >
      <button>
        <selectedcontent></selectedcontent>
      </button>
      <div class:list={["ui-list", { "ui-dense": dense }]}>
        {
          items.map((item) => (
            <option selected={isSelected(item) || undefined} value={item.value}>
              {item.text}
            </option>
          ))
        }
        <slot />
      </div>
    </select>
    {
      Astro.slots.has("prefix") && (
        <span class="ui-prefix">
          <slot name="prefix" />
        </span>
      )
    }
    {
      Astro.slots.has("suffix") && (
        <span class="ui-suffix">
          <slot name="suffix" />
        </span>
      )
    }
    {
      Astro.slots.has("header") && (
        <span class="ui-header" id={headerId}>
          <slot name="header" />
        </span>
      )
    }
    {
      Astro.slots.has("footer") && (
        <span class="ui-footer" id={footerId}>
          <slot name="footer" />
        </span>
      )
    }
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <span id={endTextId} class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
