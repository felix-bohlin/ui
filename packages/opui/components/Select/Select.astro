---
import type { Item } from "./types"
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Select"

const {
  class: className,
  dense,
  description,
  endText,
  error,
  id,
  items = [],
  label,
  name,
  size,
  spread,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const labelId = $id("select-label")
const endTextId =
  endText || Astro.slots.has("end-text") ? $id("end-text") : undefined
const isSelected = (item: Item) =>
  value === undefined
    ? item.selected
    : Array.isArray(value)
      ? value.includes(item.value)
      : item.value === value
---

<label
  class:list={[
    "ui-select",
    size && `ui-${size}`,
    {
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  {
    (label || Astro.slots.has("label")) && (
      <span class="ui-label" id={labelId}>
        {label}
        <slot name="label" />
      </span>
    )
  }
  {
    (description || Astro.slots.has("description")) && (
      <span class="ui-start-text">
        {description}
        <slot name="description" />
      </span>
    )
  }
  <span class="ui-field">
    <select
      aria-describedby={endTextId}
      aria-invalid={error ? "true" : undefined}
      aria-labelledby={label || Astro.slots.has("label") ? labelId : undefined}
      id={id}
      name={name}
      {...rest}
    >
      <button>
        <selectedcontent></selectedcontent>
      </button>
      <div class:list={["ui-list", { "ui-dense": dense }]}>
        {
          items.map((item) => (
            <option selected={isSelected(item) || undefined} value={item.value}>
              {item.text}
            </option>
          ))
        }
        <slot />
      </div>
    </select>
    {
      Astro.slots.has("prefix") && (
        <span class="ui-prefix">
          <slot name="prefix" />
        </span>
      )
    }
    {
      Astro.slots.has("suffix") && (
        <span class="ui-suffix">
          <slot name="suffix" />
        </span>
      )
    }
    {
      Astro.slots.has("header") && (
        <span class="ui-header">
          <slot name="header" />
        </span>
      )
    }
    {
      Astro.slots.has("footer") && (
        <span class="ui-footer">
          <slot name="footer" />
        </span>
      )
    }
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <span id={endTextId} class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
