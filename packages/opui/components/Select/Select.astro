---
import type { Props } from "./types.astro"
import {
  FieldLabel,
  FieldStartText,
  FieldEndText,
  FieldControl,
} from "@opui/astro"

export const title = "Select"

const {
  class: className,
  description,
  error,
  dense,
  items = [],
  label,
  spread,
  size,
  endText,
  variant = "outlined",
  ...inputProps
} = Astro.props

const { $id, currentFieldName } = Astro.locals
const selectId = inputProps.id || $id("select")
const fieldName = inputProps.name || currentFieldName
const labelId = $id("select-label")
---

<label
  class:list={[
    "ui-select",
    size && `ui-${size}`,
    {
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  {
    (label || Astro.slots.has("label")) && (
      <FieldLabel label={label} id={labelId}>
        <slot name="label" />
      </FieldLabel>
    )
  }

  {
    (description || Astro.slots.has("description")) && (
      <FieldStartText text={description}>
        <slot name="description" />
      </FieldStartText>
    )
  }

  <FieldControl>
    <slot name="prefix" slot="prefix" />
    <slot name="suffix" slot="suffix" />
    <slot name="header" slot="header" />
    <slot name="footer" slot="footer" />

    <select
      aria-labelledby={label ? labelId : undefined}
      id={selectId}
      name={fieldName}
      {...inputProps}
    >
      <button>
        <selectedcontent></selectedcontent>
      </button>
      <div class:list={["ui-list", { "ui-dense": dense }]}>
        {items.map((item) => <option value={item.value}>{item.text}</option>)}
        <slot />
      </div>
    </select>
  </FieldControl>

  {
    (endText || Astro.slots.has("end-text")) && (
      <FieldEndText text={endText} id={$id("end-text")}>
        <slot name="end-text" />
      </FieldEndText>
    )
  }
</label>
