---
import type { SelectItem } from "./types"
import { trimEdges } from "../whitespace"
import type { Props } from "./types.astro"
import { cx } from "../cx"
import { createIds, idRefs } from "../id"
import { fieldGroupContext } from "../FieldGroup/context.astro"

export const title = "Select"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  autoFit,
  class: className,
  dense,
  endText,
  error,
  hideLabel,
  id,
  items = [],
  label,
  name,
  size,
  spread,
  startText,
  style,
  value,
  variant = "outlined",
  ...rest
} = Astro.props

const SelectedContent = "selectedcontent"
const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "select", id)
const labelId = ids("label")
const startTextId =
  startText || Astro.slots.has("start-text") ? ids("start-text") : undefined
const endTextId =
  endText || Astro.slots.has("end-text") ? ids("end-text") : undefined
const topId = Astro.slots.has("top") ? ids("top") : undefined
const bottomId = Astro.slots.has("bottom") ? ids("bottom") : undefined
const describedBy = idRefs(
  topId,
  startTextId,
  endTextId,
  bottomId,
  ariaDescribedBy,
)
const isSelected = (item: SelectItem) =>
  value === undefined
    ? item.selected
    : Array.isArray(value)
      ? value.some((selected) => selected === item.value)
      : item.value === value
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const LabelTag = label || labelSlot ? "span" : Fragment
---

<label
  class:list={[
    "ui-select",
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <LabelTag class={cx([hideLabel ? "ui-sr-only" : "ui-label"])} id={labelId}
    >{label}<Fragment set:html={labelSlot} /></LabelTag
  >
  {
    (startText || Astro.slots.has("start-text")) && (
      <span class="ui-start-text" id={startTextId}>
        {startText}
        <slot name="start-text" />
      </span>
    )
  }
  <span class="ui-field">
    <select
      {...rest}
      aria-describedby={describedBy}
      aria-invalid={error ? "true" : ariaInvalid}
      aria-labelledby={label || Astro.slots.has("label")
        ? labelId
        : ariaLabelledBy}
      id={id}
      name={name ?? field?.name}
    >
      <button>
        <SelectedContent />
      </button>
      <div class:list={["ui-list", { "ui-dense": dense }]}>
        {
          items.map((item) => (
            <option selected={isSelected(item) || undefined} value={item.value}>
              {item.label}
            </option>
          ))
        }
        <slot />
      </div>
    </select>
    {
      Astro.slots.has("start") && (
        <span class="ui-start">
          <slot name="start" />
        </span>
      )
    }
    {
      Astro.slots.has("end") && (
        <span class="ui-end">
          <slot name="end" />
        </span>
      )
    }
    {
      Astro.slots.has("top") && (
        <span class="ui-top" id={topId}>
          <slot name="top" />
        </span>
      )
    }
    {
      Astro.slots.has("bottom") && (
        <span class="ui-bottom" id={bottomId}>
          <slot name="bottom" />
        </span>
      )
    }
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <span id={endTextId} class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
