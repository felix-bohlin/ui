{% macro SelectAll(props = {}) %}
  {%- set rest = props | opuiRest("SelectAll") -%}
  {%- set classes = ["ui-select-all", props.class] | opuiClass -%}
  <opui-select-all{{ opui.merge({ class: classes }, rest) | opuiAttributes("opui-select-all") }}>
    {{- caller() if caller -}}
  </opui-select-all>
{%- endmacro %}
