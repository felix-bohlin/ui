{% macro SortableTable(props = {}) %}
  {%- set props = props | opuiProps("SortableTable") -%}
  {%- set rest = props | opuiRest("SortableTable") -%}
  {%- set classes = ["ui-sortable-table", props.class] | opuiClass -%}
  <opui-sortable-table{{ opui.merge(
    {
      "ascending-label": props.ascendingLabel,
      class: classes,
      "descending-label": props.descendingLabel
    },
    opui.defined(rest)
  ) | opuiAttributes("opui-sortable-table") }}>
    {{- caller() if caller }}
    <span class="ui-sr-only" role="status"></span>
  </opui-sortable-table>
{%- endmacro %}
