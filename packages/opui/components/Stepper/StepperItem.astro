---
import type { StepperItemProps as Props } from "./types.astro"
import { trimEdges } from "../whitespace"

const {
  "aria-current": ariaCurrent,
  class: className,
  complete,
  completeLabel = ", completed",
  current,
  description,
  error,
  errorLabel = ", error",
  href,
  label,
  ...rest
} = Astro.props

const state = error ? errorLabel : complete ? completeLabel : undefined
const link = href && !current && (complete || error)
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
---

<li
  aria-current={ariaCurrent ?? (current ? "step" : undefined)}
  class:list={[{ "ui-complete": complete, "ui-error": error }, className]}
  {...rest}
>
  {Astro.slots.has("icon-complete") && <span
    aria-hidden="true"
    class="ui-icon-complete"
    ><slot name="icon-complete"
  /></span>}
  {link ? (
    <a href={href}
      >{label}<Fragment set:html={labelSlot} />{state && <span
        class="ui-sr-only"
        >{state}</span
      >}</a
    >
  ) : (
    <Fragment
      >{label}<Fragment set:html={labelSlot} />{state && <span
        class="ui-sr-only"
        >{state}</span
      >}</Fragment
    >
  )}
  {(description || Astro.slots.has("description")) && <span
    class="ui-description"
  >
    {description}
    <slot name="description" />
  </span>}
</li>
