---
import type { StepperItemProps as Props } from "./types.astro"
import { trimEdges } from "../whitespace"

const {
  "aria-current": ariaCurrent,
  class: className,
  completeLabel = ", completed",
  current,
  description,
  errorLabel = ", error",
  href,
  label,
  state,
  ...rest
} = Astro.props

const stateLabel =
  state === "error"
    ? errorLabel
    : state === "complete"
      ? completeLabel
      : undefined
const link = href && !current && state
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
---

<li
  aria-current={ariaCurrent ?? (current ? "step" : undefined)}
  class:list={[state && `ui-state-${state}`, className]}
  {...rest}
>
  {Astro.slots.has("icon-complete") && <span
    aria-hidden="true"
    class="ui-icon-complete"
    ><slot name="icon-complete"
  /></span>}
  {link ? (
    <a href={href}
      >{label}<Fragment set:html={labelSlot} />{stateLabel && <span
        class="ui-sr-only"
        >{stateLabel}</span
      >}</a
    >
  ) : (
    <Fragment
      >{label}<Fragment set:html={labelSlot} />{stateLabel && <span
        class="ui-sr-only"
        >{stateLabel}</span
      >}</Fragment
    >
  )}
  {(description || Astro.slots.has("description")) && <span
    class="ui-description"
  >
    {description}
    <slot name="description" />
  </span>}
</li>
