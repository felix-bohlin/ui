---
import SwitchInput from "./SwitchInput.astro"
import type { Props } from "./types.astro"
import { hasName, warnUnnamed } from "../dev"

export const title = "Switch"

const {
  "aria-invalid": ariaInvalid,
  card,
  class: className,
  endText,
  error,
  hideLabel,
  label,
  orientation,
  size,
  spread,
  style,
  variant,
  ...rest
} = Astro.props

warnUnnamed("Switch", hasName(Astro.props, Astro.slots.has("default")))
---

<label
  class:list={[
    "ui-switch",
    {
      "ui-card": card,
      "ui-spread": spread,
    },
    card && variant && variant !== "outlined" && `ui-${variant}`,
    orientation && orientation !== "horizontal" && `ui-${orientation}`,
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  {
    Astro.slots.has("icon-unchecked") && (
      <span class="ui-icon-unchecked" aria-hidden="true">
        <slot name="icon-unchecked" />
      </span>
    )
  }
  {
    Astro.slots.has("icon-checked") && (
      <span class="ui-icon-checked" aria-hidden="true">
        <slot name="icon-checked" />
      </span>
    )
  }
  <SwitchInput {...rest} aria-invalid={error ? "true" : ariaInvalid} />
  {
    (label || Astro.slots.has("default")) && (
      <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}>
        {label}
        <slot />
      </span>
    )
  }
  {
    (endText || Astro.slots.has("end-text")) && (
      <span class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
</label>
