---
import SwitchInput from "./SwitchInput.astro"
import type { SwitchProps as Props } from "./types.astro"
import { createId } from "../id"

export const title = "Switch"

const {
  class: className,
  error,
  hideLabel,
  name,
  size,
  spread,
  stack,
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const endTextId = Astro.slots.has("end-text") ? $id("end-text") : undefined
const describedBy =
  [endTextId, rest["aria-describedby"]].filter(Boolean).join(" ") || undefined

if (
  import.meta.env.DEV &&
  !Astro.slots.has("default") &&
  !Astro.props["aria-label"] &&
  !Astro.props["aria-labelledby"]
) {
  console.warn(
    "[OPUI Switch] Missing accessible name. Provide a default slot, and set `hideLabel` to hide it visually.",
  )
}
---

<label
  class:list={[
    "ui-switch",
    size && `ui-${size}`,
    {
      "ui-stack": stack,
      "ui-spread": spread,
    },
    className,
  ]}
  data-invalid={error ? "" : undefined}
>
  {
    Astro.slots.has("icon-unchecked") && (
      <span class="ui-icon-unchecked" aria-hidden="true">
        <slot name="icon-unchecked" />
      </span>
    )
  }
  {
    Astro.slots.has("icon-checked") && (
      <span class="ui-icon-checked" aria-hidden="true">
        <slot name="icon-checked" />
      </span>
    )
  }
  <SwitchInput
    {...rest}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : undefined}
    name={name}
  />
  {
    Astro.slots.has("default") && (
      <span class:list={[hideLabel ? "ui-sr-only" : "ui-label"]}>
        <slot />
      </span>
    )
  }
  {
    Astro.slots.has("end-text") && (
      <span id={endTextId} class="ui-end-text">
        <slot name="end-text" />
      </span>
    )
  }
</label>
