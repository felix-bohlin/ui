---
import type { ColumnProps as Props } from "./types.astro"

export const title = "Table Column"

const { style, width, ...rest } = Astro.props

const widthStyle = width
  ? `${width.includes(":") ? width : `width: ${width}`};`
  : ""
const mergedStyle =
  typeof style === "string" || !style
    ? `${widthStyle}${style ?? ""}` || undefined
    : style
---

<col style={mergedStyle} {...rest} />
