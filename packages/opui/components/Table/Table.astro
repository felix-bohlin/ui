---
import type { Props } from "./types.astro"

export const title = "Table"

const { class: className, stickyHeader, variant, ...rest } = Astro.props
---

<table
  class:list={[
    "ui-table",
    { "ui-sticky-header": stickyHeader },
    variant && `ui-${variant}`,
    className,
  ]}
  {...rest}
>
  <slot />
</table>
