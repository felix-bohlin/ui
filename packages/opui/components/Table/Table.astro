---
import type { Props } from "./types.astro"

export const title = "Table"

const { class: className, density, stickyHeader, ...rest } = Astro.props
---

<table
  class:list={[
    "ui-table",
    { "ui-sticky-header": stickyHeader },
    density && density !== "normal" && `ui-${density}`,
    className,
  ]}
  {...rest}
>
  <slot />
</table>
