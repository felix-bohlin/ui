---
import type { Props } from "./types.astro"

export const title = "Table"

const {
  class: className,
  density,
  flush,
  overflow,
  stickyHeader,
  ...rest
} = Astro.props
---

<table
  class:list={[
    "ui-table",
    { "ui-flush": flush, "ui-sticky-header": stickyHeader },
    density && density !== "normal" && `ui-${density}`,
    overflow && overflow !== "wrap" && `ui-overflow-${overflow}`,
    className,
  ]}
  {...rest}
>
  <slot />
</table>
