---
import type { Props } from "./types.astro"
import { warnUnnamedGroup } from "../dev"
import { createId } from "../id"
import { tabsContext } from "./context.astro"

export const title = "Tabs"

const idOf = createId(Astro.locals)
const {
  class: className,
  name,
  orientation,
  overflow,
  role,
  value,
  variant,
  ...rest
} = Astro.props

if (role === "radiogroup") warnUnnamedGroup("Tabs", rest)

const groupName = name || idOf("tabs")
const html = await tabsContext.provide({ groupName, value }, () =>
  Astro.slots.render("default"),
)
---

<div
  class:list={[
    "ui-tabs",
    orientation === "vertical" && "ui-vertical",
    overflow && overflow !== "scroll" && `ui-overflow-${overflow}`,
    variant && variant !== "tonal" && `ui-${variant}`,
    className,
  ]}
  role={role}
  {...rest}
>
  <Fragment set:html={html} />
</div>
