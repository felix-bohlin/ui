---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Tabs"

const $id = createId(Astro.locals)
const { class: className, name, scrollable, variant, ...rest } = Astro.props

const groupName = name || $id("tabs")
const escapedName = groupName.replaceAll("&", "&amp;").replaceAll('"', "&quot;")

const slotHtml = (await Astro.slots.render("default")) ?? ""
const html = slotHtml.replace(
  /<input\b(?=[^>]*\sclass="[^"]*\bui-tab-input\b)(?![^>]*\sname=)/g,
  () => `<input name="${escapedName}"`,
)
---

<div
  class:list={[
    "ui-tabs",
    { "ui-scrollable": scrollable },
    variant && `ui-${variant}`,
    className,
  ]}
  role="tablist"
  {...rest}
  set:html={html}
/>
