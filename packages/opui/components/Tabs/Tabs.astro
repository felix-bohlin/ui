---
import type { Props } from "./types.astro"
import { createId } from "../id"
import { tabsContext } from "./context.astro"

export const title = "Tabs"

const $id = createId(Astro.locals)
const { class: className, name, overflow, variant, ...rest } = Astro.props

const groupName = name || $id("tabs")
const html = await tabsContext.provide({ groupName }, () =>
  Astro.slots.render("default"),
)
---

<div
  class:list={[
    "ui-tabs",
    overflow && overflow !== "wrap" && `ui-overflow-${overflow}`,
    variant && variant !== "tonal" && `ui-${variant}`,
    className,
  ]}
  {...rest}
>
  <Fragment set:html={html} />
</div>
