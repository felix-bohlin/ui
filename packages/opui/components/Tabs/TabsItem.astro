---
import type { TabsItemProps as Props } from "./types.astro"
import { createId } from "../id"
import { isSelected } from "../ToggleGroup/selection"
import { warnGroupedChecked } from "../dev"
import { tabsContext } from "./context.astro"

const idOf = createId(Astro.locals)
const { checked, class: className, id, name, value, ...rest } = Astro.props

const parent = tabsContext.get()
const groupName = name || parent?.groupName || idOf("tabs")
const tabId = id || idOf("tab")
const grouped = isSelected(parent?.value, value)
warnGroupedChecked("TabsItem", grouped, checked, "Tabs")
const html = await tabsContext.provide({ groupName, tabId }, () =>
  Astro.slots.render("default"),
)
---

<input
  checked={grouped ?? checked}
  class:list={["ui-input", className]}
  id={tabId}
  name={groupName}
  type="radio"
  value={value}
  {...rest}
/>
<Fragment set:html={html} />
