---
import type { TabsItemProps as Props } from "./types.astro"
import { createId } from "../id"

const $id = createId(Astro.locals)
const {
  class: className,
  name,
  open,
  tabId = $id("tab"),
  ...rest
} = Astro.props

const escapeAttr = (value: string) =>
  value.replaceAll("&", "&amp;").replaceAll('"', "&quot;")

const slotHtml = (await Astro.slots.render("default")) ?? ""
const html = slotHtml.replace(
  /<label\b(?=[^>]*\sclass="[^"]*\bui-tab-label\b)(?![^>]*\sfor=)/g,
  () => `<label for="${escapeAttr(tabId)}"`,
)
---

<input
  checked={open}
  class:list={["ui-tab-input", className]}
  id={tabId}
  name={name}
  type="radio"
  {...rest}
/>
<Fragment set:html={html} />
