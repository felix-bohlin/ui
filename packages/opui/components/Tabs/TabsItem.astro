---
import type { TabsItemProps as Props } from "./types.astro"
import { createId } from "../id"
import { tabsContext } from "./context.astro"

const $id = createId(Astro.locals)
const { checked, class: className, name, tabId, ...rest } = Astro.props

const parent = tabsContext.get()
const groupName = name || parent?.groupName || $id("tabs")
const computedTabId = tabId || $id("tab")
const html = await tabsContext.provide(
  { groupName, tabId: computedTabId },
  () => Astro.slots.render("default"),
)
---

<input
  checked={checked}
  class:list={["ui-tab-input", className]}
  id={computedTabId}
  name={groupName}
  type="radio"
  {...rest}
/>
<Fragment set:html={html} />
