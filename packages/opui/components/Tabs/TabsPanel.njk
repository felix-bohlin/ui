{% macro TabsPanel(props = {}) %}
  {%- set props = props | opuiProps("TabsPanel") -%}
  {%- set rest = props | opuiRest("TabsPanel") -%}
  <div
    class="ui-panel
      {%- if props.class %} {{ props.class }}{% endif %}"
    {{- rest | opuiAttributes }}>
    {{- caller() if caller -}}
  </div>
{%- endmacro %}
