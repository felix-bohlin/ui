---
import Button from "../Button/Button.astro"
import { trimEdges } from "../whitespace"

import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { createIds, idRefs } from "../id"
import { cx } from "../cx"

export const title = "Text Field"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  "aria-labelledby": ariaLabelledBy,
  autoFit,
  characterCount,
  characterCountLabel,
  class: className,
  disabled,
  dropZone,
  endText,
  error,
  hideLabel,
  id,
  label,
  name,
  passwordToggle,
  passwordToggleLabel = "Show password",
  size,
  spread,
  startText,
  style,
  type = "text",
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "text-field", id)
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const hasLabel = Boolean(label || labelSlot)
const Root = passwordToggle ? "opui-text-field" : hasLabel ? "label" : "div"
const Label = passwordToggle ? "label" : "span"
const hasStartText = Boolean(startText || Astro.slots.has("start-text"))
const hasEndText = Boolean(
  endText || Astro.slots.has("end-text") || characterCount,
)
const inputId = passwordToggle ? ids() : id
const named = hasLabel && !passwordToggle
const labelId = named ? ids("label") : undefined
const startId = named && Astro.slots.has("start") ? ids("start") : undefined
const endId = named && Astro.slots.has("end") ? ids("end") : undefined
const topId = Astro.slots.has("top") ? ids("top") : undefined
const bottomId = Astro.slots.has("bottom") ? ids("bottom") : undefined
const startTextId = hasStartText ? ids("start-text") : undefined
const endTextId = hasEndText ? ids("end-text") : undefined
---

<Root
  class={cx([
    "ui-text-field",
    {
      "ui-auto-fit": autoFit,
      "ui-drop-zone": dropZone,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    size && size !== "medium" && `ui-${size}`,
    className,
  ])}
  style={style}
>
  {hasLabel && <Label
    class={cx([hideLabel ? "ui-sr-only" : "ui-label"])}
    for={passwordToggle ? inputId : undefined}
    id={labelId}
    >{label}<Fragment set:html={labelSlot}
  /></Label>}
  {hasStartText && <span class="ui-start-text" id={startTextId}>
    {startText}
    <slot name="start-text" />
  </span>}
  <span class="ui-field">
    <input
      {...rest}
      aria-describedby={idRefs(
        startTextId,
        topId,
        bottomId,
        endTextId,
        ariaDescribedBy,
      )}
      aria-invalid={error ? "true" : ariaInvalid}
      aria-labelledby={named ? idRefs(labelId, startId, endId) : ariaLabelledBy}
      disabled={disabled}
      id={inputId}
      name={name ?? field?.name}
      type={type}
    />
    {Astro.slots.has("start") && <span class="ui-start" id={startId}>
      <slot name="start" />
    </span>}
    {(Astro.slots.has("end") || passwordToggle) && <span
      class="ui-end"
      id={endId}
    >
      <slot name="end" />
      {passwordToggle && <Button
        aria-label={passwordToggleLabel}
        aria-pressed="false"
        command="--toggle-password"
        commandfor={inputId}
        disabled={disabled}
        round
      >
        {Astro.slots.has("icon-unchecked") ? (
          <span aria-hidden="true" class="ui-icon-unchecked">
            <slot name="icon-unchecked" />
          </span>
        ) : (
          <svg
            aria-hidden="true"
            class="ui-icon-unchecked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          ></svg>
        )}
        {Astro.slots.has("icon-checked") ? (
          <span aria-hidden="true" class="ui-icon-checked">
            <slot name="icon-checked" />
          </span>
        ) : (
          <svg
            aria-hidden="true"
            class="ui-icon-checked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          ></svg>
        )}
      </Button>}
    </span>}
    {Astro.slots.has("top") && <span class="ui-top" id={topId}>
      <slot name="top" />
    </span>}
    {Astro.slots.has("bottom") && <span class="ui-bottom" id={bottomId}>
      <slot name="bottom" />
    </span>}
  </span>
  {hasEndText && <span class="ui-end-text" id={endTextId}>
    {endText}
    <slot name="end-text" />
    {characterCount && (
      <opui-character-count
        aria-hidden="true"
        class="ui-value"
        label={characterCountLabel}
        set:html=""
      />
    )}
  </span>}
  <slot />
</Root>

<script>
  import "../../elements/character-count.js"
  import "../../elements/text-field.js"
</script>
