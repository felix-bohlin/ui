---
import type { Props } from "./types.astro"
import {
  FieldLabel,
  FieldStartText,
  FieldEndText,
  FieldControl,
} from "@opui/astro"

export const title = "Text Field"

const {
  autoFit,
  class: className,
  error,
  description,
  endText,
  filled,
  label,
  small,
  spread,
  startText,
  type = "text",
  ...inputProps
} = Astro.props

const startTextValue = description || startText
const { $id, currentFieldName } = Astro.locals
const fieldId = inputProps.id || $id("text-field")
const fieldName = inputProps.name || currentFieldName
---

<label
  class:list={[
    "ui-text-field",
    {
      "ui-auto-fit": autoFit,
      "ui-filled": filled,
      "ui-spread": spread,
      "ui-small": small,
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  {
    (label || Astro.slots.has("label")) && (
      <FieldLabel label={label}>
        <slot name="label" />
      </FieldLabel>
    )
  }

  {
    (startTextValue || Astro.slots.has("description")) && (
      <FieldStartText text={startTextValue}>
        <slot name="description" />
      </FieldStartText>
    )
  }

  <FieldControl>
    <slot name="prefix" slot="prefix" />
    <slot name="suffix" slot="suffix" />
    <slot name="header" slot="header" />
    <slot name="footer" slot="footer" />

    <input
      id={fieldId}
      inputmode={type === "numeric" ? "numeric" : undefined}
      name={fieldName}
      pattern={type === "numeric" ? "[0-9]*" : undefined}
      type={type === "numeric" ? "text" : type}
      {...inputProps}
    />
  </FieldControl>

  {
    (endText ||
      Astro.slots.has("end-text") ||
      Astro.slots.has("supporting-text")) && (
      <FieldEndText text={endText}>
        <slot name="end-text" />
        <slot name="supporting-text" />
      </FieldEndText>
    )
  }

  <slot />
</label>
