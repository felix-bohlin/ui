---
import type { Props } from "./types.astro"
import { fieldContext } from "../FieldGroup/context.astro"

export const title = "Text Field"

const {
  "aria-invalid": ariaInvalid,
  autoFit,
  class: className,
  description,
  disabled,
  endText,
  error,
  id,
  inputmode,
  label,
  list,
  max,
  min,
  name,
  pattern,
  placeholder,
  required,
  size,
  spread,
  step,
  style,
  type = "text",
  value,
  variant,
  ...rest
} = Astro.props

const field = fieldContext.get()
---

<label
  class:list={[
    "ui-text-field",
    size && `ui-${size}`,
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    className,
  ]}
  style={style}
>
  {
    (label || Astro.slots.has("label")) && (
      <span class="ui-label">
        {label}
        <slot name="label" />
      </span>
    )
  }
  {
    (description || Astro.slots.has("description")) && (
      <span class="ui-start-text">
        {description}
        <slot name="description" />
      </span>
    )
  }
  <span class="ui-field">
    <input
      {...rest}
      aria-invalid={error ? "true" : ariaInvalid}
      disabled={disabled}
      id={id}
      inputmode={inputmode ?? (type === "numeric" ? "numeric" : undefined)}
      list={list}
      max={max}
      min={min}
      name={name ?? field?.name}
      pattern={pattern ?? (type === "numeric" ? "[0-9]*" : undefined)}
      placeholder={placeholder}
      required={required}
      step={step}
      type={type === "numeric" ? "text" : type}
      value={value}
    />
    {
      Astro.slots.has("prefix") && (
        <span class="ui-prefix">
          <slot name="prefix" />
        </span>
      )
    }
    {
      Astro.slots.has("suffix") && (
        <span class="ui-suffix">
          <slot name="suffix" />
        </span>
      )
    }
    {
      Astro.slots.has("header") && (
        <span class="ui-header">
          <slot name="header" />
        </span>
      )
    }
    {
      Astro.slots.has("footer") && (
        <span class="ui-footer">
          <slot name="footer" />
        </span>
      )
    }
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <span class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
  <slot />
</label>
