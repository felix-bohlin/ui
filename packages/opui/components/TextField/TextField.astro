---
import type { Props } from "./types.astro"
import { renderFieldRoot } from "../Field/root.astro"

export const title = "Text Field"

const {
  autoFit,
  class: className,
  error,
  size,
  spread,
  variant,
  ...rest
} = Astro.props

const { html } = await renderFieldRoot(
  Astro.locals,
  () => Astro.slots.render("default"),
  error,
)
---

<label
  class:list={[
    "ui-text-field",
    size && `ui-${size}`,
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    className,
  ]}
  {...rest}
>
  <Fragment set:html={html} />
</label>
