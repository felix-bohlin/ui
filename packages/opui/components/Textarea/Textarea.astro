---
import type { Props } from "./types.astro"
import { trimEdges } from "../whitespace"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { createIds, idRefs } from "../id"
import { cx } from "../cx"

export const title = "Textarea"

const {
  "aria-describedby": ariaDescribedBy,
  "aria-invalid": ariaInvalid,
  autoFit,
  characterCount,
  characterCountLabel,
  class: className,
  endText,
  error,
  hideLabel,
  id,
  label,
  name,
  size,
  spread,
  startText,
  style,
  value,
  variant,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const ids = createIds(Astro.locals, "textarea", id)
const labelSlot = Astro.slots.has("label")
  ? trimEdges(await Astro.slots.render("label"))
  : ""
const LabelTag = label || labelSlot ? "span" : Fragment
const Root = label || labelSlot ? "label" : "div"
const hasStartText = Boolean(startText || Astro.slots.has("start-text"))
const hasEndText = Boolean(
  endText || Astro.slots.has("end-text") || characterCount,
)
const linked = !(label || labelSlot)
const startTextId = linked && hasStartText ? ids("start-text") : undefined
const endTextId = linked && hasEndText ? ids("end-text") : undefined
---

<Root
  class={cx([
    "ui-textarea",
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    size && size !== "medium" && `ui-${size}`,
    className,
  ])}
  style={style}
>
  <LabelTag class={cx([hideLabel ? "ui-sr-only" : "ui-label"])}
    >{label}<Fragment set:html={labelSlot}
  /></LabelTag>

  {hasStartText && <span class="ui-start-text" id={startTextId}>
    {startText}
    <slot name="start-text" />
  </span>}
  <span class="ui-field">
    <textarea
      {...rest}
      aria-describedby={idRefs(startTextId, endTextId, ariaDescribedBy)}
      aria-invalid={error ? "true" : ariaInvalid}
      id={id}
      name={name ?? field?.name}
    >{value}</textarea>
    {Astro.slots.has("start") && <span class="ui-start">
      <slot name="start" />
    </span>}
    {Astro.slots.has("end") && <span class="ui-end">
      <slot name="end" />
    </span>}
    {Astro.slots.has("top") && <span class="ui-top">
      <slot name="top" />
    </span>}
    {Astro.slots.has("bottom") && <span class="ui-bottom">
      <slot name="bottom" />
    </span>}
  </span>
  {hasEndText && <span class="ui-end-text" id={endTextId}>
    {endText}
    <slot name="end-text" />
    {characterCount && (
      <opui-character-count
        aria-hidden="true"
        class="ui-value"
        label={characterCountLabel}
        set:html=""
      />
    )}
  </span>}
  <slot />
</Root>

<script>
  import "../../elements/character-count.js"
</script>
