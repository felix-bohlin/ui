---
import type { Props } from "./types.astro"
import { fieldContext } from "../FieldGroup/context.astro"

export const title = "Textarea"

const {
  "aria-invalid": ariaInvalid,
  autoFit,
  class: className,
  cols,
  description,
  disabled,
  endText,
  error,
  id,
  label,
  maxlength,
  minlength,
  name,
  placeholder,
  required,
  rows,
  size,
  spread,
  style,
  value,
  variant,
  ...rest
} = Astro.props

const field = fieldContext.get()
---

<label
  class:list={[
    "ui-textarea",
    size && `ui-${size}`,
    {
      "ui-auto-fit": autoFit,
      "ui-filled": variant === "filled",
      "ui-spread": spread,
    },
    className,
  ]}
  style={style}
>
  {
    (label || Astro.slots.has("label")) && (
      <span class="ui-label">
        {label}
        <slot name="label" />
      </span>
    )
  }

  {
    (description || Astro.slots.has("description")) && (
      <span class="ui-start-text">
        {description}
        <slot name="description" />
      </span>
    )
  }
  <span class="ui-field">
    <textarea
      {...rest}
      aria-invalid={error ? "true" : ariaInvalid}
      cols={cols}
      disabled={disabled}
      id={id}
      maxlength={maxlength}
      minlength={minlength}
      name={name ?? field?.name}
      placeholder={placeholder}
      required={required}
      rows={rows}>{value}</textarea
    >
    {
      Astro.slots.has("prefix") && (
        <span class="ui-prefix">
          <slot name="prefix" />
        </span>
      )
    }
    {
      Astro.slots.has("suffix") && (
        <span class="ui-suffix">
          <slot name="suffix" />
        </span>
      )
    }
    {
      Astro.slots.has("header") && (
        <span class="ui-header">
          <slot name="header" />
        </span>
      )
    }
    {
      Astro.slots.has("footer") && (
        <span class="ui-footer">
          <slot name="footer" />
        </span>
      )
    }
  </span>
  {
    (endText || Astro.slots.has("end-text")) && (
      <span class="ui-end-text">
        {endText}
        <slot name="end-text" />
      </span>
    )
  }
  <slot />
</label>
