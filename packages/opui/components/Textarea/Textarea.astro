---
import type { Props } from "./types.astro"
import {
  FieldLabel,
  FieldStartText,
  FieldEndText,
  FieldControl,
} from "@opui/astro"

export const title = "Textarea"

const {
  autoFit,
  class: className,
  description,
  error,
  filled,
  label,
  spread,
  small,
  endText,
  ...inputProps
} = Astro.props

const { $id, currentFieldName } = Astro.locals
const fieldId = inputProps.id || $id("textarea")
const fieldName = inputProps.name || currentFieldName
---

<label
  class:list={[
    "ui-textarea",
    {
      "ui-auto-fit": autoFit,
      "ui-filled": filled,
      "ui-spread": spread,
      "ui-small": small,
    },
    className,
  ]}
  data-invalid={error || undefined}
>
  {
    (label || Astro.slots.has("label")) && (
      <FieldLabel label={label}>
        <slot name="label" />
      </FieldLabel>
    )
  }

  {
    (description || Astro.slots.has("description")) && (
      <FieldStartText text={description}>
        <slot name="description" />
      </FieldStartText>
    )
  }

  <FieldControl>
    <slot name="prefix" slot="prefix" />
    <slot name="suffix" slot="suffix" />
    <slot name="header" slot="header" />
    <slot name="footer" slot="footer" />

    <textarea id={fieldId} name={fieldName} {...inputProps}></textarea>
  </FieldControl>

  {
    (endText ||
      Astro.slots.has("end-text") ||
      Astro.slots.has("supporting-text")) && (
      <FieldEndText text={endText}>
        <slot name="end-text" />
        <slot name="supporting-text" />
      </FieldEndText>
    )
  }

  <slot />
</label>
