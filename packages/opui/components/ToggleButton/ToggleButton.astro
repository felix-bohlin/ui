---
import type { Props } from "./types.astro"
import { fieldContext } from "../FieldGroup/context.astro"
import { toggleGroupContext } from "../ToggleGroup/context.astro"

export const title = "Toggle Button"

const {
  class: className,
  disabled,
  label,
  name,
  pressed,
  size,
  style,
  type,
  value,
  ...rest
} = Astro.props

const field = fieldContext.get()
const group = toggleGroupContext.get()

const finalName = name || group?.groupName || field?.name
const finalType = group?.inputType === "radio" ? "radio" : (type ?? "checkbox")
---

<label
  class:list={["ui-toggle-button", size && `ui-${size}`, className]}
  style={style}
>
  <input
    checked={pressed}
    disabled={disabled}
    name={finalName}
    type={finalType}
    value={value || label}
    {...rest}
  />
  <slot>{label}</slot>
</label>
