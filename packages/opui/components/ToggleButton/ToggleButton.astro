---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Toggle Button"

const {
  class: className,
  disabled,
  label,
  name,
  pressed,
  size,
  type,
  value,
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const finalType = type || "checkbox"
const id = rest.id || $id("toggle")
---

<label
  class:list={[
    "ui-toggle-button",
    { "ui-disabled": disabled },
    size && `ui-${size}`,
    className,
  ]}
>
  <input
    checked={pressed}
    disabled={disabled}
    id={id}
    name={name}
    type={finalType}
    value={value || label}
    {...rest}
  />
  <slot>{label}</slot>
</label>
