---
import type { Props } from "./types.astro"
import { fieldGroupContext } from "../FieldGroup/context.astro"
import { toggleGroupContext } from "../ToggleGroup/context.astro"

export const title = "Toggle Button"

const {
  checked,
  class: className,
  label,
  name,
  size,
  style,
  type,
  value,
  ...rest
} = Astro.props

const field = fieldGroupContext.get()
const group = toggleGroupContext.get()

const finalName = name || group?.groupName || field?.name
const finalType = group?.inputType === "radio" ? "radio" : (type ?? "checkbox")
---

<label
  class:list={[
    "ui-toggle-button",
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  style={style}
>
  <input
    checked={checked}
    name={finalName}
    type={finalType}
    value={value}
    {...rest}
  />
  <slot>{label}</slot>
</label>
