---
import type { Props } from "./types.astro"

export const title = "Toggle Button"

const {
  class: className,
  disabled,
  label,
  name,
  pressed,
  size,
  type,
  value,
  ...rest
} = Astro.props

const { $id } = Astro.locals
const finalType = type || "checkbox"
const id = rest.id || $id("toggle")
---

<label
  class:list={[
    "ui-toggle-button",
    { "ui-disabled": disabled },
    size && `ui-${size}`,
    className,
  ]}
>
  <input
    aria-pressed={finalType === "checkbox" ? pressed : undefined}
    checked={pressed}
    disabled={disabled}
    id={id}
    name={name}
    type={finalType}
    value={value || label}
    {...rest}
  />
  <slot />
</label>
