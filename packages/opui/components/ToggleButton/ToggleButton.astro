---
import type { Props } from "./types.astro"

export const title = "Toggle Button"

const {
  class: className,
  disabled,
  label,
  name,
  pressed,
  size,
  type,
  value,
  ...rest
} = Astro.props

const finalType = type || "checkbox"
---

<label class:list={["ui-toggle-button", size && `ui-${size}`, className]}>
  <input
    checked={pressed}
    disabled={disabled}
    name={name}
    type={finalType}
    value={value || label}
    {...rest}
  />
  <slot>{label}</slot>
</label>
