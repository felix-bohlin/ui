---
import type { Props } from "./types.astro"
import { createId } from "../id"

export const title = "Toggle Group"

const {
  class: className,
  name,
  orientation,
  selection = "multiple",
  size = "default",
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const groupName = name || $id("toggle-group")
const escapedName = groupName.replaceAll("&", "&amp;").replaceAll('"', "&quot;")

const slotHtml = (await Astro.slots.render("default")) ?? ""
const html = slotHtml.replace(
  /(<label\b[^>]*\sclass="[^"]*\bui-toggle-button\b[^>]*>\s*<input\b)([^>]*)/g,
  (_, start, attrs) => {
    let inputAttrs = /\sname=/.test(attrs)
      ? attrs
      : ` name="${escapedName}"${attrs}`
    if (selection === "single") {
      inputAttrs = inputAttrs
        .replace(/\saria-pressed(="[^"]*")?/, "")
        .replace(/\stype="checkbox"/, ' type="radio"')
    }
    return start + inputAttrs
  },
)
---

<div
  class:list={[
    "ui-toggle-group",
    size !== "default" && size && `ui-${size}`,
    orientation && `ui-${orientation}`,
    className,
  ]}
  role={selection === "single" ? "radiogroup" : "group"}
  {...rest}
>
  <Fragment set:html={html} />
</div>
