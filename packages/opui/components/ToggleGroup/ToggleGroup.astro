---
import type { Props } from "./types.astro"
import { createId } from "../id"
import { toggleGroupContext } from "./context.astro"

export const title = "Toggle Group"

const {
  class: className,
  name,
  orientation,
  overflow,
  selection = "multiple",
  size,
  ...rest
} = Astro.props

const $id = createId(Astro.locals)
const groupName = name || $id("toggle-group")
const inputType = selection === "single" ? "radio" : "checkbox"
const html = await toggleGroupContext.provide({ groupName, inputType }, () =>
  Astro.slots.render("default"),
)
---

<div
  class:list={[
    "ui-toggle-group",
    {
      "ui-vertical": orientation === "vertical",
    },
    overflow && overflow !== "wrap" && `ui-overflow-${overflow}`,
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  role={selection === "single" ? "radiogroup" : "group"}
  {...rest}
>
  <Fragment set:html={html} />
</div>
