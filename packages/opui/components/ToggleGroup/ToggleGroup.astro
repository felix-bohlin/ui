---
import type { Props } from "./types.astro"
import { warnUnnamedGroup } from "../dev"
import { createId } from "../id"
import { toggleGroupContext } from "./context.astro"

export const title = "Toggle Group"

const {
  class: className,
  multiple,
  name,
  orientation,
  overflow,
  role,
  size,
  value,
  ...rest
} = Astro.props

warnUnnamedGroup("ToggleGroup", rest)

const idOf = createId(Astro.locals)
const groupName = name || idOf("toggle-group")
const inputType = multiple ? "checkbox" : "radio"
const html = await toggleGroupContext.provide(
  { groupName, inputType, value },
  () => Astro.slots.render("default"),
)
---

<div
  class:list={[
    "ui-toggle-group",
    {
      "ui-vertical": orientation === "vertical",
    },
    overflow && overflow !== "wrap" && `ui-overflow-${overflow}`,
    size && size !== "medium" && `ui-${size}`,
    className,
  ]}
  role={role ?? (multiple ? "group" : "radiogroup")}
  {...rest}
>
  <Fragment set:html={html} />
</div>
