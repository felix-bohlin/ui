---
import type { Props } from "./types.astro"

import Anchor from "../Anchor/Anchor.astro"

export const title = "Tooltip"

const { arrow, class: className, id, positionArea, ...rest } = Astro.props
---

<Anchor
  class:list={["ui-tooltip", { "ui-arrow": arrow }, className]}
  id={id}
  positionArea={positionArea}
  trigger="hover"
  {...rest}
>
  <slot />
</Anchor>
