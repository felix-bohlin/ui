{
  "name": "opui-css",
  "version": "6.0.0-rc.4",
  "description": "Design system. Components. Modern HTML & CSS. HTML, Astro, React, Svelte and Vue. The tokens started from Open Props, and the components don't need it.",
  "type": "module",
  "license": "MIT",
  "author": "Felix Bohlin",
  "homepage": "https://opui.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felix-bohlin/ui.git",
    "directory": "packages/opui"
  },
  "bugs": {
    "url": "https://github.com/felix-bohlin/ui/issues"
  },
  "keywords": [
    "astro",
    "astro-component",
    "components",
    "css",
    "design-system",
    "html",
    "open-props",
    "react",
    "react-components",
    "svelte",
    "svelte-components",
    "ui",
    "vue",
    "vue-components",
    "withastro"
  ],
  "sideEffects": [
    "*.css",
    "./css/js/*.js",
    "./elements/*.js"
  ],
  "bin": {
    "opui-css": "./bin/opui-css.mjs"
  },
  "files": [
    "astro",
    "bin",
    "components",
    "!components/AGENTS.md",
    "core",
    "css",
    "dist",
    "elements",
    "env.d.ts",
    "figma",
    "open-props.css",
    "react",
    "skills",
    "svelte",
    "themes",
    "tokens.json",
    "vue",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATING-legacy.md",
    "MIGRATING.md",
    "README.md",
    "THIRD-PARTY-NOTICES"
  ],
  "style": "./dist/opui.css",
  "svelte": "./dist/svelte/index.js",
  "exports": {
    ".": "./dist/opui.css",
    "./open-props": "./dist/op.css",
    "./open-props.css": "./open-props.css",
    "./astro": "./astro/index.ts",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./themes/*.css": "./themes/*.css",
    "./themes/*": "./themes/*.css",
    "./tokens.json": "./tokens.json",
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./components/*.react": {
      "types": "./dist/components/*.react.d.ts",
      "default": "./dist/components/*.react.js"
    },
    "./components/*.react.tsx": {
      "types": "./dist/components/*.react.d.ts",
      "default": "./dist/components/*.react.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*.svelte.js": {
      "types": "./dist/components/*.svelte.d.ts",
      "default": "./dist/components/*.svelte.js"
    },
    "./components/*.vue": {
      "types": "./dist/components/*.vue.d.ts",
      "default": "./dist/components/*.vue.js"
    },
    "./components/*": "./components/*",
    "./core/*.css": "./core/*.css",
    "./core/*": "./core/*.css",
    "./css/js/*": "./css/js/*",
    "./css/*.css": "./css/*.css",
    "./css/*": "./css/*.css",
    "./dist/*": "./dist/*",
    "./elements/*": "./elements/*",
    "./env.d.ts": "./env.d.ts",
    "./figma/*": "./figma/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "release": "node ../../scripts/release.mjs patch",
    "release:major": "node ../../scripts/release.mjs major",
    "release:minor": "node ../../scripts/release.mjs minor",
    "release:prerelease": "node ../../scripts/release.mjs prerelease"
  },
  "devDependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@types/react": "catalog:",
    "open-props": "^1.7.23",
    "postcss": "^8.5.32",
    "postcss-import": "^16.2.0",
    "svelte2tsx": "^0.7.63",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "web-features": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7",
    "open-props": "^1.7.23",
    "react": "^19",
    "react-dom": "^19",
    "svelte": "^5.57",
    "vue": "^3.5.2"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "open-props": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
