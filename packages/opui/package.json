{
  "name": "opui-css",
  "version": "6.0.0",
  "description": "Design system. Components. Modern HTML & CSS. HTML, Astro, React, Svelte and Vue. The tokens started from Open Props, and the components don't need it.",
  "type": "module",
  "license": "MIT",
  "author": "Felix Bohlin",
  "homepage": "https://open-props-ui.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felix-bohlin/ui.git",
    "directory": "packages/opui"
  },
  "bugs": {
    "url": "https://github.com/felix-bohlin/ui/issues"
  },
  "keywords": [
    "astro",
    "astro-component",
    "components",
    "css",
    "design-system",
    "html",
    "open-props",
    "react",
    "react-components",
    "svelte",
    "svelte-components",
    "ui",
    "vue",
    "vue-components",
    "withastro"
  ],
  "sideEffects": [
    "*.css",
    "./css/js/*.js"
  ],
  "bin": {
    "opui-css": "./bin/opui-css.mjs"
  },
  "files": [
    "astro",
    "bin",
    "components",
    "!components/AGENTS.md",
    "core",
    "css",
    "dist",
    "env.d.ts",
    "open-props.css",
    "react",
    "skills",
    "svelte",
    "themes",
    "tokens.json",
    "vue",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATING-legacy.md",
    "MIGRATING.md",
    "README.md"
  ],
  "style": "./dist/opui.css",
  "svelte": "./svelte/index.ts",
  "exports": {
    ".": "./dist/opui.css",
    "./open-props": "./dist/op.css",
    "./open-props.css": "./open-props.css",
    "./astro": "./astro/index.ts",
    "./react": "./react/index.ts",
    "./svelte": {
      "svelte": "./svelte/index.ts",
      "default": "./svelte/index.ts"
    },
    "./themes/*.css": "./themes/*.css",
    "./themes/*": "./themes/*.css",
    "./tokens.json": "./tokens.json",
    "./vue": "./vue/index.ts",
    "./components/*": "./components/*",
    "./core/*.css": "./core/*.css",
    "./core/*": "./core/*.css",
    "./css/js/*": "./css/js/*",
    "./css/*.css": "./css/*.css",
    "./css/*": "./css/*.css",
    "./dist/*": "./dist/*",
    "./env.d.ts": "./env.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "release": "node ../../scripts/release.mjs patch",
    "release:major": "node ../../scripts/release.mjs major",
    "release:minor": "node ../../scripts/release.mjs minor",
    "release:prerelease": "node ../../scripts/release.mjs prerelease"
  },
  "devDependencies": {
    "open-props": "^1.7.23",
    "postcss": "^8.4.0",
    "postcss-import": "^16.1.0",
    "web-features": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7",
    "open-props": "^1.7.23",
    "react": "^19",
    "react-dom": "^19",
    "svelte": "^5.29",
    "vue": "^3.5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "open-props": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
