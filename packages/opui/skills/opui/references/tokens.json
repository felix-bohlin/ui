{
  "palette": {
    "palette-chroma": {
      "$description": "Chroma of the palette source color, as a multiplier of `0.21`.",
      "$extensions": {
        "opui": {
          "cssVar": "--palette-chroma"
        }
      },
      "$value": "0.5"
    },
    "palette-hue": {
      "$description": "Hue of the palette source color in degrees. Green in light mode and blue in dark mode by default.",
      "$extensions": {
        "opui": {
          "cssVar": "--palette-hue",
          "dark": "var(--hue-blue)"
        }
      },
      "$value": "var(--hue-green)"
    },
    "palette-hue-rotate-by": {
      "$description": "Hue drift per palette step in degrees: each step rotates one more time than the last, so `1` spreads 15° across the ramp. The severity scopes use `1` for livelier tints, the brand palette `0`.",
      "$extensions": {
        "opui": {
          "cssVar": "--palette-hue-rotate-by"
        }
      },
      "$value": "0"
    },
    "palette-source": {
      "$description": "The source color the palette is derived from. Set it to replace `--palette-hue` and `--palette-chroma`. Any color works: the palette keeps its oklch hue, scales its chroma and sets the lightness per step. See [Palette](/guide/theming#palette).",
      "$extensions": {
        "opui": {
          "cssVar": "--palette-source",
          "optional": true
        }
      },
      "$value": "oklch(0.58 calc(0.21 * 0.5) var(--hue-blue))"
    },
    "gray-chroma": {
      "$description": "Chroma of the gray ramp. Raise it for tinted grays.",
      "$extensions": {
        "opui": {
          "cssVar": "--gray-chroma"
        }
      },
      "$value": "0.01"
    },
    "gray-hue": {
      "$description": "Hue of the gray ramp.",
      "$extensions": {
        "opui": {
          "cssVar": "--gray-hue"
        }
      },
      "$value": "255"
    }
  },
  "named-colors-no-severity-meaning": {
    "blue": {
      "$description": "A literal blue derived from the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--blue"
        }
      },
      "$value": "oklch(from var(--color-9) l 0.2 240)"
    },
    "green": {
      "$description": "A literal green derived from the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--green"
        }
      },
      "$value": "oklch(from var(--color-9) l 0.2 145)"
    },
    "orange": {
      "$description": "A literal orange derived from the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--orange"
        }
      },
      "$value": "oklch(from var(--color-7) l 0.2 75)"
    },
    "red": {
      "$description": "A literal red derived from the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--red"
        }
      },
      "$value": "oklch(from var(--color-9) l 0.2 25)"
    }
  },
  "intent-tokens": {
    "critical": {
      "$description": "Severity color for errors and destructive actions.",
      "$extensions": {
        "opui": {
          "cssVar": "--critical"
        }
      },
      "$value": "var(--red)"
    },
    "info": {
      "$description": "Severity color for informational messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--info"
        }
      },
      "$value": "var(--blue)"
    },
    "invalid-color": {
      "$description": "Color for invalid field borders, fills and outlines.",
      "$extensions": {
        "opui": {
          "cssVar": "--invalid-color"
        }
      },
      "$value": "var(--critical)"
    },
    "invalid-text-color": {
      "$description": "Color for validation messages and invalid labels. Lighter than `--invalid-color` in dark mode so the text stays readable.",
      "$extensions": {
        "opui": {
          "cssVar": "--invalid-text-color"
        }
      },
      "$value": "light-dark( var(--invalid-color), oklch(from var(--invalid-color) max(l, 0.75) c h) )"
    },
    "neutral": {
      "$description": "Severity color for neutral messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--neutral"
        }
      },
      "$value": "var(--gray-9)"
    },
    "success": {
      "$description": "Severity color for success messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--success"
        }
      },
      "$value": "var(--green)"
    },
    "warning": {
      "$description": "Severity color for warnings.",
      "$extensions": {
        "opui": {
          "cssVar": "--warning"
        }
      },
      "$value": "var(--orange)"
    }
  },
  "primary": {
    "primary": {
      "$description": "Brand color for primary actions and accents.",
      "$extensions": {
        "opui": {
          "cssVar": "--primary"
        }
      },
      "$value": "light-dark(var(--color-9), var(--color-6))"
    },
    "primary-contrast": {
      "$description": "Text color on `--primary`. Derived with relative color: near-black when the primary's lightness is above 0.565, near-white below, tinted with 15% of its chroma, so a custom `--primary` gets readable text.",
      "$extensions": {
        "opui": {
          "cssVar": "--primary-contrast"
        }
      },
      "$value": "oklch( from var(--primary) clamp(0.15, (0.565 - l) * 1000, 0.98) calc(c * 0.15) h )"
    },
    "primary-dark": {
      "$description": "A darker `--primary`.",
      "$extensions": {
        "opui": {
          "cssVar": "--primary-dark"
        }
      },
      "$value": "oklch(from var(--primary) calc(l * 0.75) c h)"
    },
    "primary-light": {
      "$description": "A lighter `--primary`.",
      "$extensions": {
        "opui": {
          "cssVar": "--primary-light"
        }
      },
      "$value": "oklch(from var(--primary) calc(l * 1.25) c h)"
    }
  },
  "text": {
    "text-disabled": {
      "$description": "Text color of disabled buttons and chips.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-disabled"
        }
      },
      "$value": "color-mix( in oklch, var(--text-muted) 50%, var(--surface-default) )"
    },
    "text-inverse": {
      "$description": "Text color on `--surface-inverse`.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-inverse"
        }
      },
      "$value": "light-dark(var(--gray-1), var(--gray-15))"
    },
    "text-muted": {
      "$description": "Body text color.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-muted"
        }
      },
      "$value": "light-dark(var(--gray-13), var(--gray-4))"
    },
    "text-muted-contrast": {
      "$description": "Muted text color on an inverted surface.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-muted-contrast"
        }
      },
      "$value": "light-dark(var(--gray-4), var(--gray-13))"
    },
    "text-primary": {
      "$description": "Emphasized text color for headings, labels and values.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-primary"
        }
      },
      "$value": "light-dark(var(--gray-15), var(--gray-1))"
    },
    "text-primary-contrast": {
      "$description": "Emphasized text color on an inverted surface.",
      "$extensions": {
        "opui": {
          "cssVar": "--text-primary-contrast"
        }
      },
      "$value": "light-dark(var(--gray-2), var(--gray-15))"
    }
  },
  "surfaces": {
    "surface-default": {
      "$description": "Page and card background.",
      "$extensions": {
        "opui": {
          "cssVar": "--surface-default"
        }
      },
      "$value": "light-dark(var(--gray-1), var(--gray-13))"
    },
    "surface-elevated": {
      "$description": "Background of elevated cards and accordions.",
      "$extensions": {
        "opui": {
          "cssVar": "--surface-elevated"
        }
      },
      "$value": "light-dark(var(--gray-1), var(--gray-12))"
    },
    "surface-filled": {
      "$description": "Background of filled areas such as progress tracks and table stripes.",
      "$extensions": {
        "opui": {
          "cssVar": "--surface-filled"
        }
      },
      "$value": "light-dark(var(--gray-4), var(--gray-15))"
    },
    "surface-inverse": {
      "$description": "Background of `Toast` and `Tooltip`, inverted against the page.",
      "$extensions": {
        "opui": {
          "cssVar": "--surface-inverse"
        }
      },
      "$value": "light-dark(var(--gray-15), var(--gray-2))"
    },
    "surface-tonal": {
      "$description": "Background of tonal variants.",
      "$extensions": {
        "opui": {
          "cssVar": "--surface-tonal"
        }
      },
      "$value": "light-dark(var(--gray-3), var(--gray-12))"
    }
  },
  "borders": {
    "border-color": {
      "$description": "Default border color for cards, lists, tables and dividers.",
      "$extensions": {
        "opui": {
          "cssVar": "--border-color"
        }
      },
      "$value": "light-dark(var(--gray-4), var(--gray-12))"
    },
    "border-radius": {
      "$description": "Corner radius for every component: cards, callouts, menus, buttons and fields follow it, and small parts like `kbd`, tooltips and checkboxes never get rounder than it. Set it to `0` for square corners.",
      "$extensions": {
        "opui": {
          "cssVar": "--border-radius"
        }
      },
      "$value": "var(--size-2)"
    },
    "border-width": {
      "$description": "Default border width for components that draw a border.",
      "$extensions": {
        "opui": {
          "cssVar": "--border-width"
        }
      },
      "$value": "1px"
    }
  },
  "field-input": {
    "field-border-color": {
      "$description": "Border color for `TextField`, `Select`, `Textarea`, `Radio` and `Range`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-border-color"
        }
      },
      "$value": "var(--border-color)"
    },
    "field-border-radius": {
      "$description": "Corner radius for fields. Follows `--border-radius`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-border-radius"
        }
      },
      "$value": "var(--border-radius)"
    },
    "field-border-width": {
      "$description": "Border width for fields, `Checkbox`, `Radio` and `Switch`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-border-width"
        }
      },
      "$value": "1px"
    },
    "field-helper-color": {
      "$description": "Text color for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-helper-color"
        }
      },
      "$value": "var(--text-muted)"
    },
    "field-helper-font-size": {
      "$description": "Font size for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-helper-font-size"
        }
      },
      "$value": "var(--font-size-0)"
    },
    "field-helper-line-height": {
      "$description": "Line height for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-helper-line-height"
        }
      },
      "$value": "var(--font-lineheight-3)"
    },
    "field-label-color": {
      "$description": "Text color for field labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-label-color"
        }
      },
      "$value": "var(--text-primary)"
    },
    "field-label-font-size": {
      "$description": "Font size for field labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-label-font-size"
        }
      },
      "$value": "var(--font-size-05)"
    },
    "field-label-font-weight": {
      "$description": "Font weight for emphasized field labels and legends.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-label-font-weight"
        }
      },
      "$value": "var(--font-weight-semibold)"
    },
    "field-required-color": {
      "$description": "Color of the required asterisk.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-required-color"
        }
      },
      "$value": "var(--invalid-text-color)"
    }
  },
  "focus-ring": {
    "focus-ring-color": {
      "$description": "Color of the keyboard focus ring. When unset, the ring uses the page background color inverted.",
      "$extensions": {
        "opui": {
          "cssVar": "--focus-ring-color",
          "optional": true
        }
      },
      "$value": "var(--primary)"
    },
    "focus-ring-inset": {
      "$description": "Negative offset for focus rings drawn inside a control, such as `ButtonGroup`, `List` items and `Select` options.",
      "$extensions": {
        "opui": {
          "cssVar": "--focus-ring-inset"
        }
      },
      "$value": "calc(-1 * var(--focus-ring-width))"
    },
    "focus-ring-offset": {
      "$description": "Distance between a control and its focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--focus-ring-offset"
        }
      },
      "$value": "2px"
    },
    "focus-ring-style": {
      "$description": "Outline style of the focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--focus-ring-style"
        }
      },
      "$value": "solid"
    },
    "focus-ring-width": {
      "$description": "Width of the focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--focus-ring-width"
        }
      },
      "$value": "2px"
    }
  },
  "typography": {
    "font-body": {
      "$description": "Font family for body text, fields and buttons. Defaults to Open Props `--font-sans`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-body"
        }
      },
      "$value": "var(--font-sans)"
    },
    "font-code": {
      "$description": "Font family for `code`, `kbd`, `samp` and `var`. Defaults to Open Props `--font-mono`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-code"
        }
      },
      "$value": "var(--font-mono)"
    },
    "font-heading": {
      "$description": "Font family for `h1`–`h6` and the `.ui-h1`–`.ui-h6` classes. Follows `--font-body`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-heading"
        }
      },
      "$value": "var(--font-body)"
    },
    "font-size-h1": {
      "$description": "Font size for `h1` and `.ui-h1`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h1"
        }
      },
      "$value": "var(--font-size-fluid-3)"
    },
    "font-size-h2": {
      "$description": "Font size for `h2` and `.ui-h2`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h2"
        }
      },
      "$value": "var(--font-size-fluid-2)"
    },
    "font-size-h3": {
      "$description": "Font size for `h3` and `.ui-h3`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h3"
        }
      },
      "$value": "clamp(var(--font-size-3), 4vi, var(--font-size-4))"
    },
    "font-size-h4": {
      "$description": "Font size for `h4` and `.ui-h4`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h4"
        }
      },
      "$value": "clamp(var(--font-size-2), 3vi, var(--font-size-3))"
    },
    "font-size-h5": {
      "$description": "Font size for `h5` and `.ui-h5`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h5"
        }
      },
      "$value": "var(--font-size-2)"
    },
    "font-size-h6": {
      "$description": "Font size for `h6` and `.ui-h6`.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-h6"
        }
      },
      "$value": "var(--font-size-1)"
    },
    "font-size-05": {
      "$description": "A font size between Open Props `--font-size-0` and `--font-size-1`, used for labels and compact text.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-size-05"
        }
      },
      "$value": "0.875rem"
    },
    "font-weight-normal": {
      "$description": "Font weight for `List` text and `Button` keyboard shortcuts.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-weight-normal"
        }
      },
      "$value": "var(--font-weight-4)"
    },
    "font-weight-medium": {
      "$description": "Font weight for badges, overlines and group labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-weight-medium"
        }
      },
      "$value": "var(--font-weight-5)"
    },
    "font-weight-semibold": {
      "$description": "Font weight for labels, table headers and titles.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-weight-semibold"
        }
      },
      "$value": "var(--font-weight-6)"
    },
    "font-weight-bold": {
      "$description": "Font weight for headings, buttons and terms.",
      "$extensions": {
        "opui": {
          "cssVar": "--font-weight-bold"
        }
      },
      "$value": "var(--font-weight-7)"
    },
    "rhythm-step": {
      "$description": "Vertical rhythm unit. Rich text margins and heading line heights round to it.",
      "$extensions": {
        "opui": {
          "cssVar": "--rhythm-step"
        }
      },
      "$value": "0.25rem"
    }
  },
  "spacing": {
    "space-scale": {
      "$description": "Multiplier for the `--space-*` scale, the gaps, padding and margins of containers such as cards, dialogs, forms, tables and rich text. Controls follow `--density` instead. See [Spacing](/guide/theming#spacing).",
      "$extensions": {
        "opui": {
          "cssVar": "--space-scale"
        }
      },
      "$value": "1"
    },
    "space-1": {
      "$description": "Spacing step 1: Open Props `--size-1` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-1"
        }
      },
      "$value": "calc(var(--size-1) * var(--space-scale))"
    },
    "space-2": {
      "$description": "Spacing step 2: Open Props `--size-2` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-2"
        }
      },
      "$value": "calc(var(--size-2) * var(--space-scale))"
    },
    "space-3": {
      "$description": "Spacing step 3: Open Props `--size-3` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-3"
        }
      },
      "$value": "calc(var(--size-3) * var(--space-scale))"
    },
    "space-4": {
      "$description": "Spacing step 4: Open Props `--size-4` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-4"
        }
      },
      "$value": "calc(var(--size-4) * var(--space-scale))"
    },
    "space-5": {
      "$description": "Spacing step 5: Open Props `--size-5` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-5"
        }
      },
      "$value": "calc(var(--size-5) * var(--space-scale))"
    },
    "space-6": {
      "$description": "Spacing step 6: Open Props `--size-6` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-6"
        }
      },
      "$value": "calc(var(--size-6) * var(--space-scale))"
    },
    "space-7": {
      "$description": "Spacing step 7: Open Props `--size-7` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-7"
        }
      },
      "$value": "calc(var(--size-7) * var(--space-scale))"
    },
    "space-8": {
      "$description": "Spacing step 8: Open Props `--size-8` times `--space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--space-8"
        }
      },
      "$value": "calc(var(--size-8) * var(--space-scale))"
    }
  },
  "control-sizes": {
    "density": {
      "$description": "Multiplier for the `--control-size*` scale. `0.875` is compact, `1.125` is comfortable. See [Density](/guide/theming#density).",
      "$extensions": {
        "opui": {
          "cssVar": "--density"
        }
      },
      "$value": "1"
    },
    "control-size-x-small": {
      "$description": "Shared x-small height for fields and buttons.",
      "$extensions": {
        "opui": {
          "cssVar": "--control-size-x-small"
        }
      },
      "$value": "calc(28px * var(--density))"
    },
    "control-size-small": {
      "$description": "Shared small height for fields and buttons.",
      "$extensions": {
        "opui": {
          "cssVar": "--control-size-small"
        }
      },
      "$value": "calc(32px * var(--density))"
    },
    "control-size": {
      "$description": "Shared default height for fields and buttons so they line up.",
      "$extensions": {
        "opui": {
          "cssVar": "--control-size"
        }
      },
      "$value": "calc(40px * var(--density))"
    },
    "control-size-large": {
      "$description": "Shared large height for fields and buttons.",
      "$extensions": {
        "opui": {
          "cssVar": "--control-size-large"
        }
      },
      "$value": "calc(46px * var(--density))"
    },
    "field-size-x-small": {
      "$description": "Field height with `.ui-x-small`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-size-x-small"
        }
      },
      "$value": "var(--control-size-x-small)"
    },
    "field-size-small": {
      "$description": "Field height with `.ui-small`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-size-small"
        }
      },
      "$value": "var(--control-size-small)"
    },
    "field-size": {
      "$description": "Default field height.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-size"
        }
      },
      "$value": "var(--control-size)"
    },
    "field-size-large": {
      "$description": "Field height with `.ui-large`.",
      "$extensions": {
        "opui": {
          "cssVar": "--field-size-large"
        }
      },
      "$value": "var(--control-size-large)"
    },
    "button-size-x-small": {
