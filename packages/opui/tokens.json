{
  "palette": {
    "ui-palette-chroma": {
      "$description": "Chroma of the palette source color, as a multiplier of `0.21`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-palette-chroma"
        }
      },
      "$value": "0.5"
    },
    "ui-palette-hue": {
      "$description": "Hue of the palette source color in degrees. Green in light mode and blue in dark mode by default.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-palette-hue",
          "dark": "var(--hue-blue)"
        }
      },
      "$value": "var(--hue-green)"
    },
    "ui-palette-hue-rotate-by": {
      "$description": "Hue drift per palette step in degrees: each step rotates one more time than the last, so `1` spreads 15° across the ramp. The severity scopes use `1` for livelier tints, the brand palette `0`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-palette-hue-rotate-by"
        }
      },
      "$value": "0"
    },
    "ui-palette-source": {
      "$description": "The source color the palette is derived from. Set it to replace `--ui-palette-hue` and `--ui-palette-chroma`. Any color works: the palette keeps its oklch hue, scales its chroma and sets the lightness per step. See [Palette](/guide/theming#palette).",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-palette-source",
          "optional": true
        }
      },
      "$value": "oklch(0.58 calc(0.21 * 0.5) var(--hue-blue))"
    },
    "ui-gray-chroma": {
      "$description": "Chroma of the gray ramp. Raise it for tinted grays.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-gray-chroma"
        }
      },
      "$value": "0.01"
    },
    "ui-gray-hue": {
      "$description": "Hue of the gray ramp.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-gray-hue"
        }
      },
      "$value": "255"
    }
  },
  "named-colors-no-severity-meaning": {
    "ui-blue": {
      "$description": "A literal blue, Open Props' `--hue-blue` at the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-blue"
        }
      },
      "$value": "oklch(from var(--ui-color-9) l 0.2 var(--hue-blue))"
    },
    "ui-green": {
      "$description": "A literal green, Open Props' `--hue-green` at the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-green"
        }
      },
      "$value": "oklch(from var(--ui-color-9) l 0.2 var(--hue-green))"
    },
    "ui-orange": {
      "$description": "A literal orange, Open Props' `--hue-orange` at the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-orange"
        }
      },
      "$value": "oklch(from var(--ui-color-7) l 0.2 var(--hue-orange))"
    },
    "ui-red": {
      "$description": "A literal red, Open Props' `--hue-red` at the palette lightness. No severity meaning.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-red"
        }
      },
      "$value": "oklch(from var(--ui-color-9) l 0.2 var(--hue-red))"
    }
  },
  "intent-tokens": {
    "ui-critical": {
      "$description": "Severity color for errors and destructive actions.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-critical"
        }
      },
      "$value": "var(--ui-red)"
    },
    "ui-info": {
      "$description": "Severity color for informational messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-info"
        }
      },
      "$value": "var(--ui-blue)"
    },
    "ui-invalid-color": {
      "$description": "Color for invalid field borders, fills and outlines.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-invalid-color"
        }
      },
      "$value": "var(--ui-critical)"
    },
    "ui-invalid-text-color": {
      "$description": "Color for validation messages and invalid labels. Lighter than `--ui-invalid-color` in dark mode so the text stays readable.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-invalid-text-color"
        }
      },
      "$value": "light-dark( var(--ui-invalid-color), oklch(from var(--ui-invalid-color) max(l, 0.75) c h) )"
    },
    "ui-neutral": {
      "$description": "Severity color for neutral messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-neutral"
        }
      },
      "$value": "var(--ui-gray-9)"
    },
    "ui-success": {
      "$description": "Severity color for success messages.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-success"
        }
      },
      "$value": "var(--ui-green)"
    },
    "ui-warning": {
      "$description": "Severity color for warnings.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-warning"
        }
      },
      "$value": "var(--ui-orange)"
    }
  },
  "primary": {
    "ui-primary": {
      "$description": "Brand color for primary actions and accents.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-primary"
        }
      },
      "$value": "light-dark(var(--ui-color-9), var(--ui-color-6))"
    },
    "ui-primary-contrast": {
      "$description": "Text color on `--ui-primary`. Derived with relative color: near-black when the primary's lightness is above 0.565, near-white below, tinted with 15% of its chroma, so a custom `--ui-primary` gets readable text.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-primary-contrast"
        }
      },
      "$value": "oklch( from var(--ui-primary) clamp(0.15, (0.565 - l) * 1000, 0.98) calc(c * 0.15) h )"
    },
    "ui-primary-dark": {
      "$description": "A darker `--ui-primary`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-primary-dark"
        }
      },
      "$value": "oklch(from var(--ui-primary) calc(l * 0.75) c h)"
    },
    "ui-primary-light": {
      "$description": "A lighter `--ui-primary`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-primary-light"
        }
      },
      "$value": "oklch(from var(--ui-primary) calc(l * 1.25) c h)"
    }
  },
  "text": {
    "ui-text-disabled": {
      "$description": "Text color of disabled buttons and chips.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-disabled"
        }
      },
      "$value": "color-mix( in oklch, var(--ui-text-muted) 50%, var(--ui-surface-default) )"
    },
    "ui-text-inverse": {
      "$description": "Text color on `--ui-surface-inverse`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-inverse"
        }
      },
      "$value": "light-dark(var(--ui-gray-1), var(--ui-gray-15))"
    },
    "ui-text-muted": {
      "$description": "Body text color.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-muted"
        }
      },
      "$value": "light-dark(var(--ui-gray-13), var(--ui-gray-4))"
    },
    "ui-text-muted-contrast": {
      "$description": "Muted text color on an inverted surface.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-muted-contrast"
        }
      },
      "$value": "light-dark(var(--ui-gray-4), var(--ui-gray-13))"
    },
    "ui-text-primary": {
      "$description": "Emphasized text color for headings, labels and values.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-primary"
        }
      },
      "$value": "light-dark(var(--ui-gray-15), var(--ui-gray-1))"
    },
    "ui-text-primary-contrast": {
      "$description": "Same as `--ui-text-inverse`. Kept for older themes, use `--ui-text-inverse` instead.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-text-primary-contrast"
        }
      },
      "$value": "var(--ui-text-inverse)"
    }
  },
  "surfaces": {
    "ui-surface-default": {
      "$description": "Page and card background.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-surface-default"
        }
      },
      "$value": "light-dark(var(--ui-gray-1), var(--ui-gray-13))"
    },
    "ui-surface-elevated": {
      "$description": "Background of elevated cards and accordions.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-surface-elevated"
        }
      },
      "$value": "light-dark(var(--ui-gray-1), var(--ui-gray-12))"
    },
    "ui-surface-filled": {
      "$description": "Background of filled areas such as progress tracks and table stripes.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-surface-filled"
        }
      },
      "$value": "light-dark(var(--ui-gray-4), var(--ui-gray-15))"
    },
    "ui-surface-inverse": {
      "$description": "Background of `Toast` and `Tooltip`, inverted against the page.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-surface-inverse"
        }
      },
      "$value": "light-dark(var(--ui-gray-15), var(--ui-gray-2))"
    },
    "ui-surface-tonal": {
      "$description": "Background of tonal variants.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-surface-tonal"
        }
      },
      "$value": "light-dark(var(--ui-gray-3), var(--ui-gray-12))"
    }
  },
  "borders": {
    "ui-border-radius": {
      "$description": "Corner radius for every component: cards, callouts, menus, buttons and fields follow it, and small parts like `kbd`, tooltips and checkboxes never get rounder than it. Set it to `0` for square corners. Takes a single length.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-border-radius"
        }
      },
      "$value": "var(--size-2)"
    },
    "ui-border-width": {
      "$description": "Default border width for components that draw a border.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-border-width"
        }
      },
      "$value": "1px"
    },
    "ui-border-color": {
      "$description": "Default border color for cards, lists, tables and dividers.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-border-color"
        }
      },
      "$value": "light-dark(var(--ui-gray-4), var(--ui-gray-12))"
    }
  },
  "field-input": {
    "ui-field-border-radius": {
      "$description": "Corner radius for fields. When unset, they follow `--ui-border-radius`, also where it's set on a part of the page.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-border-radius",
          "optional": true
        }
      },
      "$value": "var(--ui-border-radius)"
    },
    "ui-field-border-width": {
      "$description": "Border width for fields, `Checkbox`, `Radio` and `Switch`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-border-width"
        }
      },
      "$value": "1px"
    },
    "ui-field-helper-color": {
      "$description": "Text color for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-helper-color"
        }
      },
      "$value": "var(--ui-text-muted)"
    },
    "ui-field-helper-font-size": {
      "$description": "Font size for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-helper-font-size"
        }
      },
      "$value": "var(--font-size-0)"
    },
    "ui-field-helper-line-height": {
      "$description": "Line height for helper and end text under a field.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-helper-line-height"
        }
      },
      "$value": "var(--font-lineheight-3)"
    },
    "ui-field-label-color": {
      "$description": "Text color for field labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-label-color"
        }
      },
      "$value": "var(--ui-text-primary)"
    },
    "ui-field-label-font-size": {
      "$description": "Font size for field labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-label-font-size"
        }
      },
      "$value": "var(--ui-font-size-05)"
    },
    "ui-field-label-font-weight": {
      "$description": "Font weight for emphasized field labels and legends.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-label-font-weight"
        }
      },
      "$value": "var(--ui-font-weight-semibold)"
    },
    "ui-field-required-color": {
      "$description": "Color of the required asterisk.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-required-color"
        }
      },
      "$value": "var(--ui-invalid-text-color)"
    },
    "ui-field-border-color": {
      "$description": "Border color for `TextField`, `Select`, `Textarea`, `Radio` and `Range`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-field-border-color"
        }
      },
      "$value": "var(--ui-border-color)"
    }
  },
  "focus-ring": {
    "ui-focus-ring-color": {
      "$description": "Color of the keyboard focus ring. By default the page background color inverted.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-focus-ring-color"
        }
      },
      "$value": "rgb( from var(--ui-surface-default) calc(255 - r) calc(255 - g) calc(255 - b) )"
    },
    "ui-focus-ring-inset": {
      "$description": "Negative offset for focus rings drawn inside a control, such as `ButtonGroup`, `List` items and `Select` options.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-focus-ring-inset"
        }
      },
      "$value": "calc(-1 * var(--ui-focus-ring-width))"
    },
    "ui-focus-ring-offset": {
      "$description": "Distance between a control and its focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-focus-ring-offset"
        }
      },
      "$value": "2px"
    },
    "ui-focus-ring-style": {
      "$description": "Outline style of the focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-focus-ring-style"
        }
      },
      "$value": "solid"
    },
    "ui-focus-ring-width": {
      "$description": "Width of the focus ring.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-focus-ring-width"
        }
      },
      "$value": "2px"
    }
  },
  "typography": {
    "ui-font-body": {
      "$description": "Font family for body text, fields and buttons. Defaults to Open Props `--font-sans`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-body"
        }
      },
      "$value": "var(--font-sans)"
    },
    "ui-font-code": {
      "$description": "Font family for `code`, `kbd`, `samp` and `pre` in rich text, `.ui-kbd`, `.ui-samp`, `.ui-var`, code blocks and `kbd` in buttons and lists. Defaults to Open Props `--font-mono`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-code"
        }
      },
      "$value": "var(--font-mono)"
    },
    "ui-font-heading": {
      "$description": "Font family for `h1`–`h6` and the `.ui-h1`–`.ui-h6` classes. When unset, headings follow `--ui-font-body`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-heading",
          "optional": true
        }
      },
      "$value": "var(--ui-font-body)"
    },
    "ui-font-size-h1": {
      "$description": "Font size for `h1` and `.ui-h1`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h1"
        }
      },
      "$value": "var(--font-size-fluid-3)"
    },
    "ui-font-size-h2": {
      "$description": "Font size for `h2` and `.ui-h2`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h2"
        }
      },
      "$value": "var(--font-size-fluid-2)"
    },
    "ui-font-size-h3": {
      "$description": "Font size for `h3` and `.ui-h3`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h3"
        }
      },
      "$value": "clamp(var(--font-size-3), 4vi, var(--font-size-4))"
    },
    "ui-font-size-h4": {
      "$description": "Font size for `h4` and `.ui-h4`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h4"
        }
      },
      "$value": "clamp(var(--font-size-2), 3vi, var(--font-size-3))"
    },
    "ui-font-size-h5": {
      "$description": "Font size for `h5` and `.ui-h5`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h5"
        }
      },
      "$value": "var(--font-size-2)"
    },
    "ui-font-size-h6": {
      "$description": "Font size for `h6` and `.ui-h6`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-h6"
        }
      },
      "$value": "var(--font-size-1)"
    },
    "ui-font-size-05": {
      "$description": "A font size between Open Props `--font-size-0` and `--font-size-1`, used for labels and compact text.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-size-05"
        }
      },
      "$value": "0.875rem"
    },
    "ui-font-weight-normal": {
      "$description": "Font weight for `List` text and `Button` keyboard shortcuts.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-weight-normal"
        }
      },
      "$value": "var(--font-weight-4)"
    },
    "ui-font-weight-medium": {
      "$description": "Font weight for badges, overlines and group labels.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-weight-medium"
        }
      },
      "$value": "var(--font-weight-5)"
    },
    "ui-font-weight-semibold": {
      "$description": "Font weight for labels, table headers and titles.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-weight-semibold"
        }
      },
      "$value": "var(--font-weight-6)"
    },
    "ui-font-weight-bold": {
      "$description": "Font weight for headings, buttons and terms.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-font-weight-bold"
        }
      },
      "$value": "var(--font-weight-7)"
    },
    "ui-rhythm-step": {
      "$description": "Vertical rhythm unit. Rich text margins and heading line heights round to it.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-rhythm-step"
        }
      },
      "$value": "0.25rem"
    }
  },
  "spacing": {
    "ui-space-scale": {
      "$description": "Multiplier for the `--space-*` scale, the gaps, padding and margins of containers such as cards, dialogs, forms, tables and rich text. Controls follow `--ui-density` instead. See [Spacing](/guide/theming#spacing).",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-scale"
        }
      },
      "$value": "1"
    },
    "ui-space-1": {
      "$description": "Spacing step 1: Open Props `--size-1` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-1"
        }
      },
      "$value": "calc(var(--size-1) * var(--ui-space-scale))"
    },
    "ui-space-2": {
      "$description": "Spacing step 2: Open Props `--size-2` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-2"
        }
      },
      "$value": "calc(var(--size-2) * var(--ui-space-scale))"
    },
    "ui-space-3": {
      "$description": "Spacing step 3: Open Props `--size-3` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-3"
        }
      },
      "$value": "calc(var(--size-3) * var(--ui-space-scale))"
    },
    "ui-space-4": {
      "$description": "Spacing step 4: Open Props `--size-4` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-4"
        }
      },
      "$value": "calc(var(--size-4) * var(--ui-space-scale))"
    },
    "ui-space-5": {
      "$description": "Spacing step 5: Open Props `--size-5` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-5"
        }
      },
      "$value": "calc(var(--size-5) * var(--ui-space-scale))"
    },
    "ui-space-6": {
      "$description": "Spacing step 6: Open Props `--size-6` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-6"
        }
      },
      "$value": "calc(var(--size-6) * var(--ui-space-scale))"
    },
    "ui-space-7": {
      "$description": "Spacing step 7: Open Props `--size-7` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-7"
        }
      },
      "$value": "calc(var(--size-7) * var(--ui-space-scale))"
    },
    "ui-space-8": {
      "$description": "Spacing step 8: Open Props `--size-8` times `--ui-space-scale`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-space-8"
        }
      },
      "$value": "calc(var(--size-8) * var(--ui-space-scale))"
    }
  },
  "control-sizes": {
    "ui-density": {
      "$description": "Multiplier for the `--ui-control-size*` scale. `0.875` is compact, `1.125` is comfortable. See [Density](/guide/theming#density).",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-density"
        }
      },
      "$value": "1"
    },
    "ui-control-size-x-small": {
      "$description": "Shared x-small height for fields and buttons.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-control-size-x-small"
        }
      },
      "$value": "calc(28px * var(--ui-density))"
    },
