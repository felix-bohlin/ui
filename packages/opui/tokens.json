        }
      },
      "$value": "none"
    },
    "ui-shadow-overlay": {
      "$description": "Shadow of layers that float above the page: `Menu`, `Select` pickers, `Drawer` and `Toast`.",
      "$extensions": {
        "opui": {
          "cssVar": "--ui-shadow-overlay"
        }
      },
      "$value": "var(--shadow-3)"
    },
    "ui-shadow-raised": {
      "$description": "Shadow of raised surfaces: elevated `Card` and `Accordion`. Switches between `--ui-shadow-raised-light` and `--ui-shadow-raised-dark` with the color scheme, also in `.ui-light` and `.ui-dark` parts of the page. Set those two instead of this one.",
