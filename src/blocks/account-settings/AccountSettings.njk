{% from "opui/index.njk" import
  Avatar,
  Button,
  Card,
  CardContent,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  Field,
  FieldDescription,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  SelectButton,
  Switch,
  Tabs,
  TabsItem,
  TabsLabel,
  TabsPanel,
  ToggleButton,
  ToggleGroup
%}

<div
  class="account-settings ui-layout-container ui-layout-column ui-gap-large"
  style="--_max-inline-size: 48rem"
>
  <hgroup class="ui-hgroup">
    <h1 class="ui-h3">Account settings</h1>
    <p>Tweak your profile, your password and how Bassbook looks for you.</p>
  </hgroup>

  {% call Tabs({
    name: "account-settings-tabs",
    style: "--_panel-gap: var(--ui-space-6)",
    variant: "line"
  }) %}
    {% call TabsItem({ checked: true, id: "account-settings-tab-profile" }) %}
      {% call TabsLabel() %}Profile{% endcall %}
      {% call TabsPanel() %}
        {% call Form({ action: "#" }) %}
          {% call Fieldset() %}
            {% call FieldLegend() %}Photo{% endcall %}
            <div class="ui-layout-row acct-photo">
              {% call Avatar({
                "aria-label": "Adam Groove",
                role: "img",
                shape: "rounded"
              }) %}AG{% endcall %}
              <div class="ui-layout-row ui-gap-small">
                {% call Button({
                  size: "small",
                  type: "button",
                  variant: "outlined"
                }) %}Upload new pic{% endcall %}
                {% call Button({ size: "small", type: "button" }) %}Remove{% endcall %}
              </div>
              <p class="ui-caption">
                JPG or PNG, at least 256 × 256 px. Bass in frame encouraged!
              </p>
            </div>
          {% endcall %}

          {% call Fieldset() %}
            {% call FieldLegend() %}Personal details{% endcall %}
            {% call FieldGroup() %}
              <div class="ui-layout-grid" style="--_min-inline-size: 18rem">
                {% call Field({
                  for: "account-settings-first-name",
                  label: "First name"
                }) %}
                  <input
                    autocomplete="given-name"
                    id="account-settings-first-name"
                    name="first-name"
                    required
                    type="text"
                    value="Adam"
                  />
                {% endcall %}
                {% call Field({
                  for: "account-settings-last-name",
                  label: "Last name"
                }) %}
                  <input
                    autocomplete="family-name"
                    id="account-settings-last-name"
                    name="last-name"
                    required
                    type="text"
                    value="Groove"
                  />
                {% endcall %}
              </div>
              {% set endText %}<span class="ui-p ui-success">Verified</span>, used for
              sign-in and wall scribble alerts{% endset %}
              {% call Field({
                for: "account-settings-email",
                label: "Email",
                slots: { endText: endText }
              }) %}
                <input
                  aria-describedby="account-settings-email-end-text"
                  autocomplete="email"
                  id="account-settings-email"
                  name="email"
                  required
                  type="email"
                  value="adam@bassmail.example"
                />
              {% endcall %}
              {% call Field({
                for: "account-settings-username",
                label: "Username",
                slots: { start: "bassbook.example/" }
              }) %}
                <input
                  aria-describedby="account-settings-username-start"
                  autocomplete="username"
                  id="account-settings-username"
                  name="username"
                  type="text"
                  value="percygroove"
                />
              {% endcall %}
              {% call Field({
                for: "account-settings-bio",
                label: "Bio",
                slots: { bottom: "84 / 160" },
                startText: "Shown on your profile for the whole world to admire"
              }) %}
                <textarea
                  aria-describedby="account-settings-bio-start-text account-settings-bio-bottom"
                  id="account-settings-bio"
                  name="bio"
                  rows="3"
                >Fretless bassist in a garage band. Into flatwounds, drop D and very long root notes.</textarea>
              {% endcall %}
            {% endcall %}
          {% endcall %}

          {% call FieldGroup({ class: "acct-actions" }) %}
            {% call Button({ type: "reset" }) %}Cancel{% endcall %}
            {% call Button({ type: "submit", variant: "filled" }) %}Save my profile{% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endcall %}

    {% call TabsItem({ id: "account-settings-tab-password" }) %}
      {% call TabsLabel() %}Password{% endcall %}
      {% call TabsPanel() %}
        {% call Form({ action: "#" }) %}
          {% call Fieldset() %}
            {% call FieldLegend() %}Change password{% endcall %}
            {% call FieldDescription() %}Last changed on 12 June 2026. Wow, so fresh!{% endcall %}
            {% call FieldGroup() %}
              {% call Field({
                for: "account-settings-current-password",
                label: "Current password"
              }) %}
                <input
                  autocomplete="current-password"
                  id="account-settings-current-password"
                  name="current-password"
                  required
                  type="password"
                />
              {% endcall %}
              {% call Field({
                endText: "At least 12 characters. \"slap-that-low-B\" works great.",
                for: "account-settings-new-password",
                label: "New password"
              }) %}
                <input
                  aria-describedby="account-settings-new-password-end-text"
                  autocomplete="new-password"
                  id="account-settings-new-password"
                  minlength="12"
                  name="new-password"
                  required
                  type="password"
                />
              {% endcall %}
              {% call Field({
                for: "account-settings-confirm-password",
                label: "Confirm new password"
              }) %}
                <input
                  autocomplete="new-password"
                  id="account-settings-confirm-password"
                  name="confirm-password"
                  required
                  type="password"
                />
              {% endcall %}
            {% endcall %}
          {% endcall %}

          {% call Fieldset() %}
            {% call FieldLegend() %}Sign-in security{% endcall %}
            {% call FieldGroup() %}
              {{ Switch({
                checked: true,
                endText: "Ask for a code so nobody sneaks onto your wall.",
                label: "Two-factor authentication",
                name: "two-factor",
                spread: true
              }) }}
              {{ Switch({
                checked: true,
                endText: "Email me when a new computer signs in.",
                label: "Sign-in alerts",
                name: "sign-in-alerts",
                spread: true
              }) }}
            {% endcall %}
          {% endcall %}

          {% call FieldGroup({ class: "acct-actions" }) %}
            {% call Button({ type: "submit", variant: "filled" }) %}Update password{% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endcall %}

    {% call TabsItem({ id: "account-settings-tab-preferences" }) %}
      {% call TabsLabel() %}Preferences{% endcall %}
      {% call TabsPanel() %}
        {% call Form({ action: "#" }) %}
          {% call Fieldset() %}
            {% call FieldLegend() %}Theme{% endcall %}
            {% call ToggleGroup({
              "aria-label": "Theme",
              name: "account-settings-theme"
            }) %}
              {{ ToggleButton({ label: "Light", value: "light" }) }}
              {{ ToggleButton({ label: "Dark", value: "dark" }) }}
              {{ ToggleButton({
                checked: true,
                label: "System",
                value: "system"
              }) }}
            {% endcall %}
          {% endcall %}

          {% call Fieldset() %}
            {% call FieldLegend() %}Region{% endcall %}
            <div class="ui-layout-grid" style="--_min-inline-size: 18rem">
              {% call Field({
                for: "account-settings-language",
                label: "Language"
              }) %}
                <select id="account-settings-language" name="language">
                  {{ SelectButton() }}
                  <option value="da">Dansk</option>
                  <option value="de">Deutsch</option>
                  <option selected value="en">English</option>
                  <option value="nb">Norsk</option>
                  <option value="sv">Svenska</option>
                </select>
              {% endcall %}
              {% call Field({
                for: "account-settings-timezone",
                label: "Time zone"
              }) %}
                <select id="account-settings-timezone" name="timezone">
                  {{ SelectButton() }}
                  <option value="london">London (GMT+1)</option>
                  <option selected value="stockholm">Stockholm (GMT+2)</option>
                  <option value="helsinki">Helsinki (GMT+3)</option>
                </select>
              {% endcall %}
            </div>
          {% endcall %}

          {% call Fieldset() %}
            {% call FieldLegend() %}Accessibility{% endcall %}
            {% call FieldGroup() %}
              {{ Switch({
                label: "Reduce motion",
                name: "reduce-motion",
                spread: true
              }) }}
              {{ Switch({
                checked: true,
                label: "Always underline links",
                name: "underline-links",
                spread: true
              }) }}
            {% endcall %}
          {% endcall %}

          {% call FieldGroup({ class: "acct-actions" }) %}
            {% call Button({ type: "submit", variant: "filled" }) %}Save my prefs{% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {% call Card({
    "aria-labelledby": "account-settings-danger-heading",
    as: "section",
    class: "acct-danger",
    variant: "outlined"
  }) %}
    <hgroup>
      <h2 class="ui-h5" id="account-settings-danger-heading">Danger zone</h2>
    </hgroup>
    {% call CardContent({ class: "ui-layout-row ui-spread" }) %}
      <p>
        Deleting your account removes your profile, wall and bass photos for
        good. Save your favourite pics first! We'll miss you :(
      </p>
      {% call Button({
        color: "critical",
        command: "show-modal",
        commandfor: "account-settings-delete-dialog",
        type: "button",
        variant: "outlined"
      }) %}Delete account{% endcall %}
    {% endcall %}
  {% endcall %}

  {% call Dialog({
    "aria-describedby": "account-settings-delete-description",
    id: "account-settings-delete-dialog",
    role: "alertdialog"
  }) %}
    {% call DialogHeader() %}
      {% call DialogTitle() %}Delete your account?{% endcall %}
    {% endcall %}
    {% call DialogContent() %}
      <p id="account-settings-delete-description">
        This deletes adam@bassmail.example, your wall and every photo of your
        gear. You can't undo this.
      </p>
    {% endcall %}
    {% call DialogFooter() %}
      {% call Button({
        command: "close",
        commandfor: "account-settings-delete-dialog",
        type: "button"
      }) %}Cancel{% endcall %}
      {% call Button({
        color: "critical",
        command: "close",
        commandfor: "account-settings-delete-dialog",
        type: "button",
        variant: "filled"
      }) %}Delete account{% endcall %}
    {% endcall %}
  {% endcall %}
</div>

<style>
  .account-settings {
    container-type: inline-size;

    .acct-photo {
      .ui-avatar {
        font-size: var(--ui-font-size-600);
        inline-size: 5rem;
      }

      p {
        flex-basis: 100%;

        @container (inline-size >= 40rem) {
          flex-basis: auto;
        }
      }
    }

    .acct-actions {
      justify-content: end;
    }

    .acct-danger {
      --_outlined-border-color: var(--ui-critical-text);

      p {
        flex: 1 1 18rem;
      }
    }
  }
</style>
