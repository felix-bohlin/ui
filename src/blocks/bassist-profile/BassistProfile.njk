{% from "opui/index.njk" import
  Avatar,
  Button,
  Card,
  CardContent,
  Chip,
  DescriptionList,
  DescriptionListDescription,
  DescriptionListItem,
  DescriptionListTerm,
  List,
  ListItem,
  Reactions,
  Tabs,
  TabsItem,
  TabsLabel,
  TabsPanel
%}

<div
  class="bassist-profile ui-layout-container ui-layout-column"
  style="--_gap: var(--ui-space-6); --_max-inline-size: 64rem"
>
  <div aria-hidden="true" class="bp-cover"></div>

  <div class="bp-header ui-layout-row ui-spread">
    <div class="bp-identity ui-layout-row" style="--_gap: var(--ui-space-4)">
      {{ Avatar({
        class: "bp-avatar",
        label: "Lou Headstock",
        size: "large",
        src: "/photos/lou-headstock.png"
      }) }}
      <hgroup class="ui-hgroup">
        <h1 class="bp-name">Lou Headstock</h1>
        <p>@flatwoundlou, Gothenburg</p>
      </hgroup>
    </div>
    <div class="ui-layout-row ui-gap-small">
      {% call Button({ href: "#bassist-profile-message", variant: "outlined" }) %}Message{% endcall %}
      {% call Button({ type: "button", variant: "filled" }) %}Follow{% endcall %}
    </div>
  </div>

  <div
    class="ui-layout-columns"
    style="--_columns: 2fr 3fr; --_gap: var(--ui-space-6)"
  >
    <div class="ui-layout-column" style="--_gap: var(--ui-space-6)">
      <p>
        Fretless on Sundays, five-string the rest of the week. I play in The
        Flatwounds and teach anyone who asks nicely.
      </p>
      <dl class="bp-stats ui-layout-row" style="--_gap: var(--ui-space-6)">
        <div>
          <dt>Followers</dt>
          <dd>2 413</dd>
        </div>
        <div>
          <dt>Following</dt>
          <dd>318</dd>
        </div>
        <div>
          <dt>Gigs</dt>
          <dd>87</dd>
        </div>
      </dl>
      <ul aria-label="Styles" class="ui-layout-row ui-gap-x-small">
        <li>{{ Chip({ as: "span", label: "Five-string", size: "small" }) }}</li>
        <li>{{ Chip({ as: "span", label: "Fretless", size: "small" }) }}</li>
        <li>{{ Chip({ as: "span", label: "Funk", size: "small" }) }}</li>
        <li>{{ Chip({ as: "span", label: "Teaches", size: "small" }) }}</li>
      </ul>
      {% call Card({
        "aria-labelledby": "bassist-profile-gear-heading",
        as: "section",
        variant: "outlined"
      }) %}
        <hgroup>
          <h2 class="ui-h6" id="bassist-profile-gear-heading">Gear</h2>
          <p>What Lou plays through.</p>
        </hgroup>
        {% call CardContent() %}
          {% call DescriptionList({
            leader: "dotted",
            orientation: "horizontal"
          }) %}
            {% call DescriptionListItem() %}
              {% call DescriptionListTerm() %}Bass{% endcall %}
              {% call DescriptionListDescription() %}Jazz Bass, 1978{% endcall %}
            {% endcall %}
            {% call DescriptionListItem() %}
              {% call DescriptionListTerm() %}Strings{% endcall %}
              {% call DescriptionListDescription() %}Flatwounds, 45 to 105{% endcall %}
            {% endcall %}
            {% call DescriptionListItem() %}
              {% call DescriptionListTerm() %}Amp{% endcall %}
              {% call DescriptionListDescription() %}Very tall, very loud{% endcall %}
            {% endcall %}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    </div>

    {% call Tabs({ name: "bassist-profile-tabs", variant: "line" }) %}
      {% call TabsItem({ checked: true, id: "bassist-profile-tab-wall" }) %}
        {% call TabsLabel() %}Wall{% endcall %}
        {% call TabsPanel() %}
          <div class="ui-layout-column" style="--_gap: var(--ui-space-4)">
            {% call Card({
              as: "article",
              class: "bp-post",
              variant: "outlined"
            }) %}
              {% call CardContent() %}
                <div class="ui-layout-media ui-gap-small">
                  {{ Avatar({
                    label: "Lou Headstock",
                    src: "/photos/lou-headstock.png"
                  }) }}
                  <div>
                    <p><strong>Lou Headstock</strong></p>
                    <p class="ui-caption">
                      <time datetime="2026-11-24T21:40">Monday, 21:40</time>
                    </p>
                  </div>
                </div>
                <p>
                  Recorded the new walking line for Root Note Romance in one
                  take. Then I recorded it eleven more times, just to be sure.
                </p>
                <div class="bp-attachment ui-layout-media ui-gap-small">
                  <span aria-hidden="true" class="bp-attachment-art"></span>
                  <span class="ui-layout-column ui-gap-x-small">
                    <strong>Root Note Romance, bass only</strong>
                    <span class="ui-caption">2:58</span>
                  </span>
                </div>
                {{ Reactions({
                  "aria-label": "Reactions",
                  id: "bassist-profile-reactions-1",
                  items: [
                    {
                      "aria-label": "Fire, 24",
                      checked: true,
                      label: "🔥 24",
                      value: "fire"
                    },
                    { "aria-label": "Heart, 9", label: "❤️ 9", value: "heart" }
                  ],
                  name: "bassist-profile-reaction-1"
                }) }}
              {% endcall %}
            {% endcall %}
            {% call Card({
              as: "article",
              class: "bp-post",
              variant: "outlined"
            }) %}
              {% call CardContent() %}
                <div class="ui-layout-media ui-gap-small">
                  {{ Avatar({
                    label: "Percy Groove",
                    src: "/photos/percy-groove.png"
                  }) }}
                  <div>
                    <p><strong>Percy Groove</strong></p>
                    <p class="ui-caption">
                      <time datetime="2026-11-22T10:05">Saturday, 10:05</time>
                    </p>
                  </div>
                </div>
                <p>
                  Lou taught me the thumb mute in ten minutes. My neighbours
                  would like a word with Lou.
                </p>
                {{ Reactions({
                  "aria-label": "Reactions",
                  id: "bassist-profile-reactions-2",
                  items: [
                    {
                      "aria-label": "Laughing, 31",
                      label: "😂 31",
                      value: "laugh"
                    }
                  ],
                  name: "bassist-profile-reaction-2"
                }) }}
              {% endcall %}
            {% endcall %}
          </div>
        {% endcall %}
      {% endcall %}
      {% call TabsItem({ id: "bassist-profile-tab-gigs" }) %}
        {% call TabsLabel() %}Upcoming gigs{% endcall %}
        {% call TabsPanel() %}
          {% call List({ bordered: true, variant: "transparent" }) %}
            {% set end %}<span class="ui-caption">7 Dec</span>{% endset %}
            {{ ListItem({
              description: "Café Fretless, Malmö",
              label: "Sunday jam",
              slots: { end: end }
            }) }}
            {% set end %}<span class="ui-caption">20 Mar</span>{% endset %}
            {{ ListItem({
              description: "The Rehearsal Basement",
              label: "Percy's 40th",
              slots: { end: end }
            }) }}
            {% set end %}<span class="ui-caption">12 Jun</span>{% endset %}
            {{ ListItem({
              description: "Harbour Stage, Gothenburg",
              label: "Bassquake Festival",
              slots: { end: end }
            }) }}
          {% endcall %}
        {% endcall %}
      {% endcall %}
    {% endcall %}
  </div>
</div>

<style>
  .bassist-profile {
    container-type: inline-size;

    .bp-cover {
      aspect-ratio: 4 / 1;
      background-color: oklch(from var(--ui-primary) 0.3 0.08 h);
      background-image:
        radial-gradient(
          ellipse 30% 90% at 20% 0,
          oklch(from var(--ui-primary) 0.85 0.12 calc(h + 60) / 70%),
          transparent
        ),
        radial-gradient(
          ellipse 25% 80% at 55% 0,
          oklch(from var(--ui-primary) 0.8 0.12 calc(h + 180) / 60%),
          transparent
        ),
        radial-gradient(
          ellipse 30% 90% at 85% 0,
          oklch(from var(--ui-primary) 0.85 0.12 calc(h + 300) / 70%),
          transparent
        ),
        linear-gradient(transparent 60%, oklch(0.15 0.02 260 / 60%));
      border-radius: var(--ui-radius);
      min-block-size: 7rem;
    }

    .bp-header {
      align-items: end;
      padding-inline: var(--ui-space-5);
    }

    .bp-identity {
      align-items: end;
    }

    .bp-avatar {
      --_size: 7rem;

      border: var(--ui-border-width-large) solid var(--ui-surface);
      box-shadow: var(--ui-shadow-elevated);
      margin-block-start: calc(-1 * var(--ui-space-8));
    }

    .bp-name {
      color: var(--ui-text-strong);
      font-size: var(--ui-font-size-700);
      line-height: var(--ui-line-height-tight);
    }

    .bp-stats {
      margin: 0;

      div {
        display: grid;
      }

      dt {
        color: var(--ui-text-subtle);
        font-size: var(--ui-font-size-caption);
        order: 2;
      }

      dd {
        color: var(--ui-text-strong);
        font-size: var(--ui-font-size-large);
        font-variant-numeric: tabular-nums;
        font-weight: var(--ui-font-weight-bold);
        margin: 0;
      }
    }

    .bp-post .ui-content {
      display: grid;
      gap: var(--ui-space-4);
    }

    .bp-attachment {
      align-items: center;
      background-color: var(--ui-surface-tonal);
      border-radius: var(--ui-radius);
      padding: var(--ui-space-3);
    }

    .bp-attachment-art {
      aspect-ratio: 1;
      background-color: oklch(0.2 0.01 260);
      background-image:
        radial-gradient(
          circle,
          var(--ui-primary) 0 18%,
          oklch(0.2 0.01 260) 19% 22%,
          transparent 23%
        ),
        repeating-radial-gradient(
          circle,
          transparent 0 3px,
          oklch(1 0 0 / 8%) 3px 4px
        );
      border-radius: var(--ui-radius-small);
      inline-size: 3rem;
    }
  }
</style>

<script type="module">
  import "opui-css/elements/reactions.js"
</script>
