{% from "opui/index.njk" import
  Avatar,
  Button,
  Card,
  CardContent,
  Chip,
  Drawer,
  DrawerHeader,
  DrawerTitle,
  Field,
  FieldGroup,
  List,
  ListItem,
  Menu,
  Message,
  MessageList
%}

<div class="chat">
  <div class="ui-layout-columns" style="--_columns: 20rem 1fr; --_gap: 0">
    <aside aria-labelledby="chat-conversations-heading" class="chat-sidebar">
      <div class="ui-layout-column chat-sidebar-header">
        <div class="ui-layout-row ui-spread">
          <h2 class="ui-h5" id="chat-conversations-heading">Messages</h2>
          {% call Button({
            "aria-label": "New message",
            round: true,
            size: "small",
            type: "button"
          }) %}<svg
              data-icon="edit"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75z"
              ></path>
            </svg>{% endcall %}
        </div>
        {% set start %}<svg
          data-icon="search"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14"
          ></path>
        </svg>{% endset %}
        {% call Field({
          for: "chat-search",
          size: "small",
          slots: { start: start }
        }) %}
          <input
            aria-label="Search messages"
            id="chat-search"
            name="chat-search"
            placeholder="Search"
            type="search"
          />
        {% endcall %}
      </div>
      {% call List({ variant: "transparent" }) %}
        {% set start %}{% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}{% endset %}
        {{ ListItem({
          "aria-current": "page",
          description: "Nobody will hear it, but WE will know",
          href: "#chat-ellen",
          label: "Ellen Nut",
          slots: { end: "14:32", start: start }
        }) }}
        {% set start %}{% call Avatar({ "aria-label": "Bassists Anonymous", role: "img" }) %}BA{% endcall %}{% endset %}
        {% set label %}<strong>Bassists Anonymous</strong>{% endset %}
        {% set end %}<span class="chat-unread">3 <span class="ui-sr-only">unread</span></span>{% endset %}
        {{ ListItem({
          description: "Scott: Rate my new 5-string!! 😍",
          href: "#chat-bassists-anonymous",
          slots: { end: end, label: label, start: start }
        }) }}
        {% set start %}{% call Avatar({ "aria-label": "Adam Groove", role: "img" }) %}AG{% endcall %}{% endset %}
        {{ ListItem({
          description: "Is it normal that my band booked a gig without me?",
          href: "#chat-adam",
          label: "Adam Groove",
          slots: { end: "11:05", start: start }
        }) }}
        {% set start %}{% call Avatar({ "aria-label": "Mohini Hertz", role: "img" }) %}MH{% endcall %}{% endset %}
        {{ ListItem({
          description: "You: Pick or fingers? Fight me :P",
          href: "#chat-mohini",
          label: "Mohini Hertz",
          slots: { end: "Mon", start: start }
        }) }}
        {% set start %}{% call Avatar({ "aria-label": "Mixed Too Low", role: "img" }) %}MT{% endcall %}{% endset %}
        {{ ListItem({
          description: "Kinga: My singer called me \"the tall guitarist\" again",
          href: "#chat-mixed-too-low",
          label: "Mixed Too Low",
          slots: { end: "Sun", start: start }
        }) }}
      {% endcall %}
    </aside>

    <main>
      <header class="ui-layout-row chat-thread-header">
        {% call Button({
          "aria-label": "Show conversations",
          class: "chat-conversations-button",
          command: "show-modal",
          commandfor: "chat-drawer",
          round: true,
          size: "small",
          type: "button"
        }) %}<svg
            data-icon="arrow-left"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z"
            ></path>
          </svg>{% endcall %}
        {% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}
        <hgroup>
          <h1 class="ui-h6">Ellen Nut</h1>
          <p>
            {{ Chip({
              as: "span",
              dot: true,
              label: "Online",
              severity: "success",
              size: "small"
            }) }}
          </p>
        </hgroup>
        <div class="ui-layout-row ui-gap-x-small">
          {% call Button({
            "aria-label": "Start call",
            round: true,
            size: "small",
            type: "button"
          }) %}<svg
              data-icon="phone"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1A17 17 0 0 1 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02z"
              ></path>
            </svg>{% endcall %}
          {% call Button({
            "aria-label": "Conversation options",
            command: "toggle-popover",
            commandfor: "chat-options",
            round: true,
            size: "small",
            type: "button"
          }) %}<svg
              data-icon="more-vertical"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m0 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4m0 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4"
              ></path>
            </svg>{% endcall %}
          {{ Menu({
            align: "end",
            id: "chat-options",
            items: [
              { label: "Mute notifications" },
              { label: "Search in conversation" },
              {
                borderTop: true,
                color: "critical",
                label: "Delete conversation"
              }
            ]
          }) }}
        </div>
      </header>

      {% call MessageList({
        "aria-label": "Messages with Ellen Nut",
        class: "chat-message-list",
        direct: true
      }) %}
        <li class="ui-divider">Today</li>
        {% set start %}{% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}{% endset %}
        {% call Message({
          author: "Ellen",
          datetime: "2026-10-08T14:02",
          slots: { start: start },
          time: "14:02"
        }) %}
          <p>Heyyy! Did your band notice you changed strings yet?</p>
        {% endcall %}
        {% call Message({
          author: "You",
          datetime: "2026-10-08T14:18",
          outgoing: true,
          time: "14:18"
        }) %}
          <p>
            Nope! Played the whole gig on flatwounds AND in drop D. The
            guitarist told the keyboard player "nice tone".
          </p>
        {% endcall %}
        {% call Message({
          author: "You",
          datetime: "2026-10-08T14:19",
          outgoing: true,
          slots: { end: "Read" },
          time: "14:19"
        }) %}
          <p>
            Can you send me the tab for your slap break? I'm gonna sneak it into
            the encore.
          </p>
        {% endcall %}
        {% set start %}{% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}{% endset %}
        {% call Message({
          author: "Ellen",
          datetime: "2026-10-08T14:31",
          slots: { start: start },
          time: "14:31"
        }) %}
          <p>Totally! Here it is:</p>
          {% call Card({ variant: "outlined" }) %}
            {% call CardContent({ class: "ui-layout-media ui-gap-small" }) %}
              <svg
                data-icon="document"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm2 16H8v-2h8zm0-4H8v-2h8zm-3-5V3.5L18.5 9z"
                ></path>
              </svg>
              <div>
                <a class="ui-link" href="#chat-file-tab">slap-break-of-doom.gp</a>
                <p class="ui-caption">Guitar Pro, 48 KB</p>
              </div>
            {% endcall %}
          {% endcall %}
        {% endcall %}
        {% set start %}{% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}{% endset %}
        {% call Message({
          author: "Ellen",
          datetime: "2026-10-08T14:32",
          slots: { start: start },
          time: "14:32"
        }) %}
          <p>Nobody will hear it, but WE will know 🤘</p>
        {% endcall %}
        {% set start %}{% call Avatar({ "aria-label": "Ellen Nut", role: "img" }) %}EN{% endcall %}{% endset %}
        {% call Message({ slots: { start: start }, typing: true }) %}
          Ellen is typing
        {% endcall %}
      {% endcall %}

      <div>
        <form action="#">
          {% call FieldGroup({
            class: "chat-composer",
            orientation: "horizontal"
          }) %}
            {% call Button({
              "aria-label": "Attach a file",
              round: true,
              type: "button"
            }) %}<svg
                data-icon="attach"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M16.5 6v11.5a4 4 0 0 1-8 0V5a2.5 2.5 0 0 1 5 0v10.5a1 1 0 0 1-2 0V6H10v9.5a2.5 2.5 0 0 0 5 0V5a4 4 0 0 0-8 0v12.5a5.5 5.5 0 0 0 11 0V6z"
                ></path>
              </svg>{% endcall %}
            {% call Field({ for: "chat-chat-message" }) %}
              <textarea
                aria-label="Message Ellen Nut"
                id="chat-chat-message"
                name="chat-message"
                placeholder="Write something rad…"
              ></textarea>
            {% endcall %}
            {% call Button({
              "aria-label": "Send",
              color: "primary",
              round: true,
              type: "submit",
              variant: "filled"
            }) %}<svg
                data-icon="send"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"
                ></path>
              </svg>{% endcall %}
          {% endcall %}
        </form>
      </div>
    </main>
  </div>

  {% call Drawer({ id: "chat-drawer", scrollLock: true }) %}
    {% call DrawerHeader({ closeButton: true }) %}
      {% call DrawerTitle() %}Messages{% endcall %}
    {% endcall %}
    {% call List({ variant: "transparent" }) %}
      {{ ListItem({
        "aria-current": "page",
        href: "#chat-ellen",
        label: "Ellen Nut",
        slots: { end: "14:32" }
      }) }}
      {% set end %}<span class="chat-unread">3 <span class="ui-sr-only">unread</span></span>{% endset %}
      {{ ListItem({
        href: "#chat-bassists-anonymous",
        label: "Bassists Anonymous",
        slots: { end: end }
      }) }}
      {{ ListItem({
        href: "#chat-adam",
        label: "Adam Groove",
        slots: { end: "11:05" }
      }) }}
      {{ ListItem({
        href: "#chat-mohini",
        label: "Mohini Hertz",
        slots: { end: "Mon" }
      }) }}
      {{ ListItem({
        href: "#chat-mixed-too-low",
        label: "Mixed Too Low",
        slots: { end: "Sun" }
      }) }}
    {% endcall %}
  {% endcall %}
</div>

<style>
  .chat {
    container-type: inline-size;

    .chat-sidebar {
      border-inline-end: var(--ui-border-width) solid var(--ui-border-color);
      display: none;

      @container (inline-size >= 56rem) {
        display: block;
      }
    }

    .chat-sidebar-header {
      padding: var(--ui-space-5) var(--ui-space-4) var(--ui-space-2);
    }

    .chat-unread {
      background-color: var(--ui-primary);
      border-radius: var(--ui-radius-round);
      color: var(--ui-on-primary);
      font-size: var(--ui-font-size-caption);
      font-weight: var(--ui-font-weight-label);
      line-height: 1;
      min-inline-size: var(--ui-space-6);
      padding: var(--ui-space-1) var(--ui-space-2);
      text-align: center;
    }

    main {
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-inline-size: 0;
    }

    .chat-thread-header {
      border-block-end: var(--ui-border-width) solid var(--ui-border-color);
      padding: var(--ui-space-4);

      hgroup {
        flex: 1;
        min-inline-size: 0;
      }
    }

    .chat-conversations-button {
      @container (inline-size >= 56rem) {
        display: none;
      }
    }

    .chat-message-list {
      padding: var(--ui-space-5) var(--ui-space-4);

      @container (inline-size >= 40rem) {
        padding-inline: var(--ui-space-6);
      }
    }

    .chat-composer {
      border-block-start: var(--ui-border-width) solid var(--ui-border-color);
      padding: var(--ui-space-4);
    }
  }
</style>
