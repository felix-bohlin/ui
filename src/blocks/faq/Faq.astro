---
import {
  Accordion,
  AccordionContent,
  AccordionSummary,
  Avatar,
  Button,
  Card,
  CardActions,
  CardContent,
  Chip,
  Tabs,
  TabsItem,
  TabsLabel,
  TabsPanel,
} from "opui-css/astro"
---

<style is:global>
  .faq {
    .faq-inner {
      align-items: start;

      @container (inline-size >= 56rem) {
        .ui-tabs {
          grid-column: 2;
          grid-row: 1 / span 2;
        }
      }
    }
  }
</style>

<div class="faq ui-layout-container">
  <div
    class="ui-layout-columns faq-inner"
    style="--_columns: 2fr 3fr; --_gap: var(--ui-space-6) var(--ui-space-8)"
  >
    <hgroup class="ui-hgroup">
      <p>Help corner</p>
      <h1 class="ui-h2">Frequently asked questions</h1>
      <p>
        Quick answers about Bassbook, Gold and keeping your riffs safe. Can't
        find what you're looking for? We'd totally love to help!
      </p>
    </hgroup>

    <Tabs name="faq-category" variant="line">
      <TabsItem checked id="faq-tab-general">
        <TabsLabel>General</TabsLabel>
        <TabsPanel>
          <Card aria-label="General questions" role="group" variant="outlined">
            <Accordion name="faq-general" open>
              <AccordionSummary
                >Is Bassbook only for bassists?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  Yep! Guitarists can visit, but they have to ask nicely and
                  turn it down. Drummers get a free pair of earplugs at the
                  door, easy peasy.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-general">
              <AccordionSummary>Can I import my old tabs?</AccordionSummary>
              <AccordionContent>
                <p>
                  Yes. Import tabs, setlists and gig photos from Guitar Pro,
                  your old homepage or a text file. Most bassists are moved over
                  in under an hour.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-general">
              <AccordionSummary>Is there a mobile app?</AccordionSummary>
              <AccordionContent>
                <p>
                  Bassbook has apps for iOS and Android with offline tabs, a
                  built-in tuner and a ping whenever someone actually notices
                  your bassline.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-general">
              <AccordionSummary
                >Do you have discounts for music schools?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  Music schools and garage bands with zero gigs get 50% off
                  Gold. Send us a photo of your rehearsal space and we'll add it
                  to your account.
                </p>
              </AccordionContent>
            </Accordion>
          </Card>
        </TabsPanel>
      </TabsItem>
      <TabsItem id="faq-tab-gold">
        <TabsLabel>Gold</TabsLabel>
        <TabsPanel>
          <Card
            aria-label="Bassbook Gold questions"
            role="group"
            variant="outlined"
          >
            <Accordion name="faq-gold">
              <AccordionSummary
                >Which payment methods do you accept?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  We take all major cards and direct debit, plus invoices with
                  30-day terms for bands buying Gold for 10+ members.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-gold">
              <AccordionSummary
                >Can I switch between Gold and Platinum?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  Upgrades kick in right away, woohoo! Downgrades apply at the
                  end of your current billing period.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-gold">
              <AccordionSummary
                >What happens when I add my bandmates?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  New bandmates are added to your next bill, prorated to the
                  day. Fans and roadies are always free.
                </p>
              </AccordionContent>
            </Accordion>
          </Card>
        </TabsPanel>
      </TabsItem>
      <TabsItem id="faq-tab-privacy">
        <TabsLabel>Privacy</TabsLabel>
        <TabsPanel>
          <Card aria-label="Privacy questions" role="group" variant="outlined">
            <Accordion name="faq-privacy">
              <AccordionSummary>Where are my riffs stored?</AccordionSummary>
              <AccordionContent>
                <p>
                  Everything lives in data centers in the EU, encrypted at rest
                  and in transit. Even your drummer can't peek at your diary.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-privacy">
              <AccordionSummary
                >Can my band see my private messages?</AccordionSummary
              >
              <AccordionContent>
                <p>
                  Nope! Messages are only for you and the person you're chatting
                  with. Your band can see your public profile, if they ever look
                  at it.
                </p>
              </AccordionContent>
            </Accordion>
            <Accordion name="faq-privacy">
              <AccordionSummary>Can I delete my account?</AccordionSummary>
              <AccordionContent>
                <p>
                  Yes, any time in your settings. We'll be totally sad, and
                  we'll delete all your data, tabs and pedalboard photos for
                  good.
                </p>
              </AccordionContent>
            </Accordion>
          </Card>
        </TabsPanel>
      </TabsItem>
    </Tabs>

    <Card aria-labelledby="faq-support-heading" as="section" variant="outlined">
      <hgroup>
        <h2 class="ui-h5" id="faq-support-heading">Still have questions?</h2>
        <p>Our support bassists usually reply within 2 hours. &lt;3</p>
      </hgroup>
      <CardContent class="ui-layout-media">
        <Avatar aria-hidden="true">KH</Avatar>
        <div>
          <p>
            Kinga Headstock
            <Chip
              as="span"
              dot
              label="Online now"
              severity="success"
              size="small"
            />
          </p>
          <p class="ui-caption">Mon–Fri 08–18 CET</p>
        </div>
      </CardContent>
      <CardActions>
        <Button href="#faq-chat" variant="filled">Chat with us</Button>
        <Button href="#faq-email" variant="outlined">Email support</Button>
      </CardActions>
    </Card>
  </div>
</div>
