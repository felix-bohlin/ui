{% from "opui/index.njk" import
  Avatar,
  Card,
  CardContent,
  Chip,
  Stat,
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
  ToggleButton,
  ToggleGroup
%}

<div
  class="leaderboard ui-layout-container ui-layout-column ui-gap-large"
  style="--_max-inline-size: 56rem"
>
  <div class="ui-layout-row ui-spread">
    <hgroup class="ui-hgroup">
      <p class="ui-overline">Slap Battle, season 3</p>
      <h1 class="lb-title">High scores</h1>
    </hgroup>
    {% call ToggleGroup({
      "aria-label": "Period",
      name: "leaderboard-period",
      size: "small"
    }) %}
      {{ ToggleButton({ label: "Today", value: "today" }) }}
      {{ ToggleButton({ checked: true, label: "This week", value: "week" }) }}
      {{ ToggleButton({ label: "All time", value: "all" }) }}
    {% endcall %}
  </div>

  <section aria-labelledby="leaderboard-podium-heading">
    <h2 class="ui-sr-only" id="leaderboard-podium-heading">Top three</h2>
    <ol class="lb-podium">
      <li class="lb-first">
        {% call Avatar({
          "aria-hidden": "true",
          size: "large",
          variant: "filled"
        }) %}SN{% endcall %}
        <span class="ui-layout-column ui-gap-x-small">
          <strong>Stella Nut</strong>
          <span class="ui-caption ui-tabular-nums">98 420 points</span>
        </span>
        <span class="lb-step"><span class="ui-sr-only">Place </span>1</span>
      </li>
      <li class="lb-second">
        {% call Avatar({ "aria-hidden": "true", size: "large" }) %}RR{% endcall %}
        <span class="ui-layout-column ui-gap-x-small">
          <strong>Reggie Riff</strong>
          <span class="ui-caption ui-tabular-nums">91 005 points</span>
        </span>
        <span class="lb-step"><span class="ui-sr-only">Place </span>2</span>
      </li>
      <li class="lb-third">
        {% call Avatar({ "aria-hidden": "true", size: "large" }) %}HH{% endcall %}
        <span class="ui-layout-column ui-gap-x-small">
          <strong>Holly Humbucker</strong>
          <span class="ui-caption ui-tabular-nums">87 760 points</span>
        </span>
        <span class="lb-step"><span class="ui-sr-only">Place </span>3</span>
      </li>
    </ol>
  </section>

  {% call Table({
    class: "lb-table",
    flush: true,
    overflow: "scroll",
    tabindex: 0
  }) %}
    {% call TableCaption({ class: "ui-sr-only" }) %}Places 4 to 8, and yours{% endcall %}
    {% call TableHead() %}
      {% call TableRow() %}
        {% call TableHeaderCell({ numeric: true, scope: "col" }) %}Place{% endcall %}
        {% call TableHeaderCell({ scope: "col" }) %}Player{% endcall %}
        {% call TableHeaderCell({ numeric: true, scope: "col" }) %}Best combo{% endcall %}
        {% call TableHeaderCell({ numeric: true, scope: "col" }) %}Points{% endcall %}
        {% call TableHeaderCell({ scope: "col" }) %}This week{% endcall %}
      {% endcall %}
    {% endcall %}
    {% call TableBody() %}
      {% call TableRow() %}
        {% call TableCell({ numeric: true }) %}4{% endcall %}
        {% call TableCell() %}
          <div class="ui-layout-media ui-gap-small">
            {% call Avatar({ "aria-hidden": "true", size: "small" }) %}LH{% endcall %}
            <span>Lou Headstock</span>
          </div>
        {% endcall %}
        {% call TableCell({ numeric: true }) %}64×{% endcall %}
        {% call TableCell({ numeric: true }) %}82 310{% endcall %}
        {% call TableCell() %}{{ Chip({
            as: "span",
            label: "Up 2",
            severity: "success",
            size: "small"
          }) }}{% endcall %}
      {% endcall %}
      {% call TableRow() %}
        {% call TableCell({ numeric: true }) %}5{% endcall %}
        {% call TableCell() %}
          <div class="ui-layout-media ui-gap-small">
            {% call Avatar({ "aria-hidden": "true", size: "small" }) %}MM{% endcall %}
            <span>Mo Mute</span>
          </div>
        {% endcall %}
        {% call TableCell({ numeric: true }) %}58×{% endcall %}
        {% call TableCell({ numeric: true }) %}79 880{% endcall %}
        {% call TableCell() %}{{ Chip({
            as: "span",
            label: "Down 1",
            severity: "critical",
            size: "small"
          }) }}{% endcall %}
      {% endcall %}
      {% call TableRow() %}
        {% call TableCell({ numeric: true }) %}6{% endcall %}
        {% call TableCell() %}
          <div class="ui-layout-media ui-gap-small">
            {% call Avatar({ "aria-hidden": "true", size: "small" }) %}FF{% endcall %}
            <span>Fran Fretless</span>
          </div>
        {% endcall %}
        {% call TableCell({ numeric: true }) %}51×{% endcall %}
        {% call TableCell({ numeric: true }) %}74 125{% endcall %}
        {% call TableCell() %}{{ Chip({
            as: "span",
            label: "New",
            severity: "info",
            size: "small"
          }) }}{% endcall %}
      {% endcall %}
      {% call TableRow() %}
        {% call TableCell({ numeric: true }) %}7{% endcall %}
        {% call TableCell() %}
          <div class="ui-layout-media ui-gap-small">
            {% call Avatar({ "aria-hidden": "true", size: "small" }) %}DD{% endcall %}
            <span>Dee Detune</span>
          </div>
        {% endcall %}
        {% call TableCell({ numeric: true }) %}49×{% endcall %}
        {% call TableCell({ numeric: true }) %}70 040{% endcall %}
        {% call TableCell() %}{{ Chip({
            as: "span",
            label: "Same",
            size: "small"
          }) }}{% endcall %}
      {% endcall %}
      {% call TableRow({ class: "lb-you" }) %}
        {% call TableCell({ numeric: true }) %}42{% endcall %}
        {% call TableCell() %}
          <div class="ui-layout-media ui-gap-small">
            {% call Avatar({
              "aria-hidden": "true",
              size: "small",
              variant: "filled"
            }) %}PG{% endcall %}
            <span><strong>Percy Groove (you)</strong></span>
          </div>
        {% endcall %}
        {% call TableCell({ numeric: true }) %}23×{% endcall %}
        {% call TableCell({ numeric: true }) %}31 600{% endcall %}
        {% call TableCell() %}{{ Chip({
            as: "span",
            label: "Up 18",
            severity: "success",
            size: "small"
          }) }}{% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}

  <section
    aria-labelledby="leaderboard-stats-heading"
    class="ui-layout-column ui-gap-small"
  >
    <h2 class="ui-h5" id="leaderboard-stats-heading">Your week</h2>
    <div class="ui-layout-grid ui-stretch" style="--_min-inline-size: 12rem">
      {% call Card({ variant: "outlined" }) %}
        {% call CardContent() %}
          {% set description %}
            <span class="ui-caption ui-success">+9</span> from last week
          {% endset %}
          {% call Stat({
            label: "Games played",
            slots: { description: description }
          }) %}
            37
            
          {% endcall %}
        {% endcall %}
      {% endcall %}
      {% call Card({ variant: "outlined" }) %}
        {% call CardContent() %}
          {% set description %}
            <span class="ui-caption ui-success">+6%</span> from last week
          {% endset %}
          {% call Stat({
            label: "Win rate",
            slots: { description: description }
          }) %}
            58%
            
          {% endcall %}
        {% endcall %}
      {% endcall %}
      {% call Card({ variant: "outlined" }) %}
        {% call CardContent() %}
          {% call Stat({
            label: "Notes missed",
            slots: { description: " Mostly the low B, as usual " }
          }) %}
            214
            
          {% endcall %}
        {% endcall %}
      {% endcall %}
    </div>
  </section>
</div>

<style>
  .leaderboard {
    container-type: inline-size;

    .lb-title {
      color: var(--ui-text-strong);
      font-size: var(--ui-font-size-800);
      letter-spacing: var(--ui-letter-spacing-display);
      line-height: var(--ui-line-height-tight);
      text-transform: uppercase;
    }

    .lb-podium {
      align-items: end;
      display: grid;
      gap: var(--ui-space-3);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      list-style-type: none;
      padding: 0;

      li {
        display: grid;
        gap: var(--ui-space-2);
        justify-items: center;
        text-align: center;
      }

      .lb-step {
        align-content: start;
        background-color: oklch(from var(--_place) l c h / 25%);
        block-size: var(--_height);
        border-block-start: var(--ui-border-width-large) solid var(--_place);
        border-start-end-radius: var(--ui-radius);
        border-start-start-radius: var(--ui-radius);
        display: grid;
        font-size: var(--ui-font-size-800);
        font-weight: var(--ui-font-weight-bold);
        inline-size: 100%;
        padding-block-start: var(--ui-space-3);
      }

      .lb-first {
        --_height: 9rem;
        --_place: var(--ui-primary);

        order: 2;
      }

      .lb-second {
        --_height: 6.5rem;
        --_place: var(--ui-neutral);

        order: 1;
      }

      .lb-third {
        --_height: 5rem;
        --_place: var(--ui-orange);

        order: 3;
      }
    }

    .lb-you > td {
      background-image: linear-gradient(
        oklch(from var(--ui-primary) l c h / 14%),
        oklch(from var(--ui-primary) l c h / 14%)
      );
    }

    @container (inline-size < 30rem) {
      .lb-table :is(th, td):is(:nth-child(3), :nth-child(5)) {
        display: none;
      }
    }
  }
</style>
