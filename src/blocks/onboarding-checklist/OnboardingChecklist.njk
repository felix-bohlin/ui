{% from "opui/index.njk" import
  Accordion,
  AccordionContent,
  AccordionSummary,
  Button,
  Callout,
  CalloutContent,
  Card,
  CardContent,
  Progress
%}

<div
  class="onboarding-checklist ui-layout-container"
  style="--_max-inline-size: 40rem"
>
  {% call Card({
    "aria-labelledby": "onboarding-checklist-heading",
    as: "section",
    variant: "outlined"
  }) %}
    {% call CardContent() %}
      <div class="ui-layout-row ui-spread onboarding-checklist-head">
        <hgroup>
          <h1 class="ui-h4" id="onboarding-checklist-heading">
            Welcome to Bassbook!
          </h1>
          <p>A few easy peasy steps to get your profile rockin'. Woohoo!</p>
        </hgroup>
        {% call Button({
          "aria-label": "Dismiss checklist",
          round: true,
          size: "small",
          type: "button"
        }) %}
          <svg
            data-icon="close"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
            ></path>
          </svg>
        {% endcall %}
      </div>

      <div class="ui-layout-column ui-gap-x-small">
        <span
          class="ui-layout-row ui-spread"
          id="onboarding-checklist-progress"
        ><span>3 of 6 steps done</span><span>50%</span></span>
        {{ Progress({
          "aria-labelledby": "onboarding-checklist-progress",
          max: 6,
          value: 3
        }) }}
      </div>

      {% call Card({ "aria-label": "Steps", role: "group", variant: "outlined" }) %}
        {% call Accordion({ name: "onboarding-checklist-steps" }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media onboarding-checklist-complete">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker onboarding-checklist-done"
              >✓</span>
              <span>Fill in your
                profile<span class="ui-sr-only">, done</span></span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>Your profile bassbook.example/josh is live!</p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-profile",
                size: "small"
              }) %}Edit profile{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
        {% call Accordion({ name: "onboarding-checklist-steps" }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media onboarding-checklist-complete">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker onboarding-checklist-done"
              >✓</span>
              <span>Upload a photo of your
                bass<span class="ui-sr-only">, done</span></span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>Big Bertha looks totally rad. Five stars, no notes. Add more!</p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-photos",
                size: "small"
              }) %}Add photos{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
        {% call Accordion({ name: "onboarding-checklist-steps" }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media onboarding-checklist-complete">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker onboarding-checklist-done"
              >✓</span>
              <span>Find friends<span class="ui-sr-only">, done</span></span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>Kinga, Adam and Ellen are now on your friends list. Rad!</p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-friends",
                size: "small"
              }) %}Find more friends{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
        {% call Accordion({ name: "onboarding-checklist-steps", open: true }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker"
              >4</span>
              <span>Pick a best friend</span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>
              Your best friend shows up first on your profile, with a sparkly
              badge. Choose wisely (we won't tell your drummer).
            </p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-best-friend",
                size: "small",
                variant: "filled"
              }) %}Pick best friend{% endcall %}
              {% call Button({
                href: "#onboarding-checklist-top-friends",
                size: "small",
                variant: "outlined"
              }) %}Rank top 8{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
        {% call Accordion({ name: "onboarding-checklist-steps" }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker"
              >5</span>
              <span>Scribble on someone's wall</span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>
              Say hi to a fellow bassist! A "nice slap tone" goes a long, long
              way.
            </p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-wall",
                size: "small",
                variant: "outlined"
              }) %}Write on a wall{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
        {% call Accordion({ name: "onboarding-checklist-steps" }) %}
          {% call AccordionSummary() %}
            <span class="ui-layout-media">
              <span
                aria-hidden="true"
                class="ui-tabular-nums onboarding-checklist-marker"
              >6</span>
              <span>Get Bassbook Messenger</span>
            </span>
          {% endcall %}
          {% call AccordionContent() %}
            <p>
              Chat with your bass buddies from the desktop, with buzzy nudges.
            </p>
            <div class="ui-layout-row ui-gap-small">
              {% call Button({
                href: "#onboarding-checklist-download",
                size: "small",
                variant: "outlined"
              }) %}Download{% endcall %}
            </div>
          {% endcall %}
        {% endcall %}
      {% endcall %}

      {% call Callout({ severity: "info" }) %}
        <svg
          data-icon="help"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m1 17h-2v-2h2zm2.07-7.75-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25"
          ></path>
        </svg>
        {% call CalloutContent() %}
          <p>
            Stuck on a step?
            <a class="ui-link" href="#onboarding-checklist-message">Send a message</a>
            to Mohini, our super friendly welcome wizard.
          </p>
        {% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}
</div>

<style>
  .onboarding-checklist {
    .onboarding-checklist-head {
      align-items: start;
      flex-wrap: nowrap;
    }

    .onboarding-checklist-complete {
      color: var(--ui-text);
      font-weight: var(--ui-font-weight-medium);
    }

    .onboarding-checklist-marker {
      block-size: 1.75rem;
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius-round);
      display: inline-grid;
      inline-size: 1.75rem;
      place-items: center;
    }

    .onboarding-checklist-done {
      background-color: var(--ui-primary);
      border-color: var(--ui-primary);
      color: var(--ui-on-primary);
    }

    details > .ui-content {
      padding-inline-start: 3.75rem;
    }
  }
</style>
