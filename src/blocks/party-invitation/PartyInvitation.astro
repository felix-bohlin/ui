---
import {
  Avatar,
  AvatarGroup,
  Button,
  Card,
  CardContent,
  Checkbox,
  Field,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio,
  SelectButton,
  StepButton,
} from "opui-css/astro"
---

<style is:global>
  .party-invitation {
    container-type: inline-size;

    .pi-invite {
      background-image: linear-gradient(
        160deg,
        oklch(from var(--ui-primary) l c h / 16%),
        transparent 70%
      );
      text-align: center;

      .ui-content {
        display: grid;
        gap: var(--ui-space-6);
        justify-items: center;
        padding-block-end: var(--ui-space-8);
      }
    }

    .pi-title {
      color: var(--ui-text-strong);
      font-size: var(--ui-font-size-900);
      letter-spacing: var(--ui-letter-spacing-display);
      line-height: var(--ui-line-height-tight);
      text-wrap: balance;
    }

    .pi-confetti {
      background-image:
        radial-gradient(
          circle,
          oklch(from var(--ui-warning) l c h / 80%) 0 0.3rem,
          transparent 0.34rem
        ),
        radial-gradient(
          circle,
          oklch(from var(--ui-primary) l c h / 70%) 0 0.24rem,
          transparent 0.28rem
        ),
        radial-gradient(
          circle,
          oklch(from var(--ui-success) l c h / 70%) 0 0.28rem,
          transparent 0.32rem
        ),
        radial-gradient(
          circle,
          oklch(from var(--ui-critical) l c h / 65%) 0 0.22rem,
          transparent 0.26rem
        );
      background-position:
        0.8rem 1.4rem,
        3.1rem 0.4rem,
        1.9rem 3.6rem,
        4.4rem 2.7rem;
      background-repeat: repeat;
      background-size:
        5.5rem 4.5rem,
        6.5rem 5rem,
        4.75rem 6rem,
        7rem 5.5rem;
      block-size: 5rem;
      mask-image: linear-gradient(black, transparent);
    }

    .pi-details {
      border-block: var(--ui-border-width) solid var(--ui-border-color);
      display: grid;
      gap: var(--ui-space-4) var(--ui-space-6);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
      inline-size: 100%;
      margin: 0;
      max-inline-size: 26rem;
      padding-block: var(--ui-space-5);

      dt {
        color: var(--ui-text-subtle);
        font-size: var(--ui-font-size-caption);
        letter-spacing: var(--ui-letter-spacing-caps);
        text-transform: uppercase;
      }

      dd {
        color: var(--ui-text-strong);
        font-weight: var(--ui-font-weight-semibold);
        margin: 0;
      }
    }
  }
</style>

<div
  class="party-invitation ui-layout-container ui-layout-columns ui-gap-large"
  style="--_columns: 1fr 1fr; --_max-inline-size: 60rem"
>
  <Card
    aria-labelledby="party-invitation-title"
    as="article"
    class="pi-invite"
    variant="outlined"
  >
    <div aria-hidden="true" class="pi-confetti"></div>
    <CardContent>
      <hgroup class="ui-hgroup">
        <p class="ui-overline">You're invited</p>
        <h1 class="pi-title" id="party-invitation-title">
          Percy turns 40 and still slaps
        </h1>
        <p>A night of karaoke, chili and one very loud birthday solo.</p>
      </hgroup>
      <dl class="pi-details">
        <div>
          <dt>When</dt>
          <dd>
            <time datetime="2027-03-20T19:00">Saturday 20 March, 19:00</time>
          </dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>The Rehearsal Basement, Fretgatan 4</dd>
        </div>
        <div>
          <dt>Dress code</dt>
          <dd>Anything with a bass on it</dd>
        </div>
        <div>
          <dt>Reply by</dt>
          <dd><time datetime="2027-03-06">Saturday 6 March</time></dd>
        </div>
      </dl>
      <div class="ui-layout-row ui-gap-small">
        <AvatarGroup aria-label="Guests who are coming">
          <Avatar label="Lou Headstock" src="/photos/lou-headstock.png" />
          <Avatar aria-label="Stella Nut" role="img">SN</Avatar>
        </AvatarGroup>
        <span>23 going, 4 maybe</span>
      </div>
    </CardContent>
  </Card>

  <Card
    aria-labelledby="party-invitation-rsvp-heading"
    as="section"
    variant="outlined"
  >
    <hgroup>
      <h2 class="ui-h4" id="party-invitation-rsvp-heading">RSVP</h2>
      <p>Percy is counting chairs. Please tell him soon.</p>
    </hgroup>
    <CardContent>
      <Form action="#" id="party-invitation-form">
        <FieldGroup>
          <Fieldset>
            <FieldLegend>Can you make it?</FieldLegend>
            <FieldGroup
              name="party-invitation-attending"
              orientation="horizontal"
              role="radiogroup"
            >
              <Radio checked label="Yes, I'm in" value="yes" />
              <Radio label="Maybe" value="maybe" />
              <Radio label="Can't make it" value="no" />
            </FieldGroup>
          </Fieldset>
          <Field
            autoFit
            for="party-invitation-guests"
            label="Guests, you included"
          >
            <input
              id="party-invitation-guests"
              max="4"
              min="1"
              name="guests"
              type="number"
              value="2"
            />
            <StepButton
              command="--step-down"
              for="party-invitation-guests"
              slot="start"
            />
            <StepButton
              command="--step-up"
              for="party-invitation-guests"
              slot="end"
            />
          </Field>
          <Field for="party-invitation-food" label="Chili">
            <select id="party-invitation-food" name="food">
              <SelectButton />
              <option selected value="beef">Beef chili</option>
              <option value="bean">Three-bean chili</option>
              <option value="none">No chili, just cake</option>
            </select>
          </Field>
          <Field
            for="party-invitation-song"
            label="Karaoke song"
            startText="Percy vetoes anything without a bass line"
          >
            <input
              aria-describedby="party-invitation-song-start-text"
              id="party-invitation-song"
              name="song"
              placeholder="Under Pressure"
              type="text"
            />
          </Field>
          <Field for="party-invitation-message" label="Note for Percy">
            <textarea
              id="party-invitation-message"
              name="message"
              placeholder="Happy birthday, you low-end legend"
              rows="3"
            ></textarea>
          </Field>
          <Checkbox checked name="reminder">
            Remind me the day before
          </Checkbox>
        </FieldGroup>

        <Button type="submit" variant="filled">Send RSVP</Button>
      </Form>
    </CardContent>
  </Card>
</div>
