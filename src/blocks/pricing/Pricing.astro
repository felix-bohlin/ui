---
import {
  Button,
  Card,
  CardContent,
  Chip,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
---

<style is:global>
  .pricing {
    container-type: inline-size;

    &:has(#pricing-period-monthly:checked) .pricing-yearly,
    &:has(#pricing-period-yearly:checked) .pricing-monthly {
      display: none;
    }

    .pricing-intro h1 {
      text-wrap: balance;
    }

    .pricing-save {
      font-weight: var(--ui-font-weight-medium);
    }

    .pricing-plans {
      grid-template-columns: minmax(0, 1fr);

      @container (inline-size >= 56rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .pricing-plan {
      &.pricing-featured {
        outline: var(--ui-border-width-large) solid var(--ui-primary);
        outline-offset: calc(-1 * var(--ui-border-width-large));
      }

      .ui-content {
        display: grid;
        gap: var(--ui-space-5);
      }
    }

    .pricing-badge {
      inset-block-start: var(--ui-space-4);
      inset-inline-end: var(--ui-space-4);
      position: absolute;
    }

    .pricing-amount {
      font-size: var(--ui-font-size-800);
      font-weight: var(--ui-font-weight-bold);
      line-height: 1;
    }

    .pricing-features li {
      align-items: start;
      display: flex;
      gap: var(--ui-space-2);

      &::before {
        flex-shrink: 0;
        margin-block-start: 0.15em;
      }
    }

    .pricing-check,
    .pricing-features li::before {
      background-color: var(--ui-success-text);
      block-size: 1.25rem;
      content: "";
      display: inline-block;
      inline-size: 1.25rem;
      mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M20.7 6.3a1 1 0 0 1 0 1.4l-10 10a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.4l4.3 4.29 9.3-9.3a1 1 0 0 1 1.4 0'/></svg>")
        center / contain no-repeat;
      vertical-align: middle;
    }

    .pricing-table {
      table-layout: fixed;

      th[scope="row"] {
        font-weight: var(--ui-font-weight-normal);
      }

      :is(td, thead th:not(:first-child)) {
        text-align: center;
      }
    }

    .pricing-note {
      text-align: center;
    }
  }
</style>

<div class="pricing ui-layout-container ui-layout-column ui-gap-large">
  <div
    class="ui-layout-container ui-layout-column ui-gap-large ui-align-center pricing-intro"
    style="--_max-inline-size: 40rem; --_padding-inline: 0"
  >
    <hgroup class="ui-hgroup">
      <p>Memberships</p>
      <h1 class="ui-h2">Totally rad memberships for bassists</h1>
      <p>
        Start free, upgrade when your bandmates still won't listen. Every paid
        plan comes with a 14-day trial.
      </p>
    </hgroup>
    <div class="ui-layout-row ui-gap-small ui-align-center">
      <ToggleGroup
        aria-label="Billing period"
        name="pricing-period"
        value="yearly"
      >
        <ToggleButton
          id="pricing-period-monthly"
          label="Monthly"
          value="monthly"
        />
        <ToggleButton
          id="pricing-period-yearly"
          label="Yearly"
          value="yearly"
        />
      </ToggleGroup>
      <span class="ui-p ui-success pricing-save"
        >Pay yearly, get 2 months free! Woohoo!</span
      >
    </div>
  </div>

  <ul class="ui-layout-grid ui-gap-large pricing-plans">
    <li>
      <Card
        aria-labelledby="pricing-basic-heading"
        as="section"
        class="pricing-plan"
        variant="outlined"
      >
        <hgroup>
          <h2 class="ui-h5" id="pricing-basic-heading">Basic</h2>
          <p>For bassists just dipping a toe in.</p>
        </hgroup>
        <CardContent>
          <div class="ui-layout-column ui-gap-small">
            <span class="ui-tabular-nums pricing-amount">€0</span
            ><span>Free forever</span>
          </div>
          <Button href="#pricing-basic" variant="outlined"
            >Join for free</Button
          >
          <ul class="ui-layout-column ui-gap-small pricing-features">
            <li>Your very own profile</li>
            <li>A wall for shoutouts</li>
            <li>Up to 3 bands</li>
            <li>All the sympathy you need</li>
          </ul>
        </CardContent>
      </Card>
    </li>
    <li>
      <Card
        aria-labelledby="pricing-gold-heading"
        as="section"
        class="pricing-plan pricing-featured"
        variant="elevated"
      >
        <Chip
          as="span"
          class="pricing-badge"
          label="Most popular"
          size="small"
        />
        <hgroup>
          <h2 class="ui-h5" id="pricing-gold-heading">Gold</h2>
          <p>For bassists ready to shine (finally).</p>
        </hgroup>
        <CardContent>
          <div class="ui-layout-column ui-gap-small pricing-monthly">
            <span class="ui-tabular-nums pricing-amount">€3</span
            ><span>per month</span>
          </div>
          <div class="ui-layout-column ui-gap-small pricing-yearly">
            <span class="ui-tabular-nums pricing-amount">€30</span
            ><span>per year, that's 2 months free</span>
          </div>
          <Button href="#pricing-gold" variant="filled"
            >Start free trial</Button
          >
          <ul class="ui-layout-column ui-gap-small pricing-features">
            <li>Everything in Basic</li>
            <li>A shiny gold name</li>
            <li>Unlimited gear photos</li>
            <li>Gig calendar with reminders</li>
            <li>Speedy support (we listen!)</li>
          </ul>
        </CardContent>
      </Card>
    </li>
    <li>
      <Card
        aria-labelledby="pricing-platinum-heading"
        as="section"
        class="pricing-plan"
        variant="outlined"
      >
        <hgroup>
          <h2 class="ui-h5" id="pricing-platinum-heading">Platinum</h2>
          <p>
            For slap legends. You know who you are. Davie504 asked us to add
            “not Charles”.
          </p>
        </hgroup>
        <CardContent>
          <div class="ui-layout-column ui-gap-small pricing-monthly">
            <span class="ui-tabular-nums pricing-amount">€5</span
            ><span>per month</span>
          </div>
          <div class="ui-layout-column ui-gap-small pricing-yearly">
            <span class="ui-tabular-nums pricing-amount">€50</span
            ><span>per year, that's 2 months free</span>
          </div>
          <Button href="#pricing-platinum" variant="outlined"
            >Go Platinum</Button
          >
          <ul class="ui-layout-column ui-gap-small pricing-features">
            <li>Everything in Gold</li>
            <li>Posts 10% louder</li>
            <li>Custom profile glitter</li>
            <li>Early access to new stuff</li>
            <li>A personal bass buddy</li>
          </ul>
        </CardContent>
      </Card>
    </li>
  </ul>

  <div class="ui-layout-column">
    <h2 class="ui-h4" id="pricing-compare-heading">Compare plans</h2>
    <Table
      aria-labelledby="pricing-compare-heading"
      class="pricing-table"
      flush
    >
      <TableHead>
        <TableRow>
          <TableHeaderCell scope="col">Feature</TableHeaderCell>
          <TableHeaderCell scope="col">Basic</TableHeaderCell>
          <TableHeaderCell scope="col">Gold</TableHeaderCell>
          <TableHeaderCell scope="col">Platinum</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableHeaderCell scope="row">Bands</TableHeaderCell>
          <TableCell>Up to 3</TableCell>
          <TableCell>Unlimited</TableCell>
          <TableCell>Unlimited</TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">Gear photos</TableHeaderCell>
          <TableCell>20</TableCell>
          <TableCell>Unlimited</TableCell>
          <TableCell>Unlimited</TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">Song uploads</TableHeaderCell>
          <TableCell>3 songs</TableCell>
          <TableCell>100 songs</TableCell>
          <TableCell>All the songs</TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">Shiny gold name</TableHeaderCell>
          <TableCell>
            <span aria-hidden="true">–</span
            ><span class="ui-sr-only">Not included</span>
          </TableCell>
          <TableCell>
            <span class="pricing-check" role="img" aria-label="Included"></span>
          </TableCell>
          <TableCell>
            <span class="pricing-check" role="img" aria-label="Included"></span>
          </TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">Gig calendar</TableHeaderCell>
          <TableCell>
            <span aria-hidden="true">–</span
            ><span class="ui-sr-only">Not included</span>
          </TableCell>
          <TableCell>
            <span class="pricing-check" role="img" aria-label="Included"></span>
          </TableCell>
          <TableCell>
            <span class="pricing-check" role="img" aria-label="Included"></span>
          </TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">10% louder posts</TableHeaderCell>
          <TableCell>
            <span aria-hidden="true">–</span
            ><span class="ui-sr-only">Not included</span>
          </TableCell>
          <TableCell>
            <span aria-hidden="true">–</span
            ><span class="ui-sr-only">Not included</span>
          </TableCell>
          <TableCell>
            <span class="pricing-check" role="img" aria-label="Included"></span>
          </TableCell>
        </TableRow>
        <TableRow>
          <TableHeaderCell scope="row">Support</TableHeaderCell>
          <TableCell>Community</TableCell>
          <TableCell>Speedy email</TableCell>
          <TableCell>Bass buddy</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <p class="ui-caption pricing-note">
    Prices in EUR, excluding VAT. Buying Gold for your whole band?
    <a class="ui-link" href="#pricing-band">Get a band deal</a>.
  </p>
</div>
