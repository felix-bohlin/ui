{% from "opui/index.njk" import
  Avatar,
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Card,
  CardActions,
  CardContent,
  Chip,
  DescriptionList,
  DescriptionListDescription,
  DescriptionListItem,
  DescriptionListTerm,
  List,
  ListItem,
  Menu,
  Progress,
  Stat,
  Timeline,
  TimelineItem
%}

<div
  class="project-overview ui-layout-container ui-layout-column ui-gap-large"
  style="--_max-inline-size: 80rem"
>
  <div class="ui-layout-row ui-spread">
    <hgroup class="ui-hgroup">
      <p>Bassbook, community meetup</p>
      <h1 class="ui-h3">Bass Day 2026</h1>
      <p>
        {{ Chip({
          as: "span",
          dot: true,
          label: "On track",
          severity: "success",
          size: "small",
          variant: "outlined"
        }) }}
      </p>
    </hgroup>
    <div class="ui-layout-row ui-gap-small">
      {% call Button({ size: "small", type: "button", variant: "outlined" }) %}Share{% endcall %}
      {% call Button({
        command: "toggle-popover",
        commandfor: "project-overview-actions",
        size: "small",
        type: "button",
        variant: "filled"
      }) %}
        <span class="ui-text">Actions</span>
        <svg
          data-icon="chevron-down"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"
          ></path>
        </svg>
      {% endcall %}
      {{ Menu({
        align: "end",
        id: "project-overview-actions",
        items: [
          { label: "Edit details" },
          { label: "Add milestone" },
          { label: "Export report" },
          { borderTop: true, color: "critical", label: "Archive meetup" }
        ]
      }) }}
    </div>
  </div>

  {% call Callout({ severity: "warning" }) %}{{ CalloutIcon() }}{% call CalloutContent() %}
      <p>
        The big jam rehearsal moved from 10 to 14 October.
        <a class="ui-link" href="#project-overview-jam">See what changed</a>
      </p>
    {% endcall %}{% endcall %}

  <ul class="ui-layout-grid ui-stretch" style="--_min-inline-size: 13rem">
    <li>
      {% call Card({ variant: "outlined" }) %}{% call CardContent() %}
          {% set label %}<span id="project-overview-progress-label">Progress</span>{% endset %}
          {% call Stat({ slots: { label: label } }) %}64%{% endcall %}
          {{ Progress({
            "aria-labelledby": "project-overview-progress-label",
            max: 100,
            value: 64
          }) }}
        {% endcall %}{% endcall %}
    </li>
    <li>
      {% call Card({ variant: "outlined" }) %}{% call CardContent() %}
          {% call Stat({
            description: "11 closed this week",
            label: "Tasks completed"
          }) %}86 of 134{% endcall %}
        {% endcall %}{% endcall %}
    </li>
    <li>
      {% call Card({ variant: "outlined" }) %}{% call CardContent() %}
          {% call Stat({
            description: "Bass Day is 31 October",
            label: "Time left"
          }) %}23 days{% endcall %}
        {% endcall %}{% endcall %}
    </li>
    <li>
      {% call Card({ variant: "outlined" }) %}{% call CardContent() %}
          {% call Stat({ description: "69% of 60 000 kr", label: "Budget used" }) %}41 200 kr{% endcall %}
        {% endcall %}{% endcall %}
    </li>
  </ul>

  <div class="ui-layout-columns ui-gap-large" style="--_columns: 3fr 2fr">
    <div class="ui-layout-column ui-gap-large">
      {% call Card({
        "aria-labelledby": "project-overview-milestones-heading",
        as: "section",
        variant: "outlined"
      }) %}
        <hgroup>
          <h2 class="ui-h5" id="project-overview-milestones-heading">
            Milestones
          </h2>
          <p>3 of 5 completed.</p>
        </hgroup>
        {% call CardContent() %}{% call Timeline() %}
            {% set marker %}<svg
              data-icon="check-circle"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z"
              ></path>
            </svg>{% endset %}
            {% call TimelineItem({
              color: "success",
              datetime: "2026-08-14",
              label: "Find a venue with enough outlets",
              slots: { marker: marker },
              time: "14 Aug"
            }) %}
              <p class="ui-caption">Completed, 12 venues visited</p>
            {% endcall %}
            {% set marker %}<svg
              data-icon="check-circle"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z"
              ></path>
            </svg>{% endset %}
            {% call TimelineItem({
              color: "success",
              datetime: "2026-09-05",
              label: "Book a sound tech who loves bass",
              slots: { marker: marker },
              time: "5 Sep"
            }) %}
              <p class="ui-caption">Completed, low end approved</p>
            {% endcall %}
            {% set marker %}<svg
              data-icon="check-circle"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z"
              ></path>
            </svg>{% endset %}
            {% call TimelineItem({
              color: "success",
              datetime: "2026-09-26",
              label: "Name tags and goodie bags",
              slots: { marker: marker },
              time: "26 Sep"
            }) %}
              <p class="ui-caption">Completed, two days late</p>
            {% endcall %}
            {% set marker %}<svg
              data-icon="circle-half"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16m0-14v12a6 6 0 0 0 0-12"
              ></path>
            </svg>{% endset %}
            {% set label %}<span id="project-overview-jam-label">Big jam rehearsal</span>{% endset %}
            {% call TimelineItem({
              current: "step",
              datetime: "2026-10-14",
              slots: { label: label, marker: marker },
              time: "14 Oct"
            }) %}
              <p class="ui-caption">In progress, 18 of 26 tasks done</p>
              {{ Progress({
                "aria-labelledby": "project-overview-jam-label",
                max: 26,
                value: 18
              }) }}
            {% endcall %}
            {% set marker %}<svg
              data-icon="circle"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16"
              ></path>
            </svg>{% endset %}
            {% call TimelineItem({
              datetime: "2026-10-31",
              label: "Bass Day, woohoo!",
              slots: { marker: marker },
              time: "31 Oct"
            }) %}
              <p class="ui-caption">Upcoming</p>
            {% endcall %}
          {% endcall %}{% endcall %}
      {% endcall %}

      {% call Card({
        "aria-labelledby": "project-overview-activity-heading",
        as: "section",
        variant: "outlined"
      }) %}
        <hgroup>
          <h2 class="ui-h5" id="project-overview-activity-heading">
            Recent activity
          </h2>
        </hgroup>
        {% call List({ variant: "transparent" }) %}
          {% set start %}{% call Avatar({ "aria-label": "Holly Humbucker", role: "img" }) %}HH{% endcall %}{% endset %}
          {{ ListItem({
            description: "Today, 10:24",
            label: "Holly closed “Extension cords for 40 amps”",
            slots: { start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Lou Headstock", role: "img" }) %}LH{% endcall %}{% endset %}
          {{ ListItem({
            description: "Today, 08:51",
            label: "Lou uploaded “Bass Day poster v4.png”",
            slots: { start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Percy Groove", role: "img" }) %}PG{% endcall %}{% endset %}
          {{ ListItem({
            description: "Yesterday, 16:02",
            label: "Percy moved the jam rehearsal to 14 October",
            slots: { start: start }
          }) }}
        {% endcall %}
      {% endcall %}
    </div>

    <div class="ui-layout-column ui-gap-large">
      {% call Card({
        "aria-labelledby": "project-overview-team-heading",
        as: "section",
        variant: "outlined"
      }) %}
        <hgroup>
          <h2 class="ui-h5" id="project-overview-team-heading">Team</h2>
          <p>5 bassists making it happen.</p>
        </hgroup>
        {% call List({ dense: true, variant: "transparent" }) %}
          {% set start %}{% call Avatar({ "aria-label": "Percy Groove", role: "img" }) %}PG{% endcall %}{% endset %}
          {% set end %}{{ Chip({ as: "span", label: "Owner", size: "x-small" }) }}{% endset %}
          {{ ListItem({
            description: "Party boss",
            label: "Percy Groove",
            slots: { end: end, start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Lou Headstock", role: "img" }) %}LH{% endcall %}{% endset %}
          {{ ListItem({
            description: "Poster artist",
            label: "Lou Headstock",
            slots: { start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Holly Humbucker", role: "img" }) %}HH{% endcall %}{% endset %}
          {{ ListItem({
            description: "Amp wrangler",
            label: "Holly Humbucker",
            slots: { start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Ines Hertz", role: "img" }) %}IH{% endcall %}{% endset %}
          {{ ListItem({
            description: "Snack captain",
            label: "Ines Hertz",
            slots: { start: start }
          }) }}
          {% set start %}{% call Avatar({ "aria-label": "Rory Rootnote", role: "img" }) %}RR{% endcall %}{% endset %}
          {{ ListItem({
            description: "Sound check hero",
            label: "Rory Rootnote",
            slots: { start: start }
          }) }}
        {% endcall %}
        {% call CardActions() %}{% call Button({ size: "small", type: "button" }) %}Invite people{% endcall %}{% endcall %}
      {% endcall %}

      {% call Card({
        "aria-labelledby": "project-overview-details-heading",
        as: "section",
        variant: "outlined"
      }) %}
        <hgroup>
          <h2 class="ui-h5" id="project-overview-details-heading">Details</h2>
        </hgroup>
        {% call CardContent() %}{% call DescriptionList({ leader: "solid" }) %}
            {% call DescriptionListItem() %}{% call DescriptionListTerm() %}Host{% endcall %}{% call DescriptionListDescription() %}Low End Theory{% endcall %}{% endcall %}
            {% call DescriptionListItem() %}{% call DescriptionListTerm() %}Started{% endcall %}{% call DescriptionListDescription() %}4 August 2026{% endcall %}{% endcall %}
            {% call DescriptionListItem() %}{% call DescriptionListTerm() %}Bass Day{% endcall %}{% call DescriptionListDescription() %}31 October 2026{% endcall %}{% endcall %}
            {% call DescriptionListItem() %}{% call DescriptionListTerm() %}Basses{% endcall %}{% call DescriptionListDescription() %}4-string, 5-string, fretless{% endcall %}{% endcall %}
          {% endcall %}{% endcall %}
      {% endcall %}
    </div>
  </div>
</div>

<style>
  .project-overview {
    container-type: inline-size;
  }
</style>
