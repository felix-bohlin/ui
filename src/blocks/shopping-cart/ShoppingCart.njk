{% from "opui/index.njk" import
  Button,
  Card,
  CardContent,
  Chip,
  ControlGroup,
  DescriptionList,
  DescriptionListDescription,
  DescriptionListItem,
  DescriptionListTerm,
  Field,
  Progress,
  StepButton
%}

<div class="shopping-cart ui-layout-container ui-layout-column ui-gap-large">
  <hgroup class="ui-hgroup">
    <h1 class="ui-h3">Your gear cart</h1>
    <p>3 totally rad items, prices include VAT</p>
  </hgroup>

  <div class="ui-layout-columns ui-gap-large" style="--_columns: 2fr 1fr">
    {% call Card({
      "aria-label": "Cart items",
      as: "section",
      variant: "outlined"
    }) %}
      <ul class="ui-layout-column cart-items">
        <li class="cart-item">
          <div
            aria-label="Comfy Cloud Gig Bag in Midnight"
            class="cart-thumb"
            style="--hue: 0"
            role="img"
          ></div>
          <div class="ui-layout-column ui-gap-x-small cart-info">
            <h2 class="ui-h6">
              <a class="ui-link" href="#shopping-cart-gig-bag">Comfy Cloud Gig Bag</a>
            </h2>
            <p>Midnight, Long scale</p>
            <p>
              {{ Chip({
                as: "span",
                dot: true,
                label: "In stock, ships today",
                severity: "success",
                size: "small"
              }) }}
            </p>
            <div class="ui-layout-row ui-gap-x-small cart-links">
              {% call Button({ size: "x-small", type: "button" }) %}Save for later{% endcall %}
              {% call Button({
                color: "critical",
                size: "x-small",
                type: "button"
              }) %}Remove{% endcall %}
            </div>
          </div>
          <div class="cart-buy">
            {% set start %}{{ StepButton({ command: "--step-down", for: "shopping-cart-qty-gig-bag" }) }}{% endset %}
            {% set end %}{{ StepButton({ command: "--step-up", for: "shopping-cart-qty-gig-bag" }) }}{% endset %}
            {% call Field({
              autoFit: true,
              for: "shopping-cart-qty-gig-bag",
              hideLabel: true,
              label: "Quantity of Comfy Cloud Gig Bag",
              size: "small",
              slots: { end: end, start: start }
            }) %}
              <input
                id="shopping-cart-qty-gig-bag"
                min="1"
                name="qty-gig-bag"
                type="number"
                value="1"
              />
            {% endcall %}
            <p class="ui-tabular-nums cart-line-price">
              €119.00
              <s class="ui-caption"><span class="ui-sr-only">Was </span>€149.00</s>
            </p>
          </div>
        </li>
        <li class="cart-item">
          <div
            aria-label="Flatwound string set, medium gauge"
            class="cart-thumb"
            style="--hue: 140"
            role="img"
          ></div>
          <div class="ui-layout-column ui-gap-x-small cart-info">
            <h2 class="ui-h6">
              <a class="ui-link" href="#shopping-cart-strings">Flatwound string set</a>
            </h2>
            <p>Medium, 45–105</p>
            <p>
              {{ Chip({
                as: "span",
                dot: true,
                label: "In stock, ships today",
                severity: "success",
                size: "small"
              }) }}
            </p>
            <div class="ui-layout-row ui-gap-x-small cart-links">
              {% call Button({ size: "x-small", type: "button" }) %}Save for later{% endcall %}
              {% call Button({
                color: "critical",
                size: "x-small",
                type: "button"
              }) %}Remove{% endcall %}
            </div>
          </div>
          <div class="cart-buy">
            {% set start %}{{ StepButton({ command: "--step-down", for: "shopping-cart-qty-strings" }) }}{% endset %}
            {% set end %}{{ StepButton({ command: "--step-up", for: "shopping-cart-qty-strings" }) }}{% endset %}
            {% call Field({
              autoFit: true,
              for: "shopping-cart-qty-strings",
              hideLabel: true,
              label: "Quantity of Flatwound string set",
              size: "small",
              slots: { end: end, start: start }
            }) %}
              <input
                id="shopping-cart-qty-strings"
                min="1"
                name="qty-strings"
                type="number"
                value="2"
              />
            {% endcall %}
            <p class="ui-tabular-nums cart-line-price">€48.00</p>
          </div>
        </li>
        <li class="cart-item">
          <div
            aria-label="I'm with the bassist tee in Faded black"
            class="cart-thumb"
            style="--hue: -80"
            role="img"
          ></div>
          <div class="ui-layout-column ui-gap-x-small cart-info">
            <h2 class="ui-h6">
              <a class="ui-link" href="#shopping-cart-tee">I'm with the bassist tee</a>
            </h2>
            <p>Faded black, Size M</p>
            <p>
              {{ Chip({
                as: "span",
                dot: true,
                label: "Back in stock 21 Oct",
                severity: "warning",
                size: "small"
              }) }}
            </p>
            <div class="ui-layout-row ui-gap-x-small cart-links">
              {% call Button({ size: "x-small", type: "button" }) %}Save for later{% endcall %}
              {% call Button({
                color: "critical",
                size: "x-small",
                type: "button"
              }) %}Remove{% endcall %}
            </div>
          </div>
          <div class="cart-buy">
            {% set start %}{{ StepButton({ command: "--step-down", for: "shopping-cart-qty-tee" }) }}{% endset %}
            {% set end %}{{ StepButton({ command: "--step-up", for: "shopping-cart-qty-tee" }) }}{% endset %}
            {% call Field({
              autoFit: true,
              for: "shopping-cart-qty-tee",
              hideLabel: true,
              label: "Quantity of I'm with the bassist tee",
              size: "small",
              slots: { end: end, start: start }
            }) %}
              <input
                id="shopping-cart-qty-tee"
                min="1"
                name="qty-tee"
                type="number"
                value="1"
              />
            {% endcall %}
            <p class="ui-tabular-nums cart-line-price">€29.00</p>
          </div>
        </li>
      </ul>
    {% endcall %}

    {% call Card({
      "aria-labelledby": "shopping-cart-summary-heading",
      as: "section",
      class: "ui-sticky cart-summary",
      variant: "outlined"
    }) %}
      <hgroup>
        <h2 class="ui-h5" id="shopping-cart-summary-heading">Order summary</h2>
      </hgroup>
      {% call CardContent() %}
        <div class="ui-layout-column ui-gap-small">
          <p id="shopping-cart-free-shipping">
            Woohoo, you've unlocked <strong>free delivery</strong>!
          </p>
          {{ Progress({
            "aria-labelledby": "shopping-cart-free-shipping",
            max: 75,
            value: 75
          }) }}
        </div>

        {% call ControlGroup({ size: "small", variant: "outlined" }) %}
          {% call Field({
            for: "shopping-cart-discount",
            label: "Discount code"
          }) %}
            <input
              id="shopping-cart-discount"
              name="discount"
              placeholder="Enter code"
              type="text"
            />
          {% endcall %}
          {% call Button({ type: "button" }) %}Apply{% endcall %}
        {% endcall %}

        <div>
          {% set end %}<svg
            data-icon="close"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
            ></path>
          </svg>{% endset %}
          {{ Chip({
            "aria-label": "Remove code BASS10, −10%",
            as: "button",
            label: "BASS10, −10%",
            slots: { end: end },
            type: "button",
            variant: "outlined"
          }) }}
        </div>

        {% call DescriptionList({ leader: "solid", orientation: "horizontal" }) %}
          {% call DescriptionListItem() %}
            {% call DescriptionListTerm() %}Subtotal{% endcall %}
            {% call DescriptionListDescription() %}€196.00{% endcall %}
          {% endcall %}
          {% call DescriptionListItem() %}
            {% call DescriptionListTerm() %}Discount{% endcall %}
            {% call DescriptionListDescription() %}−€19.60{% endcall %}
          {% endcall %}
          {% call DescriptionListItem() %}
            {% call DescriptionListTerm() %}Delivery{% endcall %}
            {% call DescriptionListDescription() %}Free{% endcall %}
          {% endcall %}
          {% call DescriptionListItem({ total: true }) %}
            {% call DescriptionListTerm() %}Total{% endcall %}
            {% call DescriptionListDescription() %}€176.40{% endcall %}
          {% endcall %}
        {% endcall %}

        {% call Button({
          class: "cart-checkout",
          href: "#shopping-cart-checkout",
          size: "large",
          variant: "filled"
        }) %}Go to checkout{% endcall %}
        <p class="cart-continue">
          or
          <a class="ui-link" href="#shopping-cart-shop">keep browsing gear</a>
        </p>
      {% endcall %}
    {% endcall %}
  </div>
</div>

<style>
  .shopping-cart {
    .cart-items {
      --_gap: 0;

      li + li {
        border-block-start: var(--ui-border-width) solid var(--ui-border-color);
      }
    }

    .cart-item {
      column-gap: var(--ui-space-4);
      display: grid;
      grid-template-areas:
        "thumb info"
        "thumb buy";
      grid-template-columns: auto minmax(0, 1fr);
      padding: var(--ui-space-4);
      row-gap: var(--ui-space-4);

      @container (inline-size >= 40rem) {
        grid-template-areas: "thumb info buy";
        grid-template-columns: auto minmax(0, 1fr) auto;
      }
    }

    .cart-thumb {
      aspect-ratio: 1;
      background: linear-gradient(
        135deg,
        oklch(from var(--ui-primary) l c calc(h + var(--hue, 0))),
        oklch(from var(--ui-primary) l c calc(h + var(--hue, 0) + 60))
      );
      border-radius: var(--ui-radius);
      grid-area: thumb;
      inline-size: 5rem;
    }

    .cart-info {
      align-items: start;
      grid-area: info;
    }

    .cart-links {
      margin-inline-start: calc(var(--ui-space-2) * -1);
    }

    .cart-buy {
      align-items: center;
      display: flex;
      gap: var(--ui-space-4);
      grid-area: buy;
      justify-content: space-between;

      @container (inline-size >= 40rem) {
        align-items: end;
        flex-direction: column-reverse;
        justify-content: start;
      }
    }

    .cart-line-price {
      font-weight: var(--ui-font-weight-label);
      text-align: end;

      s {
        display: block;
        font-weight: var(--ui-font-weight-body);
      }
    }

    .cart-summary {
      .ui-content {
        display: grid;
        gap: var(--ui-space-5);
      }
    }

    .cart-checkout {
      inline-size: 100%;
    }

    .cart-continue {
      text-align: center;
    }
  }
</style>

<script type="module">
  import "opui-css/elements/step-button.js"
</script>
