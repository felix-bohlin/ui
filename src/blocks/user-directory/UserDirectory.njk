{% from "opui/index.njk" import
  Avatar,
  Badge,
  Button,
  Card,
  CardActions,
  CardContent,
  Chip,
  Field,
  ToggleButton,
  ToggleGroup
%}

<div
  class="user-directory ui-layout-container ui-layout-column ui-gap-large"
  style="--_max-inline-size: 80rem"
>
  <div class="ui-layout-row ui-spread">
    <hgroup class="ui-hgroup">
      <p>Bassbook</p>
      <h1 class="ui-h3">Find bassists</h1>
      <p>48 bassists in 6 cities. Nobody's watching them.</p>
    </hgroup>
    {% call Button({ type: "button", variant: "filled" }) %}
      <svg
        data-icon="person-add"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <path
          fill="currentColor"
          d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4m-9-2V7H4v3H1v2h3v3h2v-3h3v-2zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4"
        ></path>
      </svg><span class="ui-text">Invite a bassist</span>
    {% endcall %}
  </div>

  <search class="ui-layout-row ui-spread user-directory-filters">
    {% set start %}<svg
      data-icon="search"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path
        fill="currentColor"
        d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14"
      ></path>
    </svg>{% endset %}
    {% call Field({
      for: "user-directory-q",
      hideLabel: true,
      label: "Search bassists",
      slots: { start: start }
    }) %}
      <input
        id="user-directory-q"
        name="q"
        placeholder="Search by name, gear or city"
        type="search"
      />
    {% endcall %}
    {% call ToggleGroup({
      "aria-label": "Bass type",
      name: "user-directory-department",
      overflow: "scroll"
    }) %}
      {% call ToggleButton({ checked: true, value: "all" }) %}All{% endcall %}
      {% call ToggleButton({ value: "four-string" }) %}4-string{% endcall %}
      {% call ToggleButton({ value: "five-string" }) %}5-string{% endcall %}
      {% call ToggleButton({ value: "fretless" }) %}Fretless{% endcall %}
      {% call ToggleButton({ value: "upright" }) %}Upright{% endcall %}
    {% endcall %}
  </search>

