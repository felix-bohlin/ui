      {% call Card({ variant: "outlined" }) %}
        {% call CardContent() %}
          <div class="ui-layout-media">
            {% call Avatar({ "aria-hidden": "true" }) %}VR{% endcall %}
            <hgroup>
              <h2 class="ui-h6">Victor Rumble</h2>
              <p>Upright wrangler, jazz only</p>
            </hgroup>
          </div>
          <div class="ui-layout-row ui-gap-small ui-caption">
            {{ Chip({ as: "span", label: "Upright", size: "small" }) }}
            <span>Berlin, 14:20 local time</span>
          </div>
        {% endcall %}
        {% call CardActions() %}
          {% call Button({
            href: "#user-directory-victor-email",
            size: "small",
            variant: "outlined"
          }) %}Email{% endcall %}
          {% call Button({ href: "#user-directory-victor-chat", size: "small" }) %}Message{% endcall %}
          {% call Button({
            "aria-label": "Call Victor",
            href: "#user-directory-victor-call",
            round: true,
            size: "small"
          }) %}<svg
              data-icon="phone"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
