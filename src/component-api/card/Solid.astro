---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell><code>actions</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Actions, wrapped in <code>.ui-actions</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>actionsAlign</code></Table.Cell>
      <Table.Cell><code>"start"</code>, <code>"end"</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Alignment for the <code>actions</code> prop.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional child content.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>content</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Content, wrapped in <code>.ui-content</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>header</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Header, wrapped in <code>hgroup</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>variant</code></Table.Cell>
      <Table.Cell
        ><code>"text"</code>, <code>"outlined"</code>, <code>"tonal"</code>, <code
          >"elevated"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The variant to use.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>
