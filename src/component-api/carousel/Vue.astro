---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell><code>align</code></Table.Cell>
      <Table.Cell><code>"start"</code>, <code>"center"</code></Table.Cell>
      <Table.Cell><code>"start"</code></Table.Cell>
      <Table.Cell>Where items snap.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>buttons</code></Table.Cell>
      <Table.Cell><code>boolean</code>, <code>"outside"</code></Table.Cell>
      <Table.Cell><code>true</code></Table.Cell>
      <Table.Cell>Previous and next buttons.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>label</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Accessible name of the carousel.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>markers</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>One marker per item, after the list.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>peek</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Shows part of the neighbouring items.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>perView</code></Table.Cell>
      <Table.Cell><code>number</code></Table.Cell>
      <Table.Cell><code>1</code></Table.Cell>
      <Table.Cell>Number of visible items.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell>default</Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell><code>&lt;li&gt;</code> items.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>
