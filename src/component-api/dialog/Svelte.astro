---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell
        ><code>actions</code>, <code>children</code>, <code>content</code>, <code
          >header</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Optional snippets. <code>header</code> also accepts a <code
          >string</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>actionsAlign</code></Table.Cell>
      <Table.Cell><code>"start"</code>, <code>"end"</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Alignment of the <code>actions</code> snippet.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>closedby</code></Table.Cell>
      <Table.Cell
        ><code>"any"</code>, <code>"closerequest"</code>, <code>"none"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Specifies how the dialog can be closed (e.g., clicking outside).</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLDialogElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>
