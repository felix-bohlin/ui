---
import { Table } from "@opui/astro"
---

<h3 id="list-svelte">List</h3>

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional snippets.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>bordered</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Adds a border between list items.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>dense</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Packs the list tighter.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>gutterless</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Removes list inline padding.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLUListElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>variant</code></Table.Cell>
      <Table.Cell
        ><code>"default"</code>, <code>"tonal"</code>, <code>"transparent"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The background color variant of the list.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>

<h3 id="list-item-svelte">List item</h3>

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell
        ><code>children</code>, <code>description</code>, <code>end</code>, <code
          >headline</code
        >, <code>start</code>, <code>text</code></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Optional snippets. All except <code>children</code> also accept a <code
          >string</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>as</code></Table.Cell>
      <Table.Cell
        ><code>"li"</code>, <code>"a"</code>, <code>"button"</code>, <code
          >"div"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Renders an inner element of the given tag. Extra props are forwarded to
        it.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>borderTop</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>List item top border.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>for</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >The <code>for</code> attribute of the inner <code>&lt;label&gt;</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>inset</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Aligns with items that have a start icon.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLLIElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>type</code></Table.Cell>
      <Table.Cell
        ><code>"checkbox"</code>, <code>"radio"</code>, <code>"switch"</code>, <code
          >"button"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Wraps the content in a styled <code>&lt;label&gt;</code> for <code
          >"checkbox"</code
        >, <code>"radio"</code> and <code>"switch"</code>.</Table.Cell
      >
    </Table.Row>
  </Table.Body>
</Table>
