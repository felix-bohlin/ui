---
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "@opui/astro"
---

<Table>
  <TableColumnGroup>
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 300px" />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Prop</TableHeaderCell>
      <TableHeaderCell>Type</TableHeaderCell>
      <TableHeaderCell>Default</TableHeaderCell>
      <TableHeaderCell>Description</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell><code>align</code></TableCell>
      <TableCell><code>"start"</code>, <code>"end"</code></TableCell>
      <TableCell><code>"start"</code></TableCell>
      <TableCell>Which edge of the trigger the menu lines up with.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>class</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Optional CSS class.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>dense</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
      <TableCell><code>false</code></TableCell>
      <TableCell>Less spacing.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>id</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>auto-generated</TableCell>
      <TableCell>The trigger's <code>commandfor</code>.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>items</code></TableCell>
      <TableCell><code>MenuItem[]</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Menu items.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>placement</code></TableCell>
      <TableCell>
        <code>"block-end"</code>,{" "}
        <code>"block-start"</code>,{" "}
        <code>"inline-end"</code>,{" "}
        <code>"inline-start"</code>
      </TableCell>
      <TableCell><code>"block-end"</code></TableCell>
      <TableCell>Where the menu opens.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>popover</code></TableCell>
      <TableCell><code>"auto"</code>, <code>"manual"</code></TableCell>
      <TableCell><code>"auto"</code></TableCell>
      <TableCell
        >The popover type. With <code>"manual"</code>, Esc and a click outside
        don't close the menu, and opening another menu doesn't either.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>children</code></TableCell>
      <TableCell><code>Snippet</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Optional child content.</TableCell>
    </TableRow>
  </TableBody>
</Table>

<h3>MenuItem</h3>
<Table>
  <TableColumnGroup>
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 20%" />
    <TableColumn width="min-width: 300px" />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Key</TableHeaderCell>
      <TableHeaderCell>Type</TableHeaderCell>
      <TableHeaderCell>Default</TableHeaderCell>
      <TableHeaderCell>Description</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell><code>borderTop</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
      <TableCell><code>false</code></TableCell>
      <TableCell>Divider above the item.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>closeOnClick</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
      <TableCell><code>true</code></TableCell>
      <TableCell>Close the menu on click.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>critical</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
      <TableCell><code>false</code></TableCell>
      <TableCell>Destructive item.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>disabled</code></TableCell>
      <TableCell><code>boolean</code></TableCell>
      <TableCell><code>false</code></TableCell>
      <TableCell>Disables the item.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>href</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Renders a link instead of a button.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>label</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>The item text.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>shortcut</code></TableCell>
      <TableCell><code>string</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Keyboard shortcut hint.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell>any other key</TableCell>
      <TableCell><code>unknown</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>Passed to the item element.</TableCell>
    </TableRow>
  </TableBody>
</Table>
