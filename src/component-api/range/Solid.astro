---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Label content. Alternative to the <code>label</code> prop.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>datalist</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Extra content rendered inside the <code>&lt;datalist&gt;</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>endText</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Informational text below the range input.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>label</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The label for the range input.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>list</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Id of the <code>&lt;datalist&gt;</code>. Required with <code
          >options</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>max</code></Table.Cell>
      <Table.Cell><code>number</code>, <code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The maximum value.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>min</code></Table.Cell>
      <Table.Cell><code>number</code>, <code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The minimum value.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>options</code></Table.Cell>
      <Table.Cell
        ><code>{"(string | number | { value, label })[]"}</code></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Tick marks rendered as a <code>&lt;datalist&gt;</code>.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>spread</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Spreads the label/text and input to opposite ends.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>startText</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Informational text between label and the range input.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>step</code></Table.Cell>
      <Table.Cell><code>number</code>, <code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The step increment.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>value</code></Table.Cell>
      <Table.Cell><code>number</code>, <code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The current value.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>valueSuffix</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Renders a live <code>&lt;output&gt;</code> next to the label showing the
        current input value, with the suffix appended.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>valueText</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Custom content for the live value readout inside <code
          >&lt;output&gt;</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>variant</code></Table.Cell>
      <Table.Cell
        ><code>"filled"</code>, <code>"default"</code>, <code>"tonal"</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The variant to use.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>
