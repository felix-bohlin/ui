---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell
        ><code>children</code>, <code>description</code>, <code>endText</code>, <code
          >footer</code
        >, <code>header</code>, <code>label</code>, <code>prefix</code>, <code
          >suffix</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Optional snippets. All except <code>children</code> also accept a <code
          >string</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>dense</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Select dense state.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>disabled</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Select disabled state.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>error</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Select error state. Sets <code>[data-invalid]</code> on the root element.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>items</code></Table.Cell>
      <Table.Cell><code>Item[]</code></Table.Cell>
      <Table.Cell><code>[]</code></Table.Cell>
      <Table.Cell
        >An array of objects with <code>text</code> and <code>value</code> properties.
        Rendered before <code>children</code>.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLLabelElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>required</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Select required state.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>size</code></Table.Cell>
      <Table.Cell><code>"small"</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The size of the select.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>spread</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Spreads the label/description and select to opposite ends.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>value</code></Table.Cell>
      <Table.Cell><code>any</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The selected value. Bindable.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>variant</code></Table.Cell>
      <Table.Cell><code>"outlined"</code>, <code>"filled"</code></Table.Cell>
      <Table.Cell><code>"outlined"</code></Table.Cell>
      <Table.Cell>The visual variant of the select.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>
