---
import { Table } from "@opui/astro"
---

<h3 id="tabs-svelte">Tabs</h3>
<p>The main container for the tab items.</p>

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional snippets.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>name</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>auto-generated</Table.Cell>
      <Table.Cell
        >A unique name for the exclusive group. Shared with all children.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLDivElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>

<h3 id="tabs-item-svelte">TabsItem</h3>
<p>
  A logical grouping for a tab trigger and its content. Handles state
  synchronization.
</p>

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional snippets.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>name</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Overrides the group name from <code>Tabs</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>open</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Whether this tab is initially active.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>panelId</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>auto-generated</Table.Cell>
      <Table.Cell
        >The id of the panel. Shared with <code>TabsPanel</code>.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLInputElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>tabId</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>auto-generated</Table.Cell>
      <Table.Cell
        >The id of the tab input. Shared with <code>TabsTab</code> and <code
          >TabsPanel</code
        >.</Table.Cell
      >
    </Table.Row>
  </Table.Body>
</Table>

<h3 id="tabs-tab-svelte">TabsTab</h3>
<p>The visible trigger for the tab.</p>

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell>Snippets</Table.Cell>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional snippets.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>ref</code></Table.Cell>
      <Table.Cell><code>HTMLLabelElement</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Bindable reference to the root element.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>tabId</code></Table.Cell>
      <Table.Cell><code>string</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Overrides the tab id from <code>TabsItem</code>.</Table.Cell>
    </Table.Row>
  </Table.Body>
</Table>

