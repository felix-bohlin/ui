---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Prop</Table.HeaderCell>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell><code>autoFit</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Automatically adjusts its width to content.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>children</code></Table.Cell>
      <Table.Cell><code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional child content.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>description</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Description text displayed above the field.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>endText</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Supporting text displayed below the field.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>error</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell
        >Field error state. Sets <code>[data-invalid]</code> on the root element.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>filled</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Uses the filled variant.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>footer</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Content placed below the input, inside the border, with a divider.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>header</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Content placed above the input, inside the border, with a divider.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>label</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The label for the field.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>prefix</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Content placed at the inline-start of the field, inside the border.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>small</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell>Uses the small size.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>spread</code></Table.Cell>
      <Table.Cell><code>boolean</code></Table.Cell>
      <Table.Cell><code>false</code></Table.Cell>
      <Table.Cell
        >Spreads the label/description and input to opposite ends.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>startText</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Alias for <code>description</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>suffix</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Content placed at the inline-end of the field, inside the border.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>supportingText</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>JSX.Element</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Legacy alias for <code>endText</code>.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><code>type</code></Table.Cell>
      <Table.Cell><code>string</code>, <code>"numeric"</code></Table.Cell>
      <Table.Cell><code>"text"</code></Table.Cell>
      <Table.Cell
        >The input type. <code>"numeric"</code> renders a text input with a numeric
        keyboard.</Table.Cell
      >
    </Table.Row>
  </Table.Body>
</Table>
