---
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
---

<Table>
  <TableColumnGroup>
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 300px" />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Type</TableHeaderCell>
      <TableHeaderCell>Modifiers</TableHeaderCell>
      <TableHeaderCell>Default</TableHeaderCell>
      <TableHeaderCell>Description</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell><strong>Command</strong></TableCell>
      <TableCell><code>--show-toast</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >Custom invoker command to trigger a toast notification.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Close label</strong></TableCell>
      <TableCell><code>data-close-label</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >The <code>aria-label</code> of the close button, set on the trigger. Without
        it, the template's label is kept.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Description</strong></TableCell>
      <TableCell><code>data-description</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >A second line under the title, set on the trigger. Without it, the
        description is removed from the toast.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Duration</strong></TableCell>
      <TableCell><code>data-duration</code></TableCell>
      <TableCell><code>5000ms</code></TableCell>
      <TableCell
        >Determines how long the toast remains visible. Supports CSS time units
        (<code>ms</code>, <code>s</code>).</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Severity</strong></TableCell>
      <TableCell><code>data-severity</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >The severity icon. Options: <code>critical</code>, <code>info</code>,
        <code>success</code>, <code>warning</code>. Without it, the toast has no
        icon.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Template</strong></TableCell>
      <TableCell><code>data-template</code></TableCell>
      <TableCell><code>toast-template</code></TableCell>
      <TableCell
        >The id of the <code>&lt;template&gt;</code> to clone, set on the trigger.
        Without a matching template, the built-in markup is used.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Message</strong></TableCell>
      <TableCell><code>data-title</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >The toast title, set on the trigger. Without it, the trigger's text is
        used.</TableCell
      >
    </TableRow>
  </TableBody>
</Table>

<h3>Parts</h3>
<Table>
  <TableColumnGroup>
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 300px" />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Part</TableHeaderCell>
      <TableHeaderCell>Description</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell><code>#toast-manager</code></TableCell>
      <TableCell
        >The global fixed container that manages the stack of toasts.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-toast</code></TableCell>
      <TableCell
        >Individual notification element within the container.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-icon</code></TableCell>
      <TableCell
        >The severity icon, <code>[data-toast-icon]</code>. Hidden without <code
          >data-severity</code
        >.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-content</code></TableCell>
      <TableCell>Holds the title and description.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-title</code></TableCell>
      <TableCell
        >The title, <code>[data-toast-title]</code>. Filled from <code
          >data-title</code
        >.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-description</code></TableCell>
      <TableCell
        >The second line, <code>[data-toast-description]</code>. Filled from <code
          >data-description</code
        >.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><code>.ui-close-button</code></TableCell>
      <TableCell
        >Closes the toast, <code>[data-toast-close]</code>. <code
          >data-close-label</code
        > sets its <code>aria-label</code>.</TableCell
      >
    </TableRow>
  </TableBody>
</Table>
