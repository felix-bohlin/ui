---
import { Table } from "@opui/astro"
---

<Table>
  <Table.ColumnGroup>
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 20%" />
    <Table.Column width="min-width: 300px" />
  </Table.ColumnGroup>
  <Table.Head>
    <Table.Row>
      <Table.HeaderCell>Type</Table.HeaderCell>
      <Table.HeaderCell>Modifiers</Table.HeaderCell>
      <Table.HeaderCell>Default</Table.HeaderCell>
      <Table.HeaderCell>Description</Table.HeaderCell>
    </Table.Row>
  </Table.Head>
  <Table.Body>
    <Table.Row>
      <Table.Cell><strong>Part</strong></Table.Cell>
      <Table.Cell><code>.ui-toaster</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >The fixed, top layer container. Needs <code>popover="manual"</code> and <code
          >id="toaster"</code
        >.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Positions</strong></Table.Cell>
      <Table.Cell
        >default, <code>.ui-block-start</code>, <code>.ui-inline-start</code>, <code
          >.ui-center</code
        ></Table.Cell
      >
      <Table.Cell>default</Table.Cell>
      <Table.Cell
        >Where the toaster sits. Set on <code>.ui-toaster</code>.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Part</strong></Table.Cell>
      <Table.Cell><code>.ui-toast</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>A toast. Lives while it is inside the toaster.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Children</strong></Table.Cell>
      <Table.Cell
        ><code>.ui-content</code>, <code>.ui-title</code>, <code
          >.ui-description</code
        ></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Optional child content.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Severities</strong></Table.Cell>
      <Table.Cell
        ><code>.ui-info</code>, <code>.ui-success</code>, <code
          >.ui-warning</code
        >, <code>.ui-critical</code></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell>Adds a colored icon.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Duration</strong></Table.Cell>
      <Table.Cell><code>--toast-duration</code></Table.Cell>
      <Table.Cell><code>5s</code></Table.Cell>
      <Table.Cell
        >How long the toast stays. Set on a toast or the toaster.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Persistent</strong></Table.Cell>
      <Table.Cell><code>.ui-persistent</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell>The toast stays until it is dismissed.</Table.Cell>
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Command</strong></Table.Cell>
      <Table.Cell><code>--show-toast</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Shows the <code>&lt;template&gt;</code> or toaster that <code
          >commandfor</code
        > points to.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Command</strong></Table.Cell>
      <Table.Cell><code>--dismiss-toast</code></Table.Cell>
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Dismisses the toast the button is in, or all toasts. <code
          >commandfor</code
        > points to the toaster.</Table.Cell
      >
    </Table.Row>
    <Table.Row>
      <Table.Cell><strong>Data</strong></Table.Cell>
      <Table.Cell
        ><code>data-title</code>, <code>data-description</code>, <code
          >data-severity</code
        >, <code>data-duration</code>, <code>data-persistent</code></Table.Cell
      >
      <Table.Cell>-</Table.Cell>
      <Table.Cell
        >Fill in the toast that <code>--show-toast</code> shows.</Table.Cell
      >
    </Table.Row>
  </Table.Body>
</Table>
