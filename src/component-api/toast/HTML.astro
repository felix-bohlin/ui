---
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "@opui/astro"
---

<Table>
  <TableColumnGroup>
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 20%" />
    <TableColumn style="min-width: 300px" />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Type</TableHeaderCell>
      <TableHeaderCell>Modifiers</TableHeaderCell>
      <TableHeaderCell>Default</TableHeaderCell>
      <TableHeaderCell>Description</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell><strong>Command</strong></TableCell>
      <TableCell><code>--show-toast</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >Custom invoker command to trigger a toast notification.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Message</strong></TableCell>
      <TableCell><code>value</code> / <code>textContent</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell>The message to display in the toast.</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><strong>Severity</strong></TableCell>
      <TableCell><code>data-severity</code></TableCell>
      <TableCell><code>info</code></TableCell>
      <TableCell
        >Modifies the toast appearance. Options: <code>success</code>, <code
          >critical</code
        >, <code>info</code>.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Duration</strong></TableCell>
      <TableCell><code>data-duration</code></TableCell>
      <TableCell><code>5000ms</code></TableCell>
      <TableCell
        >Determines how long the toast remains visible. Supports CSS time units
        (ms, s).</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Container</strong></TableCell>
      <TableCell><code>#toast-manager</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >The global fixed container that manages the stack of toasts.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell><strong>Component</strong></TableCell>
      <TableCell><code>.ui-toast</code></TableCell>
      <TableCell>-</TableCell>
      <TableCell
        >Individual notification element within the container.</TableCell
      >
    </TableRow>
  </TableBody>
</Table>
