{% from "opui/index.njk" import Accordion, AccordionContent, AccordionSummary %}

{% call Accordion({ markerAnimation: "flip", variant: "outlined" }) %}
  {% call AccordionSummary() %}Flip{% endcall %}
  {% call AccordionContent() %}
    <p>
      Return any bass within 30 days for a full refund, no awkward questions.
    </p>
  {% endcall %}
{% endcall %}

{% call Accordion({ markerAnimation: "rotate", variant: "outlined" }) %}
  {% call AccordionSummary() %}Rotate{% endcall %}
  {% call AccordionContent() %}
    <p>String orders over €50 ship free within the EU.</p>
  {% endcall %}
{% endcall %}

{% call Accordion({ markerAnimation: "turn", variant: "outlined" }) %}
  {% set marker %}
    <svg
      data-icon="chevron-right"
      aria-hidden="true"
      class="ui-marker"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path
        fill="currentColor"
        d="M8.293 19.707a1 1 0 0 1 0-1.414L14.586 12 8.293 5.707a1 1 0 1 1 1.414-1.414l7 7a1 1 0 0 1 0 1.414l-7 7a1 1 0 0 1-1.414 0"
      ></path>
    </svg>
  {% endset %}
  {% call AccordionSummary({ slots: { marker: marker } }) %}
    Turn
    
  {% endcall %}
  {% call AccordionContent() %}
    <p>Pay by card, bank transfer or a jar of gig money.</p>
  {% endcall %}
{% endcall %}
