{% from "opui/index.njk" import Badge %}

{% call Badge({
  corner: "start-start",
  hideLabel: true,
  label: "35 unread messages",
  slots: { indicator: "35" }
}) %}
  <svg aria-hidden="true"><!-- --></svg>
{% endcall %}
{% call Badge({
  hideLabel: true,
