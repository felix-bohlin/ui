---
import { BarChart } from "@opui/astro"

const rows = [
  { label: "Jan", values: [412] },
  { label: "Feb", values: [455] },
  { label: "Mar", values: [498] },
  { label: "Apr", values: [471] },
  { label: "May", values: [538] },
  { label: "Jun", values: [602] },
]
---

<BarChart
  caption="Orders per month"
  label="Month"
  rows={rows}
  series={["Orders"]}
/>
