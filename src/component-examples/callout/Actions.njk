{% from "opui/index.njk" import
  Button,
  Callout,
  CalloutActions,
  CalloutContent,
  CalloutIcon
%}

{% call Callout({ severity: "warning" }) %}
  {{ CalloutIcon() }}
  {% call CalloutContent() %}
    <h3>Your Bassbook Gold trial ends in 3 days</h3>
    <p>Choose a plan to keep your setlists and all your slap videos.</p>
  {% endcall %}
  {% call CalloutActions() %}
    {% call Button({ size: "small", variant: "filled" }) %}Choose a plan{% endcall %}
    {% call Button({ size: "small" }) %}Remind me later{% endcall %}
  {% endcall %}
{% endcall %}
