---
import { Callout, CalloutContent, CalloutIcon } from "opui-css/astro"
---

<Callout
  closeLabel="Dismiss"
  dismissible
  id="callout-dismissible-1"
  severity="info"
>
  <CalloutIcon />
  <CalloutContent>
    The new editor is on for everyone. Your drafts from the old one are in
    Settings.
  </CalloutContent>
</Callout>

<script>
  document
    .querySelector("#callout-dismissible-1")
    ?.addEventListener("dismiss", (event) => {
      if (!confirm("Hide this message?")) event.preventDefault()
    })
</script>
