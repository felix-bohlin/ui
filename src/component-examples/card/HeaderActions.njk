{% from "opui/index.njk" import Avatar, Button, Card, CardContent, CardHeader %}

{% call Card({ variant: "outlined" }) %}
  {% call CardHeader({ as: "div" }) %}
    {% call Avatar() %}LH{% endcall %}
    <hgroup>
      <h3>Lou Headstock</h3>
      <p>Posted 2 hours ago</p>
    </hgroup>
    {% call Button({ "aria-label": "More actions", round: true, size: "small" }) %}
      <svg
        data-icon="more-vertical"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <path
          fill="currentColor"
          d="M12 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m0 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4m0 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4"
        ></path>
      </svg>
    {% endcall %}
  {% endcall %}
  {% call CardContent() %}
    Played the whole gig in drop D and nobody noticed, not even the drummer.
    Woohoo, drop D lives on in secret :)
  {% endcall %}
{% endcall %}
