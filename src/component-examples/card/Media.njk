{% from "opui/index.njk" import
  Button,
  Card,
  CardActions,
  CardContent,
  CardHeader
%}

<ul
  role="list"
  class="ui-layout-grid ui-stretch"
  style="--_min-inline-size: 16rem"
>
  <li>
    {% call Card({ variant: "outlined" }) %}
      <img
        alt="Green cliffs and a winding road under a cloudy sky"
        height="450"
        loading="lazy"
        src="https://picsum.photos/id/1018/800/450"
        width="800"
      />
      {% call CardHeader() %}
        <p>Norway</p>
        <h3>Lofoten by bike</h3>
        <p>Six days along the coast</p>
      {% endcall %}
      {% call CardContent() %}
        Ride from Å to Svolvær with your luggage sent ahead, and sleep in
        fishing cabins on the water.
      {% endcall %}
      {% call CardActions() %}
        {% call Button() %}Save{% endcall %}
        {% call Button({ variant: "filled" }) %}Book{% endcall %}
      {% endcall %}
    {% endcall %}
  </li>
  <li>
    {% call Card({ variant: "outlined" }) %}
      {% call CardHeader() %}
        <p>Field notes</p>
        <h3>A week in the mountains</h3>
      {% endcall %}
      <img
        alt="Yellow tents in a snowy mountain camp"
        height="450"
        loading="lazy"
        src="https://picsum.photos/id/1036/800/450"
        style="aspect-ratio: 2 / 1"
        width="800"
      />
      {% call CardContent() %}
        Base camp sat at 3,200 meters, two days from the road.
      {% endcall %}
    {% endcall %}
  </li>
</ul>
