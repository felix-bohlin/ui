{% from "opui/index.njk" import
  Button,
  Card,
  CardActions,
  CardContent,
  CardHeader
%}

{% call Card({ variant: "outlined" }) %}
  <img
    alt="A deep blue fjord between steep mountains"
    height="450"
    loading="lazy"
    src="https://picsum.photos/id/1015/800/450"
    width="800"
  />
  {% call CardHeader() %}
    <p>Norway</p>
    <h3>Fjord cruise from Bergen</h3>
    <p>Three nights, from 6 June</p>
  {% endcall %}
  {% call CardContent() %}
    Sail the Sognefjord with stops in Flåm and Balestrand. Cabins have a window
    on the water.
  {% endcall %}
  {% call CardActions() %}
    {% call Button({ variant: "filled" }) %}Book{% endcall %}
  {% endcall %}
{% endcall %}

{% call Card({ orientation: "vertical", variant: "outlined" }) %}
  <img
    alt="Green cliffs and a winding road under a cloudy sky"
    height="450"
    loading="lazy"
    src="https://picsum.photos/id/1018/800/450"
    style="aspect-ratio: 3 / 1"
    width="800"
  />
  {% call CardHeader() %}
    <p>Norway</p>
    <h3>Lofoten by bike</h3>
  {% endcall %}
  {% call CardContent() %}
    Six days from Å to Svolvær, with your luggage sent ahead.
  {% endcall %}
{% endcall %}

{% call Card({
  orientation: "horizontal",
  style: "max-inline-size: 24rem",
  variant: "outlined"
}) %}
  <img
    alt="Yellow tents in a snowy mountain camp"
    height="450"
    loading="lazy"
    src="https://picsum.photos/id/1036/800/450"
    width="800"
  />
  {% call CardHeader() %}
    <p>Field notes</p>
    <h3>A week in the mountains</h3>
  {% endcall %}
{% endcall %}
