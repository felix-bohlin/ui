{% from "opui/index.njk" import Carousel %}
{% set tutorials = [
  {
    id: "gmI5nvzv170",
    title: "CSS only carousel? Learn ::scroll-button() in 9 minutes"
  },
  { id: "bP8mrNdR-hs", title: "I love the new CSS functions" },
  { id: "qu1jE41O_8o", title: "Use these CSS features instead of JavaScript" }
] %}

{% call Carousel({ "aria-label": "Tutorials", markers: true }) %}
  {% for tutorial in tutorials -%}
    <li>
      <iframe
        allow="encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        src="https://www.youtube-nocookie.com/embed/{{ tutorial.id }}"
        title="{{ tutorial.title }}"
      ></iframe>
    </li>
  {%- endfor %}
{% endcall %}
