{% from "opui/index.njk" import Card, Carousel %}
{% set slides = [1, 2, 3, 4, 5] %}

{% call Carousel({
  "aria-label": "Destinations",
  buttons: "outside",
  itemsPerView: 3
}) %}
  {% for slide in slides -%}
    <li>
      {{ Card({ style: "block-size: 8rem", variant: "tonal" }) }}
    </li>
  {%- endfor %}
{% endcall %}
