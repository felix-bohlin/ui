{% from "opui/index.njk" import Carousel %}
{% set videos = [
  { label: "A red flower bud opening", name: "flower" },
  { label: "Scene from a black-and-white film", name: "friday" }
] %}

{% call Carousel({ "aria-label": "Videos", markers: true }) %}
  {% for video in videos -%}
    <li>
      <video
        aria-label="{{ video.label }}"
        controls
        playsinline
        preload="metadata"
        src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/{{ video.name }}.mp4"
      ></video>
    </li>
  {%- endfor %}
{% endcall %}
