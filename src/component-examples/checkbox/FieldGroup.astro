---
import {
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
} from "opui-css/astro"
---

<Form>
  <Fieldset>
    <FieldLegend>Notifications</FieldLegend>
    <FieldGroup>
      <Checkbox checked name="checkbox-group">Email</Checkbox>
      <Checkbox name="checkbox-group">Push</Checkbox>
      <Checkbox name="checkbox-group">SMS</Checkbox>
    </FieldGroup>
  </Fieldset>
</Form>
