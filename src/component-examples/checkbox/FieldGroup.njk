{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Notifications{% endcall %}
    {% call FieldGroup({ name: "checkbox-group" }) %}
      {% call Checkbox({ checked: true }) %}Email{% endcall %}
      {% call Checkbox() %}Push{% endcall %}
      {% call Checkbox() %}SMS{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
