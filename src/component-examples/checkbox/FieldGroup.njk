{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Notifications{% endcall %}
    {% call FieldGroup() %}
      {% call Checkbox({ checked: true, name: "checkbox-group" }) %}Email{% endcall %}
      {% call Checkbox({ name: "checkbox-group" }) %}Push{% endcall %}
      {% call Checkbox({ name: "checkbox-group" }) %}SMS{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
