---
import {
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
} from "opui-css/astro"
---

<Form>
  <Fieldset disabled>
    <FieldLegend>Newsletter topics</FieldLegend>
    <FieldGroup orientation="horizontal">
      <Checkbox checked name="checkbox-group-disabled">Bassbook news</Checkbox>
      <Checkbox name="checkbox-group-disabled">Events</Checkbox>
      <Checkbox name="checkbox-group-disabled">Gear deals</Checkbox>
    </FieldGroup>
  </Fieldset>
</Form>
