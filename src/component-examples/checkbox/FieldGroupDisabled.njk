{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset({ disabled: true }) %}
    {% call FieldLegend() %}Newsletter topics{% endcall %}
    {% call FieldGroup({
      name: "checkbox-group-disabled",
      orientation: "horizontal"
    }) %}
      {% call Checkbox({ checked: true }) %}Bassbook news{% endcall %}
      {% call Checkbox() %}Events{% endcall %}
      {% call Checkbox() %}Gear deals{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
