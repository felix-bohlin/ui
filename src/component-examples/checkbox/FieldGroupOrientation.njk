{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Toppings{% endcall %}
    {% call FieldGroup({ orientation: "horizontal" }) %}
      {% call Checkbox({ checked: true, name: "checkbox-group-orientation" }) %}Cheese{% endcall %}
      {% call Checkbox({ name: "checkbox-group-orientation" }) %}Mushrooms{% endcall %}
      {% call Checkbox({ name: "checkbox-group-orientation" }) %}Olives{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
