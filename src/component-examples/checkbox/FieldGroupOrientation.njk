{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Toppings{% endcall %}
    {% call FieldGroup({
      name: "checkbox-group-orientation",
      orientation: "horizontal"
    }) %}
      {% call Checkbox({ checked: true }) %}Cheese{% endcall %}
      {% call Checkbox() %}Mushrooms{% endcall %}
      {% call Checkbox() %}Olives{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
