{% from "opui/index.njk" import
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Agreements{% endcall %}
    {% call FieldGroup({ orientation: "horizontal" }) %}
      {% call Checkbox({ name: "checkbox-group-required", required: true }) %}Terms of service{% endcall %}
      {% call Checkbox({ name: "checkbox-group-required", required: true }) %}Privacy policy{% endcall %}
      {% call Checkbox({ name: "checkbox-group-required", required: true }) %}Data processing{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
