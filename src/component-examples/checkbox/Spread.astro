---
import { Checkbox } from "opui-css/astro"
---

<Checkbox name="checkbox-spread" spread value="gift-wrap">
  Gift wrap
  <Fragment slot="end-text">Wrapped in recycled paper for €3.</Fragment>
</Checkbox>

<Checkbox name="checkbox-spread" required spread value="terms">
  I accept the terms of sale
  <Fragment slot="end-text">Required to place the order.</Fragment>
</Checkbox>

<Checkbox disabled name="checkbox-spread" spread value="express">
  Express delivery
  <Fragment slot="end-text">Not available for your address.</Fragment>
</Checkbox>

<Checkbox error name="checkbox-spread" spread value="age">
  I'm 18 or older
  <Fragment slot="end-text">Confirm your age to buy this item.</Fragment>
</Checkbox>
