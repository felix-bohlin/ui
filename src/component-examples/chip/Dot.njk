{% from "opui/index.njk" import Chip %}

<div class="example-row">
  {{ Chip({ dot: true, label: "Past due", severity: "critical" }) }}
  {{ Chip({ dot: true, label: "Processing", severity: "info" }) }}
  {{ Chip({ dot: true, label: "Refunded", severity: "neutral" }) }}
  {{ Chip({ dot: true, label: "Paid", severity: "success" }) }}
  {{ Chip({ dot: true, label: "Due 15 Oct", severity: "warning" }) }}
</div>

<div class="example-row">
  {{ Chip({
    dot: true,
    label: "Past due",
    severity: "critical",
    size: "small",
    variant: "outlined"
  }) }}
  {{ Chip({
    dot: true,
    label: "Processing",
    severity: "info",
    size: "small",
    variant: "outlined"
  }) }}
  {{ Chip({
    dot: true,
    label: "Refunded",
    severity: "neutral",
    size: "small",
    variant: "outlined"
  }) }}
  {{ Chip({
    dot: true,
    label: "Paid",
    severity: "success",
    size: "small",
    variant: "outlined"
  }) }}
  {{ Chip({
    dot: true,
    label: "Due 15 Oct",
    severity: "warning",
    size: "small",
    variant: "outlined"
  }) }}
</div>
