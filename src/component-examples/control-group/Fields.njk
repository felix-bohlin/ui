{% from "opui/index.njk" import
  Button,
  ControlGroup,
  Field,
  FieldGroup,
  FieldLegend,
  Fieldset,
  SelectButton,
  StepButton
%}

{% call ControlGroup({
  "aria-label": "Find a bassist",
  color: "primary",
  variant: "filled"
}) %}
  {% call Field({
    for: "control-group-fields-2",
    hideLabel: true,
    label: "Bassist name or handle"
  }) %}
    <input
      id="control-group-fields-2"
      placeholder="Search bassists"
      type="search"
    />
  {% endcall %}
  {% call Button() %}Search{% endcall %}
{% endcall %}

{% call Fieldset() %}
  {% call FieldLegend() %}Price{% endcall %}
  {% call FieldGroup() %}
    {% call ControlGroup() %}
      {% call Field({
        for: "control-group-fields-4",
        hideLabel: true,
        label: "Currency"
      }) %}
        <select id="control-group-fields-4" name="currency">
          {{ SelectButton() }}
          <option value="eur">EUR</option>
          <option value="sek">SEK</option>
          <option value="usd">USD</option>
        </select>
      {% endcall %}
      {% call Field({
        for: "control-group-fields-3",
        hideLabel: true,
        label: "Amount"
      }) %}
        <input
          id="control-group-fields-3"
          inputmode="decimal"
          name="amount"
          placeholder="0.00"
        />
      {% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Add to cart",
  color: "primary",
  variant: "filled"
}) %}
  {% set start %}{{ StepButton({ command: "--step-down", for: "control-group-fields-1" }) }}{% endset %}
  {% set end %}{{ StepButton({ command: "--step-up", for: "control-group-fields-1" }) }}{% endset %}
  {% call Field({
    autoFit: true,
    for: "control-group-fields-1",
    hideLabel: true,
    label: "Quantity",
    slots: { end: end, start: start }
  }) %}
    <input
      id="control-group-fields-1"
      max="10"
      min="1"
      name="quantity"
      type="number"
      value="1"
    />
  {% endcall %}
  {% call Button() %}Add to cart{% endcall %}
{% endcall %}

<script type="module">
  import "opui-css/elements/step-button.js"
</script>
