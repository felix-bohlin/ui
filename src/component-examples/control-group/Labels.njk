{% from "opui/index.njk" import Button, ControlGroup, Field %}

{% call ControlGroup({ "aria-label": "Discount", variant: "outlined" }) %}
  {% call Field({ for: "control-group-labels-2", label: "Discount code" }) %}
    <input
      aria-describedby="control-group-labels-1"
      id="control-group-labels-2"
      name="discount"
      value="SPRING10"
    />
  {% endcall %}
  {% call Button() %}Apply{% endcall %}
{% endcall %}
<p id="control-group-labels-1">One code per order.</p>
