{% from "opui/index.njk" import Button, ControlGroup, Field %}

{% call ControlGroup({ "aria-label": "Text size", orientation: "vertical" }) %}
  {% call Button({ "aria-label": "Increase" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
  {% call Button({ "aria-label": "Decrease" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Text size",
  orientation: "vertical",
  variant: "outlined"
}) %}
  {% call Button({ "aria-label": "Increase" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
  {% call Button({ "aria-label": "Decrease" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Text size",
  orientation: "vertical",
  variant: "tonal"
}) %}
  {% call Button({ "aria-label": "Increase" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
  {% call Button({ "aria-label": "Decrease" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Text size",
  orientation: "vertical",
  variant: "filled"
}) %}
  {% call Button({ "aria-label": "Increase" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
  {% call Button({ "aria-label": "Decrease" }) %}
    <svg aria-hidden="true"><!-- --></svg>
  {% endcall %}
{% endcall %}

{% call ControlGroup({ "aria-label": "Move row", orientation: "vertical" }) %}
  {% call Button() %}Up{% endcall %}
  {% call Button() %}Down{% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Move row",
  orientation: "vertical",
  variant: "outlined"
}) %}
  {% call Button() %}Up{% endcall %}
  {% call Button() %}Down{% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Move row",
  orientation: "vertical",
  variant: "tonal"
}) %}
  {% call Button() %}Up{% endcall %}
  {% call Button() %}Down{% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Move row",
  orientation: "vertical",
  variant: "filled"
}) %}
  {% call Button() %}Up{% endcall %}
  {% call Button() %}Down{% endcall %}
{% endcall %}

{% call ControlGroup({
  "aria-label": "Delivery note",
  orientation: "vertical",
  variant: "filled"
}) %}
  {% call Field({
    for: "control-group-vertical-1",
    hideLabel: true,
    label: "Delivery note"
  }) %}
    <textarea
      id="control-group-vertical-1"
      placeholder="Leave it at the back door"
    ></textarea>
  {% endcall %}
  {% call Button() %}Send note{% endcall %}
{% endcall %}
