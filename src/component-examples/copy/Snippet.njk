{% from "opui/index.njk" import Button, Copy, Tooltip, TooltipContent %}

{% call Copy({ id: "copy-snippet-1" }) %}
  <pre class="ui-code-block"><code><span data-copy-ignore>$ </span>npm install opui-css</code></pre>
  {% call Tooltip({ id: "copy-snippet-2" }) %}
    {% call Button({
      "aria-label": "Copy",
      command: "--copy",
      commandfor: "copy-snippet-1",
      interestfor: "copy-snippet-2",
      round: true
    }) %}
      <svg
        data-icon="copy"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
      >
        <path
          fill="currentColor"
          d="M9 18q-.825 0-1.412-.587T7 16V4q0-.825.588-1.412T9 2h9q.825 0 1.413.588T20 4v12q0 .825-.587 1.413T18 18zm0-2h9V4H9zm-4 6q-.825 0-1.412-.587T3 20V6h2v14h11v2z"
        ></path>
      </svg>
    {% endcall %}
    {% call TooltipContent() %}Copy{% endcall %}
  {% endcall %}
{% endcall %}

<script type="module">
  import "opui-css/elements/copy.js"
</script>
