---
import { DataGrid } from "@opui/astro"
import { people } from "./data"

const columns = [
  { key: "name", label: "Name", rowHeader: true },
  { key: "role", label: "Role" },
  { key: "email", label: "Email" },
  { key: "city", label: "Location" },
]
---

<DataGrid columns={columns} label="Team" resizable rows={people} />
