---
import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogHeader,
} from "opui-css/astro"
---

<Button
  color="critical"
  commandfor="alert-dialog-example"
  command="show-modal"
  variant="outlined"
>
  Delete project
</Button>

<Dialog
  id="alert-dialog-example"
  role="alertdialog"
  aria-describedby="alert-dialog-description"
>
  <DialogHeader>
    <h2 class="ui-h4">Delete project?</h2>
  </DialogHeader>
  <DialogContent>
    <p id="alert-dialog-description">
      This deletes the project and all its files. You can't undo this.
    </p>
  </DialogContent>
  <DialogActions>
    <Button commandfor="alert-dialog-example" command="close" type="button">
      Cancel
    </Button>
    <Button
      color="critical"
      commandfor="alert-dialog-example"
      command="close"
      type="button"
      variant="filled"
    >
      Delete
    </Button>
  </DialogActions>
</Dialog>
