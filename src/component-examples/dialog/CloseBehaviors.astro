---
import {
  Button,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Radio,
} from "opui-css/astro"
---

<Button
  command="show-modal"
  commandfor="dialog-close-behaviors-1"
  variant="outlined"
>
  Open dialog
</Button>

<Dialog closedby="any" id="dialog-close-behaviors-1">
  <DialogHeader>
    <DialogTitle>How to close</DialogTitle>
  </DialogHeader>
  <DialogContent>
    <Fieldset>
      <FieldLegend>Choose a closing behavior:</FieldLegend>
      <FieldGroup name="closedby-demo">
        <Radio checked value="any">any</Radio>
        <Radio value="closerequest">closerequest</Radio>
        <Radio value="none">none</Radio>
      </FieldGroup>
    </Fieldset>
  </DialogContent>
  <DialogFooter>
    <Button command="close" commandfor="dialog-close-behaviors-1">
      Close manually
    </Button>
  </DialogFooter>
</Dialog>

<script>
  const dialog = document.getElementById("dialog-close-behaviors-1")
  document
    .querySelectorAll<HTMLInputElement>('input[name="closedby-demo"]')
    .forEach((radio) => {
      radio.addEventListener("change", () =>
        dialog?.setAttribute("closedby", radio.value),
      )
    })
</script>
