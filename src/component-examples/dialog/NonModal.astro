---
import {
  Button,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from "opui-css/astro"
---

<Button id="dialog-non-modal-2" variant="outlined">Show uploads</Button>

<Dialog closedby="any" id="dialog-non-modal-1">
  <DialogHeader>
    <DialogTitle>Uploads</DialogTitle>
  </DialogHeader>
  <DialogContent>
    <p>2 of 3 files uploaded. Keep working while the last one finishes.</p>
  </DialogContent>
  <DialogFooter>
    <Button command="close" commandfor="dialog-non-modal-1">Hide</Button>
  </DialogFooter>
</Dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "#dialog-non-modal-1",
  )
  document
    .querySelector("#dialog-non-modal-2")
    ?.addEventListener("click", () => dialog?.show())
</script>
