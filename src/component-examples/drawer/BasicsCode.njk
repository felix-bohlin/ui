{% from "opui/index.njk" import
  Button,
  Checkbox,
  Drawer,
  DrawerContent,
  DrawerFooter,
  DrawerHeader,
  DrawerTitle,
  FieldGroup,
  FieldLegend,
  Fieldset,
  List,
  ListItem
%}

{% call Button({ command: "show-modal", commandfor: "drawer-basics-3" }) %}Block start{% endcall %}
{% call Button({ command: "show-modal", commandfor: "drawer-basics-1" }) %}Inline start{% endcall %}
{% call Button({ command: "show-modal", commandfor: "drawer-basics-2" }) %}Inline end{% endcall %}
{% call Button({ command: "show-modal", commandfor: "drawer-basics-4" }) %}Block end{% endcall %}

{% call Drawer({
  closeOnNavigate: true,
  id: "drawer-basics-1",
  side: "inline-start"
}) %}
  {% call DrawerHeader({ closeButton: true }) %}
    {% call DrawerTitle() %}Menu{% endcall %}
  {% endcall %}
  {% call DrawerContent() %}
    {% call List({ variant: "transparent" }) %}
      {{ ListItem({ "aria-current": "page", href: "#basics", label: "My wall" }) }}
      {{ ListItem({ href: "#basics", label: "My bands" }) }}
      {{ ListItem({ href: "#basics", label: "Gear Talk" }) }}
      {{ ListItem({ href: "#basics", label: "Settings" }) }}
    {% endcall %}
  {% endcall %}
  {% call DrawerFooter({ align: "start" }) %}
    {% call Button({
      command: "close",
      commandfor: "drawer-basics-1",
      size: "small"
    }) %}Sign out{% endcall %}
  {% endcall %}
{% endcall %}

{% call Drawer({
  backdrop: "transparent",
  id: "drawer-basics-2",
  side: "inline-end"
}) %}
  {% call DrawerHeader({ closeButton: true }) %}
    {% call DrawerTitle() %}Friday gig prep{% endcall %}
    {% call Button({ "aria-label": "Edit", round: true, size: "small" }) %}
      <svg
        data-icon="edit"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 32 32"
      >
        <path
          fill="currentColor"
          d="M21.65 3.434a4.889 4.889 0 1 1 6.915 6.914l-.902.901l-6.914-6.914zM19.335 5.75L4.357 20.73a3.7 3.7 0 0 0-1.002 1.84l-1.333 6.22a1 1 0 0 0 1.188 1.188l6.22-1.333a3.7 3.7 0 0 0 1.84-1.002l14.98-14.98z"
        ></path>
      </svg>
    {% endcall %}
  {% endcall %}
  {% call DrawerContent({
    "aria-label": "Gig details",
    role: "region",
    tabindex: "0"
  }) %}
    <p>
      Assigned to Kinga Headstock, due Friday. Scott Humbucker checks the
      setlist, and the drummer promises (again) to bring the cymbals by
      Wednesday.
    </p>
    <p>
      The band booked this gig without telling you, so here is the totally rad
      catch-up plan: five rehearsals over two weeks, and no more surprises.
    </p>
    <p>
      Day 1: restring with fresh flatwounds, tune to drop D and play the root
      notes of every song until your fingers say thank you.
    </p>
    <p>
      Day 2: learn the new song the guitarist wrote, which has eleven chords,
      four key changes and one very long solo that is not yours.
    </p>
    <p>
      Day 4: practice the slap part in the bridge, with a short video that shows
      how to look cool while nobody watches the bassist.
    </p>
    <p>
      Day 7: full rehearsal with the band, where somebody will ask you to turn
      it down and somebody else will ask why you can't be heard.
    </p>
    <p>
      Day 14: soundcheck at the venue, where the sound engineer calls you the
      tall guitarist and the drummer gets all the credit.
    </p>
    <p>
      Keep the pedalboard under 10 pedals, with one tuner and no more than two
      fuzzes. Pack the spare strings last, once the cables are coiled.
    </p>
    <p>
      Send the setlist to the merch table before Thursday. They sell the shirts,
      so they need to know which songs have a bass solo (zero).
    </p>
    <p>
      Test every cable and the low B on the 5-string, in the rehearsal room and
      on the actual stage, before the doors open at eight.
    </p>
    <p>
      Scott Humbucker created the task on 3 March, and Kinga Headstock moved it
      to Rocking on 5 March.
    </p>
  {% endcall %}
  {% call DrawerFooter() %}
    {% call Button({
      command: "close",
      commandfor: "drawer-basics-2",
      size: "small",
      variant: "filled"
    }) %}Mark as done{% endcall %}
  {% endcall %}
{% endcall %}

{% call Drawer({ id: "drawer-basics-3", side: "block-start" }) %}
  {% call DrawerHeader({ closeButton: true }) %}
    {% call DrawerTitle() %}Notifications{% endcall %}
  {% endcall %}
  {% call DrawerContent() %}
    <p>Scott Humbucker commented on Friday gig prep.</p>
    <p>Your setlist export is ready to download, woohoo.</p>
    <p>Kinga Headstock invited you to Mixed Too Low.</p>
  {% endcall %}
  {% call DrawerFooter() %}
    {% call Button({
      command: "close",
      commandfor: "drawer-basics-3",
      size: "small"
    }) %}Mark all as read{% endcall %}
  {% endcall %}
{% endcall %}

{% call Drawer({ id: "drawer-basics-4", side: "block-end" }) %}
  {% call DrawerHeader({ closeButton: true }) %}
    {% call DrawerTitle() %}Filters{% endcall %}
  {% endcall %}
  {% call DrawerContent() %}
    {% call Fieldset() %}
      {% call FieldLegend() %}Status{% endcall %}
      {% call FieldGroup({ name: "status", orientation: "horizontal" }) %}
        {% call Checkbox({ checked: true, value: "done" }) %}Done{% endcall %}
        {% call Checkbox({ checked: true, value: "in-progress" }) %}Rocking{% endcall %}
        {% call Checkbox({ value: "open" }) %}Not yet{% endcall %}
      {% endcall %}
    {% endcall %}
  {% endcall %}
  {% call DrawerFooter() %}
    <p>24 tasks</p>
    <div class="ui-actions">
      {% call Button({ size: "small" }) %}Reset{% endcall %}
      {% call Button({
        command: "close",
        commandfor: "drawer-basics-4",
        size: "small",
        variant: "filled"
      }) %}Apply{% endcall %}
    </div>
  {% endcall %}
{% endcall %}

<script type="module">
  import "opui-css/elements/close-on-navigate.js"
  import "opui-css/elements/drawer-swipe.js"
</script>
