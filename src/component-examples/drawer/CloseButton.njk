{% from "opui/index.njk" import
  Button,
  DrawerContent,
  DrawerHeader,
  DrawerTitle
%}

{% call Button({
  command: "show-modal",
  commandfor: "drawer-close-button-1",
  variant: "outlined"
}) %}
  Show filters
{% endcall %}

<dialog
  aria-labelledby="drawer-close-button-1-title"
  class="ui-drawer"
  closedby="any"
  id="drawer-close-button-1"
>
  {% call DrawerHeader({
    closeButton: true,
    commandfor: "drawer-close-button-1"
  }) %}
    {% call DrawerTitle({ id: "drawer-close-button-1-title" }) %}Filters{% endcall %}
  {% endcall %}
  {% call DrawerContent() %}
    <p>Narrow the list by status, owner and date.</p>
  {% endcall %}
</dialog>
