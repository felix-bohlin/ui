---
import { Field } from "opui-css/astro"
---

<Field for="field-affix-1" label="Amount">
  <input
    aria-describedby="field-affix-1-start field-affix-1-end"
    id="field-affix-1"
    placeholder="0.00"
  />
  <Fragment slot="start">€</Fragment>
  <Fragment slot="end">EUR</Fragment>
</Field>

<Field for="field-affix-2" label="Website">
  <input
    aria-describedby="field-affix-2-start"
    id="field-affix-2"
    placeholder="example.com"
  />
  <Fragment slot="start">https://</Fragment>
</Field>

<Field for="field-affix-3" label="Weight">
  <input
    aria-describedby="field-affix-3-end"
    id="field-affix-3"
    inputmode="decimal"
    placeholder="0"
  />
  <Fragment slot="end">kg</Fragment>
</Field>

<Field for="field-affix-4" label="Search">
  <input
    aria-describedby="field-affix-4-start"
    id="field-affix-4"
    placeholder="Search..."
  />
  <svg
    data-icon="search"
    aria-hidden="true"
    slot="start"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
</Field>
