{% from "opui/index.njk" import Field %}

{% call Field({
  for: "field-affix-1",
  label: "Amount",
  slots: { end: "EUR", start: "€" }
}) %}
  <input
    aria-describedby="field-affix-1-start field-affix-1-end"
    id="field-affix-1"
    placeholder="0.00"
  />
{% endcall %}

{% call Field({
  for: "field-affix-2",
  label: "Website",
  slots: { start: "https://" }
}) %}
  <input
    aria-describedby="field-affix-2-start"
    id="field-affix-2"
    placeholder="example.com"
  />
{% endcall %}

{% call Field({ for: "field-affix-3", label: "Weight", slots: { end: "kg" } }) %}
  <input
    aria-describedby="field-affix-3-end"
    id="field-affix-3"
    inputmode="decimal"
    placeholder="0"
  />
{% endcall %}

{% set start %}<svg
  data-icon="search"
  aria-hidden="true"
  width="16"
  height="16"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="11" cy="11" r="8"></circle>
  <path d="m21 21-4.3-4.3"></path>
</svg>{% endset %}
{% call Field({ for: "field-affix-4", label: "Search", slots: { start: start } }) %}
  <input id="field-affix-4" placeholder="Search..." />
{% endcall %}
