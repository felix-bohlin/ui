{% from "opui/index.njk" import Field %}

{% call Field({
  dropZone: true,
  endText: "PDF, PNG or JPG, up to 10 MB.",
  for: "field-drop-zone-1",
  label: "Receipt"
}) %}
  <input
    accept=".pdf,.png,.jpg"
    aria-describedby="field-drop-zone-1-end-text"
    id="field-drop-zone-1"
    type="file"
  />
{% endcall %}
