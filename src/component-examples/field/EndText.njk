{% from "opui/index.njk" import Field %}

{% call Field({
  endText: "We never share your email.",
  for: "field-end-text-1",
  label: "Email"
}) %}
  <input
    aria-describedby="field-end-text-1-end-text"
    id="field-end-text-1"
    placeholder="name@example.com"
    type="email"
  />
{% endcall %}
