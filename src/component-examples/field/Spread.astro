---
import { Field } from "opui-css/astro"
---

<Field for="field-spread-1" spread>
  <input
    aria-describedby="field-spread-1-start-text"
    id="field-spread-1"
    placeholder="Holly Humbucker"
  />
  <Fragment slot="label">Name</Fragment>
  <Fragment slot="start-text"
    >Your full name, as the drummer never says it</Fragment
  >
</Field>

<Field for="field-spread-2" spread variant="filled">
  <input
    aria-describedby="field-spread-2-start-text field-spread-2-end-text"
    id="field-spread-2"
    placeholder="name@lowend.example"
    type="email"
  />
  <Fragment slot="label">Email</Fragment>
  <Fragment slot="start-text">We'll send your gig invites here</Fragment>
  <Fragment slot="end-text">Use one the band checks.</Fragment>
</Field>

<Field for="field-spread-3" label="Band" spread>
  <input
    aria-describedby="field-spread-3-start-text"
    id="field-spread-3"
    required
  />
  <Fragment slot="start-text">Shown on your gig flyers</Fragment>
</Field>

<Field for="field-spread-4" label="Member ID" spread>
  <input
    aria-describedby="field-spread-4-start-text"
    disabled
    id="field-spread-4"
    value="BASS-20931"
  />
  <Fragment slot="start-text">Assigned when you joined Bassbook</Fragment>
</Field>

<Field for="field-spread-5" label="Display name" spread>
  <input
    aria-describedby="field-spread-5-start-text field-spread-5-end-text"
    aria-invalid="true"
    id="field-spread-5"
    value="A"
  />
  <Fragment slot="start-text">Shown next to your wall posts</Fragment>
  <Fragment slot="end-text">Enter at least two characters.</Fragment>
</Field>

<Field for="field-spread-6" label="Amount" spread>
  <input
    aria-describedby="field-spread-6-start-text field-spread-6-start field-spread-6-end"
    id="field-spread-6"
    placeholder="0.00"
  />
  <Fragment slot="start-text">Daily gear spending limit</Fragment>
  <Fragment slot="start">€</Fragment>
  <Fragment slot="end">EUR</Fragment>
</Field>

<Field for="field-spread-7" label="Website" spread variant="filled">
  <input
    aria-describedby="field-spread-7-start-text field-spread-7-start field-spread-7-end-text"
    id="field-spread-7"
    placeholder="example.com"
  />
  <Fragment slot="start-text">Your band homepage, totally rad</Fragment>
  <Fragment slot="start">https://</Fragment>
  <Fragment slot="end-text">Include the domain, like example.com.</Fragment>
</Field>

<Field for="field-spread-8" label="Band page" spread>
  <input
    aria-describedby="field-spread-8-start-text field-spread-8-top field-spread-8-bottom"
    id="field-spread-8"
    placeholder="my-band"
  />
  <Fragment slot="start-text">Used to make your band page URL</Fragment>
  <Fragment slot="top">bassbook.example/</Fragment>
  <Fragment slot="bottom">Lowercase letters and dashes only</Fragment>
</Field>

<Field for="field-spread-9" label="Secret riff" spread variant="filled">
  <input
    aria-describedby="field-spread-9-start-text field-spread-9-top field-spread-9-start field-spread-9-bottom field-spread-9-end-text"
    id="field-spread-9"
    placeholder="Paste your riff"
    type="password"
  />
  <Fragment slot="start-text">Locked away from guitarists</Fragment>
  <Fragment slot="start">
    <svg
      data-icon="lock"
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </Fragment>
  <Fragment slot="top">Secret</Fragment>
  <Fragment slot="bottom">Changes every 90 days</Fragment>
  <Fragment slot="end-text">Never show it to the drummer.</Fragment>
</Field>
