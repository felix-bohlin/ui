{% from "opui/index.njk" import
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Field,
  FieldGroup,
  Form
%}

{% call Form() %}
  {% call Callout({
    "aria-labelledby": "form-error-summary-4",
    id: "form-error-summary-1",
    role: "group",
    severity: "critical",
    tabindex: "-1"
  }) %}
    {{ CalloutIcon() }}
    {% call CalloutContent({ class: "ui-rich-text" }) %}
      <h3 id="form-error-summary-4">Fix 2 fields to create your account</h3>
      <ul>
        <li><a href="#form-error-summary-2">Enter your work email</a></li>
        <li>
          <a href="#form-error-summary-3">Choose a password with at least 12 characters</a>
        </li>
      </ul>
    {% endcall %}
  {% endcall %}
  {% call FieldGroup() %}
    {% call Field({
      endText: "Enter your work email.",
      for: "form-error-summary-2",
      label: "Email"
    }) %}
      <input
        aria-describedby="form-error-summary-2-end-text"
        aria-invalid="true"
        autocomplete="email"
        id="form-error-summary-2"
        type="email"
      />
    {% endcall %}
    {% call Field({
      endText: "Choose a password with at least 12 characters.",
      for: "form-error-summary-3",
      label: "Password"
    }) %}
      <input
        aria-describedby="form-error-summary-3-end-text"
        aria-invalid="true"
        autocomplete="new-password"
        id="form-error-summary-3"
        type="password"
        value="hunter2"
      />
    {% endcall %}
  {% endcall %}
  {% call FieldGroup() %}
    {% call Button({ type: "submit", variant: "filled" }) %}Create account{% endcall %}
  {% endcall %}
{% endcall %}
