---
import {
  Checkbox,
  FieldDescription,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio,
} from "opui-css/astro"
---

<Form>
  <Fieldset>
    <FieldLegend>Plan</FieldLegend>
    <FieldDescription>You can change your plan at any time.</FieldDescription>
    <FieldGroup name="plan">
      <Radio value="starter">Starter</Radio>
      <Radio value="team">Team</Radio>
      <Radio value="business">Business</Radio>
    </FieldGroup>
  </Fieldset>

  <Fieldset>
    <FieldLegend>Add-ons</FieldLegend>
    <FieldDescription>Billed monthly with your plan.</FieldDescription>
    <FieldGroup name="add-ons">
      <Checkbox value="backups">
        Backups
        <Fragment slot="end-text">Daily snapshots, kept for 30 days.</Fragment>
      </Checkbox>
      <Checkbox value="encryption">
        Encryption
        <Fragment slot="end-text"
          >Encrypt your files with your own keys.</Fragment
        >
      </Checkbox>
      <Checkbox value="single-sign-on">
        Single sign-on
        <Fragment slot="end-text">Sign in with your company account.</Fragment>
      </Checkbox>
    </FieldGroup>
  </Fieldset>
</Form>
