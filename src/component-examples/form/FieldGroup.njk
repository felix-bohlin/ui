{% from "opui/index.njk" import
  Checkbox,
  FieldDescription,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio
%}

{% call Form() %}
  {% call Fieldset({ "aria-describedby": "form-field-group-1-description" }) %}
    {% call FieldLegend() %}Plan{% endcall %}
    {% call FieldDescription({ id: "form-field-group-1-description" }) %}You can change your plan at any time.{% endcall %}
    {% call FieldGroup({ name: "plan" }) %}
      {% call Radio({ value: "starter" }) %}Starter{% endcall %}
      {% call Radio({ value: "team" }) %}Team{% endcall %}
      {% call Radio({ value: "business" }) %}Business{% endcall %}
    {% endcall %}
  {% endcall %}

  {% call Fieldset({ "aria-describedby": "form-field-group-2-description" }) %}
    {% call FieldLegend() %}Add-ons{% endcall %}
    {% call FieldDescription({ id: "form-field-group-2-description" }) %}Billed monthly with your plan.{% endcall %}
    {% call FieldGroup({ name: "add-ons" }) %}
      {% call Checkbox({
        slots: { endText: "Daily snapshots, kept for 30 days." },
        value: "backups"
      }) %}
        Backups
        
      {% endcall %}
      {% call Checkbox({
        slots: {
          endText: "Encrypt your files with your own keys."
        },
        value: "encryption"
      }) %}
        Encryption
        
      {% endcall %}
      {% call Checkbox({
        slots: { endText: "Sign in with your company account." },
        value: "single-sign-on"
      }) %}
        Single sign-on
        
      {% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
