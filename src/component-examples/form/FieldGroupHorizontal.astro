---
import {
  Checkbox,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
} from "opui-css/astro"
---

<Form>
  <Fieldset>
    <FieldLegend>Notifications</FieldLegend>
    <FieldGroup orientation="horizontal">
      <Checkbox>Email</Checkbox>
      <Checkbox>Push</Checkbox>
      <Checkbox>SMS</Checkbox>
    </FieldGroup>
  </Fieldset>
</Form>
