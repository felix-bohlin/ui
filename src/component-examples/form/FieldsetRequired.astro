---
import {
  FieldDescription,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Textarea,
  TextField,
  TextFieldControl,
  TextFieldInput,
  TextFieldLabel,
} from "@opui/astro"
---

<FieldSet>
  <FieldLegend>Pet info</FieldLegend>
  <FieldDescription>We must know your pet's information.</FieldDescription>
  <FieldGroup name="bio">
    <TextField>
      <TextFieldLabel>Name</TextFieldLabel>
      <TextFieldControl>
        <TextFieldInput name="name" />
      </TextFieldControl>
    </TextField>
    <Textarea required label="Life story" />
  </FieldGroup>
</FieldSet>
