{% from "opui/index.njk" import
  Button,
  Checkbox,
  Divider,
  Field,
  FieldDescription,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio,
  SelectButton,
  Switch
%}

{% call Form({ id: "form-kitchen-sink-1" }) %}
  {% call Fieldset({ "aria-describedby": "form-kitchen-sink-2-description" }) %}
    {% call FieldLegend() %}Your Bassbook profile{% endcall %}
    {% call FieldDescription({ id: "form-kitchen-sink-2-description" }) %}
      Heyyy, tell us who you are so your fans can find you.
    {% endcall %}
    {% call FieldGroup() %}
      {% call Field({ for: "form-kitchen-sink-7", label: "Full name" }) %}
        <input
          autocomplete="name"
          id="form-kitchen-sink-7"
          placeholder="Scott Humbucker"
          required
        />
      {% endcall %}
      {% call Field({ for: "form-kitchen-sink-8", label: "Email address" }) %}
        <input
          autocomplete="email"
          id="form-kitchen-sink-8"
          placeholder="josh@bassmail.example"
          required
          type="email"
        />
      {% endcall %}
      {% call Field({ for: "form-kitchen-sink-10", label: "Role" }) %}
        <select id="form-kitchen-sink-10">
          {{ SelectButton() }}
          <option value="bass">Bassist</option>
          <option value="drums">Drummer</option>
          <option value="guitar">Guitarist</option>
        </select>
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call Fieldset({ "aria-describedby": "form-kitchen-sink-3-description" }) %}
    {% call FieldLegend() %}Notifications{% endcall %}
    {% call FieldDescription({ id: "form-kitchen-sink-3-description" }) %}
      Pick how we tell you about new pokes and gig invites.
    {% endcall %}
    {% call FieldGroup() %}
      {% call Switch({ checked: true, name: "email_notifs" }) %}Email notifications{% endcall %}
      {% call Switch({ name: "sms_notifs" }) %}SMS notifications{% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call Fieldset({ "aria-describedby": "form-kitchen-sink-4-description" }) %}
    {% call FieldLegend() %}Profile theme{% endcall %}
    {% call FieldDescription({ id: "form-kitchen-sink-4-description" }) %}Pick the look of your awesome profile page.{% endcall %}
    {% call FieldGroup({ name: "theme" }) %}
      {% call Radio({ checked: true, value: "light" }) %}Light theme{% endcall %}
      {% call Radio({ value: "dark" }) %}Dark theme{% endcall %}
      {% call Radio({ value: "system" }) %}System default{% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call Fieldset({ "aria-describedby": "form-kitchen-sink-5-description" }) %}
    {% call FieldLegend() %}Bass experience{% endcall %}
    {% call FieldDescription({ id: "form-kitchen-sink-5-description" }) %}How many years have you held down the groove?{% endcall %}
    {% call FieldGroup() %}
      {% call Field({
        for: "form-kitchen-sink-11",
        label: "Years of playing",
        startText: "Drag the slider, and yes, the years on guitar count less."
      }) %}
        <input
          aria-describedby="form-kitchen-sink-11-start-text"
          id="form-kitchen-sink-11"
          max="20"
          min="0"
          step="1"
          type="range"
          value="5"
        />
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call Fieldset({ "aria-describedby": "form-kitchen-sink-6-description" }) %}
    {% call FieldLegend() %}About you{% endcall %}
    {% call FieldDescription({ id: "form-kitchen-sink-6-description" }) %}Favorite strings, dream rig, the band that ignores you?{% endcall %}
    {% call FieldGroup() %}
      {% call Field({ for: "form-kitchen-sink-9", label: "Biography" }) %}
        <textarea
          id="form-kitchen-sink-9"
          name="biography"
          placeholder="I play a fretless 5-string and nobody watches me..."
          rows="4"
        ></textarea>
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call Fieldset() %}
    {% call FieldLegend() %}Legal{% endcall %}
    {% call FieldGroup() %}
      {% set endText %}You can withdraw your consent at any time, no hard
      feelings.{% endset %}
      {% call Checkbox({
        name: "terms",
        required: true,
        slots: { endText: endText }
      }) %}
        I agree to the Bassbook terms and conditions
        
      {% endcall %}
    {% endcall %}
  {% endcall %}

  {{ Divider() }}

  {% call FieldGroup() %}
    {% call Button() %}Cancel{% endcall %}
    {% call Button({ type: "submit", variant: "filled" }) %}Send{% endcall %}
  {% endcall %}
{% endcall %}
