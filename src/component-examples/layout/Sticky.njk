{% from "opui/index.njk" import Card, CardContent %}

<div
  aria-label="Account settings"
  role="region"
  style="max-block-size: 16rem; overflow: auto"
  tabindex="0"
>
  <div class="ui-layout-container">
    <div
      class="ui-layout-columns ui-breakpoint-small"
      style="--_columns: 15rem 1fr"
    >
      {% call Card({ class: "ui-sticky", variant: "tonal" }) %}
        {% call CardContent() %}Account settings{% endcall %}
      {% endcall %}
      <div class="ui-layout-column">
        {% call Card({ variant: "outlined" }) %}
          {% call CardContent() %}
            Bassbook Gold: your plan, payment method and past receipts. A change
            to the plan applies from the next renewal date.
          {% endcall %}
        {% endcall %}
        {% call Card({ variant: "outlined" }) %}
          {% call CardContent() %}
            Data export: a ZIP file of your setlists, tabs and comments, with
            one CSV file per table, sent to your email address.
          {% endcall %}
        {% endcall %}
        {% call Card({ variant: "outlined" }) %}
          {% call CardContent() %}
            Notifications: which pokes and gig alerts reach you by email, push
            or SMS, and whether they arrive at once or in one daily digest.
          {% endcall %}
        {% endcall %}
        {% call Card({ variant: "outlined" }) %}
          {% call CardContent() %}
            Profile: your name, photo and the email address people see when you
            share a setlist with them or mention them in a comment.
          {% endcall %}
        {% endcall %}
        {% call Card({ variant: "outlined" }) %}
          {% call CardContent() %}
            Security: your password, two-step verification and the devices
            signed in to your account, which you can sign out one by one.
          {% endcall %}
        {% endcall %}
      </div>
    </div>
  </div>
</div>
