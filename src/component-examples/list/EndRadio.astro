---
import {
  FieldGroup,
  FieldLegend,
  Fieldset,
  List,
  ListItem,
  RadioInput,
} from "opui-css/astro"
---

<Fieldset>
  <FieldLegend>Theme</FieldLegend>
  <FieldGroup>
    <List>
      <ListItem type="radio">
        <Fragment slot="label">Dark mode</Fragment>
        <RadioInput name="theme" slot="end" value="dark" />
      </ListItem>
      <ListItem type="radio">
        <Fragment slot="label">Light mode</Fragment>
        <RadioInput name="theme" slot="end" value="light" />
      </ListItem>
    </List>
  </FieldGroup>
</Fieldset>
