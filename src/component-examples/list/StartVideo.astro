    <video slot="start" controls muted>
      <source
        src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"
        type="video/mp4"
      />
    </video>
    <Fragment slot="end">1:30</Fragment>
  </ListItem>
  <ListItem description="Uploaded by Percy Groove" label="Drop D in 45 seconds">
    <video slot="start" controls muted>
      <source
        src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4"
        type="video/mp4"
      />
    </video>
    <Fragment slot="end">0:45</Fragment>
  </ListItem>
</List>
