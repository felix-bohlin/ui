{% from "opui/index.njk" import Button, Menu %}

{% call Button({
  command: "toggle-popover",
  commandfor: "menu-manual-1",
  variant: "outlined"
}) %}
  View
{% endcall %}
{{ Menu({
  id: "menu-manual-1",
  items: [
    { keepOpen: true, label: "Zoom in" },
    { keepOpen: true, label: "Zoom out" },
    { borderTop: true, label: "Done" }
  ],
  popover: "manual"
}) }}
