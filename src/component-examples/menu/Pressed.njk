{% from "opui/index.njk" import Button, Menu %}

{% call Button({
  command: "toggle-popover",
  commandfor: "menu-pressed-1",
  variant: "outlined"
}) %}
  View
{% endcall %}
{{ Menu({
  id: "menu-pressed-1",
  items: [
    { "aria-pressed": "true", label: "Dark mode" },
    { "aria-pressed": "false", label: "Compact rows" },
    { "aria-pressed": "true", label: "Show sidebar" }
  ]
}) }}
