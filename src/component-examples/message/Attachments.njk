{% from "opui/index.njk" import
  Avatar,
  Card,
  CardContent,
  Message,
  MessageList
%}

{% call MessageList({ "aria-label": "Messages with Stella" }) %}
  {% set start %}{% call Avatar() %}SN{% endcall %}{% endset %}
  {% call Message({
    author: "Stella",
    datetime: "2026-10-08T14:31",
    slots: { start: start },
    time: "14:31"
  }) %}
    <p>Totally! Here's my slap break:</p>
    {% call Card({ variant: "outlined" }) %}
      {% call CardContent({ class: "ui-layout-media ui-gap-small" }) %}
        <svg
          data-icon="document"
          aria-hidden="true"
          class="ui-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm2 16H8v-2h8zm0-4H8v-2h8zm-3-5V3.5L18.5 9z"
          ></path>
        </svg>
        <div>
          <a class="ui-link" href="#attachments">Slap-break-of-doom.pdf</a>
          <p class="ui-caption">PDF, 2.4 MB</p>
        </div>
      {% endcall %}
    {% endcall %}
  {% endcall %}
  {% call Message({
    author: "You",
    datetime: "2026-10-08T14:40",
    outgoing: true,
    time: "14:40"
  }) %}
    <p>Woohoo, thanks! Here's the encore setlist.</p>
    {% call Card({ variant: "outlined" }) %}
      {% call CardContent({ class: "ui-layout-media ui-gap-small" }) %}
        <svg
          data-icon="document"
          aria-hidden="true"
          class="ui-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
        >
          <path
            fill="currentColor"
            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm2 16H8v-2h8zm0-4H8v-2h8zm-3-5V3.5L18.5 9z"
          ></path>
        </svg>
        <div>
          <a class="ui-link" href="#attachments">Encore-setlist.pdf</a>
          <p class="ui-caption">PDF, 860 kB</p>
        </div>
      {% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
