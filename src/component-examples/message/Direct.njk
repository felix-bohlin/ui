{% from "opui/index.njk" import Avatar, Message, MessageList %}

<div aria-label="Chat with Ellen" role="log">
  {% call MessageList({ "aria-label": "Messages with Ellen", direct: true }) %}
    {% set start %}{% call Avatar() %}EN{% endcall %}{% endset %}
    {% call Message({
      author: "Ellen",
      datetime: "2026-10-08T14:02",
      slots: { start: start },
      time: "14:02"
    }) %}
      <p>Heyyy! Did your band notice you changed strings yet?</p>
    {% endcall %}
    {% set start %}{% call Avatar() %}EN{% endcall %}{% endset %}
    {% call Message({
      author: "Ellen",
      datetime: "2026-10-08T14:03",
      slots: { start: start },
      time: "14:03"
    }) %}
      <p>Flatwounds, right? So rad.</p>
    {% endcall %}
    {% call Message({
      author: "You",
      datetime: "2026-10-08T14:18",
      outgoing: true,
      time: "14:18"
    }) %}
      <p>Nope, not even the drummer. Bummer, but WE know.</p>
    {% endcall %}
    {% set start %}{% call Avatar() %}EN{% endcall %}{% endset %}
    {% call Message({
      author: "Ellen",
      datetime: "2026-10-08T14:21",
      slots: { start: start },
      time: "14:21"
    }) %}
      <p>Their loss. Tab's in your inbox!</p>
    {% endcall %}
  {% endcall %}
</div>
