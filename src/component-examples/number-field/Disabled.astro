---
import { Field, StepButton } from "opui-css/astro"
---

<Field autoFit for="number-field-disabled-1" label="Quantity">
  <input disabled id="number-field-disabled-1" type="number" value="1" />
  <StepButton
    command="--step-down"
    for="number-field-disabled-1"
    slot="start"
  />
  <StepButton command="--step-up" for="number-field-disabled-1" slot="end" />
</Field>
