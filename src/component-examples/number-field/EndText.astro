---
import { NumberField } from "opui-css/astro"
---

<NumberField
  endText="Up to 8 per table."
  for="number-field-end-text-1"
  label="Guests"
>
  <input
    aria-describedby="number-field-end-text-1-end-text"
    id="number-field-end-text-1"
    max="8"
    min="1"
    type="number"
    value="2"
  />
</NumberField>
