---
import { Field, StepButton } from "opui-css/astro"
---

<Field autoFit for="number-field-step-1" label="Opacity">
  <input
    id="number-field-step-1"
    max="1"
    min="0"
    step="0.1"
    type="number"
    value="0.5"
  />
  <StepButton command="--step-down" for="number-field-step-1" slot="start" />
  <StepButton command="--step-up" for="number-field-step-1" slot="end" />
</Field>
