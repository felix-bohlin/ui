{% from "opui/index.njk" import Field, StepButton %}

{% set start %}{{ StepButton({ command: "--step-down", for: "number-field-unit-1" }) }}{% endset %}
{% set end %}{{ StepButton({ command: "--step-up", for: "number-field-unit-1" }) }}{% endset %}
{% call Field({
  autoFit: true,
  endText: "kg",
  for: "number-field-unit-1",
  label: "Weight",
  slots: { end: end, start: start }
}) %}
  <input
    aria-describedby="number-field-unit-1-end-text"
    id="number-field-unit-1"
    max="30"
    min="0.5"
    step="0.5"
    type="number"
    value="2.5"
  />
{% endcall %}

<script type="module">
  import "opui-css/elements/step-button.js"
</script>
