---
import { Field, StepButton } from "opui-css/astro"
---

<Field autoFit for="number-field-validation-1" label="Bandmates">
  <input id="number-field-validation-1" min="1" required type="number" />
  <StepButton
    command="--step-down"
    for="number-field-validation-1"
    slot="start"
  />
  <StepButton command="--step-up" for="number-field-validation-1" slot="end" />
</Field>
<Field
  autoFit
  endText="Only 4 left in stock."
  for="number-field-validation-2"
  label="Quantity"
>
  <input
    aria-describedby="number-field-validation-2-end-text"
    aria-invalid="true"
    id="number-field-validation-2"
    max="4"
    min="1"
    type="number"
    value="6"
  />
  <StepButton
    command="--step-down"
    for="number-field-validation-2"
    slot="start"
  />
  <StepButton command="--step-up" for="number-field-validation-2" slot="end" />
</Field>
