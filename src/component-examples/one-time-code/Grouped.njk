{% from "opui/index.njk" import OneTimeCode %}

{% call OneTimeCode({
  for: "one-time-code-grouped-1",
  grouped: true,
  label: "Verification code"
}) %}
  <input
    autocomplete="one-time-code"
    id="one-time-code-grouped-1"
    inputmode="numeric"
    maxlength="6"
    name="code"
    pattern="[0-9]{6}"
    required
    value="482"
  />
{% endcall %}
