{% from "opui/index.njk" import OneTimeCode %}

<div dir="rtl" lang="ar">
  {% call OneTimeCode({
    for: "one-time-code-right-to-left-1",
    label: "رمز التحقق"
  }) %}
    <input
      autocomplete="one-time-code"
      id="one-time-code-right-to-left-1"
      inputmode="numeric"
      maxlength="6"
      name="code"
      pattern="[0-9٠-٩۰-۹]{6}"
      value="905113"
    />
  {% endcall %}
</div>
