---
import { Progress } from "opui-css/astro"
---

<Progress id="progress-determinate-1" max="100" value="10" />

<script>
  const progress = document.querySelector(
    "#progress-determinate-1",
  ) as HTMLProgressElement
  if (progress) {
    setInterval(() => {
      if (progress.value >= 100) {
        progress.value = 10
      } else {
        progress.value += 10
      }
    }, 3000)
  }
</script>
