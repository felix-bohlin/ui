---
import { FieldGroup, FieldLegend, Fieldset, Form, Radio } from "opui-css/astro"
---

<Form>
  <Fieldset>
    <FieldLegend>Plan</FieldLegend>
    <FieldGroup name="radio-cards-end" orientation="horizontal">
      <Radio card checked spread value="starter">
        Starter
        <Fragment slot="end-text">€0 per month</Fragment>
      </Radio>
      <Radio card spread value="team" variant="elevated">
        Team
        <Fragment slot="end-text">€12 per person per month</Fragment>
      </Radio>
      <Radio card spread value="business" variant="tonal">
        Business
        <Fragment slot="end-text">€24 per person per month</Fragment>
      </Radio>
    </FieldGroup>
  </Fieldset>
  <Fieldset>
    <FieldLegend>Billing</FieldLegend>
    <FieldGroup name="radio-cards-start" orientation="horizontal">
      <Radio card checked value="monthly">
        Monthly
        <Fragment slot="end-text">Cancel at any time.</Fragment>
      </Radio>
      <Radio card value="yearly" variant="elevated">
        Yearly
        <Fragment slot="end-text">Two months free.</Fragment>
      </Radio>
      <Radio card value="invoice" variant="tonal">
        Invoice
        <Fragment slot="end-text">Pay by bank transfer.</Fragment>
      </Radio>
    </FieldGroup>
  </Fieldset>
</Form>
