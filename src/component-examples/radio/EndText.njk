{% from "opui/index.njk" import Radio %}

{% call Radio({
  checked: true,
  endText: "Arrives in 3 to 5 days.",
  name: "radio-end-text",
  value: "standard"
}) %}
  Standard delivery
{% endcall %}
{% call Radio({
  endText: "Arrives tomorrow.",
  name: "radio-end-text",
  orientation: "vertical",
  value: "express"
}) %}
  Express delivery
{% endcall %}
