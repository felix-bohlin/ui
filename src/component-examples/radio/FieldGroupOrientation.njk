{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Spot on stage{% endcall %}
    {% call FieldGroup({
      name: "radio-group-orientation",
      orientation: "horizontal"
    }) %}
      {% call Radio({ checked: true, value: "front" }) %}Front{% endcall %}
      {% call Radio({ value: "middle" }) %}Middle{% endcall %}
      {% call Radio({ value: "amp" }) %}Behind the amp{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
