{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Spot on stage{% endcall %}
    {% call FieldGroup({ orientation: "horizontal" }) %}
      {% call Radio({
        checked: true,
        name: "radio-group-orientation",
        value: "front"
      }) %}Front{% endcall %}
      {% call Radio({ name: "radio-group-orientation", value: "middle" }) %}Middle{% endcall %}
      {% call Radio({ name: "radio-group-orientation", value: "amp" }) %}Behind the amp{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
