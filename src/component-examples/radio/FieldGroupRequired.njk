{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Account type{% endcall %}
    {% call FieldGroup({
      name: "radio-group-required",
      orientation: "horizontal"
    }) %}
      {% call Radio({ required: true, value: "bassist" }) %}Bassist{% endcall %}
      {% call Radio({ required: true, value: "band" }) %}Band{% endcall %}
      {% call Radio({ required: true, value: "shop" }) %}Bass shop{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
