{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Radio
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Account type{% endcall %}
    {% call FieldGroup({ orientation: "horizontal" }) %}
      {% call Radio({
        name: "radio-group-required",
        required: true,
        value: "bassist"
      }) %}Bassist{% endcall %}
      {% call Radio({
        name: "radio-group-required",
        required: true,
        value: "band"
      }) %}Band{% endcall %}
      {% call Radio({
        name: "radio-group-required",
        required: true,
        value: "shop"
      }) %}Bass shop{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
