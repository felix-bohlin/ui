---
import { Range } from "opui-css/astro"
---

<Range label="Volume" spread>
  <Fragment slot="start-text">Media, calls and alerts.</Fragment>
  <Fragment slot="end-text">Headphones stay below 85 dB.</Fragment>
</Range>

<Range disabled label="Microphone" spread>
  <Fragment slot="start-text">Set by your organization.</Fragment>
</Range>

<Range
  endText="Set it to 20 or more to hear alarms."
  error
  label="Alarm volume"
  spread
  value="10"
>
  <Fragment slot="start-text">Rings for alarms and timers.</Fragment>
</Range>

<Range
  items={[
    { value: 0, label: "Left" },
    { value: 50, label: "Center" },
    { value: 100, label: "Right" },
  ]}
  label="Balance"
  spread
/>
