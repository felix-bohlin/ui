---
import { Range } from "opui-css/astro"
---

<Range label="Spread Layout" spread>
  <Fragment slot="start-text">Start text</Fragment>
  <Fragment slot="end-text">End text</Fragment>
</Range>

<Range disabled label="Disabled" spread>
  <Fragment slot="start-text">Start text</Fragment>
  <Fragment slot="end-text">End text</Fragment>
</Range>

<Range endText="Pick a value below 50." error label="Invalid Range" spread>
  <Fragment slot="start-text">Start text</Fragment>
</Range>

<Range
  items={[
    { value: 0, label: "0%" },
    { value: 25, label: "25%" },
    { value: 50, label: "50%" },
    { value: 75, label: "75%" },
    { value: 100, label: "100%" },
  ]}
  label="Tick marks with labels"
  spread
/>
