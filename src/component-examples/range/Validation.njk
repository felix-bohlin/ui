{% from "opui/index.njk" import Field %}

{% call Field({
  endText: "Set it to 20 or more to hear alarms.",
  for: "range-validation-1",
  label: "Alarm volume"
}) %}
  <input
    aria-describedby="range-validation-1-end-text"
    aria-invalid="true"
    id="range-validation-1"
    type="range"
    value="10"
  />
{% endcall %}
