---
import { Select } from "opui-css/astro"
---

<Select spread>
  <Fragment slot="label">Country</Fragment>
  <option value="">-</option>
  <option>Denmark</option>
  <option>Finland</option>
  <option>Iceland</option>
  <option>Norway</option>
  <option>Sweden</option>
</Select>

<Select spread variant="filled">
  <Fragment slot="label">Language</Fragment>
  <Fragment slot="start-text">Choose your preferred language.</Fragment>
  <Fragment slot="end-text">This affects UI translations.</Fragment>
  <option value="">-</option>
  <option>Danish</option>
  <option>Finnish</option>
  <option>Icelandic</option>
  <option>Norwegian</option>
  <option>Swedish</option>
</Select>

<Select required spread>
  <Fragment slot="label">Forum</Fragment>
  <Fragment slot="start-text"
    >Posts your question where the right bassists hang out.</Fragment
  >
  <option value="">-</option>
  <option>Gear Talk</option>
  <option>Ignored Bassists Anonymous</option>
</Select>

<Select disabled spread>
  <Fragment slot="label">Plan</Fragment>
  <Fragment slot="start-text">A gift from your band, aww.</Fragment>
  <option>Gold</option>
</Select>

<Select error spread>
  <Fragment slot="label">Payment method</Fragment>
  <Fragment slot="start-text"
    >Bassbook Gold renews on the first of each month.</Fragment
  >
  <Fragment slot="end-text">This card has expired. Pick another one.</Fragment>
  <option>Visa ending in 4242</option>
  <option>Mastercard ending in 5100</option>
</Select>

<Select spread>
  <Fragment slot="label">Time zone</Fragment>
  <Fragment slot="start-text">Used for gig and rehearsal reminders.</Fragment>
  <Fragment slot="start">UTC</Fragment>
  <option>-03:00</option>
  <option>+00:00</option>
  <option>+01:00</option>
  <option>+05:30</option>
  <option>+09:00</option>
</Select>

<Select spread variant="filled">
  <Fragment slot="label">Jam region</Fragment>
  <Fragment slot="start-text">Less lag means tighter grooves.</Fragment>
  <Fragment slot="start">
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>
  </Fragment>
  <Fragment slot="end-text">Cannot be changed mid-jam.</Fragment>
  <option value="">-</option>
  <option>Asia</option>
  <option>Europe</option>
  <option>North America</option>
</Select>
