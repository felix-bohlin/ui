---
import { Select } from "opui-css/astro"
---

<Select spread>
  <Fragment slot="label">Country</Fragment>
  <Fragment slot="start-text">Select your country of residence</Fragment>
  <option value="">Select a country</option>
  <option>Denmark</option>
  <option>Finland</option>
  <option>Iceland</option>
  <option>Norway</option>
  <option>Sweden</option>
</Select>

<Select spread variant="filled">
  <Fragment slot="label">Language</Fragment>
  <Fragment slot="start-text">Choose your preferred language</Fragment>
  <Fragment slot="end-text">This affects UI translations</Fragment>
  <option value="">Select a language</option>
  <option>Danish</option>
  <option>Finnish</option>
  <option>Icelandic</option>
  <option>Norwegian</option>
  <option>Swedish</option>
</Select>

<Select required spread>
  <Fragment slot="label">Department</Fragment>
  <Fragment slot="start-text">Routes your request to the right team</Fragment>
  <option value="">Select a department</option>
  <option>Billing</option>
  <option>Support</option>
</Select>

<Select disabled spread>
  <Fragment slot="label">Plan</Fragment>
  <Fragment slot="start-text">Managed by your organization</Fragment>
  <option>Business</option>
</Select>

<Select error spread>
  <Fragment slot="label">Payment method</Fragment>
  <Fragment slot="start-text">Charged on the first of each month</Fragment>
  <Fragment slot="end-text">This card has expired. Pick another one.</Fragment>
  <option>Visa ending in 4242</option>
  <option>Mastercard ending in 5100</option>
</Select>

<Select spread>
  <Fragment slot="label">Time zone</Fragment>
  <Fragment slot="start-text">Used for reminders and due dates</Fragment>
  <Fragment slot="start">UTC</Fragment>
  <option>-03:00</option>
  <option>+00:00</option>
  <option>+01:00</option>
  <option>+05:30</option>
  <option>+09:00</option>
</Select>

<Select spread variant="filled">
  <Fragment slot="label">Region</Fragment>
  <Fragment slot="start-text">Affects data residency and latency</Fragment>
  <Fragment slot="start">
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>
  </Fragment>
  <Fragment slot="end-text">Cannot be changed after deploy</Fragment>
  <option value="">-</option>
  <option>ap-southeast-1</option>
  <option>eu-north-1</option>
  <option>us-east-1</option>
</Select>
