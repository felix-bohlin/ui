{% from "opui/index.njk" import Stepper, StepperItem %}

{% call Stepper({ "aria-label": "Checkout steps" }) %}
  {% set iconComplete %}<svg
    data-icon="check-all"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 6 7 17l-5-5"></path>
    <path d="m22 10-7.5 7.5L13 16"></path>
  </svg>{% endset %}
  {{ StepperItem({
    href: "#",
    label: "Cart",
    slots: { iconComplete: iconComplete },
    state: "complete"
  }) }}
  {% set iconComplete %}<svg
    data-icon="check-all"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 6 7 17l-5-5"></path>
    <path d="m22 10-7.5 7.5L13 16"></path>
  </svg>{% endset %}
  {{ StepperItem({
    href: "#",
    label: "Shipping",
    slots: { iconComplete: iconComplete },
    state: "complete"
  }) }}
  {{ StepperItem({ current: true, label: "Payment" }) }}
  {{ StepperItem({ label: "Review" }) }}
{% endcall %}
