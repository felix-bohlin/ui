---
import { FieldGroup, FieldLegend, Fieldset, Form, Switch } from "opui-css/astro"
---

<Form>
  <Fieldset>
    <FieldLegend>Notifications</FieldLegend>
    <FieldGroup orientation="horizontal">
      <Switch card checked name="switch-cards-end" spread value="email">
        Email
        <Fragment slot="end-text">A summary every morning.</Fragment>
      </Switch>
      <Switch
        card
        name="switch-cards-end"
        spread
        value="push"
        variant="elevated"
      >
        Push
        <Fragment slot="end-text">On this device only.</Fragment>
      </Switch>
      <Switch card name="switch-cards-end" spread value="sms" variant="tonal">
        SMS
        <Fragment slot="end-text">For security alerts only.</Fragment>
      </Switch>
    </FieldGroup>
  </Fieldset>
  <Fieldset>
    <FieldLegend>Privacy</FieldLegend>
    <FieldGroup orientation="horizontal">
      <Switch card checked name="switch-cards-start" value="status">
        Online status
        <Fragment slot="end-text">Others see when you're active.</Fragment>
      </Switch>
      <Switch
        card
        name="switch-cards-start"
        value="receipts"
        variant="elevated"
      >
        Read receipts
        <Fragment slot="end-text"
          >Others see when you've read a message.</Fragment
        >
      </Switch>
      <Switch card name="switch-cards-start" value="search" variant="tonal">
        Profile search
        <Fragment slot="end-text">People can find you by email.</Fragment>
      </Switch>
    </FieldGroup>
  </Fieldset>
</Form>
