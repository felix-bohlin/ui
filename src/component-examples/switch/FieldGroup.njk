{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Switch
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Notifications{% endcall %}
    {% call FieldGroup() %}
      {% call Switch({ name: "switch-group", value: "email" }) %}Email{% endcall %}
      {% call Switch({ name: "switch-group", value: "push" }) %}Push{% endcall %}
      {% call Switch({ name: "switch-group", value: "sms" }) %}SMS{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
