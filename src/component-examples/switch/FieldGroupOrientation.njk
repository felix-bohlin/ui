{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Switch
%}

{% call Form() %}
  {% call Fieldset() %}
    {% call FieldLegend() %}Show in sidebar{% endcall %}
    {% call FieldGroup({ orientation: "horizontal" }) %}
      {% call Switch({ name: "switch-group-orientation", value: "calendar" }) %}Calendar{% endcall %}
      {% call Switch({ name: "switch-group-orientation", value: "files" }) %}Files{% endcall %}
      {% call Switch({ name: "switch-group-orientation", value: "tasks" }) %}Tasks{% endcall %}
    {% endcall %}
  {% endcall %}
{% endcall %}
