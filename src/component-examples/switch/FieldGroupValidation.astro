---
import { FieldGroup, FieldLegend, Fieldset, Form, Switch } from "opui-css/astro"
---

<Form>
  <Fieldset aria-describedby="switch-field-group-validation-1-error">
    <FieldLegend>Security alerts</FieldLegend>
    <FieldGroup name="switch-field-group-validation" orientation="horizontal">
      <Switch error value="email">Email</Switch>
      <Switch error value="push">Push</Switch>
      <Switch error value="sms">SMS</Switch>
    </FieldGroup>
    <span class="ui-end-text" id="switch-field-group-validation-1-error"
      >Turn on at least one to continue.</span
    >
  </Fieldset>
</Form>
