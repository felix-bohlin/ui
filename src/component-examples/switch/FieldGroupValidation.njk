{% from "opui/index.njk" import
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  Switch
%}

{% call Form() %}
  {% call Fieldset({
    "aria-describedby": "switch-field-group-validation-1-error"
  }) %}
    {% call FieldLegend() %}Security alerts{% endcall %}
    {% call FieldGroup({
      name: "switch-field-group-validation",
      orientation: "horizontal"
    }) %}
      {% call Switch({ error: true, value: "email" }) %}Email{% endcall %}
      {% call Switch({ error: true, value: "push" }) %}Push{% endcall %}
      {% call Switch({ error: true, value: "sms" }) %}SMS{% endcall %}
    {% endcall %}
    <span class="ui-end-text" id="switch-field-group-validation-1-error">Turn on at least one to continue.</span>
  {% endcall %}
{% endcall %}
