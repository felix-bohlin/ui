---
import { Switch } from "opui-css/astro"
---

<Switch name="switch-spread" spread value="notifications">
  Notifications
  <Fragment slot="end-text">Receive alerts when someone mentions you.</Fragment>
</Switch>

<Switch name="switch-spread" required spread value="two-step-login">
  Two-step login
  <Fragment slot="end-text">Your organization requires it for admins.</Fragment>
</Switch>

<Switch disabled name="switch-spread" spread value="location">
  Location access
  <Fragment slot="end-text">Turned off by your administrator.</Fragment>
</Switch>

<Switch error name="switch-spread" spread value="backup">
  Cloud backup
  <Fragment slot="end-text"
    >Sync needs cloud backup. Turn it on to continue.</Fragment
  >
</Switch>
