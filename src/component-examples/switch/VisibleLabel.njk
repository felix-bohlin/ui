{% from "opui/index.njk" import Switch %}

{% call Switch({ name: "switch-visible-label", value: "dark-mode" }) %}Dark mode{% endcall %}
{% call Switch({
  disabled: true,
  name: "switch-visible-label",
  value: "mobile-data"
}) %}Sync over mobile data{% endcall %}
{% call Switch({ name: "switch-visible-label", value: "auto-download" }) %}
  Download new episodes automatically while the device is on Wi-Fi and charging,
  and remove played episodes after 24 hours.
{% endcall %}
