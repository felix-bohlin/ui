---
import {
  Button,
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
---

<Table id="table-expandable-1">
  <TableCaption>Gear orders</TableCaption>
  <TableHead>
    <TableRow>
      <TableHeaderCell><span class="ui-sr-only">Details</span></TableHeaderCell>
      <TableHeaderCell>Order</TableHeaderCell>
      <TableHeaderCell>Bassist</TableHeaderCell>
      <TableHeaderCell numeric>Total</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    <TableRow>
      <TableCell>
        <Button
          aria-controls="table-expandable-1-details"
          aria-expanded="false"
          aria-label="Details of order 1042"
          class="table-expand"
          round
          size="small"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
          >
            <path
              fill="currentColor"
              d="M5.366 11.116a1.25 1.25 0 0 1 1.768 0L16 19.982l8.866-8.866a1.25 1.25 0 0 1 1.768 1.768l-9.75 9.75a1.25 1.25 0 0 1-1.768 0l-9.75-9.75a1.25 1.25 0 0 1 0-1.768"
            ></path>
          </svg>
        </Button>
      </TableCell>
      <TableCell>1042</TableCell>
      <TableCell>Lou Headstock</TableCell>
      <TableCell numeric>€84.00</TableCell>
    </TableRow>
    <TableRow hidden id="table-expandable-1-details">
      <TableCell colspan="4"
        >Flatwounds and a comfy strap, shipped to Göteborg on 3
        March.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell>
        <Button
          aria-controls="table-expandable-2-details"
          aria-expanded="false"
          aria-label="Details of order 1043"
          class="table-expand"
          round
          size="small"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
          >
            <path
              fill="currentColor"
              d="M5.366 11.116a1.25 1.25 0 0 1 1.768 0L16 19.982l8.866-8.866a1.25 1.25 0 0 1 1.768 1.768l-9.75 9.75a1.25 1.25 0 0 1-1.768 0l-9.75-9.75a1.25 1.25 0 0 1 0-1.768"
            ></path>
          </svg>
        </Button>
      </TableCell>
      <TableCell>1043</TableCell>
      <TableCell>Percy Groove</TableCell>
      <TableCell numeric>€126.50</TableCell>
    </TableRow>
    <TableRow hidden id="table-expandable-2-details">
      <TableCell colspan="4"
        >Three items, waiting for the low B string to come back in
        stock.</TableCell
      >
    </TableRow>
    <TableRow>
      <TableCell>
        <Button
          aria-controls="table-expandable-3-details"
          aria-expanded="false"
          aria-label="Details of order 1044"
          class="table-expand"
          round
          size="small"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
          >
            <path
              fill="currentColor"
              d="M5.366 11.116a1.25 1.25 0 0 1 1.768 0L16 19.982l8.866-8.866a1.25 1.25 0 0 1 1.768 1.768l-9.75 9.75a1.25 1.25 0 0 1-1.768 0l-9.75-9.75a1.25 1.25 0 0 1 0-1.768"
            ></path>
          </svg>
        </Button>
      </TableCell>
      <TableCell>1044</TableCell>
      <TableCell>Ines Hertz</TableCell>
      <TableCell numeric>€39.90</TableCell>
    </TableRow>
    <TableRow hidden id="table-expandable-3-details">
      <TableCell colspan="4"
        >One fuzz pedal, delivered to Berlin on 5 March.</TableCell
      >
    </TableRow>
  </TableBody>
</Table>

<style is:global>
  .table-expand[aria-expanded="true"] > svg {
    rotate: 180deg;
  }
</style>

<script>
  document
    .querySelectorAll("#table-expandable-1 .table-expand")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const row = document.getElementById(
          button.getAttribute("aria-controls") ?? "",
        )
        if (!(row instanceof HTMLTableRowElement)) return
        const expanded = button.getAttribute("aria-expanded") !== "true"
        button.setAttribute("aria-expanded", String(expanded))
        row.hidden = !expanded
      })
    })
</script>
