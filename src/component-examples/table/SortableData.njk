{% from "opui/index.njk" import
  SortableTable,
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow
%}
{% set bassists = [
  { gigs: 7, name: "Adam Groove", style: "Funk" },
  { gigs: 12, name: "Ellen Nut", style: "Rock" },
  { gigs: 25, name: "Josh Rootnote", style: "Jazz" },
  { gigs: 42, name: "Kinga Headstock", style: "Funk" },
  { gigs: 18, name: "Mohini Hertz", style: "Jazz" },
  { gigs: 31, name: "Scott Humbucker", style: "Rock" }
] %}

{% call SortableTable({ id: "table-sortable-data-1" }) %}
  {% call Table() %}
    {% call TableCaption() %}Gigs this month{% endcall %}
    {% call TableHead() %}
      {% call TableRow() %}
        {% call TableHeaderCell({ "aria-sort": "ascending", sortable: true }) %}Name{% endcall %}
        {% call TableHeaderCell({ sortable: true }) %}Style{% endcall %}
        {% call TableHeaderCell({ numeric: true, sortable: true }) %}Gigs{% endcall %}
      {% endcall %}
    {% endcall %}
    {% call TableBody() %}
      {% for bassist in bassists -%}
        {% call TableRow() %}
          {% call TableCell() %}{{ bassist.name }}{% endcall %}
          {% call TableCell() %}{{ bassist.style }}{% endcall %}
          {% call TableCell({ numeric: true }) %}{{ bassist.gigs }}{% endcall %}
        {% endcall %}
      {%- endfor %}
    {% endcall %}
  {% endcall %}
{% endcall %}

<script type="module">
  import "opui-css/elements/sortable-table.js"
</script>

<script type="module">
  const table = document.querySelector("#table-sortable-data-1")
  const body = table?.querySelector("tbody")
  const keys = ["name", "style", "gigs"]
  const bassists = [...(body?.rows ?? [])].map((row) => ({
    gigs: Number(row.cells[2].textContent),
    name: row.cells[0].textContent,
    row,
    style: row.cells[1].textContent,
  }))

  table?.addEventListener("sort", (event) => {
    if (!(event instanceof CustomEvent)) return
    event.preventDefault()
    const key = keys[event.detail.column]
    if (!key) return
    const sign = event.detail.direction === "descending" ? -1 : 1
    bassists.sort(
      (a, b) =>
        sign *
        String(a[key]).localeCompare(String(b[key]), undefined, {
          numeric: true,
        }),
    )
    body?.append(...bassists.map(({ row }) => row))
  })
</script>
