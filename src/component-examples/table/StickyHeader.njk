      {% endcall %}
      {% call TableRow() %}
        {% call TableCell() %}BB-1004{% endcall %}
        {% call TableCell() %}Mohini Hertz{% endcall %}
        {% call TableCell({ numeric: true }) %}€318.40{% endcall %}
      {% endcall %}
      {% call TableRow() %}
