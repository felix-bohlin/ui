{% from "opui/index.njk" import
  Table,
  TableBody,
  TableCaption,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow
%}

<div
  role="region"
  aria-label="Gear orders"
  tabindex="0"
  style="max-block-size: 15rem; overflow: auto; scroll-padding-block-start: 2.5rem"
>
  {% call Table({ stickyHeader: true }) %}
    {% call TableCaption() %}Gear orders{% endcall %}
    {% call TableHead() %}
      {% call TableRow() %}
        {% call TableHeaderCell() %}Order{% endcall %}
        {% call TableHeaderCell() %}Bassist{% endcall %}
        {% call TableHeaderCell({ numeric: true }) %}Amount{% endcall %}
      {% endcall %}
    {% endcall %}
    {% call TableBody() %}
      {% call TableRow() %}
        {% call TableCell() %}BB-1000{% endcall %}
        {% call TableCell() %}Scott Humbucker{% endcall %}
        {% call TableCell({ numeric: true }) %}€1,240.00{% endcall %}
      {% endcall %}
      {% call TableRow() %}
        {% call TableCell() %}BB-1001{% endcall %}
        {% call TableCell() %}Adam Groove{% endcall %}
        {% call TableCell({ numeric: true }) %}€86.50{% endcall %}
      {% endcall %}
      {% call TableRow() %}
        {% call TableCell() %}BB-1002{% endcall %}
        {% call TableCell() %}Josh Rootnote{% endcall %}
        {% call TableCell({ numeric: true }) %}€412.90{% endcall %}
      {% endcall %}
      {% call TableRow() %}
