{% from "opui/index.njk" import Button, Tabs, TabsItem, TabsLabel, TabsPanel %}

{% call Tabs({ name: "tabs-binding", value: "settings" }) %}
  {% call TabsItem({ id: "tabs-binding-1", value: "profile" }) %}
    {% call TabsLabel() %}Profile{% endcall %}
    {% call TabsPanel() %}Profile settings and information.{% endcall %}
  {% endcall %}
  {% call TabsItem({ id: "tabs-binding-2", value: "settings" }) %}
    {% call TabsLabel() %}Settings{% endcall %}
    {% call TabsPanel() %}General account settings.{% endcall %}
  {% endcall %}
  {% call TabsItem({ id: "tabs-binding-3", value: "notifications" }) %}
    {% call TabsLabel() %}Notifications{% endcall %}
    {% call TabsPanel() %}Manage your notifications.{% endcall %}
  {% endcall %}
{% endcall %}
<p class="tabs-binding-text">Selected: settings</p>
{% call Button({ class: "tabs-binding-reset" }) %}Reset{% endcall %}

<script type="module">
  const text = document.querySelector(".tabs-binding-text")
  const inputs = [...document.querySelectorAll('[name="tabs-binding"]')]

  function update() {
    if (!text) return
    text.textContent = `Selected: ${
      inputs.find((input) => input.checked)?.value ?? "none"
    }`
  }

  inputs.forEach((input) => input.addEventListener("change", update))
  document.querySelector(".tabs-binding-reset")?.addEventListener("click", () => {
    inputs.forEach((input) => (input.checked = input.defaultChecked))
    update()
  })
</script>
