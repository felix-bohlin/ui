{% from "opui/index.njk" import Field, PasswordToggle %}

{% set end %}{{ PasswordToggle({ for: "text-field-password-toggle-1" }) }}{% endset %}
{% call Field({
  for: "text-field-password-toggle-1",
  label: "Password",
  slots: { end: end }
}) %}
  <input
    autocomplete="current-password"
    id="text-field-password-toggle-1"
    type="password"
  />
{% endcall %}
{% set end %}{{ PasswordToggle({
  for: "text-field-password-toggle-2",
  label: "Show new password"
}) }}{% endset %}
{% call Field({
  endText: "At least 12 characters.",
  for: "text-field-password-toggle-2",
  label: "New password",
  slots: { end: end }
}) %}
  <input
    aria-describedby="text-field-password-toggle-2-end-text"
    autocomplete="new-password"
    id="text-field-password-toggle-2"
    minlength="12"
    type="password"
  />
{% endcall %}

<script type="module">
  import "opui-css/elements/password-toggle.js"
</script>
