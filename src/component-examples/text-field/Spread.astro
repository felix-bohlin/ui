---
import { TextField } from "opui-css/astro"
---

<TextField placeholder="Holly Humbucker" spread>
  <Fragment slot="label">Name</Fragment>
  <Fragment slot="start-text"
    >Your full name, as the drummer never says it</Fragment
  >
</TextField>

<TextField
  placeholder="name@lowend.example"
  spread
  type="email"
  variant="filled"
>
  <Fragment slot="label">Email</Fragment>
  <Fragment slot="start-text">We'll send your gig invites here</Fragment>
  <Fragment slot="end-text">Use one the band checks.</Fragment>
</TextField>

<TextField label="Band" required spread>
  <Fragment slot="start-text">Shown on your gig flyers</Fragment>
</TextField>

<TextField disabled label="Member ID" spread value="BASS-20931">
  <Fragment slot="start-text">Assigned when you joined Bassbook</Fragment>
</TextField>

<TextField error label="Display name" spread value="A">
  <Fragment slot="start-text">Shown next to your wall posts</Fragment>
  <Fragment slot="end-text">Enter at least two characters.</Fragment>
</TextField>

<TextField label="Amount" placeholder="0.00" spread>
  <Fragment slot="start-text">Daily gear spending limit</Fragment>
  <Fragment slot="start">€</Fragment>
  <Fragment slot="end">EUR</Fragment>
</TextField>

<TextField label="Website" placeholder="example.com" spread variant="filled">
  <Fragment slot="start-text">Your band homepage, totally rad</Fragment>
  <Fragment slot="start">https://</Fragment>
  <Fragment slot="end-text">Include the domain, like example.com.</Fragment>
</TextField>

<TextField label="Band page" placeholder="my-band" spread>
  <Fragment slot="start-text">Used to make your band page URL</Fragment>
  <Fragment slot="top">bassbook.example/</Fragment>
  <Fragment slot="bottom">Lowercase letters and dashes only</Fragment>
</TextField>

<TextField
  label="Secret riff"
  placeholder="Paste your riff"
  spread
  type="password"
  variant="filled"
>
  <Fragment slot="start-text">Locked away from guitarists</Fragment>
  <Fragment slot="start">
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
  </Fragment>
  <Fragment slot="top">Secret</Fragment>
  <Fragment slot="bottom">Changes every 90 days</Fragment>
  <Fragment slot="end-text">Never show it to the drummer.</Fragment>
</TextField>
