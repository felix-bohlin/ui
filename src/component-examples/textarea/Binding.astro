---
import { Button, Textarea } from "opui-css/astro"
---

<Textarea
  label="Message"
  name="textarea-binding"
  value="Thanks for the update."
/>
<p class="textarea-binding-text">22 characters</p>
<Button class="textarea-binding-reset">Reset</Button>

<script>
  const text = document.querySelector(".textarea-binding-text")
  const textarea = document.querySelector<HTMLTextAreaElement>(
    '[name="textarea-binding"]',
  )

  function update() {
    if (!text || !textarea) return
    text.textContent = `${textarea.value.length} characters`
  }

  textarea?.addEventListener("input", update)
  document
    .querySelector(".textarea-binding-reset")
    ?.addEventListener("click", () => {
      if (textarea) textarea.value = textarea.defaultValue
      update()
    })
</script>
