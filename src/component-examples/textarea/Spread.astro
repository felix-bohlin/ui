---
import { Textarea } from "opui-css/astro"
---

<Textarea placeholder="Hi, I have a question about my order." spread>
  <Fragment slot="label">Message</Fragment>
  <Fragment slot="start-text">Keep it under 100 characters.</Fragment>
</Textarea>

<Textarea placeholder="Additional notes..." spread variant="filled">
  <Fragment slot="label">Notes</Fragment>
  <Fragment slot="start-text">Add any additional notes or comments</Fragment>
  <Fragment slot="end-text">Only your team sees these.</Fragment>
</Textarea>

<Textarea label="Reason for return" required spread>
  <Fragment slot="start-text">Helps us improve our products</Fragment>
</Textarea>

<Textarea disabled label="Order notes" spread>
  <Fragment slot="start-text">Orders can't change once they ship</Fragment>
</Textarea>

<Textarea error label="Review" spread value="Great">
  <Fragment slot="start-text">Shown with your rating</Fragment>
  <Fragment slot="end-text">Write at least 20 characters.</Fragment>
</Textarea>

<Textarea
  characterCount
  label="Bio"
  maxlength={280}
  placeholder="Tell us about yourself..."
  spread
>
  <Fragment slot="start-text">Shown on your public profile</Fragment>
  <Fragment slot="start">
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
      ></path>
      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
    </svg>
  </Fragment>
</Textarea>

<Textarea
  label="Release notes"
  placeholder="Markdown supported..."
  spread
  variant="filled"
>
  <Fragment slot="start-text">Shown on the changelog page</Fragment>
  <Fragment slot="top">v1.4.0</Fragment>
  <Fragment slot="bottom">Saved 2 minutes ago</Fragment>
  <Fragment slot="end-text">Drafts save automatically.</Fragment>
</Textarea>
