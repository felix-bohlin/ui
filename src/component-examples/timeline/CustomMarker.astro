---
import { Timeline, TimelineItem } from "opui-css/astro"
---

<Timeline>
  <TimelineItem
    color="success"
    datetime="2026-10-01"
    label="Ordered"
    time="Oct 1"
  >
    <svg
      slot="marker"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </TimelineItem>
  <TimelineItem
    color="success"
    datetime="2026-10-02"
    label="Packed"
    time="Oct 2"
  >
    <svg
      slot="marker"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </TimelineItem>
  <TimelineItem
    color="success"
    datetime="2026-10-03"
    label="Shipped"
    time="Oct 3"
  >
    <svg
      slot="marker"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
    <p>On its way from Gothenburg.</p>
  </TimelineItem>
  <TimelineItem datetime="2026-10-06" label="Delivered" time="Oct 6">
    <p>Expected</p>
  </TimelineItem>
</Timeline>
