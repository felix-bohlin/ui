{% from "opui/index.njk" import Button, Toaster %}

{% call Button({ id: "toast-action-1-button", variant: "filled" }) %}Archive{% endcall %}
{{ Toaster({ id: "toast-action-1" }) }}

<script type="module">
  import { toast } from "opui-css/elements/toaster.js"

  document
    .getElementById("toast-action-1-button")
    ?.addEventListener("click", () =>
      toast("Conversation archived", {
        action: {
          label: "Undo",
          onClick: () => toast("Conversation restored"),
        },
      }),
    )
</script>
