---
import { List, ListItem } from "@opui/astro"
import type { Framework } from "../component-api/frameworks"
import { partLabel } from "../component-api/rows"
import type { ComponentApi } from "../component-api/types"
import { formatInline } from "../utils/format-inline"
import { DEFAULT_FRAMEWORK } from "../utils/framework-routing"

type Props = {
  api?: ComponentApi
  zoom?: number
}

const apis = import.meta.glob<ComponentApi>("../component-api/*/api.ts", {
  eager: true,
  import: "default",
})

const {
  api = apis[`../component-api/${Astro.locals.componentSlug}/api.ts`],
  zoom = 1,
} = Astro.props
const { $id } = Astro.locals

const id = $id("anatomy")
const framework = (Astro.currentLocale ?? DEFAULT_FRAMEWORK) as Framework

const parts = [
  { ...api.root, label: partLabel(api, api.root, framework, true) },
  ...api.parts.map((part) => ({
    ...part,
    label: partLabel(api, part, framework),
  })),
]

const anchors = parts
  .map(
    (part, i) =>
      `[data-anatomy="${id}"] .subject ${part.selector.includes("::") ? part.selector : `:is(${part.selector})`} { anchor-name: ${[part.anchorName, `--${id}-part-${i + 1}`].filter(Boolean).join(", ")}; }`,
  )
  .join("\n")

const step = 100 / parts.length
const ramp = step * 0.2
const fall = step * 0.8
const keyframes = (
  target: string,
  off: string,
  on: string,
  [upFrom, upTo, downFrom, downTo] = [0, ramp, fall, step],
) => `
@keyframes ${id}-${target.replace(/\W+/g, "")} {
  0%, ${upFrom}%, ${downTo}%, 100% { ${off} }
  ${upTo}%, ${downFrom}% { ${on} }
}
:where([data-anatomy="${id}"] .legend) ${target} { animation-name: ${id}-${target.replace(/\W+/g, "")}; }`
const leader = (n: number) =>
  [
    (ramp * (n - 1)) / 3,
    (ramp * n) / 3,
    fall + (ramp * (3 - n)) / 3,
    fall + (ramp * (4 - n)) / 3,
  ] as [number, number, number, number]
const tour = [
  keyframes(".glow::before", "opacity: 0;", "opacity: 1;"),
  keyframes(".marker::after", "opacity: 0;", "opacity: 1;"),
  keyframes(".frame::before", "opacity: 0;", "opacity: 1;"),
  keyframes(
    ".leader > :nth-child(1) > *",
    "scale: 0 1;",
    "scale: 1 1;",
    leader(1),
  ),
  keyframes(
    ".leader > :nth-child(2) > *",
    "scale: 1 0;",
    "scale: 1 1;",
    leader(2),
  ),
  keyframes(
    ".leader > :nth-child(3) > *",
    "scale: 0 1;",
    "scale: 1 1;",
    leader(3),
  ),
].join("\n")
---

<figure
  class="anatomy-diagram ui-card ui-outlined ui-not-rich-text"
  data-anatomy={id}
>
  <style is:inline set:html={anchors + tour}></style>
  <div
    class="layout"
    style={`--count: ${parts.length}; --subject: --${id}-subject;`}
  >
    <div class="stage">
      <div class="subject" inert style={`--zoom: ${zoom};`}>
        <slot />
      </div>
    </div>

    <List class="legend" dense variant="transparent">
      {
        parts.map((part, i) => (
          <ListItem
            class="part"
            tabindex="0"
            style={`--i: ${i}; --part: --${id}-part-${i + 1}; --marker: --${id}-marker-${i + 1}; --row: --${id}-row-${i + 1};`}
          >
            <span slot="start" class="marker" />
            <Fragment slot="text">
              <p>
                <code>{part.label}</code>
              </p>
              <p set:html={formatInline(part.description, Astro.locals.link)} />
            </Fragment>
            <span class="glow" aria-hidden="true" />
            <span class="frame" aria-hidden="true" />
            <span class="leader" aria-hidden="true">
              <span>
                <span />
              </span>
              <span>
                <span />
              </span>
              <span>
                <span />
              </span>
            </span>
          </ListItem>
        ))
      }
    </List>
  </div>
</figure>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const { isIntersecting, target } of entries) {
      target.toggleAttribute("data-offscreen", !isIntersecting)
    }
  })

  document
    .querySelectorAll(".anatomy-diagram")
    .forEach((diagram) => observer.observe(diagram))
</script>

<style>
  @property --anatomy-on {
    inherits: true;
    initial-value: 0;
    syntax: "<number>";
  }

  .anatomy-diagram {
    box-shadow: var(--shadow-2);
    container-type: inline-size;
    margin-block: var(--size-4);
    overflow: hidden;
    padding: 0;
  }

  .layout {
    --_anatomy-accent: var(--primary);
    --_idle: color-mix(in oklch, var(--text-muted) 45%, transparent);
    --_knee: var(--size-5);
    --_line: 1.5px;
    --_step: 2.4s;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    position: relative;
  }

  .stage {
    display: grid;
    isolation: isolate;
    min-block-size: var(--size-12);
    padding: var(--size-5);
    place-items: center;
    position: relative;

    &:before {
      background-image: radial-gradient(
        var(--text-muted) 1.45px,
        transparent 1.45px
      );
      background-size: 20px 20px;
      content: "";
      inset: 0;
      opacity: 0.05;
      pointer-events: none;
      position: absolute;
      z-index: -1;
    }
  }

  .subject {
    anchor-name: var(--subject);
    max-inline-size: 100%;
    min-inline-size: 0;
    zoom: var(--zoom);

    > :global(*) {
      max-inline-size: 100%;
    }
  }

  .layout :global(.legend) {
    align-content: center;
    border-inline-start: var(--border-width) solid var(--border-color);
    display: grid;
    isolation: isolate;
    margin: 0;
    padding: var(--size-3);
  }

  .glow::before,
  .marker::after,
  .frame::before,
  .leader > * > * {
    animation-delay: calc(var(--i) * var(--_step));
    animation-duration: calc(var(--count) * var(--_step));
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .anatomy-diagram[data-offscreen] {
    .glow::before,
    .marker::after,
    .frame::before,
    .leader > * > * {
      animation-play-state: paused;
    }
  }

  .layout :global(.part) {
    anchor-name: var(--row);
    border-radius: var(--radius-2);
    cursor: default;
    outline-offset: -2px;
    position: static;
    transition: --anatomy-on 0.45s ease-out;
  }

  .glow {
    bottom: anchor(bottom);
    left: anchor(left);
    pointer-events: none;
    position: absolute;
    position-anchor: var(--row);
    right: anchor(right);
    top: anchor(top);
    z-index: -1;

    &::before {
      background-color: color-mix(
        in oklch,
        var(--_anatomy-accent) 8%,
        transparent
      );
      border-radius: var(--radius-2);
      content: "";
      inset: 0;
      opacity: var(--anatomy-on);
      position: absolute;
    }
  }

  .marker {
    anchor-name: var(--marker);
    block-size: 0.5rem;
    border: var(--_line) solid var(--_idle);
    border-radius: 50%;
    inline-size: 0.5rem;
    position: relative;

    &::after {
      background-color: var(--_anatomy-accent);
      border-radius: 50%;
      content: "";
      inset: calc(var(--_line) * -1);
      opacity: var(--anatomy-on);
      position: absolute;
    }
  }

  .frame {
    bottom: anchor(bottom);
    left: anchor(left);
    position: absolute;
    position-anchor: var(--part);
    right: anchor(right);
    top: anchor(top);

    &::before {
      background-color: color-mix(
        in oklch,
        var(--_anatomy-accent) 12%,
        transparent
      );
      border: 1px solid var(--_anatomy-accent);
      border-radius: var(--radius-1);
      content: "";
      inset: 0;
      opacity: var(--anatomy-on);
      position: absolute;
    }
  }

  .leader {
    display: contents;

    > * {
      pointer-events: none;
      position: absolute;

      > * {
        border: 0 solid var(--_anatomy-accent);
        inset: 0;
        position: absolute;
      }
    }

    > :nth-child(1) {
      left: calc(anchor(var(--subject) right) + var(--_knee));
      right: anchor(var(--marker) left);
      top: anchor(var(--marker) center);
      translate: 0 calc(var(--_line) / -2);

      > * {
        border-block-start-width: var(--_line);
        scale: clamp(0, var(--anatomy-on) * 3, 1) 1;
        transform-origin: right;
      }
    }

    > :nth-child(2) {
      bottom: min(anchor(var(--marker) center), anchor(var(--part) center));
      left: calc(anchor(var(--subject) right) + var(--_knee));
      top: min(anchor(var(--marker) center), anchor(var(--part) center));
      translate: calc(var(--_line) / -2) 0;

      > * {
        border-inline-start-width: var(--_line);
        scale: 1 clamp(0, var(--anatomy-on) * 3 - 1, 1);
      }
    }

    > :nth-child(3) {
      left: anchor(var(--part) right);
      right: calc(anchor(var(--subject) right) - var(--_knee));
      top: anchor(var(--part) center);
      translate: 0 calc(var(--_line) / -2);

      > * {
        border-block-start-width: var(--_line);
        scale: clamp(0, var(--anatomy-on) * 3 - 2, 1) 1;
        transform-origin: right;
      }

      > *:after {
        background-color: var(--_anatomy-accent);
        block-size: 7px;
        border-radius: 50%;
        content: "";
        inline-size: 7px;
        left: 0;
        position: absolute;
        top: 0;
        translate: -50% calc(-50% - var(--_line) / 2);
      }
    }
  }

  .layout:global(:has(.part:hover, .part:focus)) .glow::before,
  .layout:global(:has(.part:hover, .part:focus)) .marker::after,
  .layout:global(:has(.part:hover, .part:focus)) .frame::before,
  .layout:global(:has(.part:hover, .part:focus)) .leader > * > * {
    animation: none;
  }

  .layout :global(.part:hover),
  .layout:global(:not(:has(.part:hover))) :global(.part:focus) {
    --anatomy-on: 1;
  }

  @container (inline-size < 40rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .subject {
      zoom: 1;
    }

    .stage {
      padding-inline: var(--size-3);
    }

    .layout :global(.legend) {
      border-block-start: var(--border-width) solid var(--border-color);
      border-inline-start: 0;
    }

    .leader {
      display: none;
    }
  }

  @container style(--anatomy-hero: 1) {
    .anatomy-diagram {
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      margin-block: var(--size-2) 0;
      overflow: visible;
    }

    .stage {
      padding-inline: 0 var(--size-9);

      &:before {
        inset: calc(var(--size-8) * -1);
        mask-image: radial-gradient(closest-side, #000 30%, transparent);
        opacity: 0.15;
      }

      &:after {
        background: radial-gradient(
          closest-side,
          color-mix(in oklch, var(--_anatomy-accent) 22%, transparent),
          transparent
        );
        content: "";
        inset: -10%;
        pointer-events: none;
        position: absolute;
        z-index: -1;
      }

      @container (inline-size < 40rem) {
        padding-inline: 0;

        &:before,
        &:after {
          inset: 0;
        }
      }
    }

    .layout :global(.legend) {
      border: 0;
    }
  }

  @supports not (anchor-name: --a) {
    .glow,
    .frame,
    .leader {
      display: none;
    }

    .layout :global(.part) {
      background-color: color-mix(
        in oklch,
        var(--_anatomy-accent) calc(var(--anatomy-on) * 8%),
        transparent
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layout :global(.part) {
      transition: none;
    }

    .layout .glow::before,
    .layout .marker::after,
    .layout .frame::before,
    .layout .leader > * > * {
      animation: none;
    }
  }
</style>
