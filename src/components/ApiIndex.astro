---
import Document from "../layouts/Document.astro"
import FrameworkPicker from "./FrameworkPicker.astro"
import ComponentAPI, { type FrameworkApis } from "./ComponentAPI.astro"
import type { AstroInstance } from "astro"
import type { ComponentApi } from "../component-api/types"
import { TextField } from "opui-css/astro"
import { components } from "../utils/components"
import { componentName } from "../utils/names"
import {
  componentHasFramework,
  FRAMEWORKS,
  type FrameworkId,
} from "../utils/framework"

const apiModules = import.meta.glob<AstroInstance>(
  "../component-api/**/*.astro",
  { eager: true },
)

const apiData = import.meta.glob<ComponentApi>("../component-api/*/api.ts", {
  eager: true,
  import: "default",
})

const API_LABEL_PATTERN = FRAMEWORKS.map((f) => f.label).join("|")
const LABEL_TO_ID = Object.fromEntries(
  FRAMEWORKS.map((f) => [f.label, f.id]),
) as Record<string, FrameworkId>

type ApiGroup = {
  folder: string
  page?: string
  prefix: string
  apis: FrameworkApis | { api: ComponentApi }[]
}

const groups: Record<string, ApiGroup> = {}

for (const path in apiModules) {
  const parts = path.split("/")
  const folder = parts[parts.length - 2]
  const filename = parts[parts.length - 1]

  const match = filename.match(
    new RegExp(`^(.*)(${API_LABEL_PATTERN})\\.astro$`),
  )
  if (!match) continue

  const prefix = match[1]
  const frameworkId = LABEL_TO_ID[match[2]]
  if (!frameworkId) continue

  const key = `${folder}/${prefix}`
  if (!groups[key]) {
    groups[key] = { folder, prefix, apis: {} }
  }
  ;(groups[key].apis as FrameworkApis)[frameworkId] = apiModules[path].default
}

for (const path in apiData) {
  const folder = path.split("/").at(-2)!
  groups[`${folder}/`] = {
    apis: [{ api: apiData[path] }],
    folder,
    page: apiData[path].page,
    prefix: "",
  }
}

const { link } = Astro.locals
const currentFramework = Astro.locals.framework
const pages = new Set(components.map((component) => component.slug))

const apiList = Object.values(groups)
  .filter(({ folder }) => componentHasFramework(currentFramework, folder))
  .map((group) => {
    let slug = group.prefix ? group.prefix.toLowerCase() : group.folder

    const title = componentName(slug)

    const page = group.page ?? slug

    return {
      title,
      slug,
      apis: group.apis,
      href: pages.has(page) ? link(`/components/${page}`) : undefined,
    }
  })
  .sort((a, b) => a.title.localeCompare(b.title))
---

<Document
  description="The props, slots, parts and classes of every component on one page, for HTML, Astro, React, Svelte and Vue."
  overline="API"
>
  <FrameworkPicker slot="sidebar" />

  <Fragment slot="title">Component API</Fragment>

  <style>
    table {
      cursor: default;
    }
    td a {
      color: currentColor;
      cursor: default;
      font-weight: inherit;
      pointer-events: none;
      text-decoration: none;
    }
  </style>

  <search class="api-filter ui-not-rich-text">
    <TextField
      autocomplete="off"
      label="Filter"
      name="api-filter"
      placeholder="Component, prop or class"
      type="search"
    />
    <p aria-live="polite" class="api-filter-status" role="status"></p>
  </search>

  {apiList.map(({ title, slug, apis, href }) => <section
    class="api-section"
    id={slug}
  >
    <h2>{href ? <a href={href}>{title}</a> : title}</h2>
    <ComponentAPI
      apis={apis}
      cssVariablesId={`${slug}-css-variables`}
      hideTitle
    />
  </section>)}

  <p class="api-filter-empty" hidden>No component, prop or class matches.</p>
</Document>

<script>
  const input = document.querySelector<HTMLInputElement>(".api-filter input")
  const status = document.querySelector(".api-filter-status")
  const empty = document.querySelector<HTMLElement>(".api-filter-empty")
  const search = document.querySelector(".api-filter")
  const sections = [...document.querySelectorAll<HTMLElement>(".api-section")]
  const texts = new WeakMap<Element, string>()

  const textOf = (element: Element) => {
    let text = texts.get(element)
    if (text === undefined) {
      text = (element.textContent ?? "").toLowerCase()
      texts.set(element, text)
    }
    return text
  }

  const filter = () => {
    if (!input) return
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean)
    const matches = (element: Element | null) =>
      !!element && terms.every((term) => textOf(element).includes(term))
    const filtering = terms.length > 0
    let shown = 0
    for (const section of sections) {
      const whole = matches(section.querySelector("h2"))
      let visible = whole
      for (const table of section.querySelectorAll("table")) {
        const wrapper = table.closest<HTMLElement>(".docs-table") ?? table
        let rows = 0
        for (const row of table.querySelectorAll<HTMLElement>("tbody tr")) {
          row.hidden = !whole && !matches(row)
          if (!row.hidden) rows++
        }
        wrapper.hidden = rows === 0
        visible ||= rows > 0
        if (filtering && wrapper.hasAttribute("data-collapsed")) {
          wrapper.removeAttribute("data-collapsed")
          wrapper.setAttribute("data-filter-expanded", "")
        } else if (!filtering && wrapper.hasAttribute("data-filter-expanded")) {
          wrapper.removeAttribute("data-filter-expanded")
          wrapper.setAttribute("data-collapsed", "")
        }
      }
      section.hidden = !visible
      if (visible) shown++
    }
    search?.toggleAttribute("data-filtering", filtering)
    if (status) {
      status.textContent = filtering
        ? `${shown} of ${sections.length} components`
        : ""
    }
    if (empty) empty.hidden = shown > 0
    const url = new URL(location.href)
    if (filtering) url.searchParams.set("filter", input.value)
    else url.searchParams.delete("filter")
    history.replaceState(history.state, "", url)
  }

  if (input) {
    input.value = new URLSearchParams(location.search).get("filter") ?? ""
    input.addEventListener("input", filter)
    if (input.value) filter()
  }

  let stopSettling = () => {}

  const settle = () => {
    stopSettling()
    const target = document.getElementById(location.hash.slice(1))
    if (!target) return
    if (input && target.closest("[hidden]")) {
      input.value = ""
      filter()
    }
    target.scrollIntoView()
    let top = target.getBoundingClientRect().top
    let idle = 0
    let limit = 0
    const controller = new AbortController()
    const stop = () => {
      clearTimeout(idle)
      clearTimeout(limit)
      observer.disconnect()
      controller.abort()
    }
    const stopWhenIdle = () => {
      if (document.readyState !== "complete") return
      clearTimeout(idle)
      idle = window.setTimeout(stop, 2000)
      limit ||= window.setTimeout(stop, 10_000)
    }
    const observer = new ResizeObserver(() => {
      if (Math.abs(target.getBoundingClientRect().top - top) >= 1) {
        target.scrollIntoView()
        top = target.getBoundingClientRect().top
      }
      stopWhenIdle()
    })
    stopSettling = stop
    const content = sections[0]?.parentElement
    if (content) observer.observe(content)
    for (const section of sections) observer.observe(section)
    for (const type of ["keydown", "pointerdown", "touchstart", "wheel"]) {
      addEventListener(type, stop, {
        passive: true,
        signal: controller.signal,
      })
    }
    addEventListener("load", stopWhenIdle, { signal: controller.signal })
    stopWhenIdle()
  }

  addEventListener("hashchange", settle)
  if (location.hash) settle()
</script>

<style>
  .api-filter {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    margin-block: var(--size-5);
  }

  .api-filter-status {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-caption);
    margin: 0;
  }

  :global(html:has(.api-section)) {
    scroll-behavior: auto;
  }

  .api-section {
    contain-intrinsic-block-size: auto 40rem;
    content-visibility: auto;
    overflow-clip-margin: var(--size-2);

    &:has(~ :global(.api-section:is(:target, :has(:target)))) {
      content-visibility: visible;
    }

    &[hidden],
    :global([hidden]),
    :global(:is(h3, h4):has(+ .docs-table[hidden])),
    :global(.docs-table[hidden] + p) {
      display: none;
    }
  }

  .api-filter[data-filtering] ~ .api-section :global([data-table-toggle]) {
    display: none;
  }
</style>
