---
import { TableCell, TableRow } from "opui-css/astro"
import {
  htmlRows,
  hydrationRows,
  partLabel,
  propRows,
  slotRows,
} from "../component-api/rows"
import DocsTable from "./DocsTable.astro"
import HydrationMarker from "./HydrationMarker.astro"
import type { ComponentApi } from "../component-api/types"
import {
  checkApi,
  reportProblems,
  shipped,
  splitUnion,
} from "../utils/component-source"
import { formatInline } from "../utils/format-inline"
import { FRAMEWORKS } from "../utils/framework"

type Props = {
  api: ComponentApi
  headingLevel?: 3 | 4
}

const { api, headingLevel = 4 } = Astro.props
const { link } = Astro.locals
const SlotsHeading = `h${headingLevel}` as const

reportProblems(checkApi(api))

const framework = Astro.locals.framework
const view = api.source ? framework : "html"
const component = view === "html" ? undefined : view
const html = component ? [] : htmlRows(api)
const rows = component ? propRows(api, component) : []
const hydration =
  component && shipped(api, component) ? hydrationRows(api, component) : []
const slots = component ? slotRows(api, component) : []
const parts = component
  ? []
  : [api.root, ...api.parts].map((part) => ({
      description: part.description,
      name: partLabel(api, part, "html"),
    }))
const notes = [
  ...new Set(
    [view, framework].flatMap(
      (key) => api.notes?.[key] ?? api.notes?.default ?? [],
    ),
  ),
]
if (!api.source && framework !== "html") {
  const label = FRAMEWORKS.find((entry) => entry.id === framework)?.label
  notes.push(
    [notes.pop(), `There is no ${label} component.`].filter(Boolean).join(" "),
  )
}
---

{
  html.length > 0 && (
    <DocsTable
      columns={[
        { label: "Type", width: "20%" },
        { label: "Modifiers", width: "20%" },
        { label: "Default", width: "20%" },
        { label: "Description" },
      ]}
    >
      {html.map((row) => (
        <TableRow>
          <TableCell>{row.name}</TableCell>
          <TableCell>
            {row.modifiers.map((modifier, i) => (
              <Fragment>
                {i > 0 && ", "}
                {modifier ? <code>{modifier}</code> : "default"}
              </Fragment>
            ))}
          </TableCell>
          <TableCell>
            {row.default === undefined ? (
              "-"
            ) : row.default ? (
              <code>{row.default}</code>
            ) : (
              "default"
            )}
          </TableCell>
          <TableCell set:html={formatInline(row.description, link)} />
        </TableRow>
      ))}
    </DocsTable>
  )
}

{
  rows.length > 0 && (
    <DocsTable
      columns={[
        { label: "Prop", width: "20%" },
        { label: "Type", width: "20%" },
        { label: "Default", width: "20%" },
        { label: "Description" },
      ]}
    >
      {rows.map((row) => {
        const needs = hydration.find((entry) => entry.prop === row.name)
        return (
          <TableRow>
            <TableCell>
              <code>{row.name}</code>
              {needs && <HydrationMarker hydration={needs} />}
            </TableCell>
            <TableCell>
              {row.type
                ? splitUnion(row.type).map((type, i) => (
                    <Fragment>
                      {i > 0 && ", "}
                      <code>{type}</code>
                    </Fragment>
                  ))
                : "-"}
            </TableCell>
            <TableCell>
              {row.default ? <code>{row.default}</code> : "-"}
            </TableCell>
            <TableCell set:html={formatInline(row.description, link)} />
          </TableRow>
        )
      })}
    </DocsTable>
  )
}

{
  [
    { heading: "Parts", label: "Part", rows: parts },
    { heading: "Slots", label: "Slot", rows: slots },
  ]
    .filter((table) => table.rows.length > 0)
    .map((table) => (
      <Fragment>
        <SlotsHeading>{table.heading}</SlotsHeading>
        <DocsTable
          columns={[
            { label: table.label, width: "30%" },
            { label: "Description" },
          ]}
        >
          {table.rows.map((row) => (
            <TableRow>
              <TableCell>
                <code>{row.name}</code>
              </TableCell>
              <TableCell set:html={formatInline(row.description, link)} />
            </TableRow>
          ))}
        </DocsTable>
      </Fragment>
    ))
}

{notes.map((note) => <p set:html={formatInline(note, link)} />)}
