---
import { Table } from "@opui/astro"
import type { Framework } from "../component-api/frameworks"
import {
  cssVarRows,
  htmlRows,
  partLabel,
  propRows,
  slotRows,
} from "../component-api/rows"
import DocLink from "./DocLink.astro"
import type { ComponentApi } from "../component-api/types"
import { checkApi } from "../utils/component-source"
import { formatInline } from "../utils/format-inline"
import { DEFAULT_FRAMEWORK } from "../utils/framework-routing"

type Props = {
  api: ComponentApi
  headingLevel?: 3 | 4
}

const { api, headingLevel = 4 } = Astro.props
const SlotsHeading = `h${headingLevel}` as const

checkApi(api)

const framework = (Astro.currentLocale ?? DEFAULT_FRAMEWORK) as Framework
const component = framework === "html" ? undefined : framework
const html = component ? [] : htmlRows(api)
const rows = component ? propRows(api, component) : []
const slots = component ? slotRows(api, component) : []
const parts = component
  ? []
  : [api.root, ...api.parts].map((part) => ({
      description: part.description,
      name: partLabel(api, part, "html"),
    }))
const note = api.notes?.[framework]
const cssVars = cssVarRows(api)

const splitType = (type: string) => type.split("|").map((part) => part.trim())
---

{
  html.length > 0 && (
    <div class="table-scroll wide">
      <Table>
        <Table.ColumnGroup>
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 300px" />
        </Table.ColumnGroup>
        <Table.Head>
          <Table.Row>
            <Table.HeaderCell>Type</Table.HeaderCell>
            <Table.HeaderCell>Modifiers</Table.HeaderCell>
            <Table.HeaderCell>Default</Table.HeaderCell>
            <Table.HeaderCell>Description</Table.HeaderCell>
          </Table.Row>
        </Table.Head>
        <Table.Body>
          {html.map((row) => (
            <Table.Row>
              <Table.Cell>{row.name}</Table.Cell>
              <Table.Cell>
                {row.modifiers.map((modifier, i) => (
                  <Fragment>
                    {i > 0 && ", "}
                    {modifier ? <code>{modifier}</code> : "default"}
                  </Fragment>
                ))}
              </Table.Cell>
              <Table.Cell>
                {row.default === undefined ? (
                  "-"
                ) : row.default ? (
                  <code>{row.default}</code>
                ) : (
                  "default"
                )}
              </Table.Cell>
              <Table.Cell set:html={formatInline(row.description)} />
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  )
}

{
  rows.length > 0 && (
    <div class="table-scroll wide">
      <Table>
        <Table.ColumnGroup>
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 300px" />
        </Table.ColumnGroup>
        <Table.Head>
          <Table.Row>
            <Table.HeaderCell>Prop</Table.HeaderCell>
            <Table.HeaderCell>Type</Table.HeaderCell>
            <Table.HeaderCell>Default</Table.HeaderCell>
            <Table.HeaderCell>Description</Table.HeaderCell>
          </Table.Row>
        </Table.Head>
        <Table.Body>
          {rows.map((row) => (
            <Table.Row>
              <Table.Cell>
                <code>{row.name}</code>
              </Table.Cell>
              <Table.Cell>
                {row.type
                  ? splitType(row.type).map((type, i) => (
                      <Fragment>
                        {i > 0 && ", "}
                        <code>{type}</code>
                      </Fragment>
                    ))
                  : "-"}
              </Table.Cell>
              <Table.Cell>
                {row.default ? <code>{row.default}</code> : "-"}
              </Table.Cell>
              <Table.Cell set:html={formatInline(row.description)} />
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  )
}

{
  [
    { heading: "Parts", label: "Part", rows: parts },
    { heading: "Slots", label: "Slot", rows: slots },
  ]
    .filter((table) => table.rows.length > 0)
    .map((table) => (
      <Fragment>
        <SlotsHeading>{table.heading}</SlotsHeading>
        <div class="table-scroll">
          <Table>
            <Table.ColumnGroup>
              <Table.Column width="min-width: 20%" />
              <Table.Column width="min-width: 300px" />
            </Table.ColumnGroup>
            <Table.Head>
              <Table.Row>
                <Table.HeaderCell>{table.label}</Table.HeaderCell>
                <Table.HeaderCell>Description</Table.HeaderCell>
              </Table.Row>
            </Table.Head>
            <Table.Body>
              {table.rows.map((row) => (
                <Table.Row>
                  <Table.Cell>
                    <code>{row.name}</code>
                  </Table.Cell>
                  <Table.Cell set:html={formatInline(row.description)} />
                </Table.Row>
              ))}
            </Table.Body>
          </Table>
        </div>
      </Fragment>
    ))
}

{
  cssVars.length > 0 && (
    <Fragment>
      <SlotsHeading>CSS variables</SlotsHeading>
      <div class="table-scroll wide">
        <Table>
          <Table.ColumnGroup>
            <Table.Column width="min-width: 20%" />
            <Table.Column width="min-width: 20%" />
            <Table.Column width="min-width: 300px" />
          </Table.ColumnGroup>
          <Table.Head>
            <Table.Row>
              <Table.HeaderCell>Variable</Table.HeaderCell>
              <Table.HeaderCell>Default</Table.HeaderCell>
              <Table.HeaderCell>Description</Table.HeaderCell>
            </Table.Row>
          </Table.Head>
          <Table.Body>
            {cssVars.map((row) => (
              <Table.Row>
                <Table.Cell>
                  <code>{row.name}</code>
                </Table.Cell>
                <Table.Cell>
                  {row.default ? <code>{row.default}</code> : "Unset"}
                  {row.dark && (
                    <Fragment>
                      <br />
                      <code>{row.dark}</code> in dark mode
                    </Fragment>
                  )}
                </Table.Cell>
                <Table.Cell set:html={formatInline(row.description)} />
              </Table.Row>
            ))}
          </Table.Body>
        </Table>
      </div>
      <p>
        Theme tokens this component reads. Override them on <code>html</code>
        or on a wrapper. See{" "}
        <DocLink href="/guide/theme-tokens">theme tokens</DocLink>
        for the full list.
      </p>
    </Fragment>
  )
}

{note && <p set:html={formatInline(note)} />}

<style>
  .table-scroll {
    margin-block-end: var(--size-4);
    overflow-x: auto;

    > :global(table) {
      inline-size: 100%;
      margin: 0;
      table-layout: fixed;
    }

    &.wide > :global(table) {
      min-inline-size: 40rem;
    }
  }
</style>
