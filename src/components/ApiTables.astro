---
import { Table } from "@opui/astro"
import type { Framework } from "../component-api/frameworks"
import { htmlRows, propRows, slotRows } from "../component-api/rows"
import type { ComponentApi } from "../component-api/types"
import { checkApi } from "../utils/component-source"
import { formatInline } from "../utils/format-inline"
import { DEFAULT_FRAMEWORK } from "../utils/framework-routing"

type Props = {
  api: ComponentApi
  headingLevel?: 3 | 4
}

const { api, headingLevel = 4 } = Astro.props
const SlotsHeading = `h${headingLevel}` as const

checkApi(api)

const framework = (Astro.currentLocale ?? DEFAULT_FRAMEWORK) as Framework
const component = framework === "html" ? undefined : framework
const html = component ? [] : htmlRows(api)
const rows = component ? propRows(api, component) : []
const slots = component ? slotRows(api, component) : []
const note = api.notes?.[framework]

const splitType = (type: string) => type.split("|").map((part) => part.trim())
---

{
  !component ? (
    <div class="table-scroll wide">
      <Table>
        <Table.ColumnGroup>
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 20%" />
          <Table.Column width="min-width: 300px" />
        </Table.ColumnGroup>
        <Table.Head>
          <Table.Row>
            <Table.HeaderCell>Type</Table.HeaderCell>
            <Table.HeaderCell>Modifiers</Table.HeaderCell>
            <Table.HeaderCell>Default</Table.HeaderCell>
            <Table.HeaderCell>Description</Table.HeaderCell>
          </Table.Row>
        </Table.Head>
        <Table.Body>
          {html.map((row) => (
            <Table.Row>
              <Table.Cell>{row.name}</Table.Cell>
              <Table.Cell>
                <code>{row.modifier}</code>
              </Table.Cell>
              <Table.Cell>-</Table.Cell>
              <Table.Cell set:html={formatInline(row.description)} />
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  ) : (
    <Fragment>
      <div class="table-scroll wide">
        <Table>
          <Table.ColumnGroup>
            <Table.Column width="min-width: 20%" />
            <Table.Column width="min-width: 20%" />
            <Table.Column width="min-width: 20%" />
            <Table.Column width="min-width: 300px" />
          </Table.ColumnGroup>
          <Table.Head>
            <Table.Row>
              <Table.HeaderCell>Prop</Table.HeaderCell>
              <Table.HeaderCell>Type</Table.HeaderCell>
              <Table.HeaderCell>Default</Table.HeaderCell>
              <Table.HeaderCell>Description</Table.HeaderCell>
            </Table.Row>
          </Table.Head>
          <Table.Body>
            {rows.map((row) => (
              <Table.Row>
                <Table.Cell>
                  <code>{row.name}</code>
                </Table.Cell>
                <Table.Cell>
                  {row.type
                    ? splitType(row.type).map((type, i) => (
                        <Fragment>
                          {i > 0 && ", "}
                          <code>{type}</code>
                        </Fragment>
                      ))
                    : "-"}
                </Table.Cell>
                <Table.Cell>
                  {row.default ? <code>{row.default}</code> : "-"}
                </Table.Cell>
                <Table.Cell set:html={formatInline(row.description)} />
              </Table.Row>
            ))}
          </Table.Body>
        </Table>
      </div>

      {slots.length > 0 && (
        <Fragment>
          <SlotsHeading>Slots</SlotsHeading>
          <div class="table-scroll">
            <Table>
              <Table.ColumnGroup>
                <Table.Column width="min-width: 20%" />
                <Table.Column width="min-width: 300px" />
              </Table.ColumnGroup>
              <Table.Head>
                <Table.Row>
                  <Table.HeaderCell>Slot</Table.HeaderCell>
                  <Table.HeaderCell>Description</Table.HeaderCell>
                </Table.Row>
              </Table.Head>
              <Table.Body>
                {slots.map((row) => (
                  <Table.Row>
                    <Table.Cell>
                      <code>{row.name}</code>
                    </Table.Cell>
                    <Table.Cell set:html={formatInline(row.description)} />
                  </Table.Row>
                ))}
              </Table.Body>
            </Table>
          </div>
        </Fragment>
      )}
    </Fragment>
  )
}

{note && <p set:html={formatInline(note)} />}

<style>
  .table-scroll {
    margin-block-end: var(--size-4);
    overflow-x: auto;

    > :global(table) {
      inline-size: 100%;
      margin: 0;
      table-layout: fixed;
    }

    &.wide > :global(table) {
      min-inline-size: 40rem;
    }
  }
</style>
