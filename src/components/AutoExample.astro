---
import Example from "./Example/index"
import {
  componentHasFramework,
  exampleExtension,
  FRAMEWORK_AGNOSTIC_EXAMPLES,
} from "../utils/framework"

type Props = {
  /**
   * Example file basename inside `src/component-examples/<slug>/`, e.g.
   * `"Image"` resolves to `Image.astro` and `Image.html` for the Astro and
   * HTML frameworks respectively.
   */
  name: string
  /**
   * Component slug. Defaults to `Astro.locals.componentSlug` (set by the
   * `Component` layout from its own `slug` prop), so doc pages don't have
   * to repeat the slug on every example.
   */
  slug?: string
  centered?: boolean
  class?: string
  column?: boolean
  exampleClass?: string
  marks?: Record<string, any>
  output?: "always-show" | "toggled"
  richText?: "rich-text" | "not-rich-text"
  row?: boolean
  showCode?: boolean
  spacious?: boolean
  wrapperClass?: string
}

const { name, slug: slugProp, ...rest } = Astro.props
const slug = slugProp ?? Astro.locals.componentSlug

if (!slug) {
  throw new Error(
    `<AutoExample name="${name}"> requires a "slug" prop or Astro.locals.componentSlug ` +
      `(set by <Component slug="..."> in the page frontmatter).`,
  )
}

// Eager globs scoped to the component-examples tree. Vite resolves these at
// build time, so missing files mean `undefined` rather than a runtime fetch.
// Note: every matched file must be parseable; orphaned/broken example files
// will fail the whole build.
const previewModules = import.meta.glob(
  "../component-examples/**/*.{astro,svelte}",
  {
    eager: true,
  },
) as Record<string, { default: unknown }>

const reactPreviewModules = import.meta.glob(
  "../component-examples/**/*.react.tsx",
  {
    eager: true,
  },
) as Record<string, { default: unknown }>

const vuePreviewModules = import.meta.glob("../component-examples/**/*.vue", {
  eager: true,
}) as Record<string, { default: unknown }>

const rawSources = import.meta.glob(
  "../component-examples/**/*.{astro,html,react.tsx,svelte,vue}",
  {
    eager: true,
    query: "?raw",
    import: "default",
  },
) as Record<string, string>

const astroPath = `../component-examples/${slug}/${name}.astro`
const htmlPath = `../component-examples/${slug}/${name}.html`
const reactPath = `../component-examples/${slug}/${name}.react.tsx`
const vuePath = `../component-examples/${slug}/${name}.vue`
const sveltePath = `../component-examples/${slug}/${name}.svelte`

const astroComponent = previewModules[astroPath]?.default
const reactComponent = reactPreviewModules[reactPath]?.default
const vueComponent = vuePreviewModules[vuePath]?.default
const svelteComponent = previewModules[sveltePath]?.default
const astroSource = rawSources[astroPath]
const htmlSource = rawSources[htmlPath]
const reactSource = rawSources[reactPath]
const vueSource = rawSources[vuePath]
const svelteSource = rawSources[sveltePath]
const codeSource = (ext: string) =>
  rawSources[`../component-examples/${slug}/${name}Code.${ext}`] ??
  rawSources[`../component-examples/${slug}/${name}.${ext}`]

const frameworkAgnostic = FRAMEWORK_AGNOSTIC_EXAMPLES.includes(
  `${slug}/${name}`,
)
const frameworkFiles = [astroSource, reactSource, svelteSource, vueSource]

if (frameworkAgnostic && (!htmlSource || frameworkFiles.some(Boolean))) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> is listed in ` +
      `FRAMEWORK_AGNOSTIC_EXAMPLES, so it needs ${htmlPath} and no other files.`,
  )
}

const framework = Astro.locals.framework
if (
  !frameworkAgnostic &&
  framework !== "html" &&
  componentHasFramework(framework, slug) &&
  !rawSources[
    `../component-examples/${slug}/${name}.${exampleExtension(framework)}`
  ]
) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> has no ${framework} file. ` +
      `Add it, or list the example in FRAMEWORK_AGNOSTIC_EXAMPLES to show ` +
      `${htmlPath} on every framework page.`,
  )
}

if (
  !astroComponent &&
  !htmlSource &&
  !reactComponent &&
  !vueComponent &&
  !svelteComponent
) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> found no example files at ` +
      `${astroPath}, ${htmlPath}, ${reactPath}, ${vuePath}, or ${sveltePath}.`,
  )
}
---

<Example
  {...rest}
  reactExampleId={reactComponent ? `${slug}/${name}` : undefined}
  svelteExampleId={svelteComponent ? `${slug}/${name}` : undefined}
  vueExampleId={vueComponent ? `${slug}/${name}` : undefined}
>
  {
    Astro.slots.has("controls") && (
      <Fragment slot="controls">
        <slot name="controls" />
      </Fragment>
    )
  }
  {
    astroComponent && (
      <Example.Preview slot="preview-astro" code={astroComponent} />
    )
  }
  {
    reactComponent && (
      <Example.Preview slot="preview-react" code={reactComponent} />
    )
  }
  {
    svelteComponent && (
      <Example.Preview slot="preview-svelte" code={svelteComponent} />
    )
  }
  {htmlSource && <Example.Preview slot="preview-html" code={htmlSource} />}
  {vueComponent && <Example.Preview slot="preview-vue" code={vueComponent} />}
  {astroSource && <Example.Code slot="code-astro" code={codeSource("astro")} />}
  {htmlSource && <Example.Code slot="code-html" code={codeSource("html")} />}
  {
    reactSource && (
      <Example.Code slot="code-react" code={codeSource("react.tsx")} />
    )
  }
  {
    svelteSource && (
      <Example.Code slot="code-svelte" code={codeSource("svelte")} />
    )
  }
  {vueSource && <Example.Code slot="code-vue" code={codeSource("vue")} />}
</Example>
