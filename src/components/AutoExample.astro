---
import Example from "./Example/index"
import { examplePath, exampleModules, exampleSources } from "../utils/examples"
import {
  componentHasFramework,
  FRAMEWORK_AGNOSTIC_EXAMPLES,
} from "../utils/framework"

type Props = {
  /**
   * Example file basename inside `src/component-examples/<slug>/`, e.g.
   * `"Image"` resolves to `Image.astro` and `Image.html` for the Astro and
   * HTML frameworks respectively.
   */
  name: string
  /**
   * Component slug. Defaults to `Astro.locals.componentSlug` (set by the
   * `Component` layout from its own `slug` prop), so doc pages don't have
   * to repeat the slug on every example.
   */
  slug?: string
  centered?: boolean
  class?: string
  column?: boolean
  row?: boolean
  showCode?: boolean
  spacious?: boolean
}

const { name, slug: slugProp, ...rest } = Astro.props
const slug = slugProp ?? Astro.locals.componentSlug

if (!slug) {
  throw new Error(
    `<AutoExample name="${name}"> requires a "slug" prop or Astro.locals.componentSlug ` +
      `(set by <Component slug="..."> in the page frontmatter).`,
  )
}

const astroPath = examplePath(slug, name, "astro")
const htmlPath = examplePath(slug, name, "html")
const reactPath = examplePath(slug, name, "react")
const vuePath = examplePath(slug, name, "vue")
const sveltePath = examplePath(slug, name, "svelte")

const astroComponent = exampleModules[astroPath]?.default
const reactComponent = exampleModules[reactPath]?.default
const vueComponent = exampleModules[vuePath]?.default
const svelteComponent = exampleModules[sveltePath]?.default
const astroSource = exampleSources[astroPath]
const htmlSource = exampleSources[htmlPath]
const reactSource = exampleSources[reactPath]
const vueSource = exampleSources[vuePath]
const svelteSource = exampleSources[sveltePath]

const frameworkAgnostic = FRAMEWORK_AGNOSTIC_EXAMPLES.includes(
  `${slug}/${name}`,
)
const frameworkFiles = [astroSource, reactSource, svelteSource, vueSource]

if (frameworkAgnostic && (!htmlSource || frameworkFiles.some(Boolean))) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> is listed in ` +
      `FRAMEWORK_AGNOSTIC_EXAMPLES, so it needs ${htmlPath} and no other files.`,
  )
}

const framework = Astro.locals.framework
if (
  !frameworkAgnostic &&
  framework !== "html" &&
  componentHasFramework(framework, slug) &&
  !exampleSources[examplePath(slug, name, framework)]
) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> has no ${framework} file. ` +
      `Add it, or list the example in FRAMEWORK_AGNOSTIC_EXAMPLES to show ` +
      `${htmlPath} on every framework page.`,
  )
}

if (
  !astroComponent &&
  !htmlSource &&
  !reactComponent &&
  !vueComponent &&
  !svelteComponent
) {
  throw new Error(
    `<AutoExample slug="${slug}" name="${name}"> found no example files at ` +
      `${astroPath}, ${htmlPath}, ${reactPath}, ${vuePath}, or ${sveltePath}.`,
  )
}
---

<Example
  {...rest}
  reactExampleId={reactComponent ? `${slug}/${name}` : undefined}
  svelteExampleId={svelteComponent ? `${slug}/${name}` : undefined}
  vueExampleId={vueComponent ? `${slug}/${name}` : undefined}
>
  {
    Astro.slots.has("controls") && (
      <Fragment slot="controls">
        <slot name="controls" />
      </Fragment>
    )
  }
  {
    astroComponent && (
      <Example.Preview slot="preview-astro" code={astroComponent} />
    )
  }
  {
    reactComponent && (
      <Example.Preview slot="preview-react" code={reactComponent} />
    )
  }
  {
    svelteComponent && (
      <Example.Preview slot="preview-svelte" code={svelteComponent} />
    )
  }
  {htmlSource && <Example.Preview slot="preview-html" code={htmlSource} />}
  {vueComponent && <Example.Preview slot="preview-vue" code={vueComponent} />}
  {astroSource && <Example.Code slot="code-astro" code={astroSource} />}
  {htmlSource && <Example.Code slot="code-html" code={htmlSource} />}
  {reactSource && <Example.Code slot="code-react" code={reactSource} />}
  {svelteSource && <Example.Code slot="code-svelte" code={svelteSource} />}
  {vueSource && <Example.Code slot="code-vue" code={vueSource} />}
</Example>
