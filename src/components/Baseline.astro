---
import FeatureSupport from "./UnderTheHood/FeatureSupport.astro"

type Props = {
  ids: string[]
}

const { ids } = Astro.props
---

{ids.length > 0 && <div class="baseline ui-not-rich-text">
  <FeatureSupport ids={ids} />
</div>}

<style>
  .baseline {
    margin-block: var(--size-3);
  }
</style>
