---
type Props = {
  slug: string
}

const { slug } = Astro.props

const icons = {
  download:
    "M3.5 13H12.5C12.7761 13 13 13.2239 13 13.5C13 13.7455 12.8231 13.9496 12.5899 13.9919L12.5 14H3.5C3.22386 14 3 13.7761 3 13.5C3 13.2545 3.17688 13.0504 3.41012 13.0081L3.5 13H12.5H3.5ZM7.91012 1.00806L8 1C8.24546 1 8.44961 1.17688 8.49194 1.41012L8.5 1.5V10.292L11.182 7.61091C11.3555 7.43735 11.625 7.41806 11.8198 7.55306L11.8891 7.61091C12.0627 7.78448 12.0819 8.0539 11.9469 8.24877L11.8891 8.31802L8.35355 11.8536C8.17999 12.0271 7.91056 12.0464 7.71569 11.9114L7.64645 11.8536L4.11091 8.31802C3.91565 8.12276 3.91565 7.80617 4.11091 7.61091C4.28448 7.43735 4.5539 7.41806 4.74877 7.55306L4.81802 7.61091L7.5 10.292V1.5C7.5 1.25454 7.67688 1.05039 7.91012 1.00806L8 1L7.91012 1.00806Z",
  edit: "M14.236 1.76406C13.2123 0.74037 11.5525 0.740369 10.5289 1.76406L2.65722 9.63568C2.28304 10.0099 2.01623 10.4777 1.88467 10.9902L1.01571 14.3757C0.971767 14.5469 1.02148 14.7286 1.14646 14.8536C1.27144 14.9785 1.45312 15.0282 1.62432 14.9843L5.00978 14.1153C5.52234 13.9838 5.99015 13.717 6.36433 13.3428L14.236 5.47117C15.2596 4.44748 15.2596 2.78775 14.236 1.76406ZM11.236 2.47117C11.8691 1.838 12.8957 1.838 13.5288 2.47117C14.162 3.10433 14.162 4.13089 13.5288 4.76406L12.75 5.54288L10.4571 3.24999L11.236 2.47117ZM9.75002 3.9571L12.0429 6.24999L5.65722 12.6357C5.40969 12.8832 5.10023 13.0597 4.76117 13.1467L2.19447 13.8055L2.85327 11.2388C2.9403 10.8998 3.1168 10.5903 3.36433 10.3428L9.75002 3.9571Z",
  heart:
    "M7.54112 3.94779C6.26943 2.6761 4.21207 2.66992 2.94588 3.93611C1.67969 5.20231 1.68587 7.25966 2.95756 8.53136L7.66505 13.2389C7.86031 13.4341 8.1769 13.4341 8.37216 13.2389L13.0552 8.55858C14.3184 7.28827 14.3144 5.23668 13.0425 3.96476C11.7686 2.69079 9.71024 2.68461 8.44178 3.95306L7.99452 4.40119L7.54112 3.94779ZM12.3461 7.85345L8.01861 12.1782L3.66467 7.82425C2.78255 6.94213 2.77827 5.51794 3.65299 4.64322C4.5277 3.76851 5.9519 3.77278 6.83402 4.6549L7.64337 5.46426C7.84197 5.66285 8.16514 5.65896 8.35889 5.45564L9.14889 4.66017C10.0259 3.78319 11.451 3.78747 12.3354 4.67187C13.2178 5.5542 13.2205 6.97415 12.3461 7.85345Z",
  info: "M8.49902 7.49998C8.49902 7.22384 8.27517 6.99998 7.99902 6.99998C7.72288 6.99998 7.49902 7.22384 7.49902 7.49998V10.5C7.49902 10.7761 7.72288 11 7.99902 11C8.27517 11 8.49902 10.7761 8.49902 10.5V7.49998ZM8.74807 5.50001C8.74807 5.91369 8.41271 6.24905 7.99903 6.24905C7.58535 6.24905 7.25 5.91369 7.25 5.50001C7.25 5.08633 7.58535 4.75098 7.99903 4.75098C8.41271 4.75098 8.74807 5.08633 8.74807 5.50001ZM8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1ZM2 8C2 4.68629 4.68629 2 8 2C11.3137 2 14 4.68629 14 8C14 11.3137 11.3137 14 8 14C4.68629 14 2 11.3137 2 8Z",
  success:
    "M2 8C2 4.68629 4.68629 2 8 2C11.3137 2 14 4.68629 14 8C14 11.3137 11.3137 14 8 14C4.68629 14 2 11.3137 2 8ZM8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1ZM10.8536 6.85355C11.0488 6.65829 11.0488 6.34171 10.8536 6.14645C10.6583 5.95118 10.3417 5.95118 10.1464 6.14645L7.25 9.04289L5.85355 7.64645C5.65829 7.45118 5.34171 7.45118 5.14645 7.64645C4.95118 7.84171 4.95118 8.15829 5.14645 8.35355L6.89645 10.1036C7.09171 10.2988 7.40829 10.2988 7.60355 10.1036L10.8536 6.85355Z",
}

const id = (name: string) => `blog-preview-${slug}-${name}`
---

<div class="blog-preview" data-preview={slug} inert>
  {
    slug === "accordion-height-auto" && (
      <details class="ui-accordion ui-outlined" open>
        <summary>
          Shipping
          <svg aria-hidden="true" class="ui-marker" viewBox="0 0 24 24">
            <path
              d="M4.293 8.293a1 1 0 0 1 1.414 0L12 14.586l6.293-6.293a1 1 0 1 1 1.414 1.414l-7 7a1 1 0 0 1-1.414 0l-7-7a1 1 0 0 1 0-1.414"
              fill="currentColor"
            />
          </svg>
        </summary>
        <div class="ui-content">
          <p>Free over 50 €, in two to four days.</p>
        </div>
      </details>
    )
  }
  {
    slug === "anchor-hover-cards" && (
      <div class="blog-preview-anchor">
        <a class="ui-link" href="#">
          @opui
        </a>
        <span class="ui-card ui-elevated blog-preview-hover-card">
          <span class="ui-avatar ui-small ui-tonal">OP</span>
          <span>
            <strong>opui</strong>
            <br />
            CSS-first components
          </span>
        </span>
      </div>
    )
  }
  {
    slug === "avatar-squircles" && (
      <div class="blog-preview-row">
        <span class="ui-avatar ui-large ui-squircle">AK</span>
        <span class="ui-avatar ui-large ui-squircle ui-tonal">JB</span>
        <span class="ui-avatar ui-large ui-squircle ui-outlined">SQ</span>
      </div>
    )
  }
  {
    slug === "button-icon-only-has" && (
      <div class="blog-preview-row">
        <button aria-label="Edit" class="ui-button ui-outlined" type="button">
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d={icons.edit} fill="currentColor" />
          </svg>
        </button>
        <button
          aria-label="Like"
          class="ui-button ui-round ui-tonal"
          type="button"
        >
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d={icons.heart} fill="currentColor" />
          </svg>
        </button>
        <button class="ui-button ui-filled" type="button">
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d={icons.download} fill="currentColor" />
          </svg>
          <span class="ui-text">Download</span>
        </button>
      </div>
    )
  }
  {
    slug === "callout-relative-colors" && (
      <div class="blog-preview-stack">
        <article class="ui-callout ui-info">
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d={icons.info} fill="currentColor" />
          </svg>
          <div class="ui-content">One hue, every shade.</div>
        </article>
        <article class="ui-callout ui-success">
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d={icons.success} fill="currentColor" />
          </svg>
          <div class="ui-content">Derived with oklch(from).</div>
        </article>
      </div>
    )
  }
  {
    slug === "carousel-css-only" && (
      <ul
        aria-label="Slides"
        class="ui-carousel"
        style="--_items-per-view: 2.3"
      >
        {["Kyoto", "Lima", "Lisbon", "Oslo"].map((city) => (
          <li>
            <div class="ui-card ui-tonal">
              <div class="ui-content">{city}</div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
  {
    slug === "checkbox-appearance-none" && (
      <div class="blog-preview-row">
        <label class="ui-checkbox">
          <input checked name={id("checkbox")} type="checkbox" />
          <span class="ui-label">Checked</span>
        </label>
        <label class="ui-checkbox">
          <input name={id("checkbox")} type="checkbox" />
          <span class="ui-label">Not yet</span>
        </label>
      </div>
    )
  }
  {
    slug === "description-list-leader-lines" && (
      <dl class="ui-description-list ui-bordered ui-dotted ui-horizontal">
        <div>
          <dt>Espresso</dt>
          <dd>2.80</dd>
        </div>
        <div>
          <dt>Flat white</dt>
          <dd>3.90</dd>
        </div>
        <div>
          <dt>Cardamom bun</dt>
          <dd>4.20</dd>
        </div>
      </dl>
    )
  }
  {
    slug === "dialog-closedby" && (
      <div class="blog-preview-backdrop">
        <div class="ui-card ui-elevated blog-preview-dialog">
          <strong>Discard draft?</strong>
          <span>Click outside to keep writing.</span>
          <div class="blog-preview-row">
            <button class="ui-button ui-small" type="button">
              Cancel
            </button>
            <button
              class="ui-button ui-critical ui-filled ui-small"
              type="button"
            >
              Discard
            </button>
          </div>
        </div>
      </div>
    )
  }
  {
    slug === "drawer-starting-style" && (
      <div class="blog-preview-backdrop blog-preview-drawer-stage">
        <div class="ui-card ui-elevated blog-preview-drawer">
          <strong>Filters</strong>
          <span class="blog-preview-line" />
          <span class="blog-preview-line" />
          <span class="blog-preview-line blog-preview-line-short" />
        </div>
      </div>
    )
  }
  {
    slug === "form-fieldset-has" && (
      <fieldset class="ui-fieldset">
        <legend>Contact</legend>
        <label class="ui-text-field ui-small">
          <span class="ui-label">Email</span>
          <span class="ui-field">
            <input required type="email" value="hi@opui.dev" />
          </span>
        </label>
      </fieldset>
    )
  }
  {
    slug === "menu-popover-anchor" && (
      <div class="blog-preview-menu">
        <button class="ui-button ui-outlined ui-small" type="button">
          Options
        </button>
        <menu class="ui-menu ui-dense">
          <li>
            <button type="button">
              <div class="ui-text">
                <p>Edit</p>
              </div>
            </button>
          </li>
          <li>
            <button type="button">
              <div class="ui-text">
                <p>Duplicate</p>
              </div>
            </button>
          </li>
          <li class="ui-border-top ui-critical">
            <button type="button">
              <div class="ui-text">
                <p>Delete</p>
              </div>
            </button>
          </li>
        </menu>
      </div>
    )
  }
  {
    slug === "progress-native" && (
      <div class="blog-preview-stack">
        <div class="ui-progress">
          <progress aria-label="Upload" max="100" value="64" />
        </div>
        <div class="ui-progress">
          <progress aria-label="Loading" />
        </div>
      </div>
    )
  }
  {
    slug === "range-tick-marks" && (
      <label class="ui-range">
        <span class="ui-label">Quality</span>
        <input list={id("ticks")} max="2" type="range" value="1" />
        <datalist id={id("ticks")}>
          <option label="Low" value="0" />
          <option label="Medium" value="1" />
          <option label="High" value="2" />
        </datalist>
      </label>
    )
  }
  {
    slug === "select-base-select" && (
      <label class="ui-select">
        <span class="ui-label">Role</span>
        <span class="ui-field">
          <select>
            <button>
              <selectedcontent />
            </button>
            <div class="ui-list">
              <option value="designer">Designer</option>
              <option selected value="developer">
                Developer
              </option>
            </div>
          </select>
        </span>
      </label>
    )
  }
  {
    slug === "spinner-aria-busy" && (
      <div class="blog-preview-row">
        <div aria-busy="true">Loading</div>
        <button aria-busy="true" class="ui-button ui-filled" type="button">
          Saving
        </button>
      </div>
    )
  }
  {
    slug === "switch-checkbox" && (
      <div class="blog-preview-stack">
        <label class="ui-switch">
          <input checked role="switch" type="checkbox" />
          <span class="ui-label">Wi-Fi</span>
        </label>
        <label class="ui-switch">
          <input role="switch" type="checkbox" />
          <span class="ui-label">Airplane mode</span>
        </label>
      </div>
    )
  }
  {
    slug === "table-scroll-state" && (
      <table class="ui-table ui-dense">
        <thead>
          <tr>
            <th>Planet</th>
            <th>Moons</th>
            <th>Rings</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Saturn</td>
            <td>146</td>
            <td>Yes</td>
          </tr>
          <tr>
            <td>Jupiter</td>
            <td>95</td>
            <td>Faint</td>
          </tr>
        </tbody>
      </table>
    )
  }
  {
    slug === "tabs-radio-buttons" && (
      <div class="ui-tabs">
        <input
          checked
          class="ui-input"
          id={id("tab-1")}
          name={id("tabs")}
          type="radio"
        />
        <label class="ui-label" for={id("tab-1")}>
          Profile
        </label>
        <div class="ui-panel">Name, photo and bio.</div>
        <input
          class="ui-input"
          id={id("tab-2")}
          name={id("tabs")}
          type="radio"
        />
        <label class="ui-label" for={id("tab-2")}>
          Settings
        </label>
        <div class="ui-panel">General settings.</div>
      </div>
    )
  }
  {
    slug === "text-field-user-invalid" && (
      <label class="ui-text-field">
        <span class="ui-label">Email</span>
        <span class="ui-field">
          <input aria-invalid="true" type="email" value="hi@opui" />
        </span>
        <span class="ui-end-text">Add a domain, like opui.dev.</span>
      </label>
    )
  }
  {
    slug === "textarea-field-sizing" && (
      <label class="ui-textarea">
        <span class="ui-label">Message</span>
        <span class="ui-field">
          <textarea
            rows="2"
            set:text="The box grows with every line you write, no script needed."
          />
        </span>
      </label>
    )
  }
  {
    slug === "tooltip-interest-invokers" && (
      <span class="ui-tooltip">
        <button class="ui-button ui-outlined ui-small" type="button">
          Save
        </button>
        <span class="ui-floating">Saves a draft</span>
      </span>
    )
  }
  {
    slug === "fluid-type-progress" && (
      <div class="blog-preview-type">
        <span class="blog-preview-type-xl">Aa</span>
        <span class="blog-preview-type-l">Aa</span>
        <span class="blog-preview-type-m">Aa</span>
        <span class="blog-preview-type-s">Aa</span>
      </div>
    )
  }
  {
    slug === "vertical-rhythm-round" && (
      <div class="blog-preview-rhythm">
        <strong>Heading on the grid</strong>
        <span>Every line lands on the same rhythm, headings too.</span>
      </div>
    )
  }
</div>

<style>
  .blog-preview {
    align-items: center;
    background-color: var(--ui-surface-tonal);
    block-size: 10rem;
    border-radius: var(--ui-radius);
    container-type: inline-size;
    display: grid;
    grid-area: preview;
    justify-items: center;
    overflow: clip;
    padding: var(--ui-space-4);
    position: relative;

    & > * {
      max-inline-size: 100%;
    }
  }

  .blog-preview-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-2);
    justify-content: center;
  }

  .blog-preview-stack {
    display: grid;
    gap: var(--ui-space-2);
    inline-size: min(100%, 18rem);
  }

  [data-preview="accordion-height-auto"] .ui-accordion,
  [data-preview="form-fieldset-has"] .ui-fieldset,
  [data-preview="range-tick-marks"] .ui-range,
  [data-preview="select-base-select"] .ui-select,
  [data-preview="table-scroll-state"] .ui-table,
  [data-preview="tabs-radio-buttons"] .ui-tabs,
  [data-preview="text-field-user-invalid"] .ui-text-field,
  [data-preview="textarea-field-sizing"] .ui-textarea {
    inline-size: min(100%, 18rem);
  }

  [data-preview="description-list-leader-lines"] .ui-description-list {
    inline-size: 100%;
  }

  .blog-preview-anchor {
    display: grid;
    gap: var(--ui-space-2);
    justify-items: center;
  }

  .blog-preview-hover-card {
    align-items: center;
    display: flex;
    font-size: var(--ui-font-size-small);
    gap: var(--ui-space-2);
    line-height: 1.3;
    padding: var(--ui-space-3);
    white-space: nowrap;
  }

  [data-preview="carousel-css-only"] .ui-carousel {
    inline-size: 100%;
  }

  .blog-preview-backdrop {
    align-items: center;
    background-color: oklch(from var(--ui-text-strong) l c h / 18%);
    display: grid;
    inset: 0;
    justify-items: center;
    position: absolute;
  }

  .blog-preview-dialog {
    display: grid;
    font-size: var(--ui-font-size-small);
    gap: var(--ui-space-2);
    padding: var(--ui-space-3);

    & .blog-preview-row {
      justify-content: end;
    }
  }

  .blog-preview-drawer-stage {
    justify-items: end;
  }

  .blog-preview-drawer {
    align-content: start;
    block-size: 100%;
    border-end-end-radius: 0;
    border-start-end-radius: 0;
    display: grid;
    gap: var(--ui-space-2);
    inline-size: 55%;
    padding: var(--ui-space-3);
  }

  .blog-preview-line {
    background-color: var(--ui-surface-tonal);
    block-size: 0.5rem;
    border-radius: var(--ui-radius-small);
  }

  .blog-preview-line-short {
    inline-size: 60%;
  }

  .blog-preview-menu {
    display: grid;
    gap: var(--ui-space-1);
    justify-items: start;

    & .ui-menu {
      min-inline-size: 9rem;
    }
  }

  [data-preview="tooltip-interest-invokers"] {
    align-items: end;
  }

  .blog-preview-type {
    align-items: baseline;
    color: var(--ui-text-strong);
    display: flex;
    font-weight: 700;
    gap: var(--ui-space-3);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .blog-preview-type-xl {
    font-size: clamp(2.5rem, 1rem + 12cqi, 4rem);
  }

  .blog-preview-type-l {
    font-size: clamp(1.75rem, 0.75rem + 8cqi, 2.75rem);
  }

  .blog-preview-type-m {
    font-size: clamp(1.25rem, 0.5rem + 5cqi, 1.75rem);
  }

  .blog-preview-type-s {
    font-size: 1rem;
  }

  .blog-preview-rhythm {
    --line: 1.5rem;

    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 calc(var(--line) - 1px),
      oklch(from var(--ui-primary) l c h / 35%) calc(var(--line) - 1px)
        var(--line)
    );
    display: grid;
    inline-size: min(100%, 16rem);
    line-height: var(--line);

    & strong {
      color: var(--ui-text-strong);
      font-size: 1.125rem;
    }
  }
</style>
