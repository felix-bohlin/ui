---
import { Field, Switch } from "opui-css/astro"

const seconds = 0.6
const durationId = Astro.locals.$id("starting-style-compare-duration")

const columns = [
  { code: "@starting-style", mode: "with" },
  { code: "no @starting-style", mode: "without" },
]
---

<div class="starting-style-compare" style={`--_seconds: ${seconds}s`}>
  <div class="starting-style-compare-columns">
    {columns.map((column) => <figure
      class="starting-style-compare-column"
      data-mode={column.mode}
    >
      <figcaption>
        <code>{column.code}</code>
      </figcaption>
      <div class="starting-style-compare-stage">
        <div class="starting-style-compare-panel">
          <p class="starting-style-compare-title">Drawer</p>
          <p>
            Open and close it. Watch how each side enters, and how both leave.
          </p>
        </div>
      </div>
    </figure>)}
  </div>
  <div class="starting-style-compare-knobs">
    <Switch class="starting-style-compare-switch" label="Open" />
    <Field for={durationId} label="Duration">
      <input
        id={durationId}
        max="2"
        min="0.1"
        step="0.1"
        type="range"
        value={seconds}
      />
      <Fragment slot="end-text"
        ><output aria-live="off" class="ui-value" for={durationId}
          >{seconds.toFixed(1)}s</output
        ></Fragment
      >
    </Field>
  </div>
</div>

<style>
  .starting-style-compare {
    --_duration: calc(var(--_seconds) * var(--ui-motion));

    display: grid;
    gap: var(--ui-space-5);
    inline-size: 100%;
  }

  .starting-style-compare-columns {
    display: grid;
    gap: var(--ui-space-5) var(--ui-space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }

  .starting-style-compare-column {
    display: grid;
    gap: var(--ui-space-2);
    justify-items: stretch;
    margin: 0;
    min-inline-size: 0;

    & figcaption {
      font-size: var(--ui-font-size-small);

      & code {
        color: var(--ui-text-strong);
        font-weight: var(--ui-font-weight-bold);
      }
    }
  }

  .starting-style-compare-stage {
    background-image: radial-gradient(
      oklch(from var(--ui-text) l c h / 8%) 1.45px,
      transparent 1.45px
    );
    background-size: 20px 20px;
    block-size: 11rem;
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius);
    overflow: clip;
    position: relative;
  }

  .starting-style-compare-panel {
    --_ease: var(--ui-ease-exit);

    align-content: start;
    background-color: var(--ui-surface-raised);
    border-inline-end: var(--ui-border-width) solid var(--ui-border-color);
    box-shadow: var(--ui-shadow-overlay);
    color: var(--ui-text-strong);
    display: none;
    font-size: var(--ui-font-size-small);
    gap: var(--ui-space-2);
    inline-size: min(16rem, 75%);
    inset-block: 0;
    inset-inline-start: 0;
    padding: var(--ui-space-4);
    position: absolute;
    transition:
      display var(--_duration) allow-discrete,
      translate var(--_duration) var(--_ease);
    translate: -100% 0;

    &:dir(rtl) {
      translate: 100% 0;
    }

    & p {
      margin: 0;
    }

    .starting-style-compare:has(.starting-style-compare-switch :checked) & {
      --_ease: var(--ui-ease-enter);

      display: grid;
      translate: 0 0;
    }

    .starting-style-compare:has(.starting-style-compare-switch :checked)
      [data-mode="with"]
      & {
      @starting-style {
        translate: -100% 0;

        &:dir(rtl) {
          translate: 100% 0;
        }
      }
    }
  }

  .starting-style-compare-title {
    font-size: var(--ui-font-size-body);
    font-weight: var(--ui-font-weight-bold);
  }

  .starting-style-compare-knobs {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-4) var(--ui-space-6);

    & :global(.ui-field) {
      flex: 1 1 12rem;
      min-inline-size: 0;
    }

    & :global(.ui-switch) {
      white-space: nowrap;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>(".starting-style-compare")
    .forEach((compare) => {
      const input = compare.querySelector<HTMLInputElement>("input[type=range]")
      const output = compare.querySelector("output.ui-value")
      input?.addEventListener("input", () => {
        compare.style.setProperty("--_seconds", `${input.value}s`)
        if (output) output.textContent = `${Number(input.value).toFixed(1)}s`
      })
    })
</script>
