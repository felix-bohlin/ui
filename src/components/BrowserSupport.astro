---
import Baseline from "./Baseline.astro"
import BrowserSupportChips from "./BrowserSupportChips.astro"
import DocLink from "./DocLink.astro"
import { pageSources } from "../component-api/custom-properties"
import { withSharedFeatures } from "../utils/browser-support"
import { compatCss } from "../utils/compat"
import { components } from "../utils/components"
import { formatInline } from "../utils/format-inline"

type Props = {
  fallbacks?: Record<string, string>
  ids: string[]
}

const { fallbacks = {}, ids } = Astro.props
const { link } = Astro.locals
const fallbackIds = Object.keys(fallbacks).toSorted()
const sortedIds = [...ids].sort()
const name = components.find(
  (component) => component.slug === Astro.locals.componentSlug,
)?.name
const slug = Astro.locals.componentSlug ?? ""
const compat = [...new Set([slug, ...pageSources(slug)])]
  .map((name) => `${name}.css`)
  .filter((file) => compatCss[file])
  .toSorted()
const guideHref = name
  ? `/guide/browser-support?${new URLSearchParams({ components: name })}`
  : "/guide/browser-support"
const sharedHref = "/guide/browser-support#shared-features"
---

<section id="browser-support">
  <h2>Browser support</h2>
  <BrowserSupportChips ids={withSharedFeatures(sortedIds)} />
  {fallbackIds.length > 0 && <ul>
    {fallbackIds.map((id) => (
      <li set:html={formatInline(fallbacks[id], link)} />
    ))}
  </ul>}
  {sortedIds.length > 0 ? (
    <>
      <Baseline ids={sortedIds} />
      <p>
        Explore these features in the
        <DocLink href={guideHref}>browser support guide</DocLink>. The versions
        also count the <DocLink href={sharedHref}>shared features</DocLink>
        every component relies on.
      </p>
    </>
  ) : (
    <p>
      {name ?? "It"} uses only the
      <DocLink href={sharedHref}>shared features</DocLink> every component
      relies on.
    </p>
  )}
  {compat.length > 0 && <p>
    The <DocLink href="/guide/browser-support#compat">compat layer</DocLink
    >{" "} has fallbacks for it in{" "}
    {compat.map((file, index) => (
      <>
        {index > 0 && ", "}
        <code>css/compat/{file}</code>
      </>
    ))}
    .
  </p>}
</section>
