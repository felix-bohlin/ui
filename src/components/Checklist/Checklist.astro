    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
    margin-block-end: var(--size-3);
  }

  .checks-preview-open {
    font-size: var(--ui-font-size-small);
    margin-inline-start: auto;
  }

  .checks-preview-stage {
    background: repeating-linear-gradient(
      -45deg,
      oklch(from var(--ui-text) l c h / 6%) 0 6px,
      transparent 6px 12px
    );
    border-radius: var(--ui-radius);
    display: grid;
    justify-items: center;

    iframe {
      background-color: var(--ui-surface);
      block-size: min(75dvb, 760px);
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius);
      inline-size: 100%;

      @media (prefers-reduced-motion: no-preference) {
        transition: inline-size var(--ui-duration) var(--ui-ease);
      }
    }

    &[data-width="phone"] iframe {
      inline-size: min(100%, 390px);
    }

    &[data-width="tablet"] iframe {
      inline-size: min(100%, 768px);
    }
  }

  .checks-item {
    &[data-stage="done"] .review-toggle {
      color: var(--ui-text);
      font-weight: var(--ui-font-weight-normal);
    }

    & :global(.checks-changed) {
      display: none;
    }

    &[data-changed] :global(.checks-changed) {
      display: inline-flex;
    }

    &[data-stage="done"] :global(.checks-stage-tag) {
      display: none;
    }
  }

  .checks-new-list {
    display: grid;
    gap: var(--size-2);
    list-style: none;
    margin: 0;
    padding: 0;

    &:empty {
      display: none;
    }
  }

  .checks-new {
    align-items: center;
    background-color: oklch(from var(--ui-success) l c h / 8%);
    border: var(--ui-border-width) dashed
      oklch(from var(--ui-success) l c h / 50%);
    border-radius: var(--ui-radius);
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    padding: var(--size-2) var(--size-3);
  }

  .checks-new-text {
    flex: 1;
  }

  .checks-add {
    & :global(.checks-add-open) {
      color: var(--ui-text);
    }

    & :global(.checks-add-open[hidden]) {
      display: none;
    }
  }

  .checks-add-form {
    align-items: center;
    display: flex;
    gap: var(--size-2);

    &[hidden] {
      display: none;
    }

    & :global(.checks-add-field) {
      flex: 1;
    }
  }
</style>
