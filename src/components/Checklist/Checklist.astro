---
import {
  Accordion,
  AccordionContent,
  AccordionSummary,
  Button,
  Checkbox,
  Chip,
  Drawer,
  DrawerContent,
  DrawerFooter,
  DrawerHeader,
  DrawerTitle,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import ProgressCell from "../Review/ProgressCell.astro"
import ProgressMap from "../Review/ProgressMap.astro"
import "../Review/review.css"
import CommentField from "../Todo/CommentField.astro"
import CopyFallback from "../Todo/CopyFallback.astro"
import InlineText from "../Todo/InlineText.astro"
import TodoNotes from "../Todo/TodoNotes.astro"
import { parseChecklist, stages } from "../../utils/checklist"
import { plainText, replyOf } from "../../utils/todo"

type Props = {
  file: string
  previews?: boolean
  replies: string[]
  source: string
  storageKey: string
}

const { file, previews, replies, source, storageKey } = Astro.props

const widths = [
  { label: "Full", value: "full" },
  { label: "Tablet", value: "tablet" },
  { label: "Phone", value: "phone" },
]

const { intro, sections } = parseChecklist(source)
const items = sections.flatMap((section) => section.items)
const countOf = (stage: string) =>
  items.filter((item) => item.stage === stage).length
const doneIn = (list: typeof items) =>
  list.filter((item) => item.stage === "done").length
---

<div
  class="checks review"
  data-checklist-file={file}
  data-checklist-storage={storageKey}
>
  <ProgressMap
    class="review-map-inline"
    complete={["done"]}
    label="done"
    sections={sections}
  />

  {intro.map((paragraph) => <p class="review-intro">
    <InlineText links text={paragraph} />
  </p>)}

  <div class="review-toolbar ui-not-rich-text">
    <TextField
      class="review-search"
      for="checks-search"
      hideLabel
      label="Filter items"
      size="small"
    >
      <input
        autocomplete="off"
        id="checks-search"
        placeholder="Filter items"
        type="search"
      />
    </TextField>
    <ToggleGroup
      aria-label="Show items"
      class="review-stages"
      multiple
      name="checks-stage"
      overflow="scroll"
      size="small"
      value={stages.map((stage) => stage.value)}
    >
      {stages.map((stage) => <ToggleButton
        data-stage-filter={stage.value}
        value={stage.value}
      >
        <ProgressCell
          aria-hidden="true"
          class="review-swatch"
          stage={stage.value}
        />
        {stage.label}
        <span class="review-stage-count" data-stage-count={stage.value}
          >{countOf(stage.value)}</span
        >
      </ToggleButton>)}
    </ToggleGroup>
    <Button id="checks-expand" size="small" variant="transparent"
      >Expand all</Button
    >
  </div>

  <p class="review-shortcuts">
    <kbd>j</kbd>
    <kbd>k</kbd> next and previous, <kbd>x</kbd> check, <kbd>e</kbd> open,
    <kbd>c</kbd> comment, <kbd>1</kbd> to <kbd>{replies.length}</kbd> quick
    replies,{previews && <><kbd>p</kbd> preview,</>} <kbd>/</kbd> filter.
  </p>

  <div class="review-empty ui-not-rich-text" id="checks-empty" hidden>
    <p>Nothing matches the filter.</p>
    <Button id="checks-show-all" size="small" variant="outlined"
      >Show all</Button
    >
  </div>

  {sections.map((section) => <section
    class="review-section"
    data-check-section={section.title}
    id={section.id}
  >
    <h2>{section.title}</h2>
    <div class="review-section-meta ui-not-rich-text">
      <span
        aria-hidden="true"
        class="review-meter"
        data-section-meter
        style={`--ratio: ${doneIn(section.items) / section.items.length}`}
      ></span>
      <p data-section-progress>
        {`${doneIn(section.items)} of ${section.items.length} done`}
      </p>
    </div>
    <ol class="review-list ui-not-rich-text">
      {section.items.map((item) => <li
        class="checks-item review-item"
        data-check-done={item.status === "x" ? "" : undefined}
        data-check-key={item.key}
        data-check-line={item.line}
        data-check-reply={replyOf(item.notes).reply.join("\n") || undefined}
        data-open-stage={item.openStage}
        data-stage={item.stage}
        id={`check-${item.key}`}
      >
        <div class="review-row">
          <Checkbox class="checks-done review-control" hideLabel
            >{plainText(item.text)}</Checkbox
          >
          <div class="review-heading">
            <button
              aria-controls={`check-${item.key}-body`}
              aria-expanded="false"
              class="checks-toggle review-toggle"
              type="button"
            >
              <InlineText text={item.text} />
            </button>
            <p class="review-preview">
              {item.preview.label && <span
                class="review-preview-label"
                data-tone={item.preview.tone}
                >{item.preview.label}</span
              >}
              <InlineText text={item.preview.text} />
            </p>
            <p class="review-preview review-preview-answer">
              <span class="review-preview-label" data-tone="you">You</span>
              <span data-comment-preview></span>
            </p>
          </div>
          <div class="review-tags">
            {item.openStage === "doing" && (
              <Chip
                class="checks-stage-tag"
                dot
                label="In progress"
                severity="info"
                size="x-small"
                variant="tonal"
              />
            )}
            {item.openStage === "skipped" && (
              <Chip
                class="checks-stage-tag"
                label="Skipped"
                severity="neutral"
                size="x-small"
                variant="tonal"
              />
            )}
            <Chip
              class="checks-changed"
              label="Not in the file yet"
              size="x-small"
              variant="outlined"
            />
            <svg
              aria-hidden="true"
              class="review-chevron"
              height="20"
              viewBox="0 0 24 24"
              width="20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M6.22 8.97a.75.75 0 0 1 1.06 0L12 13.69l4.72-4.72a.75.75 0 1 1 1.06 1.06l-5.25 5.25a.75.75 0 0 1-1.06 0L6.22 10.03a.75.75 0 0 1 0-1.06"
                fill="currentColor"
              ></path>
            </svg>
          </div>
        </div>
        <div
          class="review-body"
          hidden="until-found"
          id={`check-${item.key}-body`}
        >
          <div class="review-body-content">
            <TodoNotes notes={item.notes} />
            {previews && item.pages.length > 0 && <Accordion
              class="checks-preview"
              variant="outlined"
            >
              <AccordionSummary>
                {item.pages.length === 1
                  ? `Preview: ${item.pages[0].label}`
                  : `Preview (${item.pages.length} pages)`}
              </AccordionSummary>
              <AccordionContent>
                <div class="checks-preview-bar">
                  {item.pages.length > 1 && <ToggleGroup
                    aria-label="Page"
                    class="checks-preview-pages"
                    name={`check-${item.key}-page`}
                    overflow="scroll"
                    size="x-small"
                    value={item.pages[0].href}
                  >
                    {item.pages.map((page) => <ToggleButton value={page.href}
                      >{page.label}</ToggleButton
                    >)}
                  </ToggleGroup>}
                  <ToggleGroup
                    aria-label="Preview width"
                    class="checks-preview-widths"
                    name={`check-${item.key}-width`}
                    size="x-small"
                    value="full"
                  >
                    {widths.map((width) => <ToggleButton value={width.value}
                      >{width.label}</ToggleButton
                    >)}
                  </ToggleGroup>
                  <a
                    class="ui-link checks-preview-open"
                    href={item.pages[0].href}
                    rel="noopener"
                    target="_blank"
                    >Open in a new tab</a
                  >
                </div>
                <div class="checks-preview-stage" data-width="full">
                  <iframe
                    data-src={item.pages[0].href}
                    title={`${item.pages[0].label} preview`}
                  ></iframe>
                </div>
              </AccordionContent>
            </Accordion>}
            <div class="review-reply">
              <div
                aria-label="Quick replies"
                class="review-buttons"
                role="group"
              >
                {replies.map((reply) => <Button
                  aria-pressed="false"
                  class="review-pressable"
                  data-quick-reply={reply}
                  size="x-small"
                  variant="outlined"
                  >{reply}</Button
                >)}
              </div>
              <CommentField text={item.text} />
            </div>
          </div>
        </div>
      </li>)}
    </ol>
    <ul class="checks-new-list ui-not-rich-text" data-check-new></ul>
    <div class="checks-add ui-not-rich-text">
      <Button
        class="checks-add-open"
        data-add-open
        size="small"
        variant="transparent"
      >
        <svg
          aria-hidden="true"
          height="20"
          viewBox="0 0 24 24"
          width="20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12 4.5a.75.75 0 0 1 .75.75v6h6a.75.75 0 0 1 0 1.5h-6v6a.75.75 0 0 1-1.5 0v-6h-6a.75.75 0 0 1 0-1.5h6v-6A.75.75 0 0 1 12 4.5"
            fill="currentColor"
          ></path>
        </svg>
        {`Add an item to ${section.title}`}
      </Button>
      <form class="checks-add-form" data-check-add hidden>
        <TextField
          class="checks-add-field"
          for={`${section.id}-new-item`}
          hideLabel
          label={`New item in ${section.title}`}
          size="small"
        >
          <input
            autocomplete="off"
            id={`${section.id}-new-item`}
            name="item"
            placeholder="What's missing?"
          />
        </TextField>
        <Button size="small" type="submit" variant="filled">Add</Button>
        <Button data-add-cancel size="small" variant="transparent"
          >Cancel</Button
        >
      </form>
    </div>
  </section>)}

  <template id="checks-new-template">
    <li class="checks-new">
      <Chip
        class="checks-new-label"
        label="New"
        severity="success"
        size="x-small"
        variant="tonal"
      />
      <span class="checks-new-text"></span>
      <Button class="checks-new-remove" size="x-small" variant="transparent"
        >Remove</Button
      >
    </li>
  </template>

  <div class="review-dock ui-not-rich-text">
    <p class="review-pending" id="checks-progress">
      <strong data-pending-count>No changes yet</strong>
      <span data-pending-detail
        >Check, reply or add items, then copy them for an agent.</span
      >
    </p>
    <p class="review-status" id="checks-status" role="status"></p>
    <div class="review-dock-actions">
      <Button
        command="show-modal"
        commandfor="checks-review"
        id="checks-review-open"
        size="small"
        variant="outlined"
        >Review</Button
      >
      <Button id="checks-copy" size="small" variant="filled"
        >Copy for an agent</Button
      >
    </div>
  </div>

  <Drawer id="checks-review" side="inline-end">
    <DrawerHeader>
      <DrawerTitle>Review changes</DrawerTitle>
    </DrawerHeader>
    <DrawerContent>
      <div class="review-drawer-content">
        <p>
          Paste this to an agent, which writes it into <code>{file}</code>.
          Until then, everything is saved in this browser.
        </p>
        <Checkbox checked id="checks-only-changed">
          Only what I changed, added or commented on
        </Checkbox>
        <pre
          class="review-copy-text ui-code-block"
          id="checks-review-text"
        ></pre>
        <p class="review-status" id="checks-review-status" role="status"></p>
        <div class="review-start-over">
          <p>Start over</p>
          <div class="review-buttons">
            <Button id="checks-clear-comments" size="small" variant="outlined"
              >Clear comments</Button
            >
            <Button id="checks-clear-new" size="small" variant="outlined"
              >Clear new items</Button
            >
            <Button
              color="critical"
              id="checks-reset"
              size="small"
              variant="outlined"
              >Reset checks</Button
            >
          </div>
        </div>
      </div>
    </DrawerContent>
    <DrawerFooter>
      <Button command="close" commandfor="checks-review">Close</Button>
      <Button id="checks-copy-review" variant="filled">Copy</Button>
    </DrawerFooter>
  </Drawer>

  <CopyFallback label="Changes and comments" />
</div>

<script>
  import {
    disclosure,
    highlightMatches,
    isTyping,
    plural,
    progressMaps,
    shortcutsOff,
    statusLines,
  } from "../Review/review"
  import { copyOrSelect, trackComments } from "../Todo/comments"
  import { readStored as read, writeStored as write } from "../../utils/storage"
  import { slugify } from "../../utils/todo"

  const root = document.querySelector<HTMLElement>("[data-checklist-file]")!
  const file = root.dataset.checklistFile!
  const prefix = root.dataset.checklistStorage!
  const addedKey = `${prefix}-added`
  const commentsKey = `${prefix}-comments`
  const doneKey = `${prefix}-done`
  const hideKey = `${prefix}-hide-done`
  const stagesKey = `${prefix}-stages`

  const items = [...root.querySelectorAll<HTMLElement>(".checks-item")]
  const sections = [
    ...root.querySelectorAll<HTMLElement>("[data-check-section]"),
  ]
  const keyOf = (item: HTMLElement) => item.dataset.checkKey!
  const lineOf = (item: HTMLElement) => item.dataset.checkLine!
  const titleOf = (section: HTMLElement) => section.dataset.checkSection!
  const itemsOf = (section: HTMLElement) =>
    items.filter((item) => section.contains(item))
  const doneInFile = (item: HTMLElement) => "checkDone" in item.dataset
  const doneOf = (item: HTMLElement) =>
    item.querySelector<HTMLInputElement>(".checks-done input")!
  const fieldOf = (item: HTMLElement) => item.querySelector("textarea")!
  const changed = (item: HTMLElement) =>
    doneOf(item).checked !== doneInFile(item)
  const stageOf = (item: HTMLElement) =>
    doneOf(item).checked ? "done" : item.dataset.openStage!

  const review = root.querySelector<HTMLDialogElement>("#checks-review")!
  const status = statusLines(
    [
      root.querySelector<HTMLElement>("#checks-status")!,
      root.querySelector<HTMLElement>("#checks-review-status")!,
    ],
    () => (review.open ? 1 : 0),
  )
  const copyFallback = root.querySelector<HTMLDialogElement>(
    "[data-copy-fallback]",
  )!
  const search = root.querySelector<HTMLInputElement>("#checks-search")!
  const stageInputs = [
    ...root.querySelectorAll<HTMLInputElement>(".review-stages input"),
  ]
  const expandAll = root.querySelector<HTMLButtonElement>("#checks-expand")!
  const empty = root.querySelector<HTMLElement>("#checks-empty")!
  const onlyChanged = root.querySelector<HTMLInputElement>(
    "#checks-only-changed",
  )!
  const reviewText = root.querySelector<HTMLElement>("#checks-review-text")!
  const pendingCount = root.querySelector("[data-pending-count]")!
  const pendingDetail = root.querySelector("[data-pending-detail]")!
  const template = root.querySelector<HTMLTemplateElement>(
    "#checks-new-template",
  )!
  const notSaved =
    "Changes can't be saved in this browser. Copy them before leaving the page."

  const added = read<Record<string, string[]>>(addedKey, {})
  const commentOf = (item: HTMLElement) => fieldOf(item).value.trim()

  const visibleItems = () => items.filter((item) => !item.hidden)
  const updateExpandAll = () => {
    const visible = visibleItems()
    expandAll.textContent =
      visible.length && visible.every((item) => panels.get(item)!.isOpen())
        ? "Collapse all"
        : "Expand all"
  }
  const panels = new Map(
    items.map((item) => [item, disclosure(item, () => updateExpandAll())]),
  )
  const toggleOf = (item: HTMLElement) => panels.get(item)!.toggle
  const setOpen = (item: HTMLElement, open: boolean) =>
    panels.get(item)!.setOpen(open)

  const maps = progressMaps((key) => {
    const item = items.find((item) => keyOf(item) === key)
    if (!item) return
    if (item.hidden) showAll()
    setOpen(item, true)
    item.scrollIntoView({ block: "start" })
    lastItem = item
    toggleOf(item).focus({ preventScroll: true })
  })

  const render = () => {
    for (const item of items) {
      const comment = commentOf(item)
      item.dataset.stage = stageOf(item)
      item.toggleAttribute("data-changed", changed(item))
      item.toggleAttribute("data-answered", Boolean(comment))
      item.toggleAttribute("data-marked", changed(item) || Boolean(comment))
      item.querySelector("[data-comment-preview]")!.textContent = comment
      for (const button of item.querySelectorAll<HTMLElement>(
        "[data-quick-reply]",
      )) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.quickReply === comment),
        )
      }
    }

    maps.update(
      items.map((item) => ({
        changed: changed(item) || Boolean(commentOf(item)),
        key: keyOf(item),
        stage: stageOf(item),
      })),
    )

    for (const section of sections) {
      const list = itemsOf(section)
      const sectionDone = list.filter((item) => doneOf(item).checked).length
      section
        .querySelector<HTMLElement>("[data-section-meter]")!
        .style.setProperty("--ratio", String(sectionDone / list.length))
      section.querySelector("[data-section-progress]")!.textContent =
        `${sectionDone} of ${list.length} done`
    }

    for (const input of stageInputs) {
      root.querySelector(`[data-stage-count="${input.value}"]`)!.textContent =
        String(items.filter((item) => stageOf(item) === input.value).length)
    }

    const checks = items.filter(changed).length
    const comments = items.filter(commentOf).length
    const newItems = Object.values(added).flat().length
    const total = checks + comments + newItems
    root.toggleAttribute("data-pending", total > 0)
    pendingCount.textContent = total
      ? `${plural(total, "change")} not in the file yet`
      : "No changes yet"
    pendingDetail.textContent = total
      ? [
          checks && plural(checks, "check"),
          comments && plural(comments, "comment"),
          newItems && plural(newItems, "new item"),
        ]
          .filter(Boolean)
          .join(", ")
      : "Check, reply or add items, then copy them for an agent."
  }

  const saveDone = () => {
    const overrides = Object.fromEntries(
      items.filter(changed).map((item) => [keyOf(item), doneOf(item).checked]),
    )
    if (!write(doneKey, overrides)) status.set(notSaved)
    render()
  }

  const savedDone = read<Record<string, boolean> | string[]>(doneKey, {})
  const overrides = Array.isArray(savedDone)
    ? Object.fromEntries(savedDone.map((key) => [key, true]))
    : savedDone

  for (const item of items) {
    const done = doneOf(item)
    done.checked = overrides[keyOf(item)] ?? doneInFile(item)
    done.addEventListener("change", saveDone)
  }

  const savedComments = read<Record<string, string>>(commentsKey, {})
  for (const item of items) {
    const reply = item.dataset.checkReply
    if (reply && savedComments[keyOf(item)]?.trim() === reply) {
      delete savedComments[keyOf(item)]
    }
  }
  write(commentsKey, savedComments)

  const comments = trackComments({
    items,
    keyOf,
    onError: () => status.set(notSaved),
    storageKey: commentsKey,
  })

  for (const item of items) {
    fieldOf(item).addEventListener("input", render)
  }

  expandAll.addEventListener("click", () => {
    const visible = visibleItems()
    const open = !visible.every((item) => panels.get(item)!.isOpen())
    for (const item of visible) setOpen(item, open)
  })

  const quickReply = (item: HTMLElement, reply: string) => {
    const field = fieldOf(item)
    const current = field.value.trim()
    const quick = [
      ...item.querySelectorAll<HTMLElement>("[data-quick-reply]"),
    ].map((button) => button.dataset.quickReply!)
    field.value =
      !current || quick.includes(current)
        ? current === reply
          ? ""
          : reply
        : `${current}\n${reply}`
    field.dispatchEvent(new Event("input", { bubbles: true }))
    comments.saveAll()
    status.set(
      `${field.value ? "Replied to" : "Removed the reply to"} ${toggleOf(item).textContent!.trim()}.`,
    )
  }

  for (const item of items) {
    for (const button of item.querySelectorAll<HTMLElement>(
      "[data-quick-reply]",
    )) {
      button.addEventListener("click", () =>
        quickReply(item, button.dataset.quickReply!),
      )
    }
  }

  const searchTexts = new Map(
    items.map((item) => [
      item,
      [
        toggleOf(item).textContent,
        item.querySelector(".todo-notes")?.textContent ?? "",
      ]
        .join(" ")
        .toLowerCase(),
    ]),
  )

  const shownStages = () =>
    new Set(
      stageInputs.filter((input) => input.checked).map((input) => input.value),
    )

  const applyFilter = () => {
    const query = search.value.trim().toLowerCase()
    const shown = shownStages()
    const everything = !query && shown.size === stageInputs.length
    for (const item of items) {
      item.hidden =
        !shown.has(stageOf(item)) ||
        Boolean(query && !searchTexts.get(item)!.includes(query))
    }
    for (const section of sections) {
      section.hidden =
        !everything && itemsOf(section).every((item) => item.hidden)
    }
    empty.hidden = sections.some((section) => !section.hidden)
    highlightMatches(
      visibleItems().flatMap((item) => [
        ...item.querySelectorAll(".review-toggle, .todo-notes"),
      ]),
      query,
    )
    updateExpandAll()
  }

  const showAll = () => {
    search.value = ""
    for (const input of stageInputs) input.checked = true
    write(stagesKey, [...shownStages()])
    applyFilter()
  }

  const savedStages = read<string[] | undefined>(stagesKey, undefined)
  const initialStages = new Set(
    savedStages ??
      stageInputs
        .map((input) => input.value)
        .filter((stage) => stage !== "done" || !read(hideKey, false)),
  )
  for (const input of stageInputs) {
    input.checked = initialStages.has(input.value)
    input.addEventListener("change", () => {
      write(stagesKey, [...shownStages()])
      applyFilter()
    })
  }

  search.addEventListener("input", applyFilter)
  root
    .querySelector("#checks-show-all")!
    .addEventListener("click", () => showAll())

  for (const section of sections) {
    const keys = new Set(itemsOf(section).map(keyOf))
    const kept = (added[titleOf(section)] ?? []).filter(
      (text) => !keys.has(slugify(text)),
    )
    if (kept.length) added[titleOf(section)] = kept
    else delete added[titleOf(section)]
  }

  const saveAdded = () => {
    if (!write(addedKey, added)) status.set(notSaved)
    render()
  }

  const renderAdded = (section: HTMLElement) => {
    const texts = added[titleOf(section)] ?? []
    section.querySelector("[data-check-new]")!.replaceChildren(
      ...texts.map((text, index) => {
        const row = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement
        row.querySelector(".checks-new-text")!.textContent = text
        const remove = row.querySelector("button")!
        remove.setAttribute("aria-label", `Remove ${text}`)
        remove.addEventListener("click", () => {
          texts.splice(index, 1)
          if (!texts.length) delete added[titleOf(section)]
          saveAdded()
          renderAdded(section)
          status.set(`Removed ${text}.`)
        })
        return row
      }),
    )
  }

  for (const section of sections) {
    renderAdded(section)
    const form = section.querySelector<HTMLFormElement>("[data-check-add]")!
    const open = section.querySelector<HTMLButtonElement>("[data-add-open]")!
    const field = form.querySelector("input")!
    const close = () => {
      form.hidden = true
      open.hidden = false
      field.value = ""
      open.focus()
    }
    open.addEventListener("click", () => {
      open.hidden = true
      form.hidden = false
      field.focus()
    })
    form
      .querySelector("[data-add-cancel]")!
      .addEventListener("click", () => close())
    field.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault()
        close()
      }
    })
    form.addEventListener("submit", (event) => {
      event.preventDefault()
      const text = field.value.trim().replace(/\s+/g, " ")
      if (!text) return
      added[titleOf(section)] = [...(added[titleOf(section)] ?? []), text]
      saveAdded()
      renderAdded(section)
      field.value = ""
      status.set(`Added ${text} to ${titleOf(section)}.`)
    })
  }
  saveAdded()

  const buildText = () => {
    const blocks: string[] = []
    let count = 0

    for (const section of sections) {
      const lines = itemsOf(section).flatMap((item) => {
        const comment = comments.commentOf(item)
        if (!comment && !changed(item) && onlyChanged.checked) return []
        if (comment || changed(item)) count++
        const line = lineOf(item).replace(
          /^- \[.?\]/,
          doneOf(item).checked ? "- [x]" : "- [ ]",
        )
        return [
          line,
          ...(comment
            ? comment.split("\n").map((text) => `  > ${text}`.trimEnd())
            : []),
        ]
      })
      const newItems = (added[titleOf(section)] ?? []).flatMap((text) => {
        count++
        return [`- [ ] ${text}`, "  > New item"]
      })
      if (lines.length || newItems.length) {
        blocks.push(`## ${titleOf(section)}`, "", ...lines, ...newItems, "")
      }
    }

    return {
      count,
      text: [`${file} with my comments`, "", ...blocks].join("\n").trim(),
    }
  }

  const updateReview = () => {
    status.clear()
    comments.saveAll()
    const { count, text } = buildText()
    reviewText.textContent =
      onlyChanged.checked && !count
        ? "Nothing changed, added or commented on yet."
        : text
  }

  root
    .querySelector("#checks-review-open")!
    .addEventListener("click", updateReview)
  onlyChanged.addEventListener("change", updateReview)

  const copy = async () => {
    comments.saveAll()
    const { count, text } = buildText()
    if (onlyChanged.checked && !count) {
      status.set("Nothing changed, added or commented on yet.")
      return
    }
    status.set(
      (await copyOrSelect(text, copyFallback))
        ? `Copied ${plural(count, "change")}. Paste them to an agent.`
        : "This browser blocked copying.",
    )
  }

  root.querySelector("#checks-copy")!.addEventListener("click", copy)
  root.querySelector("#checks-copy-review")!.addEventListener("click", copy)

  root
    .querySelector("#checks-clear-comments")!
    .addEventListener("click", () => {
      if (!confirm("Clear all comments?")) return
      comments.clear()
      render()
      updateReview()
      status.set("Comments cleared.")
    })

  root.querySelector("#checks-clear-new")!.addEventListener("click", () => {
    if (!confirm("Clear all new items?")) return
    for (const key of Object.keys(added)) delete added[key]
    saveAdded()
    sections.forEach(renderAdded)
    updateReview()
    status.set("New items cleared.")
  })

  root.querySelector("#checks-reset")!.addEventListener("click", () => {
    if (!confirm("Reset every check to the file?")) return
    for (const item of items) doneOf(item).checked = doneInFile(item)
    saveDone()
    updateReview()
    status.set("Checks reset to the file.")
  })

  let lastItem: HTMLElement | undefined

  const currentItem = () =>
    document.activeElement?.closest<HTMLElement>(".checks-item") ??
    (lastItem && !lastItem.hidden ? lastItem : undefined)

  const goTo = (item: HTMLElement | undefined) => {
    if (!item) return
    lastItem = item
    item.scrollIntoView({ block: "nearest" })
    toggleOf(item).focus({ preventScroll: true })
  }

  const step = (direction: 1 | -1) => {
    const visible = visibleItems()
    const current = currentItem()
    const index = current ? visible.indexOf(current) : -1
    goTo(
      visible[
        index < 0 ? (direction > 0 ? 0 : visible.length - 1) : index + direction
      ],
    )
  }

  document.addEventListener("keydown", (event) => {
    if (shortcutsOff(event)) return
    const target = event.target as HTMLElement
    if (isTyping(target)) {
      if (event.key === "Escape") {
        const item = target.closest<HTMLElement>(".checks-item")
        if (item) toggleOf(item).focus({ preventScroll: true })
        else if (target === search) search.blur()
      }
      return
    }
    const item = currentItem()
    const reply = /^[1-9]$/.test(event.key)
      ? item?.querySelectorAll<HTMLElement>("[data-quick-reply]")[
          Number(event.key) - 1
        ]
      : undefined
    if (event.key === "j") step(1)
    else if (event.key === "k") step(-1)
    else if (event.key === "/") search.focus()
    else if (event.key === "x" && item) doneOf(item).click()
    else if (event.key === "e" && item)
      setOpen(item, !panels.get(item)!.isOpen())
    else if (event.key === "c" && item) {
      setOpen(item, true)
      fieldOf(item).focus()
    } else if (reply && item) {
      setOpen(item, true)
      quickReply(item, reply.dataset.quickReply!)
    } else if (event.key === "p" && item?.querySelector(".checks-preview")) {
      setOpen(item, true)
      const preview = item.querySelector<HTMLDetailsElement>(".checks-preview")!
      preview.open = !preview.open
    } else return
    event.preventDefault()
  })

  for (const preview of root.querySelectorAll<HTMLDetailsElement>(
    ".checks-preview",
  )) {
    const frame = preview.querySelector("iframe")!
    const link = preview.querySelector<HTMLAnchorElement>(
      ".checks-preview-open",
    )!
    const stage = preview.querySelector<HTMLElement>(".checks-preview-stage")!
    preview.addEventListener("toggle", () => {
      if (preview.open && !frame.getAttribute("src"))
        frame.src = frame.dataset.src!
    })
    for (const input of preview.querySelectorAll<HTMLInputElement>(
      ".checks-preview-pages input",
    )) {
      input.addEventListener("change", () => {
        frame.dataset.src = input.value
        frame.src = input.value
        frame.title = `${input.closest("label")!.textContent!.trim()} preview`
        link.href = input.value
      })
    }
    for (const input of preview.querySelectorAll<HTMLInputElement>(
      ".checks-preview-widths input",
    )) {
      input.addEventListener("change", () => {
        stage.dataset.width = input.value
      })
    }
  }

  render()
  applyFilter()
</script>

