---
import { parseChecklist } from "../../utils/checklist"
import { plainText } from "../../utils/todo"

type Props = {
  class?: string
  source: string
}

const { class: className, source } = Astro.props

const { sections } = parseChecklist(source)
const items = sections.flatMap((section) => section.items)
const doneIn = (list: typeof items) =>
  list.filter((item) => item.stage === "done").length
const done = doneIn(items)
const ratio = items.length ? done / items.length : 0
---

<nav
  aria-label="Sections"
  class:list={["checks-map", className]}
  data-checks-map
  style={`--ratio: ${ratio}`}
>
  <div class="checks-map-total">
    <span aria-hidden="true" class="checks-ring">
      <span data-map-percent>{`${Math.round(ratio * 100)}%`}</span>
    </span>
    <p>
      <strong data-map-done>{done}</strong>
      {` of ${items.length} done`}
    </p>
  </div>
  <ol class="checks-map-sections">
    {sections.map((section) => <li>
      <a
        class="checks-map-section"
        data-map-section={section.id}
        data-map-complete={
          doneIn(section.items) === section.items.length ? "" : undefined
        }
        href={`#${section.id}`}
      >
        <span class="checks-map-title">{section.title}</span>
        <span aria-hidden="true" class="checks-map-count" data-map-count
          >{`${doneIn(section.items)}/${section.items.length}`}</span
        >
        <span class="ui-sr-only" data-map-count-text
          >{`, ${doneIn(section.items)} of ${section.items.length} done`}</span
        >
        <span aria-hidden="true" class="checks-map-cells">
          {section.items.map((item) => (
            <span
              class="checks-cell"
              data-map-key={item.key}
              data-stage={item.stage}
              title={plainText(item.text)}
            />
          ))}
        </span>
      </a>
    </li>)}
  </ol>
</nav>

<style>
  @property --ratio {
    inherits: true;
    initial-value: 0;
    syntax: "<number>";
  }

  .checks-map {
    --_track: oklch(from var(--ui-text-strong) l c h / 12%);

    display: grid;
    font-size: var(--ui-font-size-small);
    gap: var(--size-4);

    @media (prefers-reduced-motion: no-preference) {
      transition: --ratio var(--ui-duration-slow) var(--ui-ease);
    }
  }

  .checks-map-total {
    align-items: center;
    display: flex;
    gap: var(--size-3);

    p {
      color: var(--ui-text);
      line-height: var(--ui-line-height-tight);
      margin: 0;
    }

    strong {
      color: var(--ui-text-strong);
      display: block;
      font-size: var(--ui-font-size-large);
    }
  }

  .checks-ring {
    aspect-ratio: 1;
    background: conic-gradient(
      var(--ui-success) calc(var(--ratio) * 1turn),
      var(--_track) 0
    );
    border-radius: var(--ui-radius-round);
    display: grid;
    flex: none;
    inline-size: var(--size-10);
    place-items: center;

    span {
      align-items: center;
      aspect-ratio: 1;
      background-color: var(--ui-surface-filled);
      border-radius: var(--ui-radius-round);
      color: var(--ui-text-strong);
      display: flex;
      font-size: var(--ui-font-size-body);
      font-variant-numeric: tabular-nums;
      font-weight: var(--ui-font-weight-bold);
      inline-size: calc(100% - var(--size-3));
      justify-content: center;
    }
  }

  .checks-map-sections {
    display: grid;
    gap: var(--size-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .checks-map-section {
    border-radius: var(--ui-radius);
    color: var(--ui-text);
    column-gap: var(--size-2);
    display: grid;
    grid-template-columns: 1fr auto;
    margin-inline: calc(var(--size-2) * -1);
    padding: var(--size-1) var(--size-2);
    row-gap: var(--size-1);
    text-decoration: none;

    &:hover {
      background-color: oklch(from var(--ui-text-strong) l c h / 6%);
      color: var(--ui-text-strong);
    }

    &:focus-visible {
      outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
        var(--ui-focus-ring-color);
      outline-offset: 0;
    }

    &[aria-current] {
      background-color: var(--ui-primary-tonal);
      color: var(--ui-on-primary-tonal);
    }
  }

  .checks-map-title {
    font-weight: var(--ui-font-weight-medium);
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    [data-map-complete] > &::before {
      color: var(--ui-success-text);
      content: "\2713\00a0" / "";
    }
  }

  .checks-map-count {
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
  }

  .checks-map-cells {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    grid-column: 1 / -1;
  }

  .checks-cell {
    --_fill: transparent;

    aspect-ratio: 1;
    background: var(--_fill);
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px
      var(--_edge, oklch(from var(--ui-text) l c h / 45%));
    cursor: pointer;
    inline-size: 10px;

    @media (prefers-reduced-motion: no-preference) {
      transition: background var(--ui-duration) var(--ui-ease);
    }

    &[data-stage="doing"] {
      --_edge: var(--ui-info);
      --_fill: linear-gradient(
        to top,
        var(--ui-info) 50%,
        oklch(from var(--ui-info) l c h / 25%) 50%
      );
    }

    &[data-stage="done"] {
      --_edge: var(--ui-success);
      --_fill: var(--ui-success);
    }

    &[data-stage="skipped"] {
      --_fill: repeating-linear-gradient(
        -45deg,
        oklch(from var(--ui-text) l c h / 45%) 0 1px,
        transparent 1px 3px
      );
    }

    &[data-changed] {
      outline: 2px solid var(--ui-primary);
      outline-offset: 1px;
    }

    &[data-pop] {
      @media (prefers-reduced-motion: no-preference) {
        animation: checks-pop var(--ui-duration-slow) var(--ui-ease-enter);
      }
    }
  }

  @keyframes checks-pop {
    50% {
      scale: 1.8;
    }
  }
</style>
