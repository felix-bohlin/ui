---
import { Chip } from "opui-css/astro"
import { getBaselineMappings } from "../utils/baseline"

const { featureToComponents } = await getBaselineMappings()
const features = Object.keys(featureToComponents).sort()
---

<div class="chip-rain" aria-hidden="true" hidden>
  {features.map((id) => <Chip class="raindrop" label={id} size="small" />)}
</div>

<script>
  const STORAGE_KEY = "opui-chip-rain-seen"
  const LANE_WIDTH = 72
  const CHIP_WIDTH = 140
  const MAX_LEVEL = 3
  const MAX_LEVEL_NARROW = 2

  function startRain() {
    const rain = document.querySelector<HTMLElement>(".chip-rain")
    if (!rain) return

    try {
      if (localStorage.getItem(STORAGE_KEY)) return
      localStorage.setItem(STORAGE_KEY, "1")
    } catch (_) {
      return
    }

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return

    rain.hidden = false
    rain.style.setProperty("--fall", `${rain.clientHeight}px`)

    const lanes = Math.max(
      1,
      Math.floor((rain.clientWidth - CHIP_WIDTH) / LANE_WIDTH),
    )
    const maxLevel = rain.clientWidth < 600 ? MAX_LEVEL_NARROW : MAX_LEVEL
    const levels = Array.from({ length: lanes }, () => 0)

    rain.querySelectorAll<HTMLElement>(".raindrop").forEach((drop) => {
      const lane = Math.floor(((Math.random() + Math.random()) / 2) * lanes)
      const level = levels[lane]
      if (level >= maxLevel) {
        drop.remove()
        return
      }
      levels[lane] = level + 1
      drop.style.setProperty("--delay", `${level * 1.8 + Math.random() * 1.2}s`)
      drop.style.setProperty("--level", String(level))
      drop.style.setProperty("--rest", `${Math.random() * 16 - 8}deg`)
      drop.style.setProperty("--rotate", `${Math.random() * 90 - 45}deg`)
      drop.style.setProperty("--ui-duration", `${1.2 + Math.random() * 0.6}s`)
      drop.style.setProperty("--x", `${(lane + Math.random()) * LANE_WIDTH}px`)
    })
  }

  startRain()
</script>

<style>
  .chip-rain {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 1;

    &[hidden] {
      display: none;
    }
  }

  .raindrop {
    animation: chip-fall var(--ui-duration) var(--ease-bounce-2) var(--delay)
      both;
    box-shadow: var(--shadow-2);
    inset-block-end: calc(var(--level) * var(--ui-chip-size-small) * 0.85);
    inset-inline-start: var(--x);
    position: absolute;
  }

  @keyframes chip-fall {
    from {
      transform: translateY(calc(-1 * var(--fall) - 100%)) rotate(var(--rotate));
    }

    to {
      transform: translateY(0) rotate(var(--rest));
    }
  }
</style>
