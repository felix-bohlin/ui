---
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"

type Props = {
  componentDefault?: "any" | "closerequest" | "none"
  name: string
}

const { componentDefault, name } = Astro.props

const isHtml = Astro.locals.framework === "html"
const defaultValue = isHtml ? undefined : componentDefault

const rows = [
  {
    description: `A click outside the ${name}, <kbd>Esc</kbd> or the platform's close request (like the back gesture on mobile), and your own close button.`,
    value: "any",
  },
  {
    description: `<kbd>Esc</kbd> or the platform's close request, and your own close button. A click outside does nothing.`,
    value: "closerequest",
  },
  {
    description: `Only your own close button (<code>command="close"</code>), <code>close()</code> or a form with <code>method="dialog"</code>.`,
    value: "none",
  },
]
---

<p>
  {
    isHtml ? (
      <>
        Set <code>closedby</code> on the <code>&lt;dialog&gt;</code> to choose
        how the {name} can be closed.
      </>
    ) : (
      <>
        Use the <code>closedby</code> prop to choose how the {name} can be
        closed.
      </>
    )
  }
</p>
<Table style="table-layout: fixed">
  <TableColumnGroup>
    <TableColumn width="30%" />
    <TableColumn />
  </TableColumnGroup>
  <TableHead>
    <TableRow>
      <TableHeaderCell>Value</TableHeaderCell>
      <TableHeaderCell>Closes with</TableHeaderCell>
    </TableRow>
  </TableHead>
  <TableBody>
    {
      rows.map((row) => (
        <TableRow>
          <TableCell>
            <code>closedby="{row.value}"</code>
            {row.value === defaultValue && " (default)"}
          </TableCell>
          <TableCell>
            <Fragment set:html={row.description} />
          </TableCell>
        </TableRow>
      ))
    }
  </TableBody>
</Table>
<p>
  {
    defaultValue ? (
      <>
        The {name} sets <code>closedby="{defaultValue}"</code> when you leave it
        out.
      </>
    ) : (
      <>
        Without <code>closedby</code>, the browser picks: a modal {name}, opened
        with <code>command="show-modal"</code> or <code>showModal()</code>, acts
        like <code>closerequest</code>, and a non-modal one like{" "}
        <code>none</code>.
      </>
    )
  }
</p>
