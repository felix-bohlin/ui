---
import { Button, Copy } from "opui-css/astro"
import "../styles/syntax.css"

type Props = {
  code: string
  lang?: string
}

const { code, lang = "" } = Astro.props

const DIFF_MARKERS: Record<string, string> = { "+": "ins", "-": "del" }
const FILE_NAME_COMMENT =
  /^\s*(?:\/\/|#|\/\*|<!--)\s*([\w@./+-]+\.\w+)\s*(?:\*\/|-->)?\s*$/
const TERMINAL_LANGS = ["bash", "sh", "shell", "zsh"]

const isDiff = lang === "diff"
const language = lang && !["diff", "text"].includes(lang) ? lang : undefined
const lines = code
  .replace(/^\s*\n/, "")
  .trimEnd()
  .replaceAll("\t", "  ")
  .split("\n")
const titleIndex = lines
  .slice(0, 4)
  .findIndex((line) => FILE_NAME_COMMENT.test(line))
const title =
  titleIndex === -1 ? undefined : lines[titleIndex].match(FILE_NAME_COMMENT)![1]
if (titleIndex !== -1) {
  lines.splice(titleIndex, lines[titleIndex + 1]?.trim() ? 1 : 2)
}
const source = lines.join("\n")
const isTerminal = !title && TERMINAL_LANGS.includes(lang)

const escape = (text: string) =>
  text.replace(/[&<>]/g, (char) => `&#${char.charCodeAt(0)};`)
const diffCode = lines.map((line) =>
  /^[+\- ]/.test(line) ? line.slice(1) : line,
)
const diffIndent = Math.min(
  ...diffCode
    .filter((line) => line.trim())
    .map((line) => line.match(/^ */)![0].length),
)
const html = isDiff
  ? lines
      .map((line, index) => {
        const type = DIFF_MARKERS[line[0]]
        const text = escape(diffCode[index].slice(diffIndent))
        const end = index < lines.length - 1 ? "\n" : ""
        return `<span class="diff-line"${type ? ` data-diff="${type}"` : ""}${type === "del" ? " data-copy-ignore" : ""}>${text}${end}</span>`
      })
      .join("")
  : escape(source)
const codeClass = language && `language-${language}`
const preClass = isDiff ? "is-diff" : undefined
const id = Astro.locals.$id("code")
---

<div
  class:list={["code-block", { "is-terminal": isTerminal }]}
  data-language={lang || undefined}
>
  {(title || isTerminal) && <div class="code-header">
    {title && <span class="code-title">{title}</span>}
  </div>}
  <Copy id={id}>
    <pre class={preClass}><code class={codeClass} set:html={html} /></pre>
    <Button
      aria-label="Copy to clipboard"
      class="code-copy"
      command="--copy"
      commandfor={id}
      size="small"
      variant="tonal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
      >
        <path d="M3 19a2 2 0 0 1-1-2V2a2 2 0 0 1 1-1h13a2 2 0 0 1 2 1"></path>
        <rect x="6" y="5" width="16" height="18" rx="1.5" ry="1.5"></rect>
      </svg>
    </Button>
  </Copy>
</div>

<style>
  .code-block {
    --syntax-background: light-dark(oklch(1 0 0), oklch(0.235 0 0));
    --syntax-border: light-dark(oklch(0.885 0 0), oklch(0.297 0 0));
    --syntax-foreground: light-dark(oklch(0 0 0), oklch(0.87 0 0));
    --syntax-radius: calc(0.3rem + 1.5px);

    border-radius: var(--syntax-radius);
    box-shadow: 0.1rem 0.1rem 0.2rem
      light-dark(oklch(0 0 0 / 0.157), oklch(0 0 0 / 0.357));
    display: grid;
    grid-template-areas: "header" "code";
    grid-template-columns: minmax(0, 1fr);

    pre {
      background: var(--syntax-background);
      border: 1.5px solid var(--syntax-border);
      border-radius: var(--syntax-radius);
      color: var(--syntax-foreground);
      grid-area: code;
      margin: 0;
      overflow-x: auto;
      padding: 1rem 1.35rem;

      &:focus-visible {
        outline-offset: var(--ui-focus-ring-inset);
      }
    }

    code {
      background: none;
      border: none;
      color: inherit;
      display: block;
      font-family:
        ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
        "Liberation Mono", "Courier New", monospace;
      font-size: 0.85rem;
      line-height: 1.65;
      padding: 0;
      white-space: pre;
    }

    .is-diff {
      padding-inline: 0;

      code {
        display: grid;
        grid-template-columns: minmax(100%, max-content);
      }
    }

    &:has(.code-header) pre {
      border-block-start: none;
      border-start-end-radius: 0;
      border-start-start-radius: 0;
    }
  }

  .code-block :global(.diff-line) {
    border-inline-start: 0.15rem solid transparent;
    padding-inline: calc(1.35rem - 0.15rem) 1.35rem;
    position: relative;

    &[data-diff]::before {
      inset-inline-start: 0.3rem;
      position: absolute;
    }

    &[data-diff="ins"] {
      background: light-dark(
        oklch(0.775 0.105 138 / 0.5),
        oklch(0.405 0.103 140.4 / 0.5)
      );
      border-inline-start-color: oklch(0.543 0.104 139 / 0.816);

      &::before {
        color: light-dark(
          oklch(0.472 0.102 140 / 0.816),
          oklch(0.706 0.105 139 / 0.816)
        );
        content: "+";
      }
    }

    &[data-diff="del"] {
      background: light-dark(
        oklch(0.797 0.115 29 / 0.5),
        oklch(0.427 0.111 28 / 0.5)
      );
      border-inline-start-color: oklch(0.564 0.113 28 / 0.816);

      &::before {
        color: light-dark(
          oklch(0.495 0.1119 28 / 0.816),
          oklch(0.728 0.115 28 / 0.816)
        );
        content: "-";
      }
    }
  }

  .code-header {
    background: light-dark(oklch(0.964 0 0), oklch(0.265 0.002 287));
    border: 1.5px solid var(--syntax-border);
    border-block-end: none;
    border-start-end-radius: var(--syntax-radius);
    border-start-start-radius: var(--syntax-radius);
    display: flex;
    font-size: 0.9rem;
    grid-area: header;
    line-height: 1.65;

    .is-terminal & {
      align-items: center;
      background: light-dark(oklch(0.898 0 0), oklch(0.356 0 0));
      border-block-end: 1.5px solid var(--syntax-border);
      min-block-size: calc(0.9rem * 1.65 + 0.5rem + 1.5px);
      padding-inline: 1rem;

      &::before {
        background-color: light-dark(oklch(0.32 0 0), oklch(0.845 0 0));
        block-size: 0.56rem;
        content: "";
        inline-size: 2.1rem;
        mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2060%2016'%20preserveAspectRatio%3D'xMidYMid%20meet'%3E%3Ccircle%20cx%3D'8'%20cy%3D'8'%20r%3D'8'%2F%3E%3Ccircle%20cx%3D'30'%20cy%3D'8'%20r%3D'8'%2F%3E%3Ccircle%20cx%3D'52'%20cy%3D'8'%20r%3D'8'%2F%3E%3C%2Fsvg%3E");
        mask-repeat: no-repeat;
        opacity: 0.15;
      }
    }
  }

  .code-title {
    background: var(--syntax-background);
    border-start-end-radius: var(--syntax-radius);
    border-start-start-radius: var(--syntax-radius);
    color: light-dark(oklch(0.32 0 0), oklch(1 0 0));
    padding: calc(0.25rem + 1.5px) 1rem;
  }

  .code-copy {
    align-self: start;
    grid-area: code;
    justify-self: end;
    margin: calc(1.5px + 0.4rem) calc(1.5px + 0.5rem);
    opacity: 0.75;
    transition: opacity 0.2s;

    &:hover,
    &:focus-visible {
      opacity: 1;
    }

    @media (hover: hover) {
      &:not(:hover, :focus-visible) {
        opacity: 0;

        .code-block:is(:hover, :focus-within) & {
          opacity: 0.75;
        }
      }
    }
  }
</style>

<script>
  import "../utils/code-blocks"
</script>
