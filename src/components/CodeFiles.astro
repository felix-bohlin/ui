---
import Code from "./Code.astro"
import type { Tab } from "./Installation.astro"
import { Select } from "opui-css/astro"

type Props = {
  files: Tab[]
  title: string
}

const { files, title } = Astro.props
---

<div class="code-files">
  {files.length > 1 && <div class="file-bar">
    <Select aria-label={`${title} file`} class="file-picker" size="small">
      {files.map((file, index) => <option value={index}>{file.title}</option>)}
    </Select>
  </div>}
  {files.map((file, index) => <div class="file" hidden={index > 0}>
    <Code code={file.code} lang={file.lang} />
  </div>)}
</div>

<style>
  .file-bar {
    align-items: center;
    border-block-end: 1px solid var(--ui-border-color);
    display: flex;
    gap: var(--ui-space-2);
    padding: var(--ui-space-2) var(--ui-space-3);
  }

  .file :global(.code-block pre) {
    border-radius: 0;
  }

  .file-picker {
    min-inline-size: 0;
  }
</style>

<script>
  document.addEventListener("change", (event) => {
    const select = (event.target as Element).closest<HTMLSelectElement>(
      ".file-picker select",
    )
    const files = select?.closest(".code-files")
    if (!select || !files) return
    files
      .querySelectorAll<HTMLElement>(":scope > .file")
      .forEach((file, index) => {
        file.hidden = index !== Number(select.value)
      })
  })
</script>
