---
import Code from "./Code.astro"
import type { Tab } from "./Installation.astro"
import { Field, SelectButton } from "opui-css/astro"

type Props = {
  files: Tab[]
  title: string
}

const { files, title } = Astro.props
const fileId = Astro.locals.$id("code-file")
---

<div class="code-files">
  <div class="file-bar">
    {files.length > 1 ? (
      <Field class="file-picker" for={fileId} size="small">
        <select aria-label={`${title} file`} id={fileId}>
          <SelectButton />
          {files.map((file, index) => <option value={index}>
            {file.title}
          </option>)}
        </select>
      </Field>
    ) : (
      <code class="file-name">{files[0].title}</code>
    )}
  </div>
  {files.map((file, index) => <div class="file" hidden={index > 0}>
    <Code code={file.code} lang={file.lang} />
  </div>)}
</div>

<style>
  .file-bar {
    align-items: center;
    border-block-end: 1px solid var(--ui-border-color);
    display: flex;
    gap: var(--ui-space-2);
    padding: var(--ui-space-2) var(--ui-space-4);
  }

  .file :global(.code-block pre) {
    border-radius: 0;
  }

  .file-name {
    align-content: center;
    font-family: var(--ui-font-code);
    font-size: var(--ui-font-size-small);
    min-block-size: var(--ui-control-size-small);
  }

  .file-picker {
    min-inline-size: 0;
  }
</style>

<script>
  document.addEventListener("change", (event) => {
    const select = (event.target as Element).closest<HTMLSelectElement>(
      ".file-picker select",
    )
    const files = select?.closest(".code-files")
    if (!select || !files) return
    files
      .querySelectorAll<HTMLElement>(":scope > .file")
      .forEach((file, index) => {
        file.hidden = index !== Number(select.value)
      })
  })
</script>
