---
import { Code } from "astro-expressive-code/components"
import { Tabs } from "@opui/astro"

type Tab = {
  title: string
  code?: string
  lang?: string
}

type Props = {
  tabs: Tab[]
}

const { tabs } = Astro.props
---

<div class="code-group ui-card ui-outlined ui-not-rich-text">
  <Tabs variant="line" class="code-tabs">
    {
      tabs.map((tab, index) => (
        <Tabs.Item open={index === 0}>
          <Tabs.Tab>{tab.title}</Tabs.Tab>
          <Tabs.Panel>
            {tab.code && <Code code={tab.code} lang={tab.lang} />}
          </Tabs.Panel>
        </Tabs.Item>
      ))
    }
  </Tabs>
</div>

<style>
  .code-group {
    gap: 0;
    margin-block: var(--size-4);
    overflow: hidden;
    padding: 0;
  }
</style>

<style is:global>
  .ui-tab-panel {
    * {
      isolation: isolate;
    }

    .expressive-code .frame .header {
      border-radius: 0;
    }
  }
</style>
