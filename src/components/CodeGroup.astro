---
import Code from "./Code.astro"
import { Tabs, TabsItem, TabsLabel, TabsPanel } from "opui-css/astro"

type Tab = {
  title: string
  code?: string
  lang?: string
}

type Props = {
  class?: string
  tabs: Tab[]
}

const { class: className, tabs } = Astro.props
---

<div
  class:list={["code-group ui-card ui-outlined ui-not-rich-text", className]}
>
  <Tabs class="code-tabs" overflow="wrap" variant="line">
    {tabs.map((tab, index) => <TabsItem checked={index === 0}>
      <TabsLabel>{tab.title}</TabsLabel>
      <TabsPanel>
        {tab.code && <Code code={tab.code} lang={tab.lang} />}
      </TabsPanel>
    </TabsItem>)}
  </Tabs>
</div>

<style>
  .code-group {
    gap: 0;
    margin-block: var(--size-4);
    overflow: hidden;
    padding: 0;
  }
</style>

<style is:global>
  .ui-panel {
    * {
      isolation: isolate;
    }

    .code-block .code-header {
      border-radius: 0;
    }
  }
</style>
