---
import ApiTables from "./ApiTables.astro"
import type { AstroInstance } from "astro"
import type { ComponentApi } from "../component-api/types"
import {
  DEFAULT_FRAMEWORK,
  FRAMEWORKS,
  FRAMEWORK_IDS,
  type FrameworkId,
} from "../utils/framework"

export type FrameworkApis = Partial<
  Record<FrameworkId, AstroInstance["default"]>
>

export type ApiEntry =
  FrameworkApis | { api: ComponentApi; id?: string; title?: string }

export type Apis = ApiEntry | ApiEntry[]

type Props = {
  apis?: Apis
  title?: string
  hideTitle?: boolean
}

const { apis, title: titleProp, hideTitle = false } = Astro.props

const apiList = Array.isArray(apis) ? apis : apis ? [apis] : []

const currentFramework = Astro.locals.framework

const isFrameworkKeyedApi = (value: ApiEntry): value is FrameworkApis =>
  !("api" in value) &&
  Object.keys(value).length > 0 &&
  Object.keys(value).every((k) => FRAMEWORK_IDS.includes(k as FrameworkId))

// Pick the framework-keyed API entry for the active framework, falling back
// to the default framework, then the first authored variant - same fallback
// shape `<Conditional>` uses so partially-authored docs don't go blank.
const pickFrameworkVariant = (value: FrameworkApis) =>
  value[currentFramework] ??
  value[DEFAULT_FRAMEWORK] ??
  FRAMEWORKS.map((f) => value[f.id]).find(Boolean)

const hasFrameworkSpecificApi =
  !!apis && !Array.isArray(apis) && isFrameworkKeyedApi(apis)
---

{
  hasFrameworkSpecificApi
    ? (() => {
        const ApiComponent = pickFrameworkVariant(apis as FrameworkApis)
        return (
          ApiComponent && (
            <section>
              {!hideTitle && <h2 id="api">{titleProp || "API"}</h2>}
              <div class="api-table-container">
                <ApiComponent />
              </div>
            </section>
          )
        )
      })()
    : apiList.length > 0 && (
        <section>
          {!hideTitle && <h2 id="api">{titleProp || "API"}</h2>}
          {apiList.map((api) => {
            if (isFrameworkKeyedApi(api)) {
              const ApiComponent = pickFrameworkVariant(api)
              return (
                ApiComponent && (
                  <div class="api-table-container">
                    <ApiComponent />
                  </div>
                )
              )
            }
            const title = api.title
            const id =
              api.id ||
              (title ? title.toLowerCase().replace(/\s+/g, "-") : undefined)

            return (
              <Fragment>
                {title && <h3 id={id}>{title}</h3>}
                <ApiTables api={api.api} headingLevel={title ? 4 : 3} />
              </Fragment>
            )
          })}
        </section>
      )
}

<style>
  .api-table-container {
    margin-block-end: var(--size-4);
    overflow-x: auto;
  }

  .api-table-container :global(table),
  .api-table-container :global(.api-table) {
    display: table;
    margin: 0;
    min-width: 700px;
    table-layout: fixed;
    width: 100%;
  }
</style>
