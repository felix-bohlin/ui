---
import ComponentShowcase from "./ComponentShowcase/ComponentShowcase.astro"
import { componentsFor } from "../utils/components"
import { added, isWhatsNewHighlighted } from "../utils/whats-new"

const currentFramework = Astro.locals.framework

const sectionOf = (slug: string) =>
  !isWhatsNewHighlighted(currentFramework, slug)
    ? "other"
    : added.has(slug)
      ? "new"
      : "updated"

const sections = [
  { id: "new", label: "New components" },
  { id: "updated", label: "Updated components" },
  { id: "other", label: "Other components" },
]
  .map((section) => ({
    ...section,
    components: componentsFor(currentFramework).filter(
      ({ slug }) => sectionOf(slug) === section.id,
    ),
  }))
  .filter((section) => section.components.length > 0)
---

{sections.map((section) => <section
  id={sections.length > 1 ? `${section.id}-components` : undefined}
>
  {sections.length > 1 && <h2>{section.label}</h2>}
  <div class="is-wide">
    <ComponentShowcase
      label={section.label}
      slugs={section.components.map(({ slug }) => slug)}
      wrap
    />
  </div>
</section>)}

<style>
  section {
    margin-block-start: var(--size-8);
  }
</style>
