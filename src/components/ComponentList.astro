---
import { componentsFor, componentHrefFor } from "../utils/components"
import { added, isWhatsNewHighlighted } from "../utils/whats-new"

const currentFramework = Astro.locals.framework

const sectionOf = (slug: string) =>
  !isWhatsNewHighlighted(currentFramework, slug)
    ? "other"
    : added.has(slug)
      ? "new"
      : "updated"

const sections = [
  { id: "new", label: "New components" },
  { id: "updated", label: "Updated components" },
  { id: "other", label: "Other components" },
]
  .map((section) => ({
    ...section,
    components: componentsFor(currentFramework).filter(
      ({ slug }) => sectionOf(slug) === section.id,
    ),
  }))
  .filter((section) => section.components.length > 0)
---

{
  sections.map((section) => (
    <section>
      {sections.length > 1 && (
        <h2 id={`${section.id}-components`}>{section.label}</h2>
      )}
      <ul class="card-grid">
        {section.components.map((component) => (
          <li>
            <a
              class="ui-card ui-outlined"
              href={componentHrefFor(currentFramework, component.slug)}
            >
              <div class="ui-content">
                <p>{component.name}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  section {
    margin-block-start: var(--size-8);
  }

  .card-grid {
    align-items: stretch;
    display: grid;
    gap: var(--size-3);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    list-style-type: none;
    margin-block-start: var(--size-3);
    padding: 0;

    .ui-card {
      color: inherit;
      display: block;
      text-decoration: none;

      &:hover {
        p {
          text-decoration: underline;
        }
      }

      .ui-content {
        align-items: center;
        display: flex;
        justify-content: space-between;

        p {
          font-weight: 600;
          margin: 0;
        }
      }
    }
  }
</style>
