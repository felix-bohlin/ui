---
import { components } from "../../utils/components"
import ComponentCard from "./ComponentCard.astro"
import ComponentPreview from "./ComponentPreview.astro"
---

{
  components.map((component) => (
    <ComponentCard href={component.href} name={component.name}>
      <ComponentPreview slug={component.slug} />
    </ComponentCard>
  ))
}

<style is:global>
  .component-showcase {
    display: grid;
    gap: var(--size-3);
    grid-auto-rows: minmax(180px, auto);
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
  }

  @media (width <= 600px) {
    .component-showcase {
      grid-auto-rows: minmax(140px, auto);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script is:inline>
  ;(function () {
    const themeSwitcher = document.getElementById("showcase-theme-switcher")

    if (themeSwitcher) {
      const syncTheme = () => {
        themeSwitcher.checked =
          document.documentElement.classList.contains("ui-dark")
      }

      syncTheme()

      themeSwitcher.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("ui-dark")
        const newTheme = isDark ? "light" : "dark"
        window.themeUtils.setTheme(newTheme)
        syncTheme()
      })

      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (
            mutation.type === "attributes" &&
            mutation.attributeName === "class"
          ) {
            syncTheme()
          }
        })
      })

      observer.observe(document.documentElement, { attributes: true })
    }
  })()
</script>
