---
import {
  Accordion,
  Anchor,
  Avatar,
  Badge,
  Button,
  ButtonGroup,
  Callout,
  Card,
  Carousel,
  Checkbox,
  Chip,
  DescriptionList,
  Divider,
  FieldDescription,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Form,
  List,
  ListItem,
  Message,
  Messages,
  Progress,
  Radio,
  Range,
  Rating,
  Select,
  Switch,
  Table,
  Tabs,
  TextField,
  Textarea,
  Timeline,
  ToggleButton,
  ToggleGroup,
} from "@opui/astro"
import ComponentCard from "./ComponentCard.astro"
import FrameworkPicker from "../FrameworkPicker.astro"
---

<div class="component-showcase component-showcase--hero">
  <div class="component-showcase__intro">
    <slot />
  </div>

  <ComponentCard name="Accordion" href="/components/accordion" size="wide">
    <Accordion aria-hidden="true" inert variant="outlined">
      <Fragment slot="summary">How does it work?</Fragment>
      It's pretty simple, actually.
    </Accordion>
  </ComponentCard>

  <ComponentCard name="Anchor" href="/components/anchor">
    <div class="ui-anchor" aria-hidden="true">
      <Chip variant="outlined">Anchored</Chip>
      {
        (
          [
            { bottom: "anchor(top)", right: "anchor(left)" },
            { bottom: "anchor(top)", left: "anchor(right)" },
            { top: "anchor(bottom)", right: "anchor(left)" },
            { top: "anchor(bottom)", left: "anchor(right)" },
          ] as const
        ).map((position) => (
          <svg
            style={`position: absolute; position-anchor: --anchor; ${Object.entries(
              position,
            )
              .map(([prop, value]) => `${prop}: ${value};`)
              .join(" ")}`}
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M12 22q-1.525 0-3.125-.55t-2.9-1.5t-2.137-2.225T3 15v-3l4 3l-1.55 1.55q.725 1.275 2.3 2.2T11 19.925V11H8V9h3V7.825q-.875-.325-1.437-1.088T9 5q0-1.25.875-2.125T12 2t2.125.875T15 5q0 .975-.562 1.738T13 7.825V9h3v2h-3v8.925q1.675-.25 3.25-1.175t2.3-2.2L17 15l4-3v3q0 1.45-.837 2.725t-2.138 2.225t-2.9 1.5T12 22m0-16q.425 0 .713-.287T13 5t-.288-.712T12 4t-.712.288T11 5t.288.713T12 6"
            />
          </svg>
        ))
      }
    </div>
  </ComponentCard>

  <ComponentCard name="Avatar" href="/components/avatar">
    <Avatar aria-hidden="true" isGroup>
      <Avatar
        src="https://images.unsplash.com/photo-1614530606961-c4ce986825c1?q=80&w=1827&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
        alt="Avatar"
      />
      <Avatar>OP</Avatar>
      <Avatar>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"
          ><path
            fill="currentColor"
            d="M16 2C8.268 2 2 8.268 2 16s6.268 14 14 14s14-6.268 14-14S23.732 2 16 2m0 22.5c-3.866 0-7-2.429-7-6.071A2.43 2.43 0 0 1 11.429 16h9.142A2.43 2.43 0 0 1 23 18.429c0 3.642-3.134 6.071-7 6.071m0-10A3.75 3.75 0 1 1 16 7a3.75 3.75 0 0 1 0 7.5"
          ></path></svg
        >
      </Avatar>
    </Avatar>
  </ComponentCard>

  <ComponentCard name="Badge" href="/components/badge">
    <Badge aria-hidden="true" label="3">Inbox</Badge>
  </ComponentCard>

  <ComponentCard name="Button" href="/components/button">
    <Button aria-hidden="true" inert variant="filled">Get started</Button>
  </ComponentCard>

  <ComponentCard name="Button Group" href="/components/button-group">
    <ButtonGroup aria-hidden="true" inert variant="outlined" size="small">
      <Button>Day</Button>
      <Button>Week</Button>
    </ButtonGroup>
  </ComponentCard>

  <ComponentCard name="Callout" href="/components/callout" size="wide">
    <Callout aria-hidden="true" variant="tonal" severity="neutral">
      <Fragment slot="title">Heads up!</Fragment>
      Nah, just kidding. It wasn't important.
    </Callout>
  </ComponentCard>

  <ComponentCard name="Card" href="/components/card" size="xl">
    <Card aria-hidden="true" inert variant="outlined">
      <Fragment slot="header">
        <p>Article</p>
        <h3>Build something nice</h3>
      </Fragment>
      <Fragment slot="content">
        Components you can copy-paste into your project.
      </Fragment>
      <Fragment slot="actions">
        <Button variant="tonal" size="small">Read</Button>
      </Fragment>
    </Card>
  </ComponentCard>

  <ComponentCard name="Carousel" href="/components/carousel" size="wide">
    <Carousel
      aria-hidden="true"
      inert
      buttons={false}
      class="showcase-carousel"
      label="Destinations"
    >
      {
        ["Kyoto", "Lima", "Lisbon", "Oslo", "Tunis"].map((title) => (
          <li>
            <Card variant="tonal">
              <Fragment slot="header">
                <p>Destination</p>
                <h3>{title}</h3>
              </Fragment>
            </Card>
          </li>
        ))
      }
    </Carousel>
  </ComponentCard>

  <ComponentCard name="Checkbox" href="/components/checkbox">
    <Checkbox aria-hidden="true" inert checked>This checks out</Checkbox>
  </ComponentCard>

  <ComponentCard name="Chip" href="/components/chip">
    <div aria-hidden="true" class="showcase-chips">
      <Chip variant="outlined">HTML</Chip>
      <Chip variant="outlined">CSS</Chip>
    </div>
  </ComponentCard>

  <ComponentCard name="Description List" href="/components/description-list">
    <DescriptionList aria-hidden="true" bordered="dotted">
      <DescriptionList.Item>
        <DescriptionList.Term>Name</DescriptionList.Term>
        <DescriptionList.Description>Open Props UI</DescriptionList.Description>
      </DescriptionList.Item>
      <DescriptionList.Item>
        <DescriptionList.Term>Status</DescriptionList.Term>
        <DescriptionList.Description>Awesome</DescriptionList.Description>
      </DescriptionList.Item>
    </DescriptionList>
  </ComponentCard>

  <ComponentCard name="Dialog" href="/components/dialog" size="wide">
    <div class="showcase-backdrop" aria-hidden="true" inert>
      <Card variant="elevated" class="showcase-dialog">
        <Fragment slot="header">
          <h3>Discard draft?</h3>
        </Fragment>
        <Fragment slot="content">You can't undo this.</Fragment>
        <Fragment slot="actions">
          <Button size="small">Cancel</Button>
          <Button size="small" variant="filled">Discard</Button>
        </Fragment>
      </Card>
    </div>
  </ComponentCard>

  <ComponentCard name="Divider" href="/components/divider">
    <Divider variant="filled" aria-hidden="true" />
  </ComponentCard>

  <ComponentCard name="Drawer" href="/components/drawer">
    <div class="showcase-backdrop showcase-drawer" aria-hidden="true" inert>
      <div class="showcase-drawer-panel">
        <p>Filters</p>
        <Checkbox checked>In stock</Checkbox>
        <Checkbox>On sale</Checkbox>
      </div>
    </div>
  </ComponentCard>

  <ComponentCard name="Form" href="/components/form" size="wide">
    <Form aria-hidden="true" inert class="showcase-form">
      <FieldSet>
        <FieldLegend>Newsletter</FieldLegend>
        <FieldDescription>We will spam you to hell.</FieldDescription>
        <div class="showcase-form-row">
          <TextField placeholder="you@example.com" />
          <Button variant="filled">Subscribe</Button>
        </div>
      </FieldSet>
    </Form>
  </ComponentCard>

  <ComponentCard name="List" href="/components/list" size="wide">
    <List variant="transparent" aria-hidden="true" bordered dense>
      <ListItem headline="Angel Investor" description="Re: Horse thing pitch">
        <Avatar slot="start">AI</Avatar>
        <div slot="end">15:42</div>
      </ListItem>
      <ListItem
        headline="Jonathan Blow"
        description="Where are we at with the Horse Tinder programming language?"
      >
        <Avatar slot="start">JB</Avatar>
        <div slot="end">09:18</div>
      </ListItem>
    </List>
  </ComponentCard>

  <ComponentCard name="Menu" href="/components/menu">
    <menu class="ui-menu ui-list showcase-menu" aria-hidden="true" inert>
      <li>
        <button type="button">
          <div class="ui-text"><p>Edit</p></div>
          <div class="ui-end"><kbd>E</kbd></div>
        </button>
      </li>
      <li>
        <button type="button">
          <div class="ui-text"><p>Duplicate</p></div>
          <div class="ui-end"><kbd>D</kbd></div>
        </button>
      </li>
      <li class="ui-border-top ui-critical">
        <button type="button">
          <div class="ui-text"><p>Delete</p></div>
        </button>
      </li>
    </menu>
  </ComponentCard>

  <ComponentCard name="Message" href="/components/message">
    <Messages aria-hidden="true" class="showcase-messages" inert>
      <Message author="Saga">
        <Avatar slot="avatar">SN</Avatar>
        <p>Lunch?</p>
      </Message>
      <Message author="You" outgoing>
        <p>Yes please!</p>
      </Message>
    </Messages>
  </ComponentCard>

  <ComponentCard name="Progress" href="/components/progress">
    <Progress variant="filled" aria-busy="true" aria-hidden="true" />
  </ComponentCard>

  <ComponentCard name="Radio" href="/components/radio">
    <FieldGroup name="index-radio-showcase" aria-hidden="true" inert>
      <Radio checked>Whoa</Radio>
      <Radio>Nice</Radio>
    </FieldGroup>
  </ComponentCard>

  <ComponentCard name="Range" href="/components/range" size="wide">
    <Range
      variant="filled"
      aria-hidden="true"
      inert
      value={50}
      min={0}
      max={100}
    />
  </ComponentCard>

  <ComponentCard name="Rating" href="/components/rating">
    <Rating
      aria-hidden="true"
      inert
      label="Rated 4.5 out of 5"
      size="large"
      value={4.5}
    />
  </ComponentCard>

  <ComponentCard name="Select" href="/components/select">
    <FrameworkPicker />
  </ComponentCard>

  <ComponentCard name="Spinner" href="/components/spinner">
    <p aria-busy="true" aria-hidden="true">Loading</p>
    <Button variant="filled" aria-busy="true" aria-hidden="true" inert>
      Loading
    </Button>
  </ComponentCard>

  <ComponentCard name="Switch" href="/components/switch">
    <Switch id="showcase-theme-switcher">Dark mode</Switch>
  </ComponentCard>

  <ComponentCard name="Table" href="/components/table" size="wide">
    <Table aria-hidden="true" variant="dense">
      <Table.Head>
        <Table.Row>
          <Table.HeaderCell>Band</Table.HeaderCell>
          <Table.HeaderCell>Name</Table.HeaderCell>
          <Table.HeaderCell>Instrument</Table.HeaderCell>
        </Table.Row>
      </Table.Head>
      <Table.Body>
        <Table.Row>
          <Table.Cell>Broken Bells</Table.Cell>
          <Table.Cell>James Mercer</Table.Cell>
          <Table.Cell>Vocals</Table.Cell>
        </Table.Row>
        <Table.Row>
          <Table.Cell>Radiohead</Table.Cell>
          <Table.Cell>Ed O'Brien</Table.Cell>
          <Table.Cell>Guitar</Table.Cell>
        </Table.Row>
      </Table.Body>
    </Table>
  </ComponentCard>

  <ComponentCard name="Tabs" href="/components/tabs" size="wide">
    <Tabs aria-hidden="true" inert name="index-tabs-showcase">
      <Tabs.Item open>
        <Tabs.Tab>Profile</Tabs.Tab>
        <Tabs.Panel>Profile settings and information.</Tabs.Panel>
      </Tabs.Item>
      <Tabs.Item>
        <Tabs.Tab>Settings</Tabs.Tab>
        <Tabs.Panel>General account settings.</Tabs.Panel>
      </Tabs.Item>
      <Tabs.Item>
        <Tabs.Tab>Notifications</Tabs.Tab>
        <Tabs.Panel>Manage your notifications.</Tabs.Panel>
      </Tabs.Item>
    </Tabs>
  </ComponentCard>

  <ComponentCard name="Text Field" href="/components/text-field">
    <TextField aria-hidden="true" inert placeholder="you@example.com" />
  </ComponentCard>

  <ComponentCard name="Textarea" href="/components/textarea">
    <Textarea aria-hidden="true" inert placeholder="Write a comment…" />
  </ComponentCard>

  <ComponentCard name="Timeline" href="/components/timeline">
    <Timeline aria-hidden="true" inert size="small">
      <Timeline.Item color="success" datetime="2026-09-02" time="Sep 2">
        <p>Design freeze</p>
      </Timeline.Item>
      <Timeline.Item current datetime="2026-10-14" time="Oct 14">
        <p>Beta review</p>
      </Timeline.Item>
      <Timeline.Item datetime="2026-10-31" time="Oct 31">
        <p>Launch</p>
      </Timeline.Item>
    </Timeline>
  </ComponentCard>

  <ComponentCard name="Toast" href="/components/toast">
    <div
      class="ui-toast showcase-toast"
      data-severity="success"
      aria-hidden="true"
    >
      <span class="ui-icon"></span>
      <div class="ui-content">
        <div class="ui-title">Changes saved</div>
      </div>
    </div>
  </ComponentCard>

  <ComponentCard name="Toggle" href="/components/toggle">
    <ToggleGroup aria-hidden="true" inert>
      <ToggleButton pressed size="small" aria-label="Bold">
        <strong>B</strong>
      </ToggleButton>
      <ToggleButton size="small" aria-label="Italic">
        <i>I</i>
      </ToggleButton>
      <ToggleButton size="small" aria-label="Underline">
        <u>U</u>
      </ToggleButton>
    </ToggleGroup>
  </ComponentCard>

  <ComponentCard name="Tooltip" href="/components/tooltip">
    <Anchor
      class="ui-tooltip ui-with-arrow showcase-tooltip"
      aria-hidden="true"
    >
      <Button variant="outlined" inert>Save</Button>
      <Fragment slot="anchored">Save your changes</Fragment>
    </Anchor>
  </ComponentCard>

  <ComponentCard name="Typography" href="/components/typography">
    <div class="ui-rich-text showcase-typography" aria-hidden="true">
      <hgroup>
        <p>Chapter one</p>
        <h3>The quick brown fox</h3>
      </hgroup>
    </div>
  </ComponentCard>

  <style is:global>
    .component-showcase {
      display: grid;
      gap: var(--size-3);
      grid-auto-flow: dense;
      grid-auto-rows: minmax(180px, auto);
      grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
      margin-block: var(--size-8);
    }

    .component-showcase--hero {
      margin-block: 0 var(--size-8);
    }

    .component-showcase__intro {
      align-self: start;
      grid-column: 1 / -1;
      justify-self: start;
      padding-block: var(--size-10) var(--size-8);
      text-align: start;
    }

    @media (width > 768px) {
      .component-showcase--hero .component-showcase__intro {
        grid-column: 1 / span 2;
        grid-row: span 3;
        max-inline-size: 34rem;
        padding-block: var(--size-8) var(--size-10);
      }
    }

    @media (width <= 600px) {
      .component-showcase {
        grid-auto-rows: minmax(160px, auto);
      }
    }

    .showcase-backdrop {
      background-color: oklch(from var(--backdrop-color) l c h / 15%);
      block-size: 100%;
      border-radius: var(--radius-3);
      display: grid;
      inline-size: 100%;
      min-block-size: 140px;
      overflow: hidden;
      padding: var(--size-3);
      place-items: center;
    }

    .showcase-carousel {
      --_per-view: 2.5;

      inline-size: 100%;
      mask-image: linear-gradient(to right, black 75%, transparent);
      scrollbar-width: none;

      &:dir(rtl) {
        mask-image: linear-gradient(to left, black 75%, transparent);
      }
    }

    .showcase-dialog {
      box-shadow: var(--shadow-3);
      max-inline-size: 28ch;

      & h3 {
        font-size: var(--font-size-2);
      }
    }

    .showcase-chips {
      display: flex;
      gap: var(--size-3);
    }

    .showcase-drawer {
      justify-items: end;
      padding: 0;
    }

    .showcase-drawer-panel {
      background-color: var(--surface-default);
      block-size: 100%;
      box-shadow: var(--shadow-2);
      display: flex;
      flex-direction: column;
      gap: var(--size-2);
      inline-size: 65%;
      padding: var(--size-3);

      & p {
        font-weight: var(--font-weight-6);
        margin: 0;
      }
    }

    .showcase-form {
      inline-size: 100%;
    }

    .showcase-form-row {
      align-items: end;
      display: flex;
      gap: var(--size-2);

      & > .ui-text-field {
        flex: 1;
      }
    }

    .showcase-menu {
      inline-size: 100%;
      max-inline-size: 14rem;
    }

    .showcase-messages {
      inline-size: 100%;
      max-inline-size: 14rem;
    }

    .showcase-toast {
      animation: none;
      min-inline-size: 0;
    }

    .showcase-tooltip {
      margin-block-start: var(--size-7);
    }

    .showcase-typography hgroup {
      margin: 0;
    }
  </style>
</div>

<script is:inline>
  ;(function () {
    const themeSwitcher = document.getElementById("showcase-theme-switcher")

    if (themeSwitcher) {
      const syncTheme = () => {
        themeSwitcher.checked =
          document.documentElement.classList.contains("ui-dark")
      }

      syncTheme()

      themeSwitcher.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("ui-dark")
        const newTheme = isDark ? "light" : "dark"
        window.themeUtils.setTheme(newTheme)
        syncTheme()
      })

      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (
            mutation.type === "attributes" &&
            mutation.attributeName === "class"
          ) {
            syncTheme()
          }
        })
      })

      observer.observe(document.documentElement, { attributes: true })
    }
  })()
</script>
