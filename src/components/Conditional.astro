---
import { DEFAULT_FRAMEWORK } from "../utils/framework"

type Props = {
  as?: "p" | "div" | "span" | "section"
}

const { as: Tag = "span" } = Astro.props

const currentFramework = Astro.locals.framework

// Find the slot for the active framework, then the shared `components` slot on
// every framework except HTML. Fall back to the default framework (currently
// HTML) if the page didn't author either, so pages don't go blank during
// incremental migration.
const slotName = [
  currentFramework,
  currentFramework !== "html" && "components",
  DEFAULT_FRAMEWORK,
].find((name) => name && Astro.slots.has(name))

const content = slotName ? await Astro.slots.render(slotName) : ""
---

{content && <Tag class="conditional" set:html={content} />}

<style>
  /* Default <span> wrapper should be transparent so prose flows inline. */
  span.conditional,
  div.conditional,
  section.conditional {
    display: contents;
  }
</style>
