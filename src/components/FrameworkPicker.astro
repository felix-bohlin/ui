---
import { Select } from "opui-css/astro"
import { FRAMEWORKS } from "../utils/framework"

type Props = {
  size?: "small"
}

const { size } = Astro.props

const currentFramework = Astro.locals.framework
---

<Select aria-label="Framework" class="framework-picker" size={size}>
  {FRAMEWORKS.map((framework) => <option
    value={framework.id}
    selected={framework.id === currentFramework}
  >
    {framework.label}
  </option>)}
</Select>

<script>
  import {
    FRAMEWORK_STORAGE_KEY,
    hrefFor,
    isFrameworkId,
    pathHasFramework,
    stripFrameworkPrefix,
    type FrameworkId,
  } from "../utils/framework"
  import { HEADING_EXCLUSION_SELECTOR } from "../utils/headings"

  const SCROLL_ANCHOR_LINE = 160
  const SCROLL_KEY = "opui-framework-scroll"
  const SCROLL_MAX_AGE = 10_000

  function urlForFramework(framework: FrameworkId): string {
    const { hash, pathname, search } = window.location
    return pathHasFramework(framework, stripFrameworkPrefix(pathname))
      ? hrefFor(framework, `${pathname}${search}${hash}`)
      : hrefFor(framework, "/components")
  }

  function saveScroll() {
    const anchor = Array.from(
      document.querySelectorAll<HTMLElement>(
        "#main-content :is(h2, h3, h4, section)[id]",
      ),
    )
      .filter(
        (element) =>
          !element.closest(HEADING_EXCLUSION_SELECTOR) &&
          element.getBoundingClientRect().top <= SCROLL_ANCHOR_LINE,
      )
      .at(-1)
    try {
      sessionStorage.setItem(
        SCROLL_KEY,
        JSON.stringify({
          id: anchor?.id,
          offset: anchor?.getBoundingClientRect().top,
          path: stripFrameworkPrefix(window.location.pathname),
          time: Date.now(),
          y: window.scrollY,
        }),
      )
    } catch {}
  }

  function restoreScroll() {
    try {
      const saved = sessionStorage.getItem(SCROLL_KEY)
      if (!saved) return
      sessionStorage.removeItem(SCROLL_KEY)
      const { id, offset, path, time, y } = JSON.parse(saved)
      if (path !== stripFrameworkPrefix(window.location.pathname)) return
      if (Date.now() - time > SCROLL_MAX_AGE) return
      const scroll = () => {
        const anchor = id ? document.getElementById(id) : null
        const top = anchor
          ? anchor.getBoundingClientRect().top + window.scrollY - offset
          : y
        window.scrollTo({ behavior: "instant", top })
      }
      scroll()
      if (document.readyState !== "complete") {
        window.addEventListener("load", scroll, { once: true })
      }
    } catch {}
  }

  function init() {
    const pickers = document.querySelectorAll<HTMLSelectElement>(
      ".framework-picker select",
    )
    pickers.forEach((select) => {
      if (select.dataset.bound === "true") return
      select.dataset.bound = "true"
      select.addEventListener("change", () => {
        const framework = select.value
        if (!isFrameworkId(framework)) return
        // Persist explicit picker choice so future visits to the bare
        // homepage land on the user's preferred variant. Writes ONLY on
        // explicit change - never on plain URL navigation, so deep links
        // can't silently overwrite a saved preference.
        try {
          localStorage.setItem(FRAMEWORK_STORAGE_KEY, framework)
        } catch (_) {
          // private mode / storage disabled - non-fatal
        }
        saveScroll()
        window.location.href = urlForFramework(framework)
      })
    })
  }

  init()
  restoreScroll()
</script>
