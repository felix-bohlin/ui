---
import { Button, Chip, List, ListItem, RadioInput, Range } from "@opui/astro"
import { Code } from "astro-expressive-code/components"

type Step = {
  css: string
  html?: string
  notes?: string[]
  title: string
}

type Knob = {
  label: string
  max: number
  min: number
  property: string
  step?: number
  unit?: string
  value: number
}

type Props = {
  id: string
  knobs?: Knob[]
  source?: string
  steps: Step[]
  title: string
}

const { id, knobs = [], source, steps, title } = Astro.props

const values = (from: number) =>
  steps
    .slice(from)
    .map((_, offset) => `[value="${from + offset + 1}"]`)
    .join(", ")

const gatedCss = steps
  .map(
    (step, index) => `
#${id}:has(.build-up-steps :is(${values(index)}):checked) .build-up-stage {
${step.css}
}
#${id}:has(.build-up-steps [value="${index + 1}"]:checked) .build-up-step[data-step="${index + 1}"] {
  display: grid;
}`,
  )
  .join("\n")

const knobStyle = knobs
  .map((knob) => `${knob.property}: ${knob.value}${knob.unit ?? ""}`)
  .join("; ")

const stepId = (index: number, part?: string) =>
  [`${id}-step-${index + 1}`, part].filter(Boolean).join("-")
---

<figure class="build-up ui-card ui-outlined ui-not-rich-text" id={id}>
  <figcaption class="build-up-header">
    <p>
      <span class="build-up-overline">How it's made</span>
      <strong class="build-up-title">{title}</strong>
    </p>
    {
      source && (
        <Chip class="build-up-source" size="small" variant="outlined">
          <code>{source}</code>
        </Chip>
      )
    }
  </figcaption>

  <div class="build-up-layout">
    <div class="build-up-preview">
      <div class="build-up-stage" style={knobStyle}>
        <slot />
      </div>

      {
        knobs.length > 0 && (
          <div class="build-up-knobs">
            {knobs.map((knob) => (
              <Range
                data-property={knob.property}
                data-unit={knob.unit ?? ""}
                label={knob.label}
                max={knob.max}
                min={knob.min}
                step={knob.step ?? 1}
                value={knob.value}
                valueSuffix={knob.unit ?? ""}
              >
                <code slot="start-text">{knob.property}</code>
              </Range>
            ))}
          </div>
        )
      }
    </div>

    <fieldset class="build-up-steps">
      <legend class="ui-sr-only">Steps</legend>
      <List dense variant="transparent">
        {
          steps.map((step, index) => (
            <ListItem for={stepId(index)} type="radio">
              <span class="build-up-marker" slot="start" />
              <Fragment slot="text">
                <p class="build-up-step-name" id={stepId(index, "title")}>
                  {step.title}
                </p>
                {step.notes && (
                  <div class="build-up-notes">
                    <ul id={stepId(index, "notes")}>
                      {step.notes.map((note) => (
                        <li set:html={note} />
                      ))}
                    </ul>
                  </div>
                )}
              </Fragment>
              <RadioInput
                aria-describedby={
                  step.notes ? stepId(index, "notes") : undefined
                }
                aria-labelledby={stepId(index, "title")}
                checked={index === 0}
                class="ui-sr-only"
                id={stepId(index)}
                name={`${id}-step`}
                value={index + 1}
              />
            </ListItem>
          ))
        }
      </List>
    </fieldset>
  </div>

  <div class="build-up-detail">
    {
      steps.map((step, index) => (
        <div class="build-up-step" data-step={index + 1}>
          <p class="build-up-step-title">
            Step {index + 1} of {steps.length}: {step.title}
          </p>
          <div class="build-up-code">
            {step.html && <Code code={step.html.trim()} lang="html" />}
            <Code code={step.css.trim()} lang="css" />
          </div>
        </div>
      ))
    }

    <div class="build-up-nav">
      <Button data-direction="-1" disabled size="small" variant="outlined">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M15.4 7.4 14 6l-6 6 6 6 1.4-1.4-4.6-4.6z"></path>
        </svg>
        <span>Previous</span>
      </Button>
      <Button data-direction="1" size="small" variant="outlined">
        <span>Next</span>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6z"></path>
        </svg>
      </Button>
    </div>
  </div>
</figure>

<style is:inline set:html={gatedCss}></style>

<style is:global>
  .build-up {
    --_accent: var(--primary);
    --_marker: 1.75rem;
    --_pad: var(--size-2);

    align-items: stretch;
    box-shadow: var(--shadow-2);
    container-type: inline-size;
    gap: 0;
    margin-block: var(--size-6);
    margin-inline: 0;
    min-inline-size: 0;
    padding: 0;
    text-align: start;

    svg {
      fill: currentColor;
    }
  }

  .build-up-header {
    align-items: center;
    border-block-end: var(--border-width, 1px) solid var(--border-color);
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
    justify-content: space-between;
    padding: var(--size-3) var(--size-4);

    & p {
      display: grid;
      gap: var(--size-1);
      margin: 0;
    }
  }

  .build-up-overline {
    color: var(--text-muted);
    font-size: var(--font-size-0);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .build-up-title {
    font-size: var(--font-size-3);
    font-weight: 700;
    line-height: var(--font-lineheight-1);
  }

  .build-up-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
  }

  .build-up-preview {
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    min-inline-size: 0;
    position: relative;

    &:before {
      background-image: radial-gradient(
        var(--text-muted) 1.45px,
        transparent 1.45px
      );
      background-size: 20px 20px;
      content: "";
      inset: 0;
      opacity: 0.05;
      pointer-events: none;
      position: absolute;
      z-index: -1;
    }
  }

  .build-up-stage {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
    justify-content: center;
    min-block-size: 12rem;
    min-inline-size: 0;
    padding: var(--size-5) var(--size-4);
    position: relative;
  }

  .build-up-knobs {
    background-color: var(--surface-default);
    border-block-start: var(--border-width, 1px) solid var(--border-color);
    display: grid;
    gap: var(--size-3) var(--size-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    padding: var(--size-3) var(--size-4);

    & code {
      font-size: var(--font-size-0);
    }
  }

  .build-up-steps {
    border: 0;
    border-inline-start: var(--border-width, 1px) solid var(--border-color);
    border-radius: 0;
    margin: 0;
    min-inline-size: 0;
    padding: var(--size-3);

    & .ui-list {
      counter-reset: build-up-step;
      padding: 0;
    }

    & .ui-list > li {
      counter-increment: build-up-step;

      &:not(:last-child):after {
        border-inline-start: 2px solid var(--border-color);
        content: "";
        inset-block: calc(var(--_pad) + var(--_marker) + 4px)
          calc(4px - var(--_pad));
        inset-inline-start: calc(var(--_pad) + var(--_marker) / 2 - 1px);
        pointer-events: none;
        position: absolute;
        transition: border-color 0.3s;
        z-index: 1;
      }

      &:has(~ li :checked):after {
        border-color: var(--_accent);
      }

      & > label {
        align-items: start;
        border-radius: var(--radius-2);
        padding: var(--_pad);

        &:has(:focus-visible) {
          outline: var(--focus-ring-width, 2px) solid
            var(--focus-ring-color, var(--primary));
          outline-offset: -2px;
        }

        &:has(:checked) {
          background-color: color-mix(in oklch, var(--_accent) 8%, transparent);
        }
      }
    }

    & .ui-start {
      align-self: start;
    }

    & .ui-text {
      min-inline-size: 0;
      padding-block-start: calc((var(--_marker) - 1lh) / 2);
    }
  }

  .build-up-marker {
    aspect-ratio: 1;
    background-color: var(--surface-default);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-round);
    box-sizing: border-box;
    color: var(--text-muted);
    display: grid;
    font-size: var(--font-size-0);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    inline-size: var(--_marker);
    place-items: center;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      box-shadow 0.3s,
      color 0.3s;

    &:before {
      content: counter(build-up-step);
    }

    li:has(~ li :checked) &,
    label:has(:checked) & {
      background-color: var(--_accent);
      border-color: var(--_accent);
      color: var(--primary-contrast);
    }

    label:has(:checked) & {
      box-shadow: 0 0 0 4px color-mix(in oklch, var(--_accent) 25%, transparent);
    }
  }

  .build-up-steps .ui-text .build-up-step-name {
    color: var(--text-muted);
    font-weight: 600;
    margin: 0;
    transition: color 0.3s;

    label:has(:checked) &,
    li:has(~ li :checked) & {
      color: var(--text-primary);
    }
  }

  .build-up-notes {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 0.3s ease,
      visibility 0.3s;
    visibility: hidden;

    label:has(:checked) & {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    & ul {
      color: var(--text-muted);
      display: grid;
      font-size: var(--font-size-0);
      gap: var(--size-1);
      list-style: disc;
      margin: 0;
      min-block-size: 0;
      overflow: hidden;
      padding-inline-start: var(--size-3);
    }

    & li {
      background: none;
      display: list-item;
      line-height: var(--font-lineheight-3);
      min-block-size: 0;
      padding: 0;

      &:first-child {
        margin-block-start: var(--size-1);
      }
    }
  }

  .build-up-detail {
    border-block-start: var(--border-width, 1px) solid var(--border-color);
    display: grid;
    gap: var(--size-3) var(--size-2);
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    padding: var(--size-3) var(--size-4) var(--size-4);
  }

  .build-up-step {
    display: none;
    grid-column: 1 / -1;
    grid-row: 1 / span 2;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    min-inline-size: 0;

    & .build-up-step-title {
      align-self: center;
      font-size: var(--font-size-1);
      font-weight: 700;
      margin: 0;
    }
  }

  .build-up-code {
    display: grid;
    gap: var(--size-3);
    grid-column: 1 / -1;
    min-inline-size: 0;
  }

  .build-up-nav {
    align-self: center;
    display: flex;
    gap: var(--size-2);
    grid-column: 2;
    grid-row: 1;

    & svg {
      block-size: 1.25em;
      inline-size: 1.25em;
    }
  }

  @container (inline-size < 40rem) {
    .build-up-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .build-up-steps {
      border-block-start: var(--border-width, 1px) solid var(--border-color);
      border-inline-start: 0;
    }

    .build-up-header,
    .build-up-detail {
      padding-inline: var(--size-3);
    }

    .build-up-nav span {
      block-size: 1px;
      clip-path: inset(50%);
      inline-size: 1px;
      overflow: hidden;
      position: absolute;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .build-up-notes,
    .build-up-marker,
    .build-up-step-name,
    .build-up-steps .ui-list > li:after {
      transition: none;
    }
  }
</style>

<script>
  function initBuildUps() {
    document.querySelectorAll<HTMLElement>(".build-up").forEach((buildUp) => {
      if (buildUp.dataset.ready) return
      buildUp.dataset.ready = ""

      const stage = buildUp.querySelector<HTMLElement>(".build-up-stage")
      const radios = [
        ...buildUp.querySelectorAll<HTMLInputElement>(
          ".build-up-steps input[type=radio]",
        ),
      ]
      const buttons = [
        ...buildUp.querySelectorAll<HTMLButtonElement>(".build-up-nav button"),
      ]
      const current = () => radios.findIndex((radio) => radio.checked)

      const sync = () => {
        const index = current()
        const focused = document.activeElement
        buttons.forEach((button) => {
          const target = index + Number(button.dataset.direction)
          button.disabled = target < 0 || target >= radios.length
        })
        if (buttons.some((button) => button.disabled && button === focused))
          buttons.find((button) => !button.disabled)?.focus()
      }

      radios.forEach((radio) => radio.addEventListener("change", sync))
      buttons.forEach((button) =>
        button.addEventListener("click", () => {
          const radio = radios[current() + Number(button.dataset.direction)]
          if (!radio) return
          radio.checked = true
          sync()
        }),
      )
      sync()

      buildUp
        .querySelectorAll<HTMLInputElement>(".build-up-knobs input[type=range]")
        .forEach((input) => {
          const update = () =>
            stage?.style.setProperty(
              input.dataset.property ?? "",
              `${input.value}${input.dataset.unit ?? ""}`,
            )
          input.addEventListener("input", update)
        })
    })
  }

  initBuildUps()
  document.addEventListener("astro:after-swap", initBuildUps)
</script>
