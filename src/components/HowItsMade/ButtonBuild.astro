---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.button {
  align-items: center;
  background-color: var(--surface-tonal);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-2);
  color: var(--text-primary);
  display: inline-flex;
  gap: 1ex;
  min-block-size: var(--size);
  padding-inline: var(--padding-inline);
}

.button > svg {
  flex-shrink: 0;
  max-block-size: 1.25em;
}`,
    notes: [
      "Padding in <code>ex</code> so it scales with the font",
      "One custom property per size, every size reuses the same rules",
    ],
    title: "Base",
  },
  {
    css: `
.button:has(> svg:only-child) {
  justify-content: center;
  min-inline-size: var(--size);
  padding-inline: 0;
}`,
    notes: [
      "<code>:has(> svg:only-child)</code> spots an icon-only button",
      "Square at every size: no <code>IconButton</code>, no extra class",
    ],
    title: "Icon-only",
  },
  {
    css: `
.button:has(> svg:first-child + *) {
  padding-inline-start: calc(var(--padding-inline) * 0.75);
}

.button:has(> * + svg:last-child) {
  padding-inline-end: calc(var(--padding-inline) * 0.75);
}`,
    html: `
<button class="button">
  <svg>…</svg>
  <span>Download</span>
</button>`,
    notes: [
      "Tighter padding on the icon side balances the optical weight",
      "Text nodes aren't elements, so the label needs a <code>&lt;span&gt;</code>",
    ],
    title: "Icon side",
  },
  {
    css: `
.ripple {
  --ripple-scale: 0.01;
  border-radius: 50%;
  position: relative;
  transform-style: preserve-3d;
}

.ripple::before {
  background-color: oklch(0.6 0 0 / 0.2);
  block-size: 130%;
  clip-path: circle(50%);
  content: "";
  inline-size: 130%;
  inset: 50% auto auto 50%;
  position: absolute;
  transform: translate(-50%, -50%) translateZ(-1px)
    scale(var(--ripple-scale));
  transition: transform 0.2s ease;
}

.ripple:hover {
  --ripple-scale: 1;
}

.ripple:hover:active {
  --ripple-scale: 1.1;
}`,
    notes: [
      "<code>translateZ(-1px)</code> + <code>preserve-3d</code> puts the halo behind the button, no <code>z-index</code>",
      "<code>clip-path: circle()</code> keeps the halo round",
      "Hover the last button",
    ],
    title: "Ripple",
  },
]

const knobs = [
  {
    label: "Padding",
    max: 4,
    min: 0.5,
    property: "--padding-inline",
    step: 0.25,
    unit: "ex",
    value: 1.5,
  },
  {
    label: "Size",
    max: 56,
    min: 28,
    property: "--size",
    step: 4,
    unit: "px",
    value: 40,
  },
]

const icon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg>`
---

<BuildUp
  id="build-button"
  knobs={knobs}
  source="button.css"
  steps={steps}
  title="Button: one class, every shape"
>
  <div class="row">
    <button class="button">Download</button>
    <button class="button" aria-label="Download"
      ><Fragment set:html={icon} /></button
    >
    <button class="button"
      ><Fragment set:html={icon} /><span>Download</span></button
    >
    <button class="button ripple" aria-label="Download"
      ><Fragment set:html={icon} /></button
    >
  </div>
</BuildUp>

<style>
  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: center;
  }

  .button {
    cursor: pointer;
    font: inherit;
  }
</style>
