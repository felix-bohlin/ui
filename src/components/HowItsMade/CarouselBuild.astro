---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.carousel {
  display: grid;
  gap: var(--gap);
  grid-auto-columns: calc(
    (100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
  );
  grid-auto-flow: column;
  overflow-x: auto;
}`,
    notes: [
      "<code>grid-auto-flow: column</code> lays every item out in one row",
      "Item width = (track − gaps) ÷ items per view",
    ],
    title: "Grid track",
  },
  {
    css: `
.carousel {
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
}

.carousel > li {
  scroll-snap-align: start;
}`,
    notes: [
      "<code>scroll-snap-type</code> on the scroller",
      "<code>scroll-snap-align</code> on each item",
      "<code>overscroll-behavior-x: contain</code> stops the page swiping back",
    ],
    title: "Scroll snap",
  },
  {
    css: `
.carousel::scroll-button(inline-start),
.carousel::scroll-button(inline-end) {
  background-color: var(--text-primary);
  block-size: 2rem;
  border: 0;
  border-radius: 50%;
  color: var(--surface-default);
  cursor: pointer;
  inline-size: 2rem;
  inset-block-start: anchor(center);
  position: absolute;
  position-anchor: auto;
  translate: 0 -50%;
}

.carousel::scroll-button(inline-start) {
  content: "❮" / "Previous";
  inset-inline-start: calc(anchor(self-start) + 0.5rem);
}

.carousel::scroll-button(inline-end) {
  content: "❯" / "Next";
  inset-inline-end: calc(anchor(self-end) + 0.5rem);
}

.carousel::scroll-button(inline-start):disabled,
.carousel::scroll-button(inline-end):disabled {
  opacity: 0;
}`,
    notes: [
      "<code>::scroll-button()</code>: real, focusable buttons generated by CSS",
      "Disabled automatically at either end",
      '<code>content: "❯" / "Next"</code> sets the glyph and the accessible name',
      "Anchor positioning places them over the scroller",
    ],
    title: "Scroll buttons",
  },
  {
    css: `
.carousel {
  counter-reset: slide;
  scroll-marker-group: after;
}

.carousel::scroll-marker-group {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
  margin-block-start: 0.75rem;
}

.carousel > li {
  counter-increment: slide;
}

.carousel > li::scroll-marker {
  background-color: oklch(from var(--text-primary) l c h / 25%);
  block-size: 0.5rem;
  border-radius: 50%;
  content: "" / "Slide " counter(slide);
  cursor: pointer;
  inline-size: 0.5rem;
}

.carousel > li::scroll-marker:target-current {
  background-color: var(--primary);
}

@supports selector(::scroll-button(*)) {
  .carousel {
    scrollbar-width: none;
  }
}`,
    notes: [
      "<code>scroll-marker-group: after</code> creates the dot container",
      "<code>::scroll-marker</code> per item, labelled with a CSS counter",
      "<code>:target-current</code> follows the snapped item",
      "Scrollbar hidden only where buttons are supported",
    ],
    title: "Scroll markers",
  },
]

const knobs = [
  { label: "Items per view", max: 3, min: 1, property: "--per-view", value: 1 },
  {
    label: "Gap",
    max: 32,
    min: 0,
    property: "--gap",
    step: 4,
    unit: "px",
    value: 12,
  },
]

const slides = ["Kyoto", "Lima", "Lisbon", "Oslo", "Tbilisi"]
---

<BuildUp id="build-carousel" knobs={knobs} steps={steps}>
  <div class="frame">
    <ul class="carousel" aria-label="Destinations" tabindex="0">
      {
        slides.map((slide, index) => (
          <li>
            <span class="slide-index">{index + 1}</span>
            {slide}
          </li>
        ))
      }
    </ul>
  </div>
</BuildUp>

<style>
  .frame {
    inline-size: min(100%, 28rem);
  }

  .carousel {
    list-style: none;
    margin: 0;
    padding: 0;

    & > li {
      align-content: center;
      background-color: var(--surface-default);
      border: var(--border-width, 1px) solid var(--border-color);
      border-radius: var(--radius-2);
      display: grid;
      font-weight: 600;
      min-block-size: 7rem;
      min-inline-size: 7rem;
      text-align: center;
    }
  }

  .slide-index {
    color: var(--text-muted);
    font-size: var(--font-size-0);
  }
</style>
