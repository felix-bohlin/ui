---
import { Chip } from "@opui/astro"
import { references } from "./references"

type Props = {
  topic: keyof typeof references
}

const { topic } = Astro.props
---

<ul class="read-more ui-not-rich-text">
  {
    references[topic]
      .toSorted((a, b) => a.label.localeCompare(b.label))
      .map((reference) => (
        <li>
          <Chip
            href={reference.href}
            rel="noopener noreferrer"
            target="_blank"
            variant="outlined"
          >
            {reference.code ? <code>{reference.label}</code> : reference.label}
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M14 3v2h3.6l-9.8 9.8 1.4 1.4L19 6.4V10h2V3zm5 16H5V5h7V3H5a2 2 0 0 0-2 2v14c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-7h-2z" />
            </svg>
          </Chip>
        </li>
      ))
  }
</ul>

<style>
  .read-more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    list-style: none;
    margin-block: var(--size-3) 0;
    padding: 0;

    & svg {
      fill: currentColor;
    }
  }
</style>
