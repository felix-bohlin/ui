---
import { Chip, Tooltip } from "@opui/astro"
import type { ComponentFramework } from "../component-api/frameworks"
import { hydrationRows } from "../component-api/rows"
import type { ComponentApi } from "../component-api/types"
import { formatInline } from "../utils/format-inline"
import Server from "./icons/Server.astro"

type Props = {
  apis: ComponentApi[]
  framework: ComponentFramework
}

const { apis, framework } = Astro.props
const tooltipId = Astro.locals.$id("hydration")
const needs = apis.flatMap((api) =>
  hydrationRows(api, framework).map((row) => ({
    ...row,
    component: api.component,
  })),
)
const named = new Set(needs.map((need) => need.component)).size > 1
const code = (text: string) => "`" + text + "`"
const key = (need: (typeof needs)[number]) =>
  [need.prop, need.description, need.fallback].join(" ")
const lines = [...new Set(needs.map(key))].map((entry) => {
  const group = needs.filter((need) => key(need) === entry)
  const [{ description, fallback, prop }] = group
  const components = group.map((need) => need.component).sort()
  const name = named
    ? `${code(prop)} (${components.join(", ")}):`
    : `${code(prop)}:`
  return formatInline(
    [name, description, fallback].filter(Boolean).join(" "),
    Astro.locals.link,
  )
})
const props = [...new Set(needs.map((need) => need.prop))].sort()
const label = needs.length
  ? formatInline(
      `SSR: hydrate for ${props.map(code).join(", ")}`,
      Astro.locals.link,
    )
  : "SSR: no hydration needed"
---

<Tooltip id={tooltipId} class="hydration-tooltip">
  <Chip
    as="button"
    type="button"
    multiline
    size="small"
    variant={needs.length ? "outlined" : "tonal"}
    class="hydration-chip"
    interestfor={tooltipId}
    commandfor={tooltipId}
    command="toggle-popover"
  >
    <Server slot="start" crossed={needs.length > 0} />
    <span class="ui-text" set:html={label} />
  </Chip>
  <Fragment slot="content">
    <strong class="tooltip-heading"
      >{needs.length ? "Needs hydration" : "No hydration needed"}</strong
    >
    {
      needs.length ? (
        <span class="tooltip-line">
          Renders complete HTML on the server. Without hydration:
        </span>
      ) : (
        <span class="tooltip-line">
          Renders complete HTML on the server and works without hydration.
        </span>
      )
    }
    {lines.map((line) => <span class="tooltip-line" set:html={line} />)}
  </Fragment>
</Tooltip>

<style>
  .hydration-chip {
    cursor: help;

    :global(svg) {
      color: var(--text-muted);
    }
  }

  .hydration-tooltip {
    max-inline-size: 100%;
  }

  .hydration-tooltip :global(.ui-anchor-floating) {
    max-inline-size: 20rem;
    text-align: start;
  }

  .tooltip-heading,
  .tooltip-line {
    display: block;
  }

  .tooltip-heading,
  .tooltip-line:not(:last-child) {
    margin-block-end: var(--size-1);
  }
</style>
