---
import { Tooltip } from "@opui/astro"
import type { ApiHydration } from "../component-api/types"
import { formatInline } from "../utils/format-inline"
import Server from "./icons/Server.astro"

type Props = {
  hydration: ApiHydration
}

const { hydration } = Astro.props
const tooltipId = Astro.locals.$id("hydration-prop")
---

<Tooltip id={tooltipId} class="hydration-marker-tooltip">
  <button
    type="button"
    class="hydration-marker"
    aria-label="Needs hydration"
    interestfor={tooltipId}
    commandfor={tooltipId}
    command="toggle-popover"
  >
    <Server crossed />
  </button>
  <Fragment slot="content">
    <strong class="tooltip-heading">Needs hydration</strong>
    <span set:html={formatInline(hydration.description, Astro.locals.link)} />
    {
      hydration.fallback && (
        <span
          class="tooltip-line"
          set:html={formatInline(hydration.fallback, Astro.locals.link)}
        />
      )
    }
  </Fragment>
</Tooltip>

<style>
  .hydration-marker {
    align-items: center;
    background: none;
    border: 0;
    border-radius: var(--radius-1);
    color: var(--text-muted);
    cursor: help;
    display: inline-flex;
    font: inherit;
    margin-inline-start: var(--size-1);
    padding: 0;
    vertical-align: middle;

    :global(svg) {
      block-size: 1.25em;
      inline-size: 1.25em;
    }
  }

  .hydration-marker-tooltip :global(.ui-anchor-floating) {
    max-inline-size: 20rem;
    position-visibility: always;
    text-align: start;
  }

  .tooltip-heading {
    display: block;
    margin-block-end: var(--size-1);
  }

  .tooltip-line {
    display: block;
    margin-block-start: var(--size-1);
  }
</style>
