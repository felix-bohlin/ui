---
import Code from "./Code.astro"
import { compatCss } from "../utils/compat"
import { components, dependentsOf } from "../utils/components"
import { componentHasFramework } from "../utils/framework"
import { Tabs, TabsItem, TabsLabel, TabsPanel } from "opui-css/astro"
import InstallationFiles from "./InstallationFiles.astro"
import InstallCommand from "../docs/guide/getting-started/partials/InstallCommand.astro"

export type Tab = {
  title: string
  code: string
  lang?: string
  isDependency?: boolean
}

type Props = {
  imports?: { names: string[]; package: string }
  slug?: string
  sourceTabs?: Tab[]
  tabs: Tab[]
}

const { imports, slug, sourceTabs = [], tabs } = Astro.props

const importLine = imports
  ? `import { ${imports.names.join(", ")} } from "${imports.package}"`
  : ""
const importCode =
  imports && importLine.length > 80
    ? `import {\n${imports.names.map((name) => `  ${name},`).join("\n")}\n} from "${imports.package}"`
    : importLine

const { link } = Astro.locals

const pageFor = (tab: Tab) =>
  components.find((c) => c.slug === tab.title.replace(/\.css$/, ""))

const dependencies = tabs
  .filter((tab) => tab.isDependency)
  .map(pageFor)
  .filter((c) => c !== undefined)

const allTabs = [
  ...tabs,
  ...tabs.flatMap((tab) =>
    compatCss[tab.title]
      ? [
          {
            code: compatCss[tab.title],
            isDependency: tab.isDependency,
            lang: "css",
            title: `compat/${tab.title}`,
          },
        ]
      : [],
  ),
]

const usedBy = slug
  ? dependentsOf(slug).filter((c) =>
      componentHasFramework(Astro.locals.framework, c.slug),
    )
  : []
---

<section id="installation">
  <h2>Installation</h2>
  {imports ? (
    <Tabs class="installation-methods" overflow="wrap" variant="line">
      <TabsItem checked>
        <TabsLabel>Command</TabsLabel>
        <TabsPanel>
          <InstallCommand />
          {imports.names.length > 0 && (
            <>
              <p>
                Import{" "}
                {imports.names.length === 1
                  ? "the component"
                  : "the components"}
                from{" "} <code>{imports.package}</code>:
              </p>
              <Code code={importCode} lang="ts" />
            </>
          )}
          <p>
            The components ship markup only. Import
            <code>opui-css/css/imports.css</code> once, or only the files under
            Manual. See
            <a href={link("/guide/getting-started")}>Getting started</a>.
          </p>
        </TabsPanel>
      </TabsItem>
      <TabsItem>
        <TabsLabel>Manual</TabsLabel>
        <TabsPanel>
          <InstallationFiles sourceTabs={sourceTabs} tabs={allTabs}>
            <slot />
          </InstallationFiles>
        </TabsPanel>
      </TabsItem>
    </Tabs>
  ) : (
    <InstallationFiles sourceTabs={sourceTabs} tabs={allTabs}>
      <slot />
    </InstallationFiles>
  )}

  {dependencies.length > 0 && (
    <>
      <h3 id="dependencies">Dependencies</h3>
      <ul>
        {dependencies.map((dep) => <li>
          <a href={link(dep.href)}>{dep.name}</a>
        </li>)}
      </ul>
    </>
  )}

  {usedBy.length > 0 && (
    <>
      <h3 id="used-by">Used by</h3>
      <ul>
        {usedBy.map((item) => <li>
          <a href={link(item.href)}>{item.name}</a>
        </li>)}
      </ul>
    </>
  )}
</section>

<style>
  .installation-methods {
    margin-block: var(--size-4);
  }
</style>
