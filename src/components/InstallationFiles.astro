---
import Code from "./Code.astro"
import type { Tab } from "./Installation.astro"
import { FRAMEWORKS } from "../utils/framework"
import { Select, Tabs, TabsItem, TabsLabel, TabsPanel } from "opui-css/astro"

type Props = {
  sourceTabs: Tab[]
  tabs: Tab[]
}

const { sourceTabs, tabs: allTabs } = Astro.props

const cssTabs = allTabs.filter((tab) => tab.title.endsWith(".css"))
const allCss = cssTabs
  .map((tab) => `/* ${tab.title} */\n${tab.code.trim()}\n`)
  .join("\n")

const framework = Astro.locals.framework
const frameworkLabel = FRAMEWORKS.find((f) => f.id === framework)?.label

const sourceNames = new Set(
  sourceTabs.map((tab) => tab.title.slice(tab.title.lastIndexOf("/") + 1)),
)
const styleFiles = allTabs.filter(
  (tab) => tab.title.endsWith(".css") || !sourceNames.has(tab.title),
)

const groups = [
  { files: styleFiles, title: "CSS" },
  ...(sourceTabs.length > 0
    ? [{ files: sourceTabs, title: frameworkLabel ?? "Source" }]
    : []),
]
---

<slot />

<div class="code-group ui-card ui-outlined ui-not-rich-text">
  <Tabs variant="line" class="code-tabs">
    {groups.map((group, groupIndex) => <TabsItem checked={groupIndex === 0}>
      <TabsLabel>{group.title}</TabsLabel>
      <TabsPanel>
        {(group.files.length > 1 ||
          (group.title === "CSS" && cssTabs.length > 1)) && <div
          class="file-bar"
        >
          {group.files.length > 1 && <Select
            aria-label={`${group.title} file`}
            class="file-picker"
            size="small"
          >
            {group.files.map((file, index) => <option value={index}>
              {file.title}
            </option>)}
          </Select>}
          <span class="file-count">{group.files.length} files</span>
          {group.title === "CSS" && cssTabs.length > 1 && <button
            type="button"
            class="ui-button ui-outlined ui-small copy-all-css"
            data-css={allCss}
          >
            Copy all CSS
          </button>}
        </div>}
        {group.files.map((file, index) => <div class="file" hidden={index > 0}>
          <Code code={file.code} lang={file.lang} />
        </div>)}
      </TabsPanel>
    </TabsItem>)}
  </Tabs>
</div>

<style>
  .code-group {
    gap: 0;
    margin-block: var(--size-4);
    overflow: hidden;
    padding: 0;
  }

  .file-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-3);
    padding: var(--ui-space-3);
  }

  .file-count {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-small);
  }

  .copy-all-css {
    margin-inline-start: auto;
  }
</style>

<script>
  import { copyText } from "../utils/storage"

  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      ".copy-all-css[data-css]",
    )
    if (!button || !(await copyText(button.dataset.css ?? ""))) return
    const label = button.textContent
    button.textContent = "Copied"
    setTimeout(() => (button.textContent = label), 1500)
  })

  document.addEventListener("change", (event) => {
    const select = (event.target as Element).closest<HTMLSelectElement>(
      ".file-picker select",
    )
    const panel = select?.closest(".ui-panel")
    if (!select || !panel) return
    panel
      .querySelectorAll<HTMLElement>(":scope > .file")
      .forEach((file, index) => {
        file.hidden = index !== Number(select.value)
      })
  })
</script>
