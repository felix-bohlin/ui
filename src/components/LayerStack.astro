---
type Item = {
  name: string
  note?: string
  sublayers?: Item[]
  tag?: string
  yours?: boolean
}

type Props = {
  items?: Item[]
}

const layers: Item[] = [
  { name: "openprops", note: "Open Props, optional" },
  {
    name: "theme",
    sublayers: [
      { name: "theme.palette", note: "palette.css" },
      { name: "theme.base", note: "theme.css" },
      { name: "theme.custom", note: "Your theme", yours: true },
      { name: "theme.severity", note: "Severity scopes" },
    ],
  },
  { name: "normalize", note: "Reset and focus ring" },
  {
    name: "components",
    sublayers: [
      { name: "components.prose", note: "Rich text" },
      { name: "components.root", note: "Button, Checkbox" },
      { name: "components.extended", note: "Badge, Dialog, Select" },
      { name: "components.compat", note: "Browser fallbacks" },
    ],
  },
  { name: "utils", note: "Utility classes" },
  { name: "Unlayered", note: "Your overrides", yours: true },
]

const { items = layers } = Astro.props
---

<figure class="layer-stack ui-not-rich-text">
  <ol>
    {items.map((layer) => <li data-yours={layer.yours ? "" : undefined}>
      {layer.name === "Unlayered" ? (
        <span class="name">{layer.name}</span>
      ) : (
        <code class="name">{layer.name}</code>
      )}
      {layer.note && <span class="note">{layer.note}</span>}
      {layer.tag && <span class="tag">{layer.tag}</span>}
      {layer.sublayers && <ol>
        {layer.sublayers.map((sublayer) => <li
          data-yours={sublayer.yours ? "" : undefined}
        >
          <code class="name">{sublayer.name}</code>
          <span class="note">{sublayer.note}</span>
        </li>)}
      </ol>}
    </li>)}
  </ol>
  <figcaption>
    <slot name="caption">Each layer beats the ones above it.</slot>
  </figcaption>
</figure>

<style>
  .layer-stack {
    container-type: inline-size;
    display: grid;
    gap: var(--size-3);
    margin-block: var(--size-5);
    place-items: stretch;
  }

  ol {
    column-gap: var(--size-3);
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) auto;
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: var(--size-2);
  }

  .layer-stack > ol {
    padding-inline-start: var(--size-6);
    position: relative;

    &::before {
      background-image: linear-gradient(transparent, var(--ui-primary));
      border-radius: var(--radius-round);
      content: "";
      inline-size: 3px;
      inset-block: var(--size-2);
      inset-inline-start: var(--size-2);
      position: absolute;
    }

    &::after {
      border-block-start: 8px solid var(--ui-primary);
      border-inline: 6px solid transparent;
      content: "";
      inset-block-end: 0;
      inset-inline-start: calc(var(--size-2) - 4.5px);
      position: absolute;
    }
  }

  li {
    align-items: center;
    background-color: var(--ui-surface-tonal);
    border: var(--ui-border-width) solid transparent;
    border-radius: var(--ui-radius-small);
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding: var(--size-2) var(--size-3);
    row-gap: var(--size-2);
  }

  li li {
    background-color: var(--ui-surface);
  }

  li > ol {
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  [data-yours] {
    background-color: var(--ui-palette-tint-subtle);
    border-color: var(--ui-primary);
    border-style: dashed;
  }

  .name {
    font-size: var(--ui-font-size-small);
    font-weight: var(--ui-font-weight-semibold);
  }

  .note {
    color: var(--ui-text);
    font-size: var(--ui-font-size-small);
  }

  .tag {
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--radius-round);
    color: var(--ui-text);
    font-size: var(--ui-font-size-caption);
    justify-self: start;
    padding-inline: var(--size-2);
  }

  figcaption {
    color: var(--ui-text);
    font-size: var(--ui-font-size-small);
    text-align: start;
  }

  @container (width < 24rem) {
    .layer-stack > ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
