---
import { Range } from "opui-css/astro"
import DragHandle from "./DragHandle.astro"

const domain = { max: 960, min: 240 }
const fluidWindow = { end: 768, start: 320 }
const viewport = 600

const steps = [
  { max: 3.5, min: 2, name: "h1", slope: 9 },
  { max: 2.5, min: 1.5, name: "h2", slope: 6 },
  { max: 1.5, min: 1.25, name: "h3", slope: 4 },
  { max: 1.25, min: 1.125, name: "h4", slope: 3 },
]

const fraction = (px: number) => (px - domain.min) / (domain.max - domain.min)

const ramp = (from: number, to: number) =>
  `M 0 100 L ${fraction(from) * 1000} 100 L ${fraction(to) * 1000} 0 L 1000 0`

const clampRange = (step: (typeof steps)[number]) => ({
  from: (step.min * 16 * 100) / step.slope,
  to: (step.max * 16 * 100) / step.slope,
})

const growth = (step: (typeof steps)[number], px: number) => {
  const size = Math.min(
    Math.max(step.min, (px * step.slope) / 100 / 16),
    step.max,
  )
  return (size - step.min) / (step.max - step.min)
}

const ticks = [320, 480, 640, 800, 960]

const charts = [
  {
    caption: "Four ramps",
    mode: "clamp",
    paths: steps.map((step) => {
      const { from, to } = clampRange(step)
      return ramp(from, to)
    }),
    title: "clamp()",
  },
  {
    caption: "One ramp, shared",
    mode: "progress",
    paths: steps.map(() => ramp(fluidWindow.start, fluidWindow.end)),
    title: "progress()",
  },
]
---

<div
  class="fluid-compare"
  style={`--viewport: ${viewport}px; --fluid-min: ${fluidWindow.start}px; --fluid-max: ${fluidWindow.end}px; --_domain-min: ${domain.min}px; --_domain-max: ${domain.max}px; --_x: ${fraction(viewport)}; --_window-start: ${fraction(fluidWindow.start)}; --_window-end: ${fraction(fluidWindow.end)}`}
>
  <div class="fluid-compare-charts">
    {
      charts.map((chart) => (
        <figure
          aria-hidden="true"
          class="fluid-compare-chart"
          data-mode={chart.mode}
        >
          <figcaption>
            <code>{chart.title}</code>
            <span>{chart.caption}</span>
          </figcaption>
          <div class="fluid-compare-plot">
            <span class="fluid-compare-y" data-end="max">
              100%
            </span>
            <span class="fluid-compare-y" data-end="min">
              0%
            </span>
            {chart.mode === "progress" && <span class="fluid-compare-window" />}
            <svg preserveAspectRatio="none" viewBox="0 0 1000 100">
              {chart.paths.map((d, index) => (
                <path
                  d={d}
                  data-step={steps[index].name}
                  vector-effect="non-scaling-stroke"
                />
              ))}
            </svg>
            <span class="fluid-compare-cursor" />
            {steps.map((step) => (
              <span
                class="fluid-compare-dot"
                data-step={step.name}
                style={
                  chart.mode === "clamp"
                    ? `--_growth: ${growth(step, viewport)}`
                    : undefined
                }
              />
            ))}
          </div>
          <div class="fluid-compare-ticks">
            {ticks.map((tick) => (
              <span style={`--_x: ${fraction(tick)}`}>{tick}</span>
            ))}
          </div>
        </figure>
      ))
    }
  </div>

  <div class="fluid-compare-stage">
    <div class="fluid-compare-frame">
      <div class="fluid-compare-viewport">
        {
          charts.map((chart) => (
            <div class="fluid-compare-column" data-mode={chart.mode}>
              <p class="fluid-compare-column-title">
                <code>{chart.title}</code>
              </p>
              {steps.map((step) => (
                <p
                  class="fluid-compare-row"
                  style={`--_min: ${step.min}rem; --_max: ${step.max}rem; --_slope: ${step.slope / 100}`}
                >
                  <span class="fluid-compare-sample">Aa</span>
                  <span class="fluid-compare-readout">
                    <span class="fluid-compare-key" data-step={step.name}>
                      {step.name}
                    </span>
                    <span data-size />
                  </span>
                </p>
              ))}
            </div>
          ))
        }
      </div>
      <span aria-hidden="true" class="fluid-compare-width">{viewport}px</span>
      <DragHandle />
    </div>
  </div>

  <fieldset class="fluid-compare-knobs">
    <legend class="ui-sr-only">Viewport and window</legend>
    <Range
      data-property="--viewport"
      label="Viewport"
      max={domain.max}
      min={domain.min}
      step={10}
      value={viewport}
      valueSuffix="px"
    >
      <code slot="start-text">100vi</code>
    </Range>
    <Range
      data-property="--fluid-min"
      label="Window start"
      max={464}
      min={domain.min}
      step={16}
      value={fluidWindow.start}
      valueSuffix="px"
    >
      <code slot="start-text">--ui-fluid-min-inline-size</code>
    </Range>
    <Range
      data-property="--fluid-max"
      label="Window end"
      max={domain.max}
      min={496}
      step={16}
      value={fluidWindow.end}
      valueSuffix="px"
    >
      <code slot="start-text">--ui-fluid-max-inline-size</code>
    </Range>
  </fieldset>
</div>

<style>
  .fluid-compare {
    --_h1: light-dark(oklch(0.575 0.163 255.5), oklch(0.622 0.161 255.1));
    --_h2: light-dark(oklch(0.671 0.175 40.6), oklch(0.622 0.173 40.1));
    --_h3: light-dark(oklch(0.62 0.141 162.1), oklch(0.621 0.128 163.1));
    --_h4: light-dark(oklch(0.64 0.161 75.1), oklch(0.67 0.143 73.2));
    --progress: progress(var(--viewport), var(--fluid-min), var(--fluid-max));

    container-type: inline-size;
    display: grid;
    gap: var(--ui-space-5);
    inline-size: 100%;
  }

  [data-step="h1"] {
    --_color: var(--_h1);
  }

  [data-step="h2"] {
    --_color: var(--_h2);
  }

  [data-step="h3"] {
    --_color: var(--_h3);
  }

  [data-step="h4"] {
    --_color: var(--_h4);
  }

  .fluid-compare-charts {
    display: grid;
    gap: var(--ui-space-4) var(--ui-space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .fluid-compare-chart {
    display: grid;
    gap: var(--ui-space-2);
    justify-items: stretch;
    margin: 0;
    min-inline-size: 0;
    text-align: start;

    & figcaption {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--ui-font-size-small);
      gap: var(--ui-space-2);

      & code {
        color: var(--ui-text-strong);
        font-weight: var(--ui-font-weight-bold);
      }
    }
  }

  .fluid-compare-plot {
    block-size: 7rem;
    border-block-end: var(--ui-border-width) solid var(--ui-border-color);
    border-block-start: var(--ui-border-width) dashed var(--ui-border-color);
    cursor: ew-resize;
    direction: ltr;
    margin-inline: 2.25rem 0.5rem;
    position: relative;
    touch-action: pan-y;
    user-select: none;

    & svg {
      block-size: 100%;
      inline-size: 100%;
      inset: 0;
      overflow: visible;
      position: absolute;
    }

    & path {
      fill: none;
      stroke: var(--_color);
      stroke-linejoin: round;
      stroke-width: 2px;
    }
  }

  .fluid-compare-chart[data-mode="progress"] path {
    stroke-dasharray: 6 18;

    &[data-step="h2"] {
      stroke-dashoffset: -6;
    }

    &[data-step="h3"] {
      stroke-dashoffset: -12;
    }

    &[data-step="h4"] {
      stroke-dashoffset: -18;
    }
  }

  .fluid-compare-y {
    color: var(--ui-text);
    font-size: var(--ui-font-size-caption);
    inset-inline-end: calc(100% + var(--ui-space-2));
    line-height: 1;
    position: absolute;
    translate: 0 -50%;

    &[data-end="max"] {
      inset-block-start: 0;
    }

    &[data-end="min"] {
      inset-block-start: 100%;
    }
  }

  .fluid-compare-window {
    background-color: oklch(from var(--ui-primary) l c h / 10%);
    border-inline: var(--ui-border-width) dashed
      oklch(from var(--ui-primary) l c h / 50%);
    inset-block: 0;
    inset-inline-end: calc((1 - var(--_window-end)) * 100%);
    inset-inline-start: calc(var(--_window-start) * 100%);
    position: absolute;
  }

  .fluid-compare-cursor {
    border-inline-start: var(--ui-border-width-thick) solid
      var(--ui-text-strong);
    inset-block: -0.25rem;
    inset-inline-start: calc(var(--_x) * 100%);
    position: absolute;
    translate: -50% 0;
  }

  .fluid-compare-dot {
    aspect-ratio: 1;
    background-color: var(--_color);
    border-radius: var(--ui-radius-round);
    box-shadow: 0 0 0 2px var(--ui-surface);
    inline-size: 0.625rem;
    inset-block-end: calc(var(--_growth) * 100%);
    inset-inline-start: calc(var(--_x) * 100%);
    position: absolute;
    translate: -50% 50%;

    [data-mode="progress"] > .fluid-compare-plot > & {
      --_growth: var(--progress);
    }

    @media (forced-colors: active) {
      box-shadow: none;
      forced-color-adjust: none;
    }
  }

  .fluid-compare-ticks {
    block-size: 1lh;
    color: var(--ui-text);
    direction: ltr;
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
    margin-inline: 2.25rem 0.5rem;
    position: relative;

    & span {
      inset-inline-start: calc(var(--_x) * 100%);
      position: absolute;
      translate: -50% 0;
    }

    & span:last-child {
      translate: -100% 0;
    }
  }

  .fluid-compare-stage {
    background-image: radial-gradient(
      oklch(from var(--ui-text) l c h / 5%) 1.45px,
      transparent 1.45px
    );
    background-size: 20px 20px;
    padding-block: var(--ui-space-3);
  }

  .fluid-compare-frame {
    inline-size: fit-content;
    max-inline-size: 100%;
    position: relative;
  }

  .fluid-compare-viewport {
    background-color: var(--ui-surface);
    border: var(--ui-border-width-thick) dashed var(--ui-border-color);
    border-radius: var(--ui-radius);
    box-sizing: border-box;
    display: grid;
    gap: var(--ui-space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    inline-size: var(--viewport);
    padding: var(--ui-space-3);
    zoom: var(--_scale, 1);

    @media (scripting: none) {
      inline-size: min(100cqi, var(--viewport));
    }
  }

  .fluid-compare-column {
    align-content: start;
    display: grid;
    gap: var(--ui-space-1);
    min-inline-size: 0;

    &[data-mode="clamp"] .fluid-compare-row {
      font-size: clamp(
        var(--_min),
        var(--viewport) * var(--_slope),
        var(--_max)
      );
    }

    &[data-mode="progress"] .fluid-compare-row {
      font-size: calc(
        var(--_min) + (var(--_max) - var(--_min)) * var(--progress)
      );
    }
  }

  .fluid-compare-column-title {
    font-size: var(--ui-font-size-small);
    margin: 0;
    zoom: calc(1 / var(--_scale, 1));

    & code {
      color: var(--ui-text-strong);
      font-weight: var(--ui-font-weight-bold);
    }
  }

  .fluid-compare-row {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--ui-space-2);
    line-height: 1.1;
    margin: 0;
  }

  .fluid-compare-sample {
    color: var(--ui-text-strong);
    font-weight: var(--ui-font-weight-bold);
  }

  .fluid-compare-readout {
    align-items: center;
    color: var(--ui-text);
    display: inline-flex;
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
    gap: var(--ui-space-1);
    line-height: 1.4;
    zoom: calc(1 / var(--_scale, 1));
  }

  .fluid-compare-key {
    align-items: center;
    display: inline-flex;
    gap: 0.25em;

    &:before {
      background-color: var(--_color);
      block-size: 0.625rem;
      border-radius: var(--ui-radius-round);
      content: "";
      inline-size: 0.625rem;

      @media (forced-colors: active) {
        forced-color-adjust: none;
      }
    }
  }

  .fluid-compare-width {
    background-color: var(--ui-surface);
    color: var(--ui-text);
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
    inset-block-start: 0;
    inset-inline-end: var(--ui-space-3);
    line-height: 1;
    padding-inline: var(--ui-space-1);
    position: absolute;
    translate: 0 -50%;
  }

  .fluid-compare-knobs {
    border: 0;
    display: grid;
    gap: var(--ui-space-3) var(--ui-space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin: 0;
    min-inline-size: 0;
    padding: 0;

    & code {
      font-size: var(--ui-font-size-caption);
      overflow-wrap: anywhere;
    }
  }
</style>

<script>
  import { drag } from "./drag"

  document
    .querySelectorAll<HTMLElement>(".fluid-compare")
    .forEach((compare) => {
      const inputs = [
        ...compare.querySelectorAll<HTMLInputElement>("input[type=range]"),
      ]
      const viewportInput = inputs.find(
        (input) => input.dataset.property === "--viewport",
      )
      const frame = compare.querySelector<HTMLElement>(".fluid-compare-frame")
      const handle = compare.querySelector<HTMLElement>(".drag-handle")
      const value = (property: string) =>
        Number(
          inputs.find((input) => input.dataset.property === property)?.value,
        )
      const length = (property: string) =>
        Number.parseFloat(compare.style.getPropertyValue(property))
      const domain = {
        max: length("--_domain-max"),
        min: length("--_domain-min"),
      }
      const fraction = (px: number) =>
        (px - domain.min) / (domain.max - domain.min)
      const scale = () => Math.min(1, compare.clientWidth / value("--viewport"))

      const render = () => {
        inputs.forEach((input) =>
          compare.style.setProperty(
            input.dataset.property ?? "",
            `${input.value}px`,
          ),
        )
        const start = fraction(value("--fluid-min"))
        const end = fraction(value("--fluid-max"))
        compare.style.setProperty("--_scale", String(scale()))
        compare.style.setProperty("--_window-end", String(end))
        compare.style.setProperty("--_window-start", String(start))
        compare.style.setProperty("--_x", String(fraction(value("--viewport"))))
        compare
          .querySelectorAll('[data-mode="progress"] path')
          .forEach((path) =>
            path.setAttribute(
              "d",
              `M 0 100 L ${start * 1000} 100 L ${end * 1000} 0 L 1000 0`,
            ),
          )
        const width = compare.querySelector(".fluid-compare-width")
        if (width) width.textContent = `${value("--viewport")}px`
        const rem = Number.parseFloat(
          getComputedStyle(document.documentElement).fontSize,
        )
        compare
          .querySelectorAll<HTMLElement>(".fluid-compare-column")
          .forEach((column) => {
            column
              .querySelectorAll<HTMLElement>(".fluid-compare-row")
              .forEach((row) => {
                const key = row.querySelector<HTMLElement>(".fluid-compare-key")
                const size = row.querySelector("[data-size]")
                const px = Number.parseFloat(getComputedStyle(row).fontSize)
                const min = Number.parseFloat(
                  row.style.getPropertyValue("--_min"),
                )
                const max = Number.parseFloat(
                  row.style.getPropertyValue("--_max"),
                )
                const share = Math.min(
                  Math.max((px / rem - min) / (max - min), 0),
                  1,
                )
                if (size) {
                  size.textContent = `${px.toFixed(1)}px, ${Math.round(share * 100)}%`
                }
                if (column.dataset.mode === "clamp") {
                  compare
                    .querySelector<HTMLElement>(
                      `[data-mode="clamp"] .fluid-compare-dot[data-step="${key?.dataset.step}"]`,
                    )
                    ?.style.setProperty("--_growth", String(share))
                }
              })
          })
      }

      const setViewport = (px: number) => {
        if (!viewportInput) return
        viewportInput.value = String(px)
        viewportInput.dispatchEvent(new Event("input", { bubbles: true }))
      }

      if (frame && handle) {
        let origin = { px: 0, viewport: 0 }
        drag(handle, {
          move: (event) => {
            const moved = event.clientX - origin.px
            setViewport(
              origin.viewport +
                (getComputedStyle(frame).direction === "rtl" ? -moved : moved),
            )
          },
          root: compare,
          start: (event) => {
            origin = { px: event.clientX, viewport: value("--viewport") }
          },
        })
      }
      compare
        .querySelectorAll<HTMLElement>(".fluid-compare-plot")
        .forEach((plot) => {
          const move = (event: PointerEvent) => {
            const rect = plot.getBoundingClientRect()
            setViewport(
              domain.min +
                ((event.clientX - rect.left) / rect.width) *
                  (domain.max - domain.min),
            )
          }
          drag(plot, { move, root: compare, start: move })
        })

      let fitted = 0
      const fit = () => {
        if (compare.clientWidth === fitted) return
        fitted = compare.clientWidth
        render()
      }

      inputs.forEach((input) => input.addEventListener("input", render))
      new ResizeObserver(fit).observe(compare)
    })
</script>
