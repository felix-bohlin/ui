---
import { Range } from "opui-css/astro"

type Props = {
  label: string
  min?: number
}

const { label, min = 160 } = Astro.props
const max = 960
---

<div class="resizable" style={`--_min: ${min}px`}>
  <div class="resizable-frame">
    <slot />
    <span aria-hidden="true" class="resizable-width"></span>
    <span aria-hidden="true" class="resizable-handle"></span>
  </div>
  <Range
    class="resizable-range"
    label={label}
    max={max}
    min={min}
    step={10}
    value={max}
    valueSuffix="px"
  />
</div>

<style>
  .resizable {
    --_chrome: calc(2 * (var(--ui-space-4) + var(--ui-border-width-thick)));

    container-type: inline-size;
    display: grid;
    gap: var(--ui-space-5);
    inline-size: 100%;
    padding-block: var(--ui-space-3);
  }

  .resizable-frame {
    border: var(--ui-border-width-thick) dashed var(--ui-border-color);
    border-radius: var(--ui-radius);
    box-sizing: content-box;
    display: grid;
    gap: var(--ui-space-4);
    inline-size: clamp(
      var(--_min),
      var(--_size, 100cqi),
      calc(100cqi - var(--_chrome))
    );
    padding: var(--ui-space-4);
    position: relative;
  }

  .resizable-width {
    background-color: var(--ui-surface);
    color: var(--ui-text);
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
    inset-block-start: 0;
    inset-inline-end: var(--ui-space-3);
    line-height: 1;
    padding-inline: var(--ui-space-1);
    position: absolute;
    translate: 0 -50%;

    &:empty {
      display: none;
    }
  }

  .resizable-handle {
    align-items: center;
    background-color: var(--ui-surface);
    block-size: 3rem;
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-round);
    cursor: ew-resize;
    display: grid;
    inline-size: 1rem;
    inset-block-start: 50%;
    inset-inline-start: 100%;
    justify-items: center;
    position: absolute;
    touch-action: none;
    translate: -50% -50%;

    &:before {
      block-size: 1.25rem;
      border-inline: var(--ui-border-width) solid var(--ui-text);
      content: "";
      inline-size: 0.25rem;
    }

    &:hover,
    .resizable[data-dragging] & {
      border-color: var(--ui-primary);
    }

    &:dir(rtl) {
      translate: 50% -50%;
    }
  }

  @media (scripting: none) {
    .resizable-handle,
    .resizable :global(.resizable-range) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".resizable").forEach((resizable) => {
    const frame = resizable.querySelector<HTMLElement>(".resizable-frame")
    const handle = resizable.querySelector<HTMLElement>(".resizable-handle")
    const width = resizable.querySelector(".resizable-width")
    const input = resizable.querySelector<HTMLInputElement>(
      ".resizable-range input[type=range]",
    )
    if (!frame || !handle || !input) return

    const chrome = () => {
      const style = getComputedStyle(frame)
      return [
        style.borderInlineStartWidth,
        style.borderInlineEndWidth,
        style.paddingInlineStart,
        style.paddingInlineEnd,
      ].reduce((sum, value) => sum + Number.parseFloat(value), 0)
    }

    const render = () => {
      resizable.style.setProperty("--_size", `${input.value}px`)
      if (width) width.textContent = `${input.value}px`
    }

    const set = (px: number) => {
      input.value = String(px)
      input.dispatchEvent(new Event("input", { bubbles: true }))
    }

    const fit = () => {
      const full = Number(input.max) - Number(input.value) < Number(input.step)
      input.max = String(Math.floor(resizable.clientWidth - chrome()))
      set(full ? Number(input.max) : Number(input.value))
    }

    handle.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return
      event.preventDefault()
      handle.setPointerCapture(event.pointerId)
      resizable.dataset.dragging = ""
      const rtl = getComputedStyle(frame).direction === "rtl"
      const move = (moveEvent: PointerEvent) => {
        const rect = frame.getBoundingClientRect()
        const outer = rtl
          ? rect.right - moveEvent.clientX
          : moveEvent.clientX - rect.left
        set(outer - chrome())
      }
      const end = () => {
        delete resizable.dataset.dragging
        handle.removeEventListener("pointermove", move)
      }
      handle.addEventListener("pointermove", move)
      handle.addEventListener("lostpointercapture", end, { once: true })
    })

    input.addEventListener("input", render)
    new ResizeObserver(fit).observe(resizable)
  })
</script>
