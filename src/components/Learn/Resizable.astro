---
type Props = {
  label: string
  min?: number
}

const { label, min = 160 } = Astro.props
---

<div class="resizable" data-min={min}>
  <div class="resizable-frame">
    <slot />
    <span aria-hidden="true" class="resizable-width"></span>
    <span
      aria-label={label}
      aria-orientation="vertical"
      aria-valuemin={min}
      class="resizable-handle"
      role="separator"
      tabindex="0"></span>
  </div>
</div>

<style>
  .resizable {
    container-type: inline-size;
    inline-size: 100%;
    padding-block: var(--ui-space-3);
  }

  .resizable-frame {
    border: var(--ui-border-width-thick) dashed var(--ui-border-color);
    border-radius: var(--ui-radius);
    box-sizing: border-box;
    display: grid;
    gap: var(--ui-space-4);
    inline-size: clamp(var(--_min, 10rem), var(--_size, 100cqi), 100cqi);
    padding: var(--ui-space-4);
    position: relative;
  }

  .resizable-width {
    background-color: var(--ui-surface);
    color: var(--ui-text);
    font-size: var(--ui-font-size-caption);
    font-variant-numeric: tabular-nums;
    inset-block-start: 0;
    inset-inline-end: var(--ui-space-3);
    line-height: 1;
    padding-inline: var(--ui-space-1);
    position: absolute;
    translate: 0 -50%;

    &:empty {
      display: none;
    }
  }

  .resizable-handle {
    align-items: center;
    background-color: var(--ui-surface);
    block-size: 3rem;
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-round);
    cursor: ew-resize;
    display: grid;
    inline-size: 1rem;
    inset-block-start: 50%;
    inset-inline-start: 100%;
    justify-items: center;
    position: absolute;
    touch-action: none;
    translate: -50% -50%;

    &:before {
      block-size: 1.25rem;
      border-inline: var(--ui-border-width) solid var(--ui-text);
      content: "";
      inline-size: 0.25rem;
    }

    &:hover,
    &:focus-visible,
    .resizable[data-dragging] & {
      border-color: var(--ui-primary);
    }

    &:focus-visible {
      outline: var(--ui-focus-ring-width) solid var(--ui-focus-ring-color);
      outline-offset: var(--ui-focus-ring-offset);
    }

    @media (scripting: none) {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".resizable").forEach((resizable) => {
    const frame = resizable.querySelector<HTMLElement>(".resizable-frame")
    const handle = resizable.querySelector<HTMLElement>(".resizable-handle")
    const width = resizable.querySelector(".resizable-width")
    if (!frame || !handle) return
    const min = Number(resizable.dataset.min)
    const max = () => resizable.clientWidth

    const set = (px: number) => {
      const size = Math.round(Math.min(Math.max(px, min), max()))
      resizable.style.setProperty("--_size", `${size}px`)
      sync()
    }

    const sync = () => {
      const size = Math.round(frame.getBoundingClientRect().width)
      const style = getComputedStyle(frame)
      const content = Math.round(
        size -
          [
            style.borderInlineStartWidth,
            style.borderInlineEndWidth,
            style.paddingInlineStart,
            style.paddingInlineEnd,
          ].reduce((sum, value) => sum + Number.parseFloat(value), 0),
      )
      handle.setAttribute("aria-valuemax", String(max()))
      handle.setAttribute("aria-valuenow", String(size))
      handle.setAttribute("aria-valuetext", `${content}px`)
      if (width) width.textContent = `${content}px`
    }

    resizable.style.setProperty("--_min", `${min}px`)

    handle.addEventListener("keydown", (event) => {
      const current = frame.getBoundingClientRect().width
      const by = event.shiftKey ? 50 : 10
      const next = {
        ArrowDown: current - by,
        ArrowLeft: current - by,
        ArrowRight: current + by,
        ArrowUp: current + by,
        End: max(),
        Home: min,
      }[event.key]
      if (next === undefined) return
      event.preventDefault()
      set(next)
    })

    handle.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return
      event.preventDefault()
      handle.setPointerCapture(event.pointerId)
      handle.focus()
      resizable.dataset.dragging = ""
      const move = (moveEvent: PointerEvent) =>
        set(moveEvent.clientX - frame.getBoundingClientRect().left)
      const end = () => {
        delete resizable.dataset.dragging
        handle.removeEventListener("pointermove", move)
      }
      handle.addEventListener("pointermove", move)
      handle.addEventListener("lostpointercapture", end, { once: true })
    })

    new ResizeObserver(sync).observe(resizable)
  })
</script>
