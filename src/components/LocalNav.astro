---
import TableOfContents from "./TableOfContents.astro"
import { Button, Drawer, DrawerContent, DrawerFooter } from "opui-css/astro"

type Props = {
  headings?: { id: string; level: number; text: string }[]
  showToc?: boolean
  sidebarDrawerId?: string
  sidebarLabel?: string
}

const {
  headings = [],
  showToc = true,
  sidebarDrawerId,
  sidebarLabel = "Pages",
} = Astro.props
---

<div class="local-nav">
  {sidebarDrawerId && <Button
    size="small"
    class="menu-button"
    commandfor={sidebarDrawerId}
    command="show-modal"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path
        fill="currentColor"
        d="M15.53 4.22a.75.75 0 0 1 0 1.06L8.81 12l6.72 6.72a.75.75 0 1 1-1.06 1.06l-7.25-7.25a.75.75 0 0 1 0-1.06l7.25-7.25a.75.75 0 0 1 1.06 0"
      />
    </svg>
    <span>{sidebarLabel}</span>
  </Button>}
  {showToc && <Button
    size="small"
    class="toc-button"
    commandfor="toc-dialog"
    command="show-modal"
  >
    <span>On this page</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path
        fill="currentColor"
        d="M8.47 4.22a.75.75 0 0 0 0 1.06L15.19 12l-6.72 6.72a.75.75 0 1 0 1.06 1.06l7.25-7.25a.75.75 0 0 0 0-1.06L9.53 4.22a.75.75 0 0 0-1.06 0"
      />
    </svg>
  </Button>}
</div>

{showToc && <Drawer
  aria-label="On this page"
  id="toc-dialog"
  backdrop="transparent"
  scrollLock
  side="inline-end"
  closedby="any"
>
  <DrawerContent>
    <TableOfContents headings={headings} variant="drawer" />
  </DrawerContent>
  <DrawerFooter>
    <Button size="small" commandfor="toc-dialog" command="close">
      Close
    </Button>
  </DrawerFooter>
</Drawer>}

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return
    const link = event.target.closest("#toc-dialog a[href]")
    if (!link) return
    link.closest("dialog")?.close()
  })

  const tocDialog = document.querySelector<HTMLDialogElement>("#toc-dialog")

  if (tocDialog && CSS.supports("selector(:target-current)")) {
    tocDialog.addEventListener("toggle", (event) => {
      if (event.newState !== "open") return
      tocDialog.querySelector<HTMLElement>("a:target-current")?.focus()
    })
  }
</script>

<style>
  .local-nav {
    align-items: center;
    display: flex;
    grid-column: 4 / 8;
    margin-inline-start: var(--size-2);
    padding-block: var(--size-2);
    padding-inline: var(--size-1);

    @media (width < 900px) {
      animation-fill-mode: both;
      animation-name: compact-local-nav;
      animation-range: 0 150px;
      animation-timeline: scroll();
      animation-timing-function: linear;
      grid-column: 1 / -1;
      margin-inline-start: 0;
    }

    @media (width >= 1140px) {
      display: none;
    }
  }

  .menu-button {
    @media (width >= 900px) {
      display: none;
    }
  }

  .toc-button {
    margin-inline-start: auto;
  }

  @keyframes compact-local-nav {
    to {
      padding-block: var(--size-1);
    }
  }
</style>
