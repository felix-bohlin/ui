---
type Props = {
  size?: number
  class?: string
}

const { size = 20, class: className } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  fill="none"
  stroke="oklch(0.55 0.13 150)"
  stroke-linecap="round"
  stroke-width="2"
>
  <path
    d="M7 3c-2 0-2.5 1-2.5 3v3c0 1.4-.8 2.4-2 3 1.2.6 2 1.6 2 3v3c0 2 .5 3 2.5 3"
  ></path>
  <path
    d="M17 3c2 0 2.5 1 2.5 3v3c0 1.4.8 2.4 2 3-1.2.6-2 1.6-2 3v3c0 2-.5 3-2.5 3"
  ></path>
  <path d="m14.5 8-5 8"></path>
  <circle cx="9.75" cy="8.75" r="1"></circle>
  <circle cx="14.25" cy="15.25" r="1"></circle>
</svg>
