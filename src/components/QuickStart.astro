---
import { Code } from "astro-expressive-code/components"
import { Accordion, Button } from "@opui/astro"
import type { Tab } from "./Installation.astro"
import { componentExportsFor } from "../utils/package-exports"
import { DEFAULT_FRAMEWORK, type FrameworkId } from "../utils/framework-routing"

type Props = {
  slug: string
  tabs: Tab[]
}

const { slug, tabs } = Astro.props
const { link } = Astro.locals

const framework = (Astro.currentLocale ?? DEFAULT_FRAMEWORK) as FrameworkId

const cssFiles = Object.keys(
  import.meta.glob("../../packages/opui/css/components/*.css"),
).map((path) => path.split("/").pop() ?? "")

const styles = tabs
  .filter((tab) => tab.code && !tab.seeAlso && cssFiles.includes(tab.title))
  .map((tab) => `opui-css/css/components/${tab.title}`)
  .sort((a, b) => a.localeCompare(b))

const exports = componentExportsFor(framework, slug)

const componentImport = () => {
  if (exports.length === 0) return []
  const names = exports.join(", ")
  const line = `import { ${names} } from "opui-css/${framework}"`
  return line.length <= 80
    ? [line]
    : [
        "import {",
        ...exports.map((name) => `  ${name},`),
        `} from "opui-css/${framework}"`,
      ]
}

const imports = [
  ...styles.map((style) => `import "${style}"`),
  ...componentImport(),
]

const snippets: Record<FrameworkId, { code: string; lang: string }> = {
  astro: {
    code: ["---", ...imports, "---"].join("\n"),
    lang: "astro",
  },
  html: {
    code: styles.map((style) => `@import "${style}";`).join("\n"),
    lang: "css",
  },
  vue: {
    code: ['<script setup lang="ts">', ...imports, "</script>"].join("\n"),
    lang: "vue",
  },
}

const { code, lang } = snippets[framework]
---

<div class="quick-start ui-not-rich-text">
  <Accordion variant="outlined">
    <Fragment slot="summary">Quick start</Fragment>
    <div class="ui-rich-text">
      {
        framework === "html" ? (
          <p>
            Run <code>npm install opui-css open-props</code> and import the
            styles, or copy the CSS source further down.
          </p>
        ) : (
          <p>
            Run <code>npm install opui-css open-props</code>, then import{" "}
            {exports.length > 0 ? "the component and its styles" : "the styles"}
            .
          </p>
        )
      }
      <Code code={code} lang={lang} />
    </div>
    <Fragment slot="actions">
      <Button href={link("/guide/getting-started")} size="small">
        Getting started
      </Button>
      <Button href="#installation" size="small">CSS source</Button>
    </Fragment>
  </Accordion>
</div>

<style>
  .quick-start {
    margin-block-end: var(--size-4);
  }
</style>
