---
import { Code } from "astro-expressive-code/components"
import { Accordion, Button } from "@opui/astro"
import type { Tab } from "./Installation.astro"
import { componentExportsFor } from "../utils/package-exports"
import { DEFAULT_FRAMEWORK, type FrameworkId } from "../utils/framework-routing"

type Props = {
  slug: string
  tabs: Tab[]
}

const { slug, tabs } = Astro.props
const { link } = Astro.locals

const framework = (Astro.currentLocale ?? DEFAULT_FRAMEWORK) as FrameworkId

const cssFiles = Object.keys(
  import.meta.glob("../../packages/opui/css/components/*.css"),
).map((path) => path.split("/").pop() ?? "")

const styles = tabs
  .filter((tab) => tab.code && !tab.seeAlso && cssFiles.includes(tab.title))
  .map((tab) => `opui-css/css/components/${tab.title}`)
  .sort((a, b) => a.localeCompare(b))

const exports = componentExportsFor(framework, slug)

const componentImport = () => {
  if (exports.length === 0) return []
  const names = exports.join(", ")
  const line = `import { ${names} } from "opui-css/${framework}"`
  return line.length <= 80
    ? [line]
    : [
        "import {",
        ...exports.map((name) => `  ${name},`),
        `} from "opui-css/${framework}"`,
      ]
}

const imports = [
  ...styles.map((style) => `import "${style}"`),
  ...componentImport(),
]

const install = { code: "npm install opui-css open-props", lang: "sh" }

const usage: Record<FrameworkId, { code: string; lang: string }> = {
  astro: {
    code: ["---", ...imports, "---"].join("\n"),
    lang: "astro",
  },
  html: {
    code: styles.map((style) => `@import "${style}";`).join("\n"),
    lang: "css",
  },
  vue: {
    code: ['<script setup lang="ts">', ...imports, "</script>"].join("\n"),
    lang: "vue",
  },
}

const cdn = {
  code: '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/opui-css/dist/opui.css" />',
  lang: "html",
}

const options = [
  { blocks: [install, usage[framework]], label: "npm" },
  ...(framework === "html"
    ? [
        { blocks: [cdn], label: "CDN" },
        { blocks: [], label: "Copy the CSS" },
      ]
    : []),
]
---

<div class="quick-start ui-not-rich-text">
  <Accordion variant="outlined">
    <Fragment slot="summary">
      Quick start
      <span class="quick-start-hint">
        {options.map((option) => option.label).join(" · ")}
      </span>
    </Fragment>
    <div class="ui-rich-text">
      {
        options.map((option) => (
          <>
            <h3>{option.label}</h3>
            {option.blocks.map((block) => (
              <Code code={block.code} frame="none" lang={block.lang} />
            ))}
            {option.blocks.length === 0 && (
              <div class="ui-not-rich-text">
                <Button href="#installation" size="small" variant="outlined">
                  Jump to source
                </Button>
              </div>
            )}
          </>
        ))
      }
    </div>
    <Fragment slot="actions">
      <Button href={link("/guide/getting-started")} size="small">
        Full setup guide
      </Button>
    </Fragment>
  </Accordion>
</div>

<style>
  .quick-start {
    margin-block-end: var(--size-4);

    .quick-start-hint {
      color: var(--text-muted);
      font-weight: 400;
      margin-inline-start: var(--size-2);
    }

    .ui-rich-text h3 {
      font-size: var(--font-size-1);
      margin-block: var(--size-3) var(--size-2);

      &:first-child {
        margin-block-start: 0;
      }
    }

    .ui-rich-text :global(.expressive-code + .expressive-code) {
      margin-block-start: var(--size-2);
    }
  }
</style>
