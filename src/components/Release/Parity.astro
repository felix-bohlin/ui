---
import { ToggleButton, ToggleGroup } from "opui-css/astro"
import {
  examplePath,
  exampleModules,
  exampleSources,
} from "../../utils/examples"
import { FRAMEWORKS, type FrameworkId } from "../../utils/framework"
import AstroLogo from "../AstroLogo.astro"
import Html5Logo from "../Html5Logo.astro"
import ReactLogo from "../ReactLogo.astro"
import SvelteLogo from "../SvelteLogo.astro"
import VueLogo from "../VueLogo.astro"

const id = "parity"
const slug = "card"
const name = "Clickable"
const reference: FrameworkId = "astro"
const groupName = `${id}-framework`

const logos = {
  astro: AstroLogo,
  html: Html5Logo,
  react: ReactLogo,
  svelte: SvelteLogo,
  vue: VueLogo,
}

const parts: Record<string, string> = {
  Button: "button",
  Card: "card",
  CardActions: "cardactions",
  CardContent: "cardcontent",
  CardHeader: "cardheader",
  outlined: "outlined",
  "ui-actions": "cardactions",
  "ui-button": "button",
  "ui-card": "card",
  "ui-card-link": "cardlink",
  "ui-content": "cardcontent",
  "ui-header": "cardheader",
  "ui-outlined": "outlined",
}

const PART_TOKEN =
  /(<\/?)?\b(CardActions|CardContent|CardHeader|Card|Button|ui-card-link|ui-actions|ui-button|ui-card|ui-content|ui-header|ui-outlined|outlined)\b/g

const escape = (text: string) =>
  text.replace(/[&<>]/g, (char) => `&#${char.charCodeAt(0)};`)

const markParts = (code: string) => {
  const opened: Record<string, number> = {}
  const stacks: Record<string, number[]> = {}
  let html = ""
  let last = 0
  for (const match of code.matchAll(PART_TOKEN)) {
    const [, prefix = "", token] = match
    const part = parts[token]
    const isTag = prefix.startsWith("<")
    const isImport = !isTag && /^[A-Z]/.test(token)
    let occurrence: string
    if (prefix === "</") {
      occurrence = `${stacks[part]?.pop() ?? 0}-close`
    } else if (isImport) {
      occurrence = "import"
    } else {
      opened[part] = (opened[part] ?? 0) + 1
      if (isTag) (stacks[part] ??= []).push(opened[part])
      occurrence = `${opened[part]}`
    }
    html += escape(code.slice(last, match.index)) + escape(prefix)
    html += `<mark class="parity-part" style="--parity-part: ${id}-${part}-${occurrence}">${token}</mark>`
    last = match.index + match[0].length
  }
  return html + escape(code.slice(last))
}

const source = (framework: FrameworkId) => {
  const code = exampleSources[examplePath(slug, name, framework)]
  if (!code) {
    throw new Error(`Parity.astro: ${slug}/${name} has no ${framework} file`)
  }
  return code.trimEnd()
}

const renders = FRAMEWORKS.map(({ id: framework, label }) => ({
  Component:
    framework === "html"
      ? undefined
      : exampleModules[examplePath(slug, name, framework)]?.default,
  Logo: logos[framework],
  framework,
  html: framework === "html" ? source("html") : undefined,
  label,
  marked: markParts(source(framework)),
}))

const stage = renders.find((render) => render.framework === reference)!
const others = renders.filter((render) => render.framework !== reference)

const activeSourceCss = FRAMEWORKS.map(
  ({ id: framework }) =>
    `#${id}:is([data-framework="${framework}"], :not([data-framework]):has([name="${groupName}"][value="${framework}"]:checked)) .parity-source[data-framework="${framework}"] { display: block; view-transition-name: ${id}-code; }
#${id}:is([data-framework="${framework}"], :not([data-framework]):has([name="${groupName}"][value="${framework}"]:checked)) .parity-source[data-framework="${framework}"] .parity-part { view-transition-name: var(--parity-part); }`,
).join("\n")
---

<div class="parity ui-not-rich-text" id={id}>
  <div class="parity-stage">
    <div class="parity-render example-preview" data-framework={stage.framework}>
      {stage.Component && <stage.Component />}
    </div>
    <div class="parity-verdict" hidden>
      <p class="parity-stamp">
        Identical markup in {FRAMEWORKS.length} frameworks
      </p>
      <p class="parity-note">
        Compared in your browser just now, the same way the test suite does it.
      </p>
      <details class="parity-diffs" hidden>
        <summary>Show the differences</summary>
      </details>
    </div>
    <div class="parity-others" hidden inert>
      {
        others.map(({ Component, framework, html }) => (
          <div class="parity-render example-preview" data-framework={framework}>
            {html ? <Fragment set:html={html} /> : Component && <Component />}
          </div>
        ))
      }
    </div>
  </div>
  <div class="parity-morph">
    <ToggleGroup
      aria-label="Framework"
      class="parity-toggle"
      name={groupName}
      size="small"
    >
      {
        renders.map(({ Logo, framework, label }) => (
          <ToggleButton checked={framework === reference} value={framework}>
            <span aria-hidden="true" class="parity-logo">
              <Logo />
            </span>
            {label}
          </ToggleButton>
        ))
      }
    </ToggleGroup>
    <div class="parity-code">
      {
        renders.map(({ framework, marked }) => (
          <pre
            class="parity-source"
            data-framework={framework}
            set:html={`<code>${marked}</code>`}
          />
        ))
      }
    </div>
  </div>
</div>

<style is:inline set:html={activeSourceCss}></style>

<style is:global>
  .parity {
    align-items: start;
    container-type: inline-size;
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: minmax(0, 1fr);
    margin-block: var(--ui-space-5);

    @container (inline-size >= 48rem) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }

  .parity-stage {
    display: grid;
    gap: var(--ui-space-3);
    position: relative;
  }

  .parity-render {
    background-color: var(--ui-surface);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-large);
    color: var(--ui-text);
    display: grid;
    font-family: var(--ui-font-body);
    gap: var(--ui-space-3);
    padding: var(--ui-space-4);

    & h3 {
      font-size: var(--ui-font-size-h6);
      margin: 0;
    }
  }

  .parity-verdict {
    display: grid;
    gap: var(--ui-space-2);
  }

  .parity-stamp {
    background-color: oklch(from var(--ui-surface) l c h / 85%);
    border: 0.2em double currentColor;
    border-radius: var(--ui-radius-small);
    color: var(--ui-success-text, var(--ui-success));
    font-family: var(--ui-font-body);
    font-size: clamp(0.7rem, 1.2cqi + 0.35rem, 1rem);
    font-weight: 800;
    inset-block-start: calc(-1 * var(--ui-space-4));
    inset-inline-end: calc(-1 * var(--ui-space-2));
    letter-spacing: 0.06em;
    line-height: 1.1;
    margin: 0;
    max-inline-size: 12em;
    padding: 0.4em 0.6em;
    pointer-events: none;
    position: absolute;
    rotate: -8deg;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    transform-origin: center;
    transition-duration: calc(var(--ui-duration-slow) * 1.5 * var(--ui-motion));
    transition-property: opacity, rotate, scale;
    transition-timing-function: linear(0, 1.18 55%, 0.94 76%, 1);

    @starting-style {
      opacity: 0;
      rotate: 6deg;
      scale: 2.4;
    }

    &.is-different {
      color: var(--ui-warning-text, var(--ui-warning));
    }
  }

  .parity-note {
    color: var(--ui-text-subtle);
    font-family: var(--ui-font-body);
    font-size: var(--ui-font-size-caption);
    margin: 0;
    text-align: end;
  }

  .parity-diffs {
    font-family: var(--ui-font-body);
    font-size: var(--ui-font-size-small);

    & summary {
      cursor: pointer;
    }

    & p {
      font-weight: var(--ui-font-weight-semibold);
      margin-block: var(--ui-space-2) var(--ui-space-1);
    }
  }

  .parity-diff {
    background-color: var(--ui-surface-tonal);
    border-radius: var(--ui-radius-small);
    font-family: var(--ui-font-code);
    font-size: var(--ui-font-size-caption);
    inline-size: 100%;
    line-height: 1.6;
    margin: 0;
    overflow-x: auto;
    padding: var(--ui-space-2);
    tab-size: 2;

    & del,
    & ins {
      display: block;
      text-decoration: none;
    }

    & del {
      background-color: oklch(from var(--ui-critical) l c h / 20%);
      color: var(--ui-critical-text, var(--ui-text));
    }

    & ins {
      background-color: oklch(from var(--ui-success) l c h / 20%);
      color: var(--ui-success-text, var(--ui-text));
    }

    & .parity-gap {
      display: block;
      opacity: 0.6;
    }
  }

  .parity-morph {
    display: grid;
    gap: var(--ui-space-3);
    min-inline-size: 0;
  }

  .parity-toggle {
    & .ui-toggle-button {
      flex: 1 1 auto;
    }
  }

  .parity-logo {
    display: inline-flex;

    & svg {
      block-size: 1.1em;
      inline-size: 1.1em;
    }
  }

  .parity-code {
    display: grid;
    min-inline-size: 0;
  }

  .parity-source {
    background-color: var(--ui-surface);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-large);
    color: var(--ui-text);
    display: none;
    font-family: var(--ui-font-code);
    font-size: var(--ui-font-size-caption);
    grid-area: 1 / 1;
    line-height: 1.45;
    margin: 0;
    min-inline-size: 0;
    overflow-x: auto;
    padding: var(--ui-space-3) var(--ui-space-2);
    tab-size: 2;
    view-transition-class: parity-code;
    view-transition-group: contain;

    & code {
      background: none;
      color: inherit;
      display: block;
      font: inherit;
      padding: 0;
      white-space: pre;
    }
  }

  .parity-part {
    background-color: var(--ui-surface-tonal);
    border-radius: var(--ui-radius-small);
    color: var(--ui-palette-text, var(--ui-text-strong));
    font-weight: var(--ui-font-weight-semibold);
    margin-inline: -0.15em;
    padding-inline: 0.15em;
    view-transition-class: parity-part;
    view-transition-name: none;
  }

  html.parity-morphing {
    view-transition-name: none;
  }

  ::view-transition-group(*.parity-code),
  ::view-transition-group(*.parity-part),
  ::view-transition-old(*.parity-code),
  ::view-transition-new(*.parity-code),
  ::view-transition-old(*.parity-part),
  ::view-transition-new(*.parity-part) {
    animation-duration: calc(var(--ui-duration-slow) * var(--ui-motion));
    animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  ::view-transition-group(*.parity-code) {
    overflow: clip;
  }

  ::view-transition-group(*.parity-part) {
    z-index: 1;
  }

  @media (scripting: none) {
    .parity-verdict {
      display: none;
    }
  }
</style>

<script>
  import { diffLines } from "diff"

  const DROPPED_ELEMENTS = new Set(["script", "style"])

  const DROPPED_ATTRIBUTE =
    /^(data-astro-|data-svelte-|data-v-|data-vue-|data-server-rendered$|on[a-z]+$|slot$)/

  const ID_REFERENCE_ATTRIBUTES = new Set([
    "anchor",
    "aria-activedescendant",
    "aria-controls",
    "aria-describedby",
    "aria-details",
    "aria-errormessage",
    "aria-flowto",
    "aria-labelledby",
    "aria-owns",
    "commandfor",
    "for",
    "form",
    "headers",
    "interestfor",
    "list",
    "popovertarget",
  ])

  const VOID_ELEMENTS = new Set([
    "area",
    "base",
    "br",
    "col",
    "embed",
    "hr",
    "img",
    "input",
    "link",
    "meta",
    "source",
    "track",
    "wbr",
  ])

  const INLINE_ELEMENTS = new Set([
    "a",
    "abbr",
    "b",
    "bdi",
    "bdo",
    "button",
    "cite",
    "code",
    "data",
    "del",
    "dfn",
    "em",
    "i",
    "img",
    "input",
    "ins",
    "kbd",
    "label",
    "mark",
    "meter",
    "output",
    "progress",
    "q",
    "s",
    "samp",
    "select",
    "small",
    "span",
    "strong",
    "sub",
    "sup",
    "svg",
    "textarea",
    "time",
    "u",
    "var",
  ])

  const GENERATED_NAME = /^(v-[\w-]+|[a-z][a-z-]*-\d+|([a-z][a-z-]*-)?_R_\w+_)$/

  const CONTEXT = 2

  const childrenOf = (node: Node) =>
    node instanceof HTMLTemplateElement
      ? [...node.content.childNodes]
      : [...node.childNodes]

  const collectIds = (nodes: Node[], ids: Map<string, string>) => {
    for (const node of nodes) {
      if (!(node instanceof Element) || DROPPED_ELEMENTS.has(node.localName)) {
        continue
      }
      const id = node.getAttribute("id")
      if (id && !ids.has(id)) ids.set(id, `id-${ids.size + 1}`)
      const name = node.getAttribute("name")
      if (name && GENERATED_NAME.test(name) && !ids.has(`name:${name}`)) {
        ids.set(`name:${name}`, `name-${ids.size + 1}`)
      }
      collectIds(childrenOf(node), ids)
    }
  }

  const normalizeAttribute = (
    name: string,
    value: string,
    ids: Map<string, string>,
  ) => {
    if (name === "class") {
      return value.split(/\s+/).filter(Boolean).toSorted().join(" ")
    }
    if (name === "id") return ids.get(value) ?? value
    if (name === "name") return ids.get(`name:${value}`) ?? value
    if (ID_REFERENCE_ATTRIBUTES.has(name)) {
      return value
        .split(/\s+/)
        .filter(Boolean)
        .map((token) => ids.get(token) ?? token)
        .join(" ")
    }
    if (name === "href" && value.startsWith("#")) {
      return `#${ids.get(value.slice(1)) ?? value.slice(1)}`
    }
    if (name === "style") {
      return value
        .split(";")
        .map((declaration) => declaration.trim().replace(/\s*:\s*/, ": "))
        .filter(Boolean)
        .map((declaration) => {
          const colon = declaration.indexOf(":")
          return colon === -1
            ? declaration
            : `${declaration.slice(0, colon).trim()}: ${declaration.slice(colon + 1).trim()}`
        })
        .join("; ")
    }
    return value.trim()
  }

  const serialize = (
    nodes: Node[],
    ids: Map<string, string>,
    depth: number,
  ): string[] => {
    const indent = "  ".repeat(depth)
    const lines: string[] = []

    let pending = ""
    let previousInline = false
    const flush = (nextInline: boolean) => {
      const text = pending.replace(/\s+/g, " ").trim()
      if (text) {
        const lead = previousInline && /^\s/.test(pending) ? "␣" : ""
        const trail = nextInline && /\s$/.test(pending) ? "␣" : ""
        lines.push(indent + lead + text + trail)
      }
      pending = ""
    }

    for (const node of nodes) {
      if (node instanceof Text) {
        pending += node.data
        continue
      }
      if (node instanceof Comment) continue
      const inline =
        node instanceof Element && INLINE_ELEMENTS.has(node.localName)
      flush(inline)
      previousInline = inline
      if (!(node instanceof Element) || DROPPED_ELEMENTS.has(node.localName)) {
        continue
      }

      const attrs = node
        .getAttributeNames()
        .filter((name) => !DROPPED_ATTRIBUTE.test(name))
        .map((name) => ({
          name,
          value: normalizeAttribute(name, node.getAttribute(name) ?? "", ids),
        }))
        .filter(
          (attr) =>
            !((attr.name === "class" || attr.name === "style") && !attr.value),
        )
        .toSorted((a, b) => a.name.localeCompare(b.name))
        .map((attr) =>
          attr.value ? `${attr.name}="${attr.value}"` : attr.name,
        )

      const open = `<${[node.localName, ...attrs].join(" ")}>`
      if (VOID_ELEMENTS.has(node.localName)) {
        lines.push(indent + open)
        continue
      }

      const children = serialize(childrenOf(node), ids, depth + 1)
      if (children.length === 0) {
        lines.push(`${indent}${open}</${node.localName}>`)
      } else if (children.length === 1 && !children[0].trim().startsWith("<")) {
        lines.push(`${indent}${open}${children[0].trim()}</${node.localName}>`)
      } else {
        lines.push(indent + open, ...children, `${indent}</${node.localName}>`)
      }
    }
    flush(false)

    return lines
  }

  const normalize = (root: Element) => {
    const nodes = childrenOf(root)
    const ids = new Map<string, string>()
    collectIds(nodes, ids)
    return serialize(nodes, ids, 0).join("\n") + "\n"
  }

  const diffOf = (expected: string, actual: string) => {
    const lines = diffLines(expected, actual).flatMap((part) =>
      part.value
        .replace(/\n$/, "")
        .split("\n")
        .map((line) => ({
          line,
          type: part.added ? "ins" : part.removed ? "del" : undefined,
        })),
    )
    const changed = lines.flatMap(({ type }, index) => (type ? [index] : []))
    const shown = new Set(
      changed.flatMap((index) =>
        Array.from({ length: CONTEXT * 2 + 1 }, (_, i) => index - CONTEXT + i),
      ),
    )

    const pre = document.createElement("pre")
    pre.className = "parity-diff"
    let gap = false
    lines.forEach(({ line, type }, index) => {
      if (!shown.has(index)) {
        gap = true
        return
      }
      if (gap && pre.childNodes.length) {
        const separator = document.createElement("span")
        separator.className = "parity-gap"
        separator.textContent = "..."
        pre.append(separator)
      }
      gap = false
      const element = type ? document.createElement(type) : null
      const text = `${type === "ins" ? "+" : type === "del" ? "-" : " "} ${line}\n`
      if (element) {
        element.textContent = text
        pre.append(element)
      } else {
        pre.append(text)
      }
    })
    return pre
  }

  const compare = (root: HTMLElement) => {
    const renders = [...root.querySelectorAll<HTMLElement>(".parity-render")]
    const markup = new Map(
      renders.map((render) => [
        render.dataset.framework ?? "",
        normalize(render),
      ]),
    )
    const reference = markup.get("astro") ?? ""
    const differing = [...markup].filter(
      ([framework, actual]) => framework !== "astro" && actual !== reference,
    )

    const verdict = root.querySelector<HTMLElement>(".parity-verdict")!
    const stamp = root.querySelector<HTMLElement>(".parity-stamp")!
    const diffs = root.querySelector<HTMLElement>(".parity-diffs")!
    if (differing.length) {
      stamp.classList.add("is-different")
      stamp.textContent = `Markup differs in ${differing.length} of ${markup.size} frameworks`
      for (const [framework, actual] of differing) {
        const label = document.createElement("p")
        label.textContent = `${framework} against astro`
        diffs.append(label, diffOf(reference, actual))
      }
      diffs.hidden = false
    }
    root.dataset.parity = differing.length
      ? differing.map(([framework]) => framework).join(" ")
      : "identical"
    verdict.hidden = false
  }

  const initMorph = (root: HTMLElement) => {
    const checked = root.querySelector<HTMLInputElement>(
      ".parity-toggle input:checked",
    )
    const groupName = checked?.name
    root.dataset.framework = checked?.value ?? "astro"
    let running = 0
    root.addEventListener("change", (event) => {
      const input = event.target
      if (!(input instanceof HTMLInputElement) || input.name !== groupName) {
        return
      }
      const swap = () => {
        root.dataset.framework = input.value
      }
      if (typeof document.startViewTransition !== "function") {
        swap()
        return
      }
      const html = document.documentElement
      html.classList.add("parity-morphing")
      running += 1
      document.startViewTransition(swap).finished.finally(() => {
        running -= 1
        if (running === 0) html.classList.remove("parity-morphing")
      })
    })
  }

  document.querySelectorAll<HTMLElement>(".parity").forEach((root) => {
    compare(root)
    initMorph(root)
  })
</script>
