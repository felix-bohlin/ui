---
import chipCss from "opui-css-5/css/components/chip?raw"
import Code from "../Code.astro"

const file = "chip.css"
const code = chipCss.replaceAll("\r\n", "\n").trimEnd()
const lineCount = code.split("\n").length

const notes = [
  { from: 1, text: "Layer plus :where(): any class overrides it", to: 2 },
  { from: 3, text: "Three private properties hold the colors", to: 5 },
  { from: 19, text: "A variant only swaps those properties", to: 28 },
  { from: 30, text: "Hover shade per scheme with light-dark()", to: 37 },
  { from: 39, text: ":has() fits the padding around icons", to: 53 },
  { from: 64, text: "A ripple from one radial gradient", to: 79 },
  { from: 81, text: "Disabled text mixed with color-mix()", to: 90 },
]

for (const note of notes) {
  if (note.to > lineCount || note.from > note.to) {
    throw new Error(
      `ReadableFive.astro: lines ${note.from} to ${note.to} are outside ${file} (${lineCount} lines)`,
    )
  }
}

const rows = (note: (typeof notes)[number]) =>
  `--readable-five-row: ${note.from} / ${note.to + 1}`
---

<figure
  class="readable-five ui-not-rich-text"
  id="readable-five"
  style={`--readable-five-lines: ${lineCount}`}
>
  <div class="readable-five-body">
    <div class="readable-five-code">
      <Code code={code} lang="css" />
      <div aria-hidden="true" class="readable-five-marks">
        {
          notes.map((note, index) => (
            <span class="readable-five-mark" style={rows(note)}>
              {index + 1}
            </span>
          ))
        }
      </div>
    </div>
    <ol class="readable-five-notes">
      {
        notes.map((note, index) => (
          <li class="readable-five-note" style={rows(note)}>
            <span aria-hidden="true" class="readable-five-number">
              {index + 1}
            </span>
            <span class="readable-five-text">
              <span class="ui-sr-only">
                Lines {note.from} to {note.to}:
              </span>
              {note.text}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption class="readable-five-caption">
    opui 5.4.3, {file}, {lineCount} lines
  </figcaption>
</figure>

<style is:global>
  .readable-five {
    --readable-five-font-size: 0.75rem;
    --readable-five-line-height: 1.65;
    --readable-five-pad: calc(1rem + 1.5px);
    --readable-five-row: auto;

    container-type: inline-size;
    display: grid;
    gap: var(--ui-space-2);
    margin: var(--ui-space-5) 0;

    & .code-block code {
      font-size: var(--readable-five-font-size);
      line-height: var(--readable-five-line-height);
    }
  }

  .readable-five-body {
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: minmax(0, 1fr);
  }

  .readable-five-code {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    & > * {
      grid-area: 1 / 1;
    }
  }

  .readable-five-marks,
  .readable-five-notes {
    display: grid;
    font-size: var(--readable-five-font-size);
    grid-template-rows: repeat(var(--readable-five-lines), 1lh);
    line-height: var(--readable-five-line-height);
    padding-block-start: var(--readable-five-pad);
  }

  .readable-five-marks {
    align-self: start;
    display: none;
    inline-size: 2rem;
    pointer-events: none;
  }

  .readable-five-mark {
    align-self: start;
    background-color: var(--ui-primary);
    block-size: 1lh;
    border-radius: var(--ui-radius-round);
    color: var(--ui-on-primary);
    display: grid;
    font-family: var(--ui-font-body);
    font-size: var(--ui-font-size-caption);
    font-weight: var(--ui-font-weight-bold);
    grid-column: 1;
    grid-row: var(--readable-five-row);
    inline-size: 1lh;
    justify-self: center;
    line-height: 1;
    place-items: center;
  }

  .readable-five-notes {
    color: var(--ui-text);
    list-style: none;
    margin: 0;
    padding-inline: 0;
  }

  .readable-five-note {
    align-items: start;
    display: flex;
    gap: var(--ui-space-2);
    grid-column: 1;
  }

  .readable-five-number {
    background-color: var(--ui-primary);
    block-size: 1.5em;
    border-radius: var(--ui-radius-round);
    color: var(--ui-on-primary);
    display: grid;
    flex-shrink: 0;
    font-size: var(--ui-font-size-caption);
    font-weight: var(--ui-font-weight-bold);
    inline-size: 1.5em;
    line-height: 1;
    place-items: center;
  }

  .readable-five-text {
    font-family: var(--ui-font-body);
    font-size: var(--ui-font-size-small);
    line-height: var(--ui-line-height-tight);
    padding-block-start: 0.1em;
  }

  .readable-five-caption {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-caption);
  }

  @container (inline-size >= 44rem) {
    .readable-five-body {
      gap: var(--ui-space-3);
      grid-template-columns: minmax(0, 1fr) 13rem;
    }

    .readable-five-note {
      block-size: 100%;
      border-inline-start: var(--ui-border-width-thick) solid
        var(--ui-palette-border);
      grid-row: var(--readable-five-row);
      padding-inline-start: var(--ui-space-2);
    }
  }

  @container (inline-size < 44rem) {
    .readable-five .code-block pre {
      padding-inline-start: 2.25rem;
    }

    .readable-five-marks {
      display: grid;
    }

    .readable-five-notes {
      gap: var(--ui-space-2);
      grid-template-rows: none;
      padding-block-start: 0;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .readable-five-note,
      .readable-five-mark {
        animation: readable-five-in linear both;
        animation-range: cover 5% cover 25%;
        animation-timeline: view();
      }
    }
  }

  @keyframes readable-five-in {
    from {
      opacity: 0;
      translate: 1.5rem 0;
    }

    to {
      opacity: 1;
      translate: none;
    }
  }
</style>
