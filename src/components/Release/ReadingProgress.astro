<div aria-hidden="true" class="reading-progress"></div>

<style is:global>
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (width >= 1140px) {
      .page-contents nav[data-toc-selector] {
        anchor-name: --page-toc;
      }

      .reading-progress {
        background-color: var(--ui-border-color);
        block-size: anchor-size(--page-toc block);
        border-radius: var(--ui-radius-round);
        display: block;
        inline-size: 2px;
        inset-block-start: anchor(--page-toc top);
        inset-inline-start: calc(anchor(--page-toc left) - var(--site-gap) / 2);
        margin: 0;
        overflow: clip;
        pointer-events: none;
        position: fixed;
        position-anchor: --page-toc;
        z-index: 1;

        &::before {
          animation: reading-progress-fill linear both;
          animation-timeline: scroll(root block);
          background-color: var(--ui-primary);
          content: "";
          inset: 0;
          position: absolute;
          transform-origin: top;
        }
      }
    }
  }

  @keyframes reading-progress-fill {
    from {
      scale: 1 0;
    }

    to {
      scale: 1 1;
    }
  }
</style>
