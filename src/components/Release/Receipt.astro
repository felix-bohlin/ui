---
import { ToggleButton } from "opui-css/astro"
import newCss from "@opui/css/components/button.css?raw"
import oldCss from "opui-css-5/css/components/button?raw"

const id = "receipt"
const newLines = newCss.trimEnd().split("\n")
const oldLines = oldCss.trimEnd().split(/\r?\n/)

type Span = {
  at: RegExp | string
  count?: number
  ends?: boolean
  from?: number
  offsets?: number[]
}

type Feature = {
  color: string
  id: string
  label: string
  rule: string
  spans: Span[]
}

const features: Feature[] = [
  {
    color: "var(--ui-blue)",
    id: "button-group",
    label: "Button Group",
    rule: "Selectors that pass a Button Group's color, size and variant down to its buttons.",
    spans: [
      { at: "/* Color inherited from Button Group. */" },
      { at: /^:where\(\.ui-button-group[^)]*\) > [&*]( \{)?$/ },
    ],
  },
  {
    color: "oklch(from var(--ui-blue) l c calc(h + 50))",
    id: "card-actions",
    label: "Card actions",
    rule: "The shift that lines the first or last text button up with the padding of Card and Accordion actions and Dialog footers.",
    spans: [
      { at: "--_actions-shift: min(", count: 8 },
      { at: "/* Card and Accordion actions, Dialog footer */", count: 27 },
    ],
  },
  {
    color: "var(--ui-neutral)",
    id: "compat",
    label: "Compat",
    rule: "A prefixed copy of a standard property, for engines that still need the prefix.",
    spans: [{ at: "-webkit-user-select: none;" }],
  },
  {
    color: "var(--ui-red)",
    id: "contrast",
    label: "Contrast",
    rule: "Text and fill colors clamped by contrast knobs or read from <code>-text</code> roles, and the <code>@container style(--ui-contrast: more)</code> block.",
    spans: [
      { at: "--_accent-text: light-dark(", count: 7 },
      { at: "--_accent-fill: oklch(", count: 3 },
      { at: "--_accent-text: var(--ui-critical-text);" },
      { at: "--_accent-text: var(--ui-primary-text);" },
      { at: "@container style(--ui-contrast: more) {", count: 4, from: -1 },
    ],
  },
  {
    color: "oklch(from var(--ui-green) l c calc(h + 50))",
    id: "density",
    label: "Density",
    rule: "Block padding that shrinks with the control size, which follows <code>--ui-density</code>.",
    spans: [{ at: "padding-block: min(", count: 3, from: 1 }],
  },
  {
    color: "var(--ui-orange)",
    id: "icon-buttons",
    label: "Icon buttons",
    rule: "The icon-only square and the tighter padding on the icon side, which replace the 5.x IconButton.",
    spans: [
      { at: "--_icon-size: 0.7lh;" },
      { at: "&:where(:has(> svg:first-child + *)) {", count: 7 },
      { at: "&:where(:has(> svg:only-child)) {", count: 6, from: -1 },
    ],
  },
  {
    color: "var(--ui-green)",
    id: "state-layer",
    label: "State layer",
    rule: "The <code>@container style(--ui-button-hover: layer)</code> block, and the outlined and tonal hover and active defaults that exist so it can swap them.",
    spans: [
      {
        at: "--_outlined-active-bg-color: var(--_filled-active-bg-color);",
        count: 6,
      },
      {
        at: "--_tonal-active-bg-color: var(--_outlined-active-bg-color);",
        count: 4,
      },
      { at: "@container style(--ui-button-hover: layer) {", count: 31 },
    ],
  },
  {
    color: "oklch(from var(--ui-red) l c calc(h - 45))",
    id: "themes",
    label: "Themes",
    rule: "Optional <code>--ui-button-*</code> and <code>--ui-control-*</code> hooks, the shadow and hover lift, and filled hover colors that work for any accent.",
    spans: [
      { at: "--ui-button-accent,", count: 3 },
      { at: "--_accent-fill: var(--ui-button-accent-filled, var(--_accent));" },
      {
        at: "/* Lightens accents darker than L 0.3, darkens the rest */",
        offsets: [0, 2, 4, 5],
      },
      { at: "--ui-button-on-accent,", count: 3 },
      {
        at: "--_on-accent-fill: var(--ui-button-on-accent-filled, var(--_on-accent));",
      },
      { at: "--_shadow: none;" },
      { at: "box-shadow: var(--_shadow);" },
      { at: "translate var(--_duration) var(--_ease);" },
      { at: "--_on-accent-fill: var(--_on-accent);" },
      { at: "--_accent-fill: var(--_accent);" },
      {
        at: "--_accent-tonal: var(--ui-primary-tonal, var(--ui-palette-tint));",
      },
      {
        at: "--_on-accent-tonal: var(--ui-on-primary-tonal, var(--ui-palette-on-tint));",
      },
      { at: "--ui-control-border-color,", count: 3 },
      { at: "&:is(.ui-filled, .ui-outlined, .ui-tonal) {", count: 17 },
    ],
  },
  {
    color: "oklch(from var(--ui-orange) l c calc(h + 35))",
    id: "touch",
    label: "Touch screens",
    rule: "The <code>@media (hover: hover)</code> lines that keep hover colors off touch screens. Inside the themes block they stay themes.",
    spans: [{ at: "@media (hover: hover) {", ends: true }],
  },
]

const tags: (string | undefined)[] = newLines.map(() => undefined)
const trimmed = newLines.map((line) => line.trim())

const closingLine = (start: number) => {
  let depth = 0
  for (let index = start; index < newLines.length; index++) {
    depth += (newLines[index].match(/\{/g) ?? []).length
    depth -= (newLines[index].match(/\}/g) ?? []).length
    if (depth === 0) return index
  }
  throw new Error(`Receipt.astro: no closing brace for line ${start + 1}`)
}

for (const feature of features) {
  for (const span of feature.spans) {
    const starts = trimmed.flatMap((line, index) =>
      (typeof span.at === "string" ? line === span.at : span.at.test(line))
        ? [index]
        : [],
    )
    if (starts.length === 0) {
      throw new Error(
        `Receipt.astro: "${span.at}" (${feature.label}) is no longer in button.css`,
      )
    }
    for (const start of starts) {
      const first = start + (span.from ?? 0)
      const lines = span.ends
        ? [start, closingLine(start)]
        : span.offsets
          ? span.offsets.map((offset) => first + offset)
          : Array.from({ length: span.count ?? 1 }, (_, index) => first + index)
      for (const line of lines) {
        if (tags[line] && span.ends) continue
        if (tags[line]) {
          throw new Error(
            `Receipt.astro: line ${line + 1} is tagged both ${tags[line]} and ${feature.id}`,
          )
        }
        tags[line] = feature.id
      }
    }
  }
}

const counts = Object.fromEntries(
  features.map((feature) => [
    feature.id,
    tags.filter((tag) => tag === feature.id).length,
  ]),
)
const baseCount = tags.filter((tag) => !tag).length
const lines = (count: number) => (count === 1 ? "line" : "lines")

const offWhen = (ids: string[]) =>
  `#${id}:has(.receipt-toggles :is(${ids.map((value) => `[value="${value}"]`).join(", ")}):not(:checked))`

const generatedCss = [
  `#${id} { --receipt-kept: calc(${newLines.length} ${features.map((feature) => `- var(--receipt-off-${feature.id}, 0)`).join(" ")}); }`,
  `${offWhen(features.map((feature) => feature.id))} .receipt-all { display: none; }`,
  `${offWhen(features.map((feature) => feature.id))} .receipt-without { display: inline; }`,
  ...features.flatMap((feature, index) => [
    `#${id} [data-tag="${feature.id}"] { --receipt-color: ${feature.color}; }`,
    `${offWhen([feature.id])} { --receipt-off-${feature.id}: ${counts[feature.id]}; }`,
    `${offWhen([feature.id])} .receipt-new [data-tag="${feature.id}"] { block-size: 0; color: var(--ui-text-subtle); opacity: 0; }`,
    `${offWhen([feature.id])} .receipt-off-name[data-tag="${feature.id}"] { display: inline; }`,
    ...(index > 0
      ? [
          `${offWhen(features.slice(0, index).map((earlier) => earlier.id))} .receipt-off-name[data-tag="${feature.id}"]::before { content: ", "; }`,
        ]
      : []),
  ]),
].join("\n")

const rules = [
  {
    count: baseCount,
    id: undefined,
    label: "Base",
    rule: "Everything else: the lines a button needs without those features. When only part of a multi-line declaration pays for a feature, its first line stays base and the extra lines get the tag.",
  },
  ...features.map((feature) => ({
    count: counts[feature.id],
    id: feature.id,
    label: feature.label,
    rule: feature.rule,
  })),
]
---

<div class="receipt ui-not-rich-text" id={id}>
  <fieldset class="receipt-toggles">
    <legend class="ui-sr-only">Features the 6.0 lines pay for</legend>
    {
      features.map((feature) => (
        <ToggleButton
          checked
          name={`${id}-feature`}
          size="small"
          value={feature.id}
        >
          <span aria-hidden="true" class="receipt-dot" data-tag={feature.id} />
          {feature.label}
          <span class="receipt-chip-count">
            {counts[feature.id]}
            <span class="ui-sr-only">{lines(counts[feature.id])}</span>
          </span>
        </ToggleButton>
      ))
    }
    <p class="receipt-base">No marker: base, {baseCount} lines</p>
  </fieldset>

  <p aria-live="polite" class="receipt-summary">
    <span class="receipt-all">6.0 with every feature:</span>
    <span class="receipt-without"
      >6.0 without {
        features.map((feature) => (
          <span
            class="receipt-off-name"
            data-tag={feature.id}
            set:text={feature.label}
          />
        ))
      }:</span
    >
    <span
      ><strong class="receipt-kept"></strong> lines, 5.4.3:
      <strong>{oldLines.length}</strong> lines</span
    >
  </p>

  <div class="receipt-columns">
    <div class="receipt-column">
      <p class="receipt-heading" id={`${id}-old`}>
        5.4.3 <code>button.css</code>
        <span class="receipt-count">{oldLines.length} lines</span>
      </p>
      <div
        aria-labelledby={`${id}-old`}
        class="receipt-scroll"
        role="region"
        tabindex="0"
      >
        <code class="receipt-code">
          {
            oldLines.map((line) => (
              <span class="receipt-line" set:text={line} />
            ))
          }
        </code>
      </div>
    </div>
    <div class="receipt-column receipt-new">
      <p class="receipt-heading" id={`${id}-new`}>
        6.0 <code>button.css</code>
        <span class="receipt-count"
          ><span class="receipt-kept"></span> of {newLines.length} lines</span
        >
      </p>
      <div
        aria-labelledby={`${id}-new`}
        class="receipt-scroll"
        role="region"
        tabindex="0"
      >
        <code class="receipt-code">
          {
            newLines.map((line, index) => (
              <span
                class="receipt-line"
                data-tag={tags[index]}
                set:text={line}
              />
            ))
          }
        </code>
      </div>
    </div>
  </div>

  <details class="receipt-rules">
    <summary>How each line is tagged</summary>
    <dl>
      {
        rules.map((rule) => (
          <div class="receipt-rule" data-tag={rule.id}>
            <dt>
              <span aria-hidden="true" class="receipt-dot" />
              {rule.label}, {rule.count} {lines(rule.count)}
            </dt>
            <dd set:html={rule.rule} />
          </div>
        ))
      }
    </dl>
  </details>
</div>

<style is:inline set:html={generatedCss}></style>

<style is:global>
  @property --receipt-kept {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  .receipt {
    --receipt-color: transparent;
    --receipt-kept: 0;

    container-type: inline-size;
    display: grid;
    gap: var(--ui-space-4);
    margin-block: var(--ui-space-5);
    transition: --receipt-kept
      calc(var(--ui-duration-slow) * 2 * var(--ui-motion)) var(--ui-ease);
  }

  .receipt-toggles {
    align-items: center;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-2);
    margin: 0;
    padding: 0;

    & .ui-toggle-button {
      gap: var(--ui-space-1);
    }
  }

  .receipt-dot {
    background-color: var(--receipt-color, var(--ui-border-color));
    block-size: 0.6rem;
    border: var(--ui-border-width) solid var(--ui-surface);
    border-radius: var(--ui-radius-round);
    box-sizing: content-box;
    flex-shrink: 0;
    inline-size: 0.6rem;
  }

  .receipt-rule:not([data-tag]) .receipt-dot {
    background-color: transparent;
    border-color: var(--ui-text-subtle);
  }

  .receipt-chip-count {
    font-variant-numeric: tabular-nums;
    font-weight: var(--ui-font-weight-normal);
    opacity: 0.8;
  }

  .receipt-base {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-caption);
    margin: 0;
  }

  .receipt-summary {
    column-gap: 0.3em;
    display: flex;
    flex-wrap: wrap;
    font-size: var(--ui-font-size-large);
    margin: 0;

    & strong {
      font-variant-numeric: tabular-nums;
    }
  }

  .receipt-kept::after {
    content: counter(receipt-kept);
    counter-reset: receipt-kept var(--receipt-kept);
  }

  .receipt-without,
  .receipt-off-name {
    display: none;
  }

  .receipt-columns {
    display: grid;
    gap: var(--ui-space-3);
    grid-template-columns: minmax(0, 1fr);
  }

  @container (inline-size >= 40rem) {
    .receipt-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (inline-size < 40rem) {
    .receipt .receipt-scroll {
      block-size: min(24rem, 60vh);
    }
  }

  .receipt-column {
    display: grid;
    gap: var(--ui-space-2);
    grid-template-rows: auto 1fr;
    min-inline-size: 0;
  }

  .receipt-heading {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    font-size: var(--ui-font-size-body);
    gap: 0 var(--ui-space-2);
    margin: 0;
  }

  .receipt-count {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-small);
    font-variant-numeric: tabular-nums;
    font-weight: var(--ui-font-weight-normal);
  }

  .receipt-scroll {
    background-color: var(--ui-surface);
    block-size: min(32rem, 70vh);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius);
    overflow: auto;
    overscroll-behavior: contain;

    &:focus-visible {
      outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
        var(--ui-focus-ring-color);
      outline-offset: var(--ui-focus-ring-offset);
    }
  }

  .receipt-code {
    background: none;
    border: 0;
    color: var(--ui-text);
    counter-reset: receipt-line;
    display: block;
    font-family: var(--ui-font-code);
    font-size: 0.7rem;
    inline-size: max-content;
    line-height: 1.6;
    min-inline-size: 100%;
    padding: var(--ui-space-2) var(--ui-space-3) var(--ui-space-2) 0;
  }

  .receipt-line {
    block-size: 1lh;
    border-inline-start: 0.3rem solid var(--receipt-color, transparent);
    counter-increment: receipt-line;
    display: block;
    overflow: clip;
    padding-inline-start: 3.5em;
    position: relative;
    transition:
      color calc(var(--ui-duration) * var(--ui-motion)) var(--ui-ease),
      block-size calc(var(--ui-duration-slow) * var(--ui-motion)) var(--ui-ease)
        calc(var(--ui-duration) * var(--ui-motion)),
      opacity calc(var(--ui-duration-slow) * var(--ui-motion)) var(--ui-ease)
        calc(var(--ui-duration) * var(--ui-motion));
    white-space: pre;

    &::before {
      color: var(--ui-text-subtle);
      content: counter(receipt-line);
      inline-size: 2.5em;
      inset-inline-start: 0;
      position: absolute;
      text-align: end;
    }
  }

  .receipt-rules {
    font-size: var(--ui-font-size-small);

    & summary {
      cursor: pointer;
      font-weight: var(--ui-font-weight-semibold);
    }

    & dl {
      display: grid;
      gap: var(--ui-space-2);
      margin: var(--ui-space-3) 0 0;
    }

    & dt {
      align-items: center;
      display: flex;
      font-weight: var(--ui-font-weight-semibold);
      gap: var(--ui-space-2);
    }

    & dd {
      color: var(--ui-text-subtle);
      margin: 0;
      padding-inline-start: calc(0.6rem + var(--ui-space-2));
    }
  }
</style>
