---
import { Button, Callout, CalloutContent, CalloutIcon } from "opui-css/astro"

const callouts = [
  { severity: "info", title: "Info" },
  { severity: "success", title: "Success" },
  { severity: "warning", title: "Warning" },
  { severity: "critical", title: "Critical" },
] as const

const panels = [
  {
    caption: "Your hue reaches the callouts.",
    label: "5.x",
    layers: [
      { name: "theme.palette" },
      { name: "theme.base" },
      { name: "severity scopes", nested: true },
      { name: "theme.custom", note: "your theme", wins: true },
    ],
    version: "5",
  },
  {
    caption: "Callouts keep their meaning.",
    label: "6.0",
    layers: [
      { name: "theme.palette" },
      { name: "theme.base" },
      { name: "theme.custom", note: "your theme" },
      { name: "theme.severity", wins: true },
    ],
    version: "6",
  },
]
---

<div class="severity-layers ui-not-rich-text" id="severity-layers">
  {
    panels.map((panel) => (
      <figure
        class="severity-layers-panel ui-palette"
        data-version={panel.version}
      >
        <p class="severity-layers-version">{panel.label}</p>
        <ol class="severity-layers-stack">
          {panel.layers.map((layer) => (
            <li
              data-nested={"nested" in layer ? "" : undefined}
              data-wins={layer.wins ? "" : undefined}
            >
              {"nested" in layer ? (
                <span>{layer.name}</span>
              ) : (
                <code>{layer.name}</code>
              )}
              {layer.note && (
                <span class="severity-layers-note">{layer.note}</span>
              )}
              {layer.wins && (
                <span class="severity-layers-wins">colors the callouts</span>
              )}
            </li>
          ))}
        </ol>
        <div class="severity-layers-stage">
          <Button color="primary" size="small" variant="filled">
            Save changes
          </Button>
          <div class="severity-layers-callouts">
            {callouts.map((callout) => (
              <Callout class="ui-palette" severity={callout.severity}>
                <CalloutIcon />
                <CalloutContent>
                  <p>{callout.title}</p>
                </CalloutContent>
              </Callout>
            ))}
          </div>
        </div>
        <figcaption>{panel.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style is:global>
  @layer theme.custom {
    .severity-layers-panel[data-version="6"] {
      &,
      & .ui-palette {
        --ui-palette-hue: 300;
        --ui-palette-source: oklch(0.58 0.21 300);
      }
    }
  }

  .severity-layers-panel[data-version="5"] {
    &,
    & .ui-palette {
      --ui-palette-hue: 300;
      --ui-palette-source: oklch(0.58 0.21 300);
    }
  }

  .severity-layers {
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin-block: var(--ui-space-5);
  }

  .severity-layers-panel {
    align-content: start;
    background-color: var(--ui-surface);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-large);
    color: var(--ui-text);
    display: grid;
    font-family: var(--ui-font-body);
    gap: var(--ui-space-3);
    justify-items: stretch;
    margin: 0;
    padding: var(--ui-space-4);

    & figcaption {
      color: var(--ui-text-strong);
      font-size: var(--ui-font-size-small);
      font-weight: var(--ui-font-weight-medium);
    }
  }

  .severity-layers-version {
    color: var(--ui-text-strong);
    font-family: var(--ui-font-heading, var(--ui-font-body));
    font-size: var(--ui-font-size-body);
    font-weight: var(--ui-font-weight-semibold);
    margin: 0;
  }

  .severity-layers-stack {
    display: grid;
    font-size: var(--ui-font-size-caption);
    gap: var(--ui-space-1);
    list-style: none;
    margin: 0;
    padding: 0;

    & li {
      align-items: baseline;
      border-radius: var(--ui-radius-small);
      color: var(--ui-text-subtle);
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--ui-space-2);
      padding: var(--ui-space-1) var(--ui-space-2) var(--ui-space-1)
        var(--ui-space-3);
    }

    & code {
      font-size: inherit;
    }

    & [data-nested] {
      margin-inline-start: var(--ui-space-4);
    }

    & [data-wins] {
      --_stripe: linear-gradient(
        var(--ui-palette-accent),
        var(--ui-palette-accent)
      );

      background-color: var(--ui-surface-tonal);
      background-image: var(--_stripe);
      background-repeat: no-repeat;
      background-size: var(--ui-space-1) 100%;
      color: var(--ui-text-strong);
      font-weight: var(--ui-font-weight-semibold);
    }
  }

  .severity-layers-panel[data-version="6"] [data-wins] {
    --_stripe: linear-gradient(
      var(--ui-info) 25%,
      var(--ui-success) 25% 50%,
      var(--ui-warning) 50% 75%,
      var(--ui-critical) 75%
    );
  }

  .severity-layers-note {
    font-weight: var(--ui-font-weight-normal);
  }

  .severity-layers-wins {
    color: var(--ui-text-subtle);
    font-weight: var(--ui-font-weight-normal);
  }

  .severity-layers-stage {
    display: grid;
    gap: var(--ui-space-2);
    justify-items: start;
  }

  .severity-layers-callouts {
    display: grid;
    gap: var(--ui-space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    inline-size: 100%;

    & .ui-callout {
      --_gap: var(--ui-space-2);
      --_icon-size: 1.125rem;
      --_padding: var(--ui-space-2);

      align-items: center;
    }

    & p {
      font-weight: var(--ui-font-weight-semibold);
      margin: 0;
    }
  }
</style>
