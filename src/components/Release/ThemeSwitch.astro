---
import {
  Badge,
  Button,
  Card,
  CardActions,
  CardContent,
  CardHeader,
  Checkbox,
  Chip,
  FieldLegend,
  Fieldset,
  Select,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import { EXAMPLE_THEMES } from "../../utils/example-themes"

const id = "theme-switch"

const stageOf = (name: string) =>
  `#${id}:has([name="${id}"][value="${name}"]:checked) .theme-switch-stage`

const rewrite = (css: string, from: string, to: string) => {
  if (!css.includes(from)) {
    throw new Error(`ThemeSwitch.astro: expected "${from}" in the theme CSS`)
  }
  return css.replaceAll(from, to)
}

const scopedCss = EXAMPLE_THEMES.map(({ css, name }) => {
  const rewrites = [
    [":where(html, .ui-palette, .ui-contrast-more)", "&"],
    ["html:not(.ui-contrast-normal)", "html:not(.ui-contrast-normal) &"],
    [
      ":where(.ui-contrast-more, .ui-contrast-more .ui-palette)",
      ":where(& .ui-contrast-more, .ui-contrast-more &)",
    ],
    ["@layer theme.custom {", `@layer theme.custom {\n${stageOf(name)} {`],
  ]
  const body = css.replace(/^@layer [^{]+;\n/gm, "").trimEnd()
  return `${rewrites.reduce(
    (result, [from, to]) => rewrite(result, from, to),
    body,
  )}\n}`
}).join("\n")
---

<div class="theme-switch ui-not-rich-text" id={id}>
  <Fieldset>
    <FieldLegend>Theme</FieldLegend>
    <ToggleGroup name={id} size="small">
      <ToggleButton checked value="">Default</ToggleButton>
      {
        EXAMPLE_THEMES.map((theme) => (
          <ToggleButton value={theme.name}>{theme.label}</ToggleButton>
        ))
      }
    </ToggleGroup>
  </Fieldset>

  <div class="theme-switch-stage ui-palette">
    <Card class="theme-switch-card" variant="elevated">
      <CardHeader>
        <h3>Invite a teammate</h3>
        <p>They get an email with a link that works for seven days.</p>
      </CardHeader>
      <CardContent>
        <div class="theme-switch-meta">
          <Chip label="Pro plan" size="small" variant="tonal" />
          <Badge hideLabel label="3 pending invites">
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 32 32"
              ><path
                fill="currentColor"
                d="M2.004 9.303A4.5 4.5 0 0 1 6.5 5h19a4.5 4.5 0 0 1 4.496 4.303l-1.476.82L16 16.864L3.48 10.123zM2 11.588V22.5A4.5 4.5 0 0 0 6.5 27h19a4.5 4.5 0 0 0 4.5-4.5V11.588l-.526.293l-13 7a1 1 0 0 1-.948 0L2.514 11.874z"
              ></path></svg
            >
            <Fragment slot="indicator">3</Fragment>
          </Badge>
        </div>
        <TextField
          label="Email"
          name="theme-switch-email"
          placeholder="name@example.com"
          type="email"
        />
        <Select label="Role" name="theme-switch-role">
          <option>Editor</option>
          <option>Owner</option>
          <option>Viewer</option>
        </Select>
        <Checkbox label="Send me a copy" name="theme-switch-copy" />
      </CardContent>
      <CardActions>
        <Button color="primary" variant="filled">Send invite</Button>
        <Button variant="outlined">Preview</Button>
        <Button variant="tonal">Cancel</Button>
      </CardActions>
    </Card>
  </div>
</div>

<style is:inline set:html={scopedCss}></style>

<style is:global>
  .theme-switch {
    display: grid;
    gap: var(--ui-space-3);
    margin-block: var(--ui-space-5);

    & .ui-fieldset {
      gap: var(--ui-space-1);
    }

    & legend {
      font-size: var(--ui-font-size-caption);
    }
  }

  .theme-switch-stage {
    background-color: var(--ui-surface);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius-large);
    color: var(--ui-text);
    container-type: inline-size;
    display: grid;
    font-family: var(--ui-font-body);
    padding: var(--ui-space-6) var(--ui-space-4);
    place-items: center;

    & h3 {
      font-family: var(--ui-font-heading, var(--ui-font-body));
      font-size: var(--ui-font-size-h5);
      margin: 0;
    }

    & p {
      margin: 0;
    }

    &,
    & * {
      transition-duration: calc(var(--ui-duration-slow) * 2 * var(--ui-motion));
      transition-property:
        background-color, block-size, border-color, border-radius, border-width,
        box-shadow, color, fill, font-size, font-weight, letter-spacing,
        min-block-size, outline-color, padding, translate;
      transition-timing-function: var(--ui-ease);
    }
  }

  .theme-switch-card {
    inline-size: min(100%, 26rem);

    & .ui-header {
      display: grid;
      gap: var(--ui-space-2);
    }

    & .ui-content {
      display: grid;
      gap: var(--ui-space-3);
    }
  }

  .theme-switch-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-3);
  }
</style>
