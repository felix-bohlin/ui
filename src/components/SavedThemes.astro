---
import {
  Button,
  FieldGroup,
  FieldLegend,
  Fieldset,
  TextField,
  ToggleGroup,
} from "opui-css/astro"
---

<Fieldset class="saved-themes">
  <FieldLegend>Saved themes</FieldLegend>
  <FieldGroup>
    <p class="saved-themes-empty ui-caption">
      Save a theme to compare it with others or switch back to it.
    </p>
    <ToggleGroup
      aria-label="Saved themes"
      class="saved-themes-list"
      hidden
      name="saved-theme"
      size="small"
    />
    <div class="saved-themes-actions">
      <TextField label="Theme name" name="saved-theme-name" size="small" />
      <Button class="saved-themes-save" size="small" type="button">Save</Button>
      <Button
        class="saved-themes-delete"
        disabled
        size="small"
        type="button"
        variant="outlined"
      >
        Delete
      </Button>
    </div>
  </FieldGroup>
</Fieldset>

<script>
  import { savedThemes } from "../utils/saved-themes"

  for (const root of document.querySelectorAll<HTMLElement>(".saved-themes")) {
    const list = root.querySelector<HTMLElement>(".saved-themes-list")!
    const empty = root.querySelector<HTMLElement>(".saved-themes-empty")!
    const nameField = root.querySelector<HTMLInputElement>(
      '[name="saved-theme-name"]',
    )!
    const saveButton =
      root.querySelector<HTMLButtonElement>(".saved-themes-save")!
    const deleteButton = root.querySelector<HTMLButtonElement>(
      ".saved-themes-delete",
    )!
    let rendered = ""

    const render = () => {
      const themes = savedThemes.list()
      const current = savedThemes.current()
      const state = JSON.stringify([themes.map((theme) => theme.name), current])
      if (state === rendered) return
      rendered = state

      list.replaceChildren(
        ...themes.map((theme) => {
          const label = document.createElement("label")
          label.className = "ui-toggle-button"
          const input = document.createElement("input")
          input.checked = theme.name === current
          input.name = "saved-theme"
          input.type = "radio"
          input.value = theme.name
          label.append(input, theme.name)
          return label
        }),
      )
      list.hidden = themes.length === 0
      empty.hidden = themes.length > 0
      deleteButton.disabled = current === null
      nameField.placeholder = current ?? savedThemes.nextName()
    }

    const save = () => {
      savedThemes.save(
        nameField.value.trim() ||
          savedThemes.current() ||
          savedThemes.nextName(),
      )
      nameField.value = ""
    }

    list.addEventListener("change", (event) => {
      const target = event.target
      if (target instanceof HTMLInputElement && target.checked) {
        savedThemes.apply(target.value)
      }
    })

    nameField.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return
      event.preventDefault()
      save()
    })

    saveButton.addEventListener("click", save)

    deleteButton.addEventListener("click", () => {
      const current = savedThemes.current()
      if (current) savedThemes.remove(current)
    })

    render()
    savedThemes.subscribe(render)
  }
</script>

<style>
  .saved-themes {
    :global([hidden]) {
      display: none;
    }
  }

  .saved-themes-actions {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);

    :global(.ui-text-field) {
      flex: 1;
      min-inline-size: 10rem;
    }
  }
</style>
