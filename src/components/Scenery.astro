<style>
  .scenery {
    --scenery-palm-far: light-dark(oklch(0.66 0.09 315), oklch(0.34 0.08 315));
    --scenery-palm-near: light-dark(oklch(0.5 0.12 310), oklch(0.25 0.07 305));

    block-size: clamp(13rem, 30vw, 22rem);
    display: none;
    inset-block-end: 0;
    inset-inline: 0;
    pointer-events: none;
    position: absolute;
    z-index: -1;

    :global(html[data-example-theme="vice-city"]) & {
      display: block;
    }
  }

  .scenery-sky {
    block-size: 100%;
    display: block;
    inline-size: 100%;
  }

  .scenery-palms {
    aspect-ratio: 420 / 400;
    block-size: 108%;
    inline-size: auto;
    inset-block-end: 0;
    inset-inline-start: -2rem;
    position: absolute;
  }

  .scenery-palms-end {
    block-size: 88%;
    inset-inline: auto -2rem;
    scale: -1 1;
  }

  .scenery-glow-center {
    stop-color: light-dark(
      oklch(0.93 0.07 50 / 70%),
      oklch(0.55 0.18 355 / 45%)
    );
  }

  .scenery-glow-edge {
    stop-color: light-dark(oklch(0.93 0.07 50 / 0%), oklch(0.55 0.18 355 / 0%));
  }

  .scenery-sun-top {
    stop-color: light-dark(oklch(0.92 0.09 75), oklch(0.86 0.12 65));
  }

  .scenery-sun-bottom {
    stop-color: light-dark(oklch(0.74 0.17 355), oklch(0.6 0.21 355));
  }

  .scenery-skyline-back {
    fill: light-dark(oklch(0.78 0.06 315 / 55%), oklch(0.32 0.08 315 / 70%));
  }

  .scenery-skyline-front {
    fill: light-dark(oklch(0.7 0.08 310 / 60%), oklch(0.25 0.06 300 / 85%));
  }

  .scenery-sea-top {
    stop-color: light-dark(oklch(0.8 0.07 320), oklch(0.26 0.07 305));
  }

  .scenery-sea-bottom {
    stop-color: light-dark(oklch(0.86 0.05 300), oklch(0.2 0.04 290));
  }

  .scenery-reflection {
    fill: light-dark(oklch(0.94 0.07 55 / 80%), oklch(0.75 0.14 20 / 60%));
  }

  .scenery-birds,
  .scenery-plane {
    fill: light-dark(oklch(0.45 0.08 305 / 70%), oklch(0.75 0.05 320 / 50%));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.ui-motion-off)) {
      .scenery-palms use {
        animation: scenery-sway 7s ease-in-out infinite alternate;
        transform-box: fill-box;
        transform-origin: 50% 100%;
      }

      .scenery-palms-end use {
        animation-delay: -3s;
      }

      .scenery-plane {
        animation: scenery-fly 90s linear infinite;
      }
    }
  }

  @keyframes scenery-sway {
    from {
      rotate: -0.6deg;
    }

    to {
      rotate: 0.8deg;
    }
  }

  @keyframes scenery-fly {
    from {
      translate: -600px 24px;
    }

    to {
      translate: 1200px -30px;
    }
  }
</style>
