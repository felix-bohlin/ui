---
import Brutalist from "./scenery/Brutalist.astro"
import Govuk from "./scenery/Govuk.astro"
import M3 from "./scenery/M3.astro"
import Shadcn from "./scenery/Shadcn.astro"
import ViceCity from "./scenery/ViceCity.astro"
---

<div class="scenery">
  <Brutalist />
  <Govuk />
  <M3 />
  <Shadcn />
  <ViceCity />
</div>

<style>
  .scenery {
    display: contents;

    > :global(*) {
      block-size: clamp(13rem, 30vw, 22rem);
      inset-block-end: 0;
      inset-inline: 0;
      pointer-events: none;
      position: absolute;
      z-index: -1;
    }
  }
</style>
