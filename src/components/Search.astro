---
import { Button, Chip, List } from "opui-css/astro"
import Command from "./Command.astro"
import { SEARCH_CATEGORIES } from "../utils/search-categories"
---

<Command id="search-dialog" class="search-modal" aria-label="Search docs">
  <input
    slot="input"
    type="text"
    id="search-input"
    placeholder="Search docs..."
    autocomplete="off"
    aria-label="Search docs"
    role="combobox"
    aria-autocomplete="list"
    aria-controls="recent-list"
    aria-expanded="false"
  />

  <Button
    round
    size="small"
    slot="input-end"
    class="search-mobile-close"
    id="search-close"
    title="Close"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 32 32"
    >
      <path
        fill="currentColor"
        d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
      ></path>
    </svg>
  </Button>

  <div
    slot="header"
    class="search-filters"
    id="search-filters"
    role="group"
    aria-label="Filter by category"
  >
    <Chip
      aria-pressed="true"
      as="button"
      size="small"
      type="button"
      variant="outlined"
      class="filter-chip"
      data-filter="all"
      label="All"
    />
    {
      SEARCH_CATEGORIES.map((category) => (
        <Chip
          aria-pressed="false"
          as="button"
          size="small"
          type="button"
          variant="outlined"
          class="filter-chip"
          data-filter={category.id}
          label={category.label}
        />
      ))
    }
  </div>

  <div id="search-results">
    <div class="command-empty" id="search-empty" style="display: none;">
      No results found.
    </div>
    <div id="recent-searches" class="command-group">
      <div class="command-group-heading" id="recent-heading">Recent</div>
      <List
        variant="transparent"
        id="recent-list"
        role="listbox"
        aria-labelledby="recent-heading"
      />
      <div
        class="command-empty"
        id="recent-empty"
        style="display: none; padding-block: var(--size-4);"
      >
        No recent searches in this category.
      </div>
    </div>
    <div id="results-list" role="listbox" aria-label="Results"></div>
  </div>
  <div id="search-status" class="ui-sr-only" role="status"></div>

  <Fragment slot="footer">
    <div class="helper">
      <span class="keys"><kbd>↑</kbd><kbd>↓</kbd></span>
      <span>Navigate</span>
    </div>
    <div class="helper">
      <span class="keys"><kbd>←</kbd><kbd>→</kbd></span>
      <span>Category</span>
    </div>
    <div class="helper"><kbd>↵</kbd> <span>Select</span></div>
    <div class="helper"><kbd>esc</kbd> <span>Close</span></div>
  </Fragment>
</Command>

<script>
  import MiniSearch, { type SearchResult } from "minisearch"
  import {
    DEFAULT_FRAMEWORK,
    FRAMEWORKS,
    frameworkPrefixPattern,
    isFrameworkId,
    type FrameworkId,
  } from "../utils/framework"
  import {
    SEARCH_CATEGORIES,
    type SearchItem,
  } from "../utils/search-categories"
  import { readStored, writeStored } from "../utils/storage"

  const dialog = document.getElementById("search-dialog") as HTMLDialogElement
  const input = document.getElementById("search-input") as HTMLInputElement
  const resultsList = document.getElementById("results-list")
  const recentList = document.getElementById("recent-list")
  const recentEmpty = document.getElementById("recent-empty")
  const recentGroup = document.getElementById("recent-searches")
  const emptyState = document.getElementById("search-empty")
  const filterGroup = document.getElementById("search-filters")
  const closeBtn = document.getElementById("search-close")
  const status = document.getElementById("search-status")

  type Result = SearchItem & {
    framework?: FrameworkId
    score: number
    terms: string[]
  }
  type RecentItem = Pick<
    SearchItem,
    "category" | "description" | "id" | "page" | "title" | "url"
  >

  const GROUP_LIMIT = 5
  const CATEGORY_BOOST: Partial<Record<string, number>> = {
    API: 0.8,
    Blocks: 0.9,
    Blog: 0.7,
    Component: 1.2,
  }
  const indexes = new Map<FrameworkId, Promise<MiniSearch<SearchItem>>>()
  let selectedIndex = -1
  let activeFilter = "all"
  let statusTimer: ReturnType<typeof setTimeout> | undefined
  let renderRun = 0
  const optionItems = new WeakMap<Element, RecentItem>()

  function getActiveFrameworkId(): FrameworkId {
    const framework = document.documentElement.dataset.framework
    return isFrameworkId(framework) ? framework : DEFAULT_FRAMEWORK
  }

  function matchesActiveFramework(item: Pick<SearchItem, "url">): boolean {
    const frameworkId = item.url?.match(frameworkPrefixPattern())?.[1]
    return !isFrameworkId(frameworkId) || frameworkId === getActiveFrameworkId()
  }

  function selectFilter(filter: string) {
    filterGroup?.querySelectorAll(".filter-chip").forEach((c) => {
      c.setAttribute(
        "aria-pressed",
        String((c as HTMLElement).dataset.filter === filter),
      )
    })
    activeFilter = filter
    updateResults()
  }

  // Handle filter clicks
  filterGroup?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement
    const filterChip = target.closest(".filter-chip")

    if (filterChip) {
      selectFilter((filterChip as HTMLElement).dataset.filter || "all")
      input.focus()
    }
  })

  // Initialize MiniSearch
  function loadIndex(framework = getActiveFrameworkId()) {
    let index = indexes.get(framework)
    if (!index) {
      index = fetch(`/search-index/${framework}.json`)
        .then((response) => response.json())
        .then((items: SearchItem[]) => {
          const miniSearch = new MiniSearch<SearchItem>({
            fields: [
              "title",
              "keywords",
              "page",
              "headings",
              "description",
              "terms",
            ], // fields to index for full-text search
            storeFields: ["category", "description", "page", "title", "url"],
            searchOptions: {
              boost: {
                description: 1,
                headings: 1,
                keywords: 3,
                page: 2,
                terms: 0.5,
                title: 4,
              },
              boostDocument: (_id, _term, item) =>
                (CATEGORY_BOOST[String(item?.category)] ?? 1) *
                (item?.page ? 1 : 1.5),
              combineWith: "AND",
              fuzzy: 0.2,
              prefix: true,
            },
          })
          miniSearch.addAll(items)
          return miniSearch
        })
      index.catch((e) => {
        indexes.delete(framework)
        console.error("Failed to initialize search", e)
      })
      indexes.set(framework, index)
    }
    return index
  }

  function search(miniSearch: MiniSearch<SearchItem>, query: string) {
    const results = miniSearch.search(query)
    return (
      results.length > 0
        ? results
        : miniSearch.search(query, { combineWith: "OR" })
    ).map((result: SearchResult) => result as unknown as Result)
  }

  const getRecentSearches = () =>
    readStored<RecentItem[]>("opui-recent-searches", [])

  function saveRecentSearch({
    category,
    description,
    id,
    page,
    title,
    url,
  }: RecentItem) {
    let recent = getRecentSearches()
    // Remove if exists
    recent = recent.filter((r) => r.url !== url)
    // Add to front
    recent.unshift({ category, description, id, page, title, url })
    // Limit to 5
    recent = recent.slice(0, 5)
    writeStored("opui-recent-searches", recent)
  }

  const escapeHtml = (text: string) =>
    text.replace(/[&<>"]/g, (char) => `&#${char.charCodeAt(0)};`)

  function highlight(text: string, terms: string[]) {
    if (terms.length === 0) return escapeHtml(text)
    const pattern = terms
      .toSorted((a, b) => b.length - a.length)
      .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
      .join("|")
    return text
      .split(
        new RegExp(`(?<![\\p{L}\\p{N}])(${pattern})(?![\\p{L}\\p{N}])`, "giu"),
      )
      .map((part, index) =>
        index % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part),
      )
      .join("")
  }

  function renderItem(
    item: RecentItem & Partial<Result>,
    id: string,
    isSelected: boolean,
  ) {
    const terms = item.terms ?? []
    const li = document.createElement("li")
    li.id = id
    li.setAttribute("aria-selected", String(isSelected))
    li.setAttribute("role", "option")

    const displayTitle = highlight(item.title, terms)
    const displayDesc = highlight(item.page ?? item.description ?? "", terms)
    const end = item.framework
      ? FRAMEWORKS.find(({ id }) => id === item.framework)?.label
      : item.category

    const link = document.createElement("a")
    link.href = item.url
    link.tabIndex = -1
    link.innerHTML = `
      <div class="ui-text">
        <p class="ui-title">${displayTitle}</p>
        <p class="ui-description">${displayDesc}</p>
      </div>
      <div class="ui-end">
        ${end ? `<span class="command-item-shortcut">${end}</span>` : ""}
      </div>
    `
    li.append(link)
    optionItems.set(li, item)

    link.addEventListener("click", (e) => {
      saveRecentSearch(item)
      if (!e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) dialog.close()
    })

    return li
  }

  function renderMore(category: string, count: number, id: string) {
    const li = document.createElement("li")
    li.id = id
    li.className = "search-more"
    li.setAttribute("aria-selected", "false")
    li.setAttribute("role", "option")
    li.innerHTML = `<button type="button" tabindex="-1"><span class="ui-text"><span class="ui-title">Show all ${count}</span></span></button>`
    li.addEventListener("click", () => {
      selectFilter(category)
      input.focus()
    })
    return li
  }

  function announce(text: string) {
    clearTimeout(statusTimer)
    statusTimer = setTimeout(() => {
      if (status) status.textContent = text
    }, 500)
  }

  function renderGroups(
    items: Result[],
    { heading, limit }: { heading?: string; limit: boolean },
  ) {
    // Group and sort by category
    const grouped = new Map<string, Result[]>()
    for (const item of items) {
      const group = heading ?? item.category
      grouped.set(group, [...(grouped.get(group) ?? []), item])
    }

    let globalIndex = resultsList!.querySelectorAll("[role=option]").length
    for (const [category, groupItems] of grouped) {
      const headingId = `search-group-${category.toLowerCase().replace(/\W+/g, "-")}`
      const groupDiv = document.createElement("div")
      groupDiv.className = "command-group"
      groupDiv.innerHTML = `<div class="command-group-heading" id="${headingId}">${category}</div>`

      const ul = document.createElement("ul")
      ul.className = "ui-list ui-transparent"
      ul.setAttribute("aria-labelledby", headingId)
      ul.setAttribute("role", "group")

      const shown =
        limit && groupItems.length > GROUP_LIMIT + 1
          ? groupItems.slice(0, GROUP_LIMIT)
          : groupItems
      shown.forEach((item) => {
        ul.appendChild(
          renderItem(item, `search-result-${globalIndex++}`, false),
        )
      })
      if (shown.length < groupItems.length) {
        ul.appendChild(
          renderMore(
            category,
            groupItems.length,
            `search-result-${globalIndex++}`,
          ),
        )
      }

      groupDiv.appendChild(ul)
      resultsList!.appendChild(groupDiv)
    }
    return globalIndex
  }

  async function searchOtherFrameworks(query: string) {
    const current = getActiveFrameworkId()
    const others = await Promise.all(
      FRAMEWORKS.filter(({ id }) => id !== current).map(async ({ id }) =>
        search(await loadIndex(id), query)
          .filter((r) => activeFilter === "all" || r.category === activeFilter)
          .map((r) => ({ ...r, framework: id })),
      ),
    )
    return others
      .flat()
      .filter(
        (result, index, all) =>
          all.findIndex((other) => other.url === result.url) === index,
      )
      .toSorted((a, b) => b.score - a.score)
      .slice(0, GROUP_LIMIT)
  }

  async function updateResults() {
    const run = ++renderRun
    const query = input.value.trim()
    resultsList!.innerHTML = ""
    selectedIndex = -1
    input.removeAttribute("aria-activedescendant")
    input.setAttribute("aria-controls", query ? "results-list" : "recent-list")
    input.setAttribute("aria-expanded", "false")

    if (!query) {
      recentGroup!.style.display = "block"
      emptyState!.style.display = "none"
      announce("")
      renderRecent()
      return
    }

    recentGroup!.style.display = "none"

    const miniSearch = await loadIndex().catch(() => undefined)
    if (!miniSearch || run !== renderRun) return

    const results = search(miniSearch, query)

    // Update Category Chips with counts
    updateChipCounts(results.length, countByCategory(results))

    let finalResults = results
    if (activeFilter !== "all") {
      finalResults = finalResults.filter((r) => r.category === activeFilter)
    }

    resultsList!.innerHTML = ""

    if (finalResults.length === 0) {
      const framework = FRAMEWORKS.find(
        ({ id }) => id === getActiveFrameworkId(),
      )?.label
      emptyState!.textContent = `No results in ${framework}.`
      emptyState!.style.display = "block"
      const others = await searchOtherFrameworks(query)
      if (run !== renderRun) return
      announce(
        others.length > 0
          ? `No results in ${framework}, ${others.length} in other frameworks`
          : `No results in ${framework}`,
      )
      if (others.length > 0) {
        renderGroups(others, { heading: "Other frameworks", limit: false })
        selectedIndex = 0
        updateSelection()
      }
      return
    }

    emptyState!.style.display = "none"
    announce(
      `${finalResults.length} ${finalResults.length === 1 ? "result" : "results"}`,
    )

    if (renderGroups(finalResults, { limit: activeFilter === "all" }) > 0) {
      selectedIndex = 0
      updateSelection()
    }
  }

  function countByCategory(items: Pick<SearchItem, "category">[]) {
    const counts: Record<string, number> = {}
    for (const item of items) {
      counts[item.category] = (counts[item.category] || 0) + 1
    }
    return counts
  }

  function updateChipCounts(
    totalCount: number,
    categoryCounts: Record<string, number>,
  ) {
    filterGroup?.querySelectorAll(".filter-chip").forEach((chip) => {
      const filter = (chip as HTMLElement).dataset.filter
      const label = chip.querySelector(".ui-text") || chip
      const baseText =
        filter === "all"
          ? "All"
          : SEARCH_CATEGORIES.find((category) => category.id === filter)
              ?.label || filter
      const count = filter === "all" ? totalCount : categoryCounts[filter!] || 0
      label.textContent = `${baseText} (${count})`
    })
  }

  function renderRecent() {
    let recent = getRecentSearches()

    recent = recent.filter((r) => matchesActiveFramework(r))

    // Update counts based on Recent history
    updateChipCounts(recent.length, countByCategory(recent))

    // Apply active category filter
    if (activeFilter !== "all") {
      recent = recent.filter((r) => r.category === activeFilter)
    }

    recentList!.innerHTML = ""
    recentEmpty!.style.display = "none"
    recentList!.style.display = "block"

    if (recent.length === 0) {
      recentGroup!.style.display = activeFilter !== "all" ? "block" : "none"
      recentList!.style.display = "none"
      if (activeFilter !== "all") {
        recentEmpty!.style.display = "block"
      }
      return
    }

    recentGroup!.style.display = "block"
    recent.forEach((item, index) => {
      recentList!.appendChild(renderItem(item, `search-recent-${index}`, false))
    })

    if (recent.length > 0) {
      selectedIndex = 0
      updateSelection()
    }
  }

  function updateSelection() {
    const items = getActiveItems()
    input.setAttribute("aria-expanded", String(items.length > 0))
    items.forEach((item, i) => {
      if (i === selectedIndex) {
        item.setAttribute("aria-selected", "true")
        input.setAttribute("aria-activedescendant", item.id)
        item.scrollIntoView({ block: "nearest" })
      } else {
        item.setAttribute("aria-selected", "false")
      }
    })
  }

  function getActiveItems() {
    if (input.value.trim()) {
      return resultsList!.querySelectorAll<HTMLElement>("[role=option]")
    } else {
      return recentList!.querySelectorAll<HTMLElement>("[role=option]")
    }
  }

  input.addEventListener("input", updateResults)

  closeBtn?.addEventListener("click", () => {
    dialog.close()
  })

  input.addEventListener("keydown", (e) => {
    const atStart = input.selectionStart === 0 && input.selectionEnd === 0
    const atEnd =
      input.selectionStart === input.value.length &&
      input.selectionEnd === input.value.length
    if (
      (e.key === "ArrowLeft" && atStart) ||
      (e.key === "ArrowRight" && atEnd)
    ) {
      const chips = Array.from(
        filterGroup!.querySelectorAll(".filter-chip"),
      ) as HTMLElement[]
      const currentIndex = chips.findIndex(
        (c) => (c as HTMLElement).dataset.filter === activeFilter,
      )
      let newIndex
      if (e.key === "ArrowLeft") {
        newIndex = (currentIndex - 1 + chips.length) % chips.length
      } else {
        newIndex = (currentIndex + 1) % chips.length
      }
      const targetChip = chips[newIndex]

      e.preventDefault()
      // Update UI (same logic as click handler)
      selectFilter(targetChip.dataset.filter || "all")
      return
    }

    const items = getActiveItems()
    if (items.length === 0) return

    if (e.key === "ArrowDown") {
      e.preventDefault()
      selectedIndex = (selectedIndex + 1) % items.length
      updateSelection()
    } else if (e.key === "ArrowUp") {
      e.preventDefault()
      selectedIndex = (selectedIndex - 1 + items.length) % items.length
      updateSelection()
    } else if (e.key === "Enter") {
      const selected = items[selectedIndex]
      const item = selected && optionItems.get(selected)
      e.preventDefault()
      if (item && (e.ctrlKey || e.metaKey)) {
        saveRecentSearch(item)
        window.open(item.url, "_blank")
        return
      }
      selected?.querySelector<HTMLElement>("a, button")?.click()
    }
  })

  // Global shortcuts
  window.addEventListener("keydown", (e) => {
    const platform = (
      (navigator as Navigator & { userAgentData?: { platform: string } })
        .userAgentData?.platform ||
      navigator.platform ||
      ""
    ).toLowerCase()
    const isMac = /mac|iphone|ipad|ipod|ios/.test(platform)
    const modifier = isMac ? e.metaKey : e.ctrlKey

    if (modifier && e.key === "k") {
      e.preventDefault()
      toggleSearch()
    }

    if (e.key === "/" && document.activeElement === document.body) {
      e.preventDefault()
      toggleSearch()
    }
  })

  function toggleSearch() {
    if (dialog.open) {
      dialog.close()
    } else {
      dialog.showModal()
      input.focus()
      updateResults()
    }
  }

  const prefetch = (e: Event) => {
    if ((e.target as HTMLElement).closest?.("[data-open-search]")) {
      loadIndex().catch(() => {})
    }
  }
  document.addEventListener("pointerover", prefetch, { passive: true })
  document.addEventListener("focusin", prefetch)

  // Handle open from other elements
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement
    if (target.closest("[data-open-search]")) {
      e.preventDefault()
      toggleSearch()
    }
  })
</script>

<style is:global>
  :where(.command[open]) {
    background-color: var(--ui-surface);
    block-size: 100dvb;
    color: var(--ui-text-strong);
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    margin: 0;
    max-block-size: 100dvb;
    max-inline-size: 100%;
    overflow: hidden;
    padding: 0;

    @media (width >= 640px) {
      block-size: fit-content;
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius);
      box-shadow: var(--shadow-6);
      inline-size: auto;
      margin-block-start: 10vh;
      margin-inline: auto;
      max-block-size: 80vh;
      max-inline-size: 640px;
    }

    &::backdrop {
      backdrop-filter: blur(10px);
      background-color: oklch(0 0 0 / 0.4);
    }

    .command-input-wrapper,
    .search-filters,
    .command-footer {
      flex-shrink: 0;
    }

    .command-input-wrapper {
      align-items: center;
      border-bottom: var(--border-size-1) solid var(--ui-surface-tonal);
      display: flex;
      gap: var(--size-2);
      padding-inline: var(--size-3);

      svg {
        color: var(--ui-text);
        flex-shrink: 0;
      }

      input {
        background: transparent;
        border: none;
        color: var(--ui-text-strong);
        flex: 1;
        font-family: inherit;
        font-size: var(--font-size-2);
        outline: none;
        padding-block: var(--size-3);

        &::placeholder {
          color: var(--ui-text);
        }
      }

      .search-mobile-close {
        display: none;

        @media (max-width: 640px) {
          display: flex;
        }
      }
    }

    .search-filters {
      align-items: center;
      border-bottom: var(--border-size-1) solid var(--ui-surface-tonal);
      display: flex;
      gap: var(--size-2);
      overflow-x: auto;
      padding: var(--size-2) var(--size-3);
      scrollbar-width: none;

      @media (min-width: 641px) {
        flex-wrap: wrap;
        padding: var(--size-2);
      }

      &::-webkit-scrollbar {
        display: none;
      }

      .ui-chip {
        cursor: pointer;
        flex-shrink: 0;
        user-select: none;
      }
    }

    .command-list {
      flex: 1;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--size-2);

      &::-webkit-scrollbar {
        inline-size: 8px;
      }

      &::-webkit-scrollbar-thumb {
        background-color: var(--ui-surface-tonal);
        border-radius: var(--radius-round);
      }
    }

    .command-group {
      &:not(:first-child) {
        margin-block-start: var(--size-2);
      }
    }

    .command-group-heading {
      color: var(--ui-text);
      font-size: var(--font-size-1);
      font-weight: var(--font-weight-6);
      letter-spacing: var(--font-letterspacing-1);
      padding-block: var(--size-1);
      padding-inline: var(--size-2);
      text-transform: uppercase;
    }

    .command-footer {
      align-items: center;
      background-color: var(--ui-surface-tonal);
      border-top: var(--border-size-1) solid var(--ui-surface-tonal);
      color: var(--ui-text);
      display: flex;
      flex-wrap: nowrap;
      font-size: var(--font-size-0);
      gap: var(--size-4);
      overflow-x: auto;
      padding-block: var(--size-2);
      padding-inline: var(--size-3);
      scrollbar-width: none;

      @media (max-width: 640px) {
        display: none;
      }

      &::-webkit-scrollbar {
        display: none;
      }

      .helper {
        align-items: center;
        display: flex;
        gap: var(--size-2);
        white-space: nowrap;

        .keys {
          align-items: center;
          display: flex;
          gap: 2px;
        }

        kbd {
          align-items: center;
          background-color: var(--ui-surface-filled);
          block-size: 1.6em;
          border: 1px solid var(--ui-surface-tonal);
          border-radius: var(--radius-1);
          box-shadow: 0 1px 0 0 var(--ui-surface-tonal);
          color: var(--ui-text-strong);
          display: flex;
          font-family: var(--font-mono);
          font-size: 10px;
