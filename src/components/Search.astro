---
import {
  Button,
  Chip,
  Command,
  CommandInput,
  CommandList,
} from "opui-css/astro"
import { SEARCH_CATEGORIES } from "../utils/search-categories"
---

<dialog
  aria-label="Search docs"
  class="ui-dialog search-modal"
  closedby="any"
  id="search-dialog"
>
  <Command emptyLabel="No results found." filter="none" id="search-command">
    <CommandInput
      aria-label="Search docs"
      id="search-input"
      placeholder="Search docs..."
    />

    <div
      class="search-filters"
      id="search-filters"
      role="group"
      aria-label="Filter by category"
    >
      <Chip
        aria-pressed="true"
        as="button"
        size="small"
        type="button"
        variant="outlined"
        class="filter-chip"
        data-filter="all"
        label="All"
      />
      {
        SEARCH_CATEGORIES.map((category) => (
          <Chip
            aria-pressed="false"
            as="button"
            size="small"
            type="button"
            variant="outlined"
            class="filter-chip"
            data-filter={category.id}
            label={category.label}
          />
        ))
      }
      <Button
        round
        size="small"
        class="search-mobile-close"
        id="search-close"
        title="Close"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 32 32"
        >
          <path
            fill="currentColor"
            d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
          ></path>
        </svg>
      </Button>
    </div>

    <CommandList aria-label="Results" id="results-list" />
    <p class="search-empty" id="recent-empty" hidden>
      No recent searches in this category.
    </p>

    <div class="search-footer">
      <div class="helper">
        <span class="keys"><kbd>↑</kbd><kbd>↓</kbd></span>
        <span>Navigate</span>
      </div>
      <div class="helper">
        <span class="keys"><kbd>←</kbd><kbd>→</kbd></span>
        <span>Category</span>
      </div>
      <div class="helper"><kbd>↵</kbd> <span>Select</span></div>
      <div class="helper"><kbd>esc</kbd> <span>Close</span></div>
    </div>
  </Command>
  <div id="search-status" class="ui-sr-only" role="status"></div>
</dialog>

<script>
  import MiniSearch, { type SearchResult } from "minisearch"
  import {
    DEFAULT_FRAMEWORK,
    FRAMEWORKS,
    frameworkPrefixPattern,
    isFrameworkId,
    type FrameworkId,
  } from "../utils/framework"
  import {
    SEARCH_CATEGORIES,
    type SearchItem,
  } from "../utils/search-categories"
  import type { Command } from "opui-css/elements/command.js"
  import { readStored, writeStored } from "../utils/storage"

  const dialog = document.getElementById("search-dialog") as HTMLDialogElement
  const command = document.getElementById("search-command") as Command
  const input = document.getElementById("search-input") as HTMLInputElement
  const resultsList = document.getElementById("results-list")
  const recentEmpty = document.getElementById("recent-empty")
  const filterGroup = document.getElementById("search-filters")
  const closeBtn = document.getElementById("search-close")
  const status = document.getElementById("search-status")

  type Result = SearchItem & {
    framework?: FrameworkId
    score: number
    terms: string[]
  }
  type RecentItem = Pick<
    SearchItem,
    "category" | "description" | "id" | "page" | "title" | "url"
  >

  const GROUP_LIMIT = 5
  const CATEGORY_BOOST: Partial<Record<string, number>> = {
    API: 0.8,
    Blocks: 0.9,
    Blog: 0.7,
    Component: 1.2,
  }
  const indexes = new Map<FrameworkId, Promise<MiniSearch<SearchItem>>>()
  let activeFilter = "all"
  let statusTimer: ReturnType<typeof setTimeout> | undefined
  let renderRun = 0

  function getActiveFrameworkId(): FrameworkId {
    const framework = document.documentElement.dataset.framework
    return isFrameworkId(framework) ? framework : DEFAULT_FRAMEWORK
  }

  function matchesActiveFramework(item: Pick<SearchItem, "url">): boolean {
    const frameworkId = item.url?.match(frameworkPrefixPattern())?.[1]
    return !isFrameworkId(frameworkId) || frameworkId === getActiveFrameworkId()
  }

  function selectFilter(filter: string) {
    filterGroup?.querySelectorAll(".filter-chip").forEach((c) => {
      c.setAttribute(
        "aria-pressed",
        String((c as HTMLElement).dataset.filter === filter),
      )
    })
    activeFilter = filter
    updateResults()
  }

  // Handle filter clicks
  filterGroup?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement
    const filterChip = target.closest(".filter-chip")

    if (filterChip) {
      selectFilter((filterChip as HTMLElement).dataset.filter || "all")
      input.focus()
    }
  })

  // Initialize MiniSearch
  function loadIndex(framework = getActiveFrameworkId()) {
    let index = indexes.get(framework)
    if (!index) {
      index = fetch(`/search-index/${framework}.json`)
        .then((response) => response.json())
        .then((items: SearchItem[]) => {
          const miniSearch = new MiniSearch<SearchItem>({
            fields: [
              "title",
              "keywords",
              "page",
              "headings",
              "description",
              "terms",
            ], // fields to index for full-text search
            storeFields: ["category", "description", "page", "title", "url"],
            searchOptions: {
              boost: {
                description: 1,
                headings: 1,
                keywords: 3,
                page: 2,
                terms: 0.5,
                title: 4,
              },
              boostDocument: (_id, _term, item) =>
                (CATEGORY_BOOST[String(item?.category)] ?? 1) *
                (item?.page ? 1 : 1.5),
              combineWith: "AND",
              fuzzy: 0.2,
              prefix: true,
            },
          })
          miniSearch.addAll(items)
          return miniSearch
        })
      index.catch((e) => {
        indexes.delete(framework)
        console.error("Failed to initialize search", e)
      })
      indexes.set(framework, index)
    }
    return index
  }

  function search(miniSearch: MiniSearch<SearchItem>, query: string) {
    const results = miniSearch.search(query)
    return (
      results.length > 0
        ? results
        : miniSearch.search(query, { combineWith: "OR" })
    ).map((result: SearchResult) => result as unknown as Result)
  }

  const getRecentSearches = () =>
    readStored<RecentItem[]>("opui-recent-searches", [])

  function saveRecentSearch({
    category,
    description,
    id,
    page,
    title,
    url,
  }: RecentItem) {
    let recent = getRecentSearches()
    // Remove if exists
    recent = recent.filter((r) => r.url !== url)
    // Add to front
    recent.unshift({ category, description, id, page, title, url })
    // Limit to 5
    recent = recent.slice(0, 5)
    writeStored("opui-recent-searches", recent)
  }

  const escapeHtml = (text: string) =>
    text.replace(/[&<>"]/g, (char) => `&#${char.charCodeAt(0)};`)

  function highlight(text: string, terms: string[]) {
    if (terms.length === 0) return escapeHtml(text)
    const pattern = terms
      .toSorted((a, b) => b.length - a.length)
      .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
      .join("|")
    return text
      .split(
        new RegExp(`(?<![\\p{L}\\p{N}])(${pattern})(?![\\p{L}\\p{N}])`, "giu"),
      )
      .map((part, index) =>
        index % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part),
      )
      .join("")
  }

  function renderItem(item: RecentItem & Partial<Result>) {
    const terms = item.terms ?? []
    const li = document.createElement("li")

    const displayTitle = highlight(item.title, terms)
    const displayDesc = highlight(item.page ?? item.description ?? "", terms)
    const end = item.framework
      ? FRAMEWORKS.find(({ id }) => id === item.framework)?.label
      : item.category

    const link = document.createElement("a")
    link.href = item.url
    link.innerHTML = `
      <div class="ui-text">
        <p class="ui-title">${displayTitle}</p>
        <p class="ui-description">${displayDesc}</p>
      </div>
      <div class="ui-end">
        ${end ? `<span class="search-item-category">${end}</span>` : ""}
      </div>
    `
    li.append(link)

    link.addEventListener("click", (e) => {
      saveRecentSearch(item)
      if (!e.ctrlKey && !e.metaKey && !e.shiftKey && !e.altKey) dialog.close()
    })

    return li
  }

  function renderMore(category: string, count: number) {
    const li = document.createElement("li")
    li.className = "search-more"
    li.innerHTML = `<button type="button"><span class="ui-text"><span class="ui-title">Show all ${count}</span></span></button>`
    li.querySelector("button")?.addEventListener("click", () => {
      selectFilter(category)
      input.focus()
    })
    return li
  }

  function announce(text: string) {
    clearTimeout(statusTimer)
    statusTimer = setTimeout(() => {
      if (status) status.textContent = text
    }, 500)
  }

  function renderGroups(
    items: (RecentItem & Partial<Result>)[],
    { heading, limit }: { heading?: string; limit: boolean },
  ) {
    // Group and sort by category
    const grouped = new Map<string, (RecentItem & Partial<Result>)[]>()
    for (const item of items) {
      const group = heading ?? item.category
      grouped.set(group, [...(grouped.get(group) ?? []), item])
    }

    const groups = [...grouped].map(([category, groupItems]) => {
      const headingId = `search-group-${category.toLowerCase().replace(/\W+/g, "-")}`
      const groupDiv = document.createElement("div")
      groupDiv.className = "ui-command-group"
      groupDiv.innerHTML = `<p class="ui-label" id="${headingId}">${category}</p>`

      const ul = document.createElement("ul")
      ul.className = "ui-list ui-transparent"
      ul.setAttribute("aria-labelledby", headingId)

      const shown =
        limit && groupItems.length > GROUP_LIMIT + 1
          ? groupItems.slice(0, GROUP_LIMIT)
          : groupItems
      ul.append(...shown.map((item) => renderItem(item)))
      if (shown.length < groupItems.length) {
        ul.append(renderMore(category, groupItems.length))
      }

      groupDiv.append(ul)
      return groupDiv
    })
    resultsList!.replaceChildren(...groups)
  }

  async function searchOtherFrameworks(query: string) {
    const current = getActiveFrameworkId()
    const others = await Promise.all(
      FRAMEWORKS.filter(({ id }) => id !== current).map(async ({ id }) =>
        search(await loadIndex(id), query)
          .filter((r) => activeFilter === "all" || r.category === activeFilter)
          .map((r) => ({ ...r, framework: id })),
      ),
    )
    return others
      .flat()
      .filter(
        (result, index, all) =>
          all.findIndex((other) => other.url === result.url) === index,
      )
      .toSorted((a, b) => b.score - a.score)
      .slice(0, GROUP_LIMIT)
  }

  async function updateResults() {
    const run = ++renderRun
    const query = input.value.trim()
    recentEmpty!.hidden = true

    if (!query) {
      announce("")
      renderRecent()
      return
    }

    const miniSearch = await loadIndex().catch(() => undefined)
    if (!miniSearch || run !== renderRun) return

    const results = search(miniSearch, query)

    // Update Category Chips with counts
    updateChipCounts(results.length, countByCategory(results))

    let finalResults = results
    if (activeFilter !== "all") {
      finalResults = finalResults.filter((r) => r.category === activeFilter)
    }

    if (finalResults.length === 0) {
      const framework = FRAMEWORKS.find(
        ({ id }) => id === getActiveFrameworkId(),
      )?.label
      const others = await searchOtherFrameworks(query)
      if (run !== renderRun) return
      command.setAttribute("empty-label", `No results in ${framework}.`)
      renderGroups(others, { heading: "Other frameworks", limit: false })
      announce(
        others.length > 0
          ? `No results in ${framework}, ${others.length} in other frameworks`
          : "",
      )
      return
    }

    announce(
      `${finalResults.length} ${finalResults.length === 1 ? "result" : "results"}`,
    )
    renderGroups(finalResults, { limit: activeFilter === "all" })
  }

  function countByCategory(items: Pick<SearchItem, "category">[]) {
    const counts: Record<string, number> = {}
    for (const item of items) {
      counts[item.category] = (counts[item.category] || 0) + 1
    }
    return counts
  }

  function updateChipCounts(
    totalCount: number,
    categoryCounts: Record<string, number>,
  ) {
    filterGroup?.querySelectorAll(".filter-chip").forEach((chip) => {
      const filter = (chip as HTMLElement).dataset.filter
      const label = chip.querySelector(".ui-text") || chip
      const baseText =
        filter === "all"
          ? "All"
          : SEARCH_CATEGORIES.find((category) => category.id === filter)
              ?.label || filter
      const count = filter === "all" ? totalCount : categoryCounts[filter!] || 0
      label.textContent = `${baseText} (${count})`
    })
  }

  function renderRecent() {
    let recent = getRecentSearches()

    recent = recent.filter((r) => matchesActiveFramework(r))

    // Update counts based on Recent history
    updateChipCounts(recent.length, countByCategory(recent))

    // Apply active category filter
    if (activeFilter !== "all") {
      recent = recent.filter((r) => r.category === activeFilter)
    }

    renderGroups(recent, { heading: "Recent", limit: false })
    recentEmpty!.hidden = recent.length > 0 || activeFilter === "all"
  }

  input.addEventListener("input", updateResults)

  closeBtn?.addEventListener("click", () => {
    dialog.close()
  })

  input.addEventListener("keydown", (e) => {
    const atStart = input.selectionStart === 0 && input.selectionEnd === 0
    const atEnd =
      input.selectionStart === input.value.length &&
      input.selectionEnd === input.value.length
    if (
      (e.key === "ArrowLeft" && atStart) ||
      (e.key === "ArrowRight" && atEnd)
    ) {
      const chips = Array.from(
        filterGroup!.querySelectorAll(".filter-chip"),
      ) as HTMLElement[]
      const currentIndex = chips.findIndex(
        (c) => (c as HTMLElement).dataset.filter === activeFilter,
      )
      let newIndex
      if (e.key === "ArrowLeft") {
        newIndex = (currentIndex - 1 + chips.length) % chips.length
      } else {
        newIndex = (currentIndex + 1) % chips.length
      }
      const targetChip = chips[newIndex]

      e.preventDefault()
      // Update UI (same logic as click handler)
      selectFilter(targetChip.dataset.filter || "all")
      return
    }
  })

  // Global shortcuts
  window.addEventListener("keydown", (e) => {
    const platform = (
      (navigator as Navigator & { userAgentData?: { platform: string } })
        .userAgentData?.platform ||
      navigator.platform ||
      ""
    ).toLowerCase()
    const isMac = /mac|iphone|ipad|ipod|ios/.test(platform)
    const modifier = isMac ? e.metaKey : e.ctrlKey

    if (modifier && e.key === "k") {
      e.preventDefault()
      toggleSearch()
    }

    if (e.key === "/" && document.activeElement === document.body) {
      e.preventDefault()
      toggleSearch()
    }
  })

  function toggleSearch() {
    if (dialog.open) {
      dialog.close()
    } else {
      dialog.showModal()
      input.focus()
      updateResults()
    }
  }

  const prefetch = (e: Event) => {
    if ((e.target as HTMLElement).closest?.("[data-open-search]")) {
      loadIndex().catch(() => {})
    }
  }
  document.addEventListener("pointerover", prefetch, { passive: true })
  document.addEventListener("focusin", prefetch)

  // Handle open from other elements
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement
    if (target.closest("[data-open-search]")) {
      e.preventDefault()
      toggleSearch()
    }
  })
</script>

<style is:global>
  :where(.search-modal[open]) {
    background-color: var(--ui-surface);
    block-size: 100dvb;
    color: var(--ui-text-strong);
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    margin: 0;
    max-block-size: 100dvb;
    max-inline-size: 100%;
    overflow: hidden;
    padding: 0;

    @media (width >= 640px) {
      block-size: fit-content;
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius);
      box-shadow: var(--shadow-6);
      inline-size: auto;
      margin-block-start: 10vh;
      margin-inline: auto;
      max-block-size: 80vh;
      max-inline-size: 640px;
    }

    &::backdrop {
      backdrop-filter: blur(10px);
      background-color: oklch(0 0 0 / 0.4);
    }

    .ui-command {
      --_max-block-size: none;

      flex: 1;
      min-block-size: 0;

      & > .ui-header input {
        font-size: var(--font-size-2);
      }

      & > .ui-content {
        padding: var(--size-2);
      }
    }

    .search-filters,
    .search-footer {
      flex-shrink: 0;
    }

    .search-filters {
      align-items: center;
      border-bottom: var(--border-size-1) solid var(--ui-surface-tonal);
      display: flex;
      gap: var(--size-2);
      overflow-x: auto;
      padding: var(--size-2) var(--size-3);
      scrollbar-width: none;

      @media (min-width: 641px) {
        flex-wrap: wrap;
        padding: var(--size-2);
      }

      &::-webkit-scrollbar {
        display: none;
      }

      .ui-chip {
        cursor: pointer;
        flex-shrink: 0;
        user-select: none;
      }

      .search-mobile-close {
        display: none;
        flex-shrink: 0;
        inset-inline-end: 0;
        margin-inline-start: auto;
        position: sticky;

        @media (max-width: 640px) {
          display: flex;
        }
      }
    }

    .search-footer {
      align-items: center;
      background-color: var(--ui-surface-tonal);
      border-top: var(--border-size-1) solid var(--ui-surface-tonal);
      color: var(--ui-text);
      display: flex;
      flex-wrap: nowrap;
      font-size: var(--font-size-0);
      gap: var(--size-4);
      overflow-x: auto;
      padding-block: var(--size-2);
      padding-inline: var(--size-3);
      scrollbar-width: none;

      @media (max-width: 640px) {
        display: none;
      }

      &::-webkit-scrollbar {
        display: none;
      }

      .helper {
        align-items: center;
        display: flex;
        gap: var(--size-2);
        white-space: nowrap;

        .keys {
          align-items: center;
          display: flex;
          gap: 2px;
        }

        kbd {
          align-items: center;
          background-color: var(--ui-surface-filled);
          block-size: 1.6em;
          border: 1px solid var(--ui-surface-tonal);
          border-radius: var(--radius-1);
          box-shadow: 0 1px 0 0 var(--ui-surface-tonal);
          color: var(--ui-text-strong);
          display: flex;
          font-family: var(--font-mono);
          font-size: 10px;
          justify-content: center;
          line-height: normal;
          min-inline-size: 1.6em;
          padding-inline: 4px;
        }

        span:not(.keys) {
          color: var(--ui-text);
          font-size: 11px;
          line-height: 1;
          margin-block-start: 2px; /* Move text down more to match kbd vertical center */
        }
      }
    }

    .search-empty {
      color: var(--ui-text);
      font-size: var(--font-size-1);
      margin: 0;
      padding-block: var(--size-4);
      text-align: center;
    }

    .search-more .ui-title {
      color: var(--ui-primary);
      font-weight: var(--font-weight-6);
    }

    mark {
      background: none;
      color: var(--ui-primary);
      font-weight: bold;
      padding: 0;
      text-decoration: underline;
    }
  }
</style>
