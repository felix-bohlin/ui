---
type Heading = { id: string; level: number; text: string }
type Item = Heading & { children: Item[] }

type Props = {
  headings: Heading[]
  variant?: "default" | "drawer"
}

const { headings, variant = "default" } = Astro.props

const items: Item[] = []
const stack = [{ children: items, level: 1 }]
for (const heading of headings) {
  while (stack.length > 1 && stack[stack.length - 1].level >= heading.level) {
    stack.pop()
  }
  const item = { ...heading, children: [] }
  stack[stack.length - 1].children.push(item)
  stack.push(item)
}
---

<nav
  aria-label="On this page"
  class:list={["table-of-contents", { "toc-drawer": variant === "drawer" }]}
>
  <h3>On this page</h3>
  <menu>
    <li><a href="#main-content" title="Overview">Overview</a></li>
    {items.map((item) => <li>
      <a href={`#${item.id}`} title={item.text}>{item.text}</a>
      {item.children.length > 0 && <ul>
        {item.children.map((child) => <li>
          <a href={`#${child.id}`} title={child.text}>{child.text}</a>
          {child.children.length > 0 && <ul>
            {child.children.map((grandchild) => <li>
              <a href={`#${grandchild.id}`} title={grandchild.text}>
                {grandchild.text}
              </a>
            </li>)}
          </ul>}
        </li>)}
      </ul>}
    </li>)}
  </menu>
</nav>

<style>
  nav {
    scroll-target-group: auto;
    text-align: start;

    h3 {
      font-size: var(--ui-font-size-small);
      margin-block-end: 0.5em;
      text-align: start;
    }

    menu {
      font-size: var(--ui-font-size-small);
      list-style-type: none;
      margin: 0;
      padding: 0;
    }
  }
</style>

<style is:global>
  .table-of-contents {
    ul {
      font-size: var(--ui-font-size-caption);
      list-style-type: none;
      margin: 0;
      margin-inline-start: var(--size-3);
      padding: 0;
    }

    a {
      display: block;
      overflow: hidden;
      padding-block: var(--size-1);
      position: relative;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;

      &:before {
        background-color: transparent;
        block-size: 80%;
        border-radius: var(--radius-2);
        content: "";
        inline-size: 2px;
        inset-block-start: 10%;
        inset-inline-start: calc(-1 * var(--size-3));
        position: absolute;
        transition: background-color 0.3s;
      }

      &:not([aria-current="page"]) {
        color: oklch(from currentColor l c h / 75%);
      }

      &:hover {
        color: var(--ui-primary-text);
      }

      &:target-current {
        color: var(--ui-primary-text);
        font-weight: 700;

        &:before {
          background-color: currentColor;
        }
      }
    }
  }
</style>
