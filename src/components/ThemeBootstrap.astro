---
import "../styles/custom-palette.css"
import "../styles/no-grays.css"
import "../styles/theme-fonts.css"
import { EXAMPLE_THEMES } from "../utils/example-themes"
import { PALETTE_KNOBS, THEME_KEYS, TOKENS } from "../utils/theme-store"

const exampleThemes = Object.fromEntries(
  EXAMPLE_THEMES.map((theme) => [theme.name, theme.css]),
)
---

<script
  is:inline
  define:vars={{ exampleThemes, PALETTE_KNOBS, THEME_KEYS, TOKENS }}
>
  window.themeUtils = {
    getCustomTheme(theme) {
      try {
        const config = JSON.parse(
          localStorage.getItem(`${THEME_KEYS.customTheme}-${theme}`) ?? "{}",
        )
        // Drop the legacy `--gray-hue-offset` key. The new core derives grays
        // per-element using absolute `--ui-gray-hue`, so the offset semantic no
        // longer applies. Users will fall back to the default --ui-gray-hue (255).
        delete config["--gray-hue-offset"]
        const sizes = { 1: "0.25rem", 2: "0.5rem", 3: "1rem", 4: "1.25rem" }
        for (const [name, value] of Object.entries(config)) {
          const legacy = /^var\(--(?:radius|size)-(\d)\)$/.exec(value)
          if (legacy) config[name] = sizes[legacy[1]] ?? value
        }
        return config
      } catch {
        return {}
      }
    },
    getSystemPreference() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light"
    },
    getExampleTheme() {
      try {
        const name = localStorage.getItem(THEME_KEYS.exampleTheme)
        return name && Object.hasOwn(exampleThemes, name) ? name : null
      } catch {
        return null
      }
    },
    getStoredContrast() {
      try {
        return localStorage.getItem(THEME_KEYS.contrast)
      } catch {
        return null
      }
    },
    getStoredTheme() {
      try {
        return localStorage.getItem(THEME_KEYS.theme)
      } catch {
        return null
      }
    },
    setContrast(contrast) {
      document.documentElement.classList.remove(
        "ui-contrast-more",
        "ui-contrast-normal",
      )
      if (contrast) {
        document.documentElement.classList.add(`ui-contrast-${contrast}`)
      }
      try {
        if (contrast) localStorage.setItem(THEME_KEYS.contrast, contrast)
        else localStorage.removeItem(THEME_KEYS.contrast)
      } catch {}
    },
    applyExampleTheme(name) {
      let style = document.getElementById("opui-example-theme")
      if (!name) {
        delete document.documentElement.dataset.exampleTheme
        style?.remove()
        return
      }
      document.documentElement.dataset.exampleTheme = name
      if (!style) {
        style = document.createElement("style")
        style.id = "opui-example-theme"
        document.head.append(style)
      }
      style.textContent = exampleThemes[name]
    },
    setExampleTheme(name) {
      try {
        if (name) localStorage.setItem(THEME_KEYS.exampleTheme, name)
        else localStorage.removeItem(THEME_KEYS.exampleTheme)
      } catch {}
      window.themeUtils.applyExampleTheme(name)
    },
    applyTheme(theme) {
      document.documentElement.classList.remove(
        "ui-dark",
        "ui-light",
        "dark",
        "light",
      )
      document.documentElement.classList.add(`ui-${theme}`)
      window.themeUtils.applyCustomTheme(theme)
    },
    setTheme(theme) {
      try {
        localStorage.setItem(THEME_KEYS.theme, theme)
      } catch {}
      window.themeUtils.applyTheme(theme)
    },
    applyCustomTheme(theme) {
      const currentTheme =
        theme ||
        (document.documentElement.classList.contains("ui-dark")
          ? "dark"
          : "light")

      // Reset previous custom properties before applying mode-specific ones
      TOKENS.forEach((name) =>
        document.documentElement.style.removeProperty(name),
      )
      document.documentElement.classList.remove("no-grays")

      const config = window.themeUtils.getCustomTheme(currentTheme)
      Object.entries(config).forEach(([name, value]) => {
        if (name === "enable-grays") {
          document.documentElement.classList.toggle(
            "no-grays",
            value === "false",
          )
        } else {
          document.documentElement.style.setProperty(name, value)
        }
      })

      document.documentElement.classList.toggle(
        "custom-palette",
        PALETTE_KNOBS.some((name) => name in config),
      )
      const scoped = TOKENS.filter((name) => name in config)
      let style = document.getElementById("opui-custom-theme")
      if (scoped.length === 0) {
        style?.remove()
        return
      }
      if (!style) {
        style = document.createElement("style")
        style.id = "opui-custom-theme"
        document.head.append(style)
      }
      const css = `@layer theme.custom { html .ui-palette { ${scoped
        .map((name) => `${name}: inherit;`)
        .join(" ")} } }`
      if (style.textContent !== css) style.textContent = css
    },
  }

  window.themeUtils.applyTheme(
    window.themeUtils.getStoredTheme() ||
      window.themeUtils.getSystemPreference(),
  )
  window.themeUtils.setContrast(window.themeUtils.getStoredContrast())
  window.themeUtils.applyExampleTheme(window.themeUtils.getExampleTheme())
  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (window.themeUtils.getStoredTheme()) return
      window.themeUtils.applyTheme(window.themeUtils.getSystemPreference())
    })
</script>
