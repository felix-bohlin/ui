---
import "../styles/theme-fonts.css"
import { EXAMPLE_THEMES } from "../utils/example-themes"
import {
  FONT_TOKENS,
  LAYERS,
  THEME_KEY,
  THEME_SESSION_GAP,
  THEME_SESSION_KEY,
  VIEW_KEYS,
} from "../utils/theme"
import { BUNDLED_FONTS, WEB_FONTS, fontCssUrls } from "../utils/theme-fonts"

type Props = {
  overrides?: boolean
}

const { overrides = false } = Astro.props

const exampleThemes = Object.fromEntries(
  EXAMPLE_THEMES.map((theme) => [theme.name, theme.css]),
)
const exampleFonts = Object.fromEntries(
  EXAMPLE_THEMES.map((theme) => [
    theme.name,
    Object.fromEntries(
      [...FONT_TOKENS, "--ui-font-family-code"]
        .filter((name) => name in theme.tokens)
        .map((name) => [name, theme.tokens[name]]),
    ),
  ]),
)
const webFonts = Object.fromEntries(
  WEB_FONTS.filter((font) => !BUNDLED_FONTS.includes(font.id)).map((font) => [
    font.family.toLowerCase(),
    fontCssUrls(font.id),
  ]),
)
---

<script
  is:inline
  define:vars={{
    exampleFonts,
    exampleThemes,
    FONT_TOKENS,
    LAYERS,
    overrides,
    THEME_KEY,
    THEME_SESSION_GAP,
    THEME_SESSION_KEY,
    VIEW_KEYS,
    webFonts,
  }}
>
  const params = overrides
    ? new URLSearchParams(location.search)
    : new URLSearchParams()
  const forcedScheme = ["dark", "light"].includes(params.get("scheme"))
    ? params.get("scheme")
    : null
  const forcedContrast = ["more", "normal"].includes(params.get("contrast"))
    ? params.get("contrast")
    : null

  const style = (id) => {
    let element = document.getElementById(id)
    if (!element) {
      element = document.createElement("style")
      element.id = id
    }
    return element
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

  const turned = (value) => {
    const color = value.trim()
    if (color.startsWith("light-dark(") && color.endsWith(")")) {
      const inner = color.slice("light-dark(".length, -1)
      let depth = 0
      for (let index = 0; index < inner.length; index++) {
        if (inner[index] === "(") depth++
        else if (inner[index] === ")") depth--
        else if (inner[index] === "," && depth === 0) {
          return `light-dark(${turned(inner.slice(0, index))}, ${turned(inner.slice(index + 1))})`
        }
      }
    }
    return `oklch(from ${color} l c calc(h + var(--site-hue-drift)))`
  }

  window.themeUtils = {
    getSystemPreference() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light"
    },
    getStoredContrast() {
      try {
        return localStorage.getItem(VIEW_KEYS.contrast)
      } catch {
        return null
      }
    },
    getStoredDrift() {
      try {
        return localStorage.getItem(VIEW_KEYS.drift)
      } catch {
        return null
      }
    },
    driftEnabled() {
      if (overrides) return false
      const stored = window.themeUtils.getStoredDrift()
      if (stored) return stored === "on"
      return !navigator.webdriver && !reducedMotion.matches
    },
    applyDrift() {
      const drift = style("opui-hue-drift")
      drift.textContent = ""
      if (!window.themeUtils.driftEnabled()) {
        drift.remove()
        return
      }
      const computed = getComputedStyle(document.documentElement)
      const source = computed.getPropertyValue("--ui-palette-source").trim()
      const primary = computed.getPropertyValue("--ui-primary-source").trim()
      if (!source || !primary) {
        window.addEventListener("load", window.themeUtils.applyDrift, {
          once: true,
        })
        return
      }
      if (/[;{}<]/.test(source + primary)) return
      drift.textContent = `@property --site-hue-drift { syntax: "<number>"; inherits: true; initial-value: 0; }
@keyframes site-hue-drift { to { --site-hue-drift: 360; } }
@supports (animation-timeline: scroll()) {
  :root {
    --ui-palette-source: ${turned(source)};
    --ui-primary-source: ${turned(primary)};
    animation: site-hue-drift linear both;
    animation-timeline: scroll(root block);
  }
}`
      if (!drift.isConnected) {
        const presetStyle = document.getElementById("opui-example-theme")
        if (presetStyle) presetStyle.before(drift)
        else document.head.append(drift)
      }
    },
    setDrift(on) {
      try {
        localStorage.setItem(VIEW_KEYS.drift, on ? "on" : "off")
      } catch {}
      window.themeUtils.applyDrift()
    },
    getStoredTheme() {
      try {
        return localStorage.getItem(VIEW_KEYS.mode)
      } catch {
        return null
      }
    },
    readTheme() {
      try {
        const theme = JSON.parse(localStorage.getItem(THEME_KEY) ?? "null")
        if (theme && typeof theme === "object") return theme
        const preset = localStorage.getItem("opui-example-theme")
        if (preset) return { css: "", preset, tokens: {} }
      } catch {}
      return null
    },
    applyContrast(contrast) {
      document.documentElement.classList.remove(
        "ui-contrast-more",
        "ui-contrast-normal",
      )
      if (contrast) {
        document.documentElement.classList.add(`ui-contrast-${contrast}`)
      }
    },
    setContrast(contrast) {
      window.themeUtils.applyContrast(forcedContrast ?? contrast)
      try {
        if (contrast) localStorage.setItem(VIEW_KEYS.contrast, contrast)
        else localStorage.removeItem(VIEW_KEYS.contrast)
      } catch {}
    },
    applyThemeCss(preset, css, tokens) {
      const root = document.documentElement
      const presetStyle = style("opui-example-theme")
      const customStyle = style("opui-theme")
      const presetCss =
        typeof preset === "string" && Object.hasOwn(exampleThemes, preset)
          ? exampleThemes[preset]
          : ""
      const presetText = presetCss || LAYERS
      if (presetStyle.textContent !== presetText) {
        presetStyle.textContent = presetText
      }
      if (customStyle.textContent !== css) customStyle.textContent = css
      if (
        document.head.lastElementChild !== customStyle ||
        customStyle.previousElementSibling !== presetStyle
      ) {
        document.head.append(presetStyle, customStyle)
      }
      if (presetCss) root.dataset.exampleTheme = preset
      else delete root.dataset.exampleTheme
      root.toggleAttribute(
        "data-theme-font",
        FONT_TOKENS.some((name) => Object.hasOwn(tokens ?? {}, name)),
      )
      const stacks = { ...exampleFonts[preset], ...tokens }
      for (const name of [...FONT_TOKENS, "--ui-font-family-code"]) {
        const family = String(stacks[name] ?? "")
          .split(",")[0]
          .trim()
          .replace(/^["']|["']$/g, "")
          .toLowerCase()
        for (const url of webFonts[family] ?? []) {
          if (!document.querySelector(`link[href="${url}"]`)) {
            const link = document.createElement("link")
            link.rel = "stylesheet"
            link.href = url
            document.head.append(link)
          }
        }
      }
      window.themeUtils.applyDrift()
    },
    applyStoredTheme() {
      const theme = window.themeUtils.readTheme()
      window.themeUtils.applyThemeCss(
        theme?.preset ?? null,
        typeof theme?.css === "string" ? theme.css : "",
        theme?.tokens,
      )
    },
    applyTheme(theme) {
      document.documentElement.classList.remove(
        "ui-dark",
        "ui-light",
        "dark",
        "light",
      )
      document.documentElement.classList.add(`ui-${forcedScheme ?? theme}`)
    },
    setTheme(theme) {
      try {
        localStorage.setItem(VIEW_KEYS.mode, theme)
      } catch {}
      window.themeUtils.applyTheme(theme)
    },
  }

  const applyMode = () =>
    window.themeUtils.applyTheme(
      window.themeUtils.getStoredTheme() ||
        window.themeUtils.getSystemPreference(),
    )

  const stampSession = () => {
    try {
      localStorage.setItem(THEME_SESSION_KEY, String(Date.now()))
    } catch {}
  }

  const rotateTheme = () => {
    try {
      const last = Number(localStorage.getItem(THEME_SESSION_KEY))
      if (Date.now() - last < THEME_SESSION_GAP) return
      const theme = window.themeUtils.readTheme()
      if (Object.keys(theme?.tokens ?? {}).length > 0) return
      const current = theme?.preset ?? null
      const choices = [null, ...Object.keys(exampleThemes)].filter(
        (preset) => preset !== current,
      )
      const preset = choices[Math.floor(Math.random() * choices.length)]
      localStorage.setItem(
        THEME_KEY,
        JSON.stringify({ css: "", preset, tokens: {} }),
      )
    } catch {}
  }

  if (!navigator.webdriver) {
    rotateTheme()
    stampSession()
    window.addEventListener("pagehide", stampSession)
  }

  applyMode()
  window.themeUtils.applyContrast(
    forcedContrast ?? window.themeUtils.getStoredContrast(),
  )
  window.themeUtils.applyStoredTheme()

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      if (!window.themeUtils.getStoredTheme()) applyMode()
    })

  reducedMotion.addEventListener("change", () => {
    if (!window.themeUtils.getStoredDrift()) window.themeUtils.applyDrift()
  })

  window.addEventListener("storage", (event) => {
    if (event.key === null || event.key === THEME_KEY) {
      window.themeUtils.applyStoredTheme()
    }
    if (event.key === null || event.key === VIEW_KEYS.mode) applyMode()
    if (event.key === null || event.key === VIEW_KEYS.drift) {
      window.themeUtils.applyDrift()
    }
    if (event.key === null || event.key === VIEW_KEYS.contrast) {
      window.themeUtils.applyContrast(
        forcedContrast ?? window.themeUtils.getStoredContrast(),
      )
    }
  })
</script>
