---
import {
  Button,
  ColorField,
  Range,
  Select,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import {
  CODE_FONTS,
  FONTS,
  controlTokens,
  type Control,
} from "../../utils/theme-builder-controls"
import { CORNERS } from "../../utils/theme"
import BrandPicker from "../BrandPicker.astro"

type Props = { control: Control }

const { control } = Astro.props
const base = `builder-${control.id}`
const labelId = `${base}-label`
const hintId = control.hint ? `${base}-hint` : undefined
const valueId = `${base}-value`
const originId = `${base}-origin`
const describedBy = [hintId, valueId, originId].filter(Boolean).join(" ")
const tokens = controlTokens(control)
const fontOf = (label: string) =>
  [...FONTS, ...CODE_FONTS].find((font) => font.label === label)?.value
const optionGroups =
  control.kind === "choice" && control.display === "select"
    ? [...new Set(control.options.map((option) => option.group))]
    : []
const groupedOptions = (group: string | undefined) =>
  control.kind === "choice"
    ? control.options.filter((option) => option.group === group)
    : []
const options =
  control.kind === "choice"
    ? control.options
    : control.kind === "corners"
      ? CORNERS.map((corner) => ({ label: corner.label, value: corner.value }))
      : []
const isColor = control.kind === "color" || control.kind === "brand"
const name = control.kind === "brand" ? "Brand color" : control.label
---

<div
  class="builder-control"
  data-control={control.id}
  data-kind={control.kind}
  data-name={name}
  data-tier={control.tier}
>
  <div class="builder-control-head">
    <span class="builder-control-label" id={labelId} title={tokens.join("\n")}
      >{control.label}</span
    >
    <span class="builder-control-origin ui-sr-only" data-origin id={originId}
      >Default value</span
    >
    <Button
      aria-label={`Show what ${name.toLowerCase()} changes`}
      class="builder-control-spot"
      data-spot
      round
      size="x-small"
      title="Show me in the preview"
      variant="transparent"
    >
      <svg
        aria-hidden="true"
        height="24"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          fill="currentColor"
          d="M12 9.005a4 4 0 1 1 0 8a4 4 0 0 1 0-8m0 1.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 0 0 0-5M12 5.5c4.613 0 8.596 3.15 9.701 7.564a.75.75 0 1 1-1.455.365a8.504 8.504 0 0 0-16.493.004a.75.75 0 0 1-1.455-.363A10.003 10.003 0 0 1 12 5.5"
        ></path></svg
      >
    </Button>
    <Button
      aria-label={`Reset ${name.toLowerCase()}`}
      class="builder-control-reset"
      data-reset
      disabled
      round
      size="x-small"
      title="Back to the preset value"
      variant="transparent"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M12 5V2.21c0-.45-.54-.67-.85-.35l-3.8 3.79c-.2.2-.2.51 0 .71l3.79 3.79c.32.31.86.09.86-.36V7c3.73 0 6.68 3.42 5.86 7.29c-.47 2.27-2.31 4.1-4.57 4.57c-3.57.75-6.75-1.7-7.23-5.01a1 1 0 0 0-.98-.85c-.6 0-1.08.53-1 1.13c.62 4.39 4.8 7.64 9.53 6.72c3.12-.61 5.63-3.12 6.24-6.24C20.84 9.48 16.94 5 12 5"
        ></path></svg
      >
    </Button>
  </div>
  {
    control.hint && (
      <p class="builder-control-hint" id={hintId}>
        {control.hint}
      </p>
    )
  }

  {
    isColor && (
      <div class="builder-colors">
        <div class="builder-color" data-mode="light">
          {control.kind === "brand" ? (
            <BrandPicker
              aria-describedby={describedBy}
              aria-labelledby={labelId}
              custom={{ "data-color": "light" }}
              name={`${base}-swatch`}
            />
          ) : (
            <ColorField
              aria-describedby={describedBy}
              data-color="light"
              data-label={name}
              label={name}
              size="small"
              swatchOnly
            />
          )}
          <span aria-hidden="true" class="builder-color-caption" data-caption />
        </div>
        <div class="builder-color" data-mode="dark" hidden>
          <ColorField
            data-color="dark"
            label={`${name} in dark mode`}
            opacity={control.kind === "color" ? "slider" : "none"}
            size="small"
            swatchOnly
          />
          <span aria-hidden="true" class="builder-color-caption" data-caption />
        </div>
        <Button
          aria-label="Different in dark mode"
          aria-pressed="false"
          class="builder-dual"
          data-dual
          round
          size="x-small"
          title="Different in dark mode"
          variant="outlined"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill="currentColor"
              d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20m0 2v16a8 8 0 1 1 0-16"
            />
          </svg>
        </Button>
      </div>
    )
  }

  {
    (control.kind === "corners" ||
      (control.kind === "choice" && control.display === "toggle")) && (
      <ToggleGroup
        aria-describedby={describedBy}
        aria-labelledby={labelId}
        name={base}
        size="small"
      >
        {options.map((option) => (
          <ToggleButton value={option.value}>{option.label}</ToggleButton>
        ))}
      </ToggleGroup>
    )
  }

  {
    control.kind === "choice" && control.display === "select" && (
      <Select
        aria-describedby={describedBy}
        hideLabel
        label={control.label}
        name={base}
        size="small"
      >
        <option disabled hidden value="custom">
          Custom
        </option>
        {optionGroups.map((group) => {
          const options = groupedOptions(group).map((option) => (
            <option
              style={
                control.font && fontOf(option.label)
                  ? `font-family: ${fontOf(option.label)}`
                  : undefined
              }
              value={option.value}
            >
              {option.label}
            </option>
          ))
          return group ? <optgroup label={group}>{options}</optgroup> : options
        })}
      </Select>
    )
  }

  {
    control.kind === "range" && (
      <Range
        aria-describedby={describedBy}
        hideLabel
        label={control.label}
        max={control.max}
        min={control.min}
        name={base}
        size="small"
        step={control.step}
      />
    )
  }

  <p class="builder-control-value" id={valueId} data-value></p>
</div>

<style>
  .builder-control {
    border-radius: var(--ui-radius);
    display: grid;
    gap: var(--size-2);
    min-inline-size: 0;

    &[hidden] {
      display: none;
    }

    &.is-highlighted {
      animation: builder-flash 1.2s var(--ui-ease, ease-out);
    }

    > :global(.ui-toggle-group) {
      inline-size: 100%;
    }

    > :global(.ui-select),
    > :global(.ui-range) {
      inline-size: 100%;
    }
  }

  @keyframes builder-flash {
    from {
      box-shadow: 0 0 0 var(--size-2)
        var(--ui-primary-tonal, var(--ui-surface-tonal));
    }

    to {
      box-shadow: 0 0 0 var(--size-2) transparent;
    }
  }

  .builder-control-head {
    align-items: center;
    display: flex;
    gap: var(--size-2);
    min-block-size: var(--ui-control-size-x-small);
  }

  .builder-control-label {
    color: var(--ui-text-strong);
    flex: 1;
    font-size: var(--ui-font-size-small);
    font-weight: var(--ui-font-weight-semibold);
  }

  .builder-control-origin {
    background-color: var(--ui-primary-tonal, var(--ui-surface-tonal));
    border-radius: var(--ui-radius-round);
    color: var(--ui-on-primary-tonal, var(--ui-text-strong));
    font-size: var(--ui-font-size-caption);
    font-weight: var(--ui-font-weight-semibold);
    line-height: var(--ui-line-height-tight);
    padding: 0.125em 0.625em;
  }

  .builder-control-reset:disabled {
    visibility: hidden;
  }

  .builder-control-spot {
    opacity: 0.6;

    .builder-control:hover &,
    &:focus-visible {
      opacity: 1;
    }
  }

  .builder-control-hint,
  .builder-control-value {
    color: var(--ui-text-subtle);
    font-size: var(--ui-font-size-caption);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .builder-control-hint {
    margin-block-start: calc(-1 * var(--size-2));
  }

  .builder-control-value:empty {
    display: none;
  }

  :is([data-kind="brand"], [data-kind="color"]) .builder-control-value {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  .builder-colors {
    align-items: center;
    column-gap: var(--size-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    row-gap: var(--size-2);
  }

  .builder-color {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    grid-column: 1;
    min-inline-size: 0;

    &[hidden] {
      display: none;
    }
  }

  .builder-colors :global(.builder-dual) {
    align-self: start;
    grid-column: 2;
    grid-row: 1 / span 2;

    &[aria-pressed="true"] {
      background-color: var(--ui-primary-tonal, var(--ui-surface-tonal));
      border-color: transparent;
      color: var(--ui-on-primary-tonal, var(--ui-text-strong));
    }
  }

  .builder-color-caption {
    color: var(--ui-text);
    font-family: var(--font-mono);
    font-size: var(--ui-font-size-caption);
  }
</style>
