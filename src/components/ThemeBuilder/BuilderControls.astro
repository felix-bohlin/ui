---
import { Accordion, AccordionContent, AccordionSummary } from "opui-css/astro"
import themeCss from "../../../packages/opui/css/theme.css?raw"
import { GROUPS, libraryDefaults } from "../../utils/theme-builder-controls"
import BuilderControl from "./BuilderControl.astro"

const defaults = JSON.stringify(libraryDefaults(themeCss))
---

<section
  aria-labelledby="builder-settings-title"
  class="builder-controls"
  data-defaults={defaults}
>
  <h2 class="ui-sr-only" id="builder-settings-title">Settings</h2>
  {
    GROUPS.map((group) => {
      const basic = group.controls.filter((control) => control.tier === "basic")
      const fine = group.controls.filter((control) => control.tier === "fine")
      return (
        <section
          aria-labelledby={`builder-group-${group.id}`}
          class="builder-group"
          data-group={group.id}
        >
          <header class="builder-group-head">
            <h3 id={`builder-group-${group.id}`}>
              {group.label}
              <span class="builder-count" data-count hidden />
            </h3>
            <p>{group.description}</p>
          </header>
          {basic.map((control) => (
            <BuilderControl control={control} />
          ))}
          {fine.length > 0 && (
            <Accordion class="builder-fine" data-fine variant="outlined">
              <AccordionSummary>
                <span>Fine-tune</span>
                <span class="builder-fine-meta" data-fine-meta>
                  {fine.length} more{" "}
                  {fine.length === 1 ? "setting" : "settings"}
                </span>
              </AccordionSummary>
              <AccordionContent>
                {fine.map((control) => (
                  <BuilderControl control={control} />
                ))}
              </AccordionContent>
            </Accordion>
          )}
        </section>
      )
    })
  }
</section>

<script>
  import { syncBrandPicker } from "../../utils/brand-picker"
  import {
    colorToOklch,
    formatOklch,
    parseOklch,
  } from "../../utils/color-utils"
  import { exampleTheme } from "../../utils/example-themes"
  import { OklchInput } from "../../utils/oklch-input"
  import {
    CORNERS,
    cornersTokens,
    cornersUpdate,
    themeStore,
    type ThemeTokens,
  } from "../../utils/theme"
  import {
    BALANCED_PRIMARY,
    COMPONENT_RADII,
    CONTROLS,
    FOLLOW_RADIUS,
    MONOCHROME_PRIMARY,
    canonical,
    controlTokens,
    isChanged,
    isFollow,
    matchOption,
    ownTokens,
    tidy,
    type ChoiceControl,
    type ColorControl,
    type Control,
    type RangeControl,
  } from "../../utils/theme-builder-controls"
  import { brandTokens, brandUpdate } from "../../utils/theme-brand"

  type Update = Record<string, string | null>

  const root = document.querySelector<HTMLElement>(".builder-controls")
  if (root) {
    const defaults: ThemeTokens = JSON.parse(root.dataset.defaults ?? "{}")
    const controls = new Map(CONTROLS.map((control) => [control.id, control]))
    const elements = new Map(
      [...root.querySelectorAll<HTMLElement>("[data-control]")].map(
        (element) => [element.dataset.control!, element],
      ),
    )
    const dual = new Set<string>()
    const picked = new Set<string>()
    let theme = themeStore.get()
    let first = true
    let queued: Update | null = null
    let frame = 0

    const hosts = (["light", "dark"] as const).map((scheme) => {
      const host = document.createElement("div")
      host.className = `ui-${scheme}`
      host.hidden = true
      host.style.color = "transparent"
      host.style.forcedColorAdjust = "none"
      root.append(host)
      return host
    })
    const lengthProbe = document.createElement("div")
    lengthProbe.hidden = true
    lengthProbe.style.forcedColorAdjust = "none"
    root.append(lengthProbe)

    const presetTokens = () => exampleTheme(theme.preset)?.tokens ?? {}
    const valueOf = (token: string) =>
      theme.tokens[token] ?? presetTokens()[token]
    const baseOf = (token: string) => presetTokens()[token]
    const same = (token: string, a?: string, b?: string) =>
      canonical(a, token, defaults) === canonical(b, token, defaults)

    const toColor = (value: string) => {
      const parsed = parseOklch(value)
      return parsed && { value: formatOklch(parsed, parsed.alpha) }
    }

    const resolveColors = (expressions: string[]) => {
      for (const host of hosts) {
        host.replaceChildren(
          ...expressions.map((expression) => {
            const probe = document.createElement("div")
            probe.style.color = `oklch(from ${expression} l c h / alpha)`
            return probe
          }),
        )
      }
      const resolved = hosts.map((host) =>
        [...host.children].map((probe) =>
          toColor(getComputedStyle(probe).color),
        ),
      )
      return new Map(
        expressions.map((expression, index) => [
          expression,
          resolved.map((mode) => mode[index]),
        ]),
      )
    }

    const resolvePx = (expression: string) => {
      lengthProbe.style.inlineSize = expression
      const px = parseFloat(getComputedStyle(lengthProbe).inlineSize)
      lengthProbe.style.inlineSize = ""
      return Number.isFinite(px) ? px : null
    }

    const round = (value: number, digits = 4) => +value.toFixed(digits)

    const colorText = (color: ReturnType<typeof toColor>) =>
      color ? color.value : "not set"

    const describeColor = (
      [light, dark]: ReturnType<typeof toColor>[],
      isDual: boolean,
    ) =>
      isDual
        ? `Light ${colorText(light)}, dark ${colorText(dark)}`
        : colorText(light)

    const changed = (control: Control) =>
      isChanged(control, theme.tokens, presetTokens())

    const resetTokens = (control: Control): Update => {
      if (control.kind === "corners") {
        return Object.fromEntries(
          Object.keys(cornersTokens(null))
            .filter(
              (token) =>
                !COMPONENT_RADII.includes(token) ||
                isFollow(theme.tokens[token]),
            )
            .map((token) => [token, null]),
        )
      }
      return Object.fromEntries(
        ownTokens(control, theme.tokens).map((token) => [
          token,
          COMPONENT_RADII.includes(token) &&
          "--ui-radius" in theme.tokens &&
          (baseOf(token) === undefined || isFollow(baseOf(token)))
            ? FOLLOW_RADIUS
            : null,
        ]),
      )
    }

    const flush = () => {
      cancelAnimationFrame(frame)
      frame = 0
      if (!queued) return
      const update = queued
      queued = null
      themeStore.update(update)
    }

    const write = (update: Update, throttle = false) => {
      queued = { ...queued, ...update }
      if (!throttle) flush()
      else if (!frame) frame = requestAnimationFrame(flush)
    }

    const paletteColor = () =>
      resolveColors(["var(--ui-palette-source)"]).get(
        "var(--ui-palette-source)",
      )?.[0]?.value ?? null

    const fitted = new Map<string, string>()

    const autoPrimary = (color: string | null) => {
      if (!color) return null
      if (!fitted.has(color)) {
        fitted.set(color, brandTokens(color)["--ui-primary-source"])
      }
      return fitted.get(color)!
    }

    const isFitted = (primary: string) => {
      const source = valueOf("--ui-palette-source")
      const base = source ? colorToOklch(source) : null
      const sides = primary
        .match(/^light-dark\((.*)\)$/)?.[1]
        .split(/,(?![^(]*\))/)
        .map((side) => side.trim())
      if (!source || !base || sides?.length !== 2) return false
      const others = sides.filter((side) => !same("", side, source))
      return (
        others.length === 1 &&
        others.every((side) => {
          const fit = colorToOklch(side)
          return (
            !!fit &&
            Math.abs(fit.C - base.C) < 0.002 &&
            (base.C < 0.002 ||
              Math.abs(((fit.H - base.H + 540) % 360) - 180) < 0.2)
          )
        })
      )
    }

    const toneOf = (primary: string | undefined, color: string | null) => {
      const token = "--ui-primary-source"
      if (same(token, primary, BALANCED_PRIMARY)) return "balanced"
      if (same(token, primary, MONOCHROME_PRIMARY)) return "monochrome"
      if (
        primary?.startsWith("light-dark(") &&
        !primary.includes("var(") &&
        !isFitted(primary) &&
        !same(token, primary, autoPrimary(color) ?? undefined)
      ) {
        return "dual"
      }
      return "brand"
    }

    const grayHue = (color: string | null) => {
      const oklch = color ? colorToOklch(color) : null
      return oklch ? `${Math.round(oklch.H)}` : null
    }

    const applyBrand = (color: string, darkColor?: string) => {
      const update: Update = brandUpdate(
        {
          ...theme.tokens,
          "--ui-palette-source":
            theme.tokens["--ui-palette-source"] ?? paletteColor() ?? "",
        },
        color,
      )
      if (darkColor) {
        update["--ui-primary-source"] = `light-dark(${color}, ${darkColor})`
      }
      return update
    }

    const choiceTokens = (control: ChoiceControl, value: string): Update => {
      if (control.dynamic === "primary-tone") {
        const primary =
          value === "balanced"
            ? BALANCED_PRIMARY
            : value === "monochrome"
              ? MONOCHROME_PRIMARY
              : autoPrimary(paletteColor())
        return { "--ui-primary-source": primary }
      }
      if (control.dynamic === "brand-hue" && value === "brand") {
        return {
          "--ui-gray-chroma": "0.012",
          "--ui-gray-hue": grayHue(paletteColor()),
        }
      }
      const option = control.options.find((entry) => entry.value === value)
      return Object.fromEntries(
        controlTokens(control).map((token) => [
          token,
          option?.tokens[token] ?? null,
        ]),
      )
    }

    const choiceValue = (
      control: ChoiceControl,
      read: (token: string) => string | undefined,
      color: string | null,
    ) => {
      if (control.dynamic === "primary-tone") {
        const tone = toneOf(read("--ui-primary-source"), color)
        return tone === "dual" ? "brand" : tone
      }
      if (
        control.dynamic === "brand-hue" &&
        color &&
        same("--ui-gray-chroma", read("--ui-gray-chroma"), "0.012") &&
        same("--ui-gray-hue", read("--ui-gray-hue"), grayHue(color) ?? "")
      ) {
        return "brand"
      }
      return matchOption(control.options, read, defaults)?.value ?? null
    }

    const check = (element: HTMLElement, value: string | null) => {
      for (const radio of element.querySelectorAll<HTMLInputElement>(
        "input[type=radio]",
      )) {
        radio.checked = radio.value.toLowerCase() === value?.toLowerCase()
      }
    }

    const setColorInputs = (
      element: HTMLElement,
      [light, dark]: ReturnType<typeof toColor>[],
      isDual: boolean,
    ) => {
      const [lightInput, darkInput] = [
        ...element.querySelectorAll<OklchInput>("oklch-input[data-color]"),
      ]
      const darkField = element.querySelector<HTMLElement>("[data-mode=dark]")!
      const dualBox = element.querySelector<HTMLInputElement>(
        "[data-dual] input, input[data-dual]",
      )!
      if (light) lightInput.value = light.value
      darkInput.value = (dark ?? light)?.value ?? ""
      darkField.hidden = !isDual
      dualBox.checked = isDual
      element.classList.toggle("is-dual", isDual)
      const [lightCaption, darkCaption] =
        element.querySelectorAll<HTMLElement>("[data-caption]")
      lightCaption.textContent = isDual
        ? `Light ${colorText(light)}`
        : colorText(light)
      darkCaption.textContent = `Dark ${colorText(dark)}`
      const name = element.dataset.name ?? ""
      lightInput.label = isDual
        ? `${name} in light mode`
        : (lightInput.dataset.label ?? name)
    }

    const formatRange = (control: RangeControl, value: number) =>
      control.display === "percent"
        ? `${Math.round(value * 100)}%`
        : `${round(value)}${control.unit}`

    const rangeNumber = (control: RangeControl) => {
      const raw = valueOf(control.token)
      const value = raw?.trim()
      const toUnit = (number: number, unit: string) =>
        control.unit === "rem" && unit === "px"
          ? number / 16
          : control.unit === "px" && unit === "rem"
            ? number * 16
            : number
      const plain = value?.match(/^(-?[\d.]+)(px|rem)?$/)
      if (plain) return toUnit(Number(plain[1]), plain[2] ?? control.unit)
      const scaled = value?.match(
        /^calc\((-?[\d.]+)(px|rem) \* var\(--ui-density\)\)$/,
      )
      if (scaled) return toUnit(Number(scaled[1]), scaled[2])
      if (control.unit === "") {
        return Number(defaults[control.token] ?? control.min)
      }
      const px = resolvePx(
        `var(${control.token}${control.fallback ? `, ${control.fallback}` : ""})`,
      )
      if (px === null) return control.min
      const density =
        control.scale === "density"
          ? Number(valueOf("--ui-density") ?? defaults["--ui-density"] ?? 1)
          : 1
      return toUnit(px / density, "px")
    }

    const render = () => {
      fitted.clear()
      const colorExpressions = [
        "var(--ui-palette-source)",
        "var(--ui-primary-source)",
        ...CONTROLS.filter(
          (control): control is ColorControl => control.kind === "color",
        ).map((control) => `var(${control.token})`),
      ]
      const colors = resolveColors(colorExpressions)
      const palette = colors.get("var(--ui-palette-source)")?.[0]?.value ?? null
      const tone = toneOf(valueOf("--ui-primary-source"), palette)
      const ranges = new Map(
        CONTROLS.filter(
          (control): control is RangeControl => control.kind === "range",
        ).map((control) => [control.id, rangeNumber(control)]),
      )

      for (const [id, element] of elements) {
        const control = controls.get(id)
        if (!control) continue
        const isChanged = changed(control)
        const origin = element.querySelector<HTMLElement>("[data-origin]")!
        origin.textContent = isChanged
          ? "Yours"
          : theme.preset
            ? "Preset"
            : "Default"
        element.classList.toggle("is-changed", isChanged)
        element.querySelector<HTMLButtonElement>("[data-reset]")!.disabled =
          !isChanged
        const valueText = element.querySelector<HTMLElement>("[data-value]")!
        const owner = isChanged ? "Your" : theme.preset ? "Preset" : "Default"
        let text = ""

        if (control.kind === "brand") {
          const isDual = dual.has(id) || tone === "dual"
          const pair = isDual
            ? colors.get("var(--ui-primary-source)")!
            : colors.get("var(--ui-palette-source)")!
          setColorInputs(element, pair, isDual)
          syncBrandPicker(
            element.querySelector<HTMLElement>(".brand-picker")!,
            theme.preset,
            theme.tokens["--ui-palette-source"] ?? null,
          )
          text = describeColor(pair, isDual)
        } else if (control.kind === "color") {
          const pair = colors.get(`var(${control.token})`)!
          const isDual =
            dual.has(id) ||
            (!!pair[0] && !!pair[1] && pair[0].value !== pair[1].value)
          setColorInputs(element, pair, isDual)
          text = describeColor(pair, isDual)
        } else if (control.kind === "corners") {
          const radius = valueOf("--ui-radius")
          const match = CORNERS.find((corner) =>
            same("--ui-radius", radius, corner.value),
          )
          check(element, match?.value ?? null)
          const value = radius ?? defaults["--ui-radius"]
          text = match ? `${match.label}, ${value}` : `${owner} value, ${value}`
        } else if (control.kind === "choice") {
          const value = choiceValue(control, valueOf, palette)
          const option = control.options.find((entry) => entry.value === value)
          if (control.display === "select") {
            const select = element.querySelector("select")!
            if (document.activeElement !== select) {
              select.value = value ?? "custom"
            }
          } else {
            check(element, value)
          }
          const tokens = controlTokens(control)
          text = option
            ? ""
            : tokens.length === 1
              ? `${owner} value, ${tidy(valueOf(tokens[0]) ?? "not set")}`
              : `${owner} values: ${tokens
                  .filter((token) => valueOf(token) !== undefined)
                  .map((token) => `${token}: ${tidy(valueOf(token)!)}`)
                  .join("; ")}`
          if (control.display === "select") {
            element.querySelector<HTMLOptionElement>(
              "option[value=custom]",
            )!.textContent = `${owner} value`
          }
        } else if (control.kind === "range") {
          const raw = valueOf(control.token)
          const number = ranges.get(id) ?? control.min
          const input =
            element.querySelector<HTMLInputElement>("input[type=range]")!
          if (document.activeElement !== input) {
            input.value = `${Math.min(control.max, Math.max(control.min, number))}`
          }
          const formatted = formatRange(control, number)
          text =
            control.follows && (raw === undefined || isFollow(raw))
              ? `${control.follows}, ${formatted}`
              : formatted
          input.setAttribute("aria-valuetext", text)
        }
        valueText.textContent = text
      }

      for (const group of root.querySelectorAll<HTMLElement>("[data-group]")) {
        const all = [...group.querySelectorAll<HTMLElement>("[data-control]")]
        const count = all.filter((element) =>
          element.classList.contains("is-changed"),
        ).length
        const badge = group.querySelector<HTMLElement>("[data-count]")!
        badge.hidden = count === 0
        badge.textContent = count === 1 ? "1 change" : `${count} changes`
        const fine = group.querySelector<HTMLDetailsElement>("[data-fine]")
        if (fine) {
          const fineControls = all.filter(
            (element) => element.dataset.tier === "fine",
          )
          const fineCount = fineControls.filter((element) =>
            element.classList.contains("is-changed"),
          ).length
          fine.querySelector("[data-fine-meta]")!.textContent =
            fineCount > 0
              ? `${fineCount} of ${fineControls.length} changed`
              : `${fineControls.length} more ${fineControls.length === 1 ? "setting" : "settings"}`
          if (first && fineCount > 0) fine.open = true
        }
      }
      first = false
    }

    const onColor = (
      control: Control,
      element: HTMLElement,
      throttle: boolean,
    ) => {
      const [light, dark] = [
        ...element.querySelectorAll<OklchInput>("oklch-input[data-color]"),
      ].map((input) => input.value)
      const isDual = element.classList.contains("is-dual")
      if (control.kind === "brand") {
        if (isDual) dual.add(control.id)
        write(applyBrand(light, isDual ? dark : undefined), throttle)
      } else if (control.kind === "color") {
        const value = isDual ? `light-dark(${light}, ${dark})` : light
        write(
          {
            [control.token]: value,
            ...Object.fromEntries(
              (control.follow ?? []).map((token) => [
                token,
                `var(${control.token})`,
              ]),
            ),
          },
          throttle,
        )
      }
    }

    const onChange = (event: Event) => {
      const target = event.target
      if (!(target instanceof HTMLElement)) return
      const element = target.closest<HTMLElement>("[data-control]")
      const control = element && controls.get(element.dataset.control!)
      if (!element || !control) return
      const throttle = event.type === "input"

      if (target instanceof OklchInput) {
        if (element.classList.contains("is-dual")) picked.add(control.id)
        onColor(control, element, throttle)
        return
      }
      if (target instanceof HTMLInputElement && target.type === "checkbox") {
        if (event.type !== "change") return
        if (target.checked) {
          dual.add(control.id)
          picked.delete(control.id)
          element.classList.add("is-dual")
          render()
        } else {
          const opened = dual.delete(control.id)
          const changedColor = picked.delete(control.id)
          element.classList.remove("is-dual")
          if (opened && !changedColor) render()
          else onColor(control, element, false)
        }
        return
      }
      if (event.type !== "change" && !(target instanceof HTMLInputElement)) {
        return
      }

      if (control.kind === "brand" && target instanceof HTMLInputElement) {
        if (event.type !== "change" || !target.checked) return
        const dark = element.querySelector<OklchInput>(
          'oklch-input[data-color="dark"]',
        )!
        if (target.value && element.classList.contains("is-dual")) {
          dual.add(control.id)
          write(applyBrand(target.value, dark.value))
          return
        }
        dual.delete(control.id)
        picked.delete(control.id)
        write(target.value ? applyBrand(target.value) : resetTokens(control))
      } else if (
        control.kind === "corners" &&
        event.type === "change" &&
        target instanceof HTMLInputElement &&
        target.checked
      ) {
        write(cornersUpdate(theme.tokens, target.value))
      } else if (control.kind === "choice" && event.type === "change") {
        const value = (target as HTMLInputElement | HTMLSelectElement).value
        if (target instanceof HTMLInputElement && !target.checked) return
        const update = choiceTokens(control, value)
        const isBase = Object.entries(update).every(([token, written]) =>
          same(token, written ?? undefined, baseOf(token)),
        )
        write(
          isBase
            ? Object.fromEntries(
                Object.keys(update).map((token) => [token, null]),
              )
            : update,
        )
      } else if (control.kind === "range") {
        const number = Number((target as HTMLInputElement).value)
        target.setAttribute("aria-valuetext", formatRange(control, number))
        const value =
          control.scale === "density"
            ? `calc(${number}${control.unit} * var(--ui-density))`
            : `${number}${control.unit}`
        write({ [control.token]: value }, throttle)
      }
    }

    root.addEventListener("input", onChange)
    root.addEventListener("change", onChange)
    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        "[data-reset]",
      )
      const element = button?.closest<HTMLElement>("[data-control]")
      const control = element && controls.get(element.dataset.control!)
      if (!control) return
      dual.delete(control.id)
      picked.delete(control.id)
      write(resetTokens(control))
      element
        .querySelector<HTMLElement>(
          "input:not([type=checkbox], [type=radio]), select, input:checked, input[type=radio], .oklch-trigger",
        )
        ?.focus()
    })

    render()
    themeStore.subscribe((next) => {
      theme = next
      render()
    })
    new MutationObserver(render).observe(document.documentElement, {
      attributeFilter: ["class"],
    })
  }
</script>

<style>
  .builder-controls {
    display: grid;
    gap: var(--size-5);
    min-inline-size: 0;
  }

  .builder-group {
    border-block-start: var(--ui-border-width) solid var(--ui-border-color);
    display: grid;
    gap: var(--size-4);
    padding-block-start: var(--size-4);

    &:first-of-type {
      border-block-start: 0;
      padding-block-start: 0;
    }
  }

  .builder-group-head {
    display: grid;
    gap: var(--size-1);

    h3 {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--ui-font-size-large);
      gap: var(--size-2);
      margin: 0;
    }

    p {
      color: var(--ui-text-subtle);
      font-size: var(--ui-font-size-small);
      margin: 0;
    }
  }

  .builder-count {
    background-color: var(--ui-primary-tonal, var(--ui-surface-tonal));
    border-radius: var(--ui-radius-round);
    color: var(--ui-on-primary-tonal, var(--ui-text-strong));
    font-size: var(--ui-font-size-caption);
    font-weight: var(--ui-font-weight-semibold);
    padding: 0.125em 0.75em;

    &[hidden] {
      display: none;
    }
  }

  .builder-fine {
    > :global(summary) {
      font-size: var(--ui-font-size-body);
      gap: var(--size-2);
    }

    :global(.ui-content) {
      display: grid;
      gap: var(--size-4);
      padding-block: var(--size-3);
    }
  }

  .builder-fine-meta {
