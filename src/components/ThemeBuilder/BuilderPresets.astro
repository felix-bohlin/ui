---
import themeCss from "../../../packages/opui/css/theme.css?raw"
import { EXAMPLE_THEMES } from "../../utils/example-themes"
import {
  UNSET_VALUES,
  libraryDefaults,
} from "../../utils/theme-builder-controls"

const knob = (token: string) =>
  themeCss.match(new RegExp(`${token}:\\s*([\\d.]+);`))?.[1]
const chroma = Number(knob("--ui-palette-chroma") ?? 0.5)
const defaults = {
  ...UNSET_VALUES,
  ...libraryDefaults(themeCss),
  "--ui-palette-source": `oklch(0.58 ${+(0.21 * chroma).toFixed(3)} ${knob("--ui-palette-hue") ?? 145})`,
}
const style = (tokens: Record<string, string>) =>
  Object.entries({ ...defaults, ...tokens })
    .map(([token, value]) => `${token}: ${value}`)
    .join("; ")
const presets = [
  { label: "Default", style: style({}), value: "" },
  ...EXAMPLE_THEMES.map((theme) => ({
    label: theme.label,
    style: style(theme.tokens),
    value: theme.name,
  })),
]
---

<fieldset class="preset-cards" data-presets>
  <legend class="preset-cards-legend">Start from</legend>
  {
    presets.map((preset) => (
      <label class="preset-card">
        <input
          class="preset-card-input"
          name="builder-preset"
          type="radio"
          value={preset.value}
        />
        <span aria-hidden="true" class="preset-card-art" style={preset.style}>
          <span class="preset-card-canvas ui-palette">
            <span class="preset-card-heading">Aa</span>
            <span class="preset-card-row">
              <span class="ui-button ui-primary ui-filled ui-x-small">
                Save
              </span>
              <span class="ui-button ui-outlined ui-x-small">Cancel</span>
            </span>
            <span class="preset-card-row">
              <span class="preset-card-field" />
              <span class="ui-chip ui-x-small">Live</span>
            </span>
          </span>
        </span>
        <span class="preset-card-name">
          {preset.label}
          <span class="preset-card-changes" data-preset-changes hidden />
        </span>
      </label>
    ))
  }
</fieldset>

<style>
  .preset-cards {
    border: 0;
    display: grid;
    gap: var(--size-2);
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    margin: 0;
    min-inline-size: 0;
    padding: 0;
  }

  .preset-cards-legend {
    color: var(--ui-text-strong);
    font-size: var(--ui-font-size-small);
    font-weight: var(--ui-font-weight-semibold);
    margin-block-end: var(--size-2);
    padding: 0;
  }

  .preset-card {
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--radius-3);
    cursor: pointer;
    display: grid;
    gap: var(--size-2);
    min-inline-size: 0;
    padding: var(--size-2);
    position: relative;

    &:has(:checked) {
      border-color: var(--ui-primary);
      box-shadow: inset 0 0 0 var(--ui-border-width) var(--ui-primary);
    }

    &:has(:focus-visible) {
      outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
        var(--ui-focus-ring-color);
      outline-offset: var(--ui-focus-ring-offset);
    }

    &:hover {
      background-color: var(--ui-surface-tonal);
    }
  }

  .preset-card-input {
    block-size: 1px;
    clip-path: inset(50%);
    inline-size: 1px;
    margin: 0;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
  }

  .preset-card-art {
    display: block;
    forced-color-adjust: none;
  }

  .preset-card-canvas {
    background-color: var(--ui-surface);
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius);
    box-shadow: var(--ui-shadow-surface);
    color: var(--ui-text);
    display: grid;
    font-family: var(--ui-font-body);
    gap: var(--size-2);
    line-height: var(--ui-line-height, 1.5);
    overflow: hidden;
    padding: var(--size-2);
    pointer-events: none;
  }

  .preset-card-heading {
    color: var(--ui-text-strong);
    font-family: var(--ui-font-heading, var(--ui-font-body));
    font-size: var(--font-size-3);
    font-weight: var(--ui-font-weight-bold);
    letter-spacing: var(--ui-letter-spacing-heading, 0);
    line-height: 1;
  }

  .preset-card-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
  }

  .preset-card-field {
    background-color: var(--ui-field-bg-color, var(--ui-surface));
    block-size: var(--ui-control-size-x-small, 1.5rem);
    border: var(--ui-field-border-width, var(--ui-border-width)) solid
      var(--ui-field-border-color, var(--ui-border-color));
    border-radius: var(--ui-field-radius, var(--ui-radius));
    flex: 1 1 2rem;
    min-inline-size: 0;
  }

  .preset-card-name {
    align-items: center;
    color: var(--ui-text-strong);
    display: flex;
    font-size: var(--ui-font-size-small);
    font-weight: var(--ui-font-weight-medium);
    gap: var(--size-2);
    justify-content: space-between;
  }

  .preset-card-changes {
    background-color: var(--ui-primary-tonal, var(--ui-surface-tonal));
    border-radius: var(--ui-radius-round);
    color: var(--ui-on-primary-tonal, var(--ui-text-strong));
    font-size: var(--ui-font-size-caption);
    font-weight: var(--ui-font-weight-semibold);
    padding: 0.125em 0.625em;

    &[hidden] {
      display: none;
    }
  }
</style>
