---
import { Button, Callout, CalloutContent, CalloutIcon } from "opui-css/astro"
---

<Callout class="builder-share" data-share hidden severity="info">
  <CalloutIcon />
  <CalloutContent>
    <h2 class="builder-share-title" id="builder-share-title">
      This link has a theme
    </h2>
    <p data-share-summary></p>
    <div class="builder-actions">
      <Button color="primary" data-share-use size="small" variant="filled"
        >Use this theme</Button
      >
      <Button data-share-keep size="small" variant="outlined">Keep mine</Button>
    </div>
  </CalloutContent>
</Callout>

<div class="builder-toolbar">
  <div class="builder-identity">
    <p aria-hidden="true" class="builder-title">Theme builder</p>
    <p class="builder-summary">
      <span data-preset-name>Default</span>
      <span class="builder-summary-sep" aria-hidden="true"></span>
      <span data-change-count>No changes</span>
    </p>
  </div>
  <div class="builder-actions">
    <Button data-shuffle size="small" variant="outlined">
      <svg
        aria-hidden="true"
        height="24"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          fill="currentColor"
          d="M19.28 4.72a.75.75 0 0 0-1.06 1.06L19.44 7h-.19c-3.918 0-6.423 2.302-8.692 4.388l-.066.06C8.154 13.597 6.044 15.5 2.75 15.5a.75.75 0 0 0 0 1.5c3.918 0 6.423-2.302 8.692-4.388l.066-.06C13.846 10.403 15.956 8.5 19.25 8.5h.19l-1.22 1.22a.75.75 0 1 0 1.06 1.06l2.5-2.5a.75.75 0 0 0 0-1.06zM2.75 7c3.248 0 5.525 1.582 7.501 3.311a44 44 0 0 0-.303.279l-.132.121c-.232.213-.458.42-.68.62C7.283 9.732 5.4 8.5 2.75 8.5a.75.75 0 0 1 0-1.5m16.5 10c-3.248 0-5.525-1.582-7.501-3.311q.153-.14.302-.278l.133-.122c.231-.213.457-.42.68-.62 1.852 1.6 3.736 2.831 6.386 2.831h.19l-1.22-1.22a.75.75 0 1 1 1.06-1.06l2.5 2.5a.75.75 0 0 1 0 1.06l-2.5 2.5a.75.75 0 1 1-1.06-1.06L19.44 17z"
        ></path></svg
      >
      <span>Shuffle</span>
    </Button>
    <Button
      aria-keyshortcuts="Control+Z Meta+Z"
      data-undo-history
      disabled
      size="small"
      variant="outlined">Undo</Button
    >
    <Button
      aria-keyshortcuts="Control+Shift+Z Meta+Shift+Z"
      data-redo-history
      disabled
      size="small"
      variant="outlined">Redo</Button
    >
    <Button data-reset-all size="small" variant="transparent">Reset</Button>
    <Button
      command="show-modal"
      commandfor="builder-saved"
      data-saved
      size="small"
      variant="outlined">Saved</Button
    >
    <Button
      class="builder-contrast"
      command="show-modal"
      commandfor="builder-contrast"
      data-contrast
      data-state="pending"
      size="small"
      variant="outlined"
    >
      <span aria-hidden="true" class="builder-contrast-dot"></span>
      <span data-contrast-text>Checking contrast</span>
    </Button>
    <Button data-copy-link size="small" variant="outlined">Copy link</Button>
    <Button
      color="primary"
      command="show-modal"
      commandfor="builder-export"
      size="small"
      variant="filled"
    >
      Export CSS
    </Button>
  </div>
</div>

<div class="builder-status" data-toast hidden>
  <p data-toast-text role="status"></p>
  <Button data-undo hidden size="x-small" variant="tonal">Undo</Button>
</div>

<script>
  import { exampleTheme } from "../../utils/example-themes"
  import { morph } from "../../utils/morph"
  import { copyText } from "../../utils/storage"
  import { themeStore, type Theme } from "../../utils/theme"
  import { changeCount } from "../../utils/theme-builder-controls"
  import { createHistory } from "../../utils/theme-history"
  import { SHARE_PARAM, decodeTheme, shareUrl } from "../../utils/theme-share"

  type Say = { focus?: HTMLElement; message: string }

  const toolbar = document.querySelector<HTMLElement>(".builder-toolbar")
  if (toolbar) {
    const share = document.querySelector<HTMLElement>("[data-share]")!
    const resetButton =
      toolbar.querySelector<HTMLButtonElement>("[data-reset-all]")!
    const shuffleButton =
      toolbar.querySelector<HTMLButtonElement>("[data-shuffle]")!
    const contrast = toolbar.querySelector<HTMLElement>("[data-contrast]")!
    const contrastText = toolbar.querySelector<HTMLElement>(
      "[data-contrast-text]",
    )!
    const presetName = toolbar.querySelector<HTMLElement>("[data-preset-name]")!
    const changes = toolbar.querySelector<HTMLElement>("[data-change-count]")!
    const statusBox = document.querySelector<HTMLElement>("[data-toast]")!
    const status = document.querySelector<HTMLElement>("[data-toast-text]")!
    const undoButton = document.querySelector<HTMLButtonElement>("[data-undo]")!
    const undoHistory = toolbar.querySelector<HTMLButtonElement>(
      "[data-undo-history]",
    )!
    const redoHistory = toolbar.querySelector<HTMLButtonElement>(
      "[data-redo-history]",
    )!
    const stack = createHistory()
    let restoring = false
    let clearTimer = 0

    const clear = () => {
      status.textContent = ""
      statusBox.hidden = true
    }

    const say = (message: string, undoable = false) => {
      clearTimeout(clearTimer)
      status.textContent = message
      statusBox.hidden = false
      undoButton.hidden = !undoable
      clearTimer = window.setTimeout(clear, undoable ? 8000 : 6000)
    }

    const syncHistory = () => {
      const active = document.activeElement
      undoHistory.disabled = !stack.canUndo
      redoHistory.disabled = !stack.canRedo
      if (active === undoHistory && undoHistory.disabled) {
        ;(redoHistory.disabled ? shuffleButton : redoHistory).focus({
          preventScroll: true,
        })
      } else if (active === redoHistory && redoHistory.disabled) {
        ;(undoHistory.disabled ? shuffleButton : undoHistory).focus({
          preventScroll: true,
        })
      }
    }

    const restore = async (theme: Theme | null, message: string) => {
      if (!theme) return
      restoring = true
      await morph(() => themeStore.set(theme))
      restoring = false
      syncHistory()
      say(message)
    }

    const undoable = async (
      message: string,
      focus: HTMLElement,
      action: () => Promise<void>,
    ) => {
      await action()
      focus.focus({ preventScroll: true })
      say(message, true)
    }

    const describe = (theme: Theme) => {
      const start = exampleTheme(theme.preset)?.label ?? "Default"
      const count = changeCount(theme)
      return count === 0
        ? `It starts from ${start} with no changes.`
        : `It starts from ${start} with ${count} ${count === 1 ? "change" : "changes"}.`
    }

    const presetInput = () =>
      document.querySelector<HTMLInputElement>(
        "[data-presets] input:checked",
      ) ?? resetButton

    const sync = () => {
      const theme = themeStore.get()
      const count = changeCount(theme)
      presetName.textContent = exampleTheme(theme.preset)?.label ?? "Default"
      changes.textContent =
        count === 0
          ? "No changes"
          : `${count} ${count === 1 ? "change" : "changes"}`
      if (!restoring) {
        stack.push(theme)
        syncHistory()
      }
    }

    document.addEventListener("builder:say", (event) => {
      const { focus, message } = (event as CustomEvent<Say>).detail
      say(message, !!focus)
    })

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null
      if (
        !(event.ctrlKey || event.metaKey) ||
        event.altKey ||
        event.key.toLowerCase() !== "z" ||
        target?.closest("input, textarea, select, [contenteditable]")
      ) {
        return
      }
      event.preventDefault()
      if (event.shiftKey) restore(stack.redo(), "Redone.")
      else restore(stack.undo(), "Undone.")
    })

    undoHistory.addEventListener("click", () =>
      restore(stack.undo(), "Undone."),
    )
    redoHistory.addEventListener("click", () =>
      restore(stack.redo(), "Redone."),
    )

    document.addEventListener("builder:contrast", (event) => {
      const { failing } = (event as CustomEvent<{ failing: number }>).detail
      contrast.dataset.state = failing > 0 ? "fail" : "pass"
      contrastText.textContent =
        failing > 0
          ? `${failing} contrast ${failing === 1 ? "failure" : "failures"}`
          : "Contrast passes"
    })

    shuffleButton.addEventListener("click", () =>
      document.dispatchEvent(new Event("builder:shuffle")),
    )

    resetButton.addEventListener("click", () =>
      undoable("Theme reset to the default.", resetButton, () =>
        morph(() => themeStore.reset()),
      ),
    )

    toolbar
      .querySelector("[data-copy-link]")!
      .addEventListener("click", async () => {
        const copied = await copyText(
          shareUrl(themeStore.get(), location.origin),
        )
        say(copied ? "Link copied." : "Could not copy the link.")
      })

    undoButton.addEventListener("click", () => {
      undoHistory.focus({ preventScroll: true })
      restore(stack.undo(), "Undone.")
    })

    const params = new URLSearchParams(location.search)
    if (params.has(SHARE_PARAM)) {
      const shared = decodeTheme(params.get(SHARE_PARAM))
      const clearParam = () => {
        const url = new URL(location.href)
        url.searchParams.delete(SHARE_PARAM)
        history.replaceState(history.state, "", url)
      }
      const same =
        shared && JSON.stringify(shared) === JSON.stringify(themeStore.get())
      if (!shared) {
        clearParam()
        say(
          "The theme in this link could not be read. Your theme is unchanged.",
        )
      } else if (same) {
        clearParam()
      } else {
        share.hidden = false
        share.querySelector("[data-share-summary]")!.textContent =
          `${describe(shared)} Using it replaces your current theme.`
        const close = () => {
          share.hidden = true
          clearParam()
          presetInput().focus()
        }
        share
          .querySelector("[data-share-use]")!
          .addEventListener("click", () => {
            close()
            undoable("Using the theme from the link.", presetInput(), () =>
              morph(() => themeStore.set(shared)),
            )
          })
        share
          .querySelector("[data-share-keep]")!
          .addEventListener("click", () => {
            close()
            say("Kept your theme.")
          })
      }
    }

    stack.push(themeStore.get())
    sync()
    themeStore.subscribe(sync)
  }
</script>

<style>
  .builder-share {
    &[hidden] {
      display: none;
    }

    p {
      margin: 0;
    }
  }

  .builder-share-title {
    font-size: var(--ui-font-size-body);
    margin: 0;
  }

  .builder-toolbar {
    align-items: center;
    border-block-end: var(--ui-border-width) solid var(--ui-border-color);
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3) var(--size-4);
    justify-content: space-between;
    padding-block: var(--size-3);
  }

  .builder-identity {
    display: grid;
    gap: var(--size-1);
    min-inline-size: 0;

    p {
      margin: 0;
    }
  }

  .builder-title {
    color: var(--ui-text-strong);
    font-size: var(--ui-font-size-large);
    font-weight: var(--ui-font-weight-bold);
    line-height: var(--ui-line-height-tight);
  }

  .builder-summary {
    align-items: center;
    color: var(--ui-text-subtle);
    display: flex;
    font-size: var(--ui-font-size-small);
    gap: var(--size-2);
  }

  .builder-summary-sep {
    background-color: var(--ui-border-color);
    block-size: 1em;
    inline-size: var(--ui-border-width);
  }

  .builder-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);

    :global([hidden]) {
      display: none;
    }
  }

  .builder-contrast-dot {
    background-color: var(--ui-text-subtle);
    block-size: 0.6em;
    border-radius: 50%;
    display: inline-block;
    inline-size: 0.6em;

    [data-state="pass"] & {
      background-color: var(--ui-success);
    }

    [data-state="fail"] & {
      background-color: var(--ui-critical);
    }
  }

  .builder-status {
    align-items: center;
    background-color: var(--ui-surface-inverse);
    border-radius: var(--ui-radius-round);
    box-shadow: var(--ui-shadow-overlay);
    color: var(--ui-on-inverse);
    display: flex;
    gap: var(--size-3);
    inset-block-end: var(--size-4);
    inset-inline-start: 50%;
    max-inline-size: calc(100vi - var(--size-4) * 2);
    padding: var(--size-2) var(--size-4);
    position: fixed;
    translate: -50% 0;
    z-index: 21;

    &[hidden] {
      display: none;
    }

    p {
      font-size: var(--ui-font-size-small);
      margin: 0;
    }

    :global([hidden]) {
      display: none;
    }
  }
</style>
