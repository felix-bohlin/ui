---
import {
  Button,
  Divider,
  Drawer,
  DrawerContent,
  DrawerFooter,
  DrawerHeader,
  DrawerTitle,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Switch,
} from "opui-css/astro"
import ThemeQuickControls from "./ThemeQuickControls.astro"

const { link } = Astro.locals
---

<Drawer
  backdrop="transparent"
  closedby="any"
  id="theme-configurator-drawer"
  side="inline-end"
>
  <DrawerHeader closeButton>
    <DrawerTitle>Theme</DrawerTitle>
  </DrawerHeader>
  <DrawerContent>
    <div class="configurator-content">
      <Fieldset class="ui-form">
        <FieldLegend>Appearance</FieldLegend>
        <FieldGroup orientation="horizontal">
          <Switch spread id="theme-switcher">
            Dark mode
            <svg
              slot="icon-checked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
              ></path>
            </svg>

            <svg
              slot="icon-unchecked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 2m5 10a5 5 0 1 1-10 0a5 5 0 0 1 10 0m4.25.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zM12 19a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 19m-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zm-.03-8.53a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06m1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5a.75.75 0 0 0 0-1.06m-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06z"
              ></path>
            </svg>
          </Switch>
          <Switch spread id="contrast-switcher">
            More contrast
            <svg
              slot="icon-checked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20m0 2v16a8 8 0 1 1 0-16"
              ></path>
            </svg>
            <svg
              slot="icon-unchecked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20m0 2a8 8 0 1 1 0 16a8 8 0 0 1 0-16"
              ></path>
            </svg>
          </Switch>
          <Switch spread id="color-scroll-switcher">
            Color scroll
            <svg
              slot="icon-checked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M3.84 5.86C6.78 1.94 12.87.8 17.2 3.5c4.28 2.66 5.86 7.77 4.1 12.57-1.65 4.54-6.01 6.33-9.16 4.05-1.17-.85-1.63-1.92-1.85-3.66l-.1-.99-.05-.4c-.12-.93-.31-1.35-.7-1.57-.54-.3-.9-.3-1.6-.03l-.35.14-.18.08c-1.01.44-1.69.6-2.54.42l-.2-.05-.17-.04c-2.78-.87-3.2-4.65-.56-8.16m12.93 4.72a1.25 1.25 0 1 0 2.41-.65 1.25 1.25 0 0 0-2.41.65m.5 3.49a1.25 1.25 0 1 0 2.4-.65 1.25 1.25 0 0 0-2.4.65m-2.48-6.5a1.25 1.25 0 1 0 2.41-.64 1.25 1.25 0 0 0-2.41.65m-.03 9a1.25 1.25 0 1 0 2.41-.64 1.25 1.25 0 0 0-2.41.65m-3.5-9.96a1.25 1.25 0 1 0 2.42-.65 1.25 1.25 0 0 0-2.42.65"
              ></path>
            </svg>
            <svg
              slot="icon-unchecked"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M3.84 5.86C6.78 1.94 12.87.8 17.2 3.5c4.28 2.66 5.86 7.77 4.1 12.57-1.65 4.54-6.01 6.33-9.16 4.05-1.17-.85-1.63-1.92-1.85-3.66l-.1-.99-.05-.4c-.12-.93-.31-1.35-.7-1.57-.54-.3-.9-.3-1.6-.03l-.35.14-.18.08c-1.01.44-1.69.6-2.54.42l-.2-.05-.17-.04c-2.78-.87-3.2-4.65-.56-8.16m.98 6.71.13.04.13.03c.44.09.81.02 1.44-.24l.6-.26c1.2-.5 1.98-.54 3.04.05.92.51 1.28 1.3 1.46 2.66l.06.46.05.53.05.43c.17 1.36.48 2.09 1.24 2.64 2.28 1.65 5.54.3 6.87-3.35 1.52-4.15.18-8.51-3.48-10.79s-8.9-1.3-11.37 1.99c-2.08 2.76-1.82 5.28-.22 5.81m11.23-1.99a1.25 1.25 0 1 1 2.41-.65 1.25 1.25 0 0 1-2.41.65m.5 3.49a1.25 1.25 0 1 1 2.4-.65 1.25 1.25 0 0 1-2.4.65m-2.48-6.5a1.25 1.25 0 1 1 2.41-.64 1.25 1.25 0 0 1-2.41.65m-.03 9a1.25 1.25 0 1 1 2.42-.64 1.25 1.25 0 0 1-2.42.65m-3.5-9.96a1.25 1.25 0 1 1 2.42-.65 1.25 1.25 0 0 1-2.42.65"
              ></path>
            </svg>
          </Switch>
        </FieldGroup>
      </Fieldset>

      <Divider />

      <ThemeQuickControls />

      <p>
        Fonts, density, shadows, status colors and a contrast check are in the
        <a class="ui-link" href={link("/theme-builder")}>theme builder</a>.
      </p>
    </div>
  </DrawerContent>

  <DrawerFooter>
    <Button size="small" commandfor="theme-configurator-drawer" command="close"
      >Close</Button
    >
    <Button href={link("/theme-builder")} size="small" variant="outlined"
      >Theme builder</Button
    >
  </DrawerFooter>
</Drawer>

<script>
  import { themeStore } from "../utils/theme"

  const themeSwitcher = document.getElementById(
    "theme-switcher",
  ) as HTMLInputElement | null
  const contrastSwitcher = document.getElementById(
    "contrast-switcher",
  ) as HTMLInputElement | null

  function syncThemeSwitcher() {
    if (!themeSwitcher) return
    themeSwitcher.checked =
      document.documentElement.classList.contains("ui-dark")
  }

  syncThemeSwitcher()
  themeSwitcher?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("ui-dark")
    window.themeUtils?.setTheme(isDark ? "light" : "dark")
    syncThemeSwitcher()
  })

  function syncContrastSwitcher() {
    if (!contrastSwitcher) return
    contrastSwitcher.checked =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--ui-contrast")
        .trim() === "more"
  }

  syncContrastSwitcher()
  matchMedia("(prefers-contrast: more)").addEventListener(
    "change",
    syncContrastSwitcher,
  )

  contrastSwitcher?.addEventListener("click", () => {
    window.themeUtils?.setContrast(contrastSwitcher.checked ? "more" : "normal")
  })

  const colorScrollSwitcher = document.getElementById(
    "color-scroll-switcher",
  ) as HTMLInputElement | null

  function syncColorScrollSwitcher() {
    if (!colorScrollSwitcher) return
    colorScrollSwitcher.checked =
      window.themeUtils?.colorScrollEnabled() ?? false
  }

  if (CSS.supports("animation-timeline", "scroll()")) {
    syncColorScrollSwitcher()
    colorScrollSwitcher?.addEventListener("change", () => {
      window.themeUtils?.setColorScroll(colorScrollSwitcher.checked)
    })
    matchMedia("(prefers-reduced-motion: reduce)").addEventListener(
      "change",
      syncColorScrollSwitcher,
    )
    window.addEventListener("storage", syncColorScrollSwitcher)
    themeStore.subscribe(syncColorScrollSwitcher)
  } else {
    colorScrollSwitcher?.closest("label")?.remove()
  }

  matchMedia("(prefers-color-scheme: dark)").addEventListener(
    "change",
    syncThemeSwitcher,
  )

  new MutationObserver(() => {
    syncThemeSwitcher()
    syncContrastSwitcher()
    syncColorScrollSwitcher()
  }).observe(document.documentElement, {
    attributeFilter: ["class", "data-example-theme"],
    attributes: true,
  })
</script>

<style>
  .configurator-content {
    display: flex;
    flex-direction: column;
    gap: var(--size-4);

    p {
      color: var(--ui-text);
      font-size: var(--ui-font-size-small);
      margin: 0;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
    }
  }
</style>
