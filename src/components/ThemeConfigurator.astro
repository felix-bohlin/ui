---
import {
  Button,
  Divider,
  Drawer,
  DrawerContent,
  DrawerFooter,
  DrawerHeader,
  DrawerTitle,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Switch,
} from "opui-css/astro"
import ThemeControls from "./ThemeControls.astro"

const { link } = Astro.locals
---

<Drawer
  backdrop="transparent"
  closedby="any"
  id="theme-configurator-drawer"
  scrollLock={false}
  side="inline-end"
>
  <DrawerHeader>
    <DrawerTitle>Theme config</DrawerTitle>
  </DrawerHeader>
  <DrawerContent>
    <div class="configurator-content">
      <form class="ui-form" id="theme-configurator-form">
        <FieldSet>
          <FieldLegend>Theme mode</FieldLegend>
          <FieldGroup orientation="horizontal">
            <Switch spread id="theme-switcher">
              Dark mode
              <svg
                slot="icon-checked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
                ></path></svg
              >

              <svg
                slot="icon-unchecked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M12 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 2m5 10a5 5 0 1 1-10 0a5 5 0 0 1 10 0m4.25.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zM12 19a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 19m-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zm-.03-8.53a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06m1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5a.75.75 0 0 0 0-1.06m-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06z"
                ></path></svg
              >
            </Switch>
            <Switch spread id="contrast-switcher">
              High contrast
              <svg
                slot="icon-checked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20m0 2v16a8 8 0 1 1 0-16"
                ></path></svg
              >
              <svg
                slot="icon-unchecked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20m0 2a8 8 0 1 1 0 16a8 8 0 0 1 0-16"
                ></path></svg
              >
            </Switch>
          </FieldGroup>
        </FieldSet>

        <Divider />

        <ThemeControls />
      </form>
    </div>
  </DrawerContent>

  <DrawerFooter>
    <Button size="small" commandfor="theme-configurator-drawer" command="close"
      >Close</Button
    >
    <Button size="small" id="theme-configurator-reset">Reset</Button>
    <Button
      href={link("/guide/theme-generator#generated-css")}
      size="small"
      variant="outlined"
      id="theme-configurator-get-css">Get CSS</Button
    >
  </DrawerFooter>
</Drawer>

<script>
  import { removeStored } from "../utils/storage"
  import { themeForm } from "../utils/theme-form"
  import { THEME_KEYS, themeStore, type Mode } from "../utils/theme-store"
  import { skipOffscreenRendering } from "../utils/skip-offscreen-rendering"

  const form = document.getElementById(
    "theme-configurator-form",
  ) as HTMLFormElement | null
  const resetBtn = document.getElementById("theme-configurator-reset")
  const themeSwitcher = document.getElementById(
    "theme-switcher",
  ) as HTMLInputElement | null
  const contrastSwitcher = document.getElementById(
    "contrast-switcher",
  ) as HTMLInputElement | null

  const controls =
    form &&
    themeForm(form, {
      setGrays: (enabled) =>
        themeStore.setEnableGrays(themeStore.getActiveSiteMode(), enabled),
      setExampleTheme: (name) => themeStore.setExampleTheme(name),
      setToken: (token, value) =>
        themeStore.setToken(themeStore.getActiveSiteMode(), token, value),
    })

  function syncFormFromStore(mode: Mode = themeStore.getActiveSiteMode()) {
    controls?.sync(
      mode,
      themeStore.get(mode),
      themeStore.defaults(mode),
      themeStore.getExampleTheme(),
    )
  }

  themeStore.applyMode()
  syncFormFromStore()

  if (themeSwitcher) {
    themeSwitcher.checked =
      document.documentElement.classList.contains("ui-dark")
    themeSwitcher.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("ui-dark")
      const newTheme: Mode = isDark ? "light" : "dark"

      window.themeUtils?.setTheme(newTheme)
      themeSwitcher.checked = newTheme === "dark"

      themeStore.applyMode(newTheme)
      syncFormFromStore(newTheme)
    })
  }

  function syncContrastSwitcher() {
    if (!contrastSwitcher) return
    contrastSwitcher.checked =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--ui-contrast")
        .trim() === "more"
  }

  syncContrastSwitcher()
  matchMedia("(prefers-contrast: more)").addEventListener(
    "change",
    syncContrastSwitcher,
  )

  contrastSwitcher?.addEventListener("click", () => {
    window.themeUtils?.setContrast(contrastSwitcher.checked ? "more" : "normal")
  })

  let endDrag: (() => void) | undefined

  form?.addEventListener("pointerdown", (e) => {
    const target = e.target as HTMLInputElement
    if (target.type !== "range" || endDrag) return

    const restore = skipOffscreenRendering()
    const controller = new AbortController()
    endDrag = () => {
      controller.abort()
      restore()
      endDrag = undefined
    }
    for (const type of ["pointerup", "pointercancel", "resize", "scroll"]) {
      window.addEventListener(type, () => endDrag?.(), {
        passive: true,
        signal: controller.signal,
      })
    }
  })

  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (themeSwitcher) {
      themeSwitcher.checked =
        document.documentElement.classList.contains("ui-dark")
    }
    syncFormFromStore()
  })

  resetBtn?.addEventListener("click", () => {
    removeStored(THEME_KEYS.theme)
    window.themeUtils?.applyTheme(window.themeUtils.getSystemPreference())
    themeStore.reset()
    if (themeSwitcher) {
      themeSwitcher.checked =
        document.documentElement.classList.contains("ui-dark")
    }
    window.themeUtils?.setContrast(null)
    syncContrastSwitcher()
  })

  themeStore.subscribe((detail) => {
    if (detail.mode !== themeStore.getActiveSiteMode()) return
    syncFormFromStore(detail.mode)
  })
</script>

<style>
  .configurator-content {
    display: flex;
    flex-direction: column;
    gap: var(--size-4);

    p {
      color: var(--ui-text-muted);
      font-size: var(--ui-font-size-small);
      margin: 0;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
    }
  }
</style>
