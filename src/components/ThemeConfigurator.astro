---
import {
  Button,
  Chip,
  Divider,
  Drawer,
  DrawerFooter,
  DrawerHeader,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Range,
  Switch,
  TextField,
} from "@opui/astro"
import { PRESETS } from "../utils/theme-presets"
import { RADIUS_OPTIONS, TOKEN_DEFAULTS } from "../utils/theme-store"

const radiusGroups = [
  { name: "--border-radius", label: "Border radius" },
  { name: "--field-border-radius", label: "Field border radius" },
  { name: "--button-border-radius", label: "Button border radius" },
] as const

const presetOptions = [
  { id: "", label: "Default", tagline: "The library as it ships." },
  ...PRESETS.map(({ id, label, tagline }) => ({ id, label, tagline })),
].sort((a, b) => a.label.localeCompare(b.label))

const { link } = Astro.locals
---

<Drawer
  backdrop="transparent"
  closedby="any"
  id="theme-configurator-drawer"
  scrollLock={false}
  side="inline-end"
>
  <DrawerHeader slot="header">
    <h3>Theme config</h3>
  </DrawerHeader>
  <Fragment slot="content">
    <div class="configurator-content">
      <form class="ui-form" id="theme-configurator-form">
        <FieldSet>
          <FieldLegend>Theme</FieldLegend>
          <FieldGroup>
            <div class="chip-group-wrapper">
              <div class="chip-group">
                {
                  presetOptions.map((option) => (
                    <Chip
                      as="button"
                      type="button"
                      size="small"
                      variant={option.id === "" ? "tonal" : "outlined"}
                      aria-pressed={option.id === "" ? "true" : "false"}
                      data-preset={option.id}
                      label={option.label}
                      title={option.tagline}
                    />
                  ))
                }
              </div>
              <p>
                Presets live in these docs, not in the library. <a
                  class="ui-link"
                  href={link("/themes")}>Browse and copy them</a
                >.
              </p>
            </div>
          </FieldGroup>
        </FieldSet>

        <Divider />

        <FieldSet>
          <FieldLegend>Theme mode</FieldLegend>
          <FieldGroup direction="row">
            <Switch spread id="theme-switcher">
              Dark mode
              <svg
                slot="icon-checked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
                ></path></svg
              >

              <svg
                slot="icon-unchecked"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M12 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 2m5 10a5 5 0 1 1-10 0a5 5 0 0 1 10 0m4.25.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zM12 19a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 19m-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zm-.03-8.53a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06m1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5a.75.75 0 0 0 0-1.06m-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06z"
                ></path></svg
              >
            </Switch>
          </FieldGroup>
        </FieldSet>

        <Divider />

        <FieldSet>
          <FieldLegend>Color palette</FieldLegend>
          <FieldGroup>
            <TextField
              type="color"
              label="Source color"
              name="--palette-source-color"
              value="#000000"
              spread
              small
            />
            <Range
              label="Hue"
              name="--palette-hue"
              min="0"
              max="360"
              step="1"
              value="240"
              valueSuffix="°"
            />
            <Range
              label="Chroma"
              name="--palette-chroma"
              min="0"
              max="1"
              step="0.01"
              value="0.5"
              valueSuffix=""
            />
            <Range
              label="Hue rotation"
              name="--palette-hue-rotate-by"
              min="-10"
              max="10"
              step="1"
              value="0"
              valueSuffix=""
            />
          </FieldGroup>
        </FieldSet>

        <Divider />

        <FieldSet>
          <FieldLegend>Grays</FieldLegend>
          <FieldGroup>
            <Switch id="enable-grays" name="enable-grays" checked spread>
              Enable
            </Switch>
            <Range
              label="Gray chroma"
              name="--gray-chroma"
              min="0"
              max="0.1"
              step="0.001"
              value="0.01"
              valueSuffix=""
            />
            <Range
              label="Gray hue"
              name="--gray-hue"
              min="0"
              max="360"
              step="1"
              value="255"
              valueSuffix="°"
            />
          </FieldGroup>
        </FieldSet>

        <Divider />

        <FieldSet>
          <FieldLegend>Border radii</FieldLegend>
          {
            radiusGroups.map((group) => (
              <FieldGroup>
                <div class="chip-group-wrapper">
                  <span class="ui-label">{group.label}</span>
                  <div class="chip-group">
                    {RADIUS_OPTIONS.map((item) => {
                      const pressed = item.value === TOKEN_DEFAULTS[group.name]
                      return (
                        <Chip
                          as="button"
                          type="button"
                          size="small"
                          variant={pressed ? "tonal" : "outlined"}
                          aria-pressed={pressed ? "true" : "false"}
                          data-name={group.name}
                          data-value={item.value}
                          data-default={pressed ? "true" : undefined}
                          label={item.text}
                          title={item.value}
                        />
                      )
                    })}
                  </div>
                </div>
              </FieldGroup>
            ))
          }
        </FieldSet>
      </form>
    </div>
  </Fragment>

  <DrawerFooter slot="footer">
    <Button size="small" commandfor="theme-configurator-drawer" command="close"
      >Close</Button
    >
    <Button size="small" id="theme-configurator-reset">Reset</Button>
    <Button
      href={link("/guide/theme-generator#generated-css")}
      size="small"
      variant="outlined"
      id="theme-configurator-get-css">Get CSS</Button
    >
  </DrawerFooter>
</Drawer>

<script>
  import {
    themeStore,
    TOKENS,
    type Mode,
    type Token,
  } from "../utils/theme-store"
  import { isPresetId } from "../utils/theme-presets"
  import { hexToOklch, oklchToHex } from "../utils/color-utils"

  const TOKEN_SET = new Set<string>(TOKENS)

  const form = document.getElementById(
    "theme-configurator-form",
  ) as HTMLFormElement | null
  const resetBtn = document.getElementById("theme-configurator-reset")
  const themeSwitcher = document.getElementById(
    "theme-switcher",
  ) as HTMLInputElement | null
  const drawer = document.getElementById("theme-configurator-drawer")

  function setChipPressed(chip: HTMLElement, pressed: boolean) {
    chip.classList.toggle("ui-tonal", pressed)
    chip.classList.toggle("ui-outlined", !pressed)
    chip.setAttribute("aria-pressed", String(pressed))
  }

  function syncPresetChips() {
    if (!form) return
    const active = themeStore.getPreset() ?? ""
    form
      .querySelectorAll<HTMLElement>("[data-preset]")
      .forEach((chip) => setChipPressed(chip, chip.dataset.preset === active))
  }

  function syncFormFromStore(mode: Mode = themeStore.getActiveSiteMode()) {
    if (!form) return
    const config = themeStore.get(mode)
    const defaults = themeStore.defaults()

    syncPresetChips()

    TOKENS.forEach((token) => {
      const value = config[token] ?? defaults[token] ?? ""
      if (!value) return
      const input = form.querySelector<HTMLInputElement>(`[name="${token}"]`)
      if (input && input.type !== "checkbox") {
        input.value = value

        input.dispatchEvent(new Event("input", { bubbles: false }))
      }

      form
        .querySelectorAll<HTMLElement>(`[data-name="${token}"]`)
        .forEach((chip) => setChipPressed(chip, chip.dataset.value === value))
    })

    const enableGrays = form.querySelector<HTMLInputElement>(
      '[name="enable-grays"]',
    )
    if (enableGrays) enableGrays.checked = themeStore.isGraysEnabled(mode)

    const colorPicker = form.querySelector<HTMLInputElement>(
      '[name="--palette-source-color"]',
    )
    if (colorPicker) {
      const hue = parseFloat(
        config["--palette-hue"] ?? defaults["--palette-hue"],
      )
      const chroma = parseFloat(
        config["--palette-chroma"] ?? defaults["--palette-chroma"],
      )
      colorPicker.value = oklchToHex(0.58, 0.21 * chroma, hue)
    }
  }

  themeStore.applyMode()
  syncFormFromStore()

  if (themeSwitcher) {
    themeSwitcher.checked =
      document.documentElement.classList.contains("ui-dark")
    themeSwitcher.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("ui-dark")
      const newTheme: Mode = isDark ? "light" : "dark"

      ;(window as any).themeUtils?.setTheme(newTheme)
      themeSwitcher.checked = newTheme === "dark"

      themeStore.applyMode(newTheme)
      syncFormFromStore(newTheme)
    })
  }

  form?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement | null
    if (!target) return
    const name = target.name || target.getAttribute("name")
    if (!name) return

    const mode = themeStore.getActiveSiteMode()

    if (target.type === "checkbox") {
      if (name === "enable-grays") {
        themeStore.setEnableGrays(mode, target.checked)
      }
      return
    }

    if (name === "--palette-source-color") {
      const { C, H } = hexToOklch(target.value)
      const hue = String(Math.round(H))
      const chroma = String(+Math.min(1, C / 0.21).toFixed(2))
      themeStore.setToken(mode, "--palette-hue", hue)
      themeStore.setToken(mode, "--palette-chroma", chroma)
      return
    }

    if (TOKEN_SET.has(name)) {
      themeStore.setToken(mode, name as Token, target.value)
    }
  })

  form?.addEventListener("click", (e) => {
    const presetChip = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-preset]",
    )
    if (presetChip && form.contains(presetChip)) {
      const id = presetChip.dataset.preset
      themeStore.setPreset(isPresetId(id) ? id : null)
      return
    }

    const chip = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-name][data-value]",
    )
    if (!chip || !form.contains(chip)) return

    const name = chip.dataset.name
    const value = chip.dataset.value
    if (!name || value === undefined) return

    if (TOKEN_SET.has(name)) {
      themeStore.setToken(themeStore.getActiveSiteMode(), name as Token, value)
    }

    form
      .querySelectorAll<HTMLElement>(`[data-name="${name}"]`)
      .forEach((c) => setChipPressed(c, c === chip))
  })

  resetBtn?.addEventListener("click", () => {
    themeStore.reset()
    form?.reset()
    if (themeSwitcher) {
      themeSwitcher.checked =
        document.documentElement.classList.contains("ui-dark")
    }
    const allChips =
      form?.querySelectorAll<HTMLElement>("[data-name][data-value]") ?? []
    allChips.forEach((chip) =>
      setChipPressed(chip, chip.dataset.default === "true"),
    )
  })

  themeStore.subscribe((detail) => {
    if (detail.mode !== themeStore.getActiveSiteMode()) return
    syncFormFromStore(detail.mode)
  })
</script>

<style is:global>
  html.no-grays {
    --neutral: var(--color-9);
    --primary-contrast: var(--color-1);
    --text-primary: light-dark(var(--color-15), var(--color-1));
    --text-primary-contrast: light-dark(var(--color-2), var(--color-15));
    --text-muted: light-dark(var(--color-13), var(--color-4));
    --text-muted-contrast: light-dark(var(--color-4), var(--color-13));
    --surface-default: light-dark(var(--color-1), var(--color-14));
    --surface-filled: light-dark(var(--color-5), var(--color-16));
    --surface-tonal: light-dark(var(--color-4), var(--color-12));
    --surface-elevated: light-dark(var(--color-1), var(--color-12));
    --border-color: light-dark(var(--color-4), var(--color-12));
    --field-border-color: light-dark(var(--color-4), var(--color-12));
  }
</style>

<style>
  .configurator-content {
    display: flex;
    flex-direction: column;
    gap: var(--size-4);

    p {
      color: var(--text-muted);
      font-size: var(--font-size-05);
      margin: 0;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
    }

    .chip-group-wrapper {
      display: flex;
      flex-direction: column;
      gap: var(--size-2);

      .ui-label {
        font-size: var(--font-size-05);
        font-weight: var(--font-weight-5);
      }
    }

    .chip-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-2);
    }
  }
</style>
