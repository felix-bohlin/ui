---
import {
  Button,
  Callout,
  Card,
  Checkbox,
  Chip,
  Divider,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Range,
  Switch,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "@opui/astro"
import { RADIUS_OPTIONS, tokenDefaults } from "../../utils/theme-store"
import { PLACEHOLDER_CSS } from "./generateCss"

const surfaces = ["default", "tonal", "filled", "elevated"]

const steps = Array.from({ length: 16 }, (_, i) => i + 1)

const radiusGroups = [
  { name: "--border-radius", label: "Border Radius" },
  { name: "--field-border-radius", label: "Field Border Radius" },
  { name: "--button-border-radius", label: "Button Border Radius" },
] as const

const previewStyle = Object.entries(tokenDefaults("light"))
  .map(([token, value]) => `${token}: ${value}`)
  .join("; ")
---

<div class="theme-generator" id="theme-generator-root">
  <div class="toolbar">
    <div class="mode-field">
      <ToggleGroup
        name="theme-generator-mode"
        selection="single"
        size="small"
        aria-label="Editing mode"
      >
        <ToggleButton value="light">Light</ToggleButton>
        <ToggleButton pressed value="both">Both</ToggleButton>
        <ToggleButton value="dark">Dark</ToggleButton>
      </ToggleGroup>
    </div>
    <Button id="theme-generator-reset" size="small" variant="outlined"
      >Reset</Button
    >
  </div>

  <Callout
    class="diverged-note"
    id="theme-generator-diverged"
    severity="info"
    hidden
  >
    Light and dark have different values. The controls show the mode in the
    preview, and each change applies to both modes.
  </Callout>

  <div class="generator-grid">
    <!-- Controls -->
    <Card variant="outlined" class="controls ui-not-rich-text">
      <h3 slot="header">Theme controls</h3>

      <form id="theme-generator-form" class="ui-form" slot="content">
        <FieldSet>
          <FieldLegend>Color Palette</FieldLegend>
          <FieldGroup>
            <TextField
              type="color"
              label="Source color"
              name="--palette-source-color"
              value="#000000"
              spread
              size="small"
            />
            <Range
              label="Hue"
              name="--palette-hue"
              min="0"
              max="360"
              step="1"
              value="240"
              valueSuffix="°"
            />
            <Range
              label="Chroma"
              name="--palette-chroma"
              min="0"
              max="1"
              step="0.01"
              value="0.5"
              valueSuffix=""
            />
            <Range
              label="Hue Rotation"
              name="--palette-hue-rotate-by"
              min="-10"
              max="10"
              step="1"
              value="0"
              valueSuffix=""
            />
          </FieldGroup>
        </FieldSet>

        <Divider />

        <FieldSet>
          <FieldLegend>Grays</FieldLegend>
          <FieldGroup>
            <Switch name="enable-grays" checked size="small" spread
              >Enable</Switch
            >
            <Range
              label="Gray Chroma"
              name="--gray-chroma"
              min="0"
              max="0.1"
              step="0.001"
              value="0.01"
              valueSuffix=""
            />
            <Range
              label="Gray Hue"
              name="--gray-hue"
              min="0"
              max="360"
              step="1"
              value="255"
              valueSuffix="°"
            />
          </FieldGroup>
        </FieldSet>

        <Divider />

        {
          radiusGroups.map((group) => (
            <FieldSet>
              <FieldLegend>{group.label}</FieldLegend>
              <FieldGroup>
                <div class="chip-group">
                  {RADIUS_OPTIONS.map((item) => {
                    const pressed =
                      item.value === tokenDefaults("light")[group.name]
                    return (
                      <Chip
                        as="button"
                        type="button"
                        size="small"
                        variant={pressed ? "tonal" : "outlined"}
                        aria-pressed={pressed ? "true" : "false"}
                        data-name={group.name}
                        data-value={item.value}
                        label={item.text}
                        title={item.value}
                      />
                    )
                  })}
                </div>
              </FieldGroup>
            </FieldSet>
          ))
        }
      </form>
    </Card>

    <!-- Preview -->
    <Card
      variant="outlined"
      class="preview-card ui-palette ui-not-rich-text"
      id="theme-generator-preview"
      style={previewStyle}
    >
      <Fragment slot="header">
        <div class="card-header">
          <h3>Preview</h3>
          <Chip
            id="theme-generator-preview-mode"
            size="small"
            variant="outlined"
            label="Light mode"
          />
        </div>
      </Fragment>

      <div class="preview-pane" slot="content">
        <h4 class="section-label">Palette</h4>
        <div class="palette-grid">
          {
            steps.map((n) => (
              <div class="swatch" style={`background-color: var(--color-${n})`}>
                <span>{n}</span>
              </div>
            ))
          }
        </div>

        <div class="gray-palette">
          <Divider />
          <h4 class="section-label">Grays</h4>
          <div class="palette-grid">
            {
              steps.map((n) => (
                <div
                  class="swatch"
                  style={`background-color: var(--gray-${n})`}
                >
                  <span>{n}</span>
                </div>
              ))
            }
          </div>
        </div>

        <Divider />
        <h4 class="section-label">Surfaces</h4>
        <div class="surface-stack">
          {
            surfaces.map((s) => (
              <div
                class="surface-swatch"
                style={`background-color: var(--surface-${s})`}
              >
                <span>{s}</span>
              </div>
            ))
          }
        </div>

        <Divider />
        <h4 class="section-label">Examples</h4>
        <Card variant="outlined">
          <h5 slot="header">Card</h5>
          <p slot="content">Cards use border radius and surface colors.</p>
          <Fragment slot="actions">
            <Button variant="tonal">Cancel</Button>
            <Button variant="filled">Save</Button>
          </Fragment>
        </Card>
        <div class="form-showcase">
          <TextField label="Label" placeholder="Input field..." />
          <div class="ui-row">
            <Switch checked>On</Switch>
            <Checkbox checked>Pick</Checkbox>
          </div>
        </div>
      </div>
    </Card>
  </div>

  <!-- Generated CSS -->
  <Card
    variant="outlined"
    class="css-output ui-not-rich-text"
    id="generated-css"
  >
    <Fragment slot="header">
      <div class="card-header">
        <h3>theme.css</h3>
        <div class="css-actions">
          <Button
            ripple
            rounded
            id="theme-generator-copy"
            size="x-small"
            title="Copy CSS"
            aria-label="Copy CSS"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M9 18q-.825 0-1.412-.587T7 16V4q0-.825.588-1.412T9 2h9q.825 0 1.413.588T20 4v12q0 .825-.587 1.413T18 18zm-4 4q-.825 0-1.412-.587T3 20V7q0-.425.288-.712T4 6t.713.288T5 7v13h10q.425 0 .713.288T16 21t-.288.713T15 22zm4-6h9V4H9z"
              ></path>
            </svg>
          </Button>
          <Button
            ripple
            rounded
            id="theme-generator-download"
            size="x-small"
            title="Download theme.css"
            aria-label="Download theme.css"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M12 15.575q-.2 0-.375-.062T11.3 15.3l-3.6-3.6q-.3-.3-.288-.7t.288-.7q.3-.3.713-.312t.712.287L11 12.15V5q0-.425.288-.712T12 4t.713.288T13 5v7.15l1.875-1.875q.3-.3.713-.288t.712.313q.275.3.288.7t-.288.7l-3.6 3.6q-.15.15-.325.213t-.375.062M6 20q-.825 0-1.412-.587T4 18v-2q0-.425.288-.712T5 15t.713.288T6 16v2h12v-2q0-.425.288-.712T19 15t.713.288T20 16v2q0 .825-.587 1.413T18 20z"
              ></path>
            </svg>
          </Button>
        </div>
      </div>
    </Fragment>
    <pre
      slot="content"><code id="theme-generator-css-code" class="hljs language-css">{PLACEHOLDER_CSS}</code></pre>
  </Card>
</div>

<style>
  .theme-generator {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .toolbar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: space-between;
  }

  .mode-field {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
  }

  .mode-label {
    font-size: var(--font-size-05);
    font-weight: var(--font-weight-6);
  }

  .diverged-note[hidden] {
    display: none;
  }

  .generator-grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: minmax(0, 1fr);

    @container (width >= 640px) {
      align-items: start;
      grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    }
  }

  .controls {
    .ui-form {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
    }

    .chip-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-2);
    }
  }

  .card-header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
    justify-content: space-between;
    width: 100%;

    h3 {
      margin: 0;
    }
  }

  .preview-card {
    color: var(--text-primary);

    &.no-grays {
      --primary-contrast: var(--color-1);
      --neutral: var(--color-9);

      --text-primary: light-dark(var(--color-15), var(--color-1));
      --text-primary-contrast: light-dark(var(--color-2), var(--color-15));
      --text-muted: light-dark(var(--color-13), var(--color-4));
      --text-muted-contrast: light-dark(var(--color-4), var(--color-13));

      --surface-default: light-dark(var(--color-1), var(--color-14));
      --surface-filled: light-dark(var(--color-5), var(--color-16));
      --surface-tonal: light-dark(var(--color-4), var(--color-12));
      --surface-elevated: light-dark(var(--color-1), var(--color-12));
      --border-color: light-dark(var(--color-4), var(--color-12));
    }

    @container (width >= 640px) {
      inset-block-start: calc(var(--size-10) + var(--size-4));
      max-block-size: calc(100dvb - var(--size-10) - var(--size-8));
      overflow-y: auto;
      position: sticky;

      @media (width >= 900px) and (width < 1140px) {
        inset-block-start: calc(var(--size-10) + var(--size-8) + var(--size-4));
        max-block-size: calc(100dvb - var(--size-10) - var(--size-8) * 2);
      }
    }
  }

  .preview-pane {
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .section-label {
    color: var(--text-muted);
    margin: 0;
  }

  .preview-card.no-grays .gray-palette {
    display: none;
  }

  .gray-palette {
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .palette-grid {
    display: grid;
    gap: var(--size-1);
    grid-template-columns: repeat(8, minmax(0, 1fr));

    @container (width >= 400px) {
      gap: var(--size-2);
    }
  }

  .swatch {
    aspect-ratio: 1;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    display: grid;
    font-size: var(--font-size-0);
    inline-size: 100%;
    place-items: center;

    &:hover span {
      opacity: 1;
    }

    span {
      aspect-ratio: 1;
      background-color: oklch(from var(--text-primary) l c h / 0.65);
      border-radius: var(--radius-round);
      color: var(--text-primary-contrast);
      display: grid;
      min-inline-size: 1lh;
      opacity: 0;
      padding-inline: 1ex;
      place-items: center;
      pointer-events: none;
      text-align: center;
      transition: opacity 0.2s ease-out;
    }
  }

  .surface-stack {
    display: grid;
    gap: var(--size-2);
    grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
  }

  .surface-swatch {
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    display: flex;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    justify-content: space-between;
    padding: var(--size-2) var(--size-3);
    text-transform: uppercase;
  }

  .form-showcase {
    background-color: var(--surface-tonal);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
    padding: var(--size-3);

    & .ui-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-3) var(--size-6);
    }
  }

  .css-output {
    .css-actions {
      display: flex;
      gap: var(--size-1);
    }

    pre {
      background: #1e1e1e;
      border-radius: var(--border-radius);
      color-scheme: dark;
      margin: 0;
      max-block-size: 60vh;
      overflow: auto;
      padding: var(--size-4);
    }

    code {
      font-family: var(--font-mono);
      font-size: var(--font-size-0);
      white-space: pre;
    }
  }
</style>

<style is:global>
  #theme-generator-css-code.hljs {
    color: #d4d4d4;
  }
  #theme-generator-css-code .hljs-keyword,
  #theme-generator-css-code .hljs-selector-tag {
    color: #c586c0;
  }
  #theme-generator-css-code .hljs-selector-class,
  #theme-generator-css-code .hljs-selector-id,
  #theme-generator-css-code .hljs-selector-pseudo {
    color: #d7ba7d;
  }
  #theme-generator-css-code .hljs-built_in {
    color: #dcdcaa;
  }
  #theme-generator-css-code .hljs-attr,
  #theme-generator-css-code .hljs-attribute {
    color: #9cdcfe;
  }
  #theme-generator-css-code .hljs-number,
  #theme-generator-css-code .hljs-unit {
    color: #b5cea8;
  }
  #theme-generator-css-code .hljs-string {
    color: #ce9178;
  }
  #theme-generator-css-code .hljs-comment {
    color: #6a9955;
  }
</style>

<script>
  import hljs from "highlight.js/lib/core"
  import css from "highlight.js/lib/languages/css"
  import {
    themeStore,
    TOKENS,
    tokenDefaults,
    type Mode,
    type ModeConfig,
    type Token,
  } from "../../utils/theme-store"
  import { toast } from "@opui/css/js/toast.js"
  import { generateCss } from "./generateCss"
  import { hexToOklch, oklchToHex } from "../../utils/color-utils"

  hljs.registerLanguage("css", css)

  const TOKEN_SET = new Set<string>(TOKENS)

  const root = document.getElementById("theme-generator-root")
  if (!root) throw new Error("Theme generator root not found")

  const form = document.getElementById(
    "theme-generator-form",
  ) as HTMLFormElement
  const preview = document.getElementById("theme-generator-preview")!
  const previewModeText = document.querySelector(
    "#theme-generator-preview-mode .ui-text",
  )
  const divergedNote = document.getElementById("theme-generator-diverged")
  const codeEl = document.getElementById("theme-generator-css-code")!
  const copyBtn = document.getElementById("theme-generator-copy")
  const downloadBtn = document.getElementById("theme-generator-download")
  const resetBtn = document.getElementById("theme-generator-reset")
  const modeRadios = root.querySelectorAll<HTMLInputElement>(
    'input[name="theme-generator-mode"]',
  )

  type EditingMode = Mode | "both"
  let editingMode: EditingMode = readModeFromRadios()
  let generatedCss = ""
  let pickingColor = false
  let refreshQueued = false

  function readModeFromRadios(): EditingMode {
    for (const r of modeRadios) {
      if (
        r.checked &&
        (r.value === "light" || r.value === "dark" || r.value === "both")
      ) {
        return r.value
      }
    }
    return "both"
  }

  function targetModes(): readonly Mode[] {
    return editingMode === "both" ? (["light", "dark"] as const) : [editingMode]
  }

  function previewMode(): Mode {
    return editingMode === "both" ? themeStore.getActiveSiteMode() : editingMode
  }

  function modesDiffer() {
    const light = themeStore.get("light")
    const dark = themeStore.get("dark")
    return (
      themeStore.isGraysEnabled("light") !==
        themeStore.isGraysEnabled("dark") ||
      TOKENS.some(
        (token) =>
          (light[token] ?? tokenDefaults("light")[token]) !==
          (dark[token] ?? tokenDefaults("dark")[token]),
      )
    )
  }

  function setGrayInputsDisabled(disabled: boolean) {
    const grayInputs = form.querySelectorAll<HTMLInputElement>(
      '[name="--gray-chroma"], [name="--gray-hue"]',
    )
    grayInputs.forEach((input) => {
      input.disabled = disabled
    })
  }

  function setChipPressed(chip: HTMLElement, pressed: boolean) {
    chip.classList.toggle("ui-tonal", pressed)
    chip.classList.toggle("ui-outlined", !pressed)
    chip.setAttribute("aria-pressed", String(pressed))
  }

  let suppressInputHandler = false

  function syncFormFromConfig(mode: Mode, config: ModeConfig) {
    const defaults = tokenDefaults(mode)
    TOKENS.forEach((token) => {
      const value = config[token] ?? defaults[token]
      const input = form.querySelector<HTMLInputElement>(`[name="${token}"]`)
      if (input && input.type !== "checkbox") {
        input.value = value
        suppressInputHandler = true
        try {
          input.dispatchEvent(new Event("input", { bubbles: true }))
        } finally {
          suppressInputHandler = false
        }
      }

      form
        .querySelectorAll<HTMLElement>(`[data-name="${token}"]`)
        .forEach((chip) => setChipPressed(chip, chip.dataset.value === value))
    })

    const enableGrays = form.querySelector<HTMLInputElement>(
      '[name="enable-grays"]',
    )
    const graysEnabled = config["enable-grays"] !== "false"
    if (enableGrays) enableGrays.checked = graysEnabled
    setGrayInputsDisabled(!graysEnabled)

    const colorPicker = form.querySelector<HTMLInputElement>(
      '[name="--palette-source-color"]',
    )
    if (colorPicker && !pickingColor) {
      const hue = parseFloat(
        config["--palette-hue"] ?? defaults["--palette-hue"],
      )
      const chroma = parseFloat(
        config["--palette-chroma"] ?? defaults["--palette-chroma"],
      )
      colorPicker.value = oklchToHex(0.58, 0.21 * chroma, hue)
    }
  }

  function applyToPreview() {
    const mode = previewMode()
    const config = themeStore.get(mode)
    const defaults = tokenDefaults(mode)
    preview.classList.toggle("ui-dark", mode === "dark")
    preview.classList.toggle("ui-light", mode === "light")
    preview.classList.toggle("no-grays", config["enable-grays"] === "false")

    TOKENS.forEach((token) => {
      preview.style.setProperty(token, config[token] ?? defaults[token])
    })

    if (previewModeText) {
      previewModeText.textContent = mode === "dark" ? "Dark mode" : "Light mode"
    }
  }

  function rerenderCode() {
    generatedCss = generateCss({
      light: themeStore.get("light"),
      dark: themeStore.get("dark"),
    })
    codeEl.innerHTML = hljs.highlight(generatedCss, { language: "css" }).value
  }

  function refreshAll() {
    syncFormFromConfig(previewMode(), themeStore.get(previewMode()))
    applyToPreview()
    rerenderCode()
    if (divergedNote) {
      divergedNote.hidden = editingMode !== "both" || !modesDiffer()
    }
  }

  function scheduleRefresh() {
    if (refreshQueued) return
    refreshQueued = true
    requestAnimationFrame(() => {
      refreshQueued = false
      refreshAll()
    })
  }

  modeRadios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (!radio.checked) return
      editingMode = readModeFromRadios()
      refreshAll()
    })
  })

  form.addEventListener("input", (e) => {
    if (suppressInputHandler) return
    const target = e.target as HTMLInputElement | null
    if (!target) return
    const name = target.name || target.getAttribute("name")
    if (!name) return

    if (target.type === "checkbox") {
      if (name === "enable-grays") {
        targetModes().forEach((m) =>
          themeStore.setEnableGrays(m, target.checked),
        )
        setGrayInputsDisabled(!target.checked)
      }
      return
    }

    if (name === "--palette-source-color") {
      pickingColor = true
      const { C, H } = hexToOklch(target.value)
      const hue = String(Math.round(H))
      const chroma = String(+Math.min(1, C / 0.21).toFixed(2))
      targetModes().forEach((m) => {
        themeStore.setToken(m, "--palette-hue", hue)
        themeStore.setToken(m, "--palette-chroma", chroma)
      })
      return
    }

    if (TOKEN_SET.has(name)) {
      targetModes().forEach((m) =>
        themeStore.setToken(m, name as Token, target.value),
      )
    }
  })

  form.addEventListener("change", (e) => {
    const target = e.target as HTMLInputElement | null
    if (target?.name !== "--palette-source-color") return
    pickingColor = false
    scheduleRefresh()
  })

  form.addEventListener("click", (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-name][data-value]",
    )
    if (!chip || !form.contains(chip)) return
    const name = chip.dataset.name
    const value = chip.dataset.value
    if (!name || value === undefined) return
    if (TOKEN_SET.has(name)) {
      targetModes().forEach((m) => themeStore.setToken(m, name as Token, value))
    }
  })

  resetBtn?.addEventListener("click", () => {
    themeStore.reset()
    form.reset()
    refreshAll()
  })

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(generatedCss)
      toast("Copied theme.css", {
        description: "Paste it into your project's stylesheet.",
        duration: "3s",
      })
    } catch {
      toast("Copy failed", {
        description: "Your browser blocked clipboard access.",
        duration: "4s",
        severity: "critical",
      })
    }
  })

  downloadBtn?.addEventListener("click", () => {
    const url = URL.createObjectURL(
      new Blob([generatedCss], { type: "text/css" }),
    )
    const link = document.createElement("a")
    link.href = url
    link.download = "theme.css"
    link.click()
    setTimeout(() => URL.revokeObjectURL(url))
  })

  themeStore.subscribe(scheduleRefresh)

  refreshAll()
</script>
