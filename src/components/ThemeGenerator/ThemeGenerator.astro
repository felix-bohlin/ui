---
import {
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Card,
  CardActions,
  CardContent,
  CardHeader,
  Checkbox,
  Chip,
  Divider,
  Switch,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import { tokenDefaults } from "../../utils/theme-store"
import ThemeControls from "../ThemeControls.astro"
import { PLACEHOLDER_CSS } from "./generateCss"
import "../../styles/syntax.css"

const surfaces = ["default", "tonal", "filled", "elevated"]

const steps = Array.from({ length: 16 }, (_, i) => i + 1)

const previewStyle = Object.entries(tokenDefaults("light"))
  .map(([token, value]) => `${token}: ${value}`)
  .join("; ")
---

<div class="theme-generator" id="theme-generator-root">
  <div class="toolbar">
    <div class="mode-field">
      <ToggleGroup
        name="theme-generator-mode"
        selection="single"
        size="small"
        aria-label="Editing mode"
      >
        <ToggleButton value="light">Light</ToggleButton>
        <ToggleButton pressed value="both">Both</ToggleButton>
        <ToggleButton value="dark">Dark</ToggleButton>
      </ToggleGroup>
    </div>
    <Button id="theme-generator-reset" size="small" variant="outlined"
      >Reset</Button
    >
  </div>

  <Callout
    class="diverged-note"
    id="theme-generator-diverged"
    severity="info"
    hidden
  >
    <CalloutIcon />
    <CalloutContent>
      Light and dark have different values. The controls show the mode in the
      preview, and each change applies to both modes.
    </CalloutContent>
  </Callout>

  <div class="generator-grid">
    <!-- Controls -->
    <Card variant="outlined" class="controls ui-not-rich-text">
      <CardHeader>
        <h3>Theme controls</h3>
      </CardHeader>

      <CardContent>
        <form id="theme-generator-form" class="ui-form">
          <ThemeControls />
        </form>
      </CardContent>
    </Card>

    <!-- Preview -->
    <Card
      variant="outlined"
      class="preview-card ui-palette ui-not-rich-text"
      id="theme-generator-preview"
      style={previewStyle}
    >
      <CardHeader>
        <div class="card-header">
          <h3>Preview</h3>
          <Chip
            id="theme-generator-preview-mode"
            size="small"
            variant="outlined"
            label="Light mode"
          />
        </div>
      </CardHeader>

      <CardContent>
        <div class="preview-pane">
          <h4 class="section-label">Palette</h4>
          <div class="palette-grid">
            {
              steps.map((n) => (
                <div
                  class="swatch"
                  style={`background-color: var(--ui-color-${n})`}
                >
                  <span>{n}</span>
                </div>
              ))
            }
          </div>

          <div class="gray-palette">
            <Divider />
            <h4 class="section-label">Grays</h4>
            <div class="palette-grid">
              {
                steps.map((n) => (
                  <div
                    class="swatch"
                    style={`background-color: var(--ui-gray-${n})`}
                  >
                    <span>{n}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <Divider />
          <h4 class="section-label">Surfaces</h4>
          <div class="surface-stack">
            {
              surfaces.map((s) => (
                <div
                  class="surface-swatch"
                  style={`background-color: var(--ui-surface-${s})`}
                >
                  <span>{s}</span>
                </div>
              ))
            }
          </div>

          <Divider />
          <h4 class="section-label">Examples</h4>
          <Card variant="outlined">
            <CardHeader>
              <h5>Card</h5>
            </CardHeader>
            <CardContent>
              <p>Cards use border radius and surface colors.</p>
            </CardContent>
            <CardActions>
              <Button variant="tonal">Cancel</Button>
              <Button variant="filled">Save</Button>
            </CardActions>
          </Card>
          <div class="form-showcase">
            <TextField label="Label" placeholder="Input field..." />
            <div class="ui-row">
              <Switch checked>On</Switch>
              <Checkbox checked>Pick</Checkbox>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Generated CSS -->
  <Card
    variant="outlined"
    class="css-output ui-not-rich-text"
    id="generated-css"
  >
    <CardHeader>
      <div class="card-header">
        <h3>custom-theme.css</h3>
        <div class="css-actions">
          <Button
            round
            id="theme-generator-copy"
            size="x-small"
            title="Copy CSS"
            aria-label="Copy CSS"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M9 18q-.825 0-1.412-.587T7 16V4q0-.825.588-1.412T9 2h9q.825 0 1.413.588T20 4v12q0 .825-.587 1.413T18 18zm-4 4q-.825 0-1.412-.587T3 20V7q0-.425.288-.712T4 6t.713.288T5 7v13h10q.425 0 .713.288T16 21t-.288.713T15 22zm4-6h9V4H9z"
              ></path>
            </svg>
          </Button>
          <Button
            round
            id="theme-generator-download"
            size="x-small"
            title="Download custom-theme.css"
            aria-label="Download custom-theme.css"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M12 15.575q-.2 0-.375-.062T11.3 15.3l-3.6-3.6q-.3-.3-.288-.7t.288-.7q.3-.3.713-.312t.712.287L11 12.15V5q0-.425.288-.712T12 4t.713.288T13 5v7.15l1.875-1.875q.3-.3.713-.288t.712.313q.275.3.288.7t-.288.7l-3.6 3.6q-.15.15-.325.213t-.375.062M6 20q-.825 0-1.412-.587T4 18v-2q0-.425.288-.712T5 15t.713.288T6 16v2h12v-2q0-.425.288-.712T19 15t.713.288T20 16v2q0 .825-.587 1.413T18 20z"
              ></path>
            </svg>
          </Button>
        </div>
      </div>
    </CardHeader>
    <CardContent>
      <pre><code id="theme-generator-css-code" class="language-css">{PLACEHOLDER_CSS}</code></pre>
    </CardContent>
  </Card>
</div>

<style>
  .theme-generator {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .toolbar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: space-between;
  }

  .mode-field {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
  }

  .mode-label {
    font-size: var(--ui-font-size-small);
    font-weight: var(--font-weight-6);
  }

  .diverged-note[hidden] {
    display: none;
  }

  .generator-grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: minmax(0, 1fr);

    @container (width >= 640px) {
      align-items: start;
      grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
    }
  }

  .controls {
    .ui-form {
      display: flex;
      flex-direction: column;
      gap: var(--size-4);
    }
  }

  .card-header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2) var(--size-3);
    justify-content: space-between;
    width: 100%;

    h3 {
      margin: 0;
    }
  }

  .preview-card {
    color: var(--ui-text-primary);

    @container (width >= 640px) {
      inset-block-start: calc(var(--size-10) + var(--size-4));
      max-block-size: calc(100dvb - var(--size-10) - var(--size-8));
      overflow-y: auto;
      position: sticky;

      @media (width >= 900px) and (width < 1140px) {
        inset-block-start: calc(var(--size-10) + var(--size-8) + var(--size-4));
        max-block-size: calc(100dvb - var(--size-10) - var(--size-8) * 2);
      }
    }
  }

  .preview-pane {
    color: var(--ui-text-primary);
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .section-label {
    color: var(--ui-text-muted);
    margin: 0;
  }

  .preview-card.no-grays .gray-palette {
    display: none;
  }

  .gray-palette {
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .palette-grid {
    display: grid;
    gap: var(--size-1);
    grid-template-columns: repeat(8, minmax(0, 1fr));

    @container (width >= 400px) {
      gap: var(--size-2);
    }
  }

  .swatch {
    aspect-ratio: 1;
    border: 1px solid var(--ui-border-color);
    border-radius: var(--ui-border-radius);
    display: grid;
    font-size: var(--font-size-0);
    inline-size: 100%;
    place-items: center;

    &:hover span {
      opacity: 1;
    }

    span {
      aspect-ratio: 1;
      background-color: oklch(from var(--ui-text-primary) l c h / 0.65);
      border-radius: var(--radius-round);
      color: var(--ui-text-inverse);
      display: grid;
      min-inline-size: 1lh;
      opacity: 0;
      padding-inline: 1ex;
      place-items: center;
      pointer-events: none;
      text-align: center;
      transition: opacity 0.2s ease-out;
    }
  }

  .surface-stack {
    display: grid;
    gap: var(--size-2);
    grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
  }

  .surface-swatch {
    align-items: center;
    border: 1px solid var(--ui-border-color);
    border-radius: var(--ui-border-radius);
    display: flex;
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-6);
    justify-content: space-between;
    padding: var(--size-2) var(--size-3);
    text-transform: uppercase;
  }

  .form-showcase {
    background-color: var(--ui-surface-tonal);
    border: 1px solid var(--ui-border-color);
    border-radius: var(--ui-border-radius);
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
    padding: var(--size-3);

    & .ui-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-3) var(--size-6);
    }
  }

  .css-output {
    .css-actions {
      display: flex;
      gap: var(--size-1);
    }

    pre {
      background: #1e1e1e;
      border-radius: var(--ui-border-radius);
      color-scheme: dark;
      margin: 0;
      max-block-size: 60vh;
      overflow: auto;
      padding: var(--size-4);
    }

    code {
      --syntax-comment: #74a061;
      --syntax-constant: #b5cea8;
      --syntax-function: #dcdcaa;
      --syntax-keyword: #c586c0;
      --syntax-operator: #d4d4d4;
      --syntax-property: #9cdcfe;
      --syntax-punctuation: #949494;
      --syntax-selector: #d7ba7d;
      --syntax-string: #ce9178;
      --syntax-tag: #569cd6;
      --syntax-type: #4ec9b0;
      --syntax-value: #ce9178;
      --syntax-variable: #9cdcfe;

      color: #d4d4d4;
      font-family: var(--font-mono);
      font-size: var(--font-size-0);
      white-space: pre;
    }
  }
</style>

<script>
  import { highlightAll } from "microlighter"
  import { exampleTheme } from "../../utils/example-themes"
  import { themeStore, TOKENS, type Mode } from "../../utils/theme-store"
  import { generateCss } from "./generateCss"
  import { copyText } from "../../utils/storage"
  import { themeForm } from "../../utils/theme-form"

  const root = document.getElementById("theme-generator-root")
  if (!root) throw new Error("Theme generator root not found")

  const form = document.getElementById(
    "theme-generator-form",
  ) as HTMLFormElement
  const preview = document.getElementById("theme-generator-preview")!
  const previewModeText = document.querySelector(
    "#theme-generator-preview-mode .ui-text",
  )
  const divergedNote = document.getElementById("theme-generator-diverged")
  const codeEl = document.getElementById("theme-generator-css-code")!
  const copyBtn = document.getElementById("theme-generator-copy")
  const downloadBtn = document.getElementById("theme-generator-download")
  const resetBtn = document.getElementById("theme-generator-reset")
  const modeRadios = root.querySelectorAll<HTMLInputElement>(
    'input[name="theme-generator-mode"]',
  )

  type EditingMode = Mode | "both"
  let editingMode: EditingMode = readModeFromRadios()
  let generatedCss = ""
  let refreshQueued = false

  function readModeFromRadios(): EditingMode {
    for (const r of modeRadios) {
      if (
        r.checked &&
        (r.value === "light" || r.value === "dark" || r.value === "both")
      ) {
        return r.value
      }
    }
    return "both"
  }

  function targetModes(): readonly Mode[] {
    return editingMode === "both" ? (["light", "dark"] as const) : [editingMode]
  }

  function previewMode(): Mode {
    return editingMode === "both" ? themeStore.getActiveSiteMode() : editingMode
  }

  function modesDiffer() {
    const light = themeStore.get("light")
    const dark = themeStore.get("dark")
    return (
      themeStore.isGraysEnabled("light") !==
        themeStore.isGraysEnabled("dark") ||
      TOKENS.some(
        (token) =>
          (light[token] ?? themeStore.defaults("light")[token]) !==
          (dark[token] ?? themeStore.defaults("dark")[token]),
      )
    )
  }

  const controls = themeForm(form, {
    setGrays: (enabled) =>
      targetModes().forEach((m) => themeStore.setEnableGrays(m, enabled)),
    setExampleTheme: (name) => themeStore.setExampleTheme(name),
    setToken: (token, value) =>
      targetModes().forEach((m) => themeStore.setToken(m, token, value)),
  })

  function applyToPreview() {
    const mode = previewMode()
    const config = themeStore.get(mode)
    const defaults = themeStore.defaults(mode)
    preview.classList.toggle("ui-dark", mode === "dark")
    preview.classList.toggle("ui-light", mode === "light")
    preview.classList.toggle("no-grays", config["enable-grays"] === "false")

    TOKENS.forEach((token) => {
      preview.style.setProperty(token, config[token] ?? defaults[token])
    })

    if (previewModeText) {
      previewModeText.textContent = mode === "dark" ? "Dark mode" : "Light mode"
    }
  }

  function rerenderCode() {
    generatedCss = generateCss({
      dark: themeStore.get("dark"),
      light: themeStore.get("light"),
      example: exampleTheme(themeStore.getExampleTheme())?.tokens,
    })
    codeEl.textContent = generatedCss
    highlightAll()
  }

  function refreshAll() {
    controls.sync(
      previewMode(),
      themeStore.get(previewMode()),
      themeStore.defaults(previewMode()),
      themeStore.getExampleTheme(),
    )
    applyToPreview()
    rerenderCode()
    if (divergedNote) {
      divergedNote.hidden = editingMode !== "both" || !modesDiffer()
    }
  }

  function scheduleRefresh() {
    if (refreshQueued) return
    refreshQueued = true
    requestAnimationFrame(() => {
      refreshQueued = false
      refreshAll()
    })
  }

  modeRadios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (!radio.checked) return
      editingMode = readModeFromRadios()
      refreshAll()
    })
  })

  form.addEventListener("change", (e) => {
    if ((e.target as HTMLInputElement).name === "--palette-source-color")
      scheduleRefresh()
  })

  resetBtn?.addEventListener("click", () => {
    themeStore.reset()
    form.reset()
    refreshAll()
  })

  copyBtn?.addEventListener("click", () => copyText(generatedCss))

  downloadBtn?.addEventListener("click", () => {
    const url = URL.createObjectURL(
      new Blob([generatedCss], { type: "text/css" }),
    )
    const link = document.createElement("a")
    link.href = url
    link.download = "custom-theme.css"
    link.click()
    setTimeout(() => URL.revokeObjectURL(url))
  })

  themeStore.subscribe(scheduleRefresh)

  refreshAll()
</script>
