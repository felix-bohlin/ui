---
import {
  Button,
  FieldLegend,
  Fieldset,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import { EXAMPLE_THEMES } from "../utils/example-themes"
import { BRAND_SWATCHES, CORNERS } from "../utils/theme"
---

<form class="theme-quick ui-form">
  <Fieldset>
    <FieldLegend>Start from</FieldLegend>
    <ToggleGroup aria-label="Start from" name="theme-preset" size="small">
      <ToggleButton checked value="">Default</ToggleButton>
      {
        EXAMPLE_THEMES.map((theme) => (
          <ToggleButton value={theme.name}>{theme.label}</ToggleButton>
        ))
      }
    </ToggleGroup>
  </Fieldset>

  <Fieldset>
    <FieldLegend>Brand color</FieldLegend>
    <div class="theme-quick-brand">
      <ToggleGroup aria-label="Brand color" name="theme-brand" size="small">
        <ToggleButton checked class="theme-quick-start" value="">
          Default
        </ToggleButton>
        {
          BRAND_SWATCHES.map((swatch) => (
            <ToggleButton value={swatch.value}>
              <span
                aria-hidden="true"
                class="theme-quick-swatch"
                style={`--swatch: ${swatch.value}`}
              />
              {swatch.label}
            </ToggleButton>
          ))
        }
      </ToggleGroup>
      <TextField
        hideLabel
        label="Custom brand color"
        name="theme-brand-custom"
        size="small"
        title="Custom brand color"
        type="color"
      />
    </div>
  </Fieldset>

  <Fieldset>
    <FieldLegend>Corners</FieldLegend>
    <ToggleGroup aria-label="Corners" name="theme-corners" size="small">
      <ToggleButton checked class="theme-quick-start" value="">
        Default
      </ToggleButton>
      {
        CORNERS.map((option) => (
          <ToggleButton value={option.value}>{option.label}</ToggleButton>
        ))
      }
      <ToggleButton class="theme-quick-custom" value="custom"
        >Custom</ToggleButton
      >
    </ToggleGroup>
  </Fieldset>

  <Fieldset class="theme-quick-saved" hidden>
    <FieldLegend>Your themes</FieldLegend>
    <ToggleGroup aria-label="Your themes" name="theme-saved" size="small" />
  </Fieldset>

  <div class="theme-quick-actions">
    <Button
      class="theme-quick-reset"
      size="small"
      type="button"
      variant="outlined"
    >
      Reset theme
    </Button>
    <p aria-live="polite" class="theme-quick-status"></p>
    <Button class="theme-quick-undo" hidden size="small" type="button">
      Undo
    </Button>
  </div>
</form>

<script>
  import { exampleTheme } from "../utils/example-themes"
  import { savedThemes } from "../utils/saved-themes"
  import {
    cornersOf,
    cornersUpdate,
    normalizeTheme,
    themeStore,
    type Theme,
  } from "../utils/theme"
  import {
    brandUpdate,
    isHex,
    resolveHex,
    switchPreset,
  } from "../utils/theme-brand"

  const fingerprint = (theme: Theme) => JSON.stringify(normalizeTheme(theme))

  for (const form of document.querySelectorAll<HTMLFormElement>(
    ".theme-quick",
  )) {
    const radios = (name: string) => [
      ...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`),
    ]
    const custom = form.querySelector<HTMLInputElement>(
      'input[name="theme-brand-custom"]',
    )!
    const saved = form.querySelector<HTMLElement>(".theme-quick-saved")!
    const savedList = saved.querySelector<HTMLElement>(".ui-toggle-group")!
    const status = form.querySelector<HTMLElement>(".theme-quick-status")!
    const undo = form.querySelector<HTMLButtonElement>(".theme-quick-undo")!
    let pendingColor: string | null = null
    let savedNames = ""
    let undoTheme: Theme | null = null
    let undoFingerprint = ""

    const check = (name: string, value: string | null) => {
      for (const radio of radios(name)) radio.checked = radio.value === value
    }

    const renderSaved = (names: string[]) => {
      savedList.replaceChildren(
        ...names.map((name) => {
          const label = document.createElement("label")
          label.className = "ui-toggle-button"
          const input = document.createElement("input")
          input.name = "theme-saved"
          input.type = "radio"
          input.value = name
          label.append(input, name)
          return label
        }),
      )
    }

    const sync = () => {
      const theme = themeStore.get()
      const { preset, tokens } = theme
      check("theme-preset", preset ?? "")
      const start = exampleTheme(preset)?.label ?? "Default"
      for (const label of form.querySelectorAll(".theme-quick-start")) {
        label.lastChild!.textContent = start
      }

      const brand = tokens["--ui-palette-source"] ?? null
      const swatch = brand
        ? radios("theme-brand").find(
            (radio) => radio.value.toLowerCase() === brand.toLowerCase(),
          )
        : undefined
      check("theme-brand", brand ? (swatch?.value ?? null) : "")
      if (document.activeElement !== custom) {
        custom.value =
          brand && isHex(brand)
            ? brand.toLowerCase()
            : (resolveHex("var(--ui-primary)") ?? custom.value)
      }

      check("theme-corners", cornersOf(tokens) ?? "")

      const names = savedThemes.list().map((entry) => entry.name)
      saved.hidden = names.length === 0
      if (names.join("\n") !== savedNames) {
        savedNames = names.join("\n")
        renderSaved(names)
      }
      check("theme-saved", savedThemes.current())

      if (undoTheme && fingerprint(theme) !== undoFingerprint) {
        undoTheme = null
        undo.hidden = true
        status.textContent = ""
      }
    }

    const undoable = (message: string, action: () => void) => {
      const before = themeStore.get()
      action()
      undoTheme = before
      undoFingerprint = fingerprint(themeStore.get())
      status.textContent = message
      undo.hidden = false
    }

    const applyBrand = (value: string | null) =>
      themeStore.update(
        value
          ? brandUpdate(themeStore.get().tokens, value)
          : { "--ui-palette-source": null, "--ui-primary-source": null },
      )

    form.addEventListener("submit", (event) => event.preventDefault())

    form.addEventListener("change", (event) => {
      const target = event.target
      if (!(target instanceof HTMLInputElement)) return
      if (target.type === "radio" && !target.checked) return
      if (target.name === "theme-preset") {
        switchPreset(target.value || null)
      } else if (target.name === "theme-brand") {
        applyBrand(target.value || null)
      } else if (target.name === "theme-corners") {
        if (target.value !== "custom") {
          themeStore.update(
            cornersUpdate(themeStore.get().tokens, target.value || null),
          )
        }
      } else if (target.name === "theme-saved") {
        undoable(`Switched to ${target.value}.`, () =>
          savedThemes.apply(target.value),
        )
      }
    })

    form
      .querySelector(".theme-quick-reset")!
      .addEventListener("click", () =>
        undoable("Theme reset.", () => themeStore.reset()),
      )

    undo.addEventListener("click", () => {
      if (!undoTheme) return
      const theme = undoTheme
      undoTheme = null
      undo.hidden = true
      themeStore.set(theme)
      status.textContent = "Undone."
      form.querySelector<HTMLElement>(".theme-quick-reset")!.focus()
    })

    custom.addEventListener("input", () => {
      const queued = pendingColor !== null
      pendingColor = custom.value
      if (queued) return
      requestAnimationFrame(() => {
        if (pendingColor) applyBrand(pendingColor)
        pendingColor = null
      })
    })

    sync()
    savedThemes.subscribe(sync)
  }
</script>

<style>
  .theme-quick {
    display: grid;
    gap: var(--size-4);

    :global([hidden]),
    :global(.theme-quick-custom:not(:has(:checked))) {
      display: none;
    }
  }

  .theme-quick-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
  }

  .theme-quick-brand {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
  }

  .theme-quick-status {
    color: var(--ui-text);
    font-size: var(--ui-font-size-small);
    margin: 0;
  }

  .theme-quick-swatch {
    background-color: var(--swatch);
    block-size: 0.75em;
    border-radius: var(--radius-round);
    display: inline-block;
    inline-size: 0.75em;
    margin-inline-end: var(--size-1);
  }
</style>
