---
import { Textarea } from "opui-css/astro"
import { plainText } from "../../utils/todo"

type Props = {
  text: string
}

const { text } = Astro.props
const commentId = Astro.locals.$id("comment-field")
---

<Textarea class="comment-field" for={commentId} size="small">
  <textarea
    aria-describedby={`${commentId}-end-text`}
    id={commentId}
    placeholder="Comment"
    rows={1}
  ></textarea>
  <span class="ui-sr-only" slot="label">
    {`Comment on: ${plainText(text)}`}
  </span>
  <span class="comment-saved" data-comment-saved slot="end-text"></span>
</Textarea>

<style>
  :global(.comment-field textarea) {
    field-sizing: content;
  }

  .comment-saved:empty {
    display: none;
  }
</style>
