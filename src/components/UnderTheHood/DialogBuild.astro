---
import { Button } from "opui-css/astro"
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.dialog {
  background-color: var(--ui-surface-elevated);
  border: 1px solid var(--ui-surface);
  border-radius: var(--ui-radius);
  box-shadow: var(--ui-shadow-overlay);
  color: inherit;
  display: flex;
  flex-direction: column;
  padding: 0;
}

.dialog:not([open]) {
  display: none;
}`,
    features: ["dialog", "dialog-closedby", "invoker-commands"],
    html: `
<button type="button" commandfor="dialog" command="show-modal">
  Shortcuts
</button>

<dialog
  class="dialog"
  id="dialog"
  aria-labelledby="dialog-title"
  closedby="any"
>
  <h2 id="dialog-title">Keyboard shortcuts</h2>
  <div class="content">…</div>
  <div class="footer">
    <button type="button" commandfor="dialog" command="close">Close</button>
  </div>
</dialog>`,
    notes: [
      "<code>command=&quot;show-modal&quot;</code>: top layer, inert page, focus moves in, no JavaScript",
      "<code>closedby=&quot;any&quot;</code> closes it on <kbd>Esc</kbd> and on a click outside",
      "<code>aria-labelledby</code> names it after its heading",
      "<code>display: flex</code> overrides the hidden state, so <code>:not([open])</code> puts <code>display: none</code> back",
      "The border is the page color, like an elevated card",
    ],
    title: "Modal",
  },
  {
    css: `
.dialog {
  inline-size: 100%;
  inset: 0;
  margin: auto;
  margin-block-start: 15dvb;
  max-block-size: calc(85dvb - 1rem);
  max-inline-size: min(100% - 1rem, 60ch);
  overflow: auto;
}

.dialog > :not(.content) {
  flex-shrink: 0;
}

.dialog > .content {
  overflow-block: auto;
  overscroll-behavior: contain;
}`,
    features: ["overscroll-behavior", "viewport-unit-variants"],
    notes: [
      "Pinned to 15% from the top, so it doesn't jump around as the content grows",
      "<code>dvb</code> follows the mobile browser toolbar as it shows and hides",
      "Only <code>.content</code> scrolls, the heading and footer stay put",
      "<code>overscroll-behavior: contain</code> stops the scroll from chaining to the page",
    ],
    title: "Place",
  },
  {
    css: `
.dialog > .content {
  anchor-name: --content;
  container-type: scroll-state;
}

.dialog > .content::before,
.dialog > .content::after {
  block-size: var(--ui-space-2);
  box-shadow: var(--ui-shadow-scroll);
  clip-path: inset(100% 0 calc(-1 * var(--ui-space-6)));
  content: "";
  inset-inline: anchor(--content inside);
  opacity: 0;
  pointer-events: none;
  position: absolute;
  transition: opacity 0.2s;
}

.dialog > .content::before {
  inset-block-end: anchor(--content outside);
}

.dialog > .content::after {
  inset-block-start: anchor(--content outside);
  scale: 1 -1;
}

@container scroll-state(scrollable: block-start) {
  .dialog > .content::before {
    opacity: 1;
  }
}

@container scroll-state(scrollable: block-end) {
  .dialog > .content::after {
    opacity: 1;
  }
}`,
    features: ["anchor-positioning", "container-scroll-state-queries"],
    notes: [
      "Scroll the shortcuts: a shadow shows on each edge with more to scroll",
      "<code>container-type: scroll-state</code> lets the pseudo-elements ask which way <code>.content</code> can scroll",
      "<code>anchor()</code> pins them to the edges of <code>.content</code>, so they don't scroll away",
      "<code>clip-path</code> keeps only the half of the shadow that falls on the content",
    ],
    title: "Shadow",
  },
  {
    css: `
.dialog::backdrop {
  backdrop-filter: blur(var(--ui-backdrop-blur));
  background-color: var(--ui-backdrop-bg-color);
}

html:has(.dialog:modal) {
  overflow: clip;
  scrollbar-gutter: stable;
}`,
    features: ["backdrop", "backdrop-filter", "has", "scrollbar-gutter"],
    notes: [
      "<code>::backdrop</code> covers the viewport, right under the dialog in the top layer",
      "<code>backdrop-filter</code> blurs the page behind it",
      "The page behind is inert but still scrolls, <code>html:has(.dialog:modal)</code> locks it",
      "<code>scrollbar-gutter: stable</code> keeps the layout still when the scrollbar goes",
    ],
    title: "Backdrop",
  },
  {
    css: `
.dialog {
  opacity: 0;
}

.dialog[open] {
  opacity: 1;
  transition:
    display 0.2s allow-discrete,
    opacity 0.2s,
    overlay 0.2s allow-discrete;

  @starting-style {
    opacity: 0;
  }
}`,
    features: [
      "display-animation",
      "overlay",
      "starting-style",
      "transition-behavior",
    ],
    notes: [
      "<code>@starting-style</code> gives the entry transition a starting point",
      "The transition only lives on <code>[open]</code>, so closing is instant, on purpose",
    ],
    title: "Fade",
  },
]

const shortcuts = [
  { keys: "⌘ K", label: "Search" },
  { keys: "⌘ S", label: "Save" },
  { keys: "⌘ Z", label: "Undo" },
  { keys: "⌘ ⇧ Z", label: "Redo" },
  { keys: "⌘ /", label: "Toggle comment" },
  { keys: "⌘ A", label: "Select all" },
  { keys: "⌘ B", label: "Bold" },
  { keys: "⌘ C", label: "Copy" },
  { keys: "⌘ F", label: "Find" },
  { keys: "⌘ I", label: "Italic" },
  { keys: "⌘ N", label: "New file" },
  { keys: "⌘ O", label: "Open" },
  { keys: "⌘ P", label: "Print" },
  { keys: "⌘ U", label: "Underline" },
  { keys: "⌘ V", label: "Paste" },
  { keys: "⌘ W", label: "Close tab" },
  { keys: "⌘ X", label: "Cut" },
  { keys: "Esc", label: "Close dialog" },
]
---

<BuildUp id="build-dialog" steps={steps}>
  <Button
    command="show-modal"
    commandfor="build-dialog-modal"
    variant="outlined"
  >
    Shortcuts
  </Button>
  <dialog
    aria-labelledby="build-dialog-title"
    class="dialog"
    closedby="any"
    id="build-dialog-modal"
  >
    <h3 id="build-dialog-title">Keyboard shortcuts</h3>
    <div class="content">
      <dl>
        {
          shortcuts.map((shortcut) => (
            <div>
              <dt>{shortcut.label}</dt>
              <dd>
                <kbd>{shortcut.keys}</kbd>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="footer">
      <Button command="close" commandfor="build-dialog-modal">Close</Button>
    </div>
  </dialog>
</BuildUp>

<style>
  :global(
    html:has(
        #build-dialog .build-up-steps :is([value="4"], [value="5"]):checked
      ):has(#build-dialog-modal:modal)
  ) {
    overflow: clip;
    scrollbar-gutter: stable;
  }

  .dialog {
    & h3 {
      font-size: var(--ui-font-size-large);
      margin: 0;
      padding: var(--ui-space-3) var(--ui-space-3) 0;
    }

    & .content {
      padding-inline: var(--ui-space-3);
    }

    & dl {
      display: grid;
      gap: var(--ui-space-2);
      margin: 0;
    }

    & dl > div {
      display: flex;
      justify-content: space-between;
    }

    & dd {
      margin: 0;
    }

    & .footer {
      display: flex;
      justify-content: end;
      padding: 0 var(--ui-space-1) var(--ui-space-2);
    }
  }
</style>
