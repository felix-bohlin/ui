---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.fieldset {
  all: unset;
  display: grid;
  gap: 0.25rem;
}

.fieldset legend {
  all: unset;
  font-weight: 600;
  margin-block-end: 0.75rem;
}`,
    features: ["all", "fieldset"],
    html: `
<fieldset class="fieldset">
  <legend>Account</legend>
  …
</fieldset>`,
    notes: [
      "<code>&lt;fieldset&gt;</code> and <code>&lt;legend&gt;</code> name the group for assistive tech",
      "<code>all: unset</code> drops the border, padding and the legend notch",
      "What's left is a plain grid",
    ],
    title: "Fieldset",
  },
  {
    css: `
.fieldset legend:has(+ .description) {
  margin-block-end: 0;
}

.description {
  color: var(--text-muted);
  font-size: var(--font-size-05);
  margin: 0;
}

.description:has(+ *) {
  margin-block-end: 0.75rem;
}`,
    features: ["has"],
    notes: [
      "<code>:has(+ .description)</code>: the legend knows a description follows",
      "The spacing moves from the legend to the description",
    ],
    title: "Description",
  },
  {
    css: `
.group {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.group + .group {
  margin-block-start: 1.25rem;
}

.group:has(> .check):not(:has(> :not(.check))) {
  gap: 0.5rem;
}

.group:has(> button):not(.column, :has(> :not(button))) {
  align-items: center;
  flex-direction: row;
  gap: 0.5rem;
}

.group:has(> button):not(.column, :has(> :not(button)), hr + .group) {
  margin-block-start: 1rem;
}

.group.column:has(> button):not(:has(> :not(button))) {
  align-items: start;
}`,
    features: ["not"],
    html: `
<form>
  <fieldset class="fieldset">
    <legend>Notifications</legend>
    …
  </fieldset>
  <div class="group">
    <button type="reset">Cancel</button>
    <button type="button">Save</button>
  </div>
</form>`,
    notes: [
      "<code>:has(> .check):not(:has(> :not(.check)))</code>: only checkboxes, radios or switches, nothing else",
      "A list of choices gets a tighter gap",
      "A group of only buttons becomes a row, unless it's set to <code>.column</code>",
      "The row gets space above it, unless an <code>&lt;hr&gt;</code> comes right before it",
      "A <code>.column</code> of buttons keeps each button at its own width",
      "The buttons act on the whole form, so their group goes after the fieldset, not inside it",
    ],
    title: "Groups",
  },
  {
    css: `
.fieldset:has(:required) legend {
  padding-inline-end: 1ex;
  position: relative;
}

.fieldset:has(:required) legend::after {
  color: var(--field-required-color);
  content: "*";
  inset-block: 0 auto;
  inset-inline: auto -0.25ex;
  position: absolute;
}`,
    notes: [
      "One <code>required</code> input anywhere inside marks the legend",
      "No prop to keep in sync with the inputs",
    ],
    title: "Required",
  },
]

const channels = ["Email", "Push", "SMS"]
---

<BuildUp id="build-form" steps={steps}>
  <form class="form">
    <fieldset class="fieldset">
      <legend>Notifications</legend>
      <p class="description">Where should we reach you?</p>
      <div class="group">
        <label class="field">
          Email address
          <input
            autocomplete="off"
            name="build-form-email"
            required
            type="email"
          />
        </label>
      </div>
      <div class="group">
        {
          channels.map((channel, index) => (
            <label class="check">
              <input
                checked={index === 0}
                name="build-form-channel"
                type="checkbox"
                value={channel}
              />
              {channel}
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="group">
      <button type="reset">Cancel</button>
      <button type="button">Save</button>
    </div>
  </form>
</BuildUp>

<style>
  .form {
    inline-size: min(100%, 20rem);
  }

  .field {
    display: grid;
    gap: var(--size-1);

    & input {
      background-color: var(--surface-default);
      border: var(--border-width, 1px) solid var(--border-color);
      border-radius: var(--radius-2);
      color: inherit;
      font: inherit;
      padding: var(--size-1) var(--size-2);
    }
  }

  .check {
    align-items: center;
    display: flex;
    gap: var(--size-2);
  }

  .group button {
    background-color: var(--surface-tonal);
    border: var(--border-width, 1px) solid var(--border-color);
    border-radius: var(--radius-2);
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: var(--size-1) var(--size-3);
  }
</style>
