---
import BuildUp from "./BuildUp.astro"

const chevron = `url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6'/></svg>")`

const steps = [
  {
    css: `
.select,
.select::picker(select) {
  appearance: base-select;
}

.select {
  background-color: var(--ui-surface);
  border: var(--ui-field-border-width) solid var(--ui-field-border-color);
  border-radius: var(--ui-radius);
  inline-size: 100%;
  padding: 0;
}

.select > button {
  align-items: center;
  display: flex;
  padding: 0.5rem 2.5rem 0.5rem 0.75rem;
}

selectedcontent {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}`,
    features: ["customizable-select"],
    html: `
<div class="field">
  <label for="fruit">Fruit</label>
  <select class="select" id="fruit">
    <button>
      <selectedcontent></selectedcontent>
    </button>
    <option value="apple">Apple</option>
    …
  </select>
</div>`,
    notes: [
      "<code>appearance: base-select</code> on the select and its picker opts in to the stylable select",
      "Every select in a <code>.ui-field</code> opts in, <code>&lt;button&gt;</code> or not",
      "<code>&lt;selectedcontent&gt;</code> mirrors the chosen option, the select keeps clicks, focus and the name",
      "Browsers without support ignore the button and show a native select",
    ],
    title: "Base select",
  },
  {
    css: `
.select {
  position: relative;
}

.select::picker-icon {
  background-color: currentColor;
  block-size: 1rem;
  content: "";
  inline-size: 1rem;
  inset-block: 50% auto;
  inset-inline: auto 0.75rem;
  mask: ${chevron} center / contain no-repeat;
  position: absolute;
  translate: 0 -50%;
}

.select:open::picker-icon {
  scale: 1 -1;
}`,
    features: ["individual-transforms", "masks", "open-pseudo"],
    notes: [
      "<code>::picker-icon</code> is the arrow",
      "A <code>mask</code> over <code>currentColor</code>: the chevron takes the text color",
      "<code>:open</code> flips it while the picker shows",
    ],
    title: "Arrow",
  },
  {
    css: `
.select::picker(select) {

  background-color: var(--ui-surface-raised);
  border: var(--ui-border-width) solid
    var(--ui-border-color-raised, var(--ui-border-color));
  border-radius: var(--ui-radius);
  box-shadow: var(--ui-shadow-overlay);
  padding: 0.5rem 0;
}

.select > option {
  padding: 0.5rem 0.75rem;
}

.select > option:hover {
  background-color: oklch(from var(--ui-primary) l c h / 15%);
}

.select > option::checkmark {
  margin-inline-start: auto;
  order: 1;
}

.select > option:checked {
  background-color: var(
    --ui-selected,
    oklch(
      from var(--ui-primary) l c h / var(--ui-state-selected-alpha-accent)
    )
  );
}`,
    features: ["relative-color"],
    notes: [
      "<code>::picker(select)</code> is the dropdown, a raised, anchored popover",
      "Options go straight in the select and style like any box",
      "<code>::checkmark</code> is the browser's check, at the end, backed by the tint",
      "Open the select",
    ],
    title: "Picker",
  },
  {
    css: `
.select::picker(select) {
  opacity: 1;
  scale: 1;
  transition:
    display 0.2s allow-discrete,
    opacity 0.2s,
    overlay 0.2s allow-discrete,
    scale 0.2s;

  @starting-style {
    opacity: 0;
    scale: 0.9;
  }
}

.select:not(:open)::picker(select) {
  opacity: 0;
  scale: 0.9;
}`,
    features: [
      "individual-transforms",
      "starting-style",
      "transition-behavior",
    ],
    notes: [
      "<code>@starting-style</code> sets where the entry starts",
      "<code>allow-discrete</code> keeps <code>display</code> and <code>overlay</code> through the exit",
      "<code>:not(:open)</code> is the exit state",
    ],
    title: "Animate",
  },
]

const fruits = ["Apple", "Banana", "Cherry", "Mango", "Pear"]
---

<BuildUp id="build-select" steps={steps}>
  <div class="field">
    <label for="build-select-fruit">Fruit</label>
    <select class="select" id="build-select-fruit" name="build-select-fruit">
      <button>
        <selectedcontent></selectedcontent>
      </button>
      {fruits.map((fruit) => <option value={fruit.toLowerCase()}>
        {fruit}
      </option>)}
    </select>
  </div>
</BuildUp>

<style>
  .field {
    display: grid;
    gap: var(--ui-space-1);
    inline-size: min(100%, 16rem);
  }

  .select {
    align-items: center;
    color: var(--ui-text-strong);
    font: inherit;
  }
</style>
