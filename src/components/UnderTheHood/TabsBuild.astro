---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.tab-panel {
  display: none;
}

.tab-input:checked + .tab-label + .tab-panel {
  display: block;
}`,
    html: `
<div aria-label="Account" class="tabs" role="radiogroup">
  <input class="tab-input" type="radio" name="tabs" id="tab-1" checked />
  <label class="tab-label" for="tab-1">Profile</label>
  <div class="tab-panel">…</div>
  …
</div>`,
    notes: [
      "One radio group holds the state",
      "<code>:checked + label + panel</code> shows the matching panel",
    ],
    title: "Radios",
  },
  {
    css: `
.tabs {
  align-items: flex-start;
  display: flex;
  flex-wrap: wrap;
}

.tab-label {
  order: 1;
}

.tab-panel {
  inline-size: 100%;
  order: 2;
}`,
    notes: [
      "The markup interleaves label, panel, label, panel",
      "<code>order</code> pulls every label into one row and drops the panel below",
      "<code>.ui-vertical</code> swaps the row for a two-column grid: the labels stack in the first column, and the panel spans their rows and one <code>1fr</code> row after them, so its height goes to that row and the labels keep theirs",
    ],
    title: "Order",
  },
  {
    css: `
.tab-input {
  block-size: 1px;
  clip-path: inset(50%);
  inline-size: 1px;
  overflow: hidden;
  position: absolute;
  white-space: nowrap;
}

.tab-input:focus-visible + .tab-label {
  outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
    var(--ui-focus-ring-color);
  outline-offset: var(--ui-focus-ring-offset);
}`,
    features: ["clip-path", "focus-visible"],
    notes: [
      "Visually hidden, still focusable: arrow keys move between tabs",
      "Focus ring on the label, for now",
    ],
    title: "Hide radios",
  },
  {
    css: `
.tab-label {
  background-color: var(--ui-surface-tonal);
  isolation: isolate;
  padding: calc(0.25rem + var(--inset)) 0.75rem;
  position: relative;
}

.tab-label::before {
  border: 1px solid transparent;
  border-radius: calc(var(--radius) - var(--inset));
  content: "";
  inset: var(--inset) 0;
  position: absolute;
  transition: background-color 0.1s;
  z-index: -1;
}

.tab-label:nth-child(1 of .tab-label) {
  border-end-start-radius: var(--radius);
  border-start-start-radius: var(--radius);
  padding-inline-start: calc(0.75rem + var(--inset));

  &::before {
    inset-inline-start: var(--inset);
  }
}

.tab-label:nth-last-child(1 of .tab-label) {
  border-end-end-radius: var(--radius);
  border-start-end-radius: var(--radius);
  padding-inline-end: calc(0.75rem + var(--inset));

  &::before {
    inset-inline-end: var(--inset);
  }
}

.tab-input:checked + .tab-label::before {
  background-color: var(--ui-surface);
  border-color: var(--ui-field-border-color);
  box-shadow: var(--ui-shadow-selected);
}

.tab-input:focus-visible + .tab-label {
  outline: none;
  z-index: 1;
}

.tab-input:focus-visible + .tab-label::before {
  outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
    var(--ui-focus-ring-color);
  outline-offset: var(--ui-focus-ring-offset);
}`,
    features: ["isolation", "nth-child-of"],
    notes: [
      "Each label paints its slice of the track",
      "The pill is a <code>::before</code> inset from the track",
      "<code>:nth-child(1 of .tab-label)</code> finds the first label among the radios and panels",
      "Inner radius = outer radius − inset",
      "Every pill has a transparent border, the checked one colors it with the field border, so it stands out from the track",
      "Logical radii round the ends in right-to-left too",
      "The focus ring moves onto the pill, and <code>z-index</code> lifts it over the next label",
    ],
    title: "Segmented",
  },
  {
    css: `
.tabs {
  container-type: inline-size;
  display: grid;
  grid-auto-columns: max-content;
  overflow-inline: auto;
  position: relative;
}

.tab-label {
  grid-row: 1;
}

.tab-input {
  grid-column: calc((sibling-index() + 2) / 3) / span 1;
  grid-row: 1 / span 1;
  inset-block-start: 50%;
  inset-inline-start: 50%;
}

.tab-input:focus-visible + .tab-label::before {
  outline-offset: var(--ui-focus-ring-inset);
}

.tab-panel {
  grid-column: 1 / span calc(sibling-count() / 3);
  grid-row: 2;
  inline-size: 100cqi;
  inset-inline-start: 0;
  margin-inline-end: -100cqi;
  position: sticky;
}`,
    features: ["container-queries", "logical-properties", "sibling-count"],
    notes: [
      "A one-row grid scrolls sideways when the labels don't fit: narrow it with the Width knob",
      "Every label takes a column in row 1, and the panels share row 2",
      "<code>sibling-index()</code> gives each radio its label's column, and its insets place it there, so the arrow keys scroll the tab they select into view",
      "The panel is as wide as the container (<code>100cqi</code>) and sticks to its start, and the negative margin keeps it from widening the columns",
      "The scroller clips what reaches past it, so the focus ring moves inside the pill",
    ],
    title: "Scroll",
  },
]

const knobs = [
  {
    label: "Inset",
    max: 8,
    min: 0,
    property: "--inset",
    unit: "px",
    value: 3,
  },
  {
    label: "Radius",
    max: 24,
    min: 4,
    property: "--radius",
    step: 2,
    unit: "px",
    value: 10,
  },
  {
    label: "Width",
    max: 24,
    min: 8,
    property: "--width",
    unit: "rem",
    value: 24,
  },
]

const tabs = [
  { label: "Profile", panel: "Your bio, your gear and your 5-string." },
  { label: "Settings", panel: "Pokes, privacy and who hears your slaps." },
  { label: "Gold", panel: "Your Bassbook Gold plan and its shiny perks." },
]
---

<BuildUp id="build-tabs" knobs={knobs} steps={steps}>
  <div aria-label="Account" class="tabs" role="radiogroup">
    {tabs.map((tab, index) => (
      <>
        <input
          checked={index === 0}
          class="tab-input"
          id={`build-tab-${index}`}
          name="build-tabs"
          type="radio"
        />
        <label class="tab-label" for={`build-tab-${index}`}>
          {tab.label}
        </label>
        <div class="tab-panel">{tab.panel}</div>
      </>
    ))}
  </div>
</BuildUp>

<style>
  .tabs {
    inline-size: min(100%, var(--width));
  }

  .tab-label {
    cursor: pointer;
    font-size: var(--ui-font-size-control);
    font-weight: 500;
  }

  .tab-panel {
    margin-block-start: var(--ui-space-2);
  }
</style>
