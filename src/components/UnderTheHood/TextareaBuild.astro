---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.textarea {
  display: grid;
}

.label {
  font-size: var(--ui-field-label-font-size);
  font-weight: 600;
  margin-block-end: var(--ui-space-1);
}

.field {
  background-color: var(--ui-surface);
  border: 1px solid var(--ui-field-border-color);
  border-radius: var(--ui-radius);
  display: grid;
}

.field textarea {
  background: transparent;
  border: 0;
  color: var(--ui-text-strong);
  font: inherit;
  inline-size: 100%;
  line-height: 1.5;
  outline: 0;
  padding: var(--ui-space-2);
}

.textarea:focus-within .field {
  border-color: var(--ui-primary);
}

.field:has(:focus-visible) {
  outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
    var(--ui-focus-ring-color);
  outline-offset: var(--ui-focus-ring-offset);
}`,
    features: ["focus-visible", "textarea"],
    html: `
<div class="textarea">
  <label class="label" for="notes">Notes</label>
  <span class="field">
    <textarea id="notes" rows="2">…</textarea>
  </span>
</div>`,
    notes: [
      "Same box as every Field",
      "<code>rows</code> fixes the height, the content scrolls",
      "<code>:has(:focus-visible)</code> adds a ring, since a border color change alone is too weak",
    ],
    title: "Field",
  },
  {
    css: `
.field textarea {
  block-size: auto;
  field-sizing: content;
}`,
    features: ["field-sizing"],
    notes: [
      "<code>field-sizing: content</code> sizes the box to its text",
      "Type and delete a few lines",
      "No JavaScript",
    ],
    title: "Grow",
  },
  {
    css: `
.field textarea {
  max-block-size: var(--_max-block-size, 20lh);
  min-block-size: calc(var(--ui-space-2) * 2 + 3lh);
  resize: block;
}`,
    features: ["lh"],
    notes: [
      "<code>lh</code> is one line of the textarea's own text",
      "The minimum keeps an empty field looking like a textarea",
      "<code>--_max-block-size</code> sets the cap, as in the library, then it scrolls",
    ],
    title: "Limits",
  },
  {
    css: `
.auto-fit {
  inline-size: fit-content;
}

.auto-fit textarea {
  inline-size: auto;
  min-inline-size: 25ch;
  resize: both;
}`,
    notes: [
      "Without a fixed width, <code>field-sizing</code> grows sideways too",
      "<code>min-inline-size</code> stops short text collapsing the box",
      "<code>resize: both</code> once the width is free",
    ],
    title: "Auto-fit",
  },
]

const knobs = [
  {
    label: "Max lines",
    max: 12,
    min: 4,
    property: "--_max-block-size",
    step: 1,
    unit: "lh",
    value: 6,
  },
]

const notes = [
  "Band practice",
  "- Bass solo (finally)",
  "- Drop D songs",
  "- Root notes",
  "- Soundcheck",
  "- Turn-it-down talk",
  "- Wrap-up",
].join("\n")
---

<BuildUp id="build-textarea" knobs={knobs} steps={steps}>
  <div class="stack">
    <div class="textarea">
      <label class="label" for="build-textarea-notes">Notes</label>
      <span class="field">
        <textarea
          id="build-textarea-notes"
          name="build-textarea-notes"
          rows="2"
        >{notes}</textarea>
      </span>
    </div>
    <div class="textarea auto-fit">
      <label class="label" for="build-textarea-title">Title</label>
      <span class="field">
        <textarea
          id="build-textarea-title"
          name="build-textarea-title"
          rows="2"
        >Short</textarea>
      </span>
    </div>
  </div>
</BuildUp>

<style>
  .stack {
    display: grid;
    gap: var(--ui-space-4);
    inline-size: min(100%, 22rem);
  }
</style>
