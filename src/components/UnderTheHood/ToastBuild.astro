---
import { Button } from "@opui/astro"
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.stack {
  display: flex;
  flex-direction: column;
  justify-content: end;
}

.toast {
  align-items: center;
  background-color: var(--surface-elevated);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-2);
  box-shadow: var(--shadow-4);
  display: flex;
  gap: 0.75rem;
  margin-block: 0.375rem;
  padding: 0.75rem 1rem;
}`,
    features: ["invoker-commands", "popover", "template"],
    html: `
<button
  commandfor="toaster"
  command="--show-toast"
  data-title="Draft saved"
>
  Default
</button>

<section class="toaster" id="toaster" popover="manual" aria-live="polite">
  <template>
    <div class="toast">…</div>
  </template>
</section>`,
    notes: [
      "A toast is a plain element in the toaster, a manual popover in the top layer",
      "Custom commands start with <code>--</code>. A few lines of JS clone the <code>&lt;template&gt;</code> and fill it with <code>textContent</code>",
      "The newest toast is last, closest to the edge",
      "Nothing removes them yet",
    ],
    title: "Stack",
  },
  {
    css: `
@property --presence {
  syntax: "<number>";
  inherits: false;
  initial-value: 1;
}

.toast {
  block-size: calc-size(auto, size * var(--presence));
  margin-block: calc(0.375rem * var(--presence));
  opacity: var(--presence);
  overflow: clip;
  padding-block: calc(0.75rem * var(--presence));
  transition: --presence 0.3s;
  translate: 0 calc(1rem * (1 - var(--presence)));

  @starting-style {
    --presence: 0;
  }
}`,
    features: ["calc-size", "registered-custom-properties", "starting-style"],
    notes: [
      "One registered number says how present a toast is: <code>0</code> is gone, <code>1</code> is here",
      "Opacity, slide, margins and height all derive from it, so one transition animates them all",
      "<code>@starting-style</code> starts new toasts at <code>0</code>",
      "<code>calc-size()</code> grows the height from <code>0</code>, so the stack makes room instead of jumping",
    ],
    title: "Presence",
  },
  {
    css: `
.toast {
  animation: build-toast-expire 0.2s var(--duration, 5s) forwards;
}

.stack:is(:hover, :focus-within) .toast {
  animation-play-state: paused;
}

@keyframes build-toast-expire {
  to {
    --presence: 0;
    visibility: hidden;
  }
}`,
    features: ["animations-css", "focus-within"],
    notes: [
      "The lifetime is the delay of the exit animation, no <code>setTimeout</code>",
      "Hover or focus the stack to stop every clock",
      "JS removes the toast on <code>animationend</code>",
    ],
    title: "Lifetime",
  },
  {
    css: `
.toast[hidden],
.toast:nth-last-child(n + 4 of .toast:not([hidden])) {
  --presence: 0;
  visibility: hidden;
}

.toast[hidden] {
  animation: none;
}`,
    features: ["nth-child-of"],
    notes: [
      "Close sets <code>hidden</code>, and <code>--presence</code> transitions back to <code>0</code>",
      "Only the three newest show. Older ones collapse and come back when there is room",
    ],
    title: "Leave",
  },
]

const triggers = [
  { label: "Default", title: "Draft saved" },
  {
    duration: "3s",
    label: "Success",
    severity: "success",
    title: "Published",
  },
  {
    duration: "8s",
    label: "Critical",
    severity: "critical",
    title: "Upload failed",
  },
]
---

<BuildUp id="build-toast" steps={steps}>
  <div class="row">
    {
      triggers.map((trigger) => (
        <Button
          command="--show-toast"
          commandfor="build-toast-stack"
          data-duration={trigger.duration}
          data-severity={trigger.severity}
          data-title={trigger.title}
          variant="outlined"
        >
          {trigger.label}
        </Button>
      ))
    }
  </div>
  <div aria-live="polite" class="stack" id="build-toast-stack"></div>
  <template id="build-toast-template">
    <div class="toast">
      <span class="icon"></span>
      <div class="title"></div>
      <button aria-label="Dismiss" class="close" type="button">
        <svg
          aria-hidden="true"
          fill="none"
          height="20"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="20"
          xmlns="http://www.w3.org/2000/svg"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
    </div>
  </template>
</BuildUp>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: center;
  }

  .stack {
    font-size: var(--font-size-05);
    margin-inline: auto;
    max-inline-size: 24rem;
    min-block-size: 12rem;
  }
</style>

<style is:global>
  @property --presence {
    inherits: false;
    initial-value: 1;
    syntax: "<number>";
  }

  #build-toast-stack {
    & .icon {
      block-size: var(--icon-size);
      display: none;
      flex-shrink: 0;
      inline-size: var(--icon-size);
      mask: center / contain no-repeat;
    }

    & [data-severity="critical"] .icon {
      background-color: var(--critical);
      display: block;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'/><path d='m15 9-6 6'/><path d='m9 9 6 6'/></svg>");
    }

    & [data-severity="success"] .icon {
      background-color: var(--success);
      display: block;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><path d='m9 11 3 3L22 4'/></svg>");
    }

    & .title {
      flex: 1;
      font-weight: var(--font-weight-semibold);
    }

    & .close {
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      display: grid;
      padding: var(--size-1);
      place-items: center;
    }
  }

  @keyframes build-toast-expire {
    to {
      --presence: 0;

      visibility: hidden;
    }
  }
</style>

<script>
  function initToastBuild() {
    const stack = document.getElementById("build-toast-stack")
    const template = document.getElementById("build-toast-template")
    if (!stack || !(template instanceof HTMLTemplateElement)) return
    if (stack.dataset.ready) return
    stack.dataset.ready = ""

    stack.addEventListener("command", (event) => {
      if (!(event instanceof CommandEvent)) return
      if (event.command !== "--show-toast") return
      if (!(event.source instanceof HTMLElement)) return

      const { duration, severity, title } = event.source.dataset
      const toast = template.content.firstElementChild?.cloneNode(true)
      if (!(toast instanceof HTMLElement)) return

      toast.querySelector(".title")!.textContent = title ?? ""
      if (duration) toast.style.setProperty("--duration", duration)
      if (severity) toast.dataset.severity = severity

      toast.querySelector(".close")?.addEventListener("click", async () => {
        toast.hidden = true
        await Promise.allSettled(toast.getAnimations().map((a) => a.finished))
        toast.remove()
      })
      stack.append(toast)
    })

    stack.addEventListener("animationend", (event) => {
      if (event.animationName !== "build-toast-expire") return
      if (event.target instanceof HTMLElement) event.target.remove()
    })
  }

  initToastBuild()
  document.addEventListener("astro:after-swap", initToastBuild)
</script>
