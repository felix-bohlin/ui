---
import BuildUp from "./BuildUp.astro"

const steps = [
  {
    css: `
.toggle {
  align-items: center;
  block-size: var(--ui-button-size);
  border: 1px solid var(--ui-border-color);
  border-radius: var(--ui-button-radius, var(--ui-radius));
  color: var(--ui-text-strong);
  cursor: pointer;
  display: inline-flex;
  gap: var(--ui-space-2);
  justify-content: center;
  min-inline-size: var(--ui-button-size);
  padding: 0 var(--ui-space-2);
  position: relative;
  user-select: none;
}`,
    html: `
<label class="toggle">
  <input type="checkbox" />
  Bold
</label>`,
    notes: [
      "A <code>&lt;label&gt;</code> wrapping a checkbox: click, keyboard and form value for free",
      "The checkbox holds the state, no <code>aria-pressed</code> to keep in sync",
    ],
    title: "Label",
  },
  {
    css: `
.toggle {
  --bg: transparent;
  background-color: var(--bg);
}

.toggle:hover {
  --bg: light-dark(
    oklch(0% 0 0 / var(--ui-state-hover-alpha-light)),
    oklch(100% 0 0 / var(--ui-state-hover-alpha-dark))
  );
}

.toggle:has(input:checked) {
  --bg: var(--ui-selected, var(--ui-primary));
  color: var(--ui-on-selected, var(--ui-on-primary));
}`,
    features: ["has", "light-dark"],
    notes: [
      "<code>:has(input:checked)</code>: the label styles itself from the checkbox state",
      "A checked toggle is filled, so it reads as on without relying on a faint tint",
      "<code>light-dark()</code> picks the hover tint per color scheme",
    ],
    title: "Pressed",
  },
  {
    css: `
.toggle input {
  block-size: 1px;
  clip-path: inset(50%);
  inline-size: 1px;
  overflow: hidden;
  position: absolute;
  white-space: nowrap;
}

.toggle:has(input:focus-visible) {
  outline: var(--ui-focus-ring-width) var(--ui-focus-ring-style)
    var(--ui-focus-ring-color);
  outline-offset: var(--ui-focus-ring-inset);
}`,
    features: ["focus-visible"],
    notes: [
      "Visually hidden, still focusable and announced",
      "<code>:has(input:focus-visible)</code> draws an inset focus ring on the label",
      "<kbd>Tab</kbd> to a toggle and press <kbd>Space</kbd>",
    ],
    title: "Hide input",
  },
  {
    css: `
.toggle-group {
  background-color: var(--ui-surface);
  border-radius: var(--ui-button-radius, var(--ui-radius));
  column-rule: 1px solid var(--ui-border-color);
  display: inline-flex;
  flex-wrap: wrap;
  gap: 1px;
  outline: 1px solid var(--ui-border-color);
  outline-offset: -1px;
  overflow: hidden;
  row-rule: 1px solid var(--ui-border-color);
}

.toggle-group .toggle {
  border: 0;
  border-radius: 0;
  flex: auto;
}`,
    html: `
<div class="toggle-group" role="radiogroup">
  <label class="toggle">
    <input type="radio" name="view" checked />
    Day
  </label>
  …
</div>`,
    features: ["gap-decorations"],
    notes: [
      "Radios with a shared <code>name</code>: single select, no JavaScript",
      "Checkboxes for multi-select, with <code>role=&quot;group&quot;</code>",
      "The toggles sit one pixel apart, and <code>column-rule</code> and <code>row-rule</code> draw the lines in those gaps, only between toggles, so a wrapped row starts without one",
      "The group clips the toggles at its rounded corners",
    ],
    title: "Group",
  },
]

const groups = [
  {
    items: [
      { checked: true, label: "Bold" },
      { checked: false, label: "Italic" },
      { checked: true, label: "Underline" },
    ],
    label: "Format",
    role: "group",
    type: "checkbox",
  },
  {
    items: [
      { checked: true, label: "Day" },
      { checked: false, label: "Week" },
      { checked: false, label: "Month" },
    ],
    label: "View",
    role: "radiogroup",
    type: "radio",
  },
] as const
---

<BuildUp id="build-toggle" steps={steps}>
  {groups.map((group) => <div
    aria-label={group.label}
    class="toggle-group"
    role={group.role}
  >
    {group.items.map((item) => <label class="toggle">
      <input
        checked={item.checked}
        name={`build-toggle-${group.type}`}
        type={group.type}
        value={item.label}
      />
      {item.label}
    </label>)}
  </div>)}
</BuildUp>
