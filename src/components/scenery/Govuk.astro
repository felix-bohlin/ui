<style>
  .scene {
    display: none;

    :global(html[data-example-theme="govuk"]) & {
      display: block;
    }
  }

  svg {
    block-size: 100%;
    display: block;
    inline-size: 100%;
  }

  .govuk-back {
    fill: light-dark(oklch(0.93 0 0), oklch(0.21 0 0));
  }

  .govuk-windows {
    fill: light-dark(
      oklch(from var(--ui-focus-ring-color) l c h / 0%),
      oklch(from var(--ui-focus-ring-color) l c h / 70%)
    );
  }

  .govuk-landmarks,
  .govuk-eye-legs {
    fill: light-dark(oklch(0.8 0 0), oklch(0.29 0 0));
  }

  .govuk-eye {
    fill: light-dark(oklch(0.8 0 0), oklch(0.29 0 0));
    stroke: light-dark(oklch(0.8 0 0), oklch(0.29 0 0));
  }

  .govuk-clock {
    fill: light-dark(oklch(0.96 0 0), var(--ui-focus-ring-color));
  }

  .govuk-river {
    fill: light-dark(
      oklch(from var(--ui-palette-source) 0.93 0.03 h),
      oklch(from var(--ui-palette-source) 0.22 0.04 h)
    );
  }

  .govuk-embankment {
    fill: var(--ui-palette-source);
  }

  .govuk-ripples {
    fill: light-dark(
      oklch(from var(--ui-palette-source) 0.97 0.015 h),
      oklch(from var(--ui-focus-ring-color) l c h / 35%)
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.ui-motion-off)) .govuk-eye {
      animation: govuk-turn 240s linear infinite;
      transform-box: view-box;
      transform-origin: 700px 220px;
    }
  }

  @keyframes govuk-turn {
    to {
      rotate: 1turn;
    }
  }
</style>
