<style>
  .scene {
    display: none;

    :global(html[data-example-theme="shadcn"]) & {
      display: block;
    }
  }

  svg {
    block-size: 100%;
    display: block;
    inline-size: 100%;
  }

  path {
    fill: none;
    stroke: oklch(from var(--ui-text-subtle) l c h / 30%);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .shadcn-major {
    stroke: oklch(from var(--ui-text-subtle) l c h / 55%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.ui-motion-off)) path {
      animation: shadcn-draw 2.4s cubic-bezier(0.25, 1, 0.5, 1)
        calc(200ms + var(--i) * 70ms) backwards;
      stroke-dasharray: 1;
    }
  }

  @keyframes shadcn-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
