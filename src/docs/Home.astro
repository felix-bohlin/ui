---
import {
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Checkbox,
  Chip,
  Progress,
  Range,
  Switch,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
  TextField,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import AstroLogo from "../components/AstroLogo.astro"
import ChipRain from "../components/ChipRain.astro"
import ComponentShowcase from "../components/ComponentShowcase/ComponentShowcase.astro"
import Html5Logo from "../components/Html5Logo.astro"
import ReactLogo from "../components/ReactLogo.astro"
import SvelteLogo from "../components/SvelteLogo.astro"
import VueLogo from "../components/VueLogo.astro"
import Default from "../layouts/Default.astro"
import { allBlocks } from "../utils/blocks"
import { components } from "../utils/components"
import { hexToOklch } from "../utils/color-utils"
import { EXAMPLE_THEMES } from "../utils/example-themes"
import { FRAMEWORKS, hrefFor, type FrameworkId } from "../utils/framework"
import { posts } from "../utils/learn-posts"
import { packageVersion, prerelease, unreleased } from "../utils/release"
import { RADIUS_OPTIONS } from "../utils/theme-store"
import { themeTokens, tokenTier } from "../utils/theme-tokens"

const description = "Design system. Components. Modern HTML & CSS."

const currentFramework = Astro.locals.framework
const { link } = Astro.locals
const componentsHref = hrefFor(currentFramework, "/components")
const quickstartHref = hrefFor(currentFramework, "/guide/getting-started")
const conceptsHref = hrefFor(currentFramework, "/guide/concepts")
const generatorHref = hrefFor(currentFramework, "/guide/theme-generator")
const tokensHref = hrefFor(currentFramework, "/guide/theme-tokens")

const FRAMEWORK_BRANDING: Record<
  FrameworkId,
  { color?: string; Logo: typeof AstroLogo }
> = {
  astro: { color: "#F041FF", Logo: AstroLogo },
  html: { Logo: Html5Logo },
  react: { color: "#61DAFB", Logo: ReactLogo },
  svelte: { color: "#FF3E00", Logo: SvelteLogo },
  vue: { color: "#41B883", Logo: VueLogo },
}

const heroKnobs = (hex?: string) =>
  hex
    ? `--ui-palette-hue: ${Math.round(hexToOklch(hex).H)}; --ui-palette-chroma: 0.5`
    : "--ui-palette-hue: var(--hue-blue); --ui-palette-chroma: 0.6"

const roleTokens = themeTokens().filter(
  (token) => tokenTier(token.name) === "role",
).length

const materials = [
  {
    href: link("/blocks"),
    item: "Blocks",
    note: "Pages and sections built from the components",
    qty: allBlocks.length,
  },
  {
    href: componentsHref,
    item: "Components",
    note: "One CSS file each, with HTML, Astro, React, Svelte and Vue",
    qty: components.length,
  },
  {
    href: hrefFor(currentFramework, "/guide/customizing#example-themes"),
    item: "Example themes",
    note: EXAMPLE_THEMES.map((theme) => theme.label).join(", "),
    qty: EXAMPLE_THEMES.length,
  },
  {
    href: link("/learn"),
    item: "Learn posts",
    note: "The CSS behind each component, one feature at a time",
    qty: posts.length,
  },
  {
    href: "https://open-props.style",
    item: "Open Props",
    note: "The sizes, radii, easings and shadows underneath",
    qty: 1,
  },
  {
    href: tokensHref,
    item: "Theme tokens",
    note: "Roles every component reads, each with a contrast promise",
    qty: roleTokens,
  },
]

const titleBlock = [
  { label: "Drawing", value: "Open Props UI" },
  { label: "Rev", value: packageVersion },
  { label: "Scale", value: "1:1" },
  { label: "Material", value: "HTML & CSS" },
  { label: "Base", value: "Open Props" },
  { label: "Sheet", value: "1 of 4" },
]

const dimensions = [
  { prop: "block-size", token: "--ui-button-size", value: "40px" },
  { prop: "border-radius", token: "--ui-button-radius", value: "8px" },
  { prop: "font-size", token: "--ui-font-size-control", value: "16px" },
  { prop: "font-weight", token: "--ui-button-font-weight", value: "700" },
  { prop: "background-color", token: "--ui-primary", value: "" },
]

const steps = Array.from({ length: 16 }, (_, i) => i + 1)
---

<Default description={description}>
  <main id="main-content" class="blueprint container is-wide">
    <section
      class="sheet hero ui-palette"
      aria-labelledby="main-heading"
      style={heroKnobs(FRAMEWORK_BRANDING[currentFramework].color)}
    >
      <div class="hero-copy">
        <hgroup class="ui-hgroup">
          <p class="hero-version">
            {packageVersion}
            {
              unreleased && (
                <span class="ui-chip ui-dot ui-warning ui-x-small">
                  <span class="ui-text">
                    {prerelease ? "Release candidate" : "Not on npm yet"}
                  </span>
                </span>
              )
            }
          </p>

          <h1 class="ui-h1" id="main-heading">Open Props UI</h1>

          <p class="hero-description">{description}</p>
        </hgroup>

        <p class="hero-lede">
          One set of theme tokens, drawn through {components.length} components in
          HTML, Astro, React, Svelte and Vue. Built on Open Props and the CSS that
          shipped this year.
        </p>

        <div class="hero-ctas">
          <Button href={quickstartHref} variant="filled" color="primary">
            Quickstart
          </Button>
          <Button href={componentsHref} variant="outlined" color="primary">
            Components
          </Button>
        </div>

        <nav class="framework-support" aria-label="Framework">
          {
            FRAMEWORKS.map((framework) => {
              const branding = FRAMEWORK_BRANDING[framework.id]
              const Logo = branding.Logo
              const isCurrent = framework.id === currentFramework
              return (
                <Chip
                  href={hrefFor(framework.id, "/")}
                  aria-current={isCurrent ? "page" : undefined}
                  variant={isCurrent ? "tonal" : "outlined"}
                  data-hero-knobs={heroKnobs(branding.color)}
                  data-framework={framework.id}
                >
                  <Logo slot="start" />
                  <Fragment slot="label">{framework.label}</Fragment>
                </Chip>
              )
            })
          }
        </nav>
      </div>

      <figure
        class="drawing"
        aria-label="A filled primary Button with its theme tokens"
      >
        <div class="drawing-stage">
          <div class="drawing-subject">
            <button class="ui-button ui-filled ui-primary" inert type="button">
              Get started
            </button>
          </div>
          <span class="dimension dimension-height" aria-hidden="true"></span>
          <span class="leader leader-radius" aria-hidden="true"></span>
          <span class="leader leader-fill" aria-hidden="true"></span>
          <span class="leader leader-text" aria-hidden="true"></span>
          <span class="leader leader-weight" aria-hidden="true"></span>
          <dl class="dimensions">
            {
              dimensions.map((dimension) => (
                <div class={`dimension-label label-${dimension.prop}`}>
                  <dt>
                    <code>{dimension.token}</code>
                  </dt>
                  <dd>
                    {dimension.prop === "background-color" && (
                      <span class="swatch" aria-hidden="true" />
                    )}
                    <output data-prop={dimension.prop}>
                      {dimension.value}
                    </output>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </figure>

      <dl class="title-block" aria-label="Title block">
        {
          titleBlock.map((cell) => (
            <div>
              <dt>{cell.label}</dt>
              <dd>{cell.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sheet" aria-labelledby="components-heading">
      <header class="sheet-header">
        <h2 class="ui-h2" id="components-heading">Every component, to scale</h2>
        <p>
          Each component is a CSS file you can read, change and keep. Open one
          for its anatomy, its API and the files it depends on, with a button
          that copies them all.
        </p>
      </header>

      <ComponentShowcase />
    </section>

    <section class="sheet" aria-labelledby="spec-heading">
      <header class="sheet-header">
        <h2 class="ui-h2" id="spec-heading">
          Turn three knobs, the whole kit follows
        </h2>
        <p>
          A theme sets knobs like the palette hue. The knobs derive a 16-step
          palette, the palette fills about {roleTokens} role tokens such as
          <code>--ui-primary</code> and <code>--ui-surface</code>, and every
          component reads the roles. No component reads a palette step, and a
          check in the repo keeps it that way.
        </p>
      </header>

      <div class="bench">
        <form class="knobs ui-form" id="spec-knobs">
          <Range
            label="Hue"
            name="--ui-palette-hue"
            min={0}
            max={360}
            step={1}
            value={240}
            valueSuffix="°"
          />
          <Range
            label="Chroma"
            name="--ui-palette-chroma"
            min={0}
            max={1}
            step={0.05}
            value={0.6}
          />
          <div class="knob-radius">
            <span class="ui-label" id="spec-radius-label">Radius</span>
            <ToggleGroup
              aria-labelledby="spec-radius-label"
              name="spec-radius"
              size="small"
            >
              {
                RADIUS_OPTIONS.map((option) => (
                  <ToggleButton
                    checked={option.value === "var(--size-2)"}
                    value={option.value}
                  >
                    {option.text}
                  </ToggleButton>
                ))
              }
            </ToggleGroup>
          </div>
          <p class="knob-note">
            The same knobs, and about forty more, live in the <a
              class="ui-link"
              href={generatorHref}>theme generator</a
            >. How the tiers fit together is in <a
              class="ui-link"
              href={conceptsHref}>Concepts</a
            >.
          </p>
        </form>

        <div
          class="specimen ui-palette ui-not-rich-text"
          id="spec-specimen"
          style="--ui-palette-hue: 240; --ui-palette-chroma: 0.6"
        >
          <div class="palette-strip" aria-hidden="true">
            {
              steps.map((step) => (
                <span style={`background-color: var(--ui-color-${step})`} />
              ))
            }
          </div>

          <div class="specimen-row">
            <Button variant="filled" color="primary" inert>Filled</Button>
            <Button variant="tonal" color="primary" inert>Tonal</Button>
            <Button variant="outlined" color="primary" inert>Outlined</Button>
          </div>

          <div class="specimen-row">
            <Chip label="Tonal chip" />
            <Chip label="Outlined chip" variant="outlined" />
            <Switch checked inert>Switch</Switch>
            <Checkbox checked inert>Checkbox</Checkbox>
          </div>

          <div class="specimen-row">
            <TextField label="Text field" placeholder="Type here" inert />
          </div>

          <Progress
            variant="filled"
            value={64}
            max={100}
            aria-label="Progress"
          />

          <Callout severity="info" variant="tonal">
            <CalloutIcon />
            <CalloutContent>
              <h3>Scoped, not global</h3>
              This box is a <code>.ui-palette</code> scope. The rest of the page keeps
              its own knobs.
            </CalloutContent>
          </Callout>
        </div>
      </div>
    </section>

    <section class="sheet" aria-labelledby="materials-heading">
      <header class="sheet-header">
        <h2 class="ui-h2" id="materials-heading">What ships in the box</h2>
        <p>
          Install the package or copy the files you need. Either way the CSS is
          layered, so your theme and your overrides win without <code
            >!important</code
          >.
        </p>
      </header>

      <Table class="materials" density="dense">
        <TableHead>
          <TableRow>
            <TableHeaderCell>No.</TableHeaderCell>
            <TableHeaderCell>Item</TableHeaderCell>
            <TableHeaderCell class="materials-qty">Qty</TableHeaderCell>
            <TableHeaderCell>Description</TableHeaderCell>
          </TableRow>
        </TableHead>
        <TableBody>
          {
            materials.map((material, index) => (
              <TableRow>
                <TableCell>{String(index + 1).padStart(2, "0")}</TableCell>
                <TableCell>
                  <a class="ui-link" href={material.href}>
                    {material.item}
                  </a>
                </TableCell>
                <TableCell class="materials-qty">{material.qty}</TableCell>
                <TableCell>{material.note}</TableCell>
              </TableRow>
            ))
          }
        </TableBody>
      </Table>

      <div class="hero-ctas">
        <Button href={quickstartHref} variant="filled" color="primary">
          Start drafting
        </Button>
        <Button href={generatorHref} variant="outlined" color="primary">
          Theme generator
        </Button>
      </div>
    </section>
  </main>

  <ChipRain />
</Default>

<script>
  import { FRAMEWORK_STORAGE_KEY } from "../utils/framework"

  // Clicking a framework chip in the hero tints the hero with that
  // framework's brand color before navigating. The hero is a palette scope,
  // so the rest of the site keeps the theme.
  const hero = document.querySelector<HTMLElement>(".hero")
  document
    .querySelectorAll<HTMLElement>(".framework-support [data-hero-knobs]")
    .forEach((chip) => {
      chip.addEventListener("click", () => {
        const framework = chip.dataset.framework
        if (framework) {
          try {
            localStorage.setItem(FRAMEWORK_STORAGE_KEY, framework)
          } catch (_) {
            // private mode / storage disabled - non-fatal
          }
        }
        hero?.setAttribute("style", chip.dataset.heroKnobs ?? "")
      })
    })

  const subject = document.querySelector<HTMLElement>(".drawing .ui-button")
  const outputs = document.querySelectorAll<HTMLOutputElement>(
    ".drawing output[data-prop]",
  )

  function measure() {
    if (!subject) return
    const style = getComputedStyle(subject)
    outputs.forEach((output) => {
      const prop = output.dataset.prop
      if (!prop) return
      const value = style.getPropertyValue(prop).trim()
      output.textContent =
        prop === "border-radius" ? value.split(" ")[0] : value
    })
  }

  measure()
  document.addEventListener("theme:change", measure)
  new MutationObserver(measure).observe(document.documentElement, {
    attributeFilter: ["class", "style"],
    attributes: true,
  })

  const knobs = document.querySelector<HTMLFormElement>("#spec-knobs")
  const specimen = document.querySelector<HTMLElement>("#spec-specimen")

  function applyKnobs() {
    if (!knobs || !specimen) return
    const data = new FormData(knobs)
    const hue = data.get("--ui-palette-hue")
    const chroma = data.get("--ui-palette-chroma")
    const radius = data.get("spec-radius")
    if (typeof hue === "string") {
      specimen.style.setProperty("--ui-palette-hue", hue)
    }
    if (typeof chroma === "string") {
      specimen.style.setProperty("--ui-palette-chroma", chroma)
    }
    if (typeof radius === "string") {
      specimen.style.setProperty("--ui-radius", radius)
      specimen.style.setProperty(
        "--ui-radius-small",
        `min(var(--radius-2), ${radius})`,
      )
      specimen.style.setProperty(
        "--ui-radius-x-small",
        `min(var(--radius-1), ${radius})`,
      )
    }
  }

  knobs?.addEventListener("input", applyKnobs)
  knobs?.addEventListener("change", applyKnobs)
  applyKnobs()
</script>

<style is:global>
  @layer theme.base {
    .hero {
      --ui-gray-chroma: 0.025;
      --ui-gray-hue: 250;
      --ui-surface: light-dark(
        oklch(from var(--ui-color-1) 97% c h),
        oklch(from var(--ui-color-15) l calc(c * 1.4) h)
      );
      --ui-surface-filled: light-dark(var(--ui-color-4), var(--ui-color-16));
      --ui-surface-tonal: light-dark(
        var(--ui-color-3),
        oklch(from var(--ui-color-13) l calc(c * 1.3) h)
      );
      --ui-surface-elevated: light-dark(
        oklch(from var(--ui-color-1) 99.5% calc(c * 0.5) h),
        oklch(from var(--ui-color-13) l calc(c * 1.3) h)
      );
      --ui-border-color: light-dark(var(--ui-color-4), var(--ui-color-11));
    }
  }

  html,
  .hero {
    --blueprint-ink: light-dark(var(--ui-color-11), var(--ui-color-5));
    --blueprint-ink-strong: light-dark(var(--ui-color-13), var(--ui-color-2));
    --blueprint-line-major: light-dark(
      oklch(from var(--ui-color-9) l c h / 18%),
      oklch(from var(--ui-color-5) l c h / 16%)
    );
    --blueprint-line-strong: light-dark(
      oklch(from var(--ui-color-9) l c h / 55%),
      oklch(from var(--ui-color-5) l c h / 50%)
    );
  }

  html {
    &::before {
      background-image: radial-gradient(
        var(--ui-text) 1.45px,
        transparent 1.45px
      );
      background-size: 20px 20px;
      content: "";
      inset: 0;
      opacity: 0.05;
      pointer-events: none;
      position: fixed;
      z-index: -1;
    }

    &::after {
      background: radial-gradient(
        120% 80% at 50% 0%,
        transparent 40%,
        light-dark(oklch(0 0 0 / 4%), oklch(0 0 0 / 35%))
      );
      content: "";
      inset: 0;
      pointer-events: none;
      position: fixed;
      z-index: -1;
    }
  }

  .blueprint {
    .component-showcase {
      gap: var(--size-4);
      margin-block: var(--size-6) 0;
    }

    .showcase-card {
      background-color: var(--ui-surface-elevated);
      border: 1px solid var(--blueprint-line-strong);
      border-radius: var(--radius-1);
      box-shadow: light-dark(none, var(--ui-shadow-elevated));

      &::before {
        display: none;
      }

      &::after {
        block-size: var(--size-3);
        border-block-start: 1px solid var(--blueprint-line-strong);
        border-inline-end: 1px solid var(--blueprint-line-strong);
        content: "";
        inline-size: var(--size-3);
        inset: -1px -1px auto auto;
        pointer-events: none;
        position: absolute;
        translate: var(--size-1) calc(-1 * var(--size-1));
      }

      &:hover {
        border-color: var(--blueprint-ink);
      }
    }

    .showcase-link {
      border-color: var(--blueprint-line-strong);
    }
  }
</style>

<style>
  :is(h1, h2, p) {
    text-wrap: pretty;
  }

  #main-content {
    display: grid;
    gap: var(--size-4);
    padding-block: var(--size-4) var(--size-8);

    @media (width >= 900px) {
      gap: var(--size-8);
    }
  }

  .sheet {
    padding-block: var(--size-5);
    position: relative;

    & + .sheet {
      border-block-start: 1px solid var(--blueprint-line-major);
      padding-block-start: var(--size-8);
    }

    @media (width >= 900px) {
      background-color: light-dark(
        oklch(from var(--ui-surface) l c h / 60%),
        oklch(from var(--ui-surface) l c h / 50%)
      );
      border: 1px solid var(--blueprint-line-strong);
      border-radius: var(--radius-1);
      outline: 1px solid var(--blueprint-line-major);
      outline-offset: 5px;
      padding: var(--size-9) var(--size-9) var(--size-8);

      & + .sheet {
        border-block-start-color: var(--blueprint-line-strong);
        padding-block-start: var(--size-9);
      }
    }
  }

  .sheet-header {
    display: grid;
    gap: var(--size-3);
    margin-block-end: var(--size-6);
    max-inline-size: 60ch;

    h2 {
      margin: 0;
    }

    p {
      margin: 0;
    }

    code {
      font-size: 0.9em;
    }
  }

  /* Hero */
  .hero {
    align-items: start;
    display: grid;
    gap: var(--size-8);

    @media (width >= 900px) {
      gap: var(--size-10);
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
      padding-block-end: calc(var(--size-9) + var(--size-6));
    }
  }

  .hero-version {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-2);

    .ui-chip {
      letter-spacing: normal;
      text-transform: none;
    }
  }

  .hero-description {
    font-size: var(--font-size-2);
    line-height: var(--font-lineheight-4);
    text-wrap: balance;
  }

  .hero-lede {
    color: var(--ui-text);
    margin-block-start: var(--size-4);
    max-inline-size: 48ch;
  }

  .hero-ctas {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    margin-block-start: var(--size-7);
  }

  .framework-support {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
    margin-block-start: var(--size-5);

    & :global(.astro-logo) {
      color: currentColor;
    }
  }

  /* Title block, the bottom corner of the sheet like on a drawing */
  .title-block {
    border: 1px solid var(--blueprint-line-strong);
    display: none;
    font-size: var(--ui-font-size-caption);
    grid-template-columns: repeat(6, auto);
    inset-block-end: -1px;
    inset-inline-end: -1px;
    margin: 0;
    position: absolute;

    @media (width >= 900px) {
      display: grid;
    }

    > div {
      border: 1px solid var(--blueprint-line-strong);
      display: grid;
      gap: var(--size-1);
      margin: -1px 0 0 -1px;
      padding: var(--size-1) var(--size-3);
    }

    dt {
      color: var(--blueprint-ink);
      font-size: var(--ui-font-size-caption);
    }

    dd {
      color: var(--ui-text-strong);
      font-weight: var(--ui-font-weight-semibold);
      margin: 0;
      white-space: nowrap;
    }
  }

  /* Drawing, a button with dimension lines */
  .drawing {
    display: grid;
    gap: var(--size-4);
    justify-items: stretch;
    margin: 0;
  }

  .drawing-stage {
    align-items: center;
    container-type: inline-size;
    display: flex;
    justify-content: center;
    min-block-size: 22rem;
    position: relative;
  }

  .drawing-subject {
    zoom: 1.75;

    .ui-button {
      anchor-name: --drawing-subject;
      white-space: nowrap;
    }
  }

  .dimension,
  .leader {
    color: var(--blueprint-ink);
    pointer-events: none;
    position: absolute;
    position-anchor: --drawing-subject;
  }

  .dimension-height {
    border-inline-start: 1px solid currentColor;
    inset-block: anchor(top) anchor(bottom);
    inset-inline-start: calc(anchor(right) + var(--size-4));

    &::before,
    &::after {
      border-block-start: 1px solid currentColor;
      content: "";
      inline-size: var(--size-3);
      inset-inline-start: calc(-1 * var(--size-3) / 2 - 0.5px);
      position: absolute;
    }

    &::before {
      inset-block-start: 0;
    }

    &::after {
      inset-block-end: 0;
    }
  }

  .leader {
    border-block-start: 1px solid currentColor;
    inline-size: var(--leader-length, 5rem);
    rotate: var(--leader-angle, 0deg);
    transform-origin: 0 0;

    &::before {
      background-color: currentColor;
      block-size: 5px;
      border-radius: var(--radius-round);
      content: "";
      inline-size: 5px;
      inset-block-start: -3px;
      inset-inline-start: -2px;
      position: absolute;
    }
  }

