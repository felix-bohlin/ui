---
import Blog from "../../layouts/Blog.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Accordion,
  Button,
  Card,
  Chip,
  FieldLegend,
  FieldSet,
  Select,
  ToggleButton,
  ToggleGroup,
} from "@opui/astro"
import { computeFeatureSupport } from "../../utils/browser-support"
import {
  categories,
  componentName,
  formatDate,
  formatMonth,
  levels,
  posts,
  readingMinutes,
  readingTimes,
  series,
  topics,
} from "../../utils/blog"

const STATUS = {
  high: "Widely available",
  limited: "Limited availability",
  low: "Newly available",
}
const STATUS_ORDER = ["limited", "low", "high"] as const

const buildCount = Object.keys(
  import.meta.glob("../../components/UnderTheHood/*Build.astro"),
).length

const labelOf = (list: { id: string; label: string }[], id: string) =>
  list.find((entry) => entry.id === id)?.label ?? id

const entries = posts
  .toSorted(
    (a, b) =>
      Number(!!a.component) - Number(!!b.component) ||
      (a.component ?? "").localeCompare(b.component ?? ""),
  )
  .map((post) => {
    const features = (post.features ?? []).map((id) => {
      const entry = computeFeatureSupport(id)
      return {
        id,
        name: entry.name,
        status: (entry.baseline || "limited") as keyof typeof STATUS,
      }
    })
    const minutes = readingMinutes(post.slug)
    const inSeries = series.find((entry) => entry.posts.includes(post.slug))
    return {
      ...post,
      author: "author" in post ? String(post.author) : undefined,
      baseline: features.length
        ? STATUS_ORDER.find((status) =>
            features.some((feature) => feature.status === status),
          )
        : undefined,
      features,
      minutes,
      month: post.date.slice(0, 7),
      reading: readingTimes.find((entry) => minutes <= entry.max)!.id,
      series: inSeries && {
        id: inSeries.id,
        label: inSeries.label,
        part: inSeries.posts.indexOf(post.slug) + 1,
        total: inSeries.posts.length,
      },
    }
  })

const present = (values: (string | undefined)[]) =>
  [...new Set(values.filter((value): value is string => !!value))].sort()

const featureOptions = [
  ...new Map(
    entries.flatMap((post) =>
      post.features.map((feature) => [feature.id, feature.name] as const),
    ),
  ),
]
  .map(([id, label]) => ({ id, label }))
  .toSorted((a, b) => a.label.localeCompare(b.label))

const filters = [
  {
    attr: "topic",
    control: "select",
    label: "Topic",
    options: topics.filter((topic) =>
      entries.some((post) => post.topics?.includes(topic.id)),
    ),
  },
  {
    attr: "feature",
    control: "select",
    label: "Platform feature",
    options: featureOptions,
  },
  {
    attr: "series",
    control: "select",
    label: "Series",
    options: series.map(({ id, label }) => ({ id, label })),
  },
  {
    attr: "month",
    control: "select",
    label: "Archive",
    options: present(entries.map((post) => post.month)).map((month) => ({
      id: month,
      label: formatMonth(`${month}-01`),
    })),
  },
  {
    attr: "author",
    control: "select",
    label: "Author",
    options: present(entries.map((post) => post.author)).map((author) => ({
      id: author.toLowerCase().replaceAll(" ", "-"),
      label: author,
    })),
  },
  { attr: "level", control: "toggle", label: "Level", options: levels },
  {
    attr: "baseline",
    control: "toggle",
    label: "Browser support",
    options: (["high", "low", "limited"] as const).map((status) => ({
      id: status,
      label: STATUS[status],
    })),
  },
  {
    attr: "reading",
    control: "toggle",
    label: "Reading time",
    options: readingTimes.map(({ id, label }) => ({ id, label })),
  },
].filter((filter) => filter.options.length > 1)

const hide = (checked: string, attr: string, id: string) =>
  `.blog:has(${checked}) .blog-post:not([data-${attr}~="${id}"]) { display: none; }`

const filterCss = [
  ...categories.flatMap((category) => [
    hide(
      `input[name="category"][value="${category.id}"]:checked`,
      "category",
      category.id,
    ),
    ...(posts.some(
      (post) => post.category === category.id && post.features?.length,
    )
      ? []
      : [
          `.blog:has(input[name="category"][value="${category.id}"]:checked) .blog-legend { display: none; }`,
        ]),
  ]),
  ...filters.flatMap((filter) =>
    filter.options.map((option) =>
      hide(
        filter.control === "select"
          ? `select[name="${filter.attr}"] option[value="${option.id}"]:checked`
          : `input[name="${filter.attr}"][value="${option.id}"]:checked`,
        filter.attr,
        option.id,
      ),
    ),
  ),
].join("\n")
---

<Blog showToc={false}>
  <Fragment slot="title">Blog</Fragment>
  <Fragment slot="preamble">
    Updates, and short posts on the HTML and CSS behind each component.
  </Fragment>

  <div class="blog ui-not-rich-text">
    <form aria-label="Filter posts" class="blog-filters">
      <div class="blog-filters-row">
        <ToggleGroup
          aria-label="Category"
          name="category"
          selection="single"
          size="small"
        >
          <ToggleButton checked value="all">All</ToggleButton>
          {
            categories.map((category) => (
              <ToggleButton value={category.id}>{category.label}</ToggleButton>
            ))
          }
        </ToggleGroup>
        <Button size="small" type="reset">Clear filters</Button>
      </div>

      <Accordion variant="outlined">
        <Fragment slot="summary">More filters</Fragment>
        <div class="blog-filters-grid">
          {
            filters.map((filter) =>
              filter.control === "select" ? (
                <Select
                  items={[
                    { text: "Any", value: "" },
                    ...filter.options.map((option) => ({
                      text: option.label,
                      value: option.id,
                    })),
                  ]}
                  label={filter.label}
                  name={filter.attr}
                  size="small"
                />
              ) : (
                <FieldSet class="blog-filter-toggles">
                  <FieldLegend>{filter.label}</FieldLegend>
                  <ToggleGroup
                    name={filter.attr}
                    selection="single"
                    size="small"
                  >
                    <ToggleButton checked value="any">
                      Any
                    </ToggleButton>
                    {filter.options.map((option) => (
                      <ToggleButton value={option.id}>
                        {option.label}
                      </ToggleButton>
                    ))}
                  </ToggleGroup>
                </FieldSet>
              ),
            )
          }
        </div>
      </Accordion>
    </form>

    <ul class="blog-posts">
      {
        entries.map((post) => (
          <li
            class:list={[
              "blog-post",
              { "blog-post-featured": !post.component },
            ]}
            data-author={post.author?.toLowerCase().replaceAll(" ", "-")}
            data-baseline={post.baseline}
            data-category={post.category}
            data-feature={post.features.map((feature) => feature.id).join(" ")}
            data-level={post.level}
            data-month={post.month}
            data-reading={post.reading}
            data-series={post.series?.id}
            data-topic={post.topics?.join(" ")}
          >
            <Card variant={post.component ? "outlined" : "tonal"}>
              <Fragment slot="header">
                <p>
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                </p>
                <h2>
                  <DocLink href={`/blog/${post.slug}`}>{post.title}</DocLink>
                </h2>
                <p>{post.description}</p>
              </Fragment>
              <Fragment slot="content">
                <ul aria-label="Tags" class="blog-tags">
                  <li>
                    <Chip size="small">
                      {labelOf(categories, post.category)}
                    </Chip>
                  </li>
                  {post.component && (
                    <li>
                      <Chip size="small" variant="outlined">
                        {componentName(post.component)}
                      </Chip>
                    </li>
                  )}
                  {post.series && (
                    <li>
                      <Chip size="small" variant="outlined">
                        {post.series.label} · {post.series.part}/
                        {post.series.total}
                      </Chip>
                    </li>
                  )}
                </ul>
                {post.features.length > 0 && (
                  <ul aria-label="Features" class="blog-features">
                    {post.features.map((feature) => (
                      <li>
                        <Chip
                          data-status={feature.status}
                          size="small"
                          variant="outlined"
                        >
                          {feature.name}
                          <span class="ui-sr-only">
                            , {STATUS[feature.status]}
                          </span>
                        </Chip>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="blog-meta">
                  {[
                    `${post.minutes} min read`,
                    post.level && labelOf(levels, post.level),
                    post.topics
                      ?.map((topic) => labelOf(topics, topic))
                      .join(", "),
                    post.slug === "under-the-hood" &&
                      `${buildCount} interactive build-ups`,
                  ]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              </Fragment>
            </Card>
          </li>
        ))
      }
    </ul>

    <p class="blog-count" aria-hidden="true"></p>

    <ul aria-label="Browser support" class="blog-legend">
      {
        (["high", "low", "limited"] as const).map((status) => (
          <li data-status={status}>{STATUS[status]}</li>
        ))
      }
    </ul>
  </div>
</Blog>

<style is:inline set:html={filterCss}></style>

<style>
  .blog {
    counter-reset: posts;
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .blog-filters {
    display: grid;
    gap: var(--size-3);
    order: -2;
  }

  .blog-filters-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: space-between;
  }

  .blog-filters-grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }

  .blog-filter-toggles {
    grid-column: 1 / -1;

    & legend {
      font-size: var(--field-label-font-size);
      margin-block-end: var(--size-1);
    }
  }

  .blog-count {
    color: var(--text-muted);
    font-size: var(--font-size-0);
    margin: 0;
    order: -1;

    &::before {
      content: "Posts: " counter(posts);
    }
  }

  .blog-posts {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-post {
    counter-increment: posts;
    display: grid;

    & .ui-card {
      position: relative;
      transition: border-color 0.2s;

      &:has(a:hover) {
        border-color: var(--primary);
      }

      &:has(a:focus-visible) {
        outline: var(--focus-ring-width, 2px) solid
          var(--focus-ring-color, var(--primary));
        outline-offset: 2px;
      }
    }

    & .ui-content {
      display: grid;
      gap: var(--size-2);
    }

    & h2 {
      font-size: var(--font-size-3);
      line-height: 1.25;
    }

    & a {
      color: inherit;
      text-decoration: none;

      &::after {
        content: "";
        inset: 0;
        position: absolute;
      }

      &:focus-visible {
        outline: none;
      }
    }
  }

  .blog-post-featured {
    grid-column: 1 / -1;

    & h2 {
      font-size: var(--font-size-5);
    }
  }

  .blog-tags,
  .blog-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-meta {
    color: var(--text-muted);
    font-size: var(--font-size-0);
    margin: auto 0 0;
  }

  [data-status] {
    &::before {
      background-color: var(--_status-color);
      block-size: 0.5rem;
      border-radius: var(--radius-round);
      content: "";
      flex-shrink: 0;
      inline-size: 0.5rem;
    }

    &[data-status="high"] {
      --_status-color: var(--text-ok, #2e7d32);
    }

    &[data-status="low"] {
      --_status-color: var(--text-info, #1565c0);
    }

    &[data-status="limited"] {
      --_status-color: var(--text-warning, #ed6c02);
    }
  }

  .blog-legend {
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--font-size-0);
    gap: var(--size-1) var(--size-4);
    list-style: none;
    margin: 0;
    padding: 0;

    & li {
      align-items: center;
      display: inline-flex;
      gap: var(--size-2);
    }
  }
</style>
