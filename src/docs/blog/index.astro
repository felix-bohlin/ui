---
import Blog from "../../layouts/Blog.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Accordion,
  Button,
  FieldLegend,
  FieldSet,
  Select,
  ToggleButton,
  ToggleGroup,
} from "@opui/astro"
import { computeFeatureSupport } from "../../utils/browser-support"
import {
  categories,
  componentName,
  excerpt,
  formatDate,
  formatMonth,
  levels,
  posts,
  readingMinutes,
  readingTimes,
  series,
  topics,
} from "../../utils/blog"

const STATUS = {
  high: "Widely available",
  limited: "Limited availability",
  low: "Newly available",
}
const STATUS_ORDER = ["limited", "low", "high"] as const

const icons = {
  buildUps:
    "M1 3.5C1 2.67 1.67 2 2.5 2h7c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5h-7A1.5 1.5 0 0 1 1 8.5zM2.5 3a.5.5 0 0 0-.5.5v5c0 .28.22.5.5.5h7a.5.5 0 0 0 .5-.5v-5a.5.5 0 0 0-.5-.5zm2.58 10c.21.58.77 1 1.42 1h3A5.5 5.5 0 0 0 15 8.5v-1c0-.65-.42-1.2-1-1.41V8.5A4.5 4.5 0 0 1 9.5 13zm-.58-1a1.5 1.5 0 0 1-1.42-1H9.5A2.5 2.5 0 0 0 12 8.5V4.09c.58.2 1 .76 1 1.41v3A3.5 3.5 0 0 1 9.5 12z",
  level:
    "M14 3.5a1.5 1.5 0 0 0-3 0v9a1.5 1.5 0 0 0 3 0zM12.5 3c.28 0 .5.22.5.5v9a.5.5 0 0 1-1 0v-9c0-.28.22-.5.5-.5M10 6.5a1.5 1.5 0 1 0-3 0v6a1.5 1.5 0 0 0 3 0zM8.5 6c.28 0 .5.22.5.5v6a.5.5 0 0 1-1 0v-6c0-.28.22-.5.5-.5m-4 2C5.33 8 6 8.67 6 9.5v3a1.5 1.5 0 0 1-3 0v-3C3 8.67 3.67 8 4.5 8M5 9.5a.5.5 0 0 0-1 0v3a.5.5 0 0 0 1 0z",
  readingTime:
    "M2 8a6 6 0 1 1 12 0A6 6 0 0 1 2 8m6-7a7 7 0 1 0 0 14A7 7 0 0 0 8 1m0 3.5a.5.5 0 0 0-1 0v4c0 .28.22.5.5.5h3a.5.5 0 0 0 0-1H8z",
  topics:
    "M11 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-8.41 4.14a2 2 0 0 1 0-2.83L7.33 2.6c.37-.37.88-.58 1.4-.59L12 2A2 2 0 0 1 14 4l-.02 3.37c0 .53-.22 1.03-.6 1.4l-4.66 4.65c-.78.77-2.05.77-2.84 0zm.7-2.12a1 1 0 0 0 0 1.41l3.3 3.28a1 1 0 0 0 1.42 0l4.67-4.65a1 1 0 0 0 .3-.7L13 4a1 1 0 0 0-1-1L8.73 3a1 1 0 0 0-.7.3z",
}

const buildCount = Object.keys(
  import.meta.glob("../../components/UnderTheHood/*Build.astro"),
).length

const labelOf = (list: { id: string; label: string }[], id: string) =>
  list.find((entry) => entry.id === id)?.label ?? id

const entries = posts
  .toSorted(
    (a, b) =>
      Number(!!a.component) - Number(!!b.component) ||
      (a.component ?? "").localeCompare(b.component ?? ""),
  )
  .map((post, index) => {
    const features = (post.features ?? []).map((id) => {
      const entry = computeFeatureSupport(id)
      return {
        id,
        name: entry.name,
        status: (entry.baseline || "limited") as keyof typeof STATUS,
      }
    })
    const minutes = readingMinutes(post.slug)
    const inSeries = series.find((entry) => entry.posts.includes(post.slug))
    return {
      ...post,
      baseline: features.length
        ? STATUS_ORDER.find((status) =>
            features.some((feature) => feature.status === status),
          )
        : undefined,
      excerpt: index < 3 ? excerpt(post.slug) : undefined,
      features,
      minutes,
      month: post.date.slice(0, 7),
      reading: readingTimes.find((entry) => minutes <= entry.max)!.id,
      series: inSeries && {
        id: inSeries.id,
        label: inSeries.label,
        part: inSeries.posts.indexOf(post.slug) + 1,
        total: inSeries.posts.length,
      },
    }
  })

const present = (values: (string | undefined)[]) =>
  [...new Set(values.filter((value): value is string => !!value))].sort()

const inputId = (attr: string, id: string) => `filter-${attr}-${id}`

const featureOptions = [
  ...new Map(
    entries.flatMap((post) =>
      post.features.map((feature) => [feature.id, feature.name] as const),
    ),
  ),
]
  .map(([id, label]) => ({ id, label }))
  .toSorted((a, b) => a.label.localeCompare(b.label))

const filters = [
  {
    attr: "topic",
    control: "select",
    label: "Topic",
    options: topics.filter((topic) =>
      entries.some((post) => post.topics?.includes(topic.id)),
    ),
  },
  {
    attr: "month",
    control: "select",
    label: "Archive",
    options: present(entries.map((post) => post.month)).map((month) => ({
      id: month,
      label: formatMonth(`${month}-01`),
    })),
  },

  {
    attr: "component",
    control: "chips",
    label: "Component",
    options: present(entries.map((post) => post.component)).map((id) => ({
      id,
      label: componentName(id),
    })),
  },
  {
    attr: "feature",
    control: "chips",
    label: "Platform feature",
    options: featureOptions,
  },
  {
    attr: "series",
    control: "toggle",
    label: "Series",
    options: series.map(({ id, label }) => ({ id, label })),
  },
  { attr: "level", control: "toggle", label: "Level", options: levels },
  {
    attr: "baseline",
    control: "toggle",
    label: "Browser support",
    options: (["high", "low", "limited"] as const).map((status) => ({
      id: status,
      label: STATUS[status],
    })),
  },
  {
    attr: "reading",
    control: "toggle",
    label: "Reading time",
    options: readingTimes.map(({ id, label }) => ({ id, label })),
  },
].filter((filter) => filter.options.length > 0)

const chipFilters = filters.filter((filter) =>
  ["component", "feature", "series"].includes(filter.attr),
)

const hide = (checked: string, attr: string, id: string) =>
  `.blog:has(${checked}) .blog-post:not([data-${attr}~="${id}"]) { display: none; }`

const filterCss = [
  ...categories.map((category) =>
    hide(
      `#${inputId("category", category.id)}:checked`,
      "category",
      category.id,
    ),
  ),
  ...filters.flatMap((filter) =>
    filter.options.map((option) =>
      hide(
        filter.control === "select"
          ? `select[name="${filter.attr}"] option[value="${option.id}"]:checked`
          : `#${inputId(filter.attr, option.id)}:checked`,
        filter.attr,
        option.id,
      ),
    ),
  ),
  ...[
    ...categories.map((category) => inputId("category", category.id)),
    ...chipFilters.flatMap((filter) =>
      filter.options.map((option) => inputId(filter.attr, option.id)),
    ),
  ].flatMap((id) => [
    `.blog:has(#${id}:checked) label.blog-chip[for="${id}"] { --_bg-color: var(--primary); --_border-color: var(--primary); --_color: var(--primary-contrast); }`,
    `.blog:has(#${id}:checked) .blog-active [data-for="${id}"] { display: inline-flex; }`,
  ]),
].join("\n")
---

<Blog
  description="Updates, and short posts on the HTML and CSS behind each component."
  overline=""
  showToc={false}
  wide
>
  <Fragment slot="title">Blog</Fragment>

  <div class="blog ui-not-rich-text">
    <form aria-label="Filter posts" class="blog-filters">
      <div class="blog-filters-row">
        <ToggleGroup
          aria-label="Category"
          name="category"
          selection="single"
          size="small"
        >
          <ToggleButton checked id={inputId("category", "all")} value="all">
            All
          </ToggleButton>
          {
            categories.map((category) => (
              <ToggleButton
                id={inputId("category", category.id)}
                value={category.id}
              >
                {category.label}
              </ToggleButton>
            ))
          }
        </ToggleGroup>
        <Button size="small" type="reset">Clear filters</Button>
      </div>

      <Accordion variant="outlined">
        <Fragment slot="summary">More filters</Fragment>
        <div class="blog-filters-grid">
          {
            filters.map((filter) =>
              filter.control === "select" ? (
                <Select
                  items={[
                    { text: "Any", value: "" },
                    ...filter.options.map((option) => ({
                      text: option.label,
                      value: option.id,
                    })),
                  ]}
                  label={filter.label}
                  name={filter.attr}
                  size="small"
                />
              ) : filter.control === "chips" ? (
                <FieldSet class="blog-filter-group">
                  <FieldLegend>{filter.label}</FieldLegend>
                  <div class="blog-chip-cloud">
                    {[{ id: "any", label: "Any" }, ...filter.options].map(
                      (option) => (
                        <label class="ui-chip ui-small ui-outlined">
                          <input
                            checked={option.id === "any"}
                            class="ui-sr-only"
                            id={inputId(filter.attr, option.id)}
                            name={filter.attr}
                            type="radio"
                            value={option.id}
                          />
                          {option.label}
                        </label>
                      ),
                    )}
                  </div>
                </FieldSet>
              ) : (
                <FieldSet class="blog-filter-group">
                  <FieldLegend>{filter.label}</FieldLegend>
                  <ToggleGroup
                    name={filter.attr}
                    selection="single"
                    size="small"
                  >
                    <ToggleButton
                      checked
                      id={inputId(filter.attr, "any")}
                      value="any"
                    >
                      Any
                    </ToggleButton>
                    {filter.options.map((option) => (
                      <ToggleButton
                        id={inputId(filter.attr, option.id)}
                        value={option.id}
                      >
                        {option.label}
                      </ToggleButton>
                    ))}
                  </ToggleGroup>
                </FieldSet>
              ),
            )
          }
        </div>
      </Accordion>
    </form>

    <ul aria-label="Active filters" class="blog-active">
      {
        chipFilters.flatMap((filter) =>
          filter.options.map((option) => (
            <li data-for={inputId(filter.attr, option.id)}>
              <label
                class="ui-chip ui-small ui-tonal"
                for={inputId(filter.attr, "any")}
              >
                {option.label}
                <span class="ui-sr-only">, remove filter</span>
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
              </label>
            </li>
          )),
        )
      }
    </ul>

    <ul class="blog-posts">
      {
        entries.map((post) => (
          <li
            class:list={[
              "blog-post",
              { "blog-post-featured": !post.component },
            ]}
            data-baseline={post.baseline}
            data-category={post.category}
            data-component={post.component}
            data-feature={post.features.map((feature) => feature.id).join(" ")}
            data-level={post.level}
            data-month={post.month}
            data-reading={post.reading}
            data-series={post.series?.id}
            data-topic={post.topics?.join(" ")}
          >
            <article
              class:list={[
                "ui-card",
                post.component ? "ui-outlined" : "ui-tonal",
              ]}
            >
              <hgroup>
                <p style={`view-transition-name: blog-${post.slug}-date`}>
                  <time datetime={post.date}>{formatDate(post.date)}</time>
                </p>
                <h2 style={`view-transition-name: blog-${post.slug}-title`}>
                  <DocLink href={`/blog/${post.slug}`}>{post.title}</DocLink>
                </h2>
                <p>{post.description}</p>
              </hgroup>
              <div class="ui-content">
                {post.excerpt && (
                  <div class="blog-excerpt">
                    <p>{post.excerpt}</p>
                    <span
                      aria-hidden="true"
                      class="ui-button ui-small ui-outlined"
                    >
                      Read more
                    </span>
                  </div>
                )}
                <ul aria-label="Tags" class="blog-chips">
                  <li>
                    <label
                      class="blog-chip ui-chip ui-small ui-tonal"
                      for={inputId("category", post.category)}
                    >
                      {labelOf(categories, post.category)}
                    </label>
                  </li>
                  {post.component && (
                    <li>
                      <label
                        class="blog-chip ui-chip ui-small ui-outlined"
                        for={inputId("component", post.component)}
                      >
                        {componentName(post.component)}
                      </label>
                    </li>
                  )}
                  {post.series && (
                    <li>
                      <label
                        class="blog-chip ui-chip ui-small ui-outlined"
                        for={inputId("series", post.series.id)}
                      >
                        {post.series.label}
                        <span class="blog-chip-part">
                          {post.series.part}/{post.series.total}
                        </span>
                      </label>
                    </li>
                  )}
                  {post.features.map((feature) => (
                    <li>
                      <label
                        class="blog-chip ui-chip ui-small ui-outlined"
                        for={inputId("feature", feature.id)}
                      >
                        {feature.name}
                      </label>
                    </li>
                  ))}
                </ul>
                <dl class="blog-meta">
                  {[
                    {
                      icon: icons.readingTime,
                      label: "Reading time",
                      value: `${post.minutes} min`,
                    },
                    post.level && {
                      icon: icons.level,
                      label: "Level",
                      value: labelOf(levels, post.level),
                    },
                    post.topics && {
                      icon: icons.topics,
                      label: "Topics",
                      value: post.topics
                        .map((topic) => labelOf(topics, topic))
                        .join(", "),
                    },
                    post.slug === "under-the-hood" && {
                      icon: icons.buildUps,
                      label: "Build-ups",
                      value: `${buildCount} build-ups`,
                    },
                  ]
                    .filter((item) => !!item)
                    .map((item) => (
                      <div>
                        <dt>
                          <svg aria-hidden="true" viewBox="0 0 16 16">
                            <path d={item.icon} />
                          </svg>
                          <span class="ui-sr-only">{item.label}</span>
                        </dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                </dl>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="blog-count" aria-hidden="true"></p>
  </div>
</Blog>

<style is:inline set:html={filterCss}></style>

<style>
  .blog {
    counter-reset: posts;
    display: flex;
    flex-direction: column;
    gap: var(--size-4);
  }

  .blog-filters {
    display: grid;
    gap: var(--size-3);
    order: -2;
  }

  .blog-filters-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: space-between;
  }

  .blog-filters-grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }

  .blog-filter-group {
    grid-column: 1 / -1;

    & legend {
      font-size: var(--field-label-font-size);
      margin-block-end: var(--size-1);
    }
  }

  .blog-count {
    color: var(--text-muted);
    font-size: var(--font-size-0);
    margin: 0;
    order: -1;

    &::before {
      content: "Posts: " counter(posts);
    }
  }

  .blog-posts {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    @supports (display: grid-lanes) {
      display: grid-lanes;
    }
  }

  .blog-post {
    container-type: inline-size;
    counter-increment: posts;
    display: grid;

    & .ui-card {
      gap: var(--size-3);
      position: relative;
      transition: border-color 0.2s;

      &:has(a:hover) {
        border-color: var(--primary);
      }

      &:has(a:focus-visible) {
        outline: var(--focus-ring-width, 2px) solid
          var(--focus-ring-color, var(--primary));
        outline-offset: 2px;
      }
    }

    & hgroup {
      display: grid;
      gap: var(--size-1);

      & > * {
        margin: 0;
      }

      & > p:first-child,
      & > h2 {
        inline-size: fit-content;
        view-transition-class: doc-heading;
      }

      & > p:first-child {
        color: var(--text-muted);
        font-size: var(--font-size-0);
        line-height: 1.3;
      }

      & > p:last-child {
        color: var(--text-muted);
        font-size: clamp(0.8125rem, 0.75rem + 0.6cqi, 0.9375rem);
        line-height: 1.45;
        text-wrap: pretty;
      }
    }

    & h2 {
      color: var(--text-primary);
      font-size: clamp(1rem, 0.8rem + 2.5cqi, 1.25rem);
      letter-spacing: -0.01em;
      line-height: 1.2;
      text-wrap: balance;
    }

    & .ui-content {
      display: grid;
      gap: var(--size-3);
    }

    & h2 a {
      color: inherit;
      text-decoration: none;

      &::after {
        content: "";
        inset: 0;
        position: absolute;
      }

      &:focus-visible {
        outline: none;
      }
    }
  }

  .blog-post-featured {
    grid-column: 1 / -1;

    & h2 {
      font-size: clamp(1.25rem, 0.75rem + 2.5cqi, 1.875rem);
    }

    & hgroup > p:last-child {
      max-inline-size: 65ch;
    }
  }

  .blog-excerpt {
    display: grid;
    gap: var(--size-3);
    justify-items: start;

    & p {
      -webkit-box-orient: vertical;
      display: -webkit-box;
      line-clamp: 4;
      -webkit-line-clamp: 4;
      line-height: 1.5;
      margin: 0;
      max-inline-size: 75ch;
      overflow: hidden;
      text-wrap: pretty;
    }
  }

  .blog-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-chip-part {
    opacity: 0.7;
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--font-size-0);
    gap: var(--size-1) var(--size-4);
    line-height: 1.3;
    margin: 0;

    & div {
      align-items: center;
      display: flex;
      gap: var(--size-1);
    }

    & dt {
      color: var(--text-muted);
      display: flex;
    }

    & svg {
      block-size: 1rem;
      fill: currentColor;
      inline-size: 1rem;
    }

    & dd {
      font-weight: 600;
      margin: 0;
    }
  }

  .blog-chip-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);

    & label {
      cursor: pointer;

      &:has(:checked) {
        --_bg-color: var(--primary);
        --_border-color: var(--primary);
        --_color: var(--primary-contrast);
      }

      &:has(:focus-visible) {
        outline: var(--focus-ring-width, 2px) solid
          var(--focus-ring-color, var(--primary));
        outline-offset: 2px;
      }
    }
  }

  .blog-chip {
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .blog-active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1);
    list-style: none;
    margin: 0;
    order: -1;
    padding: 0;

    & li {
      display: none;
    }

    & label {
      cursor: pointer;
    }

    & svg {
      block-size: 1em;
      fill: none;
      inline-size: 1em;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 2;
    }
  }
</style>
