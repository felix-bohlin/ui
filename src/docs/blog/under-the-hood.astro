---
import Blog from "../../layouts/Blog.astro"
import DocLink from "../../components/DocLink.astro"
import {
  buildPostSlugs,
  componentHref,
  componentName,
  formatDate,
  posts,
} from "../../utils/blog"

const post = posts.find((entry) => entry.slug === "under-the-hood")!

const currentFramework = Astro.locals.framework

const modules = import.meta.glob<{ default: any }>(
  "../../components/UnderTheHood/*Build.astro",
  { eager: true },
)

const builds = Object.entries(modules)
  .map(([path, module]) => {
    const fileName = path.split("/").pop()!.replace("Build.astro", "")
    const buildPost =
      fileName in buildPostSlugs
        ? posts.find((entry) => entry.slug === buildPostSlugs[fileName])
        : undefined
    const slug =
      buildPost?.component ??
      fileName.replace(/(?<!^)([A-Z])/g, "-$1").toLowerCase()
    const name = componentName(slug)
    return {
      Build: module.default,
      docsHref: componentHref(currentFramework, slug),
      heading: buildPost ? `${name}: ${buildPost.title}` : name,
      id: buildPost?.slug ?? slug,
      name,
      post: buildPost ?? posts.find((entry) => entry.component === slug),
    }
  })
  .toSorted((a, b) => a.heading.localeCompare(b.heading))
---

<Blog
  description={post.description}
  overline={formatDate(post.date)}
  title={post.title}
>
  <Fragment slot="title">{post.title}</Fragment>
  <Fragment slot="preamble">{post.description}</Fragment>

  <section id="how-it-works">
    <h2>How it works</h2>
    <ul>
      <li>Pick a step: the demo runs only the CSS up to that step</li>
      <li>The code shown is the code that runs</li>
      <li>Sliders write custom properties on the demo</li>
      <li>Browser support for each new feature, per step</li>
      <li>
        The stepper itself: radio inputs + <code>:has()</code>, no JavaScript
      </li>
    </ul>
  </section>

  {
    builds.map(({ Build, docsHref, heading, id, name, post: buildPost }) => (
      <section id={id}>
        <h2>{heading}</h2>
        <ul class="build-links">
          <li>
            <a href={docsHref}>{name} docs</a>
          </li>
          {buildPost && (
            <li>
              <DocLink href={`/blog/${buildPost.slug}`}>
                {buildPost.title}
              </DocLink>
            </li>
          )}
        </ul>
        <Build />
      </section>
    ))
  }
</Blog>

<style>
  .build-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-1) var(--ui-space-5);
    list-style: none;
    padding: 0;

    & li {
      padding: 0;
    }
  }
</style>
