---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Accordion as UIAccordion,
  AccordionActions as UIAccordionActions,
  AccordionContent as UIAccordionContent,
  AccordionSummary as UIAccordionSummary,
  Button as UIButton,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"

import AccordionCSS from "@opui/css/components/accordion.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import AccordionBuild from "../../components/UnderTheHood/AccordionBuild.astro"

import accordionApi from "../../component-api/accordion/api"
import accordionActionsApi from "../../component-api/accordion-actions/api"
import accordionSummaryApi from "../../component-api/accordion-summary/api"
export const description =
  "Lets you show and hide content, on its own or as a group."

export const keywords = [
  "collapse",
  "details",
  "disclosure",
  "expand",
  "summary",
]
---

<Component
  description={description}
  slug="accordion"
  heroAnatomy
  apis={[
    { title: "Accordion API", api: accordionApi },
    { title: "Accordion summary API", api: accordionSummaryApi },
    { title: "Accordion actions API", api: accordionActionsApi },
  ]}
  browserSupport={[
    "details-content",
    "details-name",
    "dir-pseudo",
    "display-animation",
    "has",
    "interpolate-size",
    "logical-properties",
    "overflow-clip",
    "transition-behavior",
  ]}
  fallbacks={{
    "display-animation":
      "Without display animation, the content hides at once when the accordion closes.",
    "interpolate-size":
      "Without `interpolate-size`, the content doesn't slide: it fades in at full height and hides at once.",
  }}
  changelogPaths={[
    {
      path: "packages/opui/components/Accordion/Accordion.astro",
      type: "component",
    },
    { path: "src/docs/components/accordion.astro", type: "docs" },
    { path: "src/component-examples/accordion", type: "docs" },
    {
      path: "packages/opui/css/components/accordion.css",
      type: "css",
    },
    { path: "src/component-api/accordion", type: "api" },
  ]}
  installationTabs={[
    { title: "accordion.css", code: AccordionCSS, lang: "css" },
    {
      title: "card.css",
      code: CardCSS,
      lang: "css",
      isDependency: true,
    },
  ]}
>
  <Fragment slot="title">Accordion</Fragment>
  <Usage slot="usage">
    <li slot="when">Content most readers skip, like FAQ answers.</li>
    <li slot="when">Long pages readers scan by heading.</li>
    <li slot="when">
      One open at a time: a shared
      <a href="#mutually-exclusive"><code>name</code></a>.
    </li>
    <li slot="when-not">Content everyone needs: show it on the page.</li>
    <li slot="when-not">
      Views of the same content: use
      <DocLink href="/components/tabs">Tabs</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" column />
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Plain by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Plain by default. Use <code>.ui-elevated</code>,
        <code>.ui-outlined</code>, <code>.ui-tonal</code> or
        <code>.ui-transparent</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column />
  </section>

  <section id="accordion-group">
    <h2>Accordion group</h2>
    <p>
      Wrap them in a <PropOrClass prop="Card" class=".ui-card" /> with
      <code>role="group"</code> and an <code>aria-label</code>.
    </p>
    <AutoExample name="Group" column />

    <h3 id="mutually-exclusive">Mutually exclusive</h3>
    <p>Give them the same <code>name</code>.</p>
    <AutoExample name="GroupSingle" column />
  </section>

  <section id="actions">
    <h2>Actions</h2>
    <p>
      Use <PropOrClass prop="AccordionActions" class=".ui-actions" />, with
      <PropOrClass prop='align="start"' class=".ui-align-start" /> to line them
      up with the content.
    </p>
    <AutoExample name="Actions" column />
  </section>

  <section id="custom-marker">
    <h2>Custom marker</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>marker</code>, with <code>.ui-marker</code> on the icon.
      </Fragment>
      <Fragment slot="html"> Replace the <code>svg.ui-marker</code>. </Fragment>
    </Conditional>
    <AutoExample name="CustomMarker" column />
  </section>

  <section id="marker-animation">
    <h2>Marker animation</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Rotates by default. Use <code>markerAnimation</code> to change it, with
        a marker that points to the inline end for <code>turn</code>.
      </Fragment>
      <Fragment slot="html">
        Rotates by default. Use <code>.ui-marker-animation-flip</code>, or
        <code>.ui-marker-animation-turn</code> with a marker that points to the
        inline end.
      </Fragment>
    </Conditional>
    <AutoExample name="MarkerAnimation" column />
  </section>

  <Fragment slot="accessibility">
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIAccordion open variant="outlined">
        <UIAccordionSummary>Accordion title</UIAccordionSummary>
        <UIAccordionContent>
          <p>
            Explain more about the topic shown in the summary through supporting
            text.
          </p>
        </UIAccordionContent>
        <UIAccordionActions>
          <UIButton>Cancel</UIButton>
          <UIButton>Agree</UIButton>
        </UIAccordionActions>
      </UIAccordion>
    </Anatomy>
  </Fragment>
  <AccordionBuild slot="under-the-hood" />
</Component>
