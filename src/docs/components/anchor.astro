---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import {
  Anchor as UIAnchor,
  AnchorContent as UIAnchorContent,
  Button as UIButton,
  Card as UICard,
  CardContent as UICardContent,
} from "opui-css/astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"

import anchorApi from "../../component-api/anchor/api"
import AnchorBuild from "../../components/UnderTheHood/AnchorBuild.astro"

export const description =
  "Floating content placed next to an element with CSS anchor positioning."

export const keywords = [
  "anchor positioning",
  "floating",
  "popover",
  "position-anchor",
]
---

<Component
  description={description}
  slug="anchor"
  heroAnatomy
  apis={[{ title: "Anchor API", api: anchorApi }]}
  browserSupport={[
    "anchor-positioning",
    "interest-invokers",
    "popover",
    "popover-hint",
  ]}
  fallbacks={{
    "interest-invokers":
      "Without interest invokers, the compat layer shows the card while its anchor is hovered or has keyboard focus, and Esc doesn't hide it.",
    "popover-hint":
      'Without `popover="hint"`, the card is a manual popover, which the compat layer still shows on hover and focus.',
  }}
  changelogPaths={[
    {
      path: "packages/opui/components/Anchor/Anchor.astro",
      type: "component",
    },
    { path: "src/docs/components/anchor.astro", type: "docs" },
    { path: "src/component-examples/anchor", type: "docs" },
    {
      path: "packages/opui/css/components/anchor.css",
      type: "css",
    },
    { path: "src/component-api/anchor", type: "api" },
  ]}
  installationTabs={[{ title: "anchor.css", code: AnchorCSS, lang: "css" }]}
>
  <Fragment slot="title">Anchor</Fragment>
  <Fragment slot="preamble">
    Floating content next to an element. The base of
    <DocLink href="/components/tooltip">Tooltip</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Floating content beside an element, like a coach mark.</li>
    <li slot="when">
      Hover cards that preview a link: a
      <a href="#hover-trigger">hover trigger</a>.
    </li>
    <li slot="when">A base for your own floating component.</li>
    <li slot="when-not">
      A short hint: use a <DocLink href="/components/tooltip">Tooltip</DocLink>.
    </li>
    <li slot="when-not">
      A list of actions: use a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      Content that needs an answer: use a
      <DocLink href="/components/dialog">Dialog</DocLink>.
    </li>
  </Usage>

  <section id="always-visible">
    <h2>Always visible</h2>
    <p>
      Place it with
      <PropOrClass prop="positionArea" class="--ui-anchor-position-area" />.
    </p>
    <AutoExample name="AlwaysVisible" />
  </section>

  <section id="hover-trigger">
    <h2>Hover trigger</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>trigger="hover"</code>, and <code>interestfor</code> on the
        trigger.
      </Fragment>
      <Fragment slot="html">
        Use <code>popover="hint"</code>, and <code>interestfor</code> on the
        trigger.
      </Fragment>
    </Conditional>
    <AutoExample name="RepoCard" />
  </section>

  <section id="link-preview">
    <h2>Link preview</h2>
    <AutoExample name="LinkPreview" />
  </section>

  <Fragment slot="accessibility">
    <KeyboardSupport />
  </Fragment>

  <AnchorBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy>
      <UIAnchor positionArea="start center">
        <UIButton variant="outlined">Anchor</UIButton>
        <UIAnchorContent>
          <UICard variant="tonal">
            <UICardContent>Floating content</UICardContent>
          </UICard>
        </UIAnchorContent>
      </UIAnchor>
    </Anatomy>
  </Fragment>
</Component>
