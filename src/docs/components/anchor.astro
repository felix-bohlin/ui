---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import {
  Anchor as UIAnchor,
  AnchorContent as UIAnchorContent,
  Button as UIButton,
  Card as UICard,
  CardContent as UICardContent,
} from "opui-css/astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"

import anchorApi from "../../component-api/anchor/api"
import AnchorBuild from "../../components/UnderTheHood/AnchorBuild.astro"
---

<Component
  slug="anchor"
  heroAnatomy
  apis={[{ title: "Anchor API", api: anchorApi }]}
  browserSupport={[
    "anchor-positioning",
    "interest-invokers",
    "popover",
    "popover-hint",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Anchor/Anchor.astro",
      type: "component",
    },
    { path: "src/docs/components/anchor.astro", type: "docs" },
    { path: "src/component-examples/anchor", type: "docs" },
    {
      path: "packages/opui/css/components/anchor.css",
      type: "css",
    },
    { path: "src/component-api/anchor", type: "api" },
  ]}
  installationTabs={[{ title: "anchor.css", code: AnchorCSS, lang: "css" }]}
>
  <Fragment slot="title">Anchor</Fragment>
  <Fragment slot="preamble"
    >A structural primitive to enable CSS Anchor Positioning on stuff.</Fragment
  >

  <Usage slot="usage">
    <li slot="when">
      Floating content that stays next to an element, like a coach mark beside a
      new button.
    </li>
    <li slot="when">
      Hover cards that preview a link, a repository or a profile, with a <a
        href="#hover-trigger">hover trigger</a
      >.
    </li>
    <li slot="when">
      A base for your own floating component, when Tooltip and Menu don't fit.
    </li>
    <li slot="when-not">
      A short label or hint for a control. Use a <DocLink
        href="/components/tooltip">Tooltip</DocLink
      >.
    </li>
    <li slot="when-not">
      A list of actions. Use a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      Content that needs an answer before the user goes on. Use a <DocLink
        href="/components/dialog">Dialog</DocLink
      >.
    </li>
  </Usage>

  <section>
    <h2 id="always-visible">Always visible</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Floating content that is always shown, like a coach mark beside a
        button. Put it in <code>AnchorContent</code>, and set <code
          >positionArea</code
        > to any <code>position-area</code> value to place it.
      </Fragment>
      <Fragment slot="html">
        Floating content that is always shown, like a coach mark beside a
        button. Set <code>--ui-anchor-position-area</code> on
        {" "}<code>.ui-anchor</code> to any <code>position-area</code> value to place
        it.
      </Fragment>
    </Conditional>

    <AutoExample name="AlwaysVisible" />
  </section>

  <section>
    <h2 id="hover-trigger">Hover trigger</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>trigger="hover"</code> and an <code>id</code>, and add <code
          >interestfor</code
        > with that id to the trigger. <code>AnchorContent</code> gets the id and
        <code>popover="hint"</code>.
      </Fragment>
      <Fragment slot="html">
        Add <code>popover="hint"</code> and an id to
        {" "}<code>.ui-floating</code>, and <code>interestfor</code> with that id
        on the trigger.
      </Fragment>
    </Conditional>
    <p>
      <a href="#under-the-hood">Under the hood</a> shows how hover, focus and tap
      open the card.
    </p>
    <p>
      Put a <DocLink href="/components/card">Card</DocLink> in the floating content
      for hover cards like GitHub's repository previews. Align the card below the
      trigger with <code>block-end span-inline-end</code>. It flips to the other
      side when there isn't room. The card keeps its interactive content
      reachable, so the pointer can move from the link into the card without
      closing it.
    </p>

    <AutoExample name="RepoCard" />
  </section>

  <section>
    <h2 id="link-preview">Link preview</h2>
    <p>Preview where a link goes before following it.</p>

    <AutoExample name="LinkPreview" />
  </section>

  <Fragment slot="accessibility">
    <KeyboardSupport />
  </Fragment>

  <AnchorBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy>
      <UIAnchor positionArea="start center">
        <UIButton variant="outlined">Anchor</UIButton>
        <UIAnchorContent>
          <UICard variant="tonal">
            <UICardContent>Floating content</UICardContent>
          </UICard>
        </UIAnchorContent>
      </UIAnchor>
    </Anatomy>
  </Fragment>
</Component>
