---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import {
  Anchor as UIAnchor,
  Button as UIButton,
  Card as UICard,
} from "@opui/astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"

import anchorApi from "../../component-api/anchor/api"
---

<Component
  slug="anchor"
  heroAnatomy
  apis={[{ title: "Anchor API", api: anchorApi }]}
  browserSupport={[
    "anchor-positioning",
    "interest-invokers",
    "invoker-commands",
    "popover",
    "popover-hint",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Anchor/Anchor.astro",
      type: "component",
    },
    { path: "src/docs/components/anchor.astro", type: "docs" },
    { path: "src/component-examples/anchor", type: "docs" },
    {
      path: "packages/opui/css/components/anchor.css",
      type: "css",
    },
    { path: "src/component-api/anchor", type: "api" },
  ]}
  installationTabs={[{ title: "anchor.css", code: AnchorCSS, lang: "css" }]}
>
  <Fragment slot="title">Anchor</Fragment>
  <Fragment slot="preamble"
    >A structural primitive to enable CSS Anchor Positioning on stuff.</Fragment
  >

  <section>
    <h2 id="always-visible">Always visible</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Floating content that is always shown, like a coach mark beside a
        button. Set <code>--anchor-position-area</code> on
        {" "}<code>.ui-anchor</code> to any <code>position-area</code> value to place
        it.
      </Fragment>
      <Fragment slot="astro">
        Floating content that is always shown, like a coach mark beside a
        button. Set <code>alignment</code> to any <code>position-area</code> value
        to place it.
      </Fragment>
      <Fragment slot="vue">
        Floating content that is always shown, like a coach mark beside a
        button. Set <code>alignment</code> to any <code>position-area</code> value
        to place it.
      </Fragment>
    </Conditional>

    <AutoExample name="AlwaysVisible" />
  </section>

  <section>
    <h2 id="hover-trigger">Hover trigger</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Add <code>popover="hint"</code> and an id to
        {" "}<code>.ui-anchor-floating</code>, and <code>interestfor</code> with that
        id on the trigger.
      </Fragment>
      <Fragment slot="astro">
        Set <code>trigger="hover"</code> and an <code>id</code>, and add <code
          >interestfor</code
        > with that id to the trigger. The component adds <code
          >popover="hint"</code
        >.
      </Fragment>
      <Fragment slot="vue">
        Set <code>trigger="hover"</code> and an <code>id</code>, and add <code
          >interestfor</code
        > with that id to the trigger. The component adds <code
          >popover="hint"</code
        >.
      </Fragment>
    </Conditional>
    <p>
      The trigger has to be a <code>button</code> or a link with an <code
        >href</code
      >, since those are the elements that support <code>interestfor</code>.
      Pointer and keyboard users show interest by hovering or focusing the
      trigger. Add <code>commandfor</code> and <code
        >command="toggle-popover"</code
      >
      {" "}to a button trigger so touch devices can tap to show the floating
      content. A link can't take <code>commandfor</code>, so tapping it follows
      the link instead.
    </p>
    <p>
      Put a <DocLink href="/components/card">Card</DocLink> in the floating content
      for hover cards like GitHub's profile previews. Align the card below the trigger
      with <code>block-end span-inline-end</code>. It flips to the other side
      when there isn't room.
    </p>

    <AutoExample name="ProfileCard" />
  </section>

  <section>
    <h2 id="link-preview">Link preview</h2>
    <p>
      Preview where a link goes before following it. The card keeps its
      interactive content reachable, so the pointer can move from the link into
      the card without closing it.
    </p>

    <AutoExample name="LinkPreview" />
  </section>

  <section>
    <h2 id="used-by">Used by</h2>
    <ul>
      <li><DocLink href="/components/badge">Badge</DocLink></li>
      <li><DocLink href="/components/tooltip">Tooltip</DocLink></li>
    </ul>
  </section>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIAnchor alignment="start center">
        <UIButton variant="outlined">Anchor</UIButton>
        <UICard slot="anchored" variant="tonal">
          <div class="ui-content">Floating content</div>
        </UICard>
      </UIAnchor>
    </Anatomy>
  </Fragment>
</Component>
