---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import DocLink from "../../components/DocLink.astro"
import { Avatar as UIAvatar } from "opui-css/astro"

import AvatarCSS from "@opui/css/components/avatar.css?raw"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import avatarApi from "../../component-api/avatar/api"
import avatarGroupApi from "../../component-api/avatar-group/api"
import AvatarBuild from "../../components/UnderTheHood/AvatarBuild.astro"
export const description =
  "An image, initials or icon that stands for a person or an entity."

export const keywords = ["initials", "photo", "profile picture", "user"]
---

<Component
  description={description}
  slug="avatar"
  heroAnatomy
  apis={[
    { title: "Avatar API", api: avatarApi },
    { title: "Avatar group API", api: avatarGroupApi },
  ]}
  browserSupport={["corner-shape", "has", "overflow-clip"]}
  fallbacks={{
    "corner-shape":
      "Without `corner-shape`, the compat layer draws a squircle avatar as a rounded square with corners at 27% of its size.",
  }}
  changelogPaths={[
    {
      path: "packages/opui/components/Avatar/Avatar.astro",
      type: "component",
    },
    { path: "src/docs/components/avatar.astro", type: "docs" },
    { path: "src/component-examples/avatar", type: "docs" },
    {
      path: "packages/opui/css/components/avatar.css",
      type: "css",
    },
    { path: "src/component-api/avatar", type: "api" },
  ]}
  installationTabs={[{ title: "avatar.css", code: AvatarCSS, lang: "css" }]}
>
  <Fragment slot="title">Avatar</Fragment>
  <Fragment slot="preamble">
    Who did something, like a comment's author, as an image, initials or an
    icon. For a count or status, add a
    <DocLink href="/components/badge">Badge</DocLink>.
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={2}>
      <UIAvatar
        label="Lou Headstock"
        size="large"
        src="/photos/lou-headstock.png"
      />
    </Anatomy>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Who did something, like a comment's author.</li>
    <li slot="when">People next to their name, in lists and tables.</li>
    <li slot="when">A few people at once: a <a href="#grouped">group</a>.</li>
    <li slot="when-not">
      Icons for things or actions: use an <code>svg</code>, or an
      <DocLink href="/components/button#icon-only">icon-only Button</DocLink>.
    </li>
    <li slot="when-not">
      A count or status: put a <DocLink href="/components/badge">Badge</DocLink>
      on the avatar.
    </li>
  </Usage>

  <section id="image">
    <h2>Image</h2>

    <Conditional as="p">
      <Fragment slot="components">
        <code>label</code> is the person's name, and the <code>alt</code> of the
        image. Without <code>src</code> the avatar shows its content, so a
        person without a photo falls back to their letters.
      </Fragment>
      <Fragment slot="html">
        Give the image the person's name as <code>alt</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Image" row />
  </section>

  <section id="letter">
    <h2>Letter</h2>

    <Conditional as="p">
      <Fragment slot="components">
        <code>label</code> names the avatar: the letters are hidden from
        assistive technology, and the name follows them as visually hidden text.
        Leave it out when the name is shown next to the avatar.
      </Fragment>
      <Fragment slot="html">
        Hide the letters with <code>aria-hidden="true"</code> and put the name
        after them in a <code>.ui-sr-only</code> element. Leave the name out
        when it is shown next to the avatar.
      </Fragment>
    </Conditional>

    <AutoExample name="Letter" row />
  </section>

  <section id="icon">
    <h2>Icon</h2>

    <AutoExample name="Icon" row />
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Filled by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Filled by default. Use <code>.ui-outlined</code> or
        <code>.ui-tonal</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" row />
  </section>

  <section id="shapes">
    <h2>Shapes</h2>

    <Conditional as="p">
      <Fragment slot="components">
        A circle by default. Use <code>shape</code> to change it.
      </Fragment>
      <Fragment slot="html">
        A circle by default. Use <code>.ui-rounded</code>,
        <code>.ui-squared</code> or <code>.ui-squircle</code> to change it.
      </Fragment>
    </Conditional>

    <AutoExample name="Shapes" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>

    <AutoExample name="Sizes" row />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>

    <Conditional as="p">
      <Fragment slot="components">
        Set <code>disabled</code>, on a link too.
      </Fragment>
      <Fragment slot="html">
        Links: drop <code>href</code>, add <code>role="link"</code> and
        <code>aria-disabled="true"</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Disabled" row />
  </section>

  <section id="grouped">
    <h2>Grouped</h2>

    <p>
      Use <PropOrClass prop="AvatarGroup" class=".ui-avatar-group" /> with an
      <code>aria-label</code>. Link and button avatars in a group need the
      default size or larger.
    </p>

    <AutoExample name="Grouped" row />

    <h3 id="overflow">Overflow</h3>
    <AutoExample name="GroupedOverflow" row />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        <Conditional>
          <Fragment slot="components"
            ><code>label</code> is the avatar's name: the <code>alt</code> of an
            image, or visually hidden text after initials or an icon, which are
            hidden from assistive technology.</Fragment
          >
          <Fragment slot="html"
            >Give an image the name as <code>alt</code>. Hide initials and icons
            with <code>aria-hidden="true"</code> and put the name after them in
            a <code>.ui-sr-only</code> element.</Fragment
          >
        </Conditional>
      </li>
      <li>
        <Conditional>
          <Fragment slot="components"
            >Next to the visible name, leave <code>label</code> out: the avatar
            is decorative.</Fragment
          >
          <Fragment slot="html"
            >Next to the visible name, leave the name out and give an image
            <code>alt=""</code>: the avatar is decorative.</Fragment
          >
        </Conditional>
      </li>
      <li>
        A link or button avatar needs a name. Initials stand in for a photo, so
        the name is the person's, not the letters.
      </li>
    </ul>
  </Fragment>

  <AvatarBuild slot="under-the-hood" />
</Component>
