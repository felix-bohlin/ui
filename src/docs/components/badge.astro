---
import Component from "../../layouts/Component.astro"
import AutoExample from "../../components/AutoExample.astro"

import Anatomy from "../../components/Anatomy.astro"
import { Badge as UIBadge, Switch as UISwitch } from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import BadgeCSS from "@opui/css/components/badge.css?raw"
import AnchorCSS from "@opui/css/components/anchor.css?raw"

import badgeApi from "../../component-api/badge/api"
import BadgeBuild from "../../components/UnderTheHood/BadgeBuild.astro"
export const description =
  "Badges attach a small count or status dot to another element."
---

<Component
  description={description}
  slug="badge"
  heroAnatomy
  apis={[{ title: "Badge API", api: badgeApi }]}
  browserSupport={[
    "anchor-positioning",
    "container-style-queries",
    "dir-pseudo",
    "has",
    "light-dark",
    "relative-color",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Badge/Badge.astro",
      type: "component",
    },
    { path: "src/docs/components/badge.astro", type: "docs" },
    { path: "src/component-examples/badge", type: "docs" },
    {
      path: "packages/opui/css/components/badge.css",
      type: "css",
    },
    { path: "src/component-api/badge", type: "api" },
  ]}
  installationTabs={[
    { title: "badge.css", code: BadgeCSS, lang: "css" },
    { title: "anchor.css", code: AnchorCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Badge</Fragment>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Default, and <code>dot</code>.
      </Fragment>
      <Fragment slot="html">
        Default, and <code>.ui-dot</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="colors">Colors</h2>
    <p>
      Color the indicator with <PropOrClass
        prop='color="critical"'
        class=".ui-critical"
      />, <PropOrClass prop='color="info"' class=".ui-info" />, <PropOrClass
        prop='color="neutral"'
        class=".ui-neutral"
      />, <PropOrClass prop='color="success"' class=".ui-success" /> or <PropOrClass
        prop='color="warning"'
        class=".ui-warning"
      />.
    </p>

    <AutoExample name="Colors" row />
  </section>

  <section>
    <h2 id="indicator">Indicator</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set indicator text with the <code>label</code> prop or the <code
          >indicator</code
        > slot. The default slot holds the anchored element.
      </Fragment>
      <Fragment slot="html">
        Put indicator text inside <code>.ui-badge-indicator</code>. The anchored
        element is the badge's direct child before <code
          >.ui-anchor-floating</code
        >.
      </Fragment>
      <Fragment slot="react">
        Set indicator text with the <code>label</code> prop or the <code
          >indicator</code
        > prop. <code>children</code> is the anchored element.
      </Fragment>
      <Fragment slot="svelte">
        Set indicator text with the <code>label</code> prop or the <code
          >indicator</code
        > snippet. The <code>children</code> snippet holds the anchored element.
      </Fragment>
    </Conditional>

    <AutoExample name="Indicator" row />
  </section>

  <section>
    <h2 id="visibility">Visibility</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Change the badge's visibility using the <code>invisible</code>{" "}
        prop.
      </Fragment>
      <Fragment slot="html">
        Change the badge's visibility using the <code>.ui-invisible</code>{" "}
        class.
      </Fragment>
    </Conditional>

    <AutoExample name="Visibility" row>
      <UISwitch
        slot="controls"
        checked
        data-toggle-class="ui-invisible"
        data-toggle-target=".ui-badge"
      >
        <PropOrClass prop="invisible" class=".ui-invisible" />
      </UISwitch>
    </AutoExample>
  </section>

  <section>
    <h2 id="alignment">Alignment</h2>
    <p>Where the badge should be placed over the child.</p>
    <Conditional>
      <p slot="components">
        <code>start-start</code>, default (<code>start-end</code>),{" "}
        <code>end-start</code>, <code>end-end</code>.
      </p>
      <p slot="html">
        <code>.ui-start-start</code>, default (<code>start-end</code>, no
        class),
        <code>.ui-end-start</code>, <code>.ui-end-end</code>.
      </p>
    </Conditional>

    <AutoExample name="Alignment" row spacious />
  </section>

  <BadgeBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        A count on its own is read without context, such as "5". Add visually
        hidden text inside the indicator, so it's read as "5 unread messages":
        <Conditional>
          <Fragment slot="components">the <code>srLabel</code> prop.</Fragment>
          <Fragment slot="html"
            >a <code>.ui-sr-only</code> element inside <code
              >.ui-badge-indicator</code
            >.</Fragment
          >
        </Conditional>
      </li>
    </ul>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={2}>
      <UIBadge label="5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"
          ><path
            fill="currentColor"
            d="M2.004 9.303A4.5 4.5 0 0 1 6.5 5h19a4.5 4.5 0 0 1 4.496 4.303l-1.476.82L16 16.864L3.48 10.123zM2 11.588V22.5A4.5 4.5 0 0 0 6.5 27h19a4.5 4.5 0 0 0 4.5-4.5V11.588l-.526.293l-13 7a1 1 0 0 1-.948 0L2.514 11.874z"
          ></path></svg
        >
      </UIBadge>
    </Anatomy>
  </Fragment>
</Component>
