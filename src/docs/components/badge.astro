---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import AutoExample from "../../components/AutoExample.astro"

import Anatomy from "../../components/Anatomy.astro"
import { Badge as UIBadge, Switch as UISwitch } from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import BadgeCSS from "@opui/css/components/badge.css?raw"

import badgeApi from "../../component-api/badge/api"
import BadgeBuild from "../../components/UnderTheHood/BadgeBuild.astro"
export const description =
  "A small count or status dot on the corner of another element."

export const keywords = ["counter", "dot", "indicator", "notification count"]
---

<Component
  description={description}
  slug="badge"
  heroAnatomy
  apis={[{ title: "Badge API", api: badgeApi }]}
  browserSupport={["dir-pseudo", "has", "relative-color", "trig-functions"]}
  changelogPaths={[
    {
      path: "packages/opui/components/Badge/Badge.astro",
      type: "component",
    },
    { path: "src/docs/components/badge.astro", type: "docs" },
    { path: "src/component-examples/badge", type: "docs" },
    {
      path: "packages/opui/css/components/badge.css",
      type: "css",
    },
    { path: "src/component-api/badge", type: "api" },
  ]}
  installationTabs={[{ title: "badge.css", code: BadgeCSS, lang: "css" }]}
>
  <Fragment slot="title">Badge</Fragment>

  <Usage slot="usage">
    <li slot="when">A count on an icon, like unread messages.</li>
    <li slot="when">
      A status dot, like online: <PropOrClass prop="dot" class=".ui-dot" />.
    </li>
    <li slot="when-not">
      A status in words: use a <DocLink href="/components/chip">Chip</DocLink>.
    </li>
    <li slot="when-not">
      A sentence or two: use a
      <DocLink href="/components/callout">Callout</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>Use <PropOrClass prop="dot" class=".ui-dot" /> for a dot.</p>
    <AutoExample name="Basics" row />
  </section>

  <section id="colors">
    <h2>Colors</h2>
    <p>
      Use <PropOrClass prop="color" class=".ui-critical" /> and the other tones.
    </p>
    <AutoExample name="Colors" row />
    <p>
      The indicator has a ring in the page background color,
      <code>--ui-surface</code>, so it stands out on a filled avatar or button.
      On another surface, set <code>--_border-color</code> to its background.
    </p>
  </section>

  <section id="indicator">
    <h2>Indicator</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>hideLabel</code> with the full sentence as <code>label</code>.
      </Fragment>
      <Fragment slot="html">
        Put the full sentence in a <code>.ui-sr-only</code>, and hide the count
        with <code>aria-hidden="true"</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Indicator" row />
  </section>

  <section id="visibility">
    <h2>Visibility</h2>
    <p>Use <PropOrClass prop="invisible" class=".ui-invisible" />.</p>
    <AutoExample name="Visibility" row>
      <UISwitch
        slot="controls"
        checked
        data-toggle-class="ui-invisible"
        data-toggle-target=".ui-badge"
      >
        <PropOrClass prop="invisible" class=".ui-invisible" />
      </UISwitch>
    </AutoExample>
  </section>

  <section id="corners">
    <h2>Corners</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Top end by default. Use <code>corner</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Top end by default. Use <code>.ui-start-start</code>,
        <code>.ui-end-start</code> or <code>.ui-end-end</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Corners" row spacious />
  </section>

  <BadgeBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        On a button or link, put the sentence in its name too, like
        <code>aria-label="Inbox, 5 unread messages"</code>.
      </li>
    </ul>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={2}>
      <UIBadge label="5">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"
        >
          <path
            fill="currentColor"
            d="M2.004 9.303A4.5 4.5 0 0 1 6.5 5h19a4.5 4.5 0 0 1 4.496 4.303l-1.476.82L16 16.864L3.48 10.123zM2 11.588V22.5A4.5 4.5 0 0 0 6.5 27h19a4.5 4.5 0 0 0 4.5-4.5V11.588l-.526.293l-13 7a1 1 0 0 1-.948 0L2.514 11.874z"
          ></path>
        </svg>
      </UIBadge>
    </Anatomy>
  </Fragment>
</Component>
