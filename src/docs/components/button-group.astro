---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Accordion as UIAccordion,
  Button as UIButton,
  ButtonGroup as UIButtonGroup,
} from "@opui/astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import ButtonGroupCSS from "@opui/css/components/button-group.css?raw"
import buttonGroupApi from "../../component-api/button-group/api"
import buttonApi from "../../component-api/button/api"

import Conditional from "../../components/Conditional.astro"
import ButtonGroupBuild from "../../components/UnderTheHood/ButtonGroupBuild.astro"
---

<Component
  slug="button-group"
  browserSupport={[
    "color-mix",
    "has",
    "light-dark",
    "relative-color",
    "scrollbar-width",
  ]}
  heroAnatomy
  apis={[
    { title: "Button group API", api: buttonGroupApi },
    { title: "Button API", api: buttonApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/ButtonGroup/ButtonGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/button-group.astro", type: "docs" },
    { path: "src/component-examples/button-group", type: "docs" },
    {
      path: "packages/opui/css/components/button-group.css",
      type: "css",
    },
    { path: "src/component-api/button-group", type: "api" },
  ]}
  installationTabs={[
    { title: "button-group.css", code: ButtonGroupCSS, lang: "css" },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Button group</Fragment>
  <Fragment slot="preamble">
    <Conditional>
      <Fragment slot="html">
        Groups related buttons by wrapping them with <code
          >class="ui-button-group"</code
        > and <code>role="group"</code>.
      </Fragment>
      <Fragment slot="astro">Groups related buttons.</Fragment>
      <Fragment slot="solid">Groups related buttons.</Fragment>
      <Fragment slot="vue">Groups related buttons.</Fragment>
    </Conditional>
  </Fragment>
  <ul>
    <li>Button groups should consist of 2-5 buttons.</li>
    <li>Don't allow them to wrap onto a new line.</li>
    <li>
      If an icon is used without label text make sure the button communicates
      clearly what it does.
    </li>
  </ul>

  <div class="ui-not-rich-text">
    <UIAccordion variant="tonal">
      <Fragment slot="summary">Button group or Toggle group?</Fragment>
      <p>
        If your buttons depend on state (controlled) - use <DocLink
          href="/components/toggle"
          class="ui-link">Toggle group</DocLink
        >.
      </p>
      <p>
        If you just need to group a bunch of "dumb" (uncontrolled) buttons - use
        Button group.
      </p>
    </UIAccordion>
  </div>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Change the appearance of the entire group with the <code>variant</code>
        {" "}prop.
      </Fragment>
      <Fragment slot="html">
        Change the appearance of the entire group with the <code
          >.ui-outlined</code
        >, <code>.ui-tonal</code>, and <code>.ui-filled</code> classes.
      </Fragment>
      <Fragment slot="solid">
        Change the appearance of the entire group with the <code>variant</code>
        prop.
      </Fragment>
      <Fragment slot="vue">
        Change the appearance of the entire group with the <code>variant</code>
        {" "}prop.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column centered />
  </section>

  <section>
    <h2 id="colors">Colors</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set the <code>color</code> prop to <code>primary</code> or <code
          >critical</code
        > to recolor the entire group. The default is a neutral gray.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-primary</code> or <code>.ui-critical</code> class to recolor
        the entire group. The default is a neutral gray.
      </Fragment>
      <Fragment slot="solid">
        Set the <code>color</code> prop to <code>primary</code> or <code
          >critical</code
        > to recolor the entire group. The default is a neutral gray.
      </Fragment>
      <Fragment slot="vue">
        Set the <code>color</code> prop to <code>primary</code> or <code
          >critical</code
        > to recolor the entire group. The default is a neutral gray.
      </Fragment>
    </Conditional>
    <AutoExample name="Colors" column centered />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Adjust the size of all buttons in the group using the <code>size</code>
        {" "}prop.
      </Fragment>
      <Fragment slot="html">
        Adjust the size of all buttons in the group using the <code
          >.ui-x-small</code
        >, <code>.ui-small</code> and <code>.ui-large</code> classes.
      </Fragment>
      <Fragment slot="vue">
        Adjust the size of all buttons in the group using the <code>size</code>
        {" "}prop.
      </Fragment>
    </Conditional>
    <AutoExample name="Size" column centered />
  </section>

  <section>
    <h2 id="icons">Icons</h2>
    <p>
      Yes of course, they're just <DocLink
        href="/components/button"
        class="ui-link">buttons.</DocLink
      > Wrap labels in a <code>&lt;span&gt;</code> so buttons with an icon keep their
      padding.
    </p>
    <AutoExample name="WithIcons" column centered />
  </section>

  <section>
    <h2 id="split-button">Split button</h2>
    <Conditional as="p">
      <Fragment slot="html">
        A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after the
        last button. <code>.ui-align-end</code> lines it up with the group.
      </Fragment>
      <Fragment slot="astro">
        A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after the
        last button. <code>align="end"</code> lines it up with the group.
      </Fragment>
      <Fragment slot="solid">
        Adjust the size of all buttons in the group using the <code>size</code>
        prop.
      </Fragment>
      <Fragment slot="vue">
        A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after the
        last button. <code>align="end"</code> lines it up with the group.
      </Fragment>
    </Conditional>
    <AutoExample name="SplitButton" centered />
  </section>

  <section>
    <h2 id="disabled">Disabled</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Disable individual buttons within a group by setting the <code
          >disabled</code
        >
        {" "}prop on each <code>Button</code>.
      </Fragment>
      <Fragment slot="html">
        Disable individual buttons within a group by adding the <code
          >disabled</code
        >
        {" "}attribute to each <code>&lt;button&gt;</code>.
      </Fragment>
      <Fragment slot="vue">
        Disable individual buttons within a group by setting the <code
          >disabled</code
        >
        {" "}prop on each <code>Button</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Disabled" column centered />
  </section>

  <section>
    <h2 id="vertical-orientation">Vertical orientation</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </Fragment>
      <Fragment slot="html">
        Change the layout of the group with the <code>.ui-vertical</code> class.
      </Fragment>
      <Fragment slot="solid">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </Fragment>
      <Fragment slot="vue">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </Fragment>
    </Conditional>

    <AutoExample name="Vertical" column centered />
  </section>

  <section>
    <h2 id="overflow">Overflow</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Buttons wrap onto more rows when they don't fit. Use <code
          >scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
      <Fragment slot="html">
        Buttons wrap onto more rows when they don't fit. Add <code
          >.ui-scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >.ui-shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
      <Fragment slot="solid">
        Disable individual buttons within a group by setting the <code
          >disabled</code
        >
        prop on each <code>Button</code>.
      </Fragment>
      <Fragment slot="vue">
        Buttons wrap onto more rows when they don't fit. Use <code
          >scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
    </Conditional>
    <AutoExample name="Overflow" />
  </section>

  <ButtonGroupBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIButtonGroup variant="outlined">
        <UIButton>Day</UIButton>
        <UIButton>Week</UIButton>
        <UIButton>Month</UIButton>
      </UIButtonGroup>
    </Anatomy>
  </Fragment>
</Component>
