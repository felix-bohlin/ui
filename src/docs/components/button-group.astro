---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  ButtonGroup as UIButtonGroup,
} from "opui-css/astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import ButtonGroupCSS from "@opui/css/components/button-group.css?raw"
import buttonGroupApi from "../../component-api/button-group/api"
import buttonApi from "../../component-api/button/api"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import ButtonGroupBuild from "../../components/UnderTheHood/ButtonGroupBuild.astro"

export const keywords = ["segmented control", "split button", "toolbar"]
---

<Component
  slug="button-group"
  browserSupport={[
    "color-mix",
    "container-style-queries",
    "dir-pseudo",
    "has",
    "invoker-commands",
    "lh",
    "light-dark",
    "logical-properties",
    "popover",
    "relative-color",
    "scrollbar-width",
  ]}
  heroAnatomy
  apis={[
    { title: "Button group API", api: buttonGroupApi },
    { title: "Button API", api: buttonApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/ButtonGroup/ButtonGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/button-group.astro", type: "docs" },
    { path: "src/component-examples/button-group", type: "docs" },
    {
      path: "packages/opui/css/components/button-group.css",
      type: "css",
    },
    { path: "src/component-api/button-group", type: "api" },
  ]}
  installationTabs={[
    { title: "button-group.css", code: ButtonGroupCSS, lang: "css" },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Button group</Fragment>
  <Fragment slot="preamble">
    <Conditional>
      <Fragment slot="components">Groups related buttons.</Fragment>
      <Fragment slot="html">
        Groups related buttons with <code>.ui-button-group</code> and
        <code>role="group"</code>.
      </Fragment>
    </Conditional>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Related actions, like Undo and Redo.</li>
    <li slot="when">
      A main action with more options: a <a href="#split-button">split button</a
      >.
    </li>
    <li slot="when-not">
      Options that stay selected: use a
      <DocLink href="/components/toggle#toggle-group">Toggle group</DocLink>.
    </li>
    <li slot="when-not">
      Panels of content: use <DocLink href="/components/tabs">Tabs</DocLink>.
    </li>
    <li slot="when-not">
      More than five actions: put the rest in a
      <DocLink href="/components/menu">Menu</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Transparent by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Transparent by default. Use <code>.ui-outlined</code>,
        <code>.ui-tonal</code> or <code>.ui-filled</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column centered />
  </section>

  <section id="colors">
    <h2>Colors</h2>
    <AutoExample name="Colors" column centered />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column centered />
  </section>

  <section id="icons">
    <h2>Icons</h2>
    <p>
      Wrap the label in <code>.ui-text</code>, like in a
      <DocLink
        href="/components/button#buttons-with-icon-and-label"
        class="ui-link"
        >Button</DocLink
      >.
    </p>
    <AutoExample name="WithIcons" column centered />
  </section>

  <section id="split-button">
    <h2>Split button</h2>
    <p>
      A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after
      the last button, with
      <PropOrClass prop='align="end"' class=".ui-align-end" />.
    </p>
    <AutoExample name="SplitButton" centered />
  </section>

  <section id="pagination">
    <h2>Pagination</h2>
    <p>
      Link buttons in a <code>nav</code>, with <code>aria-current="page"</code>
      on the current one. It gets a tint, and in a filled group it drops its
      fill and reads like a text button.
    </p>
    <AutoExample name="Pagination" row />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" column centered />
  </section>

  <section id="vertical-orientation">
    <h2>Vertical orientation</h2>
    <p>
      Use <PropOrClass prop='orientation="vertical"' class=".ui-vertical" />.
    </p>
    <AutoExample name="Vertical" column centered />
  </section>

  <section id="overflow">
    <h2>Overflow</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Wraps by default. Use <code>overflow</code> to scroll or shrink.
      </Fragment>
      <Fragment slot="html">
        Wraps by default. Use <code>.ui-overflow-scroll</code> or
        <code>.ui-overflow-shrink</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Overflow" column />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>Name the group with <code>aria-label</code>.</li>
      <li>Name icon-only buttons with <code>aria-label</code>.</li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <ButtonGroupBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIButtonGroup variant="outlined">
        <UIButton>Day</UIButton>
        <UIButton>Week</UIButton>
        <UIButton>Month</UIButton>
      </UIButtonGroup>
    </Anatomy>
  </Fragment>
</Component>
