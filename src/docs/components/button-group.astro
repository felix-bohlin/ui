---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  ButtonGroup as UIButtonGroup,
} from "opui-css/astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import ButtonGroupCSS from "@opui/css/components/button-group.css?raw"
import buttonGroupApi from "../../component-api/button-group/api"
import buttonApi from "../../component-api/button/api"

import Conditional from "../../components/Conditional.astro"
import ButtonGroupBuild from "../../components/UnderTheHood/ButtonGroupBuild.astro"
---

<Component
  slug="button-group"
  browserSupport={[
    "color-mix",
    "container-style-queries",
    "has",
    "invoker-commands",
    "lh",
    "light-dark",
    "popover",
    "relative-color",
    "scrollbar-width",
  ]}
  heroAnatomy
  apis={[
    { title: "Button group API", api: buttonGroupApi },
    { title: "Button API", api: buttonApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/ButtonGroup/ButtonGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/button-group.astro", type: "docs" },
    { path: "src/component-examples/button-group", type: "docs" },
    {
      path: "packages/opui/css/components/button-group.css",
      type: "css",
    },
    { path: "src/component-api/button-group", type: "api" },
  ]}
  installationTabs={[
    { title: "button-group.css", code: ButtonGroupCSS, lang: "css" },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Button group</Fragment>
  <Fragment slot="preamble">
    <Conditional>
      <Fragment slot="components">Groups related buttons.</Fragment>
      <Fragment slot="html">
        Groups related buttons by wrapping them with <code
          >class="ui-button-group"</code
        > and <code>role="group"</code>.
      </Fragment>
    </Conditional>
  </Fragment>
  <Usage slot="usage">
    <li slot="when">
      Two to five related actions that belong together, like Undo and Redo, or
      Previous and Next.
    </li>
    <li slot="when">
      A main action with more options next to it, in a <a href="#split-button"
        >split button</a
      >.
    </li>
    <li slot="when-not">
      Options that stay selected, like a view or a text style. Use a <DocLink
        href="/components/toggle#toggle-group">Toggle group</DocLink
      >.
    </li>
    <li slot="when-not">
      Switching between panels of content. Use <DocLink href="/components/tabs"
        >Tabs</DocLink
      >.
    </li>
    <li slot="when-not">
      More than five actions. Put the rest in a <DocLink href="/components/menu"
        >Menu</DocLink
      >.
    </li>
  </Usage>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Change the appearance of the entire group with the <code>variant</code>
        {" "}prop. The default is <code>transparent</code>.
      </Fragment>
      <Fragment slot="html">
        Change the appearance of the entire group with the <code
          >.ui-outlined</code
        >, <code>.ui-tonal</code>, and <code>.ui-filled</code> classes.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column centered />
  </section>

  <section>
    <h2 id="colors">Colors</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set the <code>color</code> prop to <code>critical</code> or <code
          >primary</code
        > to recolor the entire group. The default is a neutral gray.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-critical</code> or <code>.ui-primary</code> class to recolor
        the entire group. The default is a neutral gray.
      </Fragment>
    </Conditional>
    <AutoExample name="Colors" column centered />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Adjust the size of all buttons in the group using the <code>size</code>
        {" "}prop: <code>x-small</code>, <code>small</code>, <code>medium</code> (the
        default) or <code>large</code>.
      </Fragment>
      <Fragment slot="html">
        Adjust the size of all buttons in the group using the <code
          >.ui-x-small</code
        >, <code>.ui-small</code> and <code>.ui-large</code> classes.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" column centered />
  </section>

  <section>
    <h2 id="icons">Icons</h2>
    <p>
      Yes of course, they're just <DocLink
        href="/components/button"
        class="ui-link">buttons.</DocLink
      >
      <Conditional>
        <Fragment slot="html">
          Wrap the label in a <code>&lt;span class="ui-text"&gt;</code> when the button
          has an icon. The CSS looks for the wrapper element, the class is a hook
          for your own styles.
        </Fragment>
        <Fragment slot="react">
          Wrap the label in a <code>&lt;span className="ui-text"&gt;</code> when the
          button has an icon. The CSS looks for the wrapper element, the class is
          a hook for your own styles.
        </Fragment>
      </Conditional>
    </p>
    <AutoExample name="WithIcons" column centered />
  </section>

  <section>
    <h2 id="split-button">Split button</h2>
    <Conditional as="p">
      <Fragment slot="components">
        A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after the
        last button. <code>align="end"</code> lines it up with the group.
      </Fragment>
      <Fragment slot="html">
        A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after the
        last button. <code>.ui-align-end</code> lines it up with the group.
      </Fragment>
    </Conditional>
    <AutoExample name="SplitButton" centered />
  </section>

  <section>
    <h2 id="disabled">Disabled</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Disable individual buttons within a group by setting the <code
          >disabled</code
        >
        {" "}prop on each <code>Button</code>.
      </Fragment>
      <Fragment slot="html">
        Disable individual buttons within a group by adding the <code
          >disabled</code
        >
        {" "}attribute to each <code>&lt;button&gt;</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Disabled" column centered />
  </section>

  <section>
    <h2 id="vertical-orientation">Vertical orientation</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </Fragment>
      <Fragment slot="html">
        Change the layout of the group with the <code>.ui-vertical</code> class.
      </Fragment>
    </Conditional>

    <AutoExample name="Vertical" column centered />
  </section>

  <section>
    <h2 id="overflow">Overflow</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Buttons wrap onto more rows when they don't fit. Use <code
          >overflow="scroll"</code
        > to keep them on one row and scroll them sideways, or <code
          >overflow="shrink"</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size. <code>overflow="shrink"</code> hides label text, so use it only
        when the labels can be inferred or are icon-only, and prefer <code
          >overflow="scroll"</code
        >
        when the text matters.
      </Fragment>
      <Fragment slot="html">
        Buttons wrap onto more rows when they don't fit. Add <code
          >.ui-overflow-scroll</code
        > to keep them on one row and scroll them sideways, or <code
          >.ui-overflow-shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size. <code>.ui-overflow-shrink</code> hides label text, so use it only
        when the labels can be inferred or are icon-only, and prefer <code
          >.ui-overflow-scroll</code
        > when the text matters.
      </Fragment>
    </Conditional>
    <AutoExample name="Overflow" column />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        <Conditional>
          <Fragment slot="components"
            ><code>ButtonGroup</code> renders <code>role="group"</code
            >.</Fragment
          >
          <Fragment slot="html"
            >Add <code>role="group"</code> to the <code>.ui-button-group</code
            >.</Fragment
          >
        </Conditional>
        Name the group with <code>aria-label</code> when the buttons need context,
        like "Text alignment", so screen readers read it when focus moves into the
        group.
      </li>
      <li>
        Name an icon-only button with <code>aria-label</code>, like any <DocLink
          href="/components/button#icon-only">icon-only button</DocLink
        >.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <ButtonGroupBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIButtonGroup variant="outlined">
        <UIButton>Day</UIButton>
        <UIButton>Week</UIButton>
        <UIButton>Month</UIButton>
      </UIButtonGroup>
    </Anatomy>
  </Fragment>
</Component>
