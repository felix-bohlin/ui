---
import Component from "../../layouts/Component.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import BlockLink from "../../components/BlockLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import { Button as UIButton } from "opui-css/astro"

import ButtonCSS from "@opui/css/components/button.css?raw"

import Conditional from "../../components/Conditional.astro"
import ButtonBuild from "../../components/UnderTheHood/ButtonBuild.astro"

import buttonApi from "../../component-api/button/api"

export const description =
  "Buttons allow users to take actions with a single tap."

export const keywords = ["btn", "cta", "icon button", "submit"]
---

<Component
  description={description}
  slug="button"
  heroAnatomy
  apis={[{ title: "Button API", api: buttonApi }]}
  browserSupport={[
    "color-mix",
    "container-style-queries",
    "has",
    "lh",
    "light-dark",
    "popover",
    "relative-color",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Button/Button.astro",
      type: "component",
    },
    { path: "src/docs/components/button.astro", type: "docs" },
    { path: "src/component-examples/button", type: "docs" },
    {
      path: "packages/opui/css/components/button.css",
      type: "css",
    },
    { path: "src/component-api/button", type: "api" },
  ]}
  installationTabs={[{ title: "button.css", code: ButtonCSS, lang: "css" }]}
>
  <Fragment slot="title">Button</Fragment>
  <Fragment slot="preamble">
    Actions, like saving a form. For filters and tags, use a
    <DocLink href="/components/chip">Chip</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Actions, like saving or opening a dialog.</li>
    <li slot="when">
      The main action:
      <PropOrClass prop='variant="filled"' class=".ui-filled" />.
    </li>
    <li slot="when">
      A link that looks like an action:
      <PropOrClass prop="href" class='<a class="ui-button">' />.
    </li>
    <li slot="when-not">
      Filters and tags: use a <DocLink href="/components/chip">Chip</DocLink>.
    </li>
    <li slot="when-not">
      On and off: use a
      <DocLink href="/components/toggle">Toggle button</DocLink> or a
      <DocLink href="/components/switch">Switch</DocLink>.
    </li>
    <li slot="when-not">
      A link in running text: use a
      <DocLink href="/components/typography#link">text link</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Transparent by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Transparent by default. Use <code>.ui-outlined</code>,
        <code>.ui-tonal</code> or <code>.ui-filled</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column spacious />
  </section>

  <section id="colors">
    <h2>Colors</h2>
    <AutoExample name="Colors" column spacious />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column />

    <BlockLink slug="shopping-cart">
      "Go to checkout" is a large filled button that fills the width of the
      order summary.
    </BlockLink>
  </section>

  <section id="buttons-with-icon-and-label">
    <h2>Buttons with icon and label</h2>
    <p>Wrap the label in <code>.ui-text</code>.</p>
    <AutoExample name="IconAndLabel" column />
  </section>

  <section id="keyboard">
    <h2>Keyboard</h2>
    <AutoExample name="Keyboard" row />
  </section>

  <section id="icon-only">
    <h2>Icon-only</h2>
    <p>
      Needs <code>aria-label</code>. Use
      <PropOrClass prop="round" class=".ui-round" /> for a circle.
    </p>
    <AutoExample name="IconOnly" column spacious />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Links: drop <code>href</code>, add <code>role="link"</code> and
        <code>aria-disabled="true"</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Disabled" column />
  </section>

  <section id="file-upload">
    <h2>File upload</h2>
    <p>
      See <DocLink href="/components/text-field#file">File</DocLink> on the Text
      field page.
    </p>
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        A <a href="#keyboard"><code>&lt;kbd&gt;</code></a> hint is part of the
        name. Handle the shortcut in your own script.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UIButton variant="tonal">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"
        >
          <path
            fill="currentColor"
            d="M13.5 6.5V7h5v-.5a2.5 2.5 0 0 0-5 0m-2 .5v-.5a4.5 4.5 0 1 1 9 0V7H28a1 1 0 1 1 0 2h-1.508L24.6 25.568A5 5 0 0 1 19.63 30h-7.26a5 5 0 0 1-4.97-4.432L5.508 9H4a1 1 0 0 1 0-2zm2.5 6.5a1 1 0 1 0-2 0v10a1 1 0 1 0 2 0zm5-1a1 1 0 0 0-1 1v10a1 1 0 1 0 2 0v-10a1 1 0 0 0-1-1"
          ></path>
        </svg>
        <span class="ui-text">Delete</span>
        <kbd>Del</kbd>
      </UIButton>
    </Anatomy>
  </Fragment>
  <ButtonBuild slot="under-the-hood" />
</Component>
