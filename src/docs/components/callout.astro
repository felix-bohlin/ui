---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Button as UIButton,
  Callout as UICallout,
  CalloutActions as UICalloutActions,
  CalloutContent as UICalloutContent,
  CalloutIcon as UICalloutIcon,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"
import CalloutCSS from "@opui/css/components/callout.css?raw"
import CalloutJS from "@opui/elements/callout.js?raw"

import calloutApi from "../../component-api/callout/api"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import CalloutBuild from "../../components/UnderTheHood/CalloutBuild.astro"

const ThemeCSS = `/* ... */
:where(.ui-critical) {
  --ui-palette-source: oklch(from var(--ui-critical) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-info) {
  --ui-palette-source: oklch(from var(--ui-info) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-success) {
  --ui-palette-source: oklch(from var(--ui-success) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-warning) {
  --ui-palette-source: oklch(from var(--ui-warning) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-neutral) {
  --ui-palette-source: oklch(from var(--ui-neutral) 0.58 c h);
  --ui-palette-hue-rotate-by: 0;
}
/* ... */`

export const keywords = ["alert", "banner", "message box", "notice", "warning"]
---

<Component
  slug="callout"
  heroAnatomy
  apis={[{ title: "Callout API", api: calloutApi }]}
  browserSupport={["has", "invoker-commands"]}
  changelogPaths={[
    {
      path: "packages/opui/components/Callout/Callout.astro",
      type: "component",
    },
    { path: "src/docs/components/callout.astro", type: "docs" },
    { path: "src/component-examples/callout", type: "docs" },
    {
      path: "packages/opui/css/components/callout.css",
      type: "css",
    },
    { path: "packages/opui/elements/callout.js", type: "component" },
    { path: "src/component-api/callout", type: "api" },
  ]}
  installationTabs={[
    { title: "callout.css", code: CalloutCSS, lang: "css" },
    { title: "callout.js", code: CalloutJS, lang: "js" },
    { title: "theme tokens (snippet)", code: ThemeCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Callout</Fragment>
  <Fragment slot="preamble">
    A message in the flow of the page, without interrupting the task.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">A tip, note or warning for a page or section.</li>
    <li slot="when">
      Feedback that stays, like an error summary above a form.
    </li>
    <li slot="when-not">
      Something that needs an answer: use a
      <DocLink href="/components/dialog">Dialog</DocLink>.
    </li>
    <li slot="when-not">
      A short status, like Paid: use a
      <DocLink href="/components/chip">Chip</DocLink>.
    </li>
    <li slot="when-not">
      A confirmation that can go away: use a
      <DocLink href="/components/toast">Toast</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Tonal by default. Use
      <PropOrClass prop='variant="outlined"' class=".ui-outlined" /> for an
      outline.
    </p>

    <AutoExample name="Variants" column />
  </section>

  <section id="severities">
    <h2>Severities</h2>
    <Conditional as="p">
      <Fragment slot="components">Use <code>severity</code>.</Fragment>
      <Fragment slot="html">
        Use a severity class, like <code>.ui-warning</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Severities" column />
  </section>

  <section id="icon">
    <h2>Icon</h2>
    <Conditional as="p">
      <Fragment slot="components">
        <code>CalloutIcon</code> renders the severity's icon. For your own, put
        an <code>&lt;svg aria-hidden="true"&gt;</code> before
        <code>CalloutContent</code>.
      </Fragment>
      <Fragment slot="html">
        Put an <code>&lt;svg aria-hidden="true"&gt;</code> before
        <code>.ui-content</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Icon" column />
  </section>

  <section id="actions">
    <h2>Actions</h2>
    <p>Use <PropOrClass prop="CalloutActions" class=".ui-actions" />.</p>
    <AutoExample name="Actions" column />

    <h3 id="dismissible">Dismissible</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>dismissible</code> for a close button that hides the callout,
        named by <code>closeLabel</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>opui-callout</code> with a close button that has
        <code>command="--dismiss"</code>, and import
        <code>opui-css/elements/callout.js</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Dismissible" column />
  </section>

  <CalloutBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        A callout that appears after an action needs a
        <code>role="status"</code> container already on the page.
      </li>
      <li>
        The icon and color aren't announced: say the severity in the text, like
        "Payment failed".
      </li>
      <li>
        When a <a href="#dismissible">dismissible</a> callout hides with focus
        in it, focus moves to the next focusable element after it, or else the
        one before.
      </li>
      <li>
        The callout fires a cancelable <code>dismiss</code> event first. Listen
        for it to remember the choice, and call <code>preventDefault()</code> to
        keep the callout, for example to ask first.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UICallout severity="info" variant="outlined">
        <UICalloutIcon />
        <UICalloutContent>
          <h3>Title</h3>
          <p>Supporting text that explains the callout in more detail.</p>
        </UICalloutContent>
        <UICalloutActions>
          <UIButton size="small">Action</UIButton>
        </UICalloutActions>
        <UIButton aria-label="Dismiss" round size="small">
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
          >
            <path
              fill="currentColor"
              d="M26.29 4.293a1 1 0 1 1 1.414 1.414L17.413 16l10.291 10.29a1 1 0 1 1-1.414 1.414L16 17.413L5.707 27.704a1 1 0 0 1-1.414-1.414L14.585 16L4.293 5.707a1 1 0 0 1 1.414-1.414L16 14.584z"
            ></path>
          </svg>
        </UIButton>
      </UICallout>
    </Anatomy>
  </Fragment>
</Component>
