---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Callout as UICallout,
  CalloutContent as UICalloutContent,
  CalloutIcon as UICalloutIcon,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"
import CalloutCSS from "@opui/css/components/callout.css?raw"

import calloutApi from "../../component-api/callout/api"

import Conditional from "../../components/Conditional.astro"
import CalloutBuild from "../../components/UnderTheHood/CalloutBuild.astro"

const ThemeCSS = `/* ... */
:where(.ui-critical) {
  --ui-palette-source: oklch(from var(--ui-critical) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-info) {
  --ui-palette-source: oklch(from var(--ui-info) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-success) {
  --ui-palette-source: oklch(from var(--ui-success) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-warning) {
  --ui-palette-source: oklch(from var(--ui-warning) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}

:where(.ui-neutral) {
  --ui-palette-source: oklch(from var(--ui-neutral) 0.58 c h);
  --ui-palette-hue-rotate-by: 0;
}
/* ... */`
---

<Component
  slug="callout"
  heroAnatomy
  apis={[{ title: "Callout API", api: calloutApi }]}
  browserSupport={["has", "relative-color", "scope"]}
  changelogPaths={[
    {
      path: "packages/opui/components/Callout/Callout.astro",
      type: "component",
    },
    { path: "src/docs/components/callout.astro", type: "docs" },
    { path: "src/component-examples/callout", type: "docs" },
    {
      path: "packages/opui/css/components/callout.css",
      type: "css",
    },
    { path: "src/component-api/callout", type: "api" },
  ]}
  installationTabs={[
    { title: "callout.css", code: CalloutCSS, lang: "css" },
    { title: "theme tokens (snippet)", code: ThemeCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Callout</Fragment>
  <Fragment slot="preamble">
    Callouts call out for user attention. Should be part of the flow and used <strong
      >without</strong
    > interrupting the user's task.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A tip, a note or a warning that belongs to a page or a section, read in
      passing.
    </li>
    <li slot="when">
      Feedback that stays on the page, like an error summary above a form or a
      message after saving.
    </li>
    <li slot="when-not">
      Something the user has to answer before going on. Use a <DocLink
        href="/components/dialog">Dialog</DocLink
      >, which takes over completely.
    </li>
    <li slot="when-not">
      A short status on an item, like Paid. Use a <DocLink
        href="/components/chip">Chip</DocLink
      >.
    </li>
    <li slot="when-not">
      A confirmation that can go away by itself, like a saved setting. Use a <DocLink
        href="/components/toast">Toast</DocLink
      >.
    </li>
  </Usage>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Tonal (default) and outlined variants are available via the <code
          >variant</code
        > prop. Put the text in <code>CalloutContent</code>, with an optional
        heading such as an <code>&lt;h3&gt;</code> first. Every heading level gets
        the same title style.
      </Fragment>
      <Fragment slot="html">
        Tonal (default) and <code>.ui-outlined</code> variants. Put the text in <code
          >.ui-content</code
        >, with an optional heading such as an <code>&lt;h3&gt;</code> first. Every
        heading level gets the same title style.
      </Fragment>
    </Conditional>

    <AutoExample name="Variants" column />
  </section>

  <section>
    <h2 id="severities">Severities</h2>
    <Conditional as="p">
      <Fragment slot="components">
        The <code>severity</code> prop accepts <code>critical</code>, <code
          >info</code
        >, <code>neutral</code>, <code>success</code> and <code>warning</code>.
        {" "}<code>neutral</code> is a non-severity tone for brand-tinted attention.
        The default is a plain surface.
      </Fragment>
      <Fragment slot="html">
        Severity modifiers: <code>.ui-critical</code>, <code>.ui-info</code>, <code
          >.ui-neutral</code
        >, <code>.ui-success</code> and <code>.ui-warning</code>.
        {" "}<code>.ui-neutral</code> is a non-severity tone for brand-tinted attention.
        The default is a plain surface.
      </Fragment>
    </Conditional>

    <div class="ui-not-rich-text">
      <UICallout severity="info">
        <UICalloutIcon />
        <UICalloutContent>
          <h3>Icons and accessibility</h3>
          <p>
            Omitting an icon is possible. However, it helps having one if you
            need to convey a specific kind of severity in your Callout message.
            For instance, colorblind users might be left confused if there's not
            enough visual guidance.
          </p>
        </UICalloutContent>
      </UICallout>
    </div>

    <AutoExample name="Severities" column />
  </section>

  <section>
    <h2 id="icon">Icon</h2>
    <Conditional as="p">
      <Fragment slot="components">
        <code>CalloutIcon</code> renders the default icon for <code>info</code>,
        <code>success</code>, <code>warning</code> and <code>critical</code>.
        For a custom icon, put your own <code
          >&lt;svg aria-hidden="true"&gt;</code
        > in the <code>Callout</code> instead, before <code>CalloutContent</code
        >.
      </Fragment>
      <Fragment slot="html">
        There are no default icons in HTML: put an <code
          >&lt;svg aria-hidden="true"&gt;</code
        > before <code>.ui-content</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Icon" column />
  </section>

  <CalloutBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        The Callout is an <code>&lt;article&gt;</code>, so screen readers
        announce it as self-contained content.
      </li>
      <li>
        Use both color and icon to help distinguish between Callout <a
          href="#severities">severities</a
        >. The icon is hidden from screen readers, so say the severity in the
        text, for example with a title like Warning.
      </li>
    </ul>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UICallout severity="info" variant="outlined">
        <UICalloutIcon />
        <UICalloutContent>
          <h3>Title</h3>
          <p>Supporting text that explains the callout in more detail.</p>
        </UICalloutContent>
      </UICallout>
    </Anatomy>
  </Fragment>
</Component>
