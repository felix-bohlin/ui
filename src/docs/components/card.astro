---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Button as UIButton,
  Callout as UICallout,
  CalloutContent as UICalloutContent,
  Card as UICard,
  CardActions as UICardActions,
  CardContent as UICardContent,
  CardHeader as UICardHeader,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import CardCSS from "@opui/css/components/card.css?raw"
import Conditional from "../../components/Conditional.astro"
import CardBuild from "../../components/UnderTheHood/CardBuild.astro"

import cardApi from "../../component-api/card/api"
import cardActionsApi from "../../component-api/card-actions/api"
import cardHeaderApi from "../../component-api/card-header/api"

export const keywords = ["panel", "surface", "tile"]
---

<Component
  slug="card"
  heroAnatomy
  apis={[
    { title: "Card API", api: cardApi },
    { title: "Card header API", api: cardHeaderApi },
    { title: "Card actions API", api: cardActionsApi },
  ]}
  browserSupport={["container-queries", "container-style-queries", "has"]}
  changelogPaths={[
    {
      path: "packages/opui/components/Card/Card.astro",
      type: "component",
    },
    { path: "src/docs/components/card.astro", type: "docs" },
    { path: "src/component-examples/card", type: "docs" },
    {
      path: "packages/opui/css/components/card.css",
      type: "css",
    },
    { path: "src/component-api/card", type: "api" },
  ]}
  installationTabs={[{ title: "card.css", code: CardCSS, lang: "css" }]}
>
  <Fragment slot="title">Card</Fragment>
  <Fragment slot="preamble">
    A surface for related content and actions.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Self-contained content, like a product or a plan.</li>
    <li slot="when">Related content set apart, like one feature's settings.</li>
    <li slot="when">
      A box that links somewhere: a <a href="#clickable">clickable card</a>.
    </li>
    <li slot="when-not">
      Every section of a page: use headings and the
      <DocLink href="/components/layout">Layout</DocLink> classes.
    </li>
    <li slot="when-not">
      Rows of similar items: use a
      <DocLink href="/components/list">List</DocLink> or a
      <DocLink href="/components/table">Table</DocLink>.
    </li>
    <li slot="when-not">
      A message about the page: use a
      <DocLink href="/components/callout">Callout</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Plain by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Plain by default. Use <code>.ui-elevated</code>,
        <code>.ui-outlined</code>, <code>.ui-tonal</code> or
        <code>.ui-transparent</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column />
  </section>

  <section id="colors">
    <h2>Colors</h2>
    <p>
      Use <PropOrClass prop='color="primary"' class=".ui-primary" /> for the
      card that stands out.
    </p>
    <AutoExample name="Colors" column />
  </section>

  <section id="density">
    <h2>Density</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>density</code> or <code>--ui-card-padding</code> to change
        density.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-dense</code>, <code>.ui-spacious</code> or
        <code>--ui-card-padding</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Density" column />
  </section>

  <section id="header">
    <h2>Header</h2>
    <AutoExample name="Header" column />

    <h3 id="header-row">Header row</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>CardHeader as="div"</code> with an <code>hgroup</code> inside.
      </Fragment>
      <Fragment slot="html">
        Use a <code>div.ui-header</code> with an <code>hgroup</code> inside.
      </Fragment>
    </Conditional>
    <AutoExample name="HeaderActions" column />
  </section>

  <section id="media">
    <h2>Media</h2>
    <p>
      An image as a direct child runs to the edges. Crop it with
      <code>aspect-ratio</code>.
    </p>
    <AutoExample name="Media" column />
  </section>

  <section id="actions">
    <h2>Actions</h2>
    <AutoExample name="Actions" column />

    <h3 id="actions-alignment">Alignment</h3>
    <p>
      Actions sit at the end. Use
      <PropOrClass prop='align="start"' class=".ui-align-start" /> to change it.
    </p>
    <AutoExample name="Alignment" column />
  </section>

  <section id="orientation">
    <h2>Orientation</h2>
    <Conditional as="p">
      <Fragment slot="components">
        An image first goes beside the content from <code>40rem</code>. Use
        <code>orientation</code> to fix it.
      </Fragment>
      <Fragment slot="html">
        An image first goes beside the content from <code>40rem</code>. Use
        <code>.ui-horizontal</code> or <code>.ui-vertical</code> to fix it.
      </Fragment>
    </Conditional>
    <AutoExample name="Orientation" column />
  </section>

  <section id="clickable">
    <h2>Clickable card</h2>
    <p>Add <code>.ui-card-link</code> to the link in the heading.</p>
    <AutoExample name="Clickable" column />
    <div class="ui-not-rich-text">
      <UICallout>
        <UICalloutContent>
          <div class="ui-rich-text">
            Only one <code>.ui-card-link</code> per card. The link covers the
            text, so text in the card can't be selected.
          </div>
        </UICalloutContent>
      </UICallout>
    </div>
  </section>

  <section id="semantics">
    <h2>Semantics</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>as="article"</code> or <code>as="section"</code>.
      </Fragment>
      <Fragment slot="html">
        Use an <code>article</code> or a <code>section</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Semantics" column />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        A card is a <code>div</code> with no role, so screen readers read its
        content in place. Make cards in a feed <code>article</code>s (see
        <a href="#semantics">Semantics</a>).
      </li>
      <li>
        A <code>section</code> card is a region only when it has a name, such as
        <code>aria-labelledby</code> pointing at its heading.
      </li>
      <li>
        In a clickable card, the link's name is the heading, so put what tells
        the cards apart there. Buttons and links in the card stay their own tab
        stops.
      </li>
    </ul>
  </Fragment>

  <CardBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy>
      <UICard variant="elevated" style="inline-size: 20rem">
        <img
          alt="Green cliffs and a winding road under a cloudy sky"
          height="450"
          src="https://picsum.photos/id/1018/800/450"
          width="800"
        />
        <UICardHeader>
          <p>Overline</p>
          <h2 class="ui-h3">Headline</h2>
          <p>Subhead</p>
        </UICardHeader>
        <UICardContent>
          Explain more about the topic shown in the headline and subhead through
          supporting text.
        </UICardContent>
        <UICardActions>
          <UIButton>Share</UIButton>
          <UIButton>Learn more</UIButton>
        </UICardActions>
      </UICard>
    </Anatomy>
  </Fragment>
</Component>
