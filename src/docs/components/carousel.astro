---
import Component from "../../layouts/Component.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import { Callout as UICallout } from "@opui/astro"

import CarouselCSS from "@opui/css/components/carousel.css?raw"

export const description =
  "A horizontally scrolling list with snap points, previous and next buttons, and markers. Built with CSS only."
---

<Component
  description={description}
  slug="carousel"
  browserSupport={[
    "anchor-positioning",
    "scroll-buttons",
    "scroll-markers",
    "scroll-snap",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Carousel/Carousel.astro",
      type: "component",
    },
    { path: "src/docs/components/carousel.astro", type: "docs" },
    { path: "src/component-examples/carousel", type: "docs" },
    { path: "packages/opui/css/components/carousel.css", type: "css" },
    { path: "src/component-api/carousel", type: "api" },
  ]}
  installationTabs={[
    { title: "carousel.css", code: CarouselCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Carousel</Fragment>
  <Fragment slot="preamble">
    <p>
      A <code>&lt;ul&gt;</code> that scrolls and snaps. The buttons and markers
      are generated by CSS (<code>::scroll-button()</code> and
      <code>::scroll-marker</code>), so there's no JavaScript. Put anything you
      want in the items.
    </p>
  </Fragment>

  <div class="ui-not-rich-text">
    <UICallout severity="info">
      <Fragment slot="title">Progressive enhancement</Fragment>
      <p>
        Browsers without scroll buttons and markers get a regular scroller with
        snap points and a scrollbar.
      </p>
    </UICallout>
  </div>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Add <code>.ui-carousel</code> to a <code>&lt;ul&gt;</code> and give it an
        <code>aria-label</code>. Add <code>.ui-with-buttons</code> for previous
        and next buttons and <code>.ui-with-markers</code> for markers.
      </Fragment>
      <Fragment slot="astro">
        Put <code>&lt;li&gt;</code> items in the default slot and pass a
        <code>label</code>. Buttons are on by default, and <code>markers</code>
        adds markers.
      </Fragment>
      <Fragment slot="vue">
        Put <code>&lt;li&gt;</code> items in the default slot and pass a
        <code>label</code>. Buttons are on by default, and <code>markers</code>
        adds markers.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" />

    <p>
      The markers are rendered after the list, as its sibling. In a flex or grid
      parent they become a separate item, so wrap the carousel in an element of
      its own when that happens.
    </p>
  </section>

  <section>
    <h2 id="per-view">Items per view</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Set <code>--_per-view</code> to show more than one item at a time.
      </Fragment>
      <Fragment slot="astro">
        Use the <code>perView</code> prop to show more than one item at a time.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>perView</code> prop to show more than one item at a time.
      </Fragment>
    </Conditional>

    <AutoExample name="PerView" />
  </section>

  <section>
    <h2 id="peek">Peek</h2>
    <Conditional as="p">
      <Fragment slot="html">
        <code>.ui-peek</code> shows a bit of the neighbouring items.
        <code>.ui-align-center</code> snaps items to the center.
      </Fragment>
      <Fragment slot="astro">
        <code>peek</code> shows a bit of the neighbouring items.
        <code>align="center"</code> snaps items to the center.
      </Fragment>
      <Fragment slot="vue">
        <code>peek</code> shows a bit of the neighbouring items.
        <code>align="center"</code> snaps items to the center.
      </Fragment>
    </Conditional>

    <AutoExample name="Peek" />
  </section>

  <section>
    <h2 id="customize">Customize</h2>
    <p>
      Every size, color, icon and label is a custom property on
      <code>.ui-carousel</code>. See <a href="#api" class="ui-link">API</a> for
      the full list.
    </p>

    <AutoExample name="Customize" />
  </section>

  <Fragment slot="accessibility">
    <p>
      Items are list items, so screen readers announce the position (e.g. "2 of
      5"). The buttons are named "Previous" and "Next" and are disabled at the
      ends. Markers are exposed as tabs named <code>--_marker-label</code> plus
      the item number. The list itself is scrollable with the keyboard.
    </p>
  </Fragment>
</Component>
