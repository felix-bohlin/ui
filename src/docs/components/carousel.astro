---
import Component from "../../layouts/Component.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import DocLink from "../../components/DocLink.astro"

import CarouselCSS from "@opui/css/components/carousel.css?raw"

export const description =
  "A scrolling list with snap points, buttons and markers. CSS only."
---

<Component
  description={description}
  slug="carousel"
  browserSupport={[
    "anchor-positioning",
    "scroll-buttons",
    "scroll-markers",
    "scroll-snap",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Carousel/Carousel.astro",
      type: "component",
    },
    { path: "src/docs/components/carousel.astro", type: "docs" },
    { path: "src/component-examples/carousel", type: "docs" },
    { path: "packages/opui/css/components/carousel.css", type: "css" },
    { path: "src/component-api/carousel", type: "api" },
  ]}
  installationTabs={[
    { title: "carousel.css", code: CarouselCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Carousel</Fragment>
  <Fragment slot="preamble">
    <p>
      A scrolling list of anything, e.g. <DocLink href="/components/card"
        >Cards</DocLink
      >. CSS only. Falls back to a regular scroller.
    </p>
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="html">
        <code>ul.ui-carousel</code> with an <code>aria-label</code>. Add
        <code>.ui-with-buttons</code> and <code>.ui-with-markers</code>.
      </Fragment>
      <Fragment slot="astro">
        <code>&lt;li&gt;</code> items and a <code>label</code>. Add
        <code>markers</code>.
      </Fragment>
      <Fragment slot="vue">
        <code>&lt;li&gt;</code> items and a <code>label</code>. Add
        <code>markers</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" />

    <p>
      Markers render after the list, so wrap the carousel when its parent is
      flex or grid.
    </p>
  </section>

  <section>
    <h2 id="per-view">Items per view</h2>
    <Conditional as="p">
      <Fragment slot="html"><code>--_per-view</code>.</Fragment>
      <Fragment slot="astro"><code>perView</code>.</Fragment>
      <Fragment slot="vue"><code>perView</code>.</Fragment>
    </Conditional>

    <AutoExample name="PerView" />
  </section>

  <section>
    <h2 id="peek">Peek</h2>
    <Conditional as="p">
      <Fragment slot="html">
        <code>.ui-peek</code>, and <code>.ui-align-center</code> to snap to the
        center.
      </Fragment>
      <Fragment slot="astro">
        <code>peek</code>, and <code>align="center"</code> to snap to the center.
      </Fragment>
      <Fragment slot="vue">
        <code>peek</code>, and <code>align="center"</code> to snap to the center.
      </Fragment>
    </Conditional>

    <AutoExample name="Peek" />
  </section>

  <section>
    <h2 id="customize">Customize</h2>
    <p>
      See <a href="#api" class="ui-link">API</a> for all custom properties.
    </p>

    <AutoExample name="Customize" />
  </section>

  <Fragment slot="accessibility">
    <p>
      Screen readers announce the item position. Buttons are named "Previous"
      and "Next". Markers are named <code>--_marker-label</code> + number.
    </p>
  </Fragment>
</Component>
