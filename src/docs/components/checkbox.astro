---
import FieldGroupNotes from "./partials/FieldGroupNotes.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import LabelAlignment from "./partials/LabelAlignment.astro"
import Usage from "./partials/Usage.astro"
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import {
  Checkbox as UICheckbox,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
import CheckboxCSS from "@opui/css/components/checkbox.css?raw"
import ChoiceCSS from "@opui/css/components/choice.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"
import SelectAllCSS from "@opui/css/components/select-all.css?raw"
import SelectAllJS from "@opui/elements/select-all.js?raw"

import checkboxApi from "../../component-api/checkbox/api"
import checkboxInputApi from "../../component-api/checkbox-input/api"
import fieldGroupApi from "../../component-api/field-group/api"
import selectAllApi from "../../component-api/select-all/api"

import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import CheckboxBuild from "../../components/UnderTheHood/CheckboxBuild.astro"

export const keywords = ["check", "tick"]
---

<Component
  slug="checkbox"
  heroAnatomy
  browserSupport={[
    "container-style-queries",
    "has",
    "lh",
    "light-dark",
    "relative-color",
    "user-pseudos",
  ]}
  apis={[
    { title: "Checkbox API", api: checkboxApi },
    { title: "Checkbox input API", api: checkboxInputApi },
    { title: "Field group API", api: fieldGroupApi },
    { title: "Select all API", api: selectAllApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Checkbox",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/checkbox.astro", type: "docs" },
    { path: "src/component-examples/checkbox", type: "docs" },
    {
      path: "packages/opui/css/components/checkbox.css",
      type: "css",
    },
    { path: "src/component-api/checkbox", type: "api" },
    { path: "src/component-api/checkbox-input", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
    {
      path: "packages/opui/components/SelectAll",
      type: "component",
    },
    { path: "packages/opui/elements/select-all.js", type: "component" },
    { path: "src/component-api/select-all", type: "api" },
  ]}
  installationTabs={[
    { title: "checkbox.css", code: CheckboxCSS, lang: "css" },
    { title: "choice.css", code: ChoiceCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", isDependency: true },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
    { title: "select-all.css", code: SelectAllCSS, lang: "css" },
    { title: "select-all.js", code: SelectAllJS, lang: "js" },
  ]}
>
  <Fragment slot="title">Checkbox</Fragment>
  <Fragment slot="preamble">
    Choices submitted with a form. For a setting that applies right away, use a
    <DocLink href="/components/switch">Switch</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">A choice submitted with a form, like agreeing to terms.</li>
    <li slot="when">
      Several options from a short list: a <a href="#field-group">field group</a
      >.
    </li>
    <li slot="when">
      Selecting all items: <a href="#select-all">select all</a>.
    </li>
    <li slot="when-not">
      A setting that applies right away: use a
      <DocLink href="/components/switch">Switch</DocLink>.
    </li>
    <li slot="when-not">
      One choice out of several: use a
      <DocLink href="/components/radio">Radio</DocLink> group.
    </li>
    <li slot="when-not">
      Toolbar options: use a <DocLink href="/components/toggle">Toggle</DocLink
      >.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>
      A checked checkbox fills with the accent. A theme that sets
      <code>--ui-choice-checked: mark</code> keeps the box and draws only the
      check in the accent.
    </p>
    <AutoExample name="Basics" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section id="visible-label">
    <h2>Visible label</h2>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="hidden-label">Hidden label</h3>
    <p>Use <PropOrClass prop="hideLabel" class=".ui-sr-only" />.</p>
    <AutoExample name="HiddenLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <p>
      Use <PropOrClass prop='orientation="vertical"' class=".ui-vertical" /> to
      put the label under the checkbox.
    </p>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <p>Use <PropOrClass prop="endText" class=".ui-end-text" />.</p>
    <AutoExample name="EndText" row spacious />

    <h3 id="validation">Validation</h3>
    <ValidationNotes element="input" named subject="Checkboxes" />

    <AutoExample name="Validation" column spacious />
  </section>

  <section id="indeterminate">
    <h2>Indeterminate</h2>
    <Conditional as="p">
      <Fragment slot="components"> Set <code>indeterminate</code>. </Fragment>
      <Fragment slot="html">
        Add <code>data-indeterminate</code> and import
        <code>opui-css/css/js/checkbox.js</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="IndeterminateBasics" row />

    <h3 id="select-all">Select all</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Wrap the group in <code>SelectAll</code> and add
        <code>data-select-all</code> to the controlling checkbox.
      </Fragment>
      <Fragment slot="html">
        Wrap the group in <code>opui-select-all</code>, add
        <code>data-select-all</code> and import
        <code>opui-css/elements/select-all.js</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Indeterminate" column centered spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the checkbox at the
      end.
    </p>

    <AutoExample name="Spread" column />
  </section>

  <section id="cards">
    <h2>Cards</h2>
    <p>
      Use <PropOrClass prop="card" class=".ui-card" />, with
      <PropOrClass prop="spread" class=".ui-spread" />.
    </p>

    <AutoExample name="CardsMatrix" column />
  </section>

  <section id="label-alignment">
    <h2>Label alignment</h2>
    <LabelAlignment control="checkbox" />
  </section>

  <section id="field-group">
    <h2>Field group</h2>
    <FieldGroupNotes control="checkbox">
      <AutoExample name="FieldGroup" centered column />
    </FieldGroupNotes>
  </section>

  <CheckboxBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="labels">Labels</h3>
    <p>
      Accessible checkboxes must have a label. You can choose between three
      approaches:
    </p>
    <Table>
      <TableHead>
        <TableRow>
          <TableHeaderCell>Approach</TableHeaderCell>
          <TableHeaderCell>Usage in Checkbox component</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell>
            Provide a label text inside the <code>label</code> element
          </TableCell>
          <TableCell>Default</TableCell>
        </TableRow>
        <TableRow>
          <TableCell
            >Add an <code>aria-label</code> on the input element</TableCell
          >
          <TableCell>Not used</TableCell>
        </TableRow>
        <TableRow>
          <TableCell>
            Have a visible label that you reference with
            <code>aria-labelledby</code>
          </TableCell>
          <TableCell>Not used</TableCell>
        </TableRow>
      </TableBody>
    </Table>

    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UICheckbox checked>
        Label
        <Fragment slot="end-text">End text</Fragment>
      </UICheckbox>
    </Anatomy>
  </Fragment>
</Component>
