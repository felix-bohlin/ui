---
import LabelAlignment from "./partials/LabelAlignment.astro"
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import {
  Callout as UICallout,
  CalloutContent as UICalloutContent,
  Checkbox as UICheckbox,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
import CheckboxCSS from "@opui/css/components/checkbox.css?raw"
import ChoiceCSS from "@opui/css/components/choice.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import checkboxApi from "../../component-api/checkbox/api"
import checkboxInputApi from "../../component-api/checkbox-input/api"
import fieldGroupApi from "../../component-api/field-group/api"

import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import CheckboxBuild from "../../components/UnderTheHood/CheckboxBuild.astro"
---

<Component
  slug="checkbox"
  heroAnatomy
  browserSupport={["has", "lh", "light-dark", "relative-color", "user-pseudos"]}
  apis={[
    { title: "Checkbox API", api: checkboxApi },
    { title: "Checkbox input API", api: checkboxInputApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Checkbox",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/checkbox.astro", type: "docs" },
    { path: "src/component-examples/checkbox", type: "docs" },
    {
      path: "packages/opui/css/components/checkbox.css",
      type: "css",
    },
    { path: "src/component-api/checkbox", type: "api" },
    { path: "src/component-api/checkbox-input", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "checkbox.css", code: CheckboxCSS, lang: "css" },
    { title: "choice.css", code: ChoiceCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", isDependency: true },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Checkbox</Fragment>
  <Fragment slot="preamble">
    Use a Checkbox for choices that are submitted with a form. For a setting
    that applies right away, use a <DocLink href="/components/switch"
      >Switch</DocLink
    >, and for options in a toolbar a <DocLink href="/components/toggle"
      >Toggle</DocLink
    >. See also: <a href="#field-group" class="ui-link">Checkbox field group</a
    >.
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <AutoExample name="Basics" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, <code>medium</code> (the default) and <code
          >large</code
        >.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>, on the <code
          >&lt;label class="ui-checkbox"&gt;</code
        >.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section>
    <h2 id="visible-label">Visible label</h2>
    <Conditional as="p">
      <Fragment slot="components"
        >The default slot is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="html"
        >Render the label text inside an element with a <code>.ui-label</code> class.
        Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="react"
        ><code>children</code> is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="svelte"
        >The <code>children</code> snippet is the label. Also, don't miss the info
        on label <a href="#accessibility" class="ui-link">accessibility</a
        >.</Fragment
      >
    </Conditional>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="hidden-label">Hidden label</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>hideLabel</code> to keep the label for screen readers only. The
        checkbox then centers in a table cell or a line of text, and keeps a 24px
        click target.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-sr-only</code> instead of <code>.ui-label</code> to keep the
        label for screen readers only. The checkbox then centers in a table cell or
        a line of text, and keeps a 24px click target.
      </Fragment>
    </Conditional>
    <AutoExample name="HiddenLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <p>
      Use <PropOrClass prop='orientation="vertical"' class=".ui-vertical" /> to put
      the label under the checkbox.
    </p>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <Conditional as="p">
      <Fragment slot="components"
        >Use the <code>endText</code> prop or the <code>end-text</code> slot for supporting
        text under the label. It sits inside the <code>&lt;label&gt;</code>, so
        screen readers read it with the label.</Fragment
      >
      <Fragment slot="html"
        >Add a <code>&lt;span class="ui-end-text"&gt;</code> after the <code
          >.ui-label</code
        > for supporting text under the label. It sits inside the <code
          >&lt;label&gt;</code
        >, so screen readers read it with the label.</Fragment
      >
      <Fragment slot="react"
        >Use the <code>endText</code> prop for supporting text under the label. It
        sits inside the <code>&lt;label&gt;</code>, so screen readers read it
        with the label.</Fragment
      >
      <Fragment slot="svelte"
        >Use the <code>endText</code> prop for supporting text under the label. It
        sits inside the <code>&lt;label&gt;</code>, so screen readers read it
        with the label.</Fragment
      >
    </Conditional>
    <AutoExample name="EndText" row spacious />

    <h3 id="validation">Validation</h3>
    <ValidationNotes element="input" named subject="Checkboxes" />

    <AutoExample name="Validation" column spacious />
  </section>

  <section>
    <h2 id="indeterminate">Indeterminate</h2>
    <Conditional>
      <Fragment slot="astro">
        <p>
          Set the <code>indeterminate</code> prop to render a partially-selected state.
          {" "}<code>indeterminate</code> is a JavaScript-only property on <code
            >HTMLInputElement</code
          >, so the component renders <code>data-indeterminate</code> and applies
          the property at runtime.
        </p>

        <div class="ui-not-rich-text">
          <UICallout>
            <UICalloutContent>
              <h3>JavaScript required</h3>
              <div class="ui-rich-text">
                The <code>indeterminate</code> state cannot be set with HTML or CSS
                alone. The browser only exposes it as a property on <code
                  >HTMLInputElement</code
                >, so the component ships a script that sets <code
                  >el.indeterminate = true</code
                > on load. The <code>:indeterminate</code> CSS pseudo-class then matches
                and the dash glyph appears. To change the state later, set
                <code>el.indeterminate</code> yourself, as the example does.
              </div>
            </UICalloutContent>
          </UICallout>
        </div>
      </Fragment>
      <Fragment slot="components">
        <p>
          Set the <code>indeterminate</code> prop to render a partially-selected state.
          {" "}<code>indeterminate</code> is a JavaScript-only property on <code
            >HTMLInputElement</code
          >, so the component renders <code>data-indeterminate</code> and applies
          the property at runtime.
        </p>
      </Fragment>
      <div slot="html" class="ui-not-rich-text">
        <p>
          Add <code>data-indeterminate</code> to the <code
            >&lt;input type="checkbox"&gt;</code
          > and call <code>activateIndeterminate()</code> from <code
            >opui-css/css/js/checkbox.js</code
          > once the element is in the DOM. The attribute alone has no effect. When
          you add or remove <code>data-indeterminate</code> later, call <code
            >syncIndeterminate(input)</code
          >.
        </p>

        <UICallout>
          <UICalloutContent>
            <h3>JavaScript required</h3>
            <div class="ui-rich-text">
              The <code>indeterminate</code> state cannot be set with HTML or CSS
              alone. The browser only exposes it as a property on <code
                >HTMLInputElement</code
              >, so <code>activateIndeterminate()</code> sets <code
                >el.indeterminate = true</code
              > on every input with <code>data-indeterminate</code>. The <code
                >:indeterminate</code
              > CSS pseudo-class then matches and the dash glyph appears.
            </div>
          </UICalloutContent>
        </UICallout>
      </div>
    </Conditional>

    <AutoExample name="Indeterminate" column centered spacious />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>spread</code> prop to push the label to the left and the checkbox
        to the right. Handy for full-width items like lists and menus, and for <a
          class="ui-link"
          href="#cards">cards</a
        >.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to the <code
          >&lt;label class="ui-checkbox"&gt;</code
        >
        {" "}to push the label to the left and the checkbox to the right. Handy
        for full-width items like lists and menus, and for <a
          class="ui-link"
          href="#cards">cards</a
        >.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column />
  </section>

  <section>
    <h2 id="cards">Cards</h2>
    <Conditional as="p">
      <Fragment slot="components">
        <code>card</code> renders the checkbox as a card that tints when hovered and
        when checked. Combine it with <code>spread</code> for the checkbox at the
        end, and <code>variant="tonal"</code> or
        <code>variant="elevated"</code> for the surface, like a <DocLink
          href="/components/card"
          class="ui-link">Card</DocLink
        >. In a horizontal <code>FieldGroup</code> the cards share the row.
      </Fragment>
      <Fragment slot="html">
        <code>.ui-card</code> renders the checkbox as a card that tints when hovered
        and when checked. Combine it with <code>.ui-spread</code> for the checkbox
        at the end, and <code>.ui-tonal</code> or
        <code>.ui-elevated</code> for the surface, like a <DocLink
          href="/components/card"
          class="ui-link">Card</DocLink
        >. In a <code>.ui-field-group.ui-horizontal</code> the cards share the row.
      </Fragment>
    </Conditional>

    <AutoExample name="CardsMatrix" column />
  </section>

  <section>
    <h2 id="label-alignment">Label alignment</h2>
    <LabelAlignment control="checkbox" />
  </section>

  <section>
    <h2 id="field-group">Field group</h2>
    <p>Use field groups to group related checkboxes.</p>
    <Conditional>
      <p slot="components">
        The <code>name</code> prop will get passed down to each checkbox in the group.
      </p>
      <p slot="html">
        Give every <code>&lt;input type="checkbox"&gt;</code> in the group the same
        {" "}<code>name</code> attribute so they're submitted together.
      </p>
    </Conditional>
    <p>
      See also: <DocLink href="/components/form" class="ui-link"
        >Form documentation</DocLink
      >.
    </p>

    <AutoExample name="FieldGroup" centered column />

    <h3 id="field-group-orientation">Orientation</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Checkboxes stack vertically by default. Set <code
          >orientation="horizontal"</code
        > on the
        <code>FieldGroup</code> to put them in a row.
      </Fragment>
      <Fragment slot="html">
        Checkboxes stack vertically by default. Add <code>.ui-horizontal</code> to
        the
        <code>.ui-field-group</code> to put them in a row.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldGroupOrientation" row />

    <h3 id="field-group-field-description">Field description</h3>
    <p>Can be placed above and below the fields.</p>
    <AutoExample name="FieldGroupFieldDescription" column centered spacious />

    <h3 id="field-group-disabled">Disabled</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>disabled</code> on the <code>Fieldset</code> to disable every checkbox
        in it, or on a single <code>Checkbox</code>.
      </Fragment>
      <Fragment slot="html">
        Attach the <code>disabled</code> attribute to the <code
          >&lt;fieldset&gt;</code
        > element to disable every checkbox in it, or to a single <code
          >&lt;input&gt;</code
        >.
      </Fragment>
    </Conditional>
    <p>
      <code>aria-disabled="true"</code> on the <code>&lt;input&gt;</code> looks the
      same, but keeps the checkbox focusable and its value in the form. It doesn't
      stop the change, so block it with a script.
    </p>
    <AutoExample name="FieldGroupDisabled" row />

    <h3 id="field-group-required">Required</h3>
    <p>
      Each checkbox with <code>required</code> must be checked before the form submits.
      There's no native "at least one" for checkboxes.
    </p>
    <AutoExample name="FieldGroupRequired" row />

    <h3 id="field-group-validation">Validation</h3>
    <Conditional>
      <p slot="components">
        Set <code>error</code> on each <code>Checkbox</code> in the group. The end
        text of the <code>Fieldset</code> turns red with them.
      </p>
      <p slot="html">
        Add <code>aria-invalid="true"</code> to each <code>&lt;input&gt;</code> in
        the group. The end text of the <code>.ui-fieldset</code> turns red with them.
      </p>
    </Conditional>
    <p>
      Give the end text an <code>id</code> and point <code
        >aria-describedby</code
      >
      on the fieldset at it, so screen readers read the error with the group.
    </p>
    <AutoExample name="FieldGroupValidation" row />

    <h3 id="field-group-binding">Binding</h3>
    <Conditional as="p">
      <Fragment slot="astro">
        Astro renders the group on the server, so it has no bound value. The
        checked values live in the inputs, which share the group's <code
          >name</code
        >. Submit them with a form, where <code>FormData.getAll()</code> reads them,
        or read the checked inputs in a script on <code>change</code>. Set <code
          >input.checked = input.defaultChecked</code
        > to go back to the <code>checked</code> boxes.
      </Fragment>
      <Fragment slot="html">
        The checked values live in the inputs, which share a <code>name</code>.
        Submit them with a form, where <code>FormData.getAll()</code> reads them,
        or read the checked inputs in a script on <code>change</code>. Set <code
          >input.checked = input.defaultChecked</code
        > to go back to the <code>checked</code> inputs in the markup.
      </Fragment>
      <Fragment slot="react">
        Keep the checked values in your own state. Pass each <code
          >Checkbox</code
        > a <code>checked</code> and an <code>onChange</code> that adds or removes
        its <code>value</code>.
      </Fragment>
      <Fragment slot="svelte">
        Bind the checked values with <code>bind:group</code> on each <code
          >Checkbox</code
        >. The array holds the <code>value</code> of every checked box, and setting
        it updates the boxes.
      </Fragment>
      <Fragment slot="vue">
        Bind the checked values with <code>v-model</code> and an array ref on each
        <code>Checkbox</code>. The array holds the <code>value</code> of every checked
        box, and setting it updates the boxes.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldGroupBinding" centered column />
  </section>

  <CheckboxBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="labels">Labels</h3>
    <p>
      Accessible checkboxes must have a label. You can choose between three
      approaches:
    </p>
    <Table>
      <TableHead>
        <TableRow>
          <TableHeaderCell>Approach</TableHeaderCell>
          <TableHeaderCell>Usage in Checkbox component</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell>
            Provide a label text inside the <code>label</code> element
          </TableCell>
          <TableCell>Default</TableCell>
        </TableRow>
        <TableRow>
          <TableCell
            >Add an <code>aria-label</code> on the input element</TableCell
          >
          <TableCell>Not used</TableCell>
        </TableRow>
        <TableRow>
          <TableCell>
            Have a visible label that you reference with <code
              >aria-labelledby</code
            >
          </TableCell>
          <TableCell>Not used</TableCell>
        </TableRow>
      </TableBody>
    </Table>

    <h3 id="keyboard-support">Keyboard support</h3>
    <div class="ui-not-rich-text">
      <Table>
        <TableHead>
          <TableRow>
            <TableHeaderCell>Key</TableHeaderCell>
            <TableHeaderCell>Function</TableHeaderCell>
          </TableRow>
        </TableHead>
        <TableBody>
          <TableRow>
            <TableCell><kbd>Space</kbd></TableCell>
            <TableCell>When Checkbox is focused it changes its state.</TableCell
            >
          </TableRow>
        </TableBody>
      </Table>
    </div>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UICheckbox checked>
        Label
        <Fragment slot="end-text">End text</Fragment>
      </UICheckbox>
    </Anatomy>
  </Fragment>
</Component>
