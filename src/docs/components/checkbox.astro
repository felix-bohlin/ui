---
import { Code } from "astro-expressive-code/components"
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import { Callout as UICallout, Checkbox as UICheckbox } from "@opui/astro"
import CheckboxCSS from "@opui/css/components/checkbox.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import checkboxApi from "../../component-api/checkbox/api"
import fieldGroupApi from "../../component-api/field-group/api"

import Conditional from "../../components/Conditional.astro"
import CheckboxBuild from "../../components/UnderTheHood/CheckboxBuild.astro"
---

<Component
  slug="checkbox"
  heroAnatomy
  browserSupport={["has", "light-dark", "relative-color", "user-pseudos"]}
  apis={[
    { title: "Checkbox API", api: checkboxApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Checkbox",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/checkbox.astro", type: "docs" },
    { path: "src/component-examples/checkbox", type: "docs" },
    {
      path: "packages/opui/css/components/checkbox.css",
      type: "css",
    },
    { path: "src/component-api/checkbox", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "checkbox.css", code: CheckboxCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", seeAlso: true },
  ]}
>
  <Fragment slot="title">Checkbox</Fragment>
  <Fragment slot="preamble">
    Use a Checkbox for choices that are submitted with a form. For a setting
    that applies right away, use a <DocLink href="/components/switch"
      >Switch</DocLink
    >, and for options in a toolbar a <DocLink href="/components/toggle"
      >Toggle</DocLink
    >. See also: <a href="#field-group" class="ui-link">Checkbox field group</a
    >.
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>, on the <code
          >&lt;label class="ui-checkbox"&gt;</code
        >.
      </Fragment>
      <Fragment slot="vue">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section>
    <h2 id="visible-label">Visible label</h2>
    <Conditional as="p">
      <Fragment slot="astro"
        >The default slot is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="html"
        >Render the label text inside an element with a <code>.ui-label</code> class.
        Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="vue"
        >The default slot is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
    </Conditional>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <AutoExample name="SupportingText" row spacious />

    <h3 id="validation">Validation</h3>
    <ul>
      <Conditional>
        <li slot="astro">
          Set <code>required</code> on the component to toggle required styles on
          the input.
        </li>
        <li slot="vue">
          Add the <code>required</code> attribute on the component. It is forwarded
          to the underlying <code>&lt;input&gt;</code>.
        </li>
        <li slot="html">
          Add <code>[required]</code> to the <code>&lt;input&gt;</code> element to
          toggle required styles.
        </li>
      </Conditional>
      <Conditional>
        <li slot="astro">
          Use the <code>error</code> prop to toggle invalid styles. It sets <code
            >aria-invalid="true"</code
          > on the input, so screen readers announce it as invalid. Make use of the
          end text to give extra feedback on the error.
        </li>
        <li slot="vue">
          Use the <code>error</code> prop to toggle invalid styles. It sets <code
            >aria-invalid="true"</code
          > on the input, so screen readers announce it as invalid. Make use of the
          end text to give extra feedback on the error.
        </li>
        <li slot="html">
          Add <code>aria-invalid="true"</code> to the <code>&lt;input&gt;</code> to
          toggle invalid styles. Screen readers announce it as invalid. Make use of
          the end text to give extra feedback on the error, and point <code
            >aria-describedby</code
          > at it.
        </li>
      </Conditional>
      <Conditional>
        <li slot="astro">
          Checkboxes also get the invalid styles from the browser's own
          validation (<code>:user-invalid</code>), after the user has edited
          them. Use the <code>error</code> prop for server-side errors.
        </li>
        <li slot="vue">
          Checkboxes also get the invalid styles from the browser's own
          validation (<code>:user-invalid</code>), after the user has edited
          them. Use the <code>error</code> prop for server-side errors.
        </li>
        <li slot="html">
          Checkboxes also get the invalid styles from the browser's own
          validation (<code>:user-invalid</code>), after the user has edited
          them. Use <code>aria-invalid="true"</code> for server-side errors.
        </li>
      </Conditional>
    </ul>

    <AutoExample name="Validation" column spacious />
  </section>

  <section>
    <h2 id="indeterminate">Indeterminate</h2>
    <Conditional>
      <Fragment slot="astro">
        <p>
          Set the <code>indeterminate</code> prop to render a partially-selected state.
          {" "}<code>indeterminate</code> is a JavaScript-only property on <code
            >HTMLInputElement</code
          >, so the component renders <code>data-indeterminate</code> and applies
          the property at runtime.
        </p>

        <div class="ui-not-rich-text">
          <UICallout>
            <Fragment slot="title">JavaScript required</Fragment>
            <div class="ui-rich-text">
              The <code>indeterminate</code> state cannot be set with HTML or CSS
              alone. The browser only exposes it as a property on <code
                >HTMLInputElement</code
              >, so a small script is needed to flip <code
                >el.indeterminate = true</code
              > after the element is in the DOM. The <code>:indeterminate</code> CSS
              pseudo-class then matches and the dash glyph appears.
            </div>
          </UICallout>
        </div>
      </Fragment>

      <Fragment slot="vue">
        <p>
          Set the <code>indeterminate</code> prop to render a partially-selected state.
          {" "}<code>indeterminate</code> is a JavaScript-only property on <code
            >HTMLInputElement</code
          >, so the component renders <code>data-indeterminate</code> and applies
          the property at runtime.
        </p>
      </Fragment>

      <div slot="html" class="ui-not-rich-text">
        <p>
          Add <code>data-indeterminate</code> to the <code
            >&lt;input type="checkbox"&gt;</code
          > and call <code>activateIndeterminate()</code> from <code
            >opui-css/css/js/checkbox.js</code
          > once the element is in the DOM. The attribute alone has no effect.
        </p>

        <UICallout>
          <Fragment slot="title">JavaScript required</Fragment>
          <div class="ui-rich-text">
            The <code>indeterminate</code> state cannot be set with HTML or CSS alone.
            The browser only exposes it as a property on <code
              >HTMLInputElement</code
            >, so <code>activateIndeterminate()</code> sets <code
              >el.indeterminate = true</code
            > on every input with <code>data-indeterminate</code>. The <code
              >:indeterminate</code
            > CSS pseudo-class then matches and the dash glyph appears.
          </div>
        </UICallout>
      </div>
    </Conditional>

    <AutoExample name="Indeterminate" column centered spacious />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> prop to push the label to the left and the checkbox
        to the right. This is useful for full-width items like lists and menus.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to the <code
          >&lt;label class="ui-checkbox"&gt;</code
        >
        {" "}to push the label to the left and the checkbox to the right. This
        is useful for full-width items like lists and menus.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> prop to push the label to the left and the checkbox
        to the right. This is useful for full-width items like lists and menus.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column />
  </section>

  <section>
    <h2 id="label-alignment">Label alignment</h2>
    <p>
      The checkbox lines up with the first line of its label and centers on the
      label's capital letters, so it looks centered in any font and at any size.
      If a font still looks off, nudge the label with
      {" "}<code>--choice-label-offset</code>, in <code>em</code> or
      {" "}<code>cap</code> so it scales with the label.
    </p>
    <Code lang="css" code={`:root {\n  --choice-label-offset: 0.05em;\n}`} />
  </section>

  <section>
    <h2 id="field-group">Field group</h2>
    <p>Use field groups to group related checkboxes.</p>
    <Conditional>
      <p slot="astro">
        The <code>name</code> prop will get passed down to each checkbox in the group.
      </p>
      <p slot="html">
        Give every <code>&lt;input type="checkbox"&gt;</code> in the group the same
        {" "}<code>name</code> attribute so they're submitted together.
      </p>
      <p slot="vue">
        The <code>name</code> prop will get passed down to each checkbox in the group.
      </p>
    </Conditional>
    <p>
      See also: <DocLink href="/components/form" class="ui-link"
        >Form documentation</DocLink
      >.
    </p>

    <AutoExample name="FieldGroup" centered column />

    <h3 id="field-group-direction">Direction</h3>
    <AutoExample name="FieldGroupDirection" row />

    <h3 id="field-group-field-description">Field description</h3>
    <p>Can be placed above and below the fields.</p>
    <AutoExample name="FieldGroupFieldDescription" column centered spacious />

    <h3 id="field-group-disabled">Disabled</h3>
    <p>
      Attach the <code>disabled</code> attribute to the <code
        >&lt;fieldset&gt;</code
      > element.
    </p>
    <AutoExample name="FieldGroupDisabled" row />

    <h3 id="field-group-required">Required</h3>
    <p>
      Each checkbox with <code>required</code> must be checked before the form submits.
      There's no native "at least one" for checkboxes.
    </p>
    <AutoExample name="FieldGroupRequired" row />

    <h3 id="field-group-validation">Validation</h3>
    <Conditional>
      <p slot="html">
        Add <code>aria-invalid="true"</code> to each <code>&lt;input&gt;</code> in
        the group. The end text of the <code>.ui-fieldset</code> turns red with them.
      </p>
      <p slot="astro">
        Set <code>error</code> on each <code>Checkbox</code> in the group. The end
        text of the <code>FieldSet</code> turns red with them.
      </p>
      <p slot="vue">
        Set <code>error</code> on each <code>Checkbox</code> in the group. The end
        text of the <code>FieldSet</code> turns red with them.
      </p>
    </Conditional>
    <AutoExample name="FieldGroupValidation" row />
  </section>

  <CheckboxBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="labels">Labels</h3>
    <p>
      Accessible checkboxes must have a label. You can choose between three
      approaches:
    </p>
    <table class="ui-table">
      <thead>
        <tr>
          <th>Approach</th>
          <th>Usage in Checkbox component</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            Provide a label text inside the <code>label</code> element
          </td>
          <td>Default</td>
        </tr>
        <tr>
          <td>Add an <code>aria-label</code> on the input element</td>
          <td>Not used</td>
        </tr>
        <tr>
          <td>
            Have a visible label that you reference with <code
              >aria-labelledby</code
            >
          </td>
          <td>Not used</td>
        </tr>
      </tbody>
    </table>

    <h3 id="keyboard-support">Keyboard support</h3>
    <div class="ui-not-rich-text">
      <table class="ui-table">
        <thead>
          <tr>
            <th>Key</th>
            <th>Function</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><kbd>Space</kbd></td>
            <td>When Checkbox is focused it changes its state.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </Fragment>

  <style is:global>
    .example-row {
      align-items: center;
      display: flex;
      gap: var(--size-3);
    }
    .example-row.ui-spacious {
      gap: var(--size-6);
    }
  </style>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UICheckbox checked>
        Label
        <Fragment slot="end-text">End text</Fragment>
      </UICheckbox>
    </Anatomy>
  </Fragment>
</Component>
