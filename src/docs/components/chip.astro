---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Chip as UIChip } from "@opui/astro"
import AutoExample from "../../components/AutoExample.astro"
import ChipCSS from "@opui/css/components/chip.css?raw"
import Conditional from "../../components/Conditional.astro"

import chipApi from "../../component-api/chip/api"
---

<Component
  slug="chip"
  heroAnatomy
  apis={[{ title: "Chip API", api: chipApi }]}
  browserSupport={["has", "light-dark", "relative-color"]}
  changelogPaths={[
    {
      path: "packages/opui/components/Chip/Chip.astro",
      type: "component",
    },
    { path: "src/docs/components/chip.astro", type: "docs" },
    { path: "src/component-examples/chip", type: "docs" },
    {
      path: "packages/opui/css/components/chip.css",
      type: "css",
    },
    { path: "src/component-api/chip", type: "api" },
  ]}
  installationTabs={[{ title: "chip.css", code: ChipCSS, lang: "css" }]}
>
  <Fragment slot="title">Chip</Fragment>
  <Fragment slot="preamble">
    Chips are compact elements that represent an input, attribute, or action.
  </Fragment>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        The Chip has two variants: <code>tonal</code> (default) and <code
          >outlined</code
        >.
      </Fragment>
      <Fragment slot="html">
        The Chip has two variants: tonal (default) and <code>.ui-outlined</code
        >.
      </Fragment>
      <Fragment slot="vue">
        The Chip has two variants: <code>tonal</code> (default) and <code
          >outlined</code
        >.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="icon">Icon</h2>
    <Conditional>
      <p slot="astro">
        The icon can be placed before or after the text using the{" "}
        <code>start</code> and <code>end</code> slots.
      </p>
      <p slot="html">
        The icon can be placed before or after the text. <br />
        Make sure the text is wrapped in the <code>.ui-text</code> wrapper class.
      </p>
      <p slot="vue">
        The icon can be placed before or after the text using the{" "}
        <code>start</code> and <code>end</code> slots.
      </p>
    </Conditional>
    <AutoExample name="Icon" row />
  </section>

  <section>
    <h2 id="button">Button</h2>
    <AutoExample name="Button" column centered />
  </section>

  <section>
    <h2 id="link">Link</h2>
    <AutoExample name="Link" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <AutoExample name="Sizes" row />
  </section>

  <section>
    <h2 id="disabled">Disabled</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Disable a button chip with the <code>disabled</code> attribute.
      </Fragment>
      <Fragment slot="html">
        Add disabled styling with the <code>disabled</code> attribute, <code
          >aria-disabled="true"</code
        > or the <code>.ui-disabled</code> class.
      </Fragment>
      <Fragment slot="vue">
        Disable a button chip with the <code>disabled</code> attribute.
      </Fragment>
    </Conditional>
    <AutoExample name="Disabled" row />
  </section>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UIChip label="Chip">
        <svg
          slot="start"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 32 32"
        >
          <path
            fill="currentColor"
            d="M29.907 5.14a1.25 1.25 0 0 1-.047 1.767l-19 18a1.25 1.25 0 0 1-1.775-.055l-6.75-7.25a1.25 1.25 0 0 1 1.83-1.704l5.89 6.327L28.14 5.093a1.25 1.25 0 0 1 1.767.047"
          ></path>
        </svg>
        <svg slot="end" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
          <path
            fill="currentColor"
            d="M6.293 6.293a1 1 0 0 1 1.414 0L16 14.586l8.293-8.293a1 1 0 1 1 1.414 1.414L17.414 16l8.293 8.293a1 1 0 0 1-1.414 1.414L16 17.414l-8.293 8.293a1 1 0 0 1-1.414-1.414L14.586 16L6.293 7.707a1 1 0 0 1 0-1.414"
          ></path>
        </svg>
      </UIChip>
    </Anatomy>
  </Fragment>
</Component>
