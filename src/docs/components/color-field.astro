---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import ColorFieldCSS from "@opui/css/components/color-field.css?raw"
import RangeCSS from "@opui/css/components/range.css?raw"
import TextFieldCSS from "@opui/css/components/text-field.css?raw"
import ColorFieldJS from "@opui/elements/color-field.js?raw"

import colorFieldApi from "../../component-api/color-field/api"

export const description =
  "A text field for an oklch() color, with a picker of lightness, chroma, hue and opacity sliders."
---

<Component
  description={description}
  slug="color-field"
  browserSupport={[
    "container-style-queries",
    "invoker-commands",
    "light-dark",
    "popover",
    "registered-custom-properties",
    "relative-color",
    "scroll-driven-animations",
  ]}
  apis={[{ title: "Color field API", api: colorFieldApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/ColorField/ColorField.astro",
      type: "component",
    },
    { path: "src/docs/components/color-field.astro", type: "docs" },
    { path: "src/component-examples/color-field", type: "docs" },
    {
      path: "packages/opui/css/components/color-field.css",
      type: "css",
    },
    { path: "packages/opui/elements/color-field.js", type: "component" },
    { path: "src/component-api/color-field", type: "api" },
  ]}
  installationTabs={[
    { title: "color-field.css", code: ColorFieldCSS, lang: "css" },
    { title: "color-field.js", code: ColorFieldJS, lang: "js" },
    {
      title: "text-field.css",
      code: TextFieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "range.css", code: RangeCSS, lang: "css", isDependency: true },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Color field</Fragment>
  <Fragment slot="preamble">
    <p>
      A <DocLink href="/components/text-field">Text field</DocLink> for an <code
        >oklch()</code
      > color, with a swatch that opens <DocLink href="/components/range"
        >Range</DocLink
      > sliders for lightness, chroma, hue and opacity. The <code
        >&lt;opui-color-field&gt;</code
      > custom element keeps them in step.
    </p>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A color people pick or paste, like a <a href="#basics">brand color</a> in a
      settings form.
    </li>
    <li slot="when">
      A color with transparency, like an <a href="#opacity">overlay</a>.
    </li>
    <li slot="when-not">
      A choice from a few set colors, like a label color. Use a <DocLink
        href="/components/radio">Radio</DocLink
      > group of swatches.
    </li>
    <li slot="when-not">
      A single number on a scale, like a hue on its own. Use a <DocLink
        href="/components/range">Range</DocLink
      >.
    </li>
  </Usage>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="div">
      <p slot="components">
        The value is the field's text. Type or paste any CSS color, like <code
          >#3b82f6</code
        > or <code>red</code>, and it becomes <code>oklch()</code> when the field
        loses focus. The swatch opens the sliders, and they write the value back.
      </p>
      <p slot="html">
        Give the root <code>.ui-color-field</code>, a <code>.ui-text-field</code
        >
        part with a <code>&lt;label for&gt;</code>, and a <code
          >.ui-floating</code
        >
        popover with a <code>.ui-range</code> per channel, each <code
          >input[type=range]</code
        > with <code>data-channel</code> set to <code>L</code>, <code>C</code>,
        <code>H</code> or <code>alpha</code>. The swatch button opens it with <code
          >commandfor</code
        > and <code>command="toggle-popover"</code>. Then import <code
          >opui-css/elements/color-field.js</code
        >. Type or paste any CSS color and it becomes <code>oklch()</code> when the
        field loses focus.
      </p>
    </Conditional>
    <AutoExample name="Basics" />
  </section>

  <section>
    <h2 id="opacity">Opacity</h2>
    <p>
      <PropOrClass prop="alpha" class='input[data-channel="alpha"]' /> adds an opacity
      slider, and the value keeps its alpha, like <code
        >oklch(0.3 0.05 260 / 0.6)</code
      >. Without it, the value is opaque.
    </p>
    <AutoExample name="Opacity" />
  </section>

  <section>
    <h2 id="variants">Variants</h2>
    <p>
      Color fields are outlined by default. Use <PropOrClass
        prop='variant="filled"'
        class=".ui-filled"
      /> for a filled field.
    </p>
    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, <code>medium</code> (the default) and <code
          >large</code
        >.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes on the <code>.ui-text-field</code>: <code
          >.ui-x-small</code
        >, <code>.ui-small</code>, default and <code>.ui-large</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" row />
  </section>

  <section>
    <h2 id="end-text">End text</h2>
    <p>
      Use <PropOrClass prop="endText" class=".ui-end-text" /> for supporting text
      below the field.
    </p>
    <AutoExample name="EndText" />
  </section>

  <section>
    <h2 id="form-value">Form value</h2>
    <p>
      The input carries the <code>name</code>, so the form submits the <code
        >oklch()</code
      > text, a form reset brings back the starting color, and the sliders follow.
      Text that isn't a color makes the field invalid, so the form won't submit it.
    </p>
    <AutoExample name="FormValue" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        The input is a text field, named by its <code>&lt;label for&gt;</code>.
        The root isn't a <code>&lt;label&gt;</code>, because the swatch button
        would join the input's name.
      </li>
      <li>
        The swatch button is named by <Conditional
          ><Fragment slot="components"><code>pickerLabel</code></Fragment
          ><Fragment slot="html"><code>aria-label</code></Fragment></Conditional
        >, and opens a dialog named after the field. Each slider reads its value
        out, like "60%" or "250 degrees", and the chroma slider is described by
        the gamut line under the sliders.
      </li>
      <li>
        Before the element loads, the swatch button is hidden and the field
        takes an <code>oklch()</code> string.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>
</Component>
