---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  ControlGroup as UIControlGroup,
  Field as UIField,
} from "opui-css/astro"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import ControlGroupBuild from "../../components/UnderTheHood/ControlGroupBuild.astro"

export const keywords = [
  "button group",
  "field group",
  "input group",
  "segmented control",
  "split button",
  "toolbar",
]
export const description =
  "Buttons and fields joined into one control, like a split button or a search field with its button."
---

<Component
  description={description}
  heroAnatomy
  changelogPaths={[
    {
      path: "packages/opui/components/ButtonGroup/ButtonGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/button-group.astro", type: "docs" },
    { path: "src/component-examples/button-group", type: "docs" },
    { path: "packages/opui/css/components/button-group.css", type: "css" },
    { path: "src/component-api/button-group", type: "api" },
  ]}
>
  <Fragment slot="preamble">
    <Conditional>
      <Fragment slot="components">
        Joins buttons and fields into one control. For options that stay
        selected, use a
        <DocLink href="/components/toggle#toggle-group">Toggle group</DocLink>.
      </Fragment>
      <Fragment slot="html">
        Joins buttons and fields into one control with
        <code>.ui-control-group</code> and <code>role="group"</code>. For
        options that stay selected, use a
        <DocLink href="/components/toggle#toggle-group">Toggle group</DocLink>.
      </Fragment>
    </Conditional>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Related actions, like Undo and Redo, or a
      <a href="#split-button">split button</a>.
    </li>
    <li slot="when">
      A field and its button, like a <a href="#fields">search field</a>.
    </li>
    <li slot="when">
      One value from several controls, like currency and
      <a href="#fields">amount</a>.
    </li>
    <li slot="when-not">
      Options that stay selected: use a
      <DocLink href="/components/toggle#toggle-group">Toggle group</DocLink>.
    </li>
    <li slot="when-not">
      A unit like € or kg: use
      <DocLink href="/components/field#affix">Field affixes</DocLink>.
    </li>
    <li slot="when-not">
      More than five actions: put the rest in a
      <DocLink href="/components/menu">Menu</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Transparent by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Transparent by default. Use <code>.ui-outlined</code>,
        <code>.ui-tonal</code> or <code>.ui-filled</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column centered />
  </section>

  <section id="colors">
    <h2>Colors</h2>
    <AutoExample name="Colors" column centered />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column centered />
  </section>

  <section id="icons">
    <h2>Icons</h2>
    <p>Wrap the label in <code>.ui-text</code>.</p>
    <AutoExample name="WithIcons" column centered />
  </section>

  <section id="fields">
    <h2>Fields</h2>
    <p>
      For one value, name the group with a
      <PropOrClass prop="FieldLegend" class="legend" /> and hide the field
      labels.
    </p>
    <AutoExample name="Fields" column />
  </section>

  <section id="labels">
    <h2>Labels</h2>
    <p>
      Put help and error text after the group, linked with
      <code>aria-describedby</code>. Text inside a field is part of its box, so
      the group, which lines its controls up at the bottom, would lift that
      field above the buttons beside it.
    </p>
    <AutoExample name="Labels" column />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" column centered />
  </section>

  <section id="vertical-orientation">
    <h2>Vertical orientation</h2>
    <p>
      Use <PropOrClass prop='orientation="vertical"' class=".ui-vertical" />.
    </p>
    <AutoExample name="Vertical" column centered />
    <p>
      A textarea joins a vertical group only. Beside the buttons, a field that
      grows past one line would leave a corner square with nothing next to it,
      so put buttons for a multi-line field next to it instead, as in the
      <DocLink href="/blocks/chat">Chat block</DocLink>.
    </p>
  </section>

  <section id="overflow">
    <h2>Overflow</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Wraps by default. Use <code>overflow</code> to scroll or shrink.
      </Fragment>
      <Fragment slot="html">
        Wraps by default. Use <code>.ui-overflow-scroll</code> or
        <code>.ui-overflow-shrink</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Overflow" column />
  </section>

  <section id="split-button">
    <h2>Split button</h2>
    <p>
      A <DocLink href="/components/menu" class="ui-link">Menu</DocLink> after
      the button, with <PropOrClass prop='align="end"' class=".ui-align-end" />.
    </p>
    <AutoExample name="SplitButton" centered />
  </section>

  <section id="pagination">
    <h2>Pagination</h2>
    <p>
      Link buttons in a <code>nav</code>, with <code>aria-current="page"</code>
      on the current one.
    </p>
    <AutoExample name="Pagination" row />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Name a group of actions with <code>aria-label</code>, or one value with
        a visible legend.
      </li>
      <li>Name icon-only buttons with <code>aria-label</code>.</li>
      <li>Every field keeps its own label, visible or hidden.</li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <ControlGroupBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIControlGroup
        aria-label="Find an order"
        style="inline-size: 22rem"
        variant="outlined"
      >
        <UIField
          for="control-group-order-number"
          hideLabel
          label="Order number"
        >
          <input id="control-group-order-number" placeholder="Order" />
        </UIField>
        <UIButton>Search</UIButton>
        <UIButton>Clear</UIButton>
      </UIControlGroup>
    </Anatomy>
  </Fragment>
</Component>
