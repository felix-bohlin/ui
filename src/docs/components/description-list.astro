---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  DescriptionList as UIDescriptionList,
  DescriptionListDescription as UIDescriptionListDescription,
  DescriptionListItem as UIDescriptionListItem,
  DescriptionListTerm as UIDescriptionListTerm,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"
import DescriptionListCSS from "@opui/css/components/description-list.css?raw"
import PropOrClass from "../../components/PropOrClass.astro"

import descriptionListApi from "../../component-api/description-list/api"
import descriptionListItemApi from "../../component-api/description-list-item/api"
import DescriptionListBuild from "../../components/UnderTheHood/DescriptionListBuild.astro"

export const description =
  "Terms and their values, like order details or totals."

export const keywords = ["dl", "key value", "properties"]
---

<Component
  description={description}
  slug="description-list"
  heroAnatomy
  apis={[
    { title: "Description list API", api: descriptionListApi },
    { title: "Description list item API", api: descriptionListItemApi },
  ]}
  browserSupport={["container-queries"]}
  changelogPaths={[
    {
      path: "packages/opui/components/DescriptionList",
      type: "component",
    },
    { path: "src/docs/components/description-list.astro", type: "docs" },
    { path: "src/component-examples/description-list", type: "docs" },
    {
      path: "packages/opui/css/components/description-list.css",
      type: "css",
    },
    { path: "src/component-api/description-list", type: "api" },
  ]}
  installationTabs={[
    {
      title: "description-list.css",
      code: DescriptionListCSS,
      lang: "css",
    },
  ]}
>
  <Fragment slot="title">Description list</Fragment>

  <Usage slot="usage">
    <li slot="when">Labels with values, like order details.</li>
    <li slot="when">
      Totals side by side:
      <PropOrClass prop='orientation="horizontal"' class=".ui-horizontal" />.
    </li>
    <li slot="when-not">
      Data in several columns: use a
      <DocLink href="/components/table">Table</DocLink>.
    </li>
    <li slot="when-not">
      Values people edit: use a
      <DocLink href="/components/text-field">Text field</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" />
  </section>

  <section id="border">
    <h2>Border</h2>
    <p>
      Use <PropOrClass prop='border="solid"' class=".ui-border-solid" />, or
      <PropOrClass prop='border="dotted"' class=".ui-border-dotted" /> for dots.
    </p>
    <AutoExample name="Bordered" column spacious />
  </section>

  <section id="orientation">
    <h2>Orientation</h2>
    <p>
      Stacks at <code>45ch</code> or narrower. Use
      <PropOrClass prop='orientation="horizontal"' class=".ui-horizontal" /> to
      keep a row.
    </p>
    <AutoExample name="Orientation" column spacious />
  </section>

  <section id="total">
    <h2>Total</h2>
    <p>Use <PropOrClass prop="total" class=".ui-total" /> on the last item.</p>
    <AutoExample name="Total" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Screen readers read each <code>dt</code> as a term and each
        <code>dd</code> as its definition. The <code>div</code> around a pair
        adds nothing to what they announce.
      </li>
      <li>
        The leader lines of a bordered list aren't read, so a term and its value
        have to make sense one after the other.
      </li>
    </ul>
  </Fragment>

  <DescriptionListBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIDescriptionList style="inline-size: 16rem">
        <UIDescriptionListItem>
          <UIDescriptionListTerm>Order number</UIDescriptionListTerm>
          <UIDescriptionListDescription>10482</UIDescriptionListDescription>
        </UIDescriptionListItem>
      </UIDescriptionList>
    </Anatomy>
  </Fragment>
</Component>
