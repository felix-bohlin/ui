---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  DescriptionList as UIDescriptionList,
  DescriptionListDescription as UIDescriptionListDescription,
  DescriptionListItem as UIDescriptionListItem,
  DescriptionListTerm as UIDescriptionListTerm,
} from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import DescriptionListBuild from "../../components/UnderTheHood/DescriptionListBuild.astro"

export const description =
  "A list of terms and their values, like order details or totals."

export const keywords = ["dl", "key value", "properties"]
---

<Component description={description} heroAnatomy>
  <Fragment slot="preamble">
    Labels with their values, like order details. For one key number, use a
    <DocLink href="/components/stat">Stat</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Labels with values, like order details.</li>
    <li slot="when">
      Totals side by side:
      <PropOrClass prop='orientation="horizontal"' class=".ui-horizontal" />.
    </li>
    <li slot="when-not">
      Data in several columns: use a
      <DocLink href="/components/table">Table</DocLink>.
    </li>
    <li slot="when-not">
      Values people edit: use a
      <DocLink href="/components/text-field">Text field</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" />
  </section>

  <section id="leader">
    <h2>Leader</h2>
    <p>
      A leader runs from each term to its value. Use
      <PropOrClass prop='leader="solid"' class=".ui-leader-solid" />, or
      <PropOrClass prop='leader="dotted"' class=".ui-leader-dotted" /> for dots.
    </p>
    <AutoExample name="Bordered" column spacious />
  </section>

  <section id="orientation">
    <h2>Orientation</h2>
    <p>
      Stacks at <code>45ch</code> or narrower. Use
      <PropOrClass prop='orientation="horizontal"' class=".ui-horizontal" /> to
      keep a row.
    </p>
    <AutoExample name="Orientation" column spacious />
    <p>
      <PropOrClass prop='orientation="vertical"' class=".ui-vertical" /> always
      puts the term above its value. Add <code>.ui-layout-grid</code> to lay the
      items out in columns, like the details on a ticket.
    </p>
    <AutoExample name="Vertical" />
  </section>

  <section id="total">
    <h2>Total</h2>
    <p>Use <PropOrClass prop="total" class=".ui-total" /> on the last item.</p>
    <AutoExample name="Total" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Screen readers read each <code>dt</code> as a term and each
        <code>dd</code> as its definition. The <code>div</code> around a pair
        adds nothing to what they announce.
      </li>
      <li>
        The leader lines aren't read, so a term and its value have to make sense
        one after the other.
      </li>
    </ul>
  </Fragment>

  <DescriptionListBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIDescriptionList style="inline-size: 16rem">
        <UIDescriptionListItem>
          <UIDescriptionListTerm>Order number</UIDescriptionListTerm>
          <UIDescriptionListDescription>10482</UIDescriptionListDescription>
        </UIDescriptionListItem>
      </UIDescriptionList>
    </Anatomy>
  </Fragment>
</Component>
