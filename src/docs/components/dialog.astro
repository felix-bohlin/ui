---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  Dialog as UIDialog,
  DialogContent as UIDialogContent,
  DialogFooter as UIDialogFooter,
  DialogHeader as UIDialogHeader,
  DialogTitle as UIDialogTitle,
  TableCell,
  TableRow,
} from "opui-css/astro"

import DialogCSS from "@opui/css/components/dialog.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"

import ClosedbyTable from "../../components/ClosedbyTable.astro"
import Conditional from "../../components/Conditional.astro"
import DocsTable from "../../components/DocsTable.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import dialogApi from "../../component-api/dialog/api"
import dialogFooterApi from "../../component-api/dialog-footer/api"
import dialogHeaderApi from "../../component-api/dialog-header/api"
import DialogBuild from "../../components/UnderTheHood/DialogBuild.astro"

export const description =
  "A window over the page for a question or a short task, modal or not."

export const keywords = ["lightbox", "modal", "overlay", "popup"]
---

<Component
  description={description}
  heroAnatomy
  slug="dialog"
  apis={[
    { title: "Dialog API", api: dialogApi },
    { title: "Dialog header API", api: dialogHeaderApi },
    { title: "Dialog footer API", api: dialogFooterApi },
  ]}
  browserSupport={[
    "anchor-positioning",
    "backdrop-filter",
    "container-scroll-state-queries",
    "dialog-closedby",
    "display-animation",
    "has",
    "invoker-commands",
    "logical-properties",
    "overflow-clip",
    "overlay",
    "round-mod-rem",
    "scrollbar-gutter",
    "starting-style",
    "transition-behavior",
  ]}
  fallbacks={{
    "container-scroll-state-queries":
      "Without scroll-state queries, long content scrolls without the shadows that mark more content above or below.",
    "dialog-closedby":
      "Without `closedby`, a modal dialog closes with Esc whatever the value, and a click outside doesn't close it. The [polyfill](/guide/browser-support#polyfills) adds it.",
    "display-animation":
      "Without display animation, the dialog disappears at once instead of fading out.",
    overlay:
      "Without `overlay`, the backdrop disappears as soon as the dialog starts to close, and the page can cover the dialog while it fades out.",
  }}
  changelogPaths={[
    {
      path: "packages/opui/components/Dialog/Dialog.astro",
      type: "component",
    },
    { path: "src/docs/components/dialog.astro", type: "docs" },
    { path: "src/component-examples/dialog", type: "docs" },
    {
      path: "packages/opui/css/components/dialog.css",
      type: "css",
    },
    { path: "src/component-api/dialog", type: "api" },
  ]}
  installationTabs={[
    { title: "dialog.css", code: DialogCSS, lang: "css" },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Dialog</Fragment>
  <Fragment slot="preamble">
    A question or short task that needs full attention. For side content, use a
    <DocLink href="/components/drawer">Drawer</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">A short task, like renaming a file.</li>
    <li slot="when">
      Confirming a destructive action: an
      <a href="#alert-dialog">alert dialog</a>.
    </li>
    <li slot="when-not">
      Navigation, filters or side content: use a
      <DocLink href="/components/drawer">Drawer</DocLink>.
    </li>
    <li slot="when-not">
      Messages that shouldn't stop the user: use a
      <DocLink href="/components/callout">Callout</DocLink>.
    </li>
    <li slot="when-not">Long or complex tasks: give them a page.</li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>

    <h3 id="modal">Modal</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>closeLabel</code> on <code>DialogHeader</code> for a close
        button.
      </Fragment>
      <Fragment slot="html">
        Point <code>aria-labelledby</code> at the heading.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" row />

    <h3 id="non-modal">Non-modal</h3>
    <p>Open it with <code>show()</code> from a script.</p>

    <AutoExample name="NonModal" row />
  </section>

  <section id="footer">
    <h2>Footer</h2>
    <p>
      Content lines up at the end. Use
      <PropOrClass prop='align="start"' class=".ui-align-start" /> to change it.
    </p>

    <AutoExample name="FooterAlignment" row />

    <p>Wrap the buttons in <code>.ui-actions</code> to keep them together.</p>

    <AutoExample name="FooterContent" row />
  </section>

  <section id="alert-dialog">
    <h2>Alert dialog</h2>
    <p>
      Use <code>role="alertdialog"</code> and point
      <code>aria-describedby</code> at the message.
    </p>

    <AutoExample name="AlertDialog" row />
  </section>

  <section id="width">
    <h2>Width</h2>
    <p>
      Up to <code>60ch</code> by default. Use <code>--_max-inline-size</code> to
      change it.
    </p>

    <AutoExample name="Width" row />
  </section>

  <section id="long-content">
    <h2>Long content</h2>
    <p>
      Content with only text needs <code>tabindex="0"</code>,
      <code>role="region"</code> and an <code>aria-label</code> to scroll by
      keyboard in Safari.
    </p>

    <AutoExample name="LongContent" row />
  </section>

  <section id="how-to-close">
    <h2>How to close a dialog</h2>
    <ClosedbyTable name="dialog" />

    <AutoExample name="CloseBehaviors" row />
  </section>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIDialog
        closedby="none"
        open
        style="inline-size: 22rem; margin: 0; position: static"
      >
        <UIDialogHeader>
          <UIDialogTitle>Newsletter</UIDialogTitle>
        </UIDialogHeader>
        <UIDialogContent>
          <p>
            Get a short email when we ship something new. No more than once a
            month.
          </p>
        </UIDialogContent>
        <UIDialogFooter>
          <UIButton>Not now</UIButton>
          <UIButton variant="filled">Subscribe</UIButton>
        </UIDialogFooter>
      </UIDialog>
    </Anatomy>
  </Fragment>

  <DialogBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="role-attributes">Role & attributes</h3>
    <p>
      The <code>&lt;dialog&gt;</code> element has the dialog role, and opening
      it with <code>command="show-modal"</code> (or <code>showModal()</code>)
      makes it modal and the page behind it inert.
    </p>
    <DocsTable
      columns={[{ label: "Role/attribute", width: "30%" }, { label: "Usage" }]}
    >
      <TableRow>
        <TableCell><code>aria-labelledby="IDREF"</code></TableCell>
        <TableCell>
          Gives the dialog an accessible name by referring to the element that
          provides the dialog title.
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code>aria-describedby="IDREF"</code></TableCell>
        <TableCell>
          Optional. Gives the dialog an accessible description by referring to
          the dialog content that describes the primary message or purpose of
          the dialog.
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code>role="alertdialog"</code></TableCell>
        <TableCell>
          Only if the dialog is a confirmation window communicating an important
          message that requires a confirmation or other user response. See
          <a href="#alert-dialog">alert dialog</a>.
        </TableCell>
      </TableRow>
    </DocsTable>

    <p>
      Source:
      <a
        href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog#accessibility"
        class="ui-link"
        >MDN</a
      >. The
      <a
        href="https://www.w3.org/WAI/ARIA/apg/patterns/dialog-modal/"
        class="ui-link"
        >APG modal dialog pattern</a
      >
      wraps focus with a script. A native modal dialog doesn't need one.
    </p>

    <KeyboardSupport />
  </Fragment>
</Component>
