---
import Component from "../../layouts/Component.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import DividerCSS from "@opui/css/components/divider.css?raw"
import DividerBuild from "../../components/UnderTheHood/DividerBuild.astro"

import dividerApi from "../../component-api/divider/api"
---

<Component
  slug="divider"
  browserSupport={["container-style-queries"]}
  apis={[{ title: "Divider API", api: dividerApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Divider/Divider.astro",
      type: "component",
    },
    { path: "src/docs/components/divider.astro", type: "docs" },
    { path: "src/component-examples/divider", type: "docs" },
    {
      path: "packages/opui/css/components/divider.css",
      type: "css",
    },
    { path: "src/component-api/divider", type: "api" },
  ]}
  installationTabs={[{ title: "divider.css", code: DividerCSS, lang: "css" }]}
>
  <Fragment slot="title">Divider</Fragment>
  <Fragment slot="preamble"> It's just a line. </Fragment>

  <section>
    <h2 id="default">Default</h2>
    <AutoExample name="Default" />
  </section>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional>
      <p slot="astro">
        Use the <code>variant</code> prop to change the line color.
      </p>
      <p slot="html">
        Use <code>.ui-filled</code>, <code>.ui-primary</code>, or <code
          >.ui-tonal</code
        > to change the line color.
      </p>
      <p slot="vue">
        Use the <code>variant</code> prop to change the line color.
      </p>
    </Conditional>
    <AutoExample name="Variants" />
  </section>

  <section>
    <h2 id="spacing">Spacing</h2>
    <p>
      The space above and below a divider is <code>--divider-space</code>.
      Cards, callouts, dialogs and drawers set a tighter value, and a divider
      that is a direct child of a card has no margin, since the card's gap
      already spaces it. Set <code>--divider-space</code> on any wrapper to change
      it for every divider inside.
    </p>
    <AutoExample name="Spacing" column />
  </section>

  <DividerBuild slot="under-the-hood" />
</Component>
