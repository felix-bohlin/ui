---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  Drawer as UIDrawer,
  DrawerContent as UIDrawerContent,
  DrawerFooter as UIDrawerFooter,
  DrawerHeader as UIDrawerHeader,
  DrawerTitle as UIDrawerTitle,
  TableCell,
  TableRow,
} from "opui-css/astro"

import DrawerCSS from "@opui/css/components/drawer.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import drawerApi from "../../component-api/drawer/api"
import drawerFooterApi from "../../component-api/drawer-footer/api"
import drawerHeaderApi from "../../component-api/drawer-header/api"
import DrawerBuild from "../../components/UnderTheHood/DrawerBuild.astro"

import BlockLink from "../../components/BlockLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import ClosedbyTable from "../../components/ClosedbyTable.astro"
import Conditional from "../../components/Conditional.astro"
import DocsTable from "../../components/DocsTable.astro"

export const keywords = ["off-canvas", "sheet", "side panel", "sidebar"]
---

<Component
  heroAnatomy
  slug="drawer"
  browserSupport={[
    "anchor-positioning",
    "backdrop-filter",
    "container-scroll-state-queries",
    "dialog-closedby",
    "dir-pseudo",
    "display-animation",
    "has",
    "invoker-commands",
    "logical-properties",
    "overflow-clip",
    "overlay",
    "round-mod-rem",
    "scrollbar-gutter",
    "starting-style",
    "transition-behavior",
  ]}
  apis={[
    { title: "Drawer API", api: drawerApi },
    { title: "Drawer header API", api: drawerHeaderApi },
    { title: "Drawer footer API", api: drawerFooterApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Drawer",
      type: "component",
    },
    { path: "src/docs/components/drawer.astro", type: "docs" },
    { path: "src/component-examples/drawer", type: "docs" },
    {
      path: "packages/opui/css/components/drawer.css",
      type: "css",
    },
    { path: "src/component-api/drawer", type: "api" },
  ]}
  installationTabs={[
    { title: "drawer.css", code: DrawerCSS, lang: "css" },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Drawer</Fragment>
  <Fragment slot="preamble">
    Slides in from an edge of the screen. For a task that needs full attention,
    use a <DocLink href="/components/dialog">Dialog</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Navigation on small screens, like an <a href="#basics">app menu</a>.
    </li>
    <li slot="when">
      Filters or settings for the page, like <a href="#basics">filters</a> for a
      list.
    </li>
    <li slot="when">
      Item details without leaving the list, like a <a href="#basics">task</a>.
    </li>
    <li slot="when-not">
      A task that needs full attention: use a
      <DocLink href="/components/dialog">Dialog</DocLink>.
    </li>
    <li slot="when-not">
      Content used together with the page, like filters beside the results: use
      a sticky column with the
      <DocLink href="/components/layout#sticky">Layout</DocLink> classes.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <Conditional as="div">
      <Fragment slot="components">
        <p>
          Opens from <code>inline-start</code> by default. Use <code>side</code>
          to change it.
        </p>
        <p>
          Use <code>backdrop="transparent"</code> and <code>scrollLock</code>
          for the page behind it.
        </p>
      </Fragment>
      <Fragment slot="html">
        <p>
          Opens from the inline start by default. Use <code>.ui-inline-end</code
          >, <code>.ui-block-start</code> or <code>.ui-block-end</code> to
          change it.
        </p>
        <p>
          Use <code>.ui-backdrop-transparent</code> and
          <code>.ui-scroll-lock</code> for the page behind it.
        </p>
      </Fragment>
    </Conditional>
    <p>
      Content with only text needs <code>tabindex="0"</code>,
      <code>role="region"</code> and an <code>aria-label</code> to scroll by
      keyboard in Safari.
    </p>
    <AutoExample name="Basics" column />

    <BlockLink slug="app-shell">
      On narrow screens the sidebar navigation moves into a drawer that the menu
      button in the header opens.
    </BlockLink>
  </section>

  <section id="navigation">
    <h2>Navigation</h2>
    <Conditional as="p">
      <Fragment slot="components">
        A drawer used as navigation, like the menu in
        <a href="#basics">Basics</a>, closes when the page navigates with
        <code>closeOnNavigate</code>: a link inside it, Back and Forward, or a
        client router in SvelteKit, Next or Nuxt. Otherwise the new page loads
        behind a modal drawer, inert, and screen readers miss the change.
      </Fragment>
      <Fragment slot="html">
        A drawer used as navigation, like the menu in
        <a href="#basics">Basics</a>, closes when the page navigates with
        <code>data-close-on-navigate</code> and
        <code>opui-css/elements/close-on-navigate.js</code>: a link inside it,
        Back and Forward, or a client router.
      </Fragment>
    </Conditional>
  </section>

  <section id="close-button">
    <h2>Close button</h2>
    <Conditional as="p">
      <Fragment slot="components">
        It says "Close" unless you translate it with <code>closeLabel</code>,
        like the other
        <DocLink href="/guide/accessibility#built-in-labels"
          >built-in labels</DocLink
        >.
      </Fragment>
      <Fragment slot="html">
        Translate its <code>aria-label</code>, like the other
        <DocLink href="/guide/accessibility#built-in-labels"
          >built-in labels</DocLink
        >.
      </Fragment>
    </Conditional>
  </section>

  <section id="how-to-close">
    <h2>How to close a drawer</h2>
    <ClosedbyTable componentDefault="any" name="drawer" />

    <AutoExample name="CloseBehaviors" row />
  </section>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIDrawer
        closedby="none"
        id="drawer-anatomy"
        open
        style="block-size: auto; inline-size: 18rem; position: static"
      >
        <UIDrawerHeader>
          <UIDrawerTitle>Filters</UIDrawerTitle>
        </UIDrawerHeader>
        <UIDrawerContent>
          <p>Narrow the list by status, owner and date.</p>
        </UIDrawerContent>
        <UIDrawerFooter>
          <UIButton size="small">Reset</UIButton>
          <UIButton size="small" variant="filled">Apply</UIButton>
        </UIDrawerFooter>
      </UIDrawer>
    </Anatomy>
  </Fragment>

  <DrawerBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="role-attributes">Role & attributes</h3>
    <p>
      The <code>&lt;dialog&gt;</code> element has the dialog role, and opening
      it with <code>command="show-modal"</code> (or <code>showModal()</code>)
      makes it modal and the page behind it inert.
    </p>
    <DocsTable
      columns={[{ label: "Role/attribute", width: "30%" }, { label: "Usage" }]}
    >
      <TableRow>
        <TableCell><code>aria-labelledby="IDREF"</code></TableCell>
        <TableCell>
          Gives the drawer an accessible name by referring to the element that
          provides the drawer title.
        </TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code>aria-describedby="IDREF"</code></TableCell>
        <TableCell>
          Optional. Gives the drawer an accessible description by referring to
          the drawer content that describes the primary message or purpose of
          the drawer.
        </TableCell>
      </TableRow>
    </DocsTable>

    <ul>
      <li>
        <Conditional>
          <Fragment slot="components"
            >Without a <code>DrawerTitle</code>, add an <code>aria-label</code
            >.</Fragment
          >
          <Fragment slot="html"
            >Point <code>aria-labelledby</code> at the heading, not
            <code>.ui-header</code>.</Fragment
          >
        </Conditional>
      </li>
      <li>
        Put <code>autofocus</code> on the first thing to interact with, or the
        close button.
      </li>
    </ul>

    <p>
      Source:
      <a
        class="ui-link"
        target="_blank"
        href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog"
        >MDN</a
      >
    </p>

    <KeyboardSupport />
  </Fragment>
</Component>
