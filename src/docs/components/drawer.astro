---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Example from "../../components/Example"
import Anatomy from "../../components/Anatomy.astro"
import {
  Button as UIButton,
  Drawer as UIDrawer,
  DrawerFooter as UIDrawerFooter,
  DrawerHeader as UIDrawerHeader,
  Switch,
  Table,
} from "@opui/astro"

import DrawerCSS from "@opui/css/components/drawer.css?raw"
import drawerApi from "../../component-api/drawer/api"
import drawerFooterApi from "../../component-api/drawer-footer/api"
import drawerHeaderApi from "../../component-api/drawer-header/api"
import DrawerBuild from "../../components/UnderTheHood/DrawerBuild.astro"

import ExampleUsage from "../../component-examples/drawer/Usage.astro"
import ExampleUsageVue from "../../component-examples/drawer/Usage.vue"
import ExampleUsageAstro from "../../component-examples/drawer/Usage.astro?raw"
import ExampleUsageVueRaw from "../../component-examples/drawer/Usage.vue?raw"
import ExampleUsageHTML from "../../component-examples/drawer/Usage.html?raw"

import ClosedbyTable from "../../components/ClosedbyTable.astro"
import Conditional from "../../components/Conditional.astro"
---

<Component
  heroAnatomy
  slug="drawer"
  browserSupport={[
    "anchor-positioning",
    "backdrop-filter",
    "container-scroll-state-queries",
    "dialog-closedby",
    "dir-pseudo",
    "display-animation",
    "has",
    "invoker-commands",
    "overflow-clip",
    "overlay",
    "starting-style",
    "transition-behavior",
  ]}
  apis={[
    { title: "Drawer API", api: drawerApi },
    { title: "Drawer header API", api: drawerHeaderApi },
    { title: "Drawer footer API", api: drawerFooterApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Drawer",
      type: "component",
    },
    { path: "src/docs/components/drawer.astro", type: "docs" },
    { path: "src/component-examples/drawer", type: "docs" },
    {
      path: "packages/opui/css/components/drawer.css",
      type: "css",
    },
    { path: "src/component-api/drawer", type: "api" },
  ]}
  installationTabs={[{ title: "drawer.css", code: DrawerCSS, lang: "css" }]}
>
  <Fragment slot="title">Drawer</Fragment>
  <Fragment slot="preamble">
    Slides in from the sides, top or bottom of the screen. Good for navigation,
    filters and side content. For a question or a short task that needs the
    user's full attention, use a <DocLink href="/components/dialog"
      >Dialog</DocLink
    >.
  </Fragment>

  <section>
    <h2 id="usage">Usage</h2>
    <Conditional>
      <Fragment slot="astro">
        <p>Change the opening side with the <code>side</code> prop.</p>
        <p>
          Put a <code>DrawerHeader</code> in the <code>header</code> slot to add a
          heading and a close button. Put actions in the <code>footer</code> slot,
          wrapped in a <code>DrawerFooter</code>.
        </p>
        <p>
          The header and footer stay put while the content scrolls, with a
          shadow on the scrolled edge.
        </p>
        <p>
          The backdrop dims and blurs the page by default. Use <code
            >backdrop="transparent"</code
          > to keep the page behind it fully visible.
        </p>
        <p>
          Page scrolling is locked by default when the drawer is open. With a
          transparent backdrop the page stays scrollable, except on screens
          narrower than 500px. Use the <code>scrollLock={false}</code> prop to allow
          scrolling on every screen.
        </p>
      </Fragment>
      <Fragment slot="html">
        <p>
          Change the opening side with the <code>.ui-inline-start</code>, <code
            >.ui-inline-end</code
          >, <code>.ui-block-start</code>, and <code>.ui-block-end</code> classes.
        </p>
        <p>
          <code>.ui-header</code> and <code>.ui-footer</code> stay put while <code
            >.ui-content</code
          > scrolls, with a shadow on the scrolled edge.
        </p>
        <p>
          The backdrop dims and blurs the page by default. Use the <code
            >.ui-backdrop-transparent</code
          > class to keep the page behind it fully visible.
        </p>
        <p>
          Add the <code>.ui-scroll-lock</code> utility class to the drawer to lock
          page scrolling while it's open. With <code
            >.ui-backdrop-transparent</code
          >
          the page stays scrollable, except on screens narrower than 500px. Omit the
          class to allow background scrolling.
        </p>
      </Fragment>
      <Fragment slot="vue">
        <p>Change the opening side with the <code>side</code> prop.</p>
        <p>
          Put a <code>DrawerHeader</code> in the <code>header</code> slot to add a
          heading and a close button. Put actions in the <code>footer</code> slot,
          wrapped in a <code>DrawerFooter</code>.
        </p>
        <p>
          The header and footer stay put while the content scrolls, with a
          shadow on the scrolled edge.
        </p>
        <p>
          The backdrop dims and blurs the page by default. Use <code
            >backdrop="transparent"</code
          > to keep the page behind it fully visible.
        </p>
        <p>
          Page scrolling is locked by default when the drawer is open. With a
          transparent backdrop the page stays scrollable, except on screens
          narrower than 500px. Use the <code>scrollLock={false}</code> prop to allow
          scrolling on every screen.
        </p>
      </Fragment>
    </Conditional>
    <Example column>
      <Switch slot="controls" id="backdrop-transparent-toggle">
        <Conditional>
          <span slot="astro"><code>backdrop="transparent"</code></span>
          <span slot="html"><code>.ui-backdrop-transparent</code></span>
          <span slot="vue"><code>backdrop="transparent"</code></span>
        </Conditional>
      </Switch>
      <Example.Preview slot="preview-astro" code={ExampleUsage} />
      <Example.Preview slot="preview-html" code={ExampleUsageHTML} />
      <Example.Preview slot="preview-vue" code={ExampleUsageVue} />
      <Example.Code slot="code-html" code={ExampleUsageHTML} />
      <Example.Code slot="code-astro" code={ExampleUsageAstro} />
      <Example.Code slot="code-vue" code={ExampleUsageVueRaw} />
    </Example>
  </section>

  <section>
    <h2 id="closedby">How to close a drawer</h2>
    <ClosedbyTable componentDefault="any" name="drawer" />
  </section>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIDrawer
        closedby="none"
        open
        scrollLock={false}
        style="block-size: auto; inline-size: 18rem; position: static"
      >
        <UIDrawerHeader slot="header" heading="Filters" />
        <p slot="content">Narrow the list by status, owner and date.</p>
        <UIDrawerFooter slot="footer">
          <UIButton size="small">Reset</UIButton>
          <UIButton size="small" variant="filled">Apply</UIButton>
        </UIDrawerFooter>
      </UIDrawer>
    </Anatomy>
  </Fragment>

  <DrawerBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        <Conditional>
          <Fragment slot="astro"
            >The drawer is named by the first heading in the <code>header</code> slot,
            through <code>aria-labelledby</code>. Pass <code>aria-label</code> or
            <code>aria-labelledby</code> to name it yourself.</Fragment
          >
          <Fragment slot="html"
            >Name the drawer with <code>aria-labelledby</code> pointing at the heading's
            <code>id</code>, not at <code>.ui-header</code>, which also holds
            the close button.</Fragment
          >
          <Fragment slot="vue"
            >The drawer is named by the <code>heading</code> of a <code
              >DrawerHeader</code
            > in the <code>header</code> slot, through <code
              >aria-labelledby</code
            >. With your own heading, pass <code>aria-labelledby</code> or
            <code>aria-label</code> to <code>Drawer</code>.</Fragment
          >
        </Conditional>
      </li>
      <li>
        The <code>autofocus</code> attribute should be added to the element the user
        is expected to interact with immediately upon opening a modal dialog. If no
        other element involves more immediate interaction, it is recommended to add
        autofocus to the close button inside the dialog, or the dialog itself if the
        user is expected to click/activate it to dismiss.
      </li>
      <li>
        Do not add the <code>tabindex</code> property to the{" "}
        <code>&lt;dialog&gt;</code> element as it is not interactive and does not
        receive focus. The dialog's contents, including the close button contained
        in the dialog, can receive focus and be interactive.
      </li>
    </ul>

    <p>
      Source: <a
        class="ui-link"
        target="_blank"
        href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog"
        >MDN</a
      >
    </p>

    <h3 id="role-attributes">Role & attributes</h3>
    <p>
      Don't add <code>role="dialog"</code> or <code>aria-modal="true"</code>.
      The <code>&lt;dialog&gt;</code> element has the dialog role, and opening it
      with <code>command="show-modal"</code> (or <code>showModal()</code>) makes
      it modal and the page behind it inert.
    </p>
    <Table style="table-layout: fixed">
      <Table.ColumnGroup>
        <Table.Column width="30%" />
        <Table.Column />
      </Table.ColumnGroup>
      <Table.Head>
        <Table.Row>
          <Table.HeaderCell>Role/attribute</Table.HeaderCell>
          <Table.HeaderCell>Usage</Table.HeaderCell>
        </Table.Row>
      </Table.Head>
      <Table.Body>
        <Table.Row>
          <Table.Cell><code>aria-labelledby="IDREF"</code></Table.Cell>
          <Table.Cell>
            Gives the drawer an accessible name by referring to the element that
            provides the drawer title.
          </Table.Cell>
        </Table.Row>
        <Table.Row>
          <Table.Cell><code>aria-describedby="IDREF"</code></Table.Cell>
          <Table.Cell>
            Optional. Gives the drawer an accessible description by referring to
            the drawer content that describes the primary message or purpose of
            the drawer.
          </Table.Cell>
        </Table.Row>
      </Table.Body>
    </Table>

    <h3 id="keyboard-support">Keyboard support</h3>
    <div class="ui-not-rich-text">
      <Table style="table-layout: fixed">
        <Table.ColumnGroup>
          <Table.Column width="30%" />
          <Table.Column />
        </Table.ColumnGroup>
        <Table.Head>
          <Table.Row>
            <Table.HeaderCell>Key</Table.HeaderCell>
            <Table.HeaderCell>Function</Table.HeaderCell>
          </Table.Row>
        </Table.Head>
        <Table.Body>
          <Table.Row>
            <Table.Cell><kbd>Tab</kbd></Table.Cell>
            <Table.Cell>
              Moves focus to the next focusable element in the drawer. After the
              last one, focus moves to the browser's own controls (like the
              address bar), then back to the first element in the drawer. The
              page behind it is inert.
            </Table.Cell>
          </Table.Row>
          <Table.Row>
            <Table.Cell><kbd>Shift + Tab</kbd></Table.Cell>
            <Table.Cell>
              Moves focus to the previous focusable element. Before the first
              one, focus moves to the browser's controls, then to the last
              element in the drawer.
            </Table.Cell>
          </Table.Row>
          <Table.Row>
            <Table.Cell><kbd>Esc</kbd></Table.Cell>
            <Table.Cell>
              Closes the drawer, unless <code>closedby="none"</code>, and
              returns focus to the element that opened it.
            </Table.Cell>
          </Table.Row>
        </Table.Body>
      </Table>
    </div>
  </Fragment>
</Component>

<script>
  function setupDrawerBackdropControls() {
    document
      .querySelectorAll<HTMLElement>(".example-container")
      .forEach((container) => {
        if (!container.querySelector("#backdrop-transparent-toggle")) return
        if (container.dataset.drawerBackdropSetup) return
        container.dataset.drawerBackdropSetup = "true"

        container.addEventListener("change", (event) => {
          const input = event.target
          if (!(input instanceof HTMLInputElement)) return
          if (input.id !== "backdrop-transparent-toggle") return

          container.querySelectorAll("dialog.ui-drawer").forEach((drawer) => {
            drawer.classList.toggle("ui-backdrop-transparent", input.checked)
          })
        })
      })
  }

  setupDrawerBackdropControls()
</script>

<style is:global>
  .drawer-examples {
    align-items: center;
    display: grid;
    gap: var(--size-3);
    grid-template-areas:
      ". top ."
      "left . right"
      ". bottom .";
    justify-items: center;
    margin: var(--size-8) auto;
    width: fit-content;
  }

  .drawer-examples .top {
    grid-area: top;
  }

  .drawer-examples .left {
    grid-area: left;
  }

  .drawer-examples .right {
    grid-area: right;
  }

  .drawer-examples .bottom {
    grid-area: bottom;
  }
</style>
