---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import {
  CharacterCount as UICharacterCount,
  Field as UIField,
} from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import FieldCSS from "@opui/css/components/field.css?raw"

import fieldApi from "../../component-api/field/api"
import FieldBuild from "../../components/UnderTheHood/FieldBuild.astro"

export const description =
  "The label, hints and box around a form control you write: an input, a select or a textarea."

export const keywords = ["form", "input", "label", "select", "textarea"]

export const skillExamples = ["Basics", "Ids"]
---

<Component
  description={description}
  heroAnatomy
  slug="field"
  browserSupport={[
    "alt-text-generated-content",
    "attr",
    "color-mix",
    "container-queries",
    "customizable-select",
    "dir-pseudo",
    "display-animation",
    "field-sizing",
    "has",
    "invoker-commands",
    "lh",
    "open-pseudo",
    "overlay",
    "reading-flow",
    "registered-custom-properties",
    "relative-color",
    "starting-style",
    "transition-behavior",
    "user-pseudos",
  ]}
  fallbacks={{
    attr: "Without typed `attr()`, a textarea is at least three lines tall, whatever `rows` says.",
    "customizable-select":
      "Without customizable select, the field draws its own chevron on a select and the browser's own picker opens, with the text of each option only.",
    "display-animation":
      "Without display animation, the select picker disappears at once instead of fading out.",
    overlay:
      "Without `overlay`, the page can cover the select picker while it fades out.",
    "reading-flow":
      "Without `reading-flow`, Tab and screen readers follow the markup, which puts the top and start parts before the control, as they're drawn. Hand-written HTML needs that order too.",
  }}
  apis={[{ title: "Field API", api: fieldApi }]}
  changelogPaths={[
    { path: "packages/opui/css/components/text-field.css", type: "css" },
  ]}
  installationTabs={[{ title: "field.css", code: FieldCSS, lang: "css" }]}
>
  <Fragment slot="title">Field</Fragment>
  <Fragment slot="preamble">
    The label, the start and end text and the box around a control you write: an
    <code>&lt;input&gt;</code>, a <code>&lt;select&gt;</code> or a
    <code>&lt;textarea&gt;</code>. Each control has its own page, with what only
    it does: <DocLink href="/components/number-field">Number field</DocLink>,
    <DocLink href="/components/range">Range</DocLink>,
    <DocLink href="/components/select">Select</DocLink>,
    <DocLink href="/components/text-field">Text field</DocLink> and
    <DocLink href="/components/textarea">Textarea</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A control with a unit, a hint or an error, like a price in euros:
      <a href="#affix">affixes</a> and <a href="#end-text">end text</a>.
    </li>
    <li slot="when">
      A form you check yourself, like a sign-up form:
      <a href="#bound-validation">bound validation</a>.
    </li>
    <li slot="when-not">
      A choice you check: use a
      <DocLink href="/components/checkbox">Checkbox</DocLink>, a
      <DocLink href="/components/radio">Radio</DocLink> or a
      <DocLink href="/components/switch">Switch</DocLink>, which bring their own
      label.
    </li>
    <li slot="when-not">
      A code sent to the user: use a
      <DocLink href="/components/one-time-code">One-time code</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Write the control inside the field, with its <code>id</code> set to
        <code>for</code>, and bind, name and validate it like any control. The
        types require <code>for</code>.
      </Fragment>
      <Fragment slot="react">
        Write the control inside the field, with its <code>id</code> set to
        <code>htmlFor</code>, and bind, name and validate it like any control.
        The types require <code>htmlFor</code>.
      </Fragment>
      <Fragment slot="html">
        Put the control directly in <code>.ui-field-container</code>, and point
        the <code>&lt;label for&gt;</code> at its <code>id</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Basics" column />
    <Conditional as="p">
      <Fragment slot="vue">
        Vue sets a static <code>value</code> on the control again when it
        hydrates, which replaces what the user typed before the page hydrated.
        Write it as an attribute, <code>:value.attr="'1'"</code>, as the
        examples do, or bind it with <code>v-model</code>.
      </Fragment>
    </Conditional>
  </section>

  <section id="ids">
    <h2>Ids</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        A page renders once, so any id that's unique on the page works. In a
        component you render more than once, take the id from a prop.
      </Fragment>
      <Fragment slot="html">Write ids that are unique on the page.</Fragment>
      <Fragment slot="react">
        Make the id with <code>useId()</code>, which gives the same id on the
        server and in the browser, so the page hydrates without a mismatch. Pass
        it to <code>htmlFor</code>, the control's <code>id</code> and each
        <code>StepButton</code> or <code>PasswordToggle</code>.
      </Fragment>
      <Fragment slot="solid">
        Make the id with <code>createUniqueId()</code>, which gives the same id
        on the server and in the browser, so the page hydrates without a
        mismatch. Pass it to <code>for</code>, the control's <code>id</code> and
        each <code>StepButton</code> or <code>PasswordToggle</code>.
      </Fragment>
      <Fragment slot="svelte">
        Make the id with <code>$props.id()</code>, which gives the same id on
        the server and in the browser, so the page hydrates without a mismatch.
        Pass it to <code>for</code>, the control's <code>id</code> and each
        <code>StepButton</code> or <code>PasswordToggle</code>.
      </Fragment>
      <Fragment slot="vue">
        Make the id with <code>useId()</code>, which gives the same id on the
        server and in the browser, so the page hydrates without a mismatch. Pass
        it to <code>for</code>, the control's <code>id</code> and each
        <code>StepButton</code> or <code>PasswordToggle</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Ids" centered />
    <Conditional as="p">
      <Fragment slot="components">
        The field gives each part it shows an id that starts with
        <code>for</code>: <code>x-start-text</code>, <code>x-top</code>,
        <code>x-start</code>, <code>x-end</code>, <code>x-bottom</code> and
        <code>x-end-text</code> for <code>for="x"</code>. Point the control's
        <code>aria-describedby</code> at them in that order, except a part with
        nothing to read: a <code>start</code> or <code>end</code> that only
        holds buttons or a hidden icon, and end text that only holds an
        <code>&lt;output&gt;</code>.
      </Fragment>
      <Fragment slot="react">
        The field gives each part it shows an id that starts with
        <code>htmlFor</code>: <code>x-start-text</code>, <code>x-top</code>,
        <code>x-start</code>, <code>x-end</code>, <code>x-bottom</code> and
        <code>x-end-text</code> for <code>htmlFor="x"</code>. Point the
        control's <code>aria-describedby</code> at them in that order, except a
        part with nothing to read: a <code>start</code> or <code>end</code> that
        only holds buttons or a hidden icon, and end text that only holds an
        <code>&lt;output&gt;</code>.
      </Fragment>
      <Fragment slot="html">
        Give each part an id that starts with the control's:
        <code>x-start-text</code>, <code>x-top</code>, <code>x-start</code>,
        <code>x-end</code>, <code>x-bottom</code> and <code>x-end-text</code>
        for <code>id="x"</code>. Point the control's
        <code>aria-describedby</code> at them in that order, except a part with
        nothing to read: a <code>.ui-start</code> or <code>.ui-end</code> that
        only holds buttons or a hidden icon, and a <code>.ui-end-text</code>
        that only holds an <code>&lt;output&gt;</code>.
      </Fragment>
    </Conditional>
    <p>
      <code>npx opui-css check</code> reads the HTML your app renders and names
      each field whose label, part ids or <code>aria-describedby</code> don't
      follow its control's <code>id</code>.
    </p>
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      field.
    </p>
    <AutoExample name="Variants" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" row />
  </section>

  <section id="dense">
    <h2>Dense</h2>
    <p>
      <PropOrClass prop="dense" class=".ui-dense" /> packs the options of a
      select tighter.
    </p>
    <AutoExample name="Dense" row spacious />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" />
    <p>Without a label, add <code>aria-label</code> to the control.</p>
    <AutoExample name="NoLabel" />
  </section>

  <section id="start-text">
    <h2>Start text</h2>
    <p>
      Use <PropOrClass prop="startText" class=".ui-start-text" />, and point the
      control's <code>aria-describedby</code> at it.
    </p>
    <AutoExample name="StartText" row />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <p>
      Use <PropOrClass prop="endText" class=".ui-end-text" />, and point the
      control's <code>aria-describedby</code> at it.
    </p>
    <AutoExample name="EndText" centered />
  </section>

  <section id="character-count">
    <h2>Character count</h2>
    <Conditional as="p">
      <Fragment slot="components">
        With <code>maxlength</code> on the control, put a
        <code>CharacterCount</code> in
        <Conditional>
          <Fragment slot="components">the <code>end-text</code> slot</Fragment>
          <Fragment slot="react"><code>endText</code></Fragment>
          <Fragment slot="solid"><code>endText</code></Fragment>
          <Fragment slot="svelte">the <code>endText</code> snippet</Fragment>
        </Conditional
        >. Screen readers only hear the count near the limit, so name the limit
        in the end text.
      </Fragment>
      <Fragment slot="html">
        With <code>maxlength</code> on the control, add
        <code>&lt;opui-character-count&gt;</code> to the end text and import
        <code>opui-css/elements/character-count.js</code>. Screen readers only
        hear the count near the limit, so name the limit in the end text.
      </Fragment>
    </Conditional>
    <AutoExample name="CharacterCount" centered />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>start</code>, <code>end</code>, <code>top</code> and
        <code>bottom</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-start</code>, <code>.ui-end</code>, <code>.ui-top</code>
        and <code>.ui-bottom</code>.
      </Fragment>
    </Conditional>
    <p>
      A long text affix ends in an ellipsis, and the full text stays in the
      field's description.
    </p>

    <AutoExample name="Affix" column />

    <h3 id="top-and-bottom">Top and bottom</h3>

    <AutoExample name="TopAndBottom" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ul>
      <li>Use <code>required</code> on the control.</li>
      <li>
        Use <code>aria-invalid="true"</code> on the control for errors, and
        point its <code>aria-describedby</code> at the end text.
      </li>
      <li>
        Fields also get the invalid styles from <code>:user-invalid</code>,
        which color the end text too.
      </li>
    </ul>

    <AutoExample name="Validation" column spacious />

    <h3 id="bound-validation">Bound validation</h3>
    <p>
      Set <code>aria-invalid</code> from your own check, and show the error in
      the end text in place of the hint.
    </p>
    <AutoExample name="ValidationBinding" centered />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      control.
    </p>

    <AutoExample name="Spread" column spacious />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      <PropOrClass prop="autoFit" class=".ui-auto-fit" /> sizes the field to the
      content of its control.
    </p>

    <AutoExample name="AutoFit" class="flex" />
  </section>

  <section id="drop-zone">
    <h2>Drop zone</h2>
    <p>
      Use <PropOrClass prop="dropZone" class=".ui-drop-zone" /> on a field with
      a <DocLink href="/components/text-field#file">file input</DocLink>. For
      files that upload as they're picked, use a
      <DocLink href="/components/file-upload">File upload</DocLink>.
    </p>

    <AutoExample name="DropZone" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        The label alone is the control's name, through
        <code>&lt;label for&gt;</code>. The affixes, the start text, end text
        and the top and bottom regions are its description once the control's
        <code>aria-describedby</code> points at them, so a unit, a hint or an
        error is read after the name in any language's word order, and buttons
        in the affixes stay out of the name.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <FieldBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIField for="field-anatomy" label="Label" startText="Start text">
        <input
          aria-describedby="field-anatomy-start-text field-anatomy-top field-anatomy-start field-anatomy-end field-anatomy-bottom field-anatomy-end-text"
          id="field-anatomy"
          maxlength={24}
          placeholder="Placeholder"
          value="Value"
        />
        <span slot="top">Top</span>
        <span slot="start">€</span>
        <span slot="end">EUR</span>
        <span slot="bottom">Bottom</span>
        <Fragment slot="end-text">
          Supporting text
          <UICharacterCount />
        </Fragment>
      </UIField>
    </Anatomy>
  </Fragment>
</Component>
