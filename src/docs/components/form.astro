---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import Example from "../../components/Example"
import AutoExample from "../../components/AutoExample.astro"
import FormCSS from "@opui/css/components/form.css?raw"

import ExampleUsageAstroCode from "../../component-examples/form/Usage.astro?raw"
import ExampleUsageSvelteCode from "../../component-examples/form/Usage.svelte?raw"
import ExampleUsageVueCode from "../../component-examples/form/Usage.vue?raw"
import ExampleUsageHTMLCode from "../../component-examples/form/Usage.html?raw"

import ExampleKitchenSink from "../../component-examples/form/KitchenSink.astro"
import ExampleKitchenSinkSvelte from "../../component-examples/form/KitchenSink.svelte"
import ExampleKitchenSinkVue from "../../component-examples/form/KitchenSink.vue"
import ExampleKitchenSinkCodeAstro from "../../component-examples/form/KitchenSink.astro?raw"
import ExampleKitchenSinkCodeSvelte from "../../component-examples/form/KitchenSink.svelte?raw"
import ExampleKitchenSinkCodeVue from "../../component-examples/form/KitchenSink.vue?raw"
import ExampleKitchenSinkHTML from "../../component-examples/form/KitchenSink.html?raw"

import fieldDescriptionApi from "../../component-api/field-description/api"
import fieldGroupApi from "../../component-api/field-group/api"
import fieldLegendApi from "../../component-api/field-legend/api"
import fieldSetApi from "../../component-api/field-set/api"
import formApi from "../../component-api/form/api"
import FormBuild from "../../components/UnderTheHood/FormBuild.astro"

import {
  Button as UIButton,
  FieldDescription as UIFieldDescription,
  FieldGroup as UIFieldGroup,
  FieldLegend as UIFieldLegend,
  FieldSet as UIFieldSet,
  Form as UIForm,
  Radio as UIRadio,
  Switch as UISwitch,
} from "@opui/astro"
import Conditional from "../../components/Conditional.astro"
import Code from "../../components/Code.astro"

const anatomyApi = {
  ...formApi,
  parts: [
    {
      code: "<fieldset>",
      component: { astro: "FieldSet", svelte: "FieldSet", vue: "FieldSet" },
      description: "Groups related fields.",
      selector: ".ui-fieldset",
    },
    ...fieldSetApi.parts,
    {
      code: ".ui-field-group",
      component: {
        astro: "FieldGroup",
        svelte: "FieldGroup",
        vue: "FieldGroup",
      },
      description: "Lays out related fields.",
      selector: ".ui-fieldset .ui-field-group",
    },
  ],
}
---

<Component
  slug="form"
  heroAnatomy
  browserSupport={["has"]}
  installationTabs={[
    { title: "form.css", code: FormCSS, lang: "css" },
    { title: "button.css", seeAlso: true },
    { title: "checkbox.css", seeAlso: true },
    { title: "divider.css", seeAlso: true },
    { title: "radio.css", seeAlso: true },
    { title: "range.css", seeAlso: true },
    { title: "select.css", seeAlso: true },
    { title: "switch.css", seeAlso: true },
    { title: "textarea.css", seeAlso: true },
    { title: "text-field.css", seeAlso: true },
  ]}
  apis={[
    { title: "Form API", api: formApi },
    { title: "Field set API", api: fieldSetApi },
    { title: "Field legend API", api: fieldLegendApi },
    { title: "Field description API", api: fieldDescriptionApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Form/Form.astro",
      type: "component",
    },
    { path: "src/docs/components/form.astro", type: "docs" },
    { path: "src/component-examples/form", type: "docs" },
    {
      path: "packages/opui/css/components/form.css",
      type: "css",
    },
    { path: "src/component-api/form", type: "api" },
  ]}
>
  <Fragment slot="title">Form</Fragment>
  <Fragment slot="preamble">Spacing and grouping for form fields.</Fragment>

  <section>
    <h2 id="usage">Usage</h2>
    <Conditional>
      <Code slot="astro" lang="astro" code={ExampleUsageAstroCode} />
      <Code slot="svelte" lang="svelte" code={ExampleUsageSvelteCode} />
      <Code slot="vue" lang="vue" code={ExampleUsageVueCode} />
      <Code slot="html" lang="html" code={ExampleUsageHTMLCode} />
    </Conditional>
  </section>

  <section>
    <h2 id="fieldset">Fieldset</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Groups related fields. Label it with <code>FieldLegend</code> and add an optional{
          " "
        }
        <code>FieldDescription</code>.
      </Fragment>
      <Fragment slot="html">
        Groups related fields. Label it with <code>&lt;legend&gt;</code> and add an
        optional <code>.ui-field-description</code>.
      </Fragment>
      <Fragment slot="svelte">
        Groups related fields. Label it with <code>FieldLegend</code> and add an optional
        <code>FieldDescription</code>.
      </Fragment>
      <Fragment slot="vue">
        Groups related fields. Label it with <code>FieldLegend</code> and add an optional{
          " "
        }
        <code>FieldDescription</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldsetStacked" />
  </section>

  <section>
    <h2 id="field-group">Field group</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Lays out related fields and passes a shared <code>name</code> to the inputs
        inside. Wrap it in a fieldset to group them for screen readers.
      </Fragment>
      <Fragment slot="html">
        Lays out related fields. Wrap it in a fieldset to group them for screen
        readers.
      </Fragment>
      <Fragment slot="svelte">
        Lays out related fields and passes a shared <code>name</code> to the OPUI
        fields inside. Wrap it in a fieldset to group them for screen readers.
      </Fragment>
      <Fragment slot="vue">
        Lays out related fields and passes a shared <code>name</code> to the OPUI
        fields inside. Wrap it in a fieldset to group them for screen readers.
      </Fragment>
    </Conditional>

    <AutoExample name="FieldGroup" />

    <h3 id="field-group-row">Row</h3>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>direction="row"</code> to lay out fields horizontally.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-row</code> to lay out fields horizontally.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>direction="row"</code> to lay out fields horizontally.
      </Fragment>
      <Fragment slot="vue">
        Set <code>direction="row"</code> to lay out fields horizontally.
      </Fragment>
    </Conditional>

    <AutoExample name="FieldGroupRow" row />
  </section>

  <section>
    <h2 id="states">States</h2>

    <h3 id="fieldset-disabled">Disabled</h3>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>disabled</code> on <code>FieldSet</code> to disable every field
        inside.
      </Fragment>
      <Fragment slot="html">
        Add <code>disabled</code> to the <code>&lt;fieldset&gt;</code> to disable
        every field inside.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>disabled</code> on <code>FieldSet</code> to disable every field
        inside.
      </Fragment>
      <Fragment slot="vue">
        Set <code>disabled</code> on <code>FieldSet</code> to disable every field
        inside.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldsetDisabled" />

    <h3 id="fieldset-invalid">Invalid</h3>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>error</code> on each field in the <code>FieldSet</code>, and
        explain the error in a <code>.ui-end-text</code> directly inside it. The end
        text turns red when a field has <code>error</code> set.
      </Fragment>
      <Fragment slot="html">
        Add <code>aria-invalid="true"</code> to each control in the
        <code>&lt;fieldset&gt;</code>, and explain the error in a
        <code>.ui-end-text</code> directly inside it. The end text turns red when
        a control has <code>aria-invalid="true"</code>.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>error</code> on each field in the <code>FieldSet</code>, and
        explain the error in a <code>.ui-end-text</code> directly inside it. The end
        text turns red when a field has <code>error</code> set.
      </Fragment>
      <Fragment slot="vue">
        Set <code>error</code> on each field in the <code>FieldSet</code>, and
        explain the error in a <code>.ui-end-text</code> directly inside it. The end
        text turns red when a field has <code>error</code> set.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldsetInvalid" />

    <h3 id="fieldset-required">Required</h3>
    <p>The legend gets an asterisk when a field inside is required.</p>
    <AutoExample name="FieldsetRequired" />
  </section>

  <section>
    <h2 id="actions">Actions</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        A field group with only buttons lines up in a row. Set <code
          >direction="column"</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >Divider</code
        >.
      </Fragment>
      <Fragment slot="html">
        A field group with only buttons lines up in a row. Add <code
          >.ui-column</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >&lt;hr class="ui-divider"&gt;</code
        >.
      </Fragment>
      <Fragment slot="svelte">
        A field group with only buttons lines up in a row. Set <code
          >direction="column"</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >Divider</code
        >.
      </Fragment>
      <Fragment slot="vue">
        A field group with only buttons lines up in a row. Set <code
          >direction="column"</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >Divider</code
        >.
      </Fragment>
    </Conditional>
    <AutoExample name="Divider" />
  </section>

  <section>
    <h2 id="without-fieldset">Without fieldset</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Set <code>as</code> on <code>Form</code>, <code>FieldSet</code> and <code
          >FieldLegend</code
        >. A <code>div</code> doesn't pick up its name from the legend, so give the
        legend an <code>id</code> and point <code>aria-labelledby</code> on the field
        set at it.
      </Fragment>
      <Fragment slot="html">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Use <code>.ui-form</code>, <code>.ui-fieldset</code> with <code
          >role="group"</code
        > and <code>.ui-legend</code> on other elements. A <code>div</code> doesn't
        pick up its name from the legend, so give the legend an <code>id</code> and
        point <code>aria-labelledby</code> on the field set at it.
      </Fragment>
      <Fragment slot="svelte">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Set <code>as</code> on <code>Form</code>, <code>FieldSet</code> and <code
          >FieldLegend</code
        >. A <code>div</code> doesn't pick up its name from the legend, so give the
        legend an <code>id</code> and point <code>aria-labelledby</code> on the field
        set at it.
      </Fragment>
      <Fragment slot="vue">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Set <code>as</code> on <code>Form</code>, <code>FieldSet</code> and <code
          >FieldLegend</code
        >. A <code>div</code> doesn't pick up its name from the legend, so give the
        legend an <code>id</code> and point <code>aria-labelledby</code> on the field
        set at it.
      </Fragment>
    </Conditional>
    <AutoExample name="AdaptiveOutput" />
  </section>

  <section>
    <h2 id="kitchen-sink">Kitchen sink</h2>
    <p>Everything at once.</p>
    <Example>
      <Fragment slot="controls">
        <UISwitch id="kitchen-sink-small-toggle"><code>small</code></UISwitch>
        <UISwitch id="kitchen-sink-spread-toggle"><code>spread</code></UISwitch>
        <UISwitch id="kitchen-sink-divider-toggle">
          <Conditional>
            <Fragment slot="astro">Show <code>&lt;Divider&gt;</code></Fragment>
            <Fragment slot="html">Show <code>&lt;hr&gt;</code></Fragment>
            <Fragment slot="svelte">Show <code>&lt;Divider&gt;</code></Fragment>
            <Fragment slot="vue">Show <code>&lt;Divider&gt;</code></Fragment>
          </Conditional>
        </UISwitch>
      </Fragment>
      <Example.Preview slot="preview-astro" code={ExampleKitchenSink} />
      <Example.Preview slot="preview-html" code={ExampleKitchenSinkHTML} />
      <Example.Preview slot="preview-svelte" code={ExampleKitchenSinkSvelte} />
      <Example.Preview slot="preview-vue" code={ExampleKitchenSinkVue} />
      <Example.Code slot="code-astro" code={ExampleKitchenSinkCodeAstro} />
      <Example.Code slot="code-svelte" code={ExampleKitchenSinkCodeSvelte} />
      <Example.Code slot="code-vue" code={ExampleKitchenSinkCodeVue} />
    </Example>
  </section>

  <FormBuild slot="under-the-hood" />

  <p slot="installation">
    This doesn't include all the styles for all form elements, just the
    scaffolding around them.
  </p>

  <Fragment slot="anatomy">
    <Anatomy api={anatomyApi}>
      <UIForm style="inline-size: 18rem">
        <UIFieldSet>
          <UIFieldLegend>Favorite pet</UIFieldLegend>
          <UIFieldDescription>Pick one.</UIFieldDescription>
          <UIFieldGroup name="form-anatomy">
            <UIRadio value="dog" checked>Dog</UIRadio>
            <UIRadio value="cat">Cat</UIRadio>
          </UIFieldGroup>
        </UIFieldSet>
        <UIFieldGroup>
          <UIButton variant="filled">Save</UIButton>
        </UIFieldGroup>
      </UIForm>
    </Anatomy>
  </Fragment>
</Component>

<script>
  function setupKitchenSinkControls() {
    document
      .querySelectorAll<HTMLElement>(".example-container")
      .forEach((container) => {
        if (!container.querySelector("[id^='kitchen-sink-example']")) return
        if (container.dataset.kitchenSinkSetup) return
        container.dataset.kitchenSinkSetup = "true"

        const smallToggle = container.querySelector<HTMLInputElement>(
          "#kitchen-sink-small-toggle",
        )
        const spreadToggle = container.querySelector<HTMLInputElement>(
          "#kitchen-sink-spread-toggle",
        )
        const dividerToggle = container.querySelector<HTMLInputElement>(
          "#kitchen-sink-divider-toggle",
        )

        const updateFields = () => {
          const example = container.querySelector(
            "[id^='kitchen-sink-example']",
          )
          if (!example) return

          if (smallToggle) {
            example
              .querySelectorAll(
                ".ui-text-field, .ui-textarea, .ui-select, .ui-radio, .ui-checkbox, .ui-switch, .ui-button, .ui-range",
              )
              .forEach((field) => {
                field.classList.toggle("ui-small", smallToggle.checked)
              })
          }

          if (spreadToggle) {
            example
              .querySelectorAll(
                ".ui-text-field, .ui-textarea, .ui-select, .ui-checkbox, .ui-switch, .ui-range",
              )
              .forEach((field) => {
                field.classList.toggle("ui-spread", spreadToggle.checked)
              })
            example
              .querySelectorAll(".ui-field-group:has(> .ui-radio)")
              .forEach((group) => {
                group.classList.toggle("ui-row", spreadToggle.checked)
              })
          }

          if (dividerToggle) {
            example.querySelectorAll("hr.ui-divider").forEach((divider) => {
              if (divider instanceof HTMLElement) {
                divider.style.display = dividerToggle.checked ? "" : "none"
              }
            })
          }
        }

        container.addEventListener("change", (event) => {
          const input = event.target
          if (!(input instanceof HTMLInputElement)) return
          if (![smallToggle, spreadToggle, dividerToggle].includes(input))
            return
          updateFields()
        })

        updateFields()
      })
  }

  setupKitchenSinkControls()
</script>

<style is:global>
  /* This is here because the examples don't remove the hr, they just put display none. In real life though they wouldn't be there so it will look right at least. */
  .ui-field-group {
    &:has(.ui-button):not(:has(*:not(.ui-button))) {
      &:not(hr:not([style*="display: none"]) + &) {
        margin-block-start: var(--size-4);
      }
    }
  }
</style>
