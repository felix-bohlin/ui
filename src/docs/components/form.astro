---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldDescriptionApi from "../../component-api/field-description/api"
import fieldGroupApi from "../../component-api/field-group/api"
import fieldLegendApi from "../../component-api/field-legend/api"
import fieldsetApi from "../../component-api/fieldset/api"
import formApi from "../../component-api/form/api"
import FormBuild from "../../components/UnderTheHood/FormBuild.astro"

import {
  Button as UIButton,
  FieldDescription as UIFieldDescription,
  FieldGroup as UIFieldGroup,
  FieldLegend as UIFieldLegend,
  Fieldset as UIFieldset,
  Form as UIForm,
  Radio as UIRadio,
  Switch as UISwitch,
} from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

const [legendPart, descriptionPart, endTextPart] = fieldsetApi.parts

const anatomyApi = {
  ...formApi,
  parts: [
    {
      code: "<fieldset>",
      component: "Fieldset",
      description: "Groups related fields.",
      selector: ".ui-fieldset",
    },
    legendPart,
    descriptionPart,
    {
      code: ".ui-field-group",
      component: "FieldGroup",
      description: "Lays out related fields.",
      selector: ".ui-fieldset .ui-field-group",
    },
    endTextPart,
  ],
}
---

<Component
  slug="form"
  heroAnatomy
  browserSupport={["has", "user-pseudos"]}
  installationTabs={[{ title: "form.css", code: FormCSS, lang: "css" }]}
  seeAlsoLinks={[
    { name: "Button", href: "/components/button" },
    { name: "Divider", href: "/components/divider" },
    { name: "Range", href: "/components/range" },
    { name: "Select", href: "/components/select" },
    { name: "Text Field", href: "/components/text-field" },
    { name: "Textarea", href: "/components/textarea" },
  ]}
  apis={[
    { title: "Form API", api: formApi },
    { title: "Fieldset API", api: fieldsetApi },
    { title: "Field legend API", api: fieldLegendApi },
    { title: "Field description API", api: fieldDescriptionApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Form/Form.astro",
      type: "component",
    },
    { path: "src/docs/components/form.astro", type: "docs" },
    { path: "src/component-examples/form", type: "docs" },
    {
      path: "packages/opui/css/components/form.css",
      type: "css",
    },
    { path: "src/component-api/form", type: "api" },
  ]}
>
  <Fragment slot="title">Form</Fragment>
  <Fragment slot="preamble">Spacing and grouping for form fields.</Fragment>

  <Usage slot="usage">
    <li slot="when">Spacing the fields, groups and buttons of a form.</li>
    <li slot="when">
      Related fields under one heading, like an address, in a <a
        href="#fieldset">fieldset</a
      > with a legend.
    </li>
    <li slot="when">
      A set of checkboxes, radios or switches, in a <a href="#field-group"
        >field group</a
      >.
    </li>
    <li slot="when-not">
      Laying out content that isn't a form. Use the <DocLink
        href="/components/layout">Layout</DocLink
      > classes.
    </li>
    <li slot="when-not">
      Grouping fields only for the look. A fieldset is also a group for screen
      readers, so use a field group on its own.
    </li>
  </Usage>

  <section>
    <h2 id="basics">Basics</h2>
    <AutoExample name="Basics" />
  </section>

  <section>
    <h2 id="fieldset">Fieldset</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Groups related fields. Label it with <code>FieldLegend</code> and add an optional
        <code>FieldDescription</code>.
      </Fragment>
      <Fragment slot="html">
        Groups related fields. Label it with <code>&lt;legend&gt;</code> and add an
        optional <code>.ui-description</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldsetStacked" />
  </section>

  <section>
    <h2 id="field-group">Field group</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Lays out related fields and passes a shared <code>name</code> to the OPUI
        fields inside. Wrap it in a fieldset to group them for screen readers.
      </Fragment>
      <Fragment slot="html">
        Lays out related fields. Wrap it in a fieldset to group them for screen
        readers.
      </Fragment>
    </Conditional>

    <AutoExample name="FieldGroup" />

    <h3 id="field-group-horizontal">Horizontal</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>orientation="horizontal"</code> to lay out fields horizontally.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-horizontal</code> to lay out fields horizontally.
      </Fragment>
    </Conditional>

    <AutoExample name="FieldGroupHorizontal" row />
    <p>
      A horizontal group lines its fields up at their end, so a field and its
      button sit on one line. A text field, a textarea, a select or a number
      stepper grows to share the row and wraps below <code
        >--_field-min-inline-size</code
      > (<code>11rem</code>).
    </p>
    <AutoExample name="FieldGroupHorizontalFields" />
  </section>

  <section>
    <h2 id="states">States</h2>

    <h3 id="fieldset-disabled">Disabled</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>disabled</code> on <code>Fieldset</code> to disable every field
        inside.
      </Fragment>
      <Fragment slot="html">
        Add <code>disabled</code> to the <code>&lt;fieldset&gt;</code> to disable
        every field inside.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldsetDisabled" />

    <h3 id="fieldset-invalid">Invalid</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>error</code> on each field in the <code>Fieldset</code>, and
        explain the error in a <code>.ui-end-text</code> directly inside it. The end
        text turns red when a field has <code>error</code> set.
      </Fragment>
      <Fragment slot="html">
        Add <code>aria-invalid="true"</code> to each control in the
        <code>&lt;fieldset&gt;</code>, and explain the error in a
        <code>.ui-end-text</code> directly inside it. The end text turns red when
        a control has <code>aria-invalid="true"</code>.
      </Fragment>
    </Conditional>
    <p>
      Give the end text an <code>id</code> and point <code
        >aria-describedby</code
      >
      on the fieldset at it, so screen readers read the error with the group.
    </p>
    <AutoExample name="FieldsetInvalid" />

    <h3 id="fieldset-required">Required</h3>
    <p>The legend gets an asterisk when a field inside is required.</p>
    <AutoExample name="FieldsetRequired" />
  </section>

  <section>
    <h2 id="actions">Actions</h2>
    <Conditional as="p">
      <Fragment slot="components">
        A field group with only buttons lines up in a row. Set <code
          >orientation="vertical"</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >Divider</code
        >.
      </Fragment>
      <Fragment slot="html">
        A field group with only buttons lines up in a row. Add <code
          >.ui-vertical</code
        > to stack the buttons instead. Separate the group from the fields with <code
          >&lt;hr class="ui-divider"&gt;</code
        >.
      </Fragment>
    </Conditional>
    <AutoExample name="Divider" />
    <AutoExample name="ActionsColumn" />
  </section>

  <section>
    <h2 id="without-fieldset">Without fieldset</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Set <code>as</code> on <code>Form</code>, <code>Fieldset</code> and <code
          >FieldLegend</code
        >. A <code>div</code> doesn't pick up its name from the legend, so give the
        legend an <code>id</code> and point <code>aria-labelledby</code> on the field
        set at it.
      </Fragment>
      <Fragment slot="html">
        Can't use <code>&lt;form&gt;</code>, <code>&lt;fieldset&gt;</code> or <code
          >&lt;legend&gt;</code
        >? Use <code>.ui-form</code>, <code>.ui-fieldset</code> with <code
          >role="group"</code
        > and <code>.ui-legend</code> on other elements. A <code>div</code> doesn't
        pick up its name from the legend, so give the legend an <code>id</code> and
        point <code>aria-labelledby</code> on the fieldset at it.
      </Fragment>
    </Conditional>
    <AutoExample name="AdaptiveOutput" />
  </section>

  <section>
    <h2 id="kitchen-sink">Kitchen sink</h2>
    <p>Everything at once.</p>
    <AutoExample name="KitchenSink">
      <Fragment slot="controls">
        <UISwitch
          data-toggle-class="ui-small"
          data-toggle-target=".ui-text-field, .ui-textarea, .ui-select, .ui-radio, .ui-checkbox, .ui-switch, .ui-button, .ui-range"
          ><PropOrClass prop='size="small"' class=".ui-small" /></UISwitch
        >
        <UISwitch
          data-toggle-class="ui-spread; ui-horizontal"
          data-toggle-target=".ui-text-field, .ui-textarea, .ui-select, .ui-checkbox, .ui-switch, .ui-range; .ui-field-group:has(> .ui-radio)"
          ><PropOrClass prop="spread" class=".ui-spread" /></UISwitch
        >
        <UISwitch
          data-toggle-class="kitchen-sink-dividers"
          data-toggle-target="#form-kitchen-sink-1"
        >
          <Conditional>
            <Fragment slot="components"
              >Show <code>&lt;Divider&gt;</code></Fragment
            >
            <Fragment slot="html">Show <code>&lt;hr&gt;</code></Fragment>
          </Conditional>
        </UISwitch>
      </Fragment>
    </AutoExample>
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        A fieldset is a group named by its legend, so screen readers can read
        the legend with the fields in it.
      </li>
      <li>
        The asterisk on the legend of a <a href="#fieldset-required">required</a
        >
        group is hidden from screen readers in browsers that support alternative text
        in <code>content</code>. They announce each field as required from its <code
          >required</code
        > attribute.
      </li>
    </ul>
  </Fragment>

  <FormBuild slot="under-the-hood" />

  <p slot="installation">
    This doesn't include all the styles for all form elements, just the
    scaffolding around them.
  </p>

  <Fragment slot="anatomy">
    <Anatomy api={anatomyApi}>
      <UIForm style="inline-size: 18rem">
        <UIFieldset>
          <UIFieldLegend>Favorite pet</UIFieldLegend>
          <UIFieldDescription>Pick one.</UIFieldDescription>
          <UIFieldGroup name="form-anatomy">
            <UIRadio value="cat" checked>Cat</UIRadio>
            <UIRadio value="dog">Dog</UIRadio>
          </UIFieldGroup>
          <span class="ui-end-text">Supporting text</span>
        </UIFieldset>
        <UIFieldGroup>
          <UIButton variant="filled">Save</UIButton>
        </UIFieldGroup>
      </UIForm>
    </Anatomy>
  </Fragment>
</Component>

<style is:global>
  /* This is here because the examples don't remove the hr, they just put display none. In real life though they wouldn't be there so it will look right at least. */
  #form-kitchen-sink-1:not(.kitchen-sink-dividers) > hr.ui-divider {
    display: none;
  }

  .ui-field-group {
    &:has(.ui-button):not(:has(*:not(.ui-button))) {
      &:not(hr + &),
      #form-kitchen-sink-1:not(.kitchen-sink-dividers) > & {
        margin-block-start: var(--size-4);
      }
    }
  }
</style>
