---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldDescriptionApi from "../../component-api/field-description/api"
import fieldGroupApi from "../../component-api/field-group/api"
import fieldLegendApi from "../../component-api/field-legend/api"
import fieldsetApi from "../../component-api/fieldset/api"
import formApi from "../../component-api/form/api"
import FormBuild from "../../components/UnderTheHood/FormBuild.astro"

import {
  Button as UIButton,
  FieldDescription as UIFieldDescription,
  FieldGroup as UIFieldGroup,
  FieldLegend as UIFieldLegend,
  Fieldset as UIFieldset,
  Form as UIForm,
  Radio as UIRadio,
  Switch as UISwitch,
} from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

const [legendPart, descriptionPart, endTextPart] = fieldsetApi.parts

const anatomyApi = {
  ...formApi,
  parts: [
    {
      code: "<fieldset>",
      component: "Fieldset",
      description: "Groups related fields.",
      selector: ".ui-fieldset",
    },
    legendPart,
    descriptionPart,
    {
      code: ".ui-field-group",
      component: "FieldGroup",
      description: "Lays out related fields.",
      selector: ".ui-fieldset .ui-field-group",
    },
    endTextPart,
  ],
}

export const keywords = ["fieldset", "input group", "label", "validation"]
---

<Component
  slug="form"
  heroAnatomy
  browserSupport={["has", "user-pseudos"]}
  installationTabs={[{ title: "form.css", code: FormCSS, lang: "css" }]}
  seeAlsoLinks={[
    { name: "Button", href: "/components/button" },
    { name: "Divider", href: "/components/divider" },
    { name: "Range", href: "/components/range" },
    { name: "Select", href: "/components/select" },
    { name: "Text Field", href: "/components/text-field" },
    { name: "Textarea", href: "/components/textarea" },
  ]}
  apis={[
    { title: "Form API", api: formApi },
    { title: "Fieldset API", api: fieldsetApi },
    { title: "Field legend API", api: fieldLegendApi },
    { title: "Field description API", api: fieldDescriptionApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Form/Form.astro",
      type: "component",
    },
    { path: "src/docs/components/form.astro", type: "docs" },
    { path: "src/component-examples/form", type: "docs" },
    {
      path: "packages/opui/css/components/form.css",
      type: "css",
    },
    { path: "src/component-api/form", type: "api" },
  ]}
>
  <Fragment slot="title">Form</Fragment>
  <Fragment slot="preamble">Spacing and grouping for form fields.</Fragment>

  <Usage slot="usage">
    <li slot="when">Spacing a form's fields, groups and buttons.</li>
    <li slot="when">
      Related fields under a heading: a <a href="#fieldset">fieldset</a>.
    </li>
    <li slot="when">
      Checkboxes, radios or switches: a <a href="#field-group">field group</a>.
    </li>
    <li slot="when-not">
      Content that isn't a form: use the
      <DocLink href="/components/layout">Layout</DocLink> classes.
    </li>
    <li slot="when-not">
      Grouping only for the look: use a field group without a fieldset.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" />
  </section>

  <section id="fieldset">
    <h2>Fieldset</h2>
    <p>Label it with <PropOrClass prop="FieldLegend" class="<legend>" />.</p>
    <AutoExample name="FieldsetStacked" />
  </section>

  <section id="field-group">
    <h2>Field group</h2>
    <p>Wrap it in a fieldset to group the fields for screen readers.</p>
    <AutoExample name="FieldGroup" />

    <h3 id="field-group-horizontal">Horizontal</h3>
    <p>
      Use
      <PropOrClass prop='orientation="horizontal"' class=".ui-horizontal" />. To
      join a field and its button into one control, with no space between them,
      use a
      <DocLink href="/components/control-group#fields">Control group</DocLink>.
    </p>
    <AutoExample name="FieldGroupHorizontal" row />
    <AutoExample name="FieldGroupHorizontalFields" />
  </section>

  <section id="states">
    <h2>States</h2>

    <h3 id="fieldset-disabled">Disabled</h3>
    <p>Disable the fieldset to disable every field in it.</p>
    <AutoExample name="FieldsetDisabled" />

    <h3 id="fieldset-invalid">Invalid</h3>
    <p>Point <code>aria-describedby</code> on the fieldset at the error.</p>
    <AutoExample name="FieldsetInvalid" />

    <h3 id="error-summary">Error summary</h3>
    <p>
      A critical <DocLink href="/components/callout">Callout</DocLink> with
      <code>tabindex="-1"</code>. Move focus to it after submit.
    </p>
    <AutoExample name="ErrorSummary" />

    <h3 id="fieldset-required">Required</h3>
    <AutoExample name="FieldsetRequired" />
  </section>

  <section id="actions">
    <h2>Actions</h2>
    <p>
      Buttons line up in a row. Use
      <PropOrClass prop='orientation="vertical"' class=".ui-vertical" /> to
      stack them.
    </p>
    <AutoExample name="Divider" />
    <AutoExample name="ActionsColumn" />
  </section>

  <section id="without-fieldset">
    <h2>Without fieldset</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>as</code> on <code>Form</code>, <code>Fieldset</code> and
        <code>FieldLegend</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-fieldset</code> with <code>role="group"</code> and
        <code>aria-labelledby</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="AdaptiveOutput" />
  </section>

  <section id="kitchen-sink">
    <h2>Kitchen sink</h2>
    <AutoExample name="KitchenSink">
      <Fragment slot="controls">
        <UISwitch
          data-toggle-class="ui-small"
          data-toggle-target=".ui-text-field, .ui-textarea, .ui-select, .ui-radio, .ui-checkbox, .ui-switch, .ui-button, .ui-range"
          ><PropOrClass prop='size="small"' class=".ui-small"
        /></UISwitch>
        <UISwitch
          data-toggle-class="ui-spread; ui-horizontal"
          data-toggle-target=".ui-text-field, .ui-textarea, .ui-select, .ui-checkbox, .ui-switch, .ui-range; .ui-field-group:has(> .ui-radio)"
          ><PropOrClass prop="spread" class=".ui-spread"
        /></UISwitch>
        <UISwitch
          data-toggle-class="kitchen-sink-dividers"
          data-toggle-target="#form-kitchen-sink-1"
        >
          <Conditional>
            <Fragment slot="components"
              >Show <code>&lt;Divider&gt;</code></Fragment
            >
            <Fragment slot="html">Show <code>&lt;hr&gt;</code></Fragment>
          </Conditional>
        </UISwitch>
      </Fragment>
    </AutoExample>
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>A fieldset is a group named by its legend.</li>
    </ul>
  </Fragment>

  <FormBuild slot="under-the-hood" />

  <p slot="installation">
    This doesn't include all the styles for all form elements, just the
    scaffolding around them.
  </p>

  <Fragment slot="anatomy">
    <Anatomy api={anatomyApi}>
      <UIForm style="inline-size: 18rem">
        <UIFieldset>
          <UIFieldLegend>Favorite pet</UIFieldLegend>
          <UIFieldDescription>Pick one.</UIFieldDescription>
          <UIFieldGroup name="form-anatomy">
            <UIRadio value="cat" checked>Cat</UIRadio>
            <UIRadio value="dog">Dog</UIRadio>
          </UIFieldGroup>
          <span class="ui-end-text">Supporting text</span>
        </UIFieldset>
        <UIFieldGroup>
          <UIButton variant="filled">Save</UIButton>
        </UIFieldGroup>
      </UIForm>
    </Anatomy>
  </Fragment>
</Component>

<style is:global>
  /* This is here because the examples don't remove the hr, they just put display none. In real life though they wouldn't be there so it will look right at least. */
  #form-kitchen-sink-1:not(.kitchen-sink-dividers) > hr.ui-divider {
    display: none;
  }

  .ui-field-group {
    &:has(.ui-button):not(:has(*:not(.ui-button))) {
      &:not(hr + &),
      #form-kitchen-sink-1:not(.kitchen-sink-dividers) > & {
        margin-block-start: var(--size-4);
      }
    }
  }
</style>
