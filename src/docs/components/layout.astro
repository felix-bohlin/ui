---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import AutoExample from "../../components/AutoExample.astro"
import Code from "../../components/Code.astro"
import DocLink from "../../components/DocLink.astro"
import LayoutCSS from "@opui/css/components/layout.css?raw"
---

<Component
  slug="layout"
  changelogPaths={[
    { path: "src/docs/components/layout.astro", type: "docs" },
    { path: "src/component-examples/layout", type: "docs" },
    {
      path: "packages/opui/css/components/layout.css",
      type: "css",
    },
    { path: "src/component-api/layout", type: "api" },
  ]}
  installationTabs={[{ title: "layout.css", code: LayoutCSS, lang: "css" }]}
>
  <Fragment slot="title">Layout</Fragment>
  <Fragment slot="preamble">
    Five classes for the space between components: <code>.ui-layout-column</code
    >,
    <code>.ui-layout-row</code>, <code>.ui-layout-grid</code>, <code
      >.ui-layout-media</code
    > and <code>.ui-layout-container</code>. Put them on wrapper elements, such
    as <code>div</code>, <code>section</code> or
    <code>ul</code>. They sit in the <code>utils</code> layer, so on a component they
    replace its own layout. Their gaps come from the <DocLink
      href="/guide/theming#spacing"><code>--ui-space-*</code> scale</DocLink
    >, so they follow <code>--ui-space-scale</code>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Space between components on a page, in a column, a row or a grid.
    </li>
    <li slot="when">
      Cards that fill the width in as many columns as fit, without breakpoints,
      with <a href="#grid"><code>.ui-layout-grid</code></a>.
    </li>
    <li slot="when">
      An avatar or an icon next to text, with <a href="#media"
        ><code>.ui-layout-media</code></a
      >.
    </li>
    <li slot="when-not">
      Space inside a component. Components set their own, and a layout class on
      one replaces it, so put the class on a wrapper.
    </li>
    <li slot="when-not">
      Form fields. Use <DocLink href="/components/form">Form</DocLink>, which
      spaces and groups them.
    </li>
  </Usage>

  <section>
    <h2 id="column">Column</h2>
    <p>
      <code>.ui-layout-column</code> stacks its children in a column with even space
      between them.
    </p>
    <AutoExample name="Column" />
  </section>

  <section>
    <h2 id="row">Row</h2>
    <p>
      <code>.ui-layout-row</code> puts its children in a row, centered on one line,
      and wraps them when they run out of room. Set <code
        >--_justify-content</code
      > to push them to the end.
    </p>
    <AutoExample name="Row" />

    <h3 id="spread">Spread</h3>
    <p>
      <code>.ui-spread</code> pushes the children to the two ends of the row. A page
      header is a spread row around a heading group and a row of actions.
    </p>
    <AutoExample name="Spread" />
  </section>

  <section>
    <h2 id="grid">Grid</h2>
    <p>
      <code>.ui-layout-grid</code> fills the width with as many columns as fit at
      <code>--_min-inline-size</code> (<code>16rem</code> by default), and wraps the
      rest. No breakpoints: it follows the space it has.
    </p>
    <AutoExample name="Grid" />

    <h3 id="lists">Lists</h3>
    <p>
      On a <code>ul</code> or <code>ol</code>, <code>.ui-layout-row</code> and <code
        >.ui-layout-grid</code
      > drop the bullets and the list margins, and a <code>.ui-card</code> alone in
      an <code>li</code> of a grid fills its cell, so the cards in a row share one
      height.
    </p>
    <AutoExample name="List" />
  </section>

  <section>
    <h2 id="media">Media</h2>
    <p>
      <code>.ui-layout-media</code> puts a fixed-size start, such as an avatar or
      an icon, next to text. The last child fills the rest of the row, truncates instead
      of pushing the row wider, and its paragraphs lose their margins. The size classes
      set the gap.
    </p>
    <AutoExample name="Media" />
  </section>

  <section>
    <h2 id="gap">Gap</h2>
    <p>
      The size classes set the gap of <code>.ui-layout-column</code>, <code
        >.ui-layout-row</code
      > and <code>.ui-layout-grid</code>: <code>.ui-x-small</code> is <code
        >--ui-space-1</code
      >, <code>.ui-small</code>
      <code>--ui-space-2</code>, the default <code>--ui-space-3</code> and <code
        >.ui-large</code
      >
      <code>--ui-space-5</code>. For anything else, set <code>--_gap</code>. On
      a
      <code>p</code> or a <code>span</code>, <code>.ui-small</code> also makes the
      text smaller, so put a small layout on a <code>div</code>.
    </p>
    <AutoExample name="Gap" />
  </section>

  <section>
    <h2 id="container">Container</h2>
    <p>
      <code>.ui-layout-container</code> centers its content, caps its width at <code
        >--_max-inline-size</code
      > (<code>72rem</code> by default) and keeps <code>--_padding-inline</code> from
      the edges. Combine the classes to lay out a whole section:
    </p>
    <AutoExample name="Composition" />
  </section>

  <section>
    <h2 id="breakpoints">Breakpoints</h2>
    <p>
      The layout classes need none, but a page that changes shape uses the same
      three container widths everywhere, so similar layouts reflow at the same
      point. Measure the container, not the viewport, with <code
        >container-type: inline-size</code
      > on the wrapper:
    </p>
    <ul>
      <li>
        <code>40rem</code>: two columns, such as a form next to its summary, or
        a toolbar that stops wrapping.
      </li>
      <li>
        <code>56rem</code>: a sidebar next to the content, or three columns.
      </li>
      <li>
        <code>72rem</code>: three panes, such as folders, a list and a reading
        pane.
      </li>
    </ul>
    <Code
      lang="css"
      code={`.page {\n  container-type: inline-size;\n}\n\n@container (inline-size >= 40rem) {\n  .page-columns {\n    grid-template-columns: 1fr 1fr;\n  }\n}`}
    />
  </section>
</Component>
