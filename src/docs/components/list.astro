---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import { List as UIList, ListItem, Switch } from "opui-css/astro"

import ListCSS from "@opui/css/components/list.css?raw"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import listApi from "../../component-api/list/api"
import listItemApi from "../../component-api/list-item/api"
import ListBuild from "../../components/UnderTheHood/ListBuild.astro"

export const description =
  "Lists are continuous, vertical indexes of text and images and video. Use lists to help users find a specific item and act on it."

export const keywords = ["listbox", "menu list", "ul"]
---

<Component
  description={description}
  slug="list"
  heroAnatomy
  apis={[
    { title: "List API", api: listApi },
    { title: "List item API", api: listItemApi },
  ]}
  browserSupport={[
    "color-mix",
    "dir-pseudo",
    "has",
    "overflow-clip",
    "relative-color",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/List/List.astro",
      type: "component",
    },
    {
      path: "packages/opui/components/ListItem/ListItem.astro",
      type: "component",
    },
    { path: "src/docs/components/list.astro", type: "docs" },
    { path: "src/component-examples/list", type: "docs" },
    {
      path: "packages/opui/css/components/list.css",
      type: "css",
    },
    { path: "src/component-api/list", type: "api" },
  ]}
  installationTabs={[{ title: "list.css", code: ListCSS, lang: "css" }]}
>
  <Fragment slot="title">List</Fragment>

  <Usage slot="usage">
    <li slot="when">Rows of similar items, like contacts or files.</li>
    <li slot="when">
      Navigation, with <a href="#selected"><code>aria-current="page"</code></a>.
    </li>
    <li slot="when">
      Settings with a <a href="#checkbox">checkbox</a>,
      <a href="#radio">radio</a> or <a href="#switch">switch</a> per row.
    </li>
    <li slot="when-not">
      Data in columns: use a <DocLink href="/components/table">Table</DocLink>.
    </li>
    <li slot="when-not">
      Actions from a button: use a
      <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      Picking a value: use a <DocLink href="/components/select">Select</DocLink
      >.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" />
  </section>

  <section id="configurations">
    <h2>Configurations</h2>
    <Conditional as="p">
      <Fragment slot="components">
        An item has <a href="#text"><code>label</code></a>,
        <a href="#start-items"><code>start</code></a> and
        <a href="#end-items"><code>end</code></a>.
      </Fragment>
      <Fragment slot="html">
        An item has <a href="#text"><code>.ui-text</code></a>,
        <a href="#start-items"><code>.ui-start</code></a> and
        <a href="#end-items"><code>.ui-end</code></a>.
      </Fragment>
    </Conditional>
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Filled by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        Filled by default. Use <code>.ui-tonal</code> or
        <code>.ui-transparent</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Variants" column />
  </section>

  <section id="clickable-list-item">
    <h2>Clickable list item</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>as="button"</code> or <code>href</code>.
      </Fragment>
      <Fragment slot="html">
        Wrap the item's content in an <code>a</code>, <code>button</code> or
        <code>label</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Clickable" />

    <h3 id="selected">Selected item</h3>
    <p>Add <code>aria-current="page"</code> to the link.</p>
    <AutoExample name="Selected" />
  </section>

  <section id="text">
    <h2>Text</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>label</code> and <code>description</code>.
      </Fragment>
      <Fragment slot="html">
        The first <code>p</code> in <code>.ui-text</code> is the label, the
        second the description.
      </Fragment>
    </Conditional>
    <AutoExample name="Text" />
  </section>

  <section id="start-items">
    <h2>Start items</h2>
    <p>Use <PropOrClass prop="start" class=".ui-start" />.</p>

    <h3 id="icon">Icon</h3>
    <AutoExample name="StartIcon" />

    <h3 id="avatar">Avatar</h3>
    <AutoExample name="StartAvatar" />

    <h3 id="image">Image</h3>
    <AutoExample name="StartImage" />

    <h3 id="video">Video</h3>
    <AutoExample name="StartVideo" />
  </section>

  <section id="end-items">
    <h2>End items</h2>
    <p>Use <PropOrClass prop="end" class=".ui-end" />.</p>

    <h3 id="end-text">Text</h3>
    <AutoExample name="EndText" />

    <h3 id="keyboard-command">Keyboard command</h3>
    <AutoExample name="EndKeyboard" />

    <h3 id="checkbox">Checkbox</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>type="checkbox"</code> with a <code>CheckboxInput</code>.
      </Fragment>
      <Fragment slot="html">
        Wrap the content in <code>&lt;label class="ui-checkbox"&gt;</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="EndCheckbox" />

    <h3 id="radio">Radio</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>type="radio"</code> with a <code>RadioInput</code>, and name
        the group with a <code>Fieldset</code> and a <code>FieldLegend</code>.
      </Fragment>
      <Fragment slot="html">
        Wrap the content in <code>&lt;label class="ui-radio"&gt;</code>, and
        name the group with a <code>&lt;fieldset&gt;</code> and a
        <code>&lt;legend&gt;</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="EndRadio" />

    <h3 id="switch">Switch</h3>
    <AutoExample name="EndSwitch" />
  </section>

  <section id="inset">
    <h2>Inset</h2>
    <p>
      Use <PropOrClass prop="inset" class=".ui-inset" /> to align with items
      that have start content.
    </p>
    <AutoExample name="Inset" />
  </section>

  <section id="flush">
    <h2>Flush</h2>
    <p>
      Use <PropOrClass prop="flush" class=".ui-flush" /> for a list in a card.
    </p>
    <AutoExample name="Flush" />
  </section>

  <section id="borders">
    <h2>Borders</h2>

    <h3 id="on-every-item">Between items</h3>
    <p>Use <PropOrClass prop="bordered" class=".ui-bordered" />.</p>
    <AutoExample name="Bordered" />

    <h3 id="on-one-item">On one item</h3>
    <p>Use <PropOrClass prop="borderTop" class=".ui-border-top" />.</p>
    <AutoExample name="SingleBorder" />
  </section>

  <section id="dense">
    <h2>Dense</h2>
    <p>Use <PropOrClass prop="dense" class=".ui-dense" />.</p>
    <AutoExample name="Dense">
      <Switch
        slot="controls"
        checked
        data-toggle-class="ui-dense"
        data-toggle-target=".ui-list"
        size="small"
      >
        <PropOrClass prop="dense" class=".ui-dense" />
      </Switch>
    </AutoExample>
  </section>

  <ListBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>Keep <code>role="list"</code> for Safari.</li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy api={listItemApi} zoom={1.25}>
      <UIList style="inline-size: 18rem">
        <ListItem
          label="Headline"
          description="Supporting text"
          href="#clickable-list-item"
        >
          <svg
            aria-hidden="true"
            slot="start"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
          >
            <path
              fill="currentColor"
              d="M16 16a7 7 0 1 0 0-14a7 7 0 0 0 0 14m-8.5 2A3.5 3.5 0 0 0 4 21.5v.5c0 2.393 1.523 4.417 3.685 5.793C9.859 29.177 12.802 30 16 30s6.14-.823 8.315-2.207C26.477 26.417 28 24.393 28 22v-.5a3.5 3.5 0 0 0-3.5-3.5z"
            ></path>
          </svg>
          <div slot="end">100+</div>
        </ListItem>
      </UIList>
    </Anatomy>
  </Fragment>
</Component>
