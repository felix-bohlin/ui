---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import ListCSS from "@opui/css/components/list.css?raw"
import MenuCSS from "@opui/css/components/menu.css?raw"

export const description =
  "A popover list of actions or links. CSS only."
---

<Component
  description={description}
  slug="menu"
  browserSupport={[
    "anchor-positioning",
    "invoker-commands",
    "popover",
    "starting-style",
    "transition-behavior",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Menu/Menu.astro",
      type: "component",
    },
    { path: "src/docs/components/menu.astro", type: "docs" },
    { path: "src/component-examples/menu", type: "docs" },
    { path: "packages/opui/css/components/menu.css", type: "css" },
    { path: "src/component-api/menu", type: "api" },
  ]}
  installationTabs={[
    { title: "menu.css", code: MenuCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  seeAlsoLinks={[{ name: "List", href: "/components/list" }]}
>
  <Fragment slot="title">Menu</Fragment>
  <Fragment slot="preamble">
    <p>
      A popover <DocLink href="/components/list">List</DocLink>, anchored to its
      <DocLink href="/components/button">Button</DocLink>. HTML only.
    </p>
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="html"><code>command="toggle-popover"</code> to open, and <code>command="hide-popover"</code> to close.</Fragment>
      <Fragment slot="astro"><code>items</code>, and <code>closeOnClick: false</code> to keep it open.</Fragment>
      <Fragment slot="vue"><code>items</code>, and <code>closeOnClick: false</code> to keep it open.</Fragment>
    </Conditional>

    <AutoExample name="Basics" centered />
  </section>

  <section>
    <h2 id="custom">Custom items</h2>
    <p>
      <code>li.ui-label</code> for groups, and <code>.ui-critical</code> for
      destructive items.
    </p>

    <AutoExample name="Custom" centered />
  </section>

  <section>
    <h2 id="placement">Placement</h2>
    <Conditional as="p">
      <Fragment slot="html"><code>.ui-block-start</code>, <code>.ui-inline-start</code>, <code>.ui-inline-end</code>, or any <code>--anchor-position-area</code>.</Fragment>
      <Fragment slot="astro"><code>placement</code>, or any <code>--anchor-position-area</code>.</Fragment>
      <Fragment slot="vue"><code>placement</code>, or any <code>--anchor-position-area</code>.</Fragment>
    </Conditional>

    <AutoExample name="Placement" row centered />
  </section>

  <section>
    <h2 id="submenu">Submenu</h2>
    <p>A menu inside a list item.</p>

    <AutoExample name="Submenu" centered />
  </section>

  <Fragment slot="accessibility">
    <p><kbd>Tab</kbd> to navigate, and <kbd>Esc</kbd> to close.</p>
  </Fragment>
</Component>
