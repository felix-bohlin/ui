---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import ListCSS from "@opui/css/components/list.css?raw"
import MenuCSS from "@opui/css/components/menu.css?raw"

export const description =
  "A popover list of actions or links. CSS only."
---

<Component
  description={description}
  slug="menu"
  browserSupport={[
    "anchor-positioning",
    "invoker-commands",
    "popover",
    "starting-style",
    "transition-behavior",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Menu/Menu.astro",
      type: "component",
    },
    { path: "src/docs/components/menu.astro", type: "docs" },
    { path: "src/component-examples/menu", type: "docs" },
    { path: "packages/opui/css/components/menu.css", type: "css" },
    { path: "src/component-api/menu", type: "api" },
  ]}
  installationTabs={[
    { title: "menu.css", code: MenuCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  seeAlsoLinks={[{ name: "List", href: "/components/list" }]}
>
  <Fragment slot="title">Menu</Fragment>
  <Fragment slot="preamble">
    <p>
      A popover <DocLink href="/components/list">List</DocLink>, opened by a
      <DocLink href="/components/button">Button</DocLink> or
      <DocLink href="/components/icon-button">Icon Button</DocLink> and anchored
      to it. No JavaScript.
    </p>
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="html">
        <code>menu.ui-menu.ui-list[popover]</code>, opened with
        <code>command="toggle-popover"</code>. Items close it with
        <code>command="hide-popover"</code>.
      </Fragment>
      <Fragment slot="astro">
        <code>items</code>, opened with <code>command="toggle-popover"</code>.
        Items close the menu unless <code>closeOnClick</code> is
        <code>false</code>.
      </Fragment>
      <Fragment slot="vue">
        <code>items</code>, opened with <code>command="toggle-popover"</code>.
        Items close the menu unless <code>closeOnClick</code> is
        <code>false</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" centered />
  </section>

  <section>
    <h2 id="custom">Custom items</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Any <DocLink href="/components/list">List</DocLink> item. Group labels
        with <code>li.ui-label</code>, destructive items with
        <code>.ui-critical</code>.
      </Fragment>
      <Fragment slot="astro">
        <DocLink href="/components/list">ListItem</DocLink> in the default slot.
        Group labels with <code>li.ui-label</code>, destructive items with
        <code>.ui-critical</code>.
      </Fragment>
      <Fragment slot="vue">
        <DocLink href="/components/list">ListItem</DocLink> in the default slot.
        Group labels with <code>li.ui-label</code>, destructive items with
        <code>.ui-critical</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Custom" centered />
  </section>

  <section>
    <h2 id="placement">Placement</h2>
    <Conditional as="p">
      <Fragment slot="html">
        Default, <code>.ui-block-start</code>, <code>.ui-inline-start</code>,
        <code>.ui-inline-end</code>, or any <code>--anchor-position-area</code>.
      </Fragment>
      <Fragment slot="astro">
        <code>placement</code>, or any <code>--anchor-position-area</code>.
      </Fragment>
      <Fragment slot="vue">
        <code>placement</code>, or any <code>--anchor-position-area</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Placement" row centered />
  </section>

  <section>
    <h2 id="submenu">Submenu</h2>
    <p>A menu inside a list item.</p>

    <AutoExample name="Submenu" centered />
  </section>

  <Fragment slot="accessibility">
    <p>
      Navigate with <kbd>Tab</kbd>, close with <kbd>Esc</kbd>. No arrow keys,
      since <code>role="menu"</code> requires JavaScript.
    </p>
  </Fragment>
</Component>
