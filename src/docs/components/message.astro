---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import Code from "../../components/Code.astro"
import Conditional from "../../components/Conditional.astro"
import DocLink from "../../components/DocLink.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import {
  Avatar as UIAvatar,
  Button as UIButton,
  Message as UIMessage,
  MessageList as UIMessageList,
  Reactions as UIReactions,
} from "opui-css/astro"

const saveDom = `document.addEventListener("reaction", async (event) => {
  const reactions = event.target
  const { checked, value } = event.detail
  const response = await fetch(\`/messages/\${reactions.dataset.message}/reactions/\${value}\`, {
    method: checked ? "PUT" : "DELETE",
  })
  if (!response.ok) {
    reactions.announce("Couldn't save the reaction")
    return
  }
  const reply = await response.json()
  for (const input of reactions.group.querySelectorAll("input")) {
    if (!reply.reactions.some((reaction) => reaction.value === input.value)) {
      reactions.delete(input.value)
    }
  }
  for (const reaction of reply.reactions) {
    reactions.set(reaction.value, {
      checked: reaction.checked,
      label: reaction["aria-label"],
      text: reaction.label,
    })
  }
  reactions.announce(reply.status)
})`

const saveReact = `const [reactions, setReactions] = useState(message.reactions)

async function save(event) {
  const { checked, value } = event.detail
  const response = await fetch(\`/messages/\${message.id}/reactions/\${value}\`, {
    method: checked ? "PUT" : "DELETE",
  })
  if (!response.ok) {
    event.target.announce("Couldn't save the reaction")
    return
  }
  const reply = await response.json()
  setReactions(reply.reactions)
  event.target.announce(reply.status)
}

return (
  <Reactions
    aria-label="Reactions"
    id={\`message-\${message.id}\`}
    items={reactions}
    onReaction={save}
  />
)`

const saveSolid = `const [reactions, setReactions] = createSignal(props.message.reactions)

async function save(event) {
  const { checked, value } = event.detail
  const response = await fetch(\`/messages/\${props.message.id}/reactions/\${value}\`, {
    method: checked ? "PUT" : "DELETE",
  })
  if (!response.ok) {
    event.target.announce("Couldn't save the reaction")
    return
  }
  const reply = await response.json()
  setReactions(reply.reactions)
  event.target.announce(reply.status)
}

return (
  <Reactions
    aria-label="Reactions"
    id={\`message-\${props.message.id}\`}
    items={reactions()}
    onReaction={save}
  />
)`

const saveSvelte = `<script>
  let { message } = $props()
  let reactions = $state(message.reactions)

  async function save(event) {
    const { checked, value } = event.detail
    const response = await fetch(\`/messages/\${message.id}/reactions/\${value}\`, {
      method: checked ? "PUT" : "DELETE",
    })
    if (!response.ok) {
      event.target.announce("Couldn't save the reaction")
      return
    }
    const reply = await response.json()
    reactions = reply.reactions
    event.target.announce(reply.status)
  }
</script>

<Reactions
  aria-label="Reactions"
  id="message-{message.id}"
  items={reactions}
  onreaction={save}
/>`

const saveVue = `<script setup>
import { ref } from "vue"

const { message } = defineProps(["message"])
const reactions = ref(message.reactions)

async function save(event) {
  const { checked, value } = event.detail
  const response = await fetch(\`/messages/\${message.id}/reactions/\${value}\`, {
    method: checked ? "PUT" : "DELETE",
  })
  if (!response.ok) {
    event.target.announce("Couldn't save the reaction")
    return
  }
  const reply = await response.json()
  reactions.value = reply.reactions
  event.target.announce(reply.status)
}
</script>

<template>
  <Reactions
    aria-label="Reactions"
    :id="\`message-\${message.id}\`"
    :items="reactions"
    @reaction="save"
  />
</template>`

export const description =
  "Chat bubbles that group by sender, with attachments, reactions and a typing indicator."

export const keywords = ["chat", "chat bubble", "conversation"]
---

<Component
  description={description}
  heroAnatomy
  seeAlsoLinks={[
    { name: "Avatar", href: "/components/avatar" },
    { name: "Card", href: "/components/card" },
    { name: "Menu", href: "/components/menu" },
    { name: "Toggle", href: "/components/toggle" },
  ]}
>
  <Fragment slot="preamble">
    Chat bubbles for a conversation. For a note from the app, use a
    <DocLink href="/components/callout">Callout</DocLink>.
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UIMessageList
        aria-label="Messages with Ellen"
        style="inline-size: 22rem"
      >
        <UIMessage
          author="Ellen"
          datetime="2026-10-08T14:31"
          style="--_actions-opacity: 1"
          time="14:31"
        >
          <UIAvatar slot="start">EN</UIAvatar>
          <p>Here's my totally rad new bass line.</p>
          <Fragment slot="end">Read</Fragment>
          <UIButton
            aria-label="Add reaction"
            round
            size="x-small"
            slot="actions"
          >
            <svg
              data-icon="add"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M11.75 3a.75.75 0 0 1 .743.648l.007.102l.001 7.25h7.253a.75.75 0 0 1 .102 1.493l-.102.007h-7.253l.002 7.25a.75.75 0 0 1-1.493.101l-.007-.102l-.002-7.249H3.752a.75.75 0 0 1-.102-1.493L3.752 11h7.25L11 3.75a.75.75 0 0 1 .75-.75"
              ></path>
            </svg>
          </UIButton>
          <UIReactions
            aria-label="Reactions"
            items={[
              {
                "aria-label": "Thumbs up, 2",
                checked: true,
                label: "👍 2",
                value: "+1",
              },
            ]}
            name="reaction"
            slot="bottom"
          />
        </UIMessage>
      </UIMessageList>
    </Anatomy>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">A conversation, like support chat or direct messages.</li>
    <li slot="when">
      A channel with several senders: <a href="#group-chat">group chat</a>.
    </li>
    <li slot="when-not">
      A note from the app: use a
      <DocLink href="/components/callout">Callout</DocLink>.
    </li>
    <li slot="when-not">
      Comments on a post: use a <DocLink href="/components/list">List</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>
      Mark your own messages with
      <PropOrClass prop="outgoing" class=".ui-outgoing" />.
    </p>
    <AutoExample name="Basics" />
  </section>

  <section id="group-chat">
    <h2>Group chat</h2>
    <p>
      Mark each change of sender with
      <PropOrClass prop="newAuthor" class=".ui-new-author" />. Put a date or an
      event, like someone joining, in an <code>li.ui-divider</code>. Every child
      of <PropOrClass prop="MessageList" class=".ui-message-list" /> is an
      <code>li</code>, since it's a list.
    </p>
    <AutoExample name="GroupChat" />
  </section>

  <section id="direct">
    <h2>Direct</h2>
    <p>
      In a chat between two people, the chat's title already names the other
      person. <PropOrClass prop="direct" class=".ui-direct" /> on the
      <PropOrClass prop="MessageList" class=".ui-message-list" /> leaves out
      every author name and avatar, so the messages are just the bubbles on each
      side. A screen reader still hears who wrote each one.
    </p>
    <AutoExample name="Direct" />
  </section>

  <section id="attachments">
    <h2>Attachments</h2>
    <p>
      An outlined <DocLink href="/components/card">Card</DocLink> in the bubble.
    </p>
    <AutoExample name="Attachments" />
  </section>

  <section id="reactions">
    <h2>Reactions</h2>
    <Conditional as="p">
      <Fragment slot="html"
        >An <code>opui-reactions.ui-reactions</code> in <code>.ui-bottom</code>,
        with a <DocLink href="/components/toggle">Toggle group</DocLink> of
        checkbox pills. Import <code>opui-css/elements/reactions.js</code
        >.</Fragment
      >
      <Fragment slot="nunjucks"
        ><code>Reactions</code> in <code>slots.bottom</code>, with the reactions
        in <code>items</code>. <code>checked</code> marks your own. Load
        <code>opui-css/elements/reactions.js</code> on the page.</Fragment
      >
      <Fragment slot="components"
        ><code>Reactions</code> in the <code>bottom</code> slot, with the
        reactions in <code>items</code>. <code>checked</code> marks your
        own.</Fragment
      >
      <Fragment slot="react"
        ><code>Reactions</code> in the <code>bottom</code> prop, with the
        reactions in <code>items</code>. <code>checked</code> marks your
        own.</Fragment
      >
      <Fragment slot="solid"
        ><code>Reactions</code> in the <code>bottom</code> prop, with the
        reactions in <code>items</code>. <code>checked</code> marks your
        own.</Fragment
      >
      <Fragment slot="svelte"
        ><code>Reactions</code> in the <code>bottom</code> snippet, with the
        reactions in <code>items</code>. <code>checked</code> marks your
        own.</Fragment
      >
    </Conditional>
    <p>
      The add reaction button goes in
      <PropOrClass prop="actions" class=".ui-actions" /> and opens a
      <DocLink href="/components/menu#horizontal">horizontal menu</DocLink>
      whose items have <code>command="--react"</code>, the id of the reactions
      in <code>commandfor</code> and the emoji in <code>value</code>. Here a
      pretend server answers after half a second.
    </p>
    <AutoExample name="Reactions" />
  </section>

  <section id="quick-reaction">
    <h2>Quick reaction</h2>
    <p>
      Outside a message, such as under a post in a
      <DocLink href="/components/card">Card</DocLink>, the add reaction button
      and its menu go inside the reactions.
      <PropOrClass prop="quick" class="[quick-value]" /> keeps one reaction
      first as a dashed pill until someone uses it, so it takes one tap.
    </p>
    <AutoExample name="QuickReaction" />
  </section>

  <section id="saving-reactions">
    <h2>Saving reactions</h2>
    <p>
      A click on a pill or an emoji changes nothing and fires a
      <code>reaction</code> event with the emoji's <code>value</code> and the
      state asked for in <code>event.detail.checked</code>. Save it, then apply
      your server's reply and read a sentence to screen readers with
      <code>announce()</code>.
    </p>
    <Conditional as="div">
      <Fragment slot="html"><Code lang="js" code={saveDom} /></Fragment>
      <Fragment slot="astro"><Code lang="js" code={saveDom} /></Fragment>
      <Fragment slot="react"><Code lang="tsx" code={saveReact} /></Fragment>
      <Fragment slot="solid"><Code lang="tsx" code={saveSolid} /></Fragment>
      <Fragment slot="svelte"
        ><Code lang="svelte" code={saveSvelte}
      /></Fragment>
      <Fragment slot="vue"><Code lang="vue" code={saveVue} /></Fragment>
    </Conditional>
  </section>

  <section id="typing">
    <h2>Typing indicator</h2>
    <Conditional as="p">
      <Fragment slot="html"
        >Add <code>.ui-typing</code>, and <code>role="status"</code> with hidden
        text on the bubble.</Fragment
      >
      <Fragment slot="components">Set <code>typing</code>.</Fragment>
    </Conditional>
    <AutoExample name="Typing" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Name the list with <code>aria-label</code>. Keep
        <code>role="list"</code> for Safari.
      </li>
      <li>
        Keep every child an <code>li</code>: a <code>div</code> or
        <code>p</code> in the list breaks it for screen readers, without a sign
        on screen.
      </li>
      <li>Put the time in a <code>&lt;time datetime&gt;</code>.</li>
      <li>
        Wrap the list of a live conversation in
        <code>&lt;div role="log" aria-label="…"&gt;</code> so screen readers
        announce new messages. The list keeps its items and count.
      </li>
      <li>
        The add reaction button has no visible text, so give it an
        <code>aria-label</code>, and give each emoji in the menu one with its
        name, such as "Thumbs up". The actions hide with <code>opacity</code>,
        so they stay in the tab order and are read by screen readers.
      </li>
      <li>
        A reaction changes after the server answers, so the change itself isn't
        read. Pass a sentence to <code>announce()</code>, which writes it to the
        visually hidden <code>role="status"</code> region inside
        <code>opui-reactions</code>, in the page's language, for a failure too.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="under-the-hood">
    <p>
      <code>li.ui-message</code> is a grid with a <code>start</code> area for
      the avatar, a <code>content</code> area for the bubble, an
      <code>actions</code> area beside it and a <code>bottom</code> area under
      it, pulled up by a negative margin so the reactions sit on the bubble's
      edge. A ring in the page's surface color around each pill keeps it apart
      from the bubble. <code>.ui-outgoing</code> swaps the columns and aligns
      the message to the end. On a device that can hover,
      <code>:not(:hover, :focus-within, :has(:popover-open))</code> fades the
      actions out.
    </p>
    <p>
      <code>opui-reactions</code> is a row that wraps, and has
      <code>display: contents</code> in <code>.ui-bottom</code>. It calls
      <code>preventDefault()</code> on the click of a checkbox in its group,
      which keeps the checkbox as it was, and listens for the
      <code>command</code> event that a button with <code>commandfor</code> and
      <code>command="--react"</code> fires on it, then closes the popover the
      button is in, which returns focus to the button that opened it. A
      <code>.ui-bottom</code> without pills loses its margins, so a message
      whose last reaction is removed closes up. The suggested quick reaction
      differs by its border style, which forced colors keep.
    </p>
    <p>
      A run is found with <code>:has()</code>: a message followed by one on the
      same side tightens its bottom corner on the avatar side and hides its
      avatar, and a message after one on the same side tightens its top corner
      and hides its author. <code>.ui-new-author</code> and any other
      <code>li</code> break the chain.
    </p>
  </Fragment>
</Component>

<script>
  import type { ReactionsElement } from "opui-css/elements/reactions.js"

  document.addEventListener("reaction", (event) => {
    const reactions = event.target as ReactionsElement
    if (!/^message-(quick-reaction|reactions)-/.test(reactions.id)) return
    const { checked, value } = (event as CustomEvent).detail
    const input = [...reactions.querySelectorAll("input")].find(
      (pill) => pill.value === value,
    )
    const [name, count = "0"] =
      input?.getAttribute("aria-label")?.split(", ") ?? []
    const option = document.querySelector(
      `[command="--react"][commandfor="${reactions.id}"][value="${value}"]`,
    )
    const label = name ?? option?.getAttribute("aria-label") ?? value
    const emoji =
      input?.parentElement?.textContent?.trim().split(" ")[0] ??
      option?.textContent?.trim() ??
      ""
    const next = Number(count) + (checked ? 1 : -1)
    setTimeout(() => {
      if (next > 0) {
        reactions.set(value, {
          checked,
          label: `${label}, ${next}`,
          text: `${emoji} ${next}`,
        })
      } else {
        reactions.delete(value)
      }
      reactions.announce(`${label} ${checked ? "added" : "removed"}`)
    }, 500)
  })
</script>
