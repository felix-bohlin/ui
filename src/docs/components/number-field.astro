---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import DefaultIcon from "./partials/DefaultIcon.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import FieldCSS from "@opui/css/components/field.css?raw"
import StepButtonCSS from "@opui/css/components/step-button.css?raw"
import StepButtonJS from "@opui/elements/step-button.js?raw"

import stepButtonApi from "../../component-api/step-button/api"

export const description =
  "A number input in a Field with step buttons that step the value down and up, for amounts like a quantity."

export const keywords = ["counter", "quantity", "spin button", "stepper"]
---

<Component
  description={description}
  base="field"
  slug="number-field"
  browserSupport={[
    "alt-text-generated-content",
    "color-mix",
    "container-queries",
    "container-style-queries",
    "field-sizing",
    "has",
    "invoker-commands",
    "lh",
    "light-dark",
    "reading-flow",
    "registered-custom-properties",
    "relative-color",
    "user-pseudos",
  ]}
  fallbacks={{
    "reading-flow":
      "Without `reading-flow`, nothing changes: the step buttons are already in order.",
  }}
  apis={[{ title: "Step button API", api: stepButtonApi }]}
  installationTabs={[
    { title: "step-button.css", code: StepButtonCSS, lang: "css" },
    { title: "step-button.js", code: StepButtonJS, lang: "js" },
    {
      title: "field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Number field</Fragment>
  <Fragment slot="preamble">
    <p>
      A small amount stepped down and up, like a quantity. For a wide scale, use
      a <DocLink href="/components/range">Range</DocLink>.
    </p>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A small amount stepped up and down, like a <a href="#basics">quantity</a>.
    </li>
    <li slot="when">A number with limits and a <a href="#step">step</a>.</li>
    <li slot="when-not">
      Numbers that are text, like a card number: use a
      <DocLink href="/components/text-field#numeric-vs-input-type-number"
        >Text field</DocLink
      >.
    </li>
    <li slot="when-not">
      A wide scale: use a <DocLink href="/components/range">Range</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <Conditional as="p">
      <Fragment slot="components">
        A <DocLink href="/components/field">Field</DocLink> with an
        <code>&lt;input type="number"&gt;</code> inside. Put a
        <code>StepButton</code> in <code>start</code> and <code>end</code>, with
        <code>for</code> set to the input's <code>id</code>.
      </Fragment>
      <Fragment slot="react">
        A <DocLink href="/components/field">Field</DocLink> with an
        <code>&lt;input type="number"&gt;</code> inside. Put a
        <code>StepButton</code> in <code>start</code> and <code>end</code>, with
        <code>htmlFor</code> set to the input's <code>id</code>.
      </Fragment>
      <Fragment slot="html">
        A <DocLink href="/components/field">Field</DocLink> with an
        <code>&lt;input type="number"&gt;</code> inside. Put
        <code>&lt;opui-step-button&gt;</code> around a button in
        <code>.ui-start</code> and <code>.ui-end</code>, and import
        <code>opui-css/elements/step-button.js</code>.
      </Fragment>
      <Fragment slot="nunjucks">
        A <DocLink href="/components/field">Field</DocLink> with an
        <code>&lt;input type="number"&gt;</code> inside. Put a
        <code>StepButton</code> in <code>slots.start</code> and
        <code>slots.end</code>, with <code>for</code> set to the input's
        <code>id</code>, and load <code>opui-css/elements/step-button.js</code>
        on the page.
      </Fragment>
    </Conditional>
    <AutoExample name="Basics" />
  </section>

  <section id="stretch">
    <h2>Stretch</h2>
    <p>
      Fills the width by default.
      <PropOrClass prop="autoFit" class=".ui-auto-fit" /> fits it to its value.
    </p>
    <AutoExample name="Stretch" column />
  </section>

  <section id="step">
    <h2>Step</h2>
    <p>Use <code>step</code> for decimals.</p>
    <AutoExample name="Step" />
  </section>

  <section id="unit">
    <h2>Unit</h2>
    <p>Put the unit in the end text.</p>
    <AutoExample name="Unit" />
  </section>

  <section id="buttons">
    <h2>Buttons</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Translate with <code>label</code>, and put your own icon inside the
        <code>StepButton</code>.
      </Fragment>
      <Fragment slot="html">
        Translate their <code>aria-label</code>.
      </Fragment>
    </Conditional>
    <DefaultIcon tokens={["--ui-icon-decrease", "--ui-icon-increase"]} />
    <AutoExample name="Buttons" />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <p>The step buttons are disabled while the input is.</p>
    <AutoExample name="Disabled" />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="input" own subject="Fields" />
    <AutoExample name="Validation" row />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Screen readers don't announce a value the step buttons change. The arrow
        keys on the input do.
      </li>
      <li>
        Leave parts that only hold step buttons out of
        <code>aria-describedby</code>.
      </li>
    </ul>
    <KeyboardSupport api={stepButtonApi} />
  </Fragment>
</Component>
