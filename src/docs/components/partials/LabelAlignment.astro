---
import Code from "../../../components/Code.astro"

type Props = {
  control: "checkbox" | "radio" | "switch"
}

const { control } = Astro.props
---

<p>
  The {control} lines up with the first line of its label and centers on the label's
  capital letters, so it looks centered in any font and at any size. If a font still
  looks off, nudge the label with
  {" "}<code>--choice-label-offset</code>, in <code>em</code> or
  {" "}<code>cap</code> so it scales with the label.
</p>
<Code lang="css" code={`:root {\n  --choice-label-offset: 0.05em;\n}`} />
