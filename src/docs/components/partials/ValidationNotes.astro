---
import Conditional from "../../../components/Conditional.astro"
import PropOrClass from "../../../components/PropOrClass.astro"

type Props = {
  element: "input" | "select" | "textarea"
  named?: boolean
  subject: "Checkboxes" | "Fields" | "Switches"
}

const { element, named, subject } = Astro.props
---

<ul>
  <slot>
    <li>
      Use <PropOrClass prop="required" class="[required]" /> on the
      <code>&lt;{element}&gt;</code>.
    </li>
  </slot>
  <li>
    Use <PropOrClass prop="error" class='aria-invalid="true"' /> for
    errors.{named ? null : (
      <Conditional>
        <Fragment slot="html">
          Point <code>aria-describedby</code> at the end text.
        </Fragment>
      </Conditional>
    )}
  </li>
  <li>
    {subject} also get the invalid styles from <code>:user-invalid</code>.
  </li>
</ul>
