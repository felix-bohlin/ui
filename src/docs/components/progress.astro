---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import DocLink from "../../components/DocLink.astro"
import BlockLink from "../../components/BlockLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import { Progress as UIProgress } from "opui-css/astro"

import ProgressCSS from "@opui/css/components/progress.css?raw"
import ProgressBuild from "../../components/UnderTheHood/ProgressBuild.astro"

import progressApi from "../../component-api/progress/api"

export const keywords = ["loading", "meter", "progress bar"]
export const description =
  "A progress bar on the native progress element, for a task that reports how far along it is, or one that doesn't."
---

<Component
  description={description}
  slug="progress"
  heroAnatomy
  browserSupport={["attr", "container-style-queries", "has"]}
  fallbacks={{
    attr: "Without typed `attr()`, a round progress shows as a bar.",
  }}
  apis={[{ title: "Progress API", api: progressApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Progress/Progress.astro",
      type: "component",
    },
    { path: "src/docs/components/progress.astro", type: "docs" },
    { path: "src/component-examples/progress", type: "docs" },
    {
      path: "packages/opui/css/components/progress.css",
      type: "css",
    },
    { path: "src/component-api/progress", type: "api" },
  ]}
  installationTabs={[{ title: "progress.css", code: ProgressCSS, lang: "css" }]}
>
  <Fragment slot="title">Progress</Fragment>
  <Fragment slot="preamble">
    See also:
    <DocLink href="/components/spinner" class="ui-link">Spinner</DocLink>.
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UIProgress
        aria-label="Uploading"
        max="100"
        style="inline-size: 14rem"
        value="60"
      />
    </Anatomy>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A task with a known length, like an upload: a
      <a href="#determinate">value</a>.
    </li>
    <li slot="when">
      An unknown wait: <a href="#indeterminate">indeterminate</a>.
    </li>
    <li slot="when-not">
      A short wait in a small space: use a
      <DocLink href="/components/spinner">Spinner</DocLink>.
    </li>
    <li slot="when-not">
      A measurement, like disk usage: use <code>&lt;meter&gt;</code>.
    </li>
  </Usage>

  <section id="indeterminate">
    <h2>Indeterminate</h2>
    <AutoExample name="Indeterminate" />
  </section>

  <section id="determinate">
    <h2>Determinate</h2>
    <AutoExample name="Determinate" column />
    <BlockLink slug="billing">
      Usage against the plan's limits: a row with the label and the amount above
      each bar, which names the progress through <code>aria-labelledby</code>.
    </BlockLink>
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Tonal by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      track.
    </p>
    <AutoExample name="Surfaces" column />
  </section>

  <section id="inline">
    <h2>Inline</h2>
    <p>Set an <code>inline-size</code> to keep it short.</p>
    <AutoExample name="Inline" />
  </section>

  <section id="round">
    <h2>Round</h2>
    <p>
      Use <PropOrClass prop="round" class=".ui-round" />. Resize with
      <code>--_ring-size</code>.
    </p>
    <AutoExample name="Round" row />
  </section>

  <ProgressBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        Name the bar with <code>aria-label</code> or <code>aria-labelledby</code
        >.
      </li>
      <li>
        For a loading section, set <code>aria-busy="true"</code> on it and point
        its <code>aria-describedby</code> at the bar.
      </li>
    </ul>
    <AutoExample name="AriaBusy" />
  </Fragment>
</Component>
