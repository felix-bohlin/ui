---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"

import ProgressCSS from "@opui/css/components/progress.css?raw"
import Conditional from "../../components/Conditional.astro"
import ProgressBuild from "../../components/UnderTheHood/ProgressBuild.astro"

import progressApi from "../../component-api/progress/api"
---

<Component
  slug="progress"
  browserSupport={["container-style-queries", "has"]}
  apis={[{ title: "Progress API", api: progressApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Progress/Progress.astro",
      type: "component",
    },
    { path: "src/docs/components/progress.astro", type: "docs" },
    { path: "src/component-examples/progress", type: "docs" },
    {
      path: "packages/opui/css/components/progress.css",
      type: "css",
    },
    { path: "src/component-api/progress", type: "api" },
  ]}
  installationTabs={[{ title: "progress.css", code: ProgressCSS, lang: "css" }]}
>
  <Fragment slot="title">Progress</Fragment>
  <Fragment slot="preamble">
    See also: <DocLink href="/components/spinner" class="ui-link"
      >Spinner</DocLink
    >.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A task with a known length, like an upload, with a <a href="#determinate"
        >value</a
      >.
    </li>
    <li slot="when">
      A wait of unknown length, like loading a section, with an <a
        href="#indeterminate">indeterminate</a
      > bar.
    </li>
    <li slot="when-not">
      A short wait in a button or a small space. Use a <DocLink
        href="/components/spinner">Spinner</DocLink
      >.
    </li>
    <li slot="when-not">
      A measurement that isn't progress, like disk usage or a score. That's a <code
        >&lt;meter&gt;</code
      >.
    </li>
  </Usage>

  <section id="indeterminate">
    <h2>Indeterminate</h2>
    <AutoExample name="Indeterminate" />
  </section>

  <section id="determinate">
    <h2>Determinate</h2>
    <AutoExample name="Determinate" column />
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="div">
      <p slot="components">
        Use the <code>variant</code> prop to swap the progress bar track surface for
        better contrast on different backgrounds. The default, <code>tonal</code
        >, is a tonal track.
      </p>
      <p slot="html">
        Use the modifier class <code>.ui-filled</code> on the wrapper <code
          >&lt;div&gt;</code
        > to swap the progress bar track surface for better contrast on different
        backgrounds. Without a class, the track is tonal.
      </p>
    </Conditional>
    <AutoExample name="Surfaces" column />
  </section>

  <section id="inline">
    <h2>Inline</h2>
    <p>
      The bar is an <code>inline-block</code> aligned to the middle of the line, so
      it sits in a line of text or a table cell. Set an <code>inline-size</code> to
      keep it short.
    </p>
    <AutoExample name="Inline" />
  </section>

  <ProgressBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <p>
      Name the bar with <code>aria-label</code>, or <code>aria-labelledby</code>
      pointing at visible text.
    </p>
    <p>
      If the <code>&lt;progress&gt;</code> element is describing the loading progress
      of a section of a page:
    </p>
    <ul>
      <li>use <code>aria-describedby</code> to point to the status</li>
      <li>
        set <code>aria-busy="true"</code> on the section that is being updated, removing
        it when loading is finished.
      </li>
    </ul>
    <p>
      Source: <a
        href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/progress#accessibility"
        class="ui-link">MDN</a
      >
    </p>
    <AutoExample name="AriaBusy" />
  </Fragment>
</Component>
