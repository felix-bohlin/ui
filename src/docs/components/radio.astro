---
import LabelAlignment from "./partials/LabelAlignment.astro"
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Radio as UIRadio } from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import RadioCSS from "@opui/css/components/radio.css?raw"
import ChoiceCSS from "@opui/css/components/choice.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldGroupApi from "../../component-api/field-group/api"
import radioApi from "../../component-api/radio/api"
import radioInputApi from "../../component-api/radio-input/api"

import Conditional from "../../components/Conditional.astro"
import RadioBuild from "../../components/UnderTheHood/RadioBuild.astro"
---

<Component
  slug="radio"
  browserSupport={[
    "dir-pseudo",
    "has",
    "lh",
    "light-dark",
    "relative-color",
    "round-mod-rem",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[
    { title: "Radio API", api: radioApi },
    { title: "Radio input API", api: radioInputApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Radio",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/radio.astro", type: "docs" },
    { path: "src/component-examples/radio", type: "docs" },
    {
      path: "packages/opui/css/components/radio.css",
      type: "css",
    },
    { path: "src/component-api/radio", type: "api" },
    { path: "src/component-api/radio-input", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "radio.css", code: RadioCSS, lang: "css" },
    { title: "choice.css", code: ChoiceCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", seeAlso: true },
  ]}
>
  <Fragment slot="title">Radio</Fragment>
  <Fragment slot="preamble">
    See also: <DocLink href="/components/form" class="ui-link"
      >Form documentation</DocLink
    >.
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        The <code>name</code> prop will get passed down to each radio button in the
        group.
      </Fragment>
      <Fragment slot="html">
        Give every <code>&lt;input type="radio"&gt;</code> in the group the same
        {" "}<code>name</code> attribute. Browsers use that shared name to enforce
        mutual exclusivity within the group.
      </Fragment>
      <Fragment slot="react">
        The <code>name</code> prop will get passed down to each radio button in the
        group.
      </Fragment>
      <Fragment slot="svelte">
        The <code>name</code> prop will get passed down to each radio button in the
        group.
      </Fragment>
      <Fragment slot="vue">
        The <code>name</code> prop will get passed down to each radio button in the
        group.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" centered column />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>, on the <code
          >&lt;label class="ui-radio"&gt;</code
        >.
      </Fragment>
      <Fragment slot="react">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="svelte">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="vue">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section>
    <h2 id="visible-label">Visible label</h2>
    <Conditional as="p">
      <Fragment slot="astro"
        >The default slot is the label. Without a visible label, keep the text
        in the slot and set <code>hideLabel</code> to hide it visually.</Fragment
      >
      <Fragment slot="html"
        >Render the label text inside an element with a <code>.ui-label</code> class.
        Without a visible label, use <code>.ui-sr-only</code> instead of <code
          >.ui-label</code
        > to hide it visually.</Fragment
      >
      <Fragment slot="react"
        ><code>children</code> is the label. Without a visible label, keep the text
        in it and set <code>hideLabel</code> to hide it visually.</Fragment
      >
      <Fragment slot="svelte"
        >The <code>children</code> snippet is the label. Without a visible label,
        keep the text in it and set <code>hideLabel</code> to hide it visually.</Fragment
      >
      <Fragment slot="vue"
        >The default slot is the label. Without a visible label, keep the text
        in the slot and set <code>hideLabel</code> to hide it visually.</Fragment
      >
    </Conditional>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <Conditional as="p">
      <Fragment slot="astro"
        >Set <code>stack</code> to put the label under the radio.</Fragment
      >
      <Fragment slot="html"
        >Add <code>.ui-stack</code> to the <code
          >&lt;label class="ui-radio"&gt;</code
        > to put the label under the radio.</Fragment
      >
      <Fragment slot="react"
        >Set <code>stack</code> to put the label under the radio.</Fragment
      >
      <Fragment slot="svelte"
        >Set <code>stack</code> to put the label under the radio.</Fragment
      >
      <Fragment slot="vue"
        >Set <code>stack</code> to put the label under the radio.</Fragment
      >
    </Conditional>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <Conditional as="p">
      <Fragment slot="astro"
        >Use the <code>endText</code> prop for supporting text under a single radio's
        label, or the <code>end-text</code> slot for rich content. The component points
        <code>aria-describedby</code> at it.</Fragment
      >
      <Fragment slot="html"
        >Add a <code>.ui-end-text</code> element after the label for supporting text
        under a single radio, and point the input's <code>aria-describedby</code
        > at its <code>id</code>.</Fragment
      >
      <Fragment slot="react"
        >Use the <code>endText</code> prop for supporting text under a single radio's
        label. The component points <code>aria-describedby</code> at it.</Fragment
      >
      <Fragment slot="svelte"
        >Use the <code>endText</code> prop for supporting text under a single radio's
        label, or an <code>endText</code> snippet for rich content. The component
        points
        <code>aria-describedby</code> at it.</Fragment
      >
      <Fragment slot="vue"
        >Use the <code>endText</code> prop for supporting text under a single radio's
        label, or the <code>end-text</code> slot for rich content. The component points
        <code>aria-describedby</code> at it.</Fragment
      >
    </Conditional>
    <AutoExample name="EndText" row spacious />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> prop to push the label to the left and the radio
        to the right. Handy for settings cards next to spread checkboxes and switches.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to the <code
          >&lt;label class="ui-radio"&gt;</code
        >
        {" "}to push the label to the left and the radio to the right. Handy for
        settings cards next to spread checkboxes and switches.
      </Fragment>
      <Fragment slot="react">
        Use the <code>spread</code> prop to push the label to the left and the radio
        to the right. Handy for settings cards next to spread checkboxes and switches.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>spread</code> prop to push the label to the left and the radio
        to the right. Handy for settings cards next to spread checkboxes and switches.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> prop to push the label to the left and the radio
        to the right. Handy for settings cards next to spread checkboxes and switches.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column />
  </section>

  <section>
    <h2 id="label-alignment">Label alignment</h2>
    <LabelAlignment control="radio" />
  </section>

  <section>
    <h2 id="field-group-direction">Direction</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Radios stack vertically by default. Set <code>direction="row"</code> on the
        <code>FieldGroup</code> to put them in a row.
      </Fragment>
      <Fragment slot="html">
        Radios stack vertically by default. Add <code>.ui-row</code> to the <code
          >.ui-field-group</code
        > to put them in a row.
      </Fragment>
      <Fragment slot="react">
        Radios stack vertically by default. Set <code>direction="row"</code> on the
        <code>FieldGroup</code> to put them in a row.
      </Fragment>
      <Fragment slot="svelte">
        Radios stack vertically by default. Set <code>direction="row"</code> on the
        <code>FieldGroup</code> to put them in a row.
      </Fragment>
      <Fragment slot="vue">
        Radios stack vertically by default. Set <code>direction="row"</code> on the
        <code>FieldGroup</code> to put them in a row.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldGroupDirection" row />
  </section>

  <section>
    <h2 id="field-group-field-description">Field description</h2>
    <p>Can be placed above and below the fields.</p>
    <AutoExample name="FieldGroupFieldDescription" column centered spacious />
  </section>

  <section>
    <h2 id="field-group-disabled">Disabled</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>disabled</code> on the <code>FieldSet</code> to disable every radio
        in it, or on a single <code>Radio</code>.
      </Fragment>
      <Fragment slot="html">
        Attach the <code>disabled</code> attribute to the <code
          >&lt;fieldset&gt;</code
        > element to disable every radio in it, or to a single <code
          >&lt;input&gt;</code
        >.
      </Fragment>
      <Fragment slot="react">
        Set <code>disabled</code> on the <code>FieldSet</code> to disable every radio
        in it, or on a single <code>Radio</code>.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>disabled</code> on the <code>FieldSet</code> to disable every radio
        in it, or on a single <code>Radio</code>.
      </Fragment>
      <Fragment slot="vue">
        Set <code>disabled</code> on the <code>FieldSet</code> to disable every radio
        in it, or on a single <code>Radio</code>.
      </Fragment>
    </Conditional>

    <p>
      <code>aria-disabled="true"</code> on the <code>&lt;input&gt;</code> looks the
      same, but keeps the radio focusable and its value in the form. It doesn't stop
      the change, so block it with a script.
    </p>
    <AutoExample name="FieldGroupDisabled" row />
  </section>

  <section>
    <h2 id="field-group-required">Required</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>required</code> on at least one <code>Radio</code> in the group.
      </Fragment>
      <Fragment slot="react">
        Set the <code>required</code> prop on at least one <code>Radio</code>.
        It is forwarded to the underlying <code>&lt;input&gt;</code>.
      </Fragment>
      <Fragment slot="svelte">
        Add the <code>required</code> attribute on at least one <code
          >Radio</code
        >. It is forwarded to the underlying <code>&lt;input&gt;</code>.
      </Fragment>
      <Fragment slot="vue">
        Add the <code>required</code> attribute on at least one <code
          >Radio</code
        >. It is forwarded to the underlying <code>&lt;input&gt;</code>.
      </Fragment>
      <Fragment slot="html">
        Attach the <code>required</code> attribute to at least one of your <code
          >&lt;input&gt;</code
        > elements.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldGroupRequired" row />
  </section>

  <section>
    <h2 id="field-group-validation">Validation</h2>
    <Conditional>
      <p slot="html">
        Add <code>aria-invalid="true"</code> to each <code>&lt;input&gt;</code> in
        the group. The end text of the <code>.ui-fieldset</code> turns red with them.
      </p>
      <p slot="astro">
        Set <code>error</code> on each <code>Radio</code> in the group. The end text
        of the <code>FieldSet</code> turns red with them.
      </p>
      <p slot="react">
        Set <code>error</code> on each <code>Radio</code> in the group. The end text
        of the <code>FieldSet</code> turns red with them.
      </p>
      <p slot="svelte">
        Set <code>error</code> on each <code>Radio</code> in the group. The end text
        of the <code>FieldSet</code> turns red with them.
      </p>
      <p slot="vue">
        Set <code>error</code> on each <code>Radio</code> in the group. The end text
        of the <code>FieldSet</code> turns red with them.
      </p>
    </Conditional>
    <p>
      Give the end text an <code>id</code> and point <code
        >aria-describedby</code
      >
      on the fieldset at it, so screen readers read the error with the group.
    </p>
    <AutoExample name="FieldGroupValidation" row />
  </section>

  <section>
    <h2 id="field-group-binding">Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Astro renders the group on the server, so it has no bound value. The
        selected value lives in the inputs, which share the group's <code
          >name</code
        >. Submit them with a form, where <code>FormData.get()</code> reads it, or
        read the checked input in a script on <code>change</code>. Set <code
          >input.checked = input.defaultChecked</code
        > to go back to the <code>checked</code> radio.
      </Fragment>
      <Fragment slot="html">
        The selected value lives in the inputs, which share a <code>name</code>.
        Submit them with a form, where <code>FormData.get()</code> reads it, or read
        the checked input in a script on <code>change</code>. Set <code
          >input.checked = input.defaultChecked</code
        > to go back to the <code>checked</code> input in the markup.
      </Fragment>
      <Fragment slot="react">
        Keep the selected value in your own state. Pass each <code>Radio</code> a
        <code>checked</code> and an <code>onChange</code> that stores its <code
          >value</code
        >.
      </Fragment>
      <Fragment slot="svelte">
        Bind the selected value with <code>bind:group</code> on each <code
          >Radio</code
        >. It holds the <code>value</code> of the checked radio, and setting it updates
        the radios.
      </Fragment>
      <Fragment slot="vue">
        Bind the selected value with <code>v-model</code> on each <code
          >Radio</code
        >. It holds the <code>value</code> of the checked radio, and setting it updates
        the radios.
      </Fragment>
    </Conditional>
    <AutoExample name="FieldGroupBinding" centered column />
  </section>

  <Fragment slot="accessibility">
    <h3 id="keyboard-support">Keyboard support</h3>
    <div class="ui-not-rich-text">
      <table class="ui-table">
        <thead>
          <tr>
            <th>Key</th>
            <th>Function</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><kbd>Tab</kbd></td>
            <td>
              Moves focus into the group, to the checked radio. When none is
              checked, focus goes to the first radio.
            </td>
          </tr>
          <tr>
            <td>Arrow keys</td>
            <td>Move focus to the next or previous radio and select it.</td>
          </tr>
          <tr>
            <td><kbd>Space</kbd></td>
            <td>Selects the focused radio.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </Fragment>

  <RadioBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UIRadio checked name="radio-anatomy">
        Label
        <Fragment slot="end-text">End text</Fragment>
      </UIRadio>
    </Anatomy>
  </Fragment>
</Component>
