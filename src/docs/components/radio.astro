---
import FieldGroupNotes from "./partials/FieldGroupNotes.astro"
import LabelAlignment from "./partials/LabelAlignment.astro"
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Radio as UIRadio } from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import RadioCSS from "@opui/css/components/radio.css?raw"
import ChoiceCSS from "@opui/css/components/choice.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldGroupApi from "../../component-api/field-group/api"
import radioApi from "../../component-api/radio/api"
import radioInputApi from "../../component-api/radio-input/api"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import RadioBuild from "../../components/UnderTheHood/RadioBuild.astro"

export const keywords = ["option", "radio button", "radio group"]
export const description =
  "Radio buttons on the native radio input, for picking one option from a few, with sizes, cards and an invalid state."
---

<Component
  description={description}
  slug="radio"
  browserSupport={[
    "container-style-queries",
    "has",
    "lh",
    "light-dark",
    "relative-color",
    "round-mod-rem",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[
    { title: "Radio API", api: radioApi },
    { title: "Radio input API", api: radioInputApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Radio",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/radio.astro", type: "docs" },
    { path: "src/component-examples/radio", type: "docs" },
    {
      path: "packages/opui/css/components/radio.css",
      type: "css",
    },
    { path: "src/component-api/radio", type: "api" },
    { path: "src/component-api/radio-input", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "radio.css", code: RadioCSS, lang: "css" },
    { title: "choice.css", code: ChoiceCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", isDependency: true },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Radio</Fragment>
  <Fragment slot="preamble">
    See also:
    <DocLink href="/components/form" class="ui-link">Form documentation</DocLink
    >.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">One choice out of a few, like a shipping speed.</li>
    <li slot="when">
      Choices with a description: <a href="#end-text">end text</a> or
      <a href="#cards">cards</a>.
    </li>
    <li slot="when-not">
      A long list: use a <DocLink href="/components/select">Select</DocLink>.
    </li>
    <li slot="when-not">
      Several choices, or on and off: use a
      <DocLink href="/components/checkbox">Checkbox</DocLink>.
    </li>
    <li slot="when-not">
      A view or mode in a toolbar: use a
      <DocLink href="/components/toggle#toggle-group">Toggle group</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>
      Give the radios in a group the same <code>name</code>. A checked radio
      fills with the accent, or keeps its circle and draws only the dot when a
      theme sets <code>--ui-choice-checked: mark</code>.
    </p>

    <AutoExample name="Basics" centered column />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section id="visible-label">
    <h2>Visible label</h2>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="hidden-label">Hidden label</h3>
    <p>Use <PropOrClass prop="hideLabel" class=".ui-sr-only" />.</p>
    <AutoExample name="HiddenLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <p>
      Use <PropOrClass prop='orientation="vertical"' class=".ui-vertical" /> to
      put the label under the radio.
    </p>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <p>Use <PropOrClass prop="endText" class=".ui-end-text" />.</p>
    <AutoExample name="EndText" row spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the radio at the
      end.
    </p>

    <AutoExample name="Spread" column />
  </section>

  <section id="cards">
    <h2>Cards</h2>
    <p>
      Use <PropOrClass prop="card" class=".ui-card" />, with
      <PropOrClass prop="spread" class=".ui-spread" />. Cards are outlined by
      default, and
      <Conditional>
        <Fragment slot="components"><code>variant</code> changes</Fragment>
        <Fragment slot="html"
          ><code>.ui-elevated</code> and <code>.ui-tonal</code> change</Fragment
        >
      </Conditional>
      the surface.
    </p>

    <AutoExample name="CardsMatrix" column />
  </section>

  <section id="label-alignment">
    <h2>Label alignment</h2>
    <LabelAlignment control="radio" />
  </section>

  <section id="radio-input">
    <h2>Radio input</h2>
    <p>
      <PropOrClass prop="RadioInput" class='<input type="radio">' /> without the
      label, as in a
      <DocLink href="/components/list#radio" class="ui-link">List</DocLink>.
    </p>
  </section>

  <section id="field-group">
    <h2>Field group</h2>
    <FieldGroupNotes control="radio" />
    <Conditional as="div">
      <Fragment slot="svelte">
        <p>
          Without <code>bind:group</code>, pass <code>checked</code> and
          <code>onchange</code>.
        </p>
        <AutoExample name="FieldGroupControlled" centered column />
      </Fragment>
      <Fragment slot="vue">
        <p>
          Without <code>v-model</code>, pass <code>:checked</code> and
          <code>@change</code>.
        </p>
        <AutoExample name="FieldGroupControlled" centered column />
      </Fragment>
    </Conditional>
  </section>

  <Fragment slot="accessibility">
    <KeyboardSupport />
  </Fragment>

  <RadioBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <UIRadio checked name="radio-anatomy">
        Label
        <Fragment slot="end-text">End text</Fragment>
      </UIRadio>
    </Anatomy>
  </Fragment>
</Component>
