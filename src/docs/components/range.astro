---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Field as UIField } from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"

import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import RangeBuild from "../../components/UnderTheHood/RangeBuild.astro"

export const description =
  "A slider for picking a number by moving a thumb along a track."

export const keywords = ["slider"]
---

<Component description={description} heroAnatomy>
  <Fragment slot="preamble">
    A value where the rough position matters, like volume. For an exact amount,
    like a quantity, use a
    <DocLink href="/components/number-field">Number field</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A value where the rough position matters more than the exact number, like
      volume or brightness.
    </li>
    <li slot="when">
      A value on a scale with a few named steps, with
      <a href="#labels">labels</a>.
    </li>
    <li slot="when-not">
      An exact number, like a quantity or a price. Use a
      <DocLink href="/components/number-field">Number field</DocLink>, or a
      <DocLink href="/components/text-field#numeric-vs-input-type-number"
        >Text field</DocLink
      >
      with <code>inputmode="numeric"</code>.
    </li>
    <li slot="when-not">
      Named options. Use a <DocLink href="/components/select">Select</DocLink>
      or a <DocLink href="/components/radio">Radio</DocLink> group.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>
      A <DocLink href="/components/field">Field</DocLink> with an
      <code>&lt;input type="range"&gt;</code> inside.
    </p>
    <AutoExample name="Basics" column />
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      The track is outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      track.
    </p>
    <AutoExample name="Surfaces" column spacious />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column />
  </section>

  <section id="value">
    <h2>Value</h2>
    <p>
      Show the value yourself, in an <code>&lt;output&gt;</code> in the end
      text.
    </p>
    <Conditional as="p">
      <Fragment slot="svelte">
        Give the input <code>defaultValue</code> too, so a form reset brings its
        value back.
      </Fragment>
    </Conditional>
    <AutoExample name="Value" column />
  </section>

  <section id="labels">
    <h2>Labels</h2>
    <p>
      Link a <code>&lt;datalist&gt;</code> with <code>list</code>, with evenly
      spaced values. Each option's <code>label</code> shows under its value.
    </p>
    <AutoExample name="TickMarksLabels" column />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="input" own subject="Fields">
      <li>
        A range always has a value, so <code>required</code> doesn't apply.
      </li>
    </ValidationNotes>
    <AutoExample name="Validation" column />
  </section>

  <RangeBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIField
        endText="End text"
        for="range-anatomy"
        label="Label"
        startText="Start text"
        style="inline-size: 18rem"
      >
        <input
          aria-describedby="range-anatomy-start-text range-anatomy-end-text"
          id="range-anatomy"
          list="range-anatomy-list"
          type="range"
        />
        <datalist aria-hidden="true" id="range-anatomy-list">
          <option label="0" value="0"></option>
          <option label="100" value="100"></option>
        </datalist>
      </UIField>
    </Anatomy>
  </Fragment>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Set <code>aria-valuetext</code> when the number alone doesn't say the
        value, like a unit or a label.
      </li>
      <li>
        Leave an end text that only holds the <code>&lt;output&gt;</code> out of
        <code>aria-describedby</code>.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>
</Component>
