---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Range as UIRange } from "opui-css/astro"

import AutoExample from "../../components/AutoExample.astro"

import RangeCSS from "@opui/css/components/range.css?raw"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import RangeBuild from "../../components/UnderTheHood/RangeBuild.astro"

import rangeApi from "../../component-api/range/api"
export const description =
  "A slider for picking a number by moving a thumb along a track."

export const keywords = ["slider"]
---

<Component
  description={description}
  slug="range"
  heroAnatomy
  apis={[{ title: "Range API", api: rangeApi }]}
  browserSupport={[
    "container-queries",
    "container-style-queries",
    "datalist",
    "dir-pseudo",
    "has",
    "light-dark",
    "registered-custom-properties",
    "relative-color",
    "scroll-driven-animations",
    "user-pseudos",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Range/Range.astro",
      type: "component",
    },
    { path: "src/docs/components/range.astro", type: "docs" },
    { path: "src/component-examples/range", type: "docs" },
    {
      path: "packages/opui/css/components/range.css",
      type: "css",
    },
    { path: "src/component-api/range", type: "api" },
  ]}
  installationTabs={[{ title: "range.css", code: RangeCSS, lang: "css" }]}
>
  <Fragment slot="title">Range</Fragment>

  <Usage slot="usage">
    <li slot="when">
      A value where the rough position matters more than the exact number, like
      volume or brightness.
    </li>
    <li slot="when">
      A value on a scale with a few marked steps, with
      <a href="#tick-marks">tick marks</a>.
    </li>
    <li slot="when-not">
      An exact number, like a quantity or a price. Use a
      <DocLink href="/components/text-field#numeric-vs-input-type-number"
        >Text field</DocLink
      >
      with <code>inputmode="numeric"</code>.
    </li>
    <li slot="when-not">
      Named options. Use a <DocLink href="/components/select">Select</DocLink>
      or a <DocLink href="/components/radio">Radio</DocLink> group.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <AutoExample name="Basics" column />
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <Conditional as="p">
      <Fragment slot="components">
        The track is outlined by default. Use <code>variant</code> to change it.
      </Fragment>
      <Fragment slot="html">
        The track is outlined by default. Use <code>.ui-filled</code> or
        <code>.ui-tonal</code> to change it.
      </Fragment>
    </Conditional>
    <AutoExample name="Surfaces" column spacious />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" column />
  </section>

  <section id="start-end-text">
    <h2>Start and end text</h2>
    <AutoExample name="StartEndText" column />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" column />
  </section>

  <section id="value">
    <h2>Value</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>valueSuffix</code> for a live readout.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-value[data-live]</code> and import
        <code>opui-css/css/js/range.js</code> for a live readout.
      </Fragment>
    </Conditional>
    <Conditional as="p">
      <Fragment slot="astro">
        For your own readout, use the <code>value-text</code> slot, update it on
        <code>input</code>, and set <code>aria-valuetext</code> to match.
      </Fragment>
      <Fragment slot="html">
        For your own readout, leave out <code>data-live</code>, update the
        output on <code>input</code>, and set <code>aria-valuetext</code> to
        match.
      </Fragment>
      <Fragment slot="react">
        For your own readout, render <code>valueText</code> from your state and
        set <code>aria-valuetext</code> to match.
      </Fragment>
      <Fragment slot="svelte">
        For your own readout, render the <code>valueText</code> snippet from the
        bound value and set <code>aria-valuetext</code> to match.
      </Fragment>
      <Fragment slot="vue">
        For your own readout, render the <code>value-text</code> slot from the
        <code>v-model</code> value and set <code>aria-valuetext</code> to match.
      </Fragment>
    </Conditional>
    <AutoExample name="Value" column />
    <AutoExample name="ValueText" column />
  </section>

  <section id="tick-marks">
    <h2>Tick marks</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Pass <code>items</code> for tick marks.
      </Fragment>
      <Fragment slot="html">
        Link a <code>&lt;datalist&gt;</code> with <code>list</code>, and import
        <code>opui-css/css/js/range.js</code> so labeled ticks are read as
        <code>aria-valuetext</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="TickMarksLabels" column />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="input" subject="Fields">
      <li>
        A range always has a value, so <code>required</code> doesn't apply.
      </li>
    </ValidationNotes>
    <AutoExample name="Validation" column />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      slider.
    </p>
    <AutoExample name="Spread" column />
  </section>

  <RangeBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIRange
        endText="End text"
        label="Label"
        items={[
          { label: "0", value: 0 },
          { label: "100", value: 100 },
        ]}
        startText="Start text"
        style="inline-size: 18rem"
        value="50"
        valueSuffix=""
      />
    </Anatomy>
  </Fragment>

  <Fragment slot="accessibility">
    <KeyboardSupport />
  </Fragment>
</Component>
