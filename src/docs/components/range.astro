---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Range as UIRange } from "@opui/astro"

import AutoExample from "../../components/AutoExample.astro"

import RangeCSS from "@opui/css/components/range.css?raw"
import Conditional from "../../components/Conditional.astro"
import RangeBuild from "../../components/UnderTheHood/RangeBuild.astro"

import rangeApi from "../../component-api/range/api"
export const description =
  "Range lets users pick a number by sliding a thumb along a track."
---

<Component
  description={description}
  slug="range"
  heroAnatomy
  apis={[{ title: "Range API", api: rangeApi }]}
  browserSupport={[
    "container-queries",
    "datalist",
    "dir-pseudo",
    "has",
    "light-dark",
    "registered-custom-properties",
    "relative-color",
    "scroll-driven-animations",
    "user-pseudos",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Range/Range.astro",
      type: "component",
    },
    { path: "src/docs/components/range.astro", type: "docs" },
    { path: "src/component-examples/range", type: "docs" },
    {
      path: "packages/opui/css/components/range.css",
      type: "css",
    },
    { path: "src/component-api/range", type: "api" },
  ]}
  installationTabs={[{ title: "range.css", code: RangeCSS, lang: "css" }]}
>
  <Fragment slot="title">Range</Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <AutoExample name="Default" column />
  </section>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional>
      <p slot="astro">
        Use the <code>variant</code> prop to swap the track surface for better contrast
        on different backgrounds. Without a variant, the track uses <code
          >--field-border-color</code
        >, like the border of a text field.
      </p>
      <p slot="html">
        Use the <code>.ui-filled</code> or <code>.ui-tonal</code>
        {" "}class to swap the track surface for better contrast on different
        backgrounds. Without a class, the track uses <code
          >--field-border-color</code
        >, like the border of a text field.
      </p>
      <p slot="svelte">
        Use the <code>variant</code> prop to swap the track surface for better contrast
        on different backgrounds. Without a variant, the track uses <code
          >--field-border-color</code
        >, like the border of a text field.
      </p>
      <p slot="vue">
        Use the <code>variant</code> prop to swap the track surface for better contrast
        on different backgrounds. Without a variant, the track uses <code
          >--field-border-color</code
        >, like the border of a text field.
      </p>
    </Conditional>
    <AutoExample name="Surfaces" column spacious />
  </section>

  <section>
    <h2 id="start-end-text">Start and end text</h2>
    <AutoExample name="StartEndText" column />
  </section>

  <section>
    <h2 id="value">Value</h2>
    <Conditional>
      <p slot="astro">
        Pass the <code>valueSuffix</code> prop (or use the <code>value</code> named
        slot) to render a live readout of the slider's current value next to the label.
        The component wires up an <code>&lt;output&gt;</code> element and keeps its
        text in sync with the input.
      </p>
      <p slot="html">
        Add an <code>&lt;output class="ui-value"&gt;</code> sibling to the{" "}
        <code>.ui-label</code> with <code>for</code> pointing at the input's id. Optionally
        set <code>data-suffix</code> for a unit (e.g. <code>°</code>,{" "}
        <code>px</code>). Updating its text content is the consumer's
        responsibility. The example does it with an <code>input</code> listener.
      </p>
      <p slot="svelte">
        Pass the <code>valueSuffix</code> prop (or use the <code>valueText</code
        >
        snippet) to render a live readout of the slider's current value next to the
        label. The component wires up an <code>&lt;output&gt;</code> element and keeps
        its text in sync with the input.
      </p>
      <p slot="vue">
        Pass the <code>valueSuffix</code> prop (or use the <code>value</code> named
        slot) to render a live readout of the slider's current value next to the label.
        The component wires up an <code>&lt;output&gt;</code> element and keeps its
        text in sync with the input.
      </p>
    </Conditional>
    <AutoExample name="Value" column />
  </section>

  <section>
    <h2 id="tick-marks">Tick marks</h2>
    <Conditional>
      <p slot="astro">
        Pass an id to the <code>list</code> prop together with an <code
          >options</code
        >
        {" "}array - <code>{"options=[{ value, label }]"}</code> - and the component
        renders a matching <code>&lt;datalist&gt;</code>.
      </p>
      <p slot="html">
        Use the <code>list</code> attribute on the <code>&lt;input&gt;</code> and
        follow it with a <code>&lt;datalist&gt;</code> element containing{" "}
        <code>&lt;option&gt;</code> elements with <code>value</code> and{" "}
        <code>label</code> attributes.
      </p>
      <p slot="svelte">
        Pass an id to the <code>list</code> prop together with an <code
          >options</code
        >
        {" "}array - <code>{"options=[{ value, label }]"}</code> - and the component
        renders a matching <code>&lt;datalist&gt;</code>.
      </p>
      <p slot="vue">
        Pass an id to the <code>list</code> prop together with an <code
          >options</code
        >
        {" "}array - <code>{"options=[{ value, label }]"}</code> - and the component
        renders a matching <code>&lt;datalist&gt;</code>.
      </p>
    </Conditional>
    <AutoExample name="TickMarksLabels" column />
  </section>

  <section>
    <h2 id="disabled">Disabled</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set the <code>disabled</code> prop to disable the slider. The whole range
        dims and shows a not-allowed cursor.
      </Fragment>
      <Fragment slot="html">
        Add <code>disabled</code> to the <code>&lt;input&gt;</code> to disable the
        slider. The whole <code>.ui-range</code> dims and shows a not-allowed cursor.
      </Fragment>
      <Fragment slot="svelte">
        Set the <code>disabled</code> prop to disable the slider. The whole range
        dims and shows a not-allowed cursor.
      </Fragment>
      <Fragment slot="vue">
        Set the <code>disabled</code> prop to disable the slider. The whole range
        dims and shows a not-allowed cursor.
      </Fragment>
    </Conditional>
    <AutoExample name="Disabled" column />
  </section>

  <section>
    <h2 id="validation">Validation</h2>
    <Conditional>
      <Fragment slot="astro">
        <ul>
          <li>
            Use the <code>error</code> prop to toggle invalid styles: the thumb, the
            fill and the helper texts turn the invalid color. It sets <code
              >aria-invalid="true"</code
            > on the input, so screen readers announce it as invalid.
          </li>
          <li>
            Say what's wrong in the end text. The component points <code
              >aria-describedby</code
            > at it.
          </li>
          <li>
            The same styles apply when the browser's own validation fails (<code
              >:user-invalid</code
            >), such as after <code>setCustomValidity()</code>.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="html">
        <ul>
          <li>
            Add <code>aria-invalid="true"</code> to the <code
              >&lt;input&gt;</code
            > to toggle invalid styles: the thumb, the fill and the helper texts turn
            the invalid color. Screen readers announce it as invalid.
          </li>
          <li>
            Say what's wrong in the end text, and point <code
              >aria-describedby</code
            > at it.
          </li>
          <li>
            The same styles apply when the browser's own validation fails (<code
              >:user-invalid</code
            >), such as after <code>setCustomValidity()</code>.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="svelte">
        <ul>
          <li>
            Use the <code>error</code> prop to toggle invalid styles: the thumb, the
            fill and the helper texts turn the invalid color. It sets <code
              >aria-invalid="true"</code
            > on the input, so screen readers announce it as invalid.
          </li>
          <li>
            Say what's wrong in the end text. The component points <code
              >aria-describedby</code
            > at it.
          </li>
          <li>
            The same styles apply when the browser's own validation fails (<code
              >:user-invalid</code
            >), such as after <code>setCustomValidity()</code>.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="vue">
        <ul>
          <li>
            Use the <code>error</code> prop to toggle invalid styles: the thumb, the
            fill and the helper texts turn the invalid color. It sets <code
              >aria-invalid="true"</code
            > on the input, so screen readers announce it as invalid.
          </li>
          <li>
            Say what's wrong in the end text. The component points <code
              >aria-describedby</code
            > at it.
          </li>
          <li>
            The same styles apply when the browser's own validation fails (<code
              >:user-invalid</code
            >), such as after <code>setCustomValidity()</code>.
          </li>
        </ul>
      </Fragment>
    </Conditional>
    <AutoExample name="Validation" column />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the slider on the right. The value, tick marks and end text
        go under the slider. The layout collapses to a column in containers narrower
        than 400px.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to display the label and start text
        on the left with the slider on the right. The value, tick marks and end text
        go under the slider. The layout collapses to a column in containers narrower
        than 400px.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the slider on the right. The value, tick marks and end text
        go under the slider. The layout collapses to a column in containers narrower
        than 400px.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the slider on the right. The value, tick marks and end text
        go under the slider. The layout collapses to a column in containers narrower
        than 400px.
      </Fragment>
    </Conditional>
    <AutoExample name="Row" column />
  </section>

  <RangeBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UIRange
        endText="End text"
        label="Label"
        startText="Start text"
        style="inline-size: 18rem"
        value="50"
        valueSuffix=""
      />
    </Anatomy>
  </Fragment>

  <Fragment slot="accessibility">
    <ul>
      <li>
        <kbd>Right Arrow</kbd>: Increase the value of the slider by one step.
      </li>
      <li>
        <kbd>Up Arrow</kbd>: Increase the value of the slider by one step.
      </li>
      <li>
        <kbd>Left Arrow</kbd>: Decrease the value of the slider by one step.
      </li>
      <li>
        <kbd>Down Arrow</kbd>: Decrease the value of the slider by one step.
      </li>
      <li>
        <kbd>Home</kbd>: Set the slider to the first allowed value in its range.
      </li>
      <li>
        <kbd>End</kbd>: Set the slider to the last allowed value in its range.
      </li>
      <li>
        <kbd>Page Up</kbd> (Optional): Increase the slider value by an amount larger
        than the step change made by <kbd>Up Arrow</kbd>.
      </li>
      <li>
        <kbd>Page Down</kbd> (Optional): Decrease the slider value by an amount larger
        than the step change made by <kbd>Down Arrow</kbd>.
      </li>
    </ul>
  </Fragment>
</Component>
