---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Select as UISelect } from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import FieldCSS from "@opui/css/components/text-field.css?raw"
import SelectCSS from "@opui/css/components/select.css?raw"
import ListCSS from "@opui/css/components/list.css?raw"
import selectApi from "../../component-api/select/api"
import SelectBuild from "../../components/UnderTheHood/SelectBuild.astro"

export const keywords = ["combobox", "dropdown", "option", "picker"]
---

<Component
  slug="select"
  browserSupport={[
    "color-mix",
    "container-queries",
    "customizable-select",
    "dir-pseudo",
    "display-animation",
    "field-sizing",
    "has",
    "lh",
    "open-pseudo",
    "overflow-clip",
    "overlay",
    "relative-color",
    "starting-style",
    "transition-behavior",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[{ title: "Select API", api: selectApi }]}
  installationTabs={[
    {
      title: "text-field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "select.css", code: SelectCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Select/Select.astro",
      type: "component",
    },
    { path: "src/docs/components/select.astro", type: "docs" },
    { path: "src/component-examples/select", type: "docs" },
    {
      path: "packages/opui/css/components/select.css",
      type: "css",
    },
    { path: "src/component-api/select", type: "api" },
  ]}
  seeAlsoLinks={[
    {
      name: "Customizable select (MDN)",
      href: "https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Customizable_select",
    },
  ]}
>
  <Fragment slot="title">Select</Fragment>
  <Fragment slot="preamble">
    Leverages the <DocLink href="/components/list" class="ui-link"
      >List component</DocLink
    > to provide markup for the Select popover. Use a Select to pick a value in a
    form. For actions, use a <DocLink href="/components/menu">Menu</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Picking one value from a list in a form, like a country.
    </li>
    <li slot="when">
      Lists too long to show as radios, grouped under headings with <a
        href="#option-groups">option groups</a
      >.
    </li>
    <li slot="when-not">
      Actions. Use a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      A few options that fit on screen. Use a <DocLink href="/components/radio"
        >Radio</DocLink
      > group, so all of them are visible.
    </li>
    <li slot="when-not">
      Free text with suggestions. Use a <DocLink
        href="/components/text-field#autosuggest">Text field</DocLink
      > with a <code>&lt;datalist&gt;</code>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      The select is outlined by default. Use <PropOrClass
        prop='variant="filled"'
        class=".ui-filled"
      /> for a filled background.
    </p>
    <AutoExample name="Variants" row spacious />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, <code>medium</code> (the default) and <code
          >large</code
        >.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>.
      </Fragment>
    </Conditional>
    <p>
      On touch screens, x-small and small fields keep the default text size (<code
        >--ui-font-size-control</code
      >, 16px), so iOS Safari doesn't zoom in when one is focused.
    </p>
    <AutoExample name="Sizes" row spacious />
  </section>

  <section id="dense">
    <h2>Dense</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>dense</code> prop to pack the options tighter.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-dense</code> to the <code>.ui-list</code> to pack the options
        tighter.
      </Fragment>
    </Conditional>
    <AutoExample name="Dense" row spacious />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <p>
      Use <PropOrClass prop="endText" class=".ui-end-text" /> for supporting text
      below the select.
    </p>
    <AutoExample name="EndText" row spacious />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>start</code> and <code>end</code> slots to affix icons or short
        text alongside the select inside the field's border.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-start</code> or <code>.ui-end</code> element inside
        {" "}<code>.ui-field</code> to affix content alongside the select.
      </Fragment>
      <Fragment slot="react">
        Use the <code>start</code> and <code>end</code> props to affix icons or short
        text alongside the select inside the field's border.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>start</code> and <code>end</code> snippets to affix icons or
        short text alongside the select inside the field's border.
      </Fragment>
    </Conditional>

    <AutoExample name="Affix" row spacious />
  </section>

  <section id="top-and-bottom">
    <h2>Top and bottom</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>top</code> and <code>bottom</code> slots for short text or a
        link above and below the select, inside the field's border and set off by
        a divider.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-top</code> or <code>.ui-bottom</code> element inside
        {" "}<code>.ui-field</code> for short text or a link above and below the select,
        inside the field's border and set off by a divider.
      </Fragment>
      <Fragment slot="react">
        Use the <code>top</code> and <code>bottom</code> props for short text or a
        link above and below the select, inside the field's border and set off by
        a divider.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>top</code> and <code>bottom</code> snippets for short text or
        a link above and below the select, inside the field's border and set off by
        a divider.
      </Fragment>
    </Conditional>
    <p>
      They sit outside the list of options, so they can't filter it. Keep form
      controls out of them, since the select's <code>&lt;label&gt;</code> wraps them.
    </p>
    <Conditional as="p">
      <Fragment slot="components">
        The select's <code>aria-describedby</code> points at them, so screen readers
        read them with the select.
      </Fragment>
      <Fragment slot="html">
        Give them an <code>id</code> and list them in the select's <code
          >aria-describedby</code
        >, so screen readers read them with the select.
      </Fragment>
    </Conditional>
    <AutoExample name="TopAndBottom" row spacious />
  </section>

  <section id="preselected">
    <h2>Preselected</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>value</code> to preselect an option, or
        <code>selected: true</code> on an item.
      </Fragment>
      <Fragment slot="html">
        Add <code>selected</code> to the <code>option</code> to preselect it.
      </Fragment>
      <Fragment slot="react">
        Set <code>defaultValue</code>, or <code>value</code> with <code
          >onChange</code
        >, to preselect an option, or
        <code>selected: true</code> on an item.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>value</code> or <code>bind:value</code> to preselect an option,
        or
        <code>selected: true</code> on an item.
      </Fragment>
      <Fragment slot="vue">
        Set <code>value</code> or <code>v-model</code> to preselect an option, or
        <code>selected: true</code> on an item.
      </Fragment>
    </Conditional>
    <AutoExample name="Preselected" row spacious />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Astro renders the field on the server, so it has no bound value. The
        value lives in the <code>select</code>: read it in a script on <code
          >change</code
        >, or submit it with a form. Set <code
          >option.selected = option.defaultSelected</code
        > on each option to go back to the <code>value</code> prop.
      </Fragment>
      <Fragment slot="html">
        The value lives in the <code>select</code>: read it in a script on <code
          >change</code
        >, or submit it with a form. Set <code
          >option.selected = option.defaultSelected</code
        > on each option to go back to the value in the markup.
      </Fragment>
      <Fragment slot="react">
        Keep the value in your own state. Pass <code>value</code> and an <code
          >onChange</code
        > that stores <code>event.currentTarget.value</code>, or <code
          >defaultValue</code
        > to leave the select in charge.
      </Fragment>
      <Fragment slot="svelte">
        Bind the value with <code>bind:value</code>. Changing the field updates
        the variable, and setting the variable updates the field.
      </Fragment>
      <Fragment slot="vue">
        Bind the value with <code>v-model</code>. Changing the field updates the
        ref, and setting the ref updates the field.
      </Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <section id="option-groups">
    <h2>Option groups</h2>
    <p>
      Wrap options in a <code>&lt;div role="group"&gt;</code> and start it with a
      {" "}<code>&lt;label class="ui-text"&gt;</code> to group them under a heading.
      The heading takes any content, but it doesn't name the group for screen readers.
    </p>
    <AutoExample name="Grouped" row spacious />
    <h3 id="optgroup">Optgroup</h3>
    <p>
      An <code>&lt;optgroup&gt;</code> names its group natively through its
      {" "}<code>label</code> attribute. Give it a <code>&lt;legend&gt;</code> with
      the same text first in the group: it gets the heading styles in a customizable
      select, while browsers without one show the <code>label</code>
      {" "}in their own picker.
    </p>
    <AutoExample name="GroupedOptgroup" row spacious />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="select" subject="Fields" />

    <AutoExample name="Validation" column spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to display the label and start text
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column spacious />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      Use <PropOrClass prop="autoFit" class=".ui-auto-fit" /> to let the field's width
      follow the selected option, from <code>25ch</code>.
    </p>
    <AutoExample name="AutoFit" class="flex" />
  </section>

  <Fragment slot="accessibility">
    <p>
      <code>appearance: base-select</code> only changes how the select looks. The
      browser keeps the behavior of a native <code>&lt;select&gt;</code>: screen
      readers announce it like any select, with its label and the selected
      option, and the value is submitted with the form. A click outside closes
      the list without changing the value.
    </p>
    <KeyboardSupport>
      <p>
        These are the keys of a customizable select in Chromium. Browsers
        without one open their own picker, with its own keys.
      </p>
    </KeyboardSupport>
    <h3 id="fallback">Fallback</h3>
    <p>
      Browsers without customizable select drop the <code>&lt;button&gt;</code>
      {" "}and the list wrapper from the <code>&lt;select&gt;</code> and keep its
      options. The select keeps the field styles and the chevron, and opens the browser's
      own picker.
    </p>
  </Fragment>

  <SelectBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UISelect
        startText="Start text"
        endText="Supporting text"
        items={[
          { label: "Option one", value: "1" },
          { label: "Option two", value: "2" },
        ]}
        label="Label"
        name="select-anatomy"
      >
        <span slot="top">Top</span>
        <span slot="start">¤</span>
        <span slot="end">EUR</span>
        <span slot="bottom">Bottom</span>
      </UISelect>
    </Anatomy>
  </Fragment>
</Component>
