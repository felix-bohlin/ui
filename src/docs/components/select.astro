---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import FieldCSS from "@opui/css/components/field.css?raw"
import SelectCSS from "@opui/css/components/select.css?raw"
import ListCSS from "@opui/css/components/list.css?raw"
import selectButtonApi from "../../component-api/select-button/api"
import SelectBuild from "../../components/UnderTheHood/SelectBuild.astro"

export const description =
  "A dropdown for picking one value from a list in a form."

export const keywords = ["combobox", "dropdown", "option", "picker"]
---

<Component
  description={description}
  base="field"
  slug="select"
  browserSupport={[
    "alt-text-generated-content",
    "color-mix",
    "container-queries",
    "customizable-select",
    "dir-pseudo",
    "display-animation",
    "has",
    "lh",
    "open-pseudo",
    "overlay",
    "reading-flow",
    "registered-custom-properties",
    "relative-color",
    "starting-style",
    "transition-behavior",
    "user-pseudos",
  ]}
  fallbacks={{
    "customizable-select":
      "Without customizable select, the field draws its own chevron and the browser's own picker opens, with the text of each option only.",
    "display-animation":
      "Without display animation, the picker disappears at once instead of fading out.",
    overlay:
      "Without `overlay`, the page can cover the picker while it fades out.",
    "reading-flow":
      "Without `reading-flow`, Tab and screen readers follow the markup, which puts the top and start parts before the control, as they're drawn. Hand-written HTML needs that order too.",
  }}
  apis={[{ title: "Select button API", api: selectButtonApi }]}
  installationTabs={[
    {
      title: "field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "select.css", code: SelectCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  seeAlsoLinks={[
    {
      name: "Customizable select (MDN)",
      href: "https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Customizable_select",
    },
  ]}
>
  <Fragment slot="title">Select</Fragment>
  <Fragment slot="preamble">
    Pick a value in a form. For actions, use a
    <DocLink href="/components/menu">Menu</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">One value from a list, like a country.</li>
    <li slot="when">
      Long lists under headings: <a href="#option-groups">option groups</a>.
    </li>
    <li slot="when-not">
      Actions: use a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      A few options: use a <DocLink href="/components/radio">Radio</DocLink>
      group.
    </li>
    <li slot="when-not">
      Free text with suggestions: use a
      <DocLink href="/components/text-field#autosuggest">Text field</DocLink>.
    </li>
  </Usage>

  <section id="select">
    <h2>Select</h2>
    <p>
      A select is a <DocLink href="/components/field">Field</DocLink> with a
      <code>&lt;select&gt;</code> inside. Write it and wire its
      <code>aria-describedby</code> as the
      <DocLink href="/components/field#basics">Field</DocLink> page shows, with
      the variants, sizes, affixes, validation and layout every field shares,
      and <DocLink href="/components/field#dense">dense</DocLink> options.
    </p>
    <Conditional as="p">
      <Fragment slot="components">
        Write the options straight in the select, after a
        <code>SelectButton</code>, which shows the selected option in the field.
      </Fragment>
      <Fragment slot="html">
        Write the options straight in the select, after
        <code
          >&lt;button&gt;&lt;selectedcontent&gt;&lt;/selectedcontent&gt;&lt;/button&gt;</code
        >, which shows the selected option in the field.
      </Fragment>
    </Conditional>
    <AutoExample name="Basics" column />
  </section>

  <section id="option-groups">
    <h2>Option groups</h2>
    <p>
      Name each <code>&lt;div role="group"&gt;</code> with
      <code>aria-labelledby</code> pointing at its label.
    </p>
    <AutoExample name="Grouped" row spacious />

    <h3 id="optgroup">Optgroup</h3>
    <p>Repeat the <code>label</code> in a <code>&lt;legend&gt;</code>.</p>
    <AutoExample name="GroupedOptgroup" row spacious />
  </section>

  <section id="rich-options">
    <h2>Rich options</h2>
    <p>
      An option can hold an icon or a description. Put a space between the
      parts, for browsers that show the text only.
    </p>
    <AutoExample name="RichOptions" row spacious />
  </section>

  <section id="preselected">
    <h2>Preselected</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Add <code>selected</code> to the <code>&lt;option&gt;</code>, or bind
        the select's value.
      </Fragment>
      <Fragment slot="react">
        Set <code>defaultValue</code> on the <code>&lt;select&gt;</code>, or
        <code>value</code> with <code>onChange</code>.
      </Fragment>
      <Fragment slot="html">
        Add <code>selected</code> to the <code>&lt;option&gt;</code>.
      </Fragment>
    </Conditional>
    <p>
      The picker marks the selected option with a check at the end, from
      <code>--ui-icon-check</code> or a <code>.ui-icon-checked</code> in the
      option.
    </p>
    <AutoExample name="Preselected" row spacious />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" row spacious />
  </section>

  <section id="required">
    <h2>Required</h2>
    <p>
      Start a <code>required</code> select with an empty option,
      <code>value=""</code>, so it's invalid until the user picks one.
    </p>
    <AutoExample name="Required" centered />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <p>
      Bind the select like any control, as the
      <DocLink href="/components/field#binding">Field</DocLink> page shows. Its
      value is the <code>value</code> of the picked option.
    </p>
    <Conditional as="p">
      <Fragment slot="vue">
        <code>v-model</code> ignores <code>selected</code> on an option, so
        start the bound value at the option you want.
      </Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        The keys that open the picker, move through the options and close it are
        under
        <DocLink href="/components/field#keyboard-support"
          >Keyboard support</DocLink
        >
        on the Field page.
      </li>
    </ul>
  </Fragment>

  <SelectBuild slot="under-the-hood" />
</Component>
