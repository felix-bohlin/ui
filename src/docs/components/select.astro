---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Select as UISelect } from "@opui/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import FieldCSS from "@opui/css/components/text-field.css?raw"
import SelectCSS from "@opui/css/components/select.css?raw"
import ListCSS from "@opui/css/components/list.css?raw"
import classicSelectApi from "../../component-api/classic-select/api"
import selectApi from "../../component-api/select/api"
import SelectBuild from "../../components/UnderTheHood/SelectBuild.astro"
---

<Component
  slug="select"
  browserSupport={[
    "container-queries",
    "customizable-select",
    "display-animation",
    "field-sizing",
    "has",
    "light-dark",
    "open-pseudo",
    "overlay",
    "relative-color",
    "starting-style",
    "transition-behavior",
  ]}
  heroAnatomy
  apis={[
    { title: "Select API", api: selectApi },
    { title: "Classic select API", api: classicSelectApi },
  ]}
  installationTabs={[
    {
      title: "text-field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "select.css", code: SelectCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Select/Select.astro",
      type: "component",
    },
    {
      path: "packages/opui/components/ClassicSelect/ClassicSelect.astro",
      type: "component",
    },
    { path: "src/docs/components/select.astro", type: "docs" },
    { path: "src/component-examples/select", type: "docs" },
    {
      path: "packages/opui/css/components/select.css",
      type: "css",
    },
    { path: "src/component-api/select", type: "api" },
    { path: "src/component-api/classic-select", type: "api" },
  ]}
  seeAlsoLinks={[
    {
      name: "Customizable select (MDN)",
      href: "https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Customizable_select",
    },
  ]}
>
  <Fragment slot="title">Select</Fragment>
  <Fragment slot="preamble">
    Leverages the <DocLink href="/components/list" class="ui-link"
      >List component</DocLink
    > to provide markup for the Select popover. Use a Select to pick a value in a
    form. For actions, use a <DocLink href="/components/menu">Menu</DocLink>.
  </Fragment>

  <section>
    <h2 id="variants">Variants</h2>
    <AutoExample name="Variants" row spacious />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <AutoExample name="Sizes" row spacious />
  </section>

  <section>
    <h2 id="dense">Dense</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>dense</code> prop to pack the options tighter.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-dense</code> to the <code>.ui-list</code> to pack the options
        tighter.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>dense</code> prop to pack the options tighter.
      </Fragment>
    </Conditional>
    <AutoExample name="Dense" row spacious />
  </section>

  <section>
    <h2 id="end-text">End text</h2>
    <p><code>.ui-end-text</code>: end text element</p>
    <AutoExample name="SupportingText" row spacious />
  </section>

  <section>
    <h2 id="affix">Affix</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>prefix</code> and <code>suffix</code> slots to affix icons or
        short text alongside the select inside the field's border.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-prefix</code> or <code>.ui-suffix</code> element inside
        {" "}<code>.ui-field</code> to affix content alongside the select.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>prefix</code> and <code>suffix</code> slots to affix icons or
        short text alongside the select inside the field's border.
      </Fragment>
      <Fragment slot="solid">
        Use the <code>prefix</code> and <code>suffix</code> props to affix icons or
        short text alongside the select inside the field's border.
      </Fragment>
    </Conditional>

    <AutoExample name="Affix" row spacious />
  </section>

  <section>
    <h2 id="preselected">Preselected</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>value</code> to preselect an option, or
        <code>selected: true</code> on an item.
      </Fragment>
      <Fragment slot="html">
        Add <code>selected</code> to the <code>option</code> to preselect it.
      </Fragment>
      <Fragment slot="vue">
        Set <code>value</code> or <code>v-model</code> to preselect an option, or
        <code>selected: true</code> on an item.
      </Fragment>
    </Conditional>
    <AutoExample name="Preselected" row spacious />
  </section>

  <section>
    <h2 id="option-groups">Option groups</h2>
    <p>
      Wrap options in a <code>&lt;div role="group"&gt;</code> and start it with a
      {" "}<code>&lt;label class="ui-text"&gt;</code> to group them under a heading.
    </p>
    <AutoExample name="Grouped" row spacious />
  </section>

  <section>
    <h2 id="validation">Validation</h2>
    <Conditional>
      <Fragment slot="astro">
        <ul>
          <li>
            Set <code>required</code> on the component to toggle required styles on
            the select.
          </li>
          <li>
            Use the <code>error</code> prop to toggle invalid styles. It renders the
            {" "}<code>data-invalid</code> attribute on the root element. Make use
            of the end text to give extra feedback on the error.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="vue">
        <ul>
          <li>
            Add the <code>required</code> attribute on the component. It is forwarded
            to the underlying <code>&lt;select&gt;</code>.
          </li>
          <li>
            Use the <code>error</code> prop to toggle invalid styles. It renders
            {" "}<code>data-invalid</code> on the root element. Make use of the end
            text to give extra feedback on the error.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="solid">
        <ul>
          <li>
            Add the <code>required</code> attribute on the component. It is forwarded
            to the underlying <code>&lt;select&gt;</code>.
          </li>
          <li>
            Use the <code>error</code> prop to toggle invalid styles. It renders
            <code>data-invalid</code> on the root element. Make use of the end text
            to give extra feedback on the error.
          </li>
        </ul>
      </Fragment>
      <Fragment slot="html">
        <ul>
          <li>
            Add <code>[required]</code> to the <code>&lt;select&gt;</code> element
            to toggle required styles.
          </li>
          <li>
            Add <code>data-invalid</code> on the root element to toggle invalid styles.
            Make use of the end text to give extra feedback on the error.
          </li>
        </ul>
      </Fragment>
    </Conditional>

    <AutoExample name="Validation" column spacious />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> boolean prop to display the label and description
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to display the label and description
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> boolean prop to display the label and description
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="solid">
        Use the <code>spread</code> boolean prop to display the label and description
        on the left with the select on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
    </Conditional>

    <AutoExample name="Orientation" column spacious />
  </section>

  <section>
    <h2 id="classic-select">Classic select</h2>
    <p>
      Bog-standard native HTML <code>&lt;select&gt;</code> without customized option
      list. Use it when the browser's own picker is all you need, and the Select above
      when the options need styles, icons or groups.
    </p>

    <AutoExample name="Classic" row spacious />
  </section>

  <SelectBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UISelect
        description="Description"
        endText="Supporting text"
        items={[
          { text: "Option one", value: "1" },
          { text: "Option two", value: "2" },
        ]}
        label="Label"
        name="select-anatomy"
      >
        <span slot="header">Header</span>
        <span slot="prefix">¤</span>
        <span slot="suffix">EUR</span>
        <span slot="footer">Footer</span>
      </UISelect>
    </Anatomy>
  </Fragment>
</Component>
