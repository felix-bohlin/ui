---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Select as UISelect } from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import FieldCSS from "@opui/css/components/text-field.css?raw"
import SelectCSS from "@opui/css/components/select.css?raw"
import ListCSS from "@opui/css/components/list.css?raw"
import selectApi from "../../component-api/select/api"
import SelectBuild from "../../components/UnderTheHood/SelectBuild.astro"

export const keywords = ["combobox", "dropdown", "option", "picker"]
---

<Component
  slug="select"
  browserSupport={[
    "color-mix",
    "container-queries",
    "customizable-select",
    "dir-pseudo",
    "display-animation",
    "field-sizing",
    "has",
    "lh",
    "open-pseudo",
    "overflow-clip",
    "overlay",
    "relative-color",
    "starting-style",
    "transition-behavior",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[{ title: "Select API", api: selectApi }]}
  installationTabs={[
    {
      title: "text-field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "select.css", code: SelectCSS, lang: "css" },
    { title: "list.css", code: ListCSS, lang: "css", isDependency: true },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Select/Select.astro",
      type: "component",
    },
    { path: "src/docs/components/select.astro", type: "docs" },
    { path: "src/component-examples/select", type: "docs" },
    {
      path: "packages/opui/css/components/select.css",
      type: "css",
    },
    { path: "src/component-api/select", type: "api" },
  ]}
  seeAlsoLinks={[
    {
      name: "Customizable select (MDN)",
      href: "https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Customizable_select",
    },
  ]}
>
  <Fragment slot="title">Select</Fragment>
  <Fragment slot="preamble">
    Pick a value in a form. For actions, use a
    <DocLink href="/components/menu">Menu</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">One value from a list, like a country.</li>
    <li slot="when">
      Long lists under headings: <a href="#option-groups">option groups</a>.
    </li>
    <li slot="when-not">
      Actions: use a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
    <li slot="when-not">
      A few options: use a <DocLink href="/components/radio">Radio</DocLink>
      group.
    </li>
    <li slot="when-not">
      Free text with suggestions: use a
      <DocLink href="/components/text-field#autosuggest">Text field</DocLink>.
    </li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      The select is outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      background.
    </p>
    <AutoExample name="Variants" row spacious />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" row spacious />
  </section>

  <section id="dense">
    <h2>Dense</h2>
    <p>Use <PropOrClass prop="dense" class=".ui-dense" />.</p>
    <AutoExample name="Dense" row spacious />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <p>Use <PropOrClass prop="endText" class=".ui-end-text" />.</p>
    <AutoExample name="EndText" row spacious />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" row spacious />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <p>
      Use <PropOrClass prop="start" class=".ui-start" /> and
      <PropOrClass prop="end" class=".ui-end" />.
    </p>
    <AutoExample name="Affix" row spacious />
  </section>

  <section id="top-and-bottom">
    <h2>Top and bottom</h2>
    <p>
      Use <PropOrClass prop="top" class=".ui-top" /> and
      <PropOrClass prop="bottom" class=".ui-bottom" />. Keep form controls out
      of them.
    </p>
    <AutoExample name="TopAndBottom" row spacious />
  </section>

  <section id="preselected">
    <h2>Preselected</h2>
    <Conditional as="p">
      <Fragment slot="components">Set <code>value</code>.</Fragment>
      <Fragment slot="react">Set <code>defaultValue</code>.</Fragment>
      <Fragment slot="html">
        Add <code>selected</code> to the <code>option</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Preselected" row spacious />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        No bound value: read the <code>select</code> in a script.
      </Fragment>
      <Fragment slot="html">Read the <code>select</code> in a script.</Fragment>
      <Fragment slot="react">
        Use <code>value</code> and <code>onChange</code>.
      </Fragment>
      <Fragment slot="svelte">Use <code>bind:value</code>.</Fragment>
      <Fragment slot="vue">Use <code>v-model</code>.</Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <section id="option-groups">
    <h2>Option groups</h2>
    <p>
      Name each <code>&lt;div role="group"&gt;</code> with
      <code>aria-labelledby</code> pointing at its label.
    </p>
    <AutoExample name="Grouped" row spacious />

    <h3 id="optgroup">Optgroup</h3>
    <p>Repeat the <code>label</code> in a <code>&lt;legend&gt;</code>.</p>
    <AutoExample name="GroupedOptgroup" row spacious />
  </section>

  <section id="rich-options">
    <h2>Rich options</h2>
    <p>Put a space between the parts, for browsers that show the text only.</p>
    <AutoExample name="RichOptions" row spacious />
  </section>

  <section id="disabled">
    <h2>Disabled</h2>
    <AutoExample name="Disabled" row spacious />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="select" subject="Fields" />
    <AutoExample name="Validation" column spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      select.
    </p>
    <AutoExample name="Spread" column spacious />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      <PropOrClass prop="autoFit" class=".ui-auto-fit" /> sizes the field to the
      selected option.
    </p>
    <AutoExample name="AutoFit" class="flex" />
  </section>

  <Fragment slot="accessibility">
    <KeyboardSupport>
      <p>Chromium's keys. Other browsers open their own picker.</p>
    </KeyboardSupport>

    <h3 id="fallback">Fallback</h3>
    <p>Without customizable select, the browser's own picker opens.</p>
  </Fragment>

  <SelectBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UISelect
        startText="Start text"
        endText="Supporting text"
        items={[
          { label: "Option one", value: "1" },
          { label: "Option two", value: "2" },
        ]}
        label="Label"
        name="select-anatomy"
      >
        <span slot="top">Top</span>
        <span slot="start">¤</span>
        <span slot="end">EUR</span>
        <span slot="bottom">Bottom</span>
      </UISelect>
    </Anatomy>
  </Fragment>
</Component>
