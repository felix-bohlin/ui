---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import SpinnerCSS from "@opui/css/components/spinner.css?raw"
import SpinnerBuild from "../../components/UnderTheHood/SpinnerBuild.astro"

import spinnerApi from "../../component-api/spinner/api"

export const keywords = ["busy", "loader", "loading"]
export const description =
  'A spinner on any element with aria-busy="true", for content that is loading, in every size.'
---

<Component
  description={description}
  slug="spinner"
  browserSupport={["if"]}
  apis={[{ title: "Spinner API", api: spinnerApi }]}
  changelogPaths={[
    { path: "src/docs/components/spinner.astro", type: "docs" },
    { path: "src/component-examples/spinner", type: "docs" },
    {
      path: "packages/opui/css/components/spinner.css",
      type: "css",
    },
    { path: "src/component-api/spinner", type: "api" },
  ]}
  installationTabs={[{ title: "spinner.css", code: SpinnerCSS, lang: "css" }]}
>
  <Fragment slot="title">Spinner</Fragment>
  <Fragment slot="preamble">
    Add <code>aria-busy="true"</code> to an element. See also:
    <DocLink href="/components/progress" class="ui-link">Progress bar</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A short wait in a button:
      <a href="#buttons"><code>aria-busy="true"</code></a>.
    </li>
    <li slot="when">
      Loading content in a small area, like a card:
      <a href="#basics"><code>aria-busy</code> on the area</a>.
    </li>
    <li slot="when-not">
      A task with a known length: use a
      <DocLink href="/components/progress">Progress</DocLink> bar.
    </li>
    <li slot="when-not">
      A long task in the background, like an export: say when it's done with a
      <DocLink href="/components/toast">Toast</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p><code>aria-busy</code> announces nothing on its own.</p>
    <AutoExample name="Basics" />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <p>It follows the font size.</p>
    <AutoExample name="Sizes" column />
  </section>

  <section id="buttons">
    <h2>Buttons</h2>
    <AutoExample name="Buttons" column />
  </section>

  <section id="no-spinner">
    <h2>When <code>aria-busy="true"</code> shows no spinner</h2>

    <h3 id="blocked-by-another-use-case">With <code>aria-describedby</code></h3>
    <p>
      That's the pattern for a busy section that a
      <DocLink href="/components/progress#accessibility">progress bar</DocLink>
      describes. Buttons and links always get one.
    </p>

    <h3 id="doesnt-make-sense">On elements that can't show one</h3>
    <ul>
      <li><code>&lt;html&gt;</code></li>
      <li><code>&lt;input&gt;</code></li>
      <li><code>&lt;progress&gt;</code></li>
      <li><code>&lt;select&gt;</code></li>
      <li><code>&lt;textarea&gt;</code></li>
    </ul>
  </section>

  <SpinnerBuild slot="under-the-hood" />
</Component>
