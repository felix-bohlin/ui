---
import Component from "../../layouts/Component.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import SpinnerCSS from "@opui/css/components/spinner.css?raw"
import SpinnerBuild from "../../components/UnderTheHood/SpinnerBuild.astro"

import spinnerApi from "../../component-api/spinner/api"
---

<Component
  slug="spinner"
  browserSupport={["container-style-queries"]}
  apis={[{ title: "Spinner API", api: spinnerApi }]}
  changelogPaths={[
    { path: "src/docs/components/spinner.astro", type: "docs" },
    { path: "src/component-examples/spinner", type: "docs" },
    {
      path: "packages/opui/css/components/spinner.css",
      type: "css",
    },
    { path: "src/component-api/spinner", type: "api" },
  ]}
  installationTabs={[{ title: "spinner.css", code: SpinnerCSS, lang: "css" }]}
>
  <Fragment slot="title">Spinner</Fragment>
  <Fragment slot="preamble">
    Add it to an element with <code>aria-busy="true"</code>. Spinners are always
    indeterminate. See also: <DocLink
      href="/components/progress"
      class="ui-link">Progress bar</DocLink
    >.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A short wait in a button, like while a form saves, with <a href="#buttons"
        ><code>aria-busy="true"</code></a
      > on it.
    </li>
    <li slot="when">
      Loading content of unknown length in a small area, like a card.
    </li>
    <li slot="when-not">
      A task with a known length. Use a <DocLink href="/components/progress"
        >Progress</DocLink
      > bar with a value.
    </li>
    <li slot="when-not">
      A busy section that shows a progress bar. Point its <code
        >aria-describedby</code
      > at the bar, and it gets no spinner (see <a href="#no-spinner"
        >the exceptions</a
      >).
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <p>
      <code>aria-busy</code> doesn't announce anything. Say what's happening in text,
      like "Loading…" in the busy element or in a <code>role="status"</code> element.
    </p>
    <AutoExample name="Basics" />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <p>
      The spinner's size is set to <code>1em</code>, which means it will adjust
      to its current font size.
    </p>
    <AutoExample name="Sizes" column />
  </section>

  <section id="buttons">
    <h2>Buttons</h2>
    <p>
      Simply add <code>aria-busy="true"</code> to a <code>&lt;button&gt;</code>.
    </p>
    <AutoExample name="Buttons" column />
  </section>

  <section id="no-spinner">
    <h2>When <code>aria-busy="true"</code> shows no spinner</h2>
    <p>
      There are a few exceptions where <code>aria-busy="true"</code> won't render
      a spinner. Either because it doesn't make sense or because there are other reasons
      you would like to use that aria attribute.
    </p>

    <h3 id="blocked-by-another-use-case">
      1. Because it's blocked by another use case
    </h3>
    <p>
      A section that's being updated points at its progress bar with <code
        >aria-describedby</code
      > while <code>aria-busy="true"</code> marks it as busy. Busy elements with <code
        >aria-describedby</code
      > get no spinner, so you don't see a spinner <em>and</em> a progress bar. Buttons
      and links always get one.
    </p>

    <p>
      See <DocLink href="/components/progress#accessibility"
        >progress accessibility</DocLink
      > section for more.
    </p>

    <h3 id="doesnt-make-sense">2. Because it doesn't make sense</h3>
    <ul>
      <li><code>&lt;html&gt;</code></li>
      <li><code>&lt;input&gt;</code></li>
      <li><code>&lt;progress&gt;</code></li>
      <li><code>&lt;select&gt;</code></li>
      <li><code>&lt;textarea&gt;</code></li>
    </ul>
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        With reduced motion (<code>--ui-motion: 0</code>), the spinner keeps
        turning, once every 1.5s instead of every 0.7s.
      </li>
      <li>
        In forced colors mode it's drawn in <code>CanvasText</code>, and with
        more contrast it's fully opaque.
      </li>
    </ul>
  </Fragment>

  <SpinnerBuild slot="under-the-hood" />
</Component>
