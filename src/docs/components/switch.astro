---
import FieldGroupNotes from "./partials/FieldGroupNotes.astro"
import LabelAlignment from "./partials/LabelAlignment.astro"
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  Switch as UISwitch,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import SwitchCSS from "@opui/css/components/switch.css?raw"
import ChoiceCSS from "@opui/css/components/choice.css?raw"
import CardCSS from "@opui/css/components/card.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldGroupApi from "../../component-api/field-group/api"
import switchApi from "../../component-api/switch/api"
import switchInputApi from "../../component-api/switch-input/api"

import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import SwitchBuild from "../../components/UnderTheHood/SwitchBuild.astro"

export const keywords = ["on off", "toggle"]
---

<Component
  slug="switch"
  browserSupport={[
    "has",
    "lh",
    "light-dark",
    "relative-color",
    "round-mod-rem",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[
    { title: "Switch API", api: switchApi },
    { title: "Switch input API", api: switchInputApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Switch",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/switch.astro", type: "docs" },
    { path: "src/component-examples/switch", type: "docs" },
    {
      path: "packages/opui/css/components/switch.css",
      type: "css",
    },
    { path: "src/component-api/switch", type: "api" },
    { path: "src/component-api/switch-input", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "switch.css", code: SwitchCSS, lang: "css" },
    { title: "choice.css", code: ChoiceCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", isDependency: true },
    { title: "card.css", code: CardCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Switch</Fragment>
  <Fragment slot="preamble">
    Use a Switch for a setting that applies right away. Use a <DocLink
      href="/components/checkbox">Checkbox</DocLink
    > for choices that are submitted with a form, and a <DocLink
      href="/components/toggle">Toggle</DocLink
    > for options in a toolbar. See also: <a href="#field-group" class="ui-link"
      >Switch field group</a
    >.
  </Fragment>

  <!--
  Keep a look out for the new HTML switch control.
  It's not mature yet to even try to implement here,
  but will be in time.
  https://webkit.org/blog/15054/an-html-switch-control/
   -->

  <Usage slot="usage">
    <li slot="when">
      A setting that applies right away, like notifications or dark mode.
    </li>
    <li slot="when">
      A list of settings, with each switch at the end of its row with <a
        href="#spread"><PropOrClass prop="spread" class=".ui-spread" /></a
      >.
    </li>
    <li slot="when-not">
      A choice that is submitted with a form, like agreeing to the terms. Use a <DocLink
        href="/components/checkbox">Checkbox</DocLink
      >.
    </li>
    <li slot="when-not">
      Options in a toolbar, like bold. Use a <DocLink href="/components/toggle"
        >Toggle</DocLink
      >.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <Conditional as="p">
      <Fragment slot="components"
        >All switches should have an accessible name. Put the label text inside
        the component, also when there's no visible label: set <code
          >hideLabel</code
        > to hide it visually.</Fragment
      >
      <Fragment slot="html"
        >All switches should have an accessible name. Put the label text inside
        the component, also when there's no visible label: use <code
          >.ui-sr-only</code
        > instead of <code>.ui-label</code>.</Fragment
      >
    </Conditional>

    <AutoExample name="Basics" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, <code>medium</code> (the default) and <code
          >large</code
        >.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>, on the <code
          >&lt;label class="ui-switch"&gt;</code
        >.
      </Fragment>
    </Conditional>

    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section id="visible-label">
    <h2>Visible label</h2>
    <Conditional as="p">
      <Fragment slot="components"
        >The default slot is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="html"
        >Render the label text inside an element with a <code>.ui-label</code> class.
        Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="react"
        ><code>children</code> is the label. Also, don't miss the info on label <a
          href="#accessibility"
          class="ui-link">accessibility</a
        >.</Fragment
      >
      <Fragment slot="svelte"
        >The <code>children</code> snippet is the label. Also, don't miss the info
        on label <a href="#accessibility" class="ui-link">accessibility</a
        >.</Fragment
      >
    </Conditional>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="hidden-label">Hidden label</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>hideLabel</code> to keep the label for screen readers only. The
        switch then centers in a table cell or a line of text, and keeps a 24px click
        target.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-sr-only</code> instead of <code>.ui-label</code> to keep the
        label for screen readers only. The switch then centers in a table cell or
        a line of text, and keeps a 24px click target.
      </Fragment>
    </Conditional>
    <AutoExample name="HiddenLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <Conditional as="p">
      <Fragment slot="components"
        >Set <code>orientation="vertical"</code> to put the label under the switch.</Fragment
      >
      <Fragment slot="html"
        >Add <code>.ui-vertical</code> to the <code
          >&lt;label class="ui-switch"&gt;</code
        > to put the label under the switch.</Fragment
      >
    </Conditional>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <AutoExample name="EndText" row spacious />
  </section>

  <section id="icons">
    <h2>Icons</h2>
    <Conditional as="p">
      <Fragment slot="components"
        >Put an icon in the <code>icon-unchecked</code> and <code
          >icon-checked</code
        > slots to show it in the thumb. The component hides them from screen readers.</Fragment
      >
      <Fragment slot="html"
        >Put the icons in <code>.ui-icon-unchecked</code> and <code
          >.ui-icon-checked</code
        > spans with <code>aria-hidden="true"</code> before the <code
          >&lt;input&gt;</code
        >.</Fragment
      >
      <Fragment slot="react"
        >Put an icon in the <code>iconUnchecked</code> and <code
          >iconChecked</code
        > props to show it in the thumb. The component hides them from screen readers.</Fragment
      >
      <Fragment slot="svelte"
        >Put an icon in the <code>iconUnchecked</code> and <code
          >iconChecked</code
        > snippets to show it in the thumb. The component hides them from screen readers.</Fragment
      >
    </Conditional>
    <AutoExample name="Icons" column centered />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="input" named subject="Switches" />

    <AutoExample name="Validation" column centered spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>spread</code> prop to push the label to the left and the switch
        to the right. Handy for full-width items like lists and menus, and for <a
          class="ui-link"
          href="#cards">cards</a
        >.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to the <code
          >&lt;label class="ui-switch"&gt;</code
        >
        {" "}to push the label to the left and the switch to the right. Handy
        for full-width items like lists and menus, and for <a
          class="ui-link"
          href="#cards">cards</a
        >.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column />
  </section>

  <section id="cards">
    <h2>Cards</h2>
    <Conditional as="p">
      <Fragment slot="components">
        <code>card</code> renders the switch as a card that tints when hovered and
        when checked. Combine it with <code>spread</code> for the switch at the end,
        and <code>variant="tonal"</code> or
        <code>variant="elevated"</code> for the surface, like a <DocLink
          href="/components/card"
          class="ui-link">Card</DocLink
        >. In a horizontal <code>FieldGroup</code> the cards share the row.
      </Fragment>
      <Fragment slot="html">
        <code>.ui-card</code> renders the switch as a card that tints when hovered
        and when checked. Combine it with <code>.ui-spread</code> for the switch at
        the end, and <code>.ui-tonal</code> or
        <code>.ui-elevated</code> for the surface, like a <DocLink
          href="/components/card"
          class="ui-link">Card</DocLink
        >. In a <code>.ui-field-group.ui-horizontal</code> the cards share the row.
      </Fragment>
    </Conditional>

    <AutoExample name="CardsMatrix" column />
  </section>

  <section id="label-alignment">
    <h2>Label alignment</h2>
    <LabelAlignment control="switch" />
  </section>

  <section id="switch-input">
    <h2>Switch input</h2>
    <p>
      Use <PropOrClass
        prop="SwitchInput"
        class='<input type="checkbox" role="switch">'
      /> without the label for a custom layout, such as the end of a list item. See
      {" "}<DocLink href="/components/list#switch" class="ui-link">List</DocLink
      >.
    </p>
  </section>

  <section id="field-group">
    <h2>Field group</h2>
    <FieldGroupNotes control="switch">
      <AutoExample name="FieldGroup" centered column />
    </FieldGroupNotes>
  </section>

  <SwitchBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="role-attributes">Role & attributes</h3>
    <Table>
      <TableHead>
        <TableRow>
          <TableHeaderCell>Role/attribute</TableHeaderCell>
          <TableHeaderCell>Usage</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell><code>role="switch"</code></TableCell>
          <TableCell>
            Required on the <code>input</code> element. Identifies the element that
            serves as a switch.
          </TableCell>
        </TableRow>
      </TableBody>
    </Table>

    <h3 id="labels">Labels</h3>
    <p>
      Accessible switches should have a label. The first two approaches are
      equally ok:
    </p>
    <Table>
      <TableHead>
        <TableRow>
          <TableHeaderCell>Approach</TableHeaderCell>
          <TableHeaderCell>Usage in Switch component</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell>Provide a label inside the element</TableCell>
          <TableCell>
            <Conditional>
              <Fragment slot="components"
                >The default slot is the <a
                  href="#visible-label"
                  class="ui-link">visible label</a
                >. Set <code>hideLabel</code> to hide it visually while keeping it
                accessible.</Fragment
              >
              <Fragment slot="html"
                >Use a <code>.ui-label</code> child for a <a
                  href="#visible-label"
                  class="ui-link">visible label</a
                >, or a <code>.ui-sr-only</code> child to hide it visually while keeping
                it accessible.</Fragment
              >
              <Fragment slot="react"
                ><code>children</code> is the <a
                  href="#visible-label"
                  class="ui-link">visible label</a
                >. Set <code>hideLabel</code> to hide it visually while keeping it
                accessible.</Fragment
              >
              <Fragment slot="svelte"
                >The <code>children</code> snippet is the <a
                  href="#visible-label"
                  class="ui-link">visible label</a
                >. Set <code>hideLabel</code> to hide it visually while keeping it
                accessible.</Fragment
              >
            </Conditional>
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell>Add an <code>aria-label</code> on the input</TableCell>
          <TableCell
            >Not used. Use <PropOrClass prop="hideLabel" class=".ui-sr-only" /> instead,
            also for icon-only switches.</TableCell
          >
        </TableRow>
        <TableRow>
          <TableCell>
            Have a visible label that you reference with <code
              >aria-labelledby</code
            >
          </TableCell>
          <TableCell>Not used.</TableCell>
        </TableRow>
      </TableBody>
    </Table>

    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <div class="switch-anatomy">
        <UISwitch hideLabel>
          Theme
          <svg
            slot="icon-unchecked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
            ></path></svg
          >
        </UISwitch>
        <UISwitch checked>
          <svg
            slot="icon-unchecked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
            ></path></svg
          >
          <svg
            slot="icon-checked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M12 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 2m5 10a5 5 0 1 1-10 0a5 5 0 0 1 10 0m4.25.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zM12 19a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 19m-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zm-.03-8.53a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06m1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5a.75.75 0 0 0 0-1.06m-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06z"
            ></path></svg
          >
          Label
          <Fragment slot="end-text">End text</Fragment>
        </UISwitch>
      </div>
    </Anatomy>
  </Fragment>
</Component>

<style is:global>
  .switch-anatomy {
    align-items: start;
    display: flex;
    gap: var(--size-5);
  }
</style>
