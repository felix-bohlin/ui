---
import { Code } from "astro-expressive-code/components"
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Switch as UISwitch } from "@opui/astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import SwitchCSS from "@opui/css/components/switch.css?raw"
import FormCSS from "@opui/css/components/form.css?raw"

import fieldGroupApi from "../../component-api/field-group/api"
import switchApi from "../../component-api/switch/api"

import Conditional from "../../components/Conditional.astro"
import SwitchBuild from "../../components/UnderTheHood/SwitchBuild.astro"
---

<Component
  slug="switch"
  browserSupport={["has", "light-dark", "relative-color", "user-pseudos"]}
  heroAnatomy
  apis={[
    { title: "Switch API", api: switchApi },
    { title: "Field group API", api: fieldGroupApi },
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Switch",
      type: "component",
    },
    {
      path: "packages/opui/components/FieldGroup/FieldGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/switch.astro", type: "docs" },
    { path: "src/component-examples/switch", type: "docs" },
    {
      path: "packages/opui/css/components/switch.css",
      type: "css",
    },
    { path: "src/component-api/switch", type: "api" },
    { path: "src/component-api/field-group", type: "api" },
  ]}
  installationTabs={[
    { title: "switch.css", code: SwitchCSS, lang: "css" },
    { title: "form.css", code: FormCSS, lang: "css", seeAlso: true },
  ]}
>
  <Fragment slot="title">Switch</Fragment>
  <Fragment slot="preamble">
    Use a Switch for a setting that applies right away. Use a <DocLink
      href="/components/checkbox">Checkbox</DocLink
    > for choices that are submitted with a form, and a <DocLink
      href="/components/toggle">Toggle</DocLink
    > for options in a toolbar. See also: <a href="#field-group" class="ui-link"
      >Switch field group</a
    >.
  </Fragment>

  <!--
  Keep a look out for the new HTML switch control.
  It's not mature yet to even try to implement here,
  but will be in time.
  https://webkit.org/blog/15054/an-html-switch-control/
   -->

  <section>
    <h2 id="basics">Basics</h2>
    <p>
      All switches should have an accessible name. Put the label text inside the
      component, also when there's no visible label: use <code>.ui-sr-only</code
      >
      instead of <code>.ui-label</code>, or the <code>hideLabel</code> prop in Astro,
      Svelte and Vue.
    </p>

    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Set <code>size="small"</code> for a smaller Switch variant.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-small</code> class on the <code
          >&lt;label class="ui-switch"&gt;</code
        >
        {" "}for a smaller Switch variant.
      </Fragment>
      <Fragment slot="svelte">
        Set <code>size="small"</code> for a smaller Switch variant.
      </Fragment>
      <Fragment slot="vue">
        Set <code>size="small"</code> for a smaller Switch variant.
      </Fragment>
    </Conditional>

    <AutoExample name="Sizes" column centered spacious />
  </section>

  <section>
    <h2 id="visible-label">Visible label</h2>
    <p>
      Render the label text inside an element with a <code>.ui-label</code> class.
      Also, don't miss the info on label <a
        href="#accessibility"
        class="ui-link">accessibility</a
      >.
    </p>

    <AutoExample name="VisibleLabel" column centered />

    <h3 id="label-position">Label position</h3>
    <AutoExample name="LabelPosition" row spacious />

    <h3 id="end-text">End text</h3>
    <AutoExample name="SupportingText" row spacious />

    <h3 id="validation">Validation</h3>
    <ul>
      <Conditional>
        <li slot="astro">
          Set <code>required</code> on the component to toggle required styles on
          the input.
        </li>
        <li slot="svelte">
          Add the <code>required</code> attribute on the component. It is forwarded
          to the underlying <code>&lt;input&gt;</code>.
        </li>
        <li slot="vue">
          Add the <code>required</code> attribute on the component. It is forwarded
          to the underlying <code>&lt;input&gt;</code>.
        </li>
        <li slot="html">
          Add <code>[required]</code> to the <code>&lt;input&gt;</code> element to
          toggle required styles.
        </li>
      </Conditional>
      <Conditional>
        <li slot="astro">
          Use the <code>error</code> prop to toggle invalid styles. It renders
          {" "}<code>data-invalid</code> on the root element. Make use of the end
          text to give extra feedback on the error.
        </li>
        <li slot="svelte">
          Use the <code>error</code> prop to toggle invalid styles. It renders
          {" "}<code>data-invalid</code> on the root element. Make use of the end
          text to give extra feedback on the error.
        </li>
        <li slot="vue">
          Use the <code>error</code> prop to toggle invalid styles. It renders
          {" "}<code>data-invalid</code> on the root element. Make use of the end
          text to give extra feedback on the error.
        </li>
        <li slot="html">
          Add <code>data-invalid</code> on the root element to toggle invalid styles.
          Make use of the end text to give extra feedback on the error.
        </li>
      </Conditional>
    </ul>

    <AutoExample name="Validation" column centered spacious />
  </section>

  <section>
    <h2 id="icons">Icons</h2>
    <AutoExample name="Icons" column centered />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> prop to push the label to the left and the switch
        to the right. This is useful for full-width items like lists and menus.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to the <code
          >&lt;label class="ui-switch"&gt;</code
        >
        {" "}to push the label to the left and the switch to the right. This is
        useful for full-width items like lists and menus.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>spread</code> prop to push the label to the left and the switch
        to the right. This is useful for full-width items like lists and menus.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> prop to push the label to the left and the switch
        to the right. This is useful for full-width items like lists and menus.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column />
  </section>

  <section>
    <h2 id="label-alignment">Label alignment</h2>
    <p>
      The switch lines up with the first line of its label and centers on the
      label's capital letters, so it looks centered in any font and at any size.
      If a font still looks off, nudge the label with
      {" "}<code>--choice-label-offset</code>, in <code>em</code> or
      {" "}<code>cap</code> so it scales with the label.
    </p>
    <Code lang="css" code={`:root {\n  --choice-label-offset: 0.05em;\n}`} />
  </section>

  <section>
    <h2 id="field-group">Field group</h2>
    <p>Use field groups to group related switches.</p>
    <Conditional>
      <p slot="astro">
        The <code>name</code> prop will get passed down to each switch in the group.
      </p>
      <p slot="html">
        Give every <code>&lt;input&gt;</code> in the group the same <code
          >name</code
        >
        {" "}attribute so they're submitted together.
      </p>
      <p slot="svelte">
        The <code>name</code> prop will get passed down to each switch in the group.
      </p>
      <p slot="vue">
        The <code>name</code> prop will get passed down to each switch in the group.
      </p>
    </Conditional>
    <p>
      See also: <DocLink href="/components/form" class="ui-link"
        >Form documentation</DocLink
      >.
    </p>

    <AutoExample name="FieldGroup" centered column />

    <h3 id="field-group-direction">Direction</h3>
    <AutoExample name="FieldGroupDirection" row />

    <h3 id="field-group-field-description">Field description</h3>
    <p>Can be placed above and below the fields.</p>
    <AutoExample name="FieldGroupFieldDescription" column centered spacious />

    <h3 id="field-group-disabled">Disabled</h3>
    <p>
      Attach the <code>disabled</code> attribute to the <code
        >&lt;fieldset&gt;</code
      > element.
    </p>
    <AutoExample name="FieldGroupDisabled" row />

    <h3 id="field-group-required">Required</h3>
    <p>
      Attach the <code>required</code> attribute to at least one of your <code
        >&lt;input&gt;</code
      > elements.
    </p>
    <AutoExample name="FieldGroupRequired" row />

    <h3 id="field-group-validation">Validation</h3>
    <Conditional>
      <p slot="html">
        Attach the <code>data-invalid</code> attribute to your <code
          >&lt;fieldset class="ui-fieldset"&gt;</code
        > element.
      </p>
      <p slot="astro">
        Attach the <code>data-invalid</code> attribute to your <code
          >FieldSet</code
        > component.
      </p>
      <p slot="svelte">
        Attach the <code>data-invalid</code> attribute to your <code
          >FieldSet</code
        > component.
      </p>
      <p slot="vue">
        Attach the <code>data-invalid</code> attribute to your <code
          >FieldSet</code
        > component.
      </p>
    </Conditional>
    <AutoExample name="FieldGroupValidation" row />
  </section>

  <SwitchBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <h3 id="role-attributes">Role & attributes</h3>
    <table class="ui-table">
      <thead>
        <tr>
          <th>Role/attribute</th>
          <th>Usage</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><code>role="switch"</code></td>
          <td>
            Required on the <code>input</code> element. Identifies the element that
            serves as a switch.
          </td>
        </tr>
      </tbody>
    </table>

    <h3 id="labels">Labels</h3>
    <p>
      Accessible switches should have a label. The first two approaches are
      equally ok:
    </p>
    <table class="ui-table">
      <thead>
        <tr>
          <th>Approach</th>
          <th>Usage in Switch component</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Provide a label inside the element</td>
          <td
            >Use a <code>.ui-label</code> child for a <a
              href="#visible-label"
              class="ui-link">visible label</a
            >, or a <code>.ui-sr-only</code> child to hide it visually while keeping
            it accessible. In Astro, Svelte and Vue, set the <code
              >hideLabel</code
            >
            prop to render the label as <code>.ui-sr-only</code>.</td
          >
        </tr>
        <tr>
          <td>Add an <code>aria-label</code> on the input</td>
          <td
            >Not used. Use a <code>.ui-sr-only</code> label instead, also for icon-only
            switches.</td
          >
        </tr>
        <tr>
          <td>
            Have a visible label that you reference with <code
              >aria-labelledby</code
            >
          </td>
          <td>Not used.</td>
        </tr>
      </tbody>
    </table>

    <h3 id="keyboard-support">Keyboard support</h3>
    <div class="ui-not-rich-text">
      <table class="ui-table">
        <thead>
          <tr>
            <th>Key</th>
            <th>Function</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><kbd>Space</kbd></td>
            <td>When Switch is focused it changes its state.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.5}>
      <div class="switch-anatomy">
        <UISwitch hideLabel>
          Theme
          <svg
            slot="icon-unchecked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
            ></path></svg
          >
        </UISwitch>
        <UISwitch checked>
          <svg
            slot="icon-unchecked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M20.026 17.001c-2.762 4.784-8.879 6.423-13.663 3.661A10 10 0 0 1 3.13 17.68a.75.75 0 0 1 .365-1.132c3.767-1.348 5.785-2.91 6.956-5.146c1.233-2.353 1.551-4.93.689-8.463a.75.75 0 0 1 .769-.927a9.96 9.96 0 0 1 4.457 1.327c4.784 2.762 6.423 8.879 3.66 13.662"
            ></path></svg
          >
          <svg
            slot="icon-checked"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="M12 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 2m5 10a5 5 0 1 1-10 0a5 5 0 0 1 10 0m4.25.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zM12 19a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 19m-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5zm-.03-8.53a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06m1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5a.75.75 0 0 0 0-1.06m-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06z"
            ></path></svg
          >
          Label
          <Fragment slot="end-text">End text</Fragment>
        </UISwitch>
      </div>
    </Anatomy>
  </Fragment>
</Component>

<style is:global>
  .example-row {
    align-items: center;
    display: flex;
    gap: var(--size-3);
  }
  .example-row.ui-spacious {
    gap: var(--size-6);
  }

  .switch-anatomy {
    align-items: start;
    display: flex;
    gap: var(--size-5);
  }
</style>
