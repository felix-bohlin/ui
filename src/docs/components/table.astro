---
import Component from "../../layouts/Component.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import BlockLink from "../../components/BlockLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import {
  Table as UITable,
  TableBody as UITableBody,
  TableCaption as UITableCaption,
  TableCell as UITableCell,
  TableFoot as UITableFoot,
  TableHead as UITableHead,
  TableHeaderCell as UITableHeaderCell,
  TableRow as UITableRow,
} from "opui-css/astro"

import SortableTableCSS from "@opui/css/components/sortable-table.css?raw"
import TableCSS from "@opui/css/components/table.css?raw"
import SortableTableJS from "@opui/elements/sortable-table.js?raw"
import sortableTableApi from "../../component-api/sortable-table/api"
import tableApi from "../../component-api/table/api"
import tableCellApi from "../../component-api/table-cell/api"
import tableColumnApi from "../../component-api/table-column/api"
import tableColumnGroupApi from "../../component-api/table-column-group/api"
import tableHeaderCellApi from "../../component-api/table-header-cell/api"
import TableBuild from "../../components/UnderTheHood/TableBuild.astro"

export const description =
  "A table for data people scan and compare, with sticky headers, sorting and expandable rows."

export const keywords = ["data table", "grid", "rows", "sort"]
---

<Component
  description={description}
  slug="table"
  heroAnatomy
  apis={[
    { title: "Table API", api: tableApi },
    { title: "Table header cell API", api: tableHeaderCellApi },
    { title: "Table cell API", api: tableCellApi },
    { title: "Table column group API", api: tableColumnGroupApi },
    { title: "Table column API", api: tableColumnApi },
    { title: "Sortable table API", api: sortableTableApi },
  ]}
  installationTabs={[
    { title: "table.css", code: TableCSS, lang: "css" },
    { title: "sortable-table.css", code: SortableTableCSS, lang: "css" },
    { title: "sortable-table.js", code: SortableTableJS, lang: "js" },
  ]}
  browserSupport={[
    "container-scroll-state-queries",
    "has",
    "logical-properties",
    "overflow-clip",
    "relative-color",
  ]}
  fallbacks={{
    "container-scroll-state-queries":
      "Without scroll-state queries, a sticky header gets no shadow once it's stuck.",
  }}
  changelogPaths={[
    {
      path: "packages/opui/components/Table",
      type: "component",
    },
    { path: "src/docs/components/table.astro", type: "docs" },
    { path: "src/component-examples/table", type: "docs" },
    {
      path: "packages/opui/css/components/table.css",
      type: "css",
    },
    { path: "src/component-api/table", type: "api" },
    { path: "src/component-api/table-cell", type: "api" },
    { path: "src/component-api/table-column", type: "api" },
    { path: "src/component-api/table-header-cell", type: "api" },
    { path: "src/component-api/table-column-group", type: "api" },
    {
      path: "packages/opui/components/SortableTable",
      type: "component",
    },
    { path: "packages/opui/elements/sortable-table.js", type: "component" },
    {
      path: "packages/opui/css/components/sortable-table.css",
      type: "css",
    },
    { path: "src/component-api/sortable-table", type: "api" },
  ]}
>
  <Fragment slot="title">Table</Fragment>
  <Fragment slot="preamble">
    Data people scan and compare, like invoices. For labels with single values,
    use a <DocLink href="/components/description-list">Description list</DocLink
    >.
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UITable>
        <UITableCaption>Pedalboard</UITableCaption>
        <UITableHead>
          <UITableRow>
            <UITableHeaderCell>Pedal</UITableHeaderCell>
            <UITableHeaderCell>Price</UITableHeaderCell>
          </UITableRow>
        </UITableHead>
        <UITableBody>
          <UITableRow>
            <UITableCell>Compressor</UITableCell>
            <UITableCell>€89</UITableCell>
          </UITableRow>
          <UITableRow>
            <UITableCell>Octaver</UITableCell>
            <UITableCell>€120</UITableCell>
          </UITableRow>
        </UITableBody>
        <UITableFoot>
          <UITableRow>
            <UITableCell>Total</UITableCell>
            <UITableCell>€209</UITableCell>
          </UITableRow>
        </UITableFoot>
      </UITable>
    </Anatomy>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Data people scan and compare, like invoices.</li>
    <li slot="when">
      Numbers that line up:
      <a href="#numbers"><PropOrClass prop="numeric" class=".ui-numeric" /></a>.
    </li>
    <li slot="when">Rows people reorder: <a href="#sorting">sorting</a>.</li>
    <li slot="when-not">
      Layout: use the <DocLink href="/components/layout">Layout</DocLink>
      classes.
    </li>
    <li slot="when-not">
      Labels with single values: use a
      <DocLink href="/components/description-list">Description list</DocLink>.
    </li>
    <li slot="when-not">
      Rows with one label each: use a
      <DocLink href="/components/list">List</DocLink>.
    </li>
  </Usage>

  <section id="density">
    <h2>Density</h2>

    <Conditional as="p">
      <Fragment slot="components">
        Use <code>density</code> to change density.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-dense</code> or <code>.ui-spacious</code> to change
        density.
      </Fragment>
    </Conditional>

    <h3 id="normal">Normal</h3>
    <AutoExample name="Normal" />

    <h3 id="dense">Dense</h3>
    <AutoExample name="Dense" />

    <h3 id="spacious">Spacious</h3>
    <AutoExample name="Spacious" />
  </section>

  <section id="numbers">
    <h2>Numbers</h2>
    <p>
      Use <PropOrClass prop="numeric" class=".ui-numeric" /> on every cell of
      the column, header included.
    </p>
    <AutoExample name="Numeric" />
  </section>

  <section id="in-a-card">
    <h2>In a card</h2>
    <p>
      Use <PropOrClass prop="flush" class=".ui-flush" /> and
      <PropOrClass prop='overflow="scroll"' class=".ui-overflow-scroll" />. A
      scrolling table needs <code>tabindex="0"</code>.
    </p>
    <AutoExample name="InCard" />
  </section>

  <section id="controls-in-cells">
    <h2>Controls in cells</h2>
    <p>
      Hide the label with <PropOrClass prop="hideLabel" class=".ui-sr-only" />
      and name the row in it.
    </p>

    <AutoExample name="Controls" />

    <BlockLink slug="data-table">
      A select all checkbox in the header, a checkbox in each row, and a bar
      with actions for the selected rows that only shows while a row is checked.
    </BlockLink>
    <BlockLink slug="file-manager">
      A round button at the end of each row opens a menu of actions for the
      file, named "Actions for" and the file name.
    </BlockLink>
  </section>

  <section id="sticky-header">
    <h2>Sticky header</h2>
    <p>
      Use <PropOrClass prop="stickyHeader" class=".ui-sticky-header" />, without
      <PropOrClass prop='overflow="scroll"' class=".ui-overflow-scroll" />. Give
      the scroll box, or <code>html</code> when the header sticks to the page, a
      <code>scroll-padding-block-start</code> as tall as the header, so a
      control that takes focus doesn't land under it.
    </p>

    <AutoExample name="StickyHeader" />
  </section>

  <section id="sorting">
    <h2>Sorting</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Wrap the table in <code>SortableTable</code> and set
        <code>sortable</code> on the headers.
      </Fragment>
      <Fragment slot="html">
        Wrap the table in <code>opui-sortable-table</code> and import
        <code>opui-css/elements/sortable-table.js</code>.
      </Fragment>
    </Conditional>
    <p>Give formatted numbers and dates a <code>data-sort-value</code>.</p>
    <AutoExample name="Sortable" />
    <Conditional as="p">
      <Fragment slot="astro">
        To sort rows you render from data, listen for the <code>sort</code>
        event in a client script and call <code>preventDefault()</code>, which
        leaves the rows where they are, then sort the data by
        <code>event.detail.column</code> and <code>event.detail.direction</code
        >.
      </Fragment>
      <Fragment slot="html">
        To sort rows you keep as data, listen for the <code>sort</code> event
        and call <code>preventDefault()</code>, which leaves the rows where they
        are, then sort the data by <code>event.detail.column</code> and
        <code>event.detail.direction</code>.
      </Fragment>
      <Fragment slot="react">
        To sort rows you render from data, pass <code>onSort</code> and call
        <code>event.preventDefault()</code>, which leaves the rows where they
        are, then sort the state by <code>event.detail.column</code> and
        <code>event.detail.direction</code>.
      </Fragment>
      <Fragment slot="svelte">
        To sort rows you render from data, pass <code>onsort</code> and call
        <code>event.preventDefault()</code>, which leaves the rows where they
        are, then sort the state by <code>event.detail.column</code> and
        <code>event.detail.direction</code>.
      </Fragment>
      <Fragment slot="vue">
        To sort rows you render from data, listen with <code>@sort</code> and
        call <code>event.preventDefault()</code>, which leaves the rows where
        they are, then sort the ref by <code>event.detail.column</code> and
        <code>event.detail.direction</code>.
      </Fragment>
    </Conditional>
    <p>
      The header still gets <code>aria-sort</code>, and the order is announced.
    </p>
    <AutoExample name="SortableData" />
  </section>

  <section id="empty">
    <h2>Empty</h2>
    <AutoExample name="Empty" />
  </section>

  <section id="expandable-rows">
    <h2>Expandable rows</h2>
    <p>
      Toggle a <code>hidden</code> row with a button that sets
      <code>aria-expanded</code>.
    </p>
    <AutoExample name="Expandable" />
  </section>

  <section id="advanced">
    <h2>Grouped headers</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Group columns with <code>TableColumnGroup</code>, span headers with
        <code>colspan</code> and <code>rowspan</code>, and give each header a
        <code>scope</code>.
      </Fragment>
      <Fragment slot="html">
        Group columns with <code>&lt;colgroup&gt;</code>, span headers with
        <code>colspan</code> and <code>rowspan</code>, and give each header a
        <code>scope</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Advanced" />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>Name the table with a <code>&lt;caption&gt;</code>.</li>
      <li>
        A scroll box needs <code>tabindex="0"</code>, <code>role="region"</code>
        and an <code>aria-label</code>.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <TableBuild slot="under-the-hood" />
</Component>
