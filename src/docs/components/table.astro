---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import {
  Table as UITable,
  TableBody as UITableBody,
  TableCaption as UITableCaption,
  TableCell as UITableCell,
  TableFoot as UITableFoot,
  TableHead as UITableHead,
  TableHeaderCell as UITableHeaderCell,
  TableRow as UITableRow,
} from "opui-css/astro"

import TableCSS from "@opui/css/components/table.css?raw"
import tableApi from "../../component-api/table/api"
import tableColumnApi from "../../component-api/table-column/api"
import tableColumnGroupApi from "../../component-api/table-column-group/api"
import TableBuild from "../../components/UnderTheHood/TableBuild.astro"

export const description =
  "Displays tabular data. Basic tables with row and column headers, and optional captions and footers."
---

<Component
  description={description}
  slug="table"
  heroAnatomy
  apis={[
    { title: "Table API", api: tableApi },
    { title: "Table column group API", api: tableColumnGroupApi },
    { title: "Table column API", api: tableColumnApi },
  ]}
  installationTabs={[{ title: "table.css", code: TableCSS, lang: "css" }]}
  browserSupport={[
    "container-scroll-state-queries",
    "container-style-queries",
    "has",
    "overflow-clip",
    "relative-color",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Table",
      type: "component",
    },
    { path: "src/docs/components/table.astro", type: "docs" },
    { path: "src/component-examples/table", type: "docs" },
    {
      path: "packages/opui/css/components/table.css",
      type: "css",
    },
    { path: "src/component-api/table", type: "api" },
    { path: "src/component-api/table-column", type: "api" },
    { path: "src/component-api/table-column-group", type: "api" },
  ]}
>
  <Fragment slot="title">Table</Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UITable>
        <UITableCaption>Components</UITableCaption>
        <UITableHead>
          <UITableRow>
            <UITableHeaderCell>Name</UITableHeaderCell>
            <UITableHeaderCell>Size</UITableHeaderCell>
          </UITableRow>
        </UITableHead>
        <UITableBody>
          <UITableRow>
            <UITableCell>Card</UITableCell>
            <UITableCell>2 kB</UITableCell>
          </UITableRow>
          <UITableRow>
            <UITableCell>Dialog</UITableCell>
            <UITableCell>3 kB</UITableCell>
          </UITableRow>
        </UITableBody>
        <UITableFoot>
          <UITableRow>
            <UITableCell>Total</UITableCell>
            <UITableCell>5 kB</UITableCell>
          </UITableRow>
        </UITableFoot>
      </UITable>
    </Anatomy>
  </Fragment>

  <section>
    <h2 id="variants">Variants</h2>

    <Conditional as="p">
      <Fragment slot="components">
        Change the cell padding with <code>variant="dense"</code> or <code
          >variant="spacious"</code
        >.
      </Fragment>
      <Fragment slot="html">
        Change the cell padding with the <code>.ui-dense</code> or <code
          >.ui-spacious</code
        > class.
      </Fragment>
    </Conditional>

    <h3 id="default">Default</h3>
    <AutoExample name="Default" />

    <h3 id="dense">Dense</h3>
    <AutoExample name="Dense" />

    <h3 id="spacious">Spacious</h3>
    <AutoExample name="Spacious" />
  </section>

  <section>
    <h2 id="sticky-header">Sticky header</h2>
    <Conditional as="p">
      <Fragment slot="components">
        <code>stickyHeader</code> keeps the header rows at the top of the nearest
        scroll container while the rows scroll under them, and adds a shadow once
        the header is stuck. Put the table in a scroll box, or let it stick to the
        page and set <code>--_sticky-offset</code> on the table to clear a fixed top
        bar.
      </Fragment>
      <Fragment slot="html">
        <code>.ui-sticky-header</code> keeps the header rows at the top of the nearest
        scroll container while the rows scroll under them, and adds a shadow once
        the header is stuck. Put the table in a scroll box, or let it stick to the
        page and set <code>--_sticky-offset</code> on the table to clear a fixed top
        bar.
      </Fragment>
    </Conditional>

    <p>
      The scroll box has <code>role="region"</code>, an <code>aria-label</code> and
      {" "}<code>tabindex="0"</code>. A table has nothing focusable, so without
      <code>tabindex</code> keyboard users can't reach the box to scroll it, and the
      name tells screen reader users what the region holds.
    </p>

    <AutoExample name="StickyHeader" />
  </section>

  <section>
    <h2 id="advanced">Advanced</h2>
    <p>
      An advanced table showcasing the use of <code>colgroup</code>, <code
        >rowspan</code
      >, and <code>colspan</code>.
    </p>
    <p>
      The first cell of each row is a row header, <code
        >&lt;th scope="row"&gt;</code
      >. Row headers keep the body background, so only the column headers are
      filled.
    </p>

    <AutoExample name="Advanced" />
  </section>

  <Fragment slot="accessibility">
    <p>
      A <code>&lt;caption&gt;</code> names the table, and screen readers announce
      it when the user enters the table. <code>&lt;th&gt;</code> cells in
      {" "}<code>&lt;thead&gt;</code> are column headers, read out with each cell
      below them. Use <code>&lt;th scope="row"&gt;</code> for a row header in the
      body. A <code>&lt;tfoot&gt;</code> keeps totals and summaries apart from the
      data rows.
    </p>
    <p>
      A table in a scroll box needs <code>tabindex="0"</code> on the box so keyboard
      users can scroll it, and a name from <code>aria-label</code> with
      {" "}<code>role="region"</code>, as in <a
        class="ui-link"
        href="#sticky-header">Sticky header</a
      >.
    </p>
  </Fragment>

  <TableBuild slot="under-the-hood" />
</Component>
