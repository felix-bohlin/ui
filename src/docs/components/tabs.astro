---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"
import TabsBuild from "../../components/UnderTheHood/TabsBuild.astro"
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
  Tabs as UITabs,
  TabsItem as UITabsItem,
  TabsLabel as UITabsLabel,
  TabsPanel as UITabsPanel,
} from "opui-css/astro"

import TabsCSS from "@opui/css/components/tabs.css?raw"

import tabsItemApi from "../../component-api/tabs-item/api"
import tabsLabelApi from "../../component-api/tabs-label/api"
import tabsPanelApi from "../../component-api/tabs-panel/api"
import tabsApi from "../../component-api/tabs/api"
---

<Component
  slug="tabs"
  heroAnatomy
  apis={[
    { title: "Tabs API", api: tabsApi },
    { title: "Tabs item API", api: tabsItemApi },
    { title: "Tabs label API", api: tabsLabelApi },
    { title: "Tabs panel API", api: tabsPanelApi },
  ]}
  browserSupport={[
    "container-queries",
    "light-dark",
    "nth-child-of",
    "scrollbar-width",
    "sibling-count",
  ]}
  installationTabs={[{ title: "tabs.css", code: TabsCSS, lang: "css" }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Tabs",
      type: "component",
    },
    { path: "src/docs/components/tabs.astro", type: "docs" },
    { path: "src/component-examples/tabs", type: "docs" },
    {
      path: "packages/opui/css/components/tabs.css",
      type: "css",
    },
    { path: "src/component-api/tabs", type: "api" },
  ]}
>
  <Fragment slot="title">Tabs</Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UITabs name="tabs-anatomy">
        <UITabsItem>
          <UITabsLabel>Profile</UITabsLabel>
          <UITabsPanel>Profile settings and information.</UITabsPanel>
        </UITabsItem>
        <UITabsItem checked>
          <UITabsLabel>Settings</UITabsLabel>
          <UITabsPanel>General account settings.</UITabsPanel>
        </UITabsItem>
      </UITabs>
    </Anatomy>
  </Fragment>
  <Fragment slot="preamble">
    The Tabs are radio inputs and the Panels are just divs that show and hide
    based on the radio inputs' <code>:checked</code> state. Use Tabs to switch between
    panels of content. To pick an option, like a list or grid view, use a <DocLink
      href="/components/toggle#toggle-group">Toggle group</DocLink
    >.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Switching between panels of related content in one place, like the parts
      of a settings page.
    </li>
    <li slot="when">
      Versions of the same content, like a code sample for each framework.
    </li>
    <li slot="when-not">
      Picking an option, like a list or grid view. Use a <DocLink
        href="/components/toggle#toggle-group">Toggle group</DocLink
      >.
    </li>
    <li slot="when-not">
      Content that people compare or read in order. Show it on the page, or in <DocLink
        href="/components/accordion">Accordions</DocLink
      > that can be open at the same time.
    </li>
    <li slot="when-not">
      Navigation between pages. The tabs are radio inputs, not links, so use
      links, like a <DocLink href="/components/list#selected">List</DocLink> with
      <code>aria-current="page"</code>.
    </li>
  </Usage>

  <section>
    <h2 id="basics">Basics</h2>
    <Conditional as="p">
      <Fragment slot="components">
        The default <code>variant</code> is <code>tonal</code>: the tabs sit on
        a tonal track and the selected tab is a raised pill.
      </Fragment>
    </Conditional>
    <AutoExample name="Basics" />
  </section>

  <section>
    <h2 id="filled">Filled</h2>
    <p>
      Use <PropOrClass prop='variant="filled"' class=".ui-filled" /> to fill the selected
      tab with the primary color.
    </p>
    <AutoExample name="Filled" />
  </section>

  <section>
    <h2 id="line">Line</h2>
    <p>
      Use <PropOrClass prop='variant="line"' class=".ui-line" /> for tabs without
      a background, marking the selected tab with a line.
    </p>
    <AutoExample name="Line" />
  </section>

  <section>
    <h2 id="outlined">Outlined</h2>
    <p>
      Use <PropOrClass prop='variant="outlined"' class=".ui-outlined" /> for a bordered
      track without a background.
    </p>
    <AutoExample name="Outlined" />
  </section>

  <section>
    <h2 id="overflow">Overflow</h2>
    <p>
      Tabs wrap onto more rows when they don't fit. Use <PropOrClass
        prop='overflow="scroll"'
        class=".ui-overflow-scroll"
      /> to keep them on one row and scroll them sideways instead. The open panel
      stays in view. The tabs size to their container, so give them a width inside
      flex and grid layouts that size to their content.
    </p>
    <AutoExample name="Overflow" />
  </section>

  <section>
    <h2 id="binding">Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Astro renders the tabs on the server, so they have no bound value. Give
        each <code>TabsItem</code> a <code>value</code> and set <code
          >value</code
        >
        on <code>Tabs</code> to select the matching tab. After that the selection
        lives in the radio inputs, which share the <code>name</code>: submit
        them with a form, where <code>FormData.get()</code> reads the selected tab,
        or read the checked input in a script on <code>change</code>. Set <code
          >input.checked = input.defaultChecked</code
        > to go back to the starting tab.
      </Fragment>
      <Fragment slot="html">
        The selection lives in the radio inputs, which share a <code>name</code
        >. Give each one a <code>value</code> and submit them with a form, where <code
          >FormData.get()</code
        > reads the selected tab, or read the checked input in a script on <code
          >change</code
        >. Set <code>input.checked = input.defaultChecked</code> to go back to the
        <code>checked</code> input in the markup.
      </Fragment>
      <Fragment slot="react">
        Give each <code>TabsItem</code> a <code>value</code> and control the selection
        with <code>value</code> and <code>onValueChange</code> on <code
          >Tabs</code
        >, or set the starting tab with <code>defaultValue</code>. A tab is
        checked when its <code>value</code> matches, so the items don't need <code
          >defaultChecked</code
        >. A tab that loses its check to another one fires no <code
          >onChange</code
        > of its own, which is why the value lives on <code>Tabs</code>.
      </Fragment>
      <Fragment slot="svelte">
        Give each <code>TabsItem</code> a <code>value</code> and bind the selection
        with <code>bind:value</code> on <code>Tabs</code>. A tab is checked when
        its <code>value</code> matches, and setting the variable switches tabs. A
        tab that loses its check to another one fires no <code>change</code> of its
        own, which is why the value lives on <code>Tabs</code>.
      </Fragment>
      <Fragment slot="vue">
        Give each <code>TabsItem</code> a <code>value</code> and bind the selection
        with <code>v-model</code> on <code>Tabs</code>. A tab is checked when
        its <code>value</code> matches, and setting the ref switches tabs. A tab that
        loses its check to another one fires no <code>change</code> of its own, which
        is why the value lives on <code>Tabs</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <Fragment slot="accessibility">
    <p>
      Tabs are radio buttons. Each tab is a radio input with a label, and the
      panel after it shows while it's checked. Screen readers announce a radio
      group ("Profile, radio button, checked, 1 of 3"), which matches how the
      tabs behave.
    </p>
    <p>
      There are no <code>tablist</code>, <code>tab</code> or
      {" "}<code>tabpanel</code> roles. ARIA tabs promise focusable tabs with a selected
      state, and radio inputs can't keep that promise without JavaScript. Native radios
      get group management and keyboard support for free.
    </p>
    <p>
      To name the group, add <code>role="radiogroup"</code> and
      {" "}<code>aria-label</code> (or <code>aria-labelledby</code>) to
      {" "}<PropOrClass prop="Tabs" class=".ui-tabs" />.
    </p>

    <Table>
      <TableColumnGroup>
        <TableColumn width="150px" />
        <TableColumn width="150px" />
        <TableColumn />
      </TableColumnGroup>
      <TableHead>
        <TableRow>
          <TableHeaderCell>Element</TableHeaderCell>
          <TableHeaderCell>Attribute</TableHeaderCell>
          <TableHeaderCell>Description</TableHeaderCell>
        </TableRow>
      </TableHead>
      <TableBody>
        <TableRow>
          <TableCell><code>input</code></TableCell>
          <TableCell><code>name</code></TableCell>
          <TableCell
            >Groups the radio buttons together for exclusive selection.</TableCell
          >
        </TableRow>
        <TableRow>
          <TableCell><code>input</code></TableCell>
          <TableCell><code>checked</code></TableCell>
          <TableCell>Selects the tab that is open initially.</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code>label</code></TableCell>
          <TableCell><code>for</code></TableCell>
          <TableCell>Names the radio button after the tab.</TableCell>
        </TableRow>
      </TableBody>
    </Table>

    <KeyboardSupport />
  </Fragment>
  <TabsBuild slot="under-the-hood" />
</Component>
