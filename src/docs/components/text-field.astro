---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import {
  Callout as UICallout,
  CalloutContent as UICalloutContent,
  CalloutIcon as UICalloutIcon,
  Switch as UISwitch,
  TextField as UITextField,
} from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import TextFieldCSS from "@opui/css/components/text-field.css?raw"

import textFieldApi from "../../component-api/text-field/api"
import TextFieldBuild from "../../components/UnderTheHood/TextFieldBuild.astro"

export const description =
  "An input for single-line text data. Basic text fields with labels, field descriptions, and validation states."
---

<Component
  description={description}
  heroAnatomy
  slug="text-field"
  browserSupport={[
    "container-queries",
    "container-style-queries",
    "datalist",
    "field-sizing",
    "has",
    "lh",
    "light-dark",
    "relative-color",
    "user-pseudos",
  ]}
  apis={[{ title: "Text field API", api: textFieldApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/TextField/TextField.astro",
      type: "component",
    },
    { path: "src/docs/components/text-field.astro", type: "docs" },
    { path: "src/component-examples/text-field", type: "docs" },
    {
      path: "packages/opui/css/components/text-field.css",
      type: "css",
    },
    { path: "src/component-api/text-field", type: "api" },
  ]}
  installationTabs={[
    { title: "text-field.css", code: TextFieldCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Text field</Fragment>

  <section>
    <h2 id="variants">Variants</h2>
    <Conditional>
      <p slot="astro">
        Text fields are outlined by default. Set <code>variant="filled"</code> for
        a filled field.
      </p>
      <p slot="html">
        Text fields are outlined by default. Add <code>.ui-filled</code> for a filled
        field.
      </p>
      <p slot="react">
        Text fields are outlined by default. Set <code>variant="filled"</code> for
        a filled field.
      </p>
      <p slot="svelte">
        Text fields are outlined by default. Set <code>variant="filled"</code> for
        a filled field.
      </p>
      <p slot="vue">
        Text fields are outlined by default. Set <code>variant="filled"</code> for
        a filled field.
      </p>
    </Conditional>
    <AutoExample name="Variants" row />
  </section>

  <section>
    <h2 id="sizes">Sizes</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="html">
        Choose between four sizes: <code>.ui-x-small</code>, <code
          >.ui-small</code
        >, default and <code>.ui-large</code>.
      </Fragment>
      <Fragment slot="react">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="svelte">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
      <Fragment slot="vue">
        Choose between four sizes with the <code>size</code> prop: <code
          >x-small</code
        >, <code>small</code>, default and <code>large</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Sizes" row />
  </section>

  <section>
    <h2 id="start-text">Start text</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>startText</code> prop or <code>start-text</code> slot for text
        between the label and the input.
      </Fragment>
      <Fragment slot="html">
        Add a <code>.ui-start-text</code> between <code>.ui-label</code> and
        {" "}<code>.ui-field</code> for text between the label and the input.
      </Fragment>
      <Fragment slot="react">
        Use the <code>startText</code> prop for text between the label and the input.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>startText</code> prop or snippet for text between the label
        and the input.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>startText</code> prop or <code>start-text</code> slot for text
        between the label and the input.
      </Fragment>
    </Conditional>
    <AutoExample name="StartText" row />
  </section>

  <section>
    <h2 id="end-text">End text</h2>
    <AutoExample name="EndText" centered />
  </section>

  <section>
    <h2 id="affix">Affix</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>prefix</code>, <code>suffix</code>, <code>header</code>,
        and <code>footer</code> slots to affix content inside the field's border.
        Prefix and suffix sit beside the input, while header and footer span the field's
        full width with a divider.
      </Fragment>
      <Fragment slot="react">
        Use the <code>prefix</code>, <code>suffix</code>, <code>header</code>,
        and <code>footer</code> props to affix content inside the field's border.
        Prefix and suffix sit beside the input, while header and footer span the field's
        full width with a divider.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>prefix</code>, <code>suffix</code>, <code>header</code>,
        and <code>footer</code> snippets to affix content inside the field's border.
        Prefix and suffix sit beside the input, while header and footer span the field's
        full width with a divider.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>prefix</code>, <code>suffix</code>, <code>header</code>,
        and <code>footer</code> slots to affix content inside the field's border.
        Prefix and suffix sit beside the input, while header and footer span the field's
        full width with a divider.
      </Fragment>
      <Fragment slot="html">
        Add <code>.ui-prefix</code>, <code>.ui-suffix</code>, <code
          >.ui-header</code
        >, or{" "}
        <code>.ui-footer</code> elements inside <code>.ui-field</code> to affix content
        inside the field's border. Prefix and suffix sit beside the input, while header
        and footer span the field's full width with a divider.
      </Fragment>
    </Conditional>

    <AutoExample name="Affix" column />

    <h3 id="headers-and-footers">Headers and footers</h3>
    <p>
      Use the header for inside-field captions (filenames, categories) and the
      footer for counters, hints, or action buttons.
    </p>

    <AutoExample name="Headers" column />
  </section>

  <section>
    <h2 id="validation">Validation</h2>
    <ValidationNotes element="input" named subject="Fields" />

    <AutoExample name="Validation" column spacious />
  </section>

  <section>
    <h2 id="spread">Spread</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the input on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-spread</code> class to display the label and start text
        on the left with the input on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="react">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the input on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="svelte">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the input on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
      <Fragment slot="vue">
        Use the <code>spread</code> boolean prop to display the label and start text
        on the left with the input on the right. The layout collapses to a column
        on narrow containers.
      </Fragment>
    </Conditional>

    <AutoExample name="Spread" column spacious />
  </section>

  <section>
    <h2 id="auto-fit">Auto-fit</h2>
    <p>
      Use <PropOrClass prop="autoFit" class=".ui-auto-fit" /> to let the field's width
      follow its content, from <code>25ch</code>.
    </p>

    <AutoExample name="AutoFit" class="flex" />
  </section>

  <section>
    <h2 id="input-types">Input types</h2>
    <AutoExample name="InputTypes" row>
      <UISwitch
        size="small"
        slot="controls"
        data-toggle-class="ui-filled"
        data-toggle-target=".ui-text-field">Filled</UISwitch
      >
      <UISwitch
        size="small"
        slot="controls"
        data-toggle-class="ui-small"
        data-toggle-target=".ui-text-field">Small</UISwitch
      >
    </AutoExample>

    <div class="ui-not-rich-text">
      <UICallout>
        <UICalloutContent>
          <h3>Date inputs</h3>
          <div class="ui-rich-text">
            Date-related inputs never show as empty, so the label is always
            visible. There are only hacks with compromises and no neat ways of
            dealing with that issue. You're free to implement a solution of your
            own here that works with your project.
          </div>
        </UICalloutContent>
      </UICallout>
    </div>

    <h3 id="numeric-vs-input-type-number">
      Numeric vs <code>&lt;input type="number"&gt;</code>
    </h3>

    <AutoExample name="Numeric" />

    <div class="ui-not-rich-text">
      <UICallout severity="critical">
        <UICalloutIcon />
        <UICalloutContent>
          <h3>
            You most likely don't need <code>&lt;input type="number"&gt;</code>
          </h3>
          <div class="ui-rich-text">
            <p>
              While <code>&lt;input type="number"&gt;</code> may seem logical for
              numeric data it should only be used when mathematical operations are
              needed on the input (which is... never). Data like credit card numbers,
              IDs or social security numbers - are actually text that happen to be
              numeric rather than mathematical values. Therefore, consider using{
                " "
              }
              <code
                >&lt;input type="text" inputmode="numeric" pattern="[0-9]*"&gt;</code
              > instead.
            </p>

            <p><strong>You will have a bad time.</strong></p>

            <p>
              This triggers the numeric keyboard on mobile devices while
              avoiding the jank of number inputs, such as:
            </p>

            <ul>
              <li>Unexpected value increments from scroll wheels</li>
              <li>Browser-specific validation differences</li>
              <li>Accessibility problems</li>
              <li>Removal of leading zeros</li>
              <li>Allows for some non-numeric mathematical characters</li>
            </ul>

            <p>
              It should probably be called <code>&lt;input type="math"&gt;</code
              > instead.
            </p>

            <p>
              The British Government has a <a
                href="https://technology.blog.gov.uk/2020/02/24/why-the-gov-uk-design-system-team-changed-the-input-type-for-numbers/"
                class="ui-link">great article</a
              > about how bad input number is and goes in-depth. It's a very interesting
              read.
            </p>
          </div>
        </UICalloutContent>
      </UICallout>
    </div>

    <h3 id="file">File</h3>
    <p>
      File is a weird one. Should it really be an <code>&lt;input&gt;</code> element?
      Well, it's what we've got.
    </p>

    <AutoExample name="File" row />
  </section>

  <section>
    <h2 id="autosuggest">Autosuggest</h2>
    <p>
      Leverages the <code>&lt;input&gt;</code> + <code>&lt;datalist&gt;</code> element
      combo. An input with a <code>list</code> shows the Select chevron in place of
      the browser's arrow.
    </p>

    <ul>
      <li><code>&lt;input list="DATALISTID"&gt;</code></li>
      <li><code>&lt;datalist id="DATALISTID"&gt;</code></li>
    </ul>

    <AutoExample name="Autosuggest" row />

    <div class="ui-not-rich-text">
      <UICallout>
        <UICalloutContent>
          <div class="ui-rich-text">
            <p>
              Think of <code>&lt;datalist&gt;</code> as a list of <em
                >suggested</em
              > values.
            </p>

            <ul>
              <li>
                <code>&lt;select&gt;</code> only allows you to choose between its
                provided values.
              </li>
              <li>
                <code>&lt;input&gt;</code> lets you input anything you want.
              </li>
              <li>
                <code>&lt;input&gt;</code> + <code>&lt;datalist&gt;</code> is a hybrid
                between the two.
              </li>
            </ul>
          </div>
        </UICalloutContent>
      </UICallout>
    </div>
  </section>

  <section>
    <h2 id="do-i-have-to-use-label">
      Do I have to use <code>&lt;label&gt;</code>?
    </h2>
    <p>
      No. But you get some accessibility wins for free with <code
        >&lt;label&gt;</code
      >. It's recommended to label your inputs somehow.
    </p>

    <AutoExample name="NoLabel" />
  </section>

  <TextFieldBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        <a href="#numeric-vs-input-type-number" class="ui-link"
          >Don't use <code>&lt;input type="number"&gt;</code></a
        > unless your user research tells you to.
      </li>
    </ul>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UITextField
        startText="Start text"
        endText="Supporting text"
        label="Label"
        placeholder="Placeholder"
        value="Value"
      >
        <span slot="header">Header</span>
        <span slot="prefix">€</span>
        <span slot="suffix">EUR</span>
        <span slot="footer">Footer</span>
      </UITextField>
    </Anatomy>
  </Fragment>
</Component>
