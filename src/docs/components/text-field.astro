---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import DefaultIcon from "./partials/DefaultIcon.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import {
  Callout as UICallout,
  CalloutContent as UICalloutContent,
  CalloutIcon as UICalloutIcon,
  Switch as UISwitch,
  TextField as UITextField,
} from "opui-css/astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import TextFieldCSS from "@opui/css/components/text-field.css?raw"

import textFieldApi from "../../component-api/text-field/api"
import TextFieldBuild from "../../components/UnderTheHood/TextFieldBuild.astro"

export const description =
  "A single-line text input with a label, start and end text, and validation."

export const keywords = ["email", "input", "password", "search", "text box"]
---

<Component
  description={description}
  heroAnatomy
  slug="text-field"
  browserSupport={[
    "alt-text-generated-content",
    "container-queries",
    "datalist",
    "field-sizing",
    "has",
    "invoker-commands",
    "lh",
    "reading-flow",
    "registered-custom-properties",
    "user-pseudos",
  ]}
  fallbacks={{
    "reading-flow":
      "Without `reading-flow`, Tab and screen readers follow the markup, which puts the top and start parts before the control, as they're drawn. Hand-written HTML needs that order too.",
  }}
  apis={[{ title: "Text field API", api: textFieldApi }]}
  installationTabs={[
    { title: "text-field.css", code: TextFieldCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Text field</Fragment>
  <Fragment slot="preamble">
    Short free text, like a name or a search. For several lines, use a
    <DocLink href="/components/textarea">Textarea</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Short free text, like a name or a search.</li>
    <li slot="when">
      Numbers that are text, like a card number:
      <a href="#numeric-vs-input-type-number"
        ><code>inputmode="numeric"</code></a
      >.
    </li>
    <li slot="when">
      Free text with suggestions:
      <a href="#autosuggest"><code>&lt;datalist&gt;</code></a>.
    </li>
    <li slot="when-not">
      Several lines: use a
      <DocLink href="/components/textarea">Textarea</DocLink>.
    </li>
    <li slot="when-not">
      A fixed list: use a <DocLink href="/components/select">Select</DocLink>.
    </li>
    <li slot="when-not">
      A scale or a quantity: use a
      <DocLink href="/components/range">Range</DocLink> or a
      <DocLink href="/components/number-field">Number field</DocLink>.
    </li>
  </Usage>

  <section id="input">
    <h2>Input</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Write the <code>&lt;input&gt;</code> inside the field, with its
        <code>id</code> set to <code>for</code>, and bind, name and validate it
        like any input. The types require <code>for</code>.
      </Fragment>
      <Fragment slot="react">
        Write the <code>&lt;input&gt;</code> inside the field, with its
        <code>id</code> set to <code>htmlFor</code>, and bind, name and validate
        it like any input. The types require <code>htmlFor</code>.
      </Fragment>
      <Fragment slot="html">
        Put the <code>&lt;input&gt;</code> directly in
        <code>.ui-field-container</code>, and point the
        <code>&lt;label for&gt;</code> at its <code>id</code>.
      </Fragment>
    </Conditional>
    <p>
      Each part the field shows has an id that starts with the input's:
      <code>x-start-text</code>, <code>x-top</code>, <code>x-start</code>,
      <code>x-end</code>, <code>x-bottom</code> and <code>x-end-text</code> for
      an input with <code>id="x"</code>. Point the input's
      <code>aria-describedby</code> at the ones it shows, in that order, so a
      unit, a hint or an error is read after the name.
    </p>
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      field.
    </p>
    <AutoExample name="Variants" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" row />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" />
    <p>Without a label, add <code>aria-label</code> to the input.</p>
    <AutoExample name="NoLabel" />
  </section>

  <section id="start-text">
    <h2>Start text</h2>
    <p>Use <PropOrClass prop="startText" class=".ui-start-text" />.</p>
    <AutoExample name="StartText" row />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <p>
      Use <PropOrClass prop="endText" class=".ui-end-text" />, and point the
      input's <code>aria-describedby</code> at it.
    </p>
    <AutoExample name="EndText" centered />
  </section>

  <section id="character-count">
    <h2>Character count</h2>
    <Conditional as="p">
      <Fragment slot="components">
        With <code>maxlength</code> on the input, set <code>characterCount</code
        >. Screen readers only hear the count near the limit, so name the limit
        in the end text.
      </Fragment>
      <Fragment slot="html">
        With <code>maxlength</code>, import
        <code>opui-css/elements/character-count.js</code>. Screen readers only
        hear the count near the limit, so name the limit in the end text.
      </Fragment>
    </Conditional>
    <AutoExample name="CharacterCount" centered />
  </section>

  <section id="password-toggle">
    <h2>Password toggle</h2>
    <Conditional as="p">
      <Fragment slot="components"> Set <code>passwordToggle</code>. </Fragment>
      <Fragment slot="html">
        Import <code>opui-css/elements/text-field.js</code>.
      </Fragment>
    </Conditional>
    <DefaultIcon
      slots={["icon-unchecked", "icon-checked"]}
      tokens={["--ui-icon-show", "--ui-icon-hide"]}
    />
    <AutoExample name="PasswordToggle" row />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>start</code>, <code>end</code>, <code>top</code> and
        <code>bottom</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-start</code>, <code>.ui-end</code>, <code>.ui-top</code>
        and <code>.ui-bottom</code>.
      </Fragment>
    </Conditional>
    <p>
      A text affix too long for the field ends in an ellipsis, so the input
      keeps at least <code>--_min-inline-size</code> (<code>8ch</code>). The
      full text stays in the field's accessible name.
    </p>

    <AutoExample name="Affix" column />

    <h3 id="top-and-bottom">Top and bottom</h3>

    <AutoExample name="TopAndBottom" column />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Read the <code>input</code> in a script.
      </Fragment>
      <Fragment slot="html">
        Read the <code>input</code> in a script.
      </Fragment>
      <Fragment slot="react">
        Give the input <code>value</code> and <code>onChange</code>.
      </Fragment>
      <Fragment slot="solid">
        Give the input <code>value</code> and <code>onInput</code>.
      </Fragment>
      <Fragment slot="svelte">
        Use <code>bind:value</code> on the input.
      </Fragment>
      <Fragment slot="vue">Use <code>v-model</code> on the input.</Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="input" own subject="Fields" />

    <AutoExample name="Validation" column spacious />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      input.
    </p>

    <AutoExample name="Spread" column spacious />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      <PropOrClass prop="autoFit" class=".ui-auto-fit" /> sizes the field to its
      content.
    </p>

    <AutoExample name="AutoFit" class="flex" />
  </section>

  <section id="input-types">
    <h2>Input types</h2>
    <AutoExample name="InputTypes" row>
      <UISwitch
        size="small"
        slot="controls"
        data-toggle-class="ui-filled"
        data-toggle-target=".ui-text-field"
        >Filled</UISwitch
      >
      <UISwitch
        size="small"
        slot="controls"
        data-toggle-class="ui-small"
        data-toggle-target=".ui-text-field"
        >Small</UISwitch
      >
    </AutoExample>

    <h3 id="numeric-vs-input-type-number">
      Numeric vs <code>&lt;input type="number"&gt;</code>
    </h3>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>inputmode="numeric"</code> and <code>pattern="[0-9]*"</code>.
      </Fragment>
      <Fragment slot="react">
        Use <code>inputMode="numeric"</code> and <code>pattern="[0-9]*"</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>inputmode="numeric"</code> and <code>pattern="[0-9]*"</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Numeric" />

    <div class="ui-not-rich-text">
      <UICallout severity="critical">
        <UICalloutIcon />
        <UICalloutContent>
          <h3>Use <code>&lt;input type="number"&gt;</code> only for amounts</h3>
          <div class="ui-rich-text">
            <p>
              <code>&lt;input type="number"&gt;</code> fits an amount you count
              or step, like a quantity, which the
              <DocLink class="ui-link" href="/components/number-field"
                >Number field</DocLink
              >
              covers. Card numbers, IDs and codes are text made of digits: use
              <code
                >&lt;input type="text" inputmode="numeric"
                pattern="[0-9]*"&gt;</code
              >
              for them.
            </p>

            <p>
              It brings up the numeric keyboard on touch screens without the
              problems of number inputs:
            </p>

            <ul>
              <li>Unexpected value increments from scroll wheels</li>
              <li>Browser-specific validation differences</li>
              <li>Accessibility problems</li>
              <li>Removal of leading zeros</li>
              <li>Acceptance of non-numeric characters, like <code>e</code></li>
            </ul>

            <p>
              GOV.UK explains these problems in
              <a
                href="https://technology.blog.gov.uk/2020/02/24/why-the-gov-uk-design-system-team-changed-the-input-type-for-numbers/"
                class="ui-link"
                >Why the GOV.UK Design System team changed the input type for
                numbers</a
              >.
            </p>
          </div>
        </UICalloutContent>
      </UICallout>
    </div>

    <h3 id="file">File</h3>

    <AutoExample name="File" row />

    <h3 id="drop-zone">Drop zone</h3>
    <p>
      Use <PropOrClass prop="dropZone" class=".ui-drop-zone" />. For files that
      upload as they're picked, use a
      <DocLink href="/components/file-upload">File upload</DocLink>.
    </p>

    <AutoExample name="DropZone" />
  </section>

  <section id="autosuggest">
    <h2>Autosuggest</h2>
    <p>Link a <code>&lt;datalist&gt;</code> with <code>list</code>.</p>

    <AutoExample name="Autosuggest" row />
  </section>

  <TextFieldBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        The label alone is the field's name, through
        <code>&lt;label for&gt;</code>. The affixes, the start text, end text
        and the top and bottom regions are its description once the input's
        <code>aria-describedby</code> points at them, so a unit, a hint or an
        error is read after the name in any language's word order, and buttons
        in the affixes stay out of the name.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy zoom={1.25}>
      <UITextField
        characterCount
        endText="Supporting text"
        for="text-field-anatomy"
        label="Label"
        passwordToggle
        startText="Start text"
      >
        <input
          aria-describedby="text-field-anatomy-start-text text-field-anatomy-top text-field-anatomy-start text-field-anatomy-bottom text-field-anatomy-end-text"
          id="text-field-anatomy"
          maxlength={24}
          placeholder="Placeholder"
          type="password"
          value="Value"
        />
        <span slot="top">Top</span>
        <span slot="start">€</span>
        <span slot="bottom">Bottom</span>
      </UITextField>
    </Anatomy>
  </Fragment>
</Component>
