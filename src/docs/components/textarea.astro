---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import FieldCSS from "@opui/css/components/field.css?raw"
import TextareaCSS from "@opui/css/components/textarea.css?raw"
import CharacterCountJS from "@opui/elements/character-count.js?raw"

import characterCountApi from "../../component-api/character-count/api"
import TextareaBuild from "../../components/UnderTheHood/TextareaBuild.astro"

export const description =
  "A multi-line text input in a Field that grows with its text, with a character count."

export const keywords = ["multiline", "text area"]
---

<Component
  description={description}
  base="field"
  slug="textarea"
  browserSupport={[
    "alt-text-generated-content",
    "attr",
    "container-queries",
    "field-sizing",
    "has",
    "lh",
    "reading-flow",
    "registered-custom-properties",
    "user-pseudos",
  ]}
  fallbacks={{
    attr: "Without typed `attr()`, a textarea is at least three lines tall, whatever `rows` says.",
    "reading-flow":
      "Without `reading-flow`, Tab and screen readers follow the markup, which puts the top and start parts before the control, as they're drawn. Hand-written HTML needs that order too.",
  }}
  apis={[{ title: "Character count API", api: characterCountApi }]}
  changelogPaths={[
    { path: "packages/opui/css/components/field.css", type: "css" },
    { path: "packages/opui/css/components/text-field.css", type: "css" },
    { path: "src/component-api/character-count", type: "api" },
  ]}
  installationTabs={[
    {
      title: "field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "textarea.css", code: TextareaCSS, lang: "css" },
    { title: "character-count.js", code: CharacterCountJS, lang: "js" },
  ]}
>
  <Fragment slot="title">Textarea</Fragment>
  <Fragment slot="preamble">
    Text over several lines, like a comment. For a single line, use a
    <DocLink href="/components/text-field">Text field</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Text over several lines, like a comment.</li>
    <li slot="when">Messages that <a href="#rows">grow as people type</a>.</li>
    <li slot="when-not">
      A single line: use a
      <DocLink href="/components/text-field">Text field</DocLink>.
    </li>
    <li slot="when-not">Formatted text: use a rich text editor.</li>
  </Usage>

  <section id="textarea">
    <h2>Textarea</h2>
    <p>
      A textarea is a <DocLink href="/components/field">Field</DocLink> with a
      <code>&lt;textarea&gt;</code> inside. Write it and wire its
      <code>aria-describedby</code> as the
      <DocLink href="/components/field#basics">Field</DocLink> page shows, with
      the variants, sizes, affixes, validation and layout every field shares.
    </p>
    <AutoExample name="Basics" column />
  </section>

  <section id="rows">
    <h2>Rows</h2>
    <p>
      A textarea starts three lines tall and grows with its text.
      <code>rows</code> sets the lines it starts at, so <code>rows="1"</code>
      makes a one-line field that grows, like a reply box.
    </p>

    <AutoExample name="Rows" column />
  </section>

  <section id="character-count">
    <h2>Character count</h2>
    <Conditional as="p">
      <Fragment slot="components">
        With <code>maxlength</code>, put a <code>CharacterCount</code> in
        <Conditional>
          <Fragment slot="components">the <code>end-text</code> slot</Fragment>
          <Fragment slot="react"><code>endText</code></Fragment>
          <Fragment slot="solid"><code>endText</code></Fragment>
          <Fragment slot="svelte">the <code>endText</code> snippet</Fragment>
        </Conditional
        >, and name the limit in the end text
        (<DocLink href="/components/field#character-count">Field</DocLink>).
      </Fragment>
      <Fragment slot="html">
        With <code>maxlength</code>, add
        <code>&lt;opui-character-count&gt;</code> to the end text, and name the
        limit there too
        (<DocLink href="/components/field#character-count">Field</DocLink>).
      </Fragment>
    </Conditional>
    <AutoExample name="CharacterCount" centered />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <p>
      A button can go in an affix, like a send button. Leave a part that only
      holds buttons out of the textarea's <code>aria-describedby</code>, as on
      the <DocLink href="/components/field#basics">Field</DocLink> page.
    </p>
    <AutoExample name="AffixButton" row />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Bind the textarea's <code>value</code>, as on the
        <DocLink href="/components/field#binding">Field</DocLink> page, instead
        of writing text inside it.
      </Fragment>
      <Fragment slot="react">
        Give the textarea <code>value</code> or <code>defaultValue</code>, as on
        the <DocLink href="/components/field#binding">Field</DocLink> page,
        instead of children.
      </Fragment>
      <Fragment slot="astro">
        The text inside the textarea is its default value. Read its
        <code>value</code> in a script
        (<DocLink href="/components/field#binding">Field</DocLink>).
      </Fragment>
      <Fragment slot="html">
        The text inside the textarea is its default value. Read its
        <code>value</code> in a script
        (<DocLink href="/components/field#binding">Field</DocLink>).
      </Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <TextareaBuild slot="under-the-hood" />
</Component>
