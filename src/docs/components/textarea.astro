---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Textarea as UITextarea } from "opui-css/astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import FieldCSS from "@opui/css/components/text-field.css?raw"
import TextareaCSS from "@opui/css/components/textarea.css?raw"

import textareaApi from "../../component-api/textarea/api"
import TextareaBuild from "../../components/UnderTheHood/TextareaBuild.astro"

export const description =
  "An input for multi-line text data. Basic textareas with labels, supporting text, and validation states."

export const keywords = ["multiline", "text area"]
---

<Component
  description={description}
  slug="textarea"
  browserSupport={[
    "container-queries",
    "field-sizing",
    "has",
    "lh",
    "user-pseudos",
  ]}
  heroAnatomy
  apis={[{ title: "Textarea API", api: textareaApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Textarea/Textarea.astro",
      type: "component",
    },
    { path: "src/docs/components/textarea.astro", type: "docs" },
    { path: "src/component-examples/textarea", type: "docs" },
    {
      path: "packages/opui/css/components/textarea.css",
      type: "css",
    },
    {
      path: "packages/opui/css/components/text-field.css",
      type: "css",
    },
    { path: "src/component-api/textarea", type: "api" },
    { path: "src/component-api/text-field", type: "api" },
  ]}
  installationTabs={[
    {
      title: "text-field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "textarea.css", code: TextareaCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Textarea</Fragment>

  <Usage slot="usage">
    <li slot="when">Text over several lines, like a comment.</li>
    <li slot="when">
      Messages that <a href="#auto-fit">grow as people type</a>.
    </li>
    <li slot="when-not">
      A single line: use a
      <DocLink href="/components/text-field">Text field</DocLink>.
    </li>
    <li slot="when-not">Formatted text: use a rich text editor.</li>
  </Usage>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      textarea.
    </p>
    <AutoExample name="Variants" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" row />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" />
  </section>

  <section id="start-text">
    <h2>Start text</h2>
    <p>Use <PropOrClass prop="startText" class=".ui-start-text" />.</p>
    <AutoExample name="StartText" row />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <AutoExample name="EndText" row />
  </section>

  <section id="character-count">
    <h2>Character count</h2>
    <Conditional as="p">
      <Fragment slot="components">
        With <code>maxlength</code>, set <code>characterCount</code>. Screen
        readers only hear the count near the limit, so name the limit in the end
        text.
      </Fragment>
      <Fragment slot="html">
        With <code>maxlength</code>, import
        <code>opui-css/elements/character-count.js</code>. Screen readers only
        hear the count near the limit, so name the limit in the end text.
      </Fragment>
    </Conditional>
    <AutoExample name="CharacterCount" centered />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>start</code>, <code>end</code>, <code>top</code> and
        <code>bottom</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-start</code>, <code>.ui-end</code>, <code>.ui-top</code>
        and <code>.ui-bottom</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Affix" row />

    <h3 id="top-and-bottom">Top and bottom</h3>

    <AutoExample name="TopAndBottom" column />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        No bound value: read the <code>textarea</code> in a script.
      </Fragment>
      <Fragment slot="html"
        >Read the <code>textarea</code> in a script.</Fragment
      >
      <Fragment slot="react">
        Use <code>value</code> and <code>onChange</code>.
      </Fragment>
      <Fragment slot="svelte">Use <code>bind:value</code>.</Fragment>
      <Fragment slot="vue">Use <code>v-model</code>.</Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="textarea" named subject="Fields" />

    <AutoExample name="Validation" />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      textarea.
    </p>

    <AutoExample name="Spread" column spacious />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      Grows from 3 to 20 lines by default.
      <PropOrClass prop="autoFit" class=".ui-auto-fit" /> also fits the width.
    </p>

    <AutoExample name="AutoFit" class="flex" />
  </section>

  <TextareaBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        Everything in the <code>&lt;label&gt;</code> is part of the name: keep
        start text, end text and affixes short.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UITextarea
        characterCount
        endText="Supporting text"
        label="Label"
        maxlength={160}
        placeholder="Placeholder"
        startText="Start text"
        style="inline-size: 20rem"
      >
        <span slot="top">Top</span>
        <span slot="start">€</span>
        <span slot="end">EUR</span>
        <span slot="bottom">Bottom</span>
      </UITextarea>
    </Anatomy>
  </Fragment>
</Component>
