---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import { Textarea as UITextarea } from "opui-css/astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import ValidationNotes from "./partials/ValidationNotes.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import FieldCSS from "@opui/css/components/text-field.css?raw"
import TextareaCSS from "@opui/css/components/textarea.css?raw"

import textareaApi from "../../component-api/textarea/api"
import TextareaBuild from "../../components/UnderTheHood/TextareaBuild.astro"

export const description =
  "A multi-line text input with a label, start and end text, and validation."

export const keywords = ["multiline", "text area"]
---

<Component
  description={description}
  slug="textarea"
  browserSupport={[
    "alt-text-generated-content",
    "attr",
    "container-queries",
    "field-sizing",
    "has",
    "lh",
    "reading-flow",
    "registered-custom-properties",
    "user-pseudos",
  ]}
  fallbacks={{
    attr: "Without typed `attr()`, a textarea is at least three lines tall, whatever `rows` says.",
    "reading-flow":
      "Without `reading-flow`, Tab and screen readers follow the markup, which puts the top and start parts before the control, as they're drawn. Hand-written HTML needs that order too.",
  }}
  heroAnatomy
  apis={[{ title: "Textarea API", api: textareaApi }]}
  changelogPaths={[
    { path: "packages/opui/css/components/text-field.css", type: "css" },
    { path: "src/component-api/text-field", type: "api" },
  ]}
  installationTabs={[
    {
      title: "text-field.css",
      code: FieldCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "textarea.css", code: TextareaCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Textarea</Fragment>
  <Fragment slot="preamble">
    Text over several lines, like a comment. For a single line, use a
    <DocLink href="/components/text-field">Text field</DocLink>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">Text over several lines, like a comment.</li>
    <li slot="when">
      Messages that <a href="#auto-fit">grow as people type</a>.
    </li>
    <li slot="when-not">
      A single line: use a
      <DocLink href="/components/text-field">Text field</DocLink>.
    </li>
    <li slot="when-not">Formatted text: use a rich text editor.</li>
  </Usage>

  <section id="textarea">
    <h2>Textarea</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Write the <code>&lt;textarea&gt;</code> inside the field, with its
        <code>id</code> set to <code>for</code>, and bind, name and validate it
        like any textarea. The types require <code>for</code>.
      </Fragment>
      <Fragment slot="react">
        Write the <code>&lt;textarea&gt;</code> inside the field, with its
        <code>id</code> set to <code>htmlFor</code>, and bind, name and validate
        it like any textarea. The types require <code>htmlFor</code>.
      </Fragment>
      <Fragment slot="html">
        Put the <code>&lt;textarea&gt;</code> directly in <code>.ui-field</code
        >, and point the <code>&lt;label for&gt;</code> at its <code>id</code>.
      </Fragment>
    </Conditional>
    <p>
      Each part the field shows has an id that starts with the textarea's:
      <code>x-start-text</code>, <code>x-top</code>, <code>x-start</code>,
      <code>x-end</code>, <code>x-bottom</code> and <code>x-end-text</code> for
      a textarea with <code>id="x"</code>. Point its
      <code>aria-describedby</code> at the ones it shows, in that order.
    </p>
  </section>

  <section id="variants">
    <h2>Variants</h2>
    <p>
      Outlined by default. Use
      <PropOrClass prop='variant="filled"' class=".ui-filled" /> for a filled
      textarea.
    </p>
    <AutoExample name="Variants" row />
  </section>

  <section id="sizes">
    <h2>Sizes</h2>
    <AutoExample name="Sizes" row />
  </section>

  <section id="hidden-label">
    <h2>Hidden label</h2>
    <p>
      <PropOrClass prop="hideLabel" class=".ui-sr-only" /> hides the label but
      keeps the accessible name.
    </p>
    <AutoExample name="HiddenLabel" />
  </section>

  <section id="start-text">
    <h2>Start text</h2>
    <p>Use <PropOrClass prop="startText" class=".ui-start-text" />.</p>
    <AutoExample name="StartText" row />
  </section>

  <section id="end-text">
    <h2>End text</h2>
    <AutoExample name="EndText" row />
  </section>

  <section id="character-count">
    <h2>Character count</h2>
    <Conditional as="p">
      <Fragment slot="components">
        With <code>maxlength</code>, set <code>characterCount</code>. Screen
        readers only hear the count near the limit, so name the limit in the end
        text.
      </Fragment>
      <Fragment slot="html">
        With <code>maxlength</code>, import
        <code>opui-css/elements/character-count.js</code>. Screen readers only
        hear the count near the limit, so name the limit in the end text.
      </Fragment>
    </Conditional>
    <AutoExample name="CharacterCount" centered />
  </section>

  <section id="affix">
    <h2>Affix</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use <code>start</code>, <code>end</code>, <code>top</code> and
        <code>bottom</code>.
      </Fragment>
      <Fragment slot="html">
        Use <code>.ui-start</code>, <code>.ui-end</code>, <code>.ui-top</code>
        and <code>.ui-bottom</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Affix" row />

    <h3 id="buttons">Buttons</h3>
    <p>
      A button can go in an affix, like a send button. The label alone names the
      field, and the button is read after it, with the other affixes.
    </p>
    <AutoExample name="AffixButton" row />

    <h3 id="top-and-bottom">Top and bottom</h3>

    <AutoExample name="TopAndBottom" column />
  </section>

  <section id="binding">
    <h2>Binding</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Read the <code>textarea</code> in a script.
      </Fragment>
      <Fragment slot="html"
        >Read the <code>textarea</code> in a script.</Fragment
      >
      <Fragment slot="react">
        Give the textarea <code>value</code> and <code>onChange</code>.
      </Fragment>
      <Fragment slot="solid">
        Give the textarea <code>value</code> and <code>onInput</code>.
      </Fragment>
      <Fragment slot="svelte">
        Use <code>bind:value</code> on the textarea.
      </Fragment>
      <Fragment slot="vue">Use <code>v-model</code> on the textarea.</Fragment>
    </Conditional>
    <AutoExample name="Binding" column />
  </section>

  <section id="validation">
    <h2>Validation</h2>
    <ValidationNotes element="textarea" own subject="Fields" />

    <AutoExample name="Validation" />
  </section>

  <section id="spread">
    <h2>Spread</h2>
    <p>
      <PropOrClass prop="spread" class=".ui-spread" /> puts the label beside the
      textarea.
    </p>

    <AutoExample name="Spread" column spacious />
  </section>

  <section id="rows">
    <h2>Rows</h2>
    <p>
      A textarea starts three lines tall and grows with its text.
      <code>rows</code> sets the lines it starts at, so <code>rows="1"</code>
      makes a one-line field that grows, like a reply box.
    </p>

    <AutoExample name="Rows" column />
  </section>

  <section id="auto-fit">
    <h2>Auto-fit</h2>
    <p>
      Grows from 3 lines, or the lines in <code>rows</code>, to 20 lines by
      default. <PropOrClass prop="autoFit" class=".ui-auto-fit" /> also fits the
      width.
    </p>

    <AutoExample name="AutoFit" class="flex" />
  </section>

  <TextareaBuild slot="under-the-hood" />

  <Fragment slot="accessibility">
    <ul>
      <li>
        The label alone is the field's name, through
        <code>&lt;label for&gt;</code>. The affixes, the start text, end text
        and the top and bottom regions are its description, through
        <code>aria-describedby</code>, so a unit, a hint or an error is read
        after the name in any language's word order, and buttons in the affixes
        stay out of the name.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy>
      <UITextarea
        characterCount
        endText="Supporting text"
        for="textarea-label"
        label="Label"
        startText="Start text"
        style="inline-size: 20rem"
      >
        <textarea
          aria-describedby="textarea-label-start-text textarea-label-top textarea-label-start textarea-label-end textarea-label-bottom textarea-label-end-text"
          id="textarea-label"
          maxlength={160}
          placeholder="Placeholder"
        ></textarea>
        <span slot="top">Top</span>
        <span slot="start">€</span>
        <span slot="end">EUR</span>
        <span slot="bottom">Bottom</span>
      </UITextarea>
    </Anatomy>
  </Fragment>
</Component>
