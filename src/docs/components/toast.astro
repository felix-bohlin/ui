---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import Anatomy from "../../components/Anatomy.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import ButtonCSS from "@opui/css/components/button.css?raw"
import CalloutCSS from "@opui/css/components/callout.css?raw"
import ToasterCSS from "@opui/css/components/toaster.css?raw"
import ToasterJS from "@opui/elements/toaster.js?raw"

import toastApi from "../../component-api/toast/api"

const anatomyApi = {
  ...toastApi,
  root: {
    ...toastApi.root,
    code: toastApi.root.selector,
    description:
      "The `<opui-toaster>` custom element, with `display: contents`. It adds each toast to the stack.",
    selector: ".ui-toaster",
  },
}

export const description =
  "Short messages that confirm an action and dismiss themselves."

export const keywords = ["notification", "snackbar"]
---

<Component
  description={description}
  slug="toast"
  heroAnatomy
  browserSupport={[
    "color-mix",
    "container-style-queries",
    "has",
    "interpolate-size",
    "invoker-commands",
    "lh",
    "light-dark",
    "overflow-clip",
    "popover",
    "relative-color",
    "scope",
    "starting-style",
  ]}
  apis={[{ title: "Toaster API", api: toastApi }]}
  changelogPaths={[
    {
      path: "packages/opui/components/Toaster/Toaster.astro",
      type: "component",
    },
    { path: "src/docs/components/toast.astro", type: "docs" },
    { path: "src/component-examples/toast", type: "docs" },
    { path: "packages/opui/css/components/toaster.css", type: "css" },
    { path: "packages/opui/elements/toaster.js", type: "component" },
    { path: "src/component-api/toast", type: "api" },
  ]}
  installationTabs={[
    { title: "toaster.css", code: ToasterCSS, lang: "css" },
    { title: "toaster.js", code: ToasterJS, lang: "js" },
    {
      title: "callout.css",
      code: CalloutCSS,
      lang: "css",
      isDependency: true,
    },
    { title: "button.css", code: ButtonCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Toast</Fragment>
  <Fragment slot="preamble">
    <p>
      Short messages that confirm an action and dismiss themselves. Each is a
      <DocLink href="/components/callout">Callout</DocLink>.
    </p>
  </Fragment>

  <Fragment slot="anatomy">
    <Anatomy api={anatomyApi}>
      <div class="ui-toaster" style="display: block; inline-size: 22rem">
        <ol
          popover="manual"
          style="
            display: flex;
            flex-direction: column;
            inline-size: auto;
            position: static;
          "
        >
          <li class="ui-callout ui-success">
            <svg aria-hidden="true" width="32" height="32"></svg>
            <div class="ui-content"><p>Changes saved</p></div>
            <button
              class="ui-button ui-round ui-small"
              type="button"
              aria-label="Close"
            >
              <svg aria-hidden="true" width="32" height="32"></svg>
            </button>
          </li>
          <li class="ui-callout ui-critical">
            <svg aria-hidden="true" width="32" height="32"></svg>
            <div class="ui-content"><p>Upload failed</p></div>
            <button class="ui-button ui-small" type="button">Retry</button>
            <button
              class="ui-button ui-round ui-small"
              type="button"
              aria-label="Close"
            >
              <svg aria-hidden="true" width="32" height="32"></svg>
            </button>
          </li>
        </ol>
        <div
          class="ui-sr-only"
          role="status"
          style="
            block-size: auto;
            clip-path: none;
            inline-size: auto;
            position: static;
          "
        >
          <p>Changes saved</p>
        </div>
        <div
          class="ui-sr-only"
          role="alert"
          style="
            block-size: auto;
            clip-path: none;
            inline-size: auto;
            position: static;
          "
        >
          <p>Upload failed</p>
        </div>
      </div>
    </Anatomy>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Confirming an action, like <a href="#basics">saved changes</a>.
    </li>
    <li slot="when">
      A notice that needs no answer, like a <a href="#severities">new version</a
      >.
    </li>
    <li slot="when-not">
      Messages people must act on: use a
      <DocLink href="/components/callout">Callout</DocLink>.
    </li>
    <li slot="when-not">
      Copying to the clipboard: <DocLink href="/components/copy">Copy</DocLink>
      announces its own.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Point a button at the <code>Toaster</code> with
        <code>command="--toast"</code> and <code>data-toast</code>.
      </Fragment>
      <Fragment slot="html">
        Point a button at <code>opui-toaster</code> with
        <code>command="--toast"</code>, and import
        <code>opui-css/elements/toaster.js</code>.
      </Fragment>
    </Conditional>
    <AutoExample name="Basics" row />
  </section>

  <section id="severities">
    <h2>Severities</h2>
    <p>Use <code>data-toast-severity</code>.</p>
    <AutoExample name="Severities" row />
  </section>

  <section id="icons">
    <h2>Icons</h2>
    <p>
      Set <code>--_info-image</code> and the other icon properties on the
      toaster. Translate the close button with
      <PropOrClass prop="closeLabel" class="close-label" />.
    </p>
  </section>

  <section id="from-a-script">
    <h2>From a script</h2>
    <p>
      Call <code>toast(message, options)</code>, or
      <code>toast.success(message)</code> for a severity.
    </p>
    <AutoExample name="Script" row />
  </section>

  <section id="action">
    <h2>Action</h2>
    <p>
      Pass <code>action</code> with a <code>label</code> and an
      <code>onClick</code>. Never the only way to do something.
    </p>
    <AutoExample name="Action" row />
  </section>

  <section id="position">
    <h2>Position</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Bottom end by default. Use <code>side</code> and <code>align</code> to
        change it.
      </Fragment>
      <Fragment slot="html">
        Bottom end by default. Use <code>.ui-block-start</code> and
        <code>.ui-align-start</code> or <code>.ui-align-center</code> to change
        it.
      </Fragment>
    </Conditional>
    <AutoExample name="Position" column />
  </section>

  <section id="duration">
    <h2>Duration</h2>
    <p>
      5 seconds by default, 10 with an action. Use <code>duration</code> to
      change it.
    </p>
    <AutoExample name="Duration" row />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Put the toaster near the content it confirms, or at the end of the page.
      </li>
      <li>
        Give a modal <DocLink href="/components/dialog">Dialog</DocLink> or
        <DocLink href="/components/drawer">Drawer</DocLink> that shows toasts a
        toaster of its own, since the page behind it is inert.
        <code>toast()</code> uses it while the dialog is open.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>
</Component>
