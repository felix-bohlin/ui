---
import Component from "../../layouts/Component.astro"
import Anatomy from "../../components/Anatomy.astro"
import {
  ToggleButton as UIToggleButton,
  ToggleGroup as UIToggleGroup,
} from "@opui/astro"
import AutoExample from "../../components/AutoExample.astro"
import ToggleGroupCSS from "@opui/css/components/toggle-group.css?raw"
import ToggleButtonCSS from "@opui/css/components/toggle-button.css?raw"
import Conditional from "../../components/Conditional.astro"

import toggleButtonApi from "../../component-api/toggle-button/api"
import toggleGroupApi from "../../component-api/toggle-group/api"
import ToggleBuild from "../../components/UnderTheHood/ToggleBuild.astro"
export const description =
  "Toggle buttons and toggle groups switch options on and off, alone or as a set."
---

<Component
  description={description}
  slug="toggle"
  heroAnatomy
  apis={[
    { title: "Toggle group API", api: toggleGroupApi },
    { title: "Toggle button API", api: toggleButtonApi },
  ]}
  browserSupport={["color-mix", "has", "light-dark", "relative-color"]}
  changelogPaths={[
    {
      path: "packages/opui/components/ToggleButton/ToggleButton.astro",
      type: "component",
    },
    {
      path: "packages/opui/components/ToggleGroup/ToggleGroup.astro",
      type: "component",
    },
    { path: "src/docs/components/toggle.astro", type: "docs" },
    { path: "src/component-examples/toggle", type: "docs" },
    {
      path: "packages/opui/css/components/toggle-button.css",
      type: "css",
    },
    {
      path: "packages/opui/css/components/toggle-group.css",
      type: "css",
    },
    { path: "src/component-api/toggle", type: "api" },
  ]}
  installationTabs={[
    {
      title: "toggle-group.css",
      code: ToggleGroupCSS,
      lang: "css",
    },
    {
      title: "toggle-button.css",
      code: ToggleButtonCSS,
      lang: "css",
    },
  ]}
>
  <Fragment slot="title">Toggle</Fragment>
  <Fragment slot="preamble"
    >Buttons (disguised as input checkbox/radio) that can be toggled on and off.
  </Fragment>

  <section>
    <h2 id="toggle-button">Toggle button</h2>
    <AutoExample name="Standalone" centered />
  </section>

  <section>
    <h2 id="toggle-group">Toggle group</h2>
    <Conditional as="p">
      <Fragment slot="astro">
        Group toggle buttons by wrapping them in a <code>ToggleGroup</code> component.
      </Fragment>
      <Fragment slot="html">
        Group toggle buttons by wrapping them in a <code
          >&lt;div role="radiogroup" class="ui-toggle-group"&gt;</code
        > (or <code>role="group"</code> when multi-select).
      </Fragment>
      <Fragment slot="vue">
        Group toggle buttons by wrapping them in a <code>ToggleGroup</code> component.
      </Fragment>
    </Conditional>

    <h3 id="multi-select">Multi-select</h3>
    <Conditional>
      <p slot="html">
        Use <code>type="checkbox"</code> for multi-select groups.
      </p>
      <p slot="astro">
        Use <code>selection="multiple"</code> for multi-select groups.
      </p>
      <p slot="vue">
        Use <code>selection="multiple"</code> for multi-select groups.
      </p>
    </Conditional>

    <AutoExample name="MultiSelect" centered />

    <h3 id="single-select">Single-select</h3>
    <Conditional>
      <p slot="html">Use <code>type="radio"</code> for single-select groups.</p>
      <p slot="astro">
        Use <code>selection="single"</code> for single-select groups.
      </p>
      <p slot="vue">
        Use <code>selection="single"</code> for single-select groups.
      </p>
    </Conditional>

    <AutoExample name="Alignment" centered />

    <h3 id="text-icon">Text + icon</h3>

    <AutoExample name="Interactive" centered />

    <h3 id="vertical-orientation">Vertical orientation</h3>
    <Conditional>
      <p slot="astro">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </p>
      <p slot="html">
        Change the layout of the group with the <code>.ui-vertical</code> class.
      </p>
      <p slot="vue">
        Change the layout of the group with the <code
          >orientation="vertical"</code
        > prop.
      </p>
    </Conditional>
    <AutoExample name="Vertical" centered />

    <h3 id="sizes">Sizes</h3>
    <p>
      Choose between four sizes: <code>.ui-x-small</code>, <code>.ui-small</code
      >, default and <code>.ui-large</code>.
    </p>

    <AutoExample name="Sizes" centered row />

    <h3 id="overflow">Overflow</h3>
    <Conditional as="p">
      <Fragment slot="astro">
        Toggle buttons in a group wrap onto more rows when they don't fit. Use <code
          >scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
      <Fragment slot="html">
        Toggle buttons in a group wrap onto more rows when they don't fit. Add <code
          >.ui-scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >.ui-shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
      <Fragment slot="vue">
        Toggle buttons in a group wrap onto more rows when they don't fit. Use <code
          >scrollable</code
        > to keep them on one row and scroll them sideways, or <code
          >shrink</code
        > to keep them on one row and truncate their labels. Icon-only items keep
        their size.
      </Fragment>
    </Conditional>
    <AutoExample name="Overflow" />
  </section>

  <ToggleBuild slot="under-the-hood" />

  <Fragment slot="anatomy">
    <Anatomy api={toggleGroupApi} zoom={1.25}>
      <UIToggleGroup name="toggle-anatomy" selection="single">
        <UIToggleButton pressed type="radio">Day</UIToggleButton>
        <UIToggleButton type="radio">Week</UIToggleButton>
        <UIToggleButton type="radio">Month</UIToggleButton>
      </UIToggleGroup>
    </Anatomy>
  </Fragment>
</Component>

<style is:global>
  .ui-toggle-group
    .ui-toggle-button:has(input:checked).has-text
    svg:nth-of-type(2) {
    display: none;
  }
</style>
