---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"
import TooltipCSS from "@opui/css/components/tooltip.css?raw"

import tooltipApi from "../../component-api/tooltip/api"
import TooltipBuild from "../../components/UnderTheHood/TooltipBuild.astro"
---

<Component
  description="Built on top of Anchor."
  slug="tooltip"
  apis={[{ title: "Tooltip API", api: tooltipApi }]}
  browserSupport={[
    "anchor-positioning",
    "calc-size",
    "container-style-queries",
    "display-animation",
    "interest-invokers",
    "invoker-commands",
    "overlay",
    "popover",
    "popover-hint",
    "starting-style",
    "text-wrap-pretty",
    "transition-behavior",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Tooltip/Tooltip.astro",
      type: "component",
    },
    { path: "src/docs/components/tooltip.astro", type: "docs" },
    { path: "src/component-examples/tooltip", type: "docs" },
    {
      path: "packages/opui/css/components/tooltip.css",
      type: "css",
    },
    { path: "src/component-api/tooltip", type: "api" },
  ]}
  installationTabs={[
    { title: "tooltip.css", code: TooltipCSS, lang: "css" },
    { title: "anchor.css", code: AnchorCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Tooltip</Fragment>
  <Fragment slot="preamble">
    <p>
      Built on top of <DocLink href="/components/anchor">Anchor</DocLink>.
    </p>
    <Conditional as="p">
      <Fragment slot="components">
        Wrap the trigger in <code>&lt;Tooltip&gt;</code> and pass a stable{" "}
        <code>id</code>. Set <code>interestfor</code> with that id on the trigger
        element itself (it only works on real invokers like{" "}
        <code>&lt;button&gt;</code> or <code>&lt;a&gt;</code>). Put the tooltip
        in
        <code>TooltipContent</code> after the trigger.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-tooltip</code> class to the wrapper. Give the <code
          >.ui-floating</code
        > element <code>popover="hint"</code> and an id, and add <code
          >interestfor</code
        > with that id to the trigger.
      </Fragment>
    </Conditional>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      A visible label for an icon-only button that already has an <code
        >aria-label</code
      >, like Save.
    </li>
    <li slot="when">A hint or a keyboard shortcut for a control.</li>
    <li slot="when-not">
      Information people need to finish their task. The tooltip only shows on
      hover, focus or a long press, so put it on the page, or in a <a
        href="#toggletip">toggletip</a
      >.
    </li>
    <li slot="when-not">
      Links, buttons or other interactive content. Use an <DocLink
        href="/components/anchor#hover-trigger">Anchor</DocLink
      > hover card or a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
  </Usage>

  <section>
    <h2 id="basics">Basics</h2>
    <h3 id="text-only">Text only...</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Put plain text in <code>TooltipContent</code>.
      </Fragment>
      <Fragment slot="html">
        Set the tooltip text inside <code>.ui-floating[popover="hint"]</code>.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" centered />

    <h3 id="anything">... or any markup you want</h3>
    <Conditional as="p">
      <Fragment slot="components">
        <code>TooltipContent</code> takes any markup, not only text.
      </Fragment>
      <Fragment slot="html">
        You can place any markup you want (famous last words) inside <code
          >.ui-floating[popover="hint"]</code
        >, not only text.
      </Fragment>
    </Conditional>

    <AutoExample name="RichContent" centered />
  </section>

  <section>
    <h2 id="position">Position</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>positionArea</code> to any <code>position-area</code> value.
      </Fragment>
      <Fragment slot="html">
        Set <code>--ui-anchor-position-area</code> on the parent with your preferred
        {" "}<code>position-area</code> value.
      </Fragment>
    </Conditional>

    <AutoExample name="Position" row spacious />
  </section>

  <section>
    <h2 id="arrow">Arrow</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set the <code>arrow</code> prop. This would be cool to solve with <code
          >corner-shape</code
        >
        {" "}one day.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-arrow</code> class on the <code>.ui-tooltip</code>.
        This would be cool to solve with <code>corner-shape</code> one day.
      </Fragment>
    </Conditional>

    <AutoExample name="Arrow" centered />
  </section>

  <section>
    <h2 id="toggletip">Toggletip</h2>
    <p>
      A button whose only job is to show the text, like an info button, can
      toggle the tooltip on a press. Add <code>commandfor</code> and <code
        >command="toggle-popover"</code
      > with the tooltip's id next to <code>interestfor</code>, so a tap or a
      click opens it in every browser with Invoker Commands, touch screens
      without interest invokers included. Keep them off buttons that act, like
      Save: a press would run the action and toggle the tooltip at once.
    </p>

    <AutoExample name="Toggletip" centered />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Chromium exposes the tooltip text as the trigger's description, but only
        while the tooltip is shown. Put what the user must know in the trigger's
        own name, like an <code>aria-label</code> on an icon-only button.
      </li>
      <li>
        On a <a href="#toggletip">toggletip</a>, <code>commandfor</code> ties the
        button to the tooltip, so Chromium also reports it as collapsed or expanded.
      </li>
      <li>
        In browsers without interest invokers, the compat layer shows the
        tooltip while its trigger is hovered or has keyboard focus. It isn't in
        the top layer there, so an ancestor that clips its overflow can hide it,
        and <kbd>Esc</kbd> doesn't close it.
      </li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <TooltipBuild slot="under-the-hood" />
</Component>
