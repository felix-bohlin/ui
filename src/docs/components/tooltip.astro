---
import Component from "../../layouts/Component.astro"
import KeyboardSupport from "./partials/KeyboardSupport.astro"
import Usage from "./partials/Usage.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"
import PropOrClass from "../../components/PropOrClass.astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"
import TooltipCSS from "@opui/css/components/tooltip.css?raw"

import tooltipApi from "../../component-api/tooltip/api"
import TooltipBuild from "../../components/UnderTheHood/TooltipBuild.astro"

export const description =
  "A short label or hint for a control, shown on hover, focus or a long press."

export const keywords = ["hint", "hover", "title", "toggletip"]
---

<Component
  description={description}
  slug="tooltip"
  apis={[{ title: "Tooltip API", api: tooltipApi }]}
  browserSupport={[
    "anchor-positioning",
    "calc-size",
    "container-style-queries",
    "display-animation",
    "interest-invokers",
    "invoker-commands",
    "overlay",
    "popover",
    "popover-hint",
    "starting-style",
    "text-wrap-pretty",
    "transition-behavior",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Tooltip/Tooltip.astro",
      type: "component",
    },
    { path: "src/docs/components/tooltip.astro", type: "docs" },
    { path: "src/component-examples/tooltip", type: "docs" },
    {
      path: "packages/opui/css/components/tooltip.css",
      type: "css",
    },
    { path: "src/component-api/tooltip", type: "api" },
  ]}
  installationTabs={[
    { title: "tooltip.css", code: TooltipCSS, lang: "css" },
    { title: "anchor.css", code: AnchorCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Tooltip</Fragment>
  <Fragment slot="preamble">
    <p>
      A short hint on hover, focus or long press, positioned with
      <DocLink href="/components/anchor">Anchor</DocLink>.
    </p>
    <Conditional as="p">
      <Fragment slot="components">
        Set <code>interestfor</code> on the trigger to the tooltip's
        <code>id</code>.
      </Fragment>
      <Fragment slot="html">
        Set <code>interestfor</code> on the trigger to the
        <code>popover="hint"</code>'s id.
      </Fragment>
    </Conditional>
  </Fragment>

  <Usage slot="usage">
    <li slot="when">A visible label for an icon-only button.</li>
    <li slot="when">A hint or a keyboard shortcut.</li>
    <li slot="when-not">
      Information needed to finish a task: put it on the page, or in a
      <a href="#toggletip">toggletip</a>.
    </li>
    <li slot="when-not">
      Interactive content: use an
      <DocLink href="/components/anchor#hover-trigger">Anchor</DocLink> hover
      card or a <DocLink href="/components/menu">Menu</DocLink>.
    </li>
  </Usage>

  <section id="basics">
    <h2>Basics</h2>
    <h3 id="text-only">Text</h3>

    <AutoExample name="Basics" centered />

    <h3 id="rich-content">Rich content</h3>

    <AutoExample name="RichContent" centered />
  </section>

  <section id="position">
    <h2>Position</h2>
    <p>
      Use <PropOrClass prop="positionArea" class="--ui-anchor-position-area" />.
    </p>

    <AutoExample name="Position" row spacious />
  </section>

  <section id="arrow">
    <h2>Arrow</h2>
    <p>Use <PropOrClass prop="arrow" class=".ui-arrow" />.</p>

    <AutoExample name="Arrow" centered />
  </section>

  <section id="toggletip">
    <h2>Toggletip</h2>
    <p>
      Add <code>command="toggle-popover"</code> to open it on a press. Only on
      buttons that do nothing else.
    </p>

    <AutoExample name="Toggletip" centered />
  </section>

  <Fragment slot="accessibility">
    <ul>
      <li>
        Point the trigger at the tooltip with <code>aria-describedby</code>.
      </li>
      <li>Put what the user must know in the trigger's own name.</li>
    </ul>
    <KeyboardSupport />
  </Fragment>

  <TooltipBuild slot="under-the-hood" />
</Component>
