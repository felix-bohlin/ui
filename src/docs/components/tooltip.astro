---
import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import AutoExample from "../../components/AutoExample.astro"
import Conditional from "../../components/Conditional.astro"

import AnchorCSS from "@opui/css/components/anchor.css?raw"
import TooltipCSS from "@opui/css/components/tooltip.css?raw"

import tooltipApi from "../../component-api/tooltip/api"
import TooltipBuild from "../../components/UnderTheHood/TooltipBuild.astro"
---

<Component
  description="Built on top of Anchor."
  slug="tooltip"
  apis={[{ title: "Tooltip API", api: tooltipApi }]}
  browserSupport={[
    "anchor-positioning",
    "calc-size",
    "container-style-queries",
    "display-animation",
    "interest-invokers",
    "invoker-commands",
    "overlay",
    "popover",
    "popover-hint",
    "starting-style",
    "text-wrap-pretty",
    "transition-behavior",
  ]}
  changelogPaths={[
    {
      path: "packages/opui/components/Tooltip/Tooltip.astro",
      type: "component",
    },
    { path: "src/docs/components/tooltip.astro", type: "docs" },
    { path: "src/component-examples/tooltip", type: "docs" },
    {
      path: "packages/opui/css/components/tooltip.css",
      type: "css",
    },
    { path: "src/component-api/tooltip", type: "api" },
  ]}
  installationTabs={[
    { title: "tooltip.css", code: TooltipCSS, lang: "css" },
    { title: "anchor.css", code: AnchorCSS, lang: "css", isDependency: true },
  ]}
>
  <Fragment slot="title">Tooltip</Fragment>
  <Fragment slot="preamble">
    <p>
      Built on top of <DocLink href="/components/anchor">Anchor</DocLink>.
    </p>
    <Conditional as="p">
      <Fragment slot="components">
        Wrap the trigger in <code>&lt;Tooltip&gt;</code> and pass a stable{" "}
        <code>id</code>. Set <code>interestfor</code>, <code>commandfor</code>,
        and <code>command="toggle-popover"</code> on the trigger element itself (these
        attributes are only valid on real invokers like{" "}
        <code>&lt;button&gt;</code> or <code>&lt;a&gt;</code>). Put the tooltip
        in
        <code>TooltipContent</code> after the trigger.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-tooltip</code> class alongside <code>.ui-anchor</code> on
        the wrapper. Give the <code>.ui-anchor-floating</code> element <code
          >popover="hint"</code
        > and an id. Add <code>interestfor</code>, plus <code>commandfor</code> and
        {" "}<code>command="toggle-popover"</code> for touch, with that id to the
        trigger.
      </Fragment>
    </Conditional>
  </Fragment>

  <section>
    <h2 id="basics">Basics</h2>
    <h3 id="text-only">Text only...</h3>
    <Conditional as="p">
      <Fragment slot="components">
        Put plain text in <code>TooltipContent</code>.
      </Fragment>
      <Fragment slot="html">
        Set the tooltip text inside <code
          >.ui-anchor-floating[popover="hint"]</code
        >.
      </Fragment>
    </Conditional>

    <AutoExample name="Basics" centered />

    <h3 id="anything">... or any markup you want</h3>
    <Conditional as="p">
      <Fragment slot="components">
        <code>TooltipContent</code> takes any markup, not only text.
      </Fragment>
      <Fragment slot="html">
        You can place any markup you want (famous last words) inside <code
          >.ui-anchor-floating[popover="hint"]</code
        >, not only text.
      </Fragment>
    </Conditional>

    <AutoExample name="RichContent" centered />
  </section>

  <section>
    <h2 id="alignment">Alignment</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Use the <code>alignment</code> prop.
      </Fragment>
      <Fragment slot="html">
        Set <code>--ui-anchor-position-area</code> on the parent with your preferred
        {" "}<code>position-area</code> value.
      </Fragment>
    </Conditional>

    <AutoExample name="Alignment" row spacious />
  </section>

  <section>
    <h2 id="arrow">Arrow</h2>
    <Conditional as="p">
      <Fragment slot="components">
        Set the <code>arrow</code> prop. This would be cool to solve with <code
          >corner-shape</code
        >
        {" "}one day.
      </Fragment>
      <Fragment slot="html">
        Add the <code>.ui-with-arrow</code> class on the <code>.ui-tooltip</code
        >. This would be cool to solve with <code>corner-shape</code> one day.
      </Fragment>
    </Conditional>

    <AutoExample name="Arrow" centered />
  </section>

  <TooltipBuild slot="under-the-hood" />
</Component>
