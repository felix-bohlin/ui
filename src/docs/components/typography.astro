---
import Code from "../../components/Code.astro"

import Component from "../../layouts/Component.astro"
import DocLink from "../../components/DocLink.astro"
import Usage from "./partials/Usage.astro"
import AutoExample from "../../components/AutoExample.astro"
import FluidTypeBuild from "../../components/UnderTheHood/FluidTypeBuild.astro"
import RhythmBuild from "../../components/UnderTheHood/RhythmBuild.astro"
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"

import LinkCSS from "@opui/css/components/link.css?raw"
import TypographyCSS from "@opui/css/components/typography.css?raw"

import typographyApi from "../../component-api/typography/api"

export const keywords = ["font", "heading", "prose", "text"]
---

<Component
  slug="typography"
  browserSupport={[
    "attr",
    "box-decoration-break",
    "container-style-queries",
    "exp-functions",
    "has",
    "light-dark",
    "marker",
    "progress-function",
    "registered-custom-properties",
    "relative-color",
    "round-mod-rem",
    "scope",
    "scrollbar-width",
    "text-wrap-pretty",
  ]}
  apis={[{ title: "Typography API", api: typographyApi }]}
  changelogPaths={[
    { path: "src/docs/components/typography.astro", type: "docs" },
    { path: "src/component-examples/typography", type: "docs" },
    {
      path: "packages/opui/css/components/typography.css",
      type: "css",
    },
    { path: "src/component-api/typography", type: "api" },
  ]}
  installationTabs={[
    { title: "typography.css", code: TypographyCSS, lang: "css" },
    { title: "link.css", code: LinkCSS, lang: "css" },
  ]}
>
  <Fragment slot="title">Typography</Fragment>
  <Fragment slot="preamble">
    Styles for headings, body text, and other text content. Use util classes
    anywhere or wrap content in <code>.ui-rich-text</code>.
  </Fragment>

  <Usage slot="usage">
    <li slot="when">
      Text that you can't add classes to, like rich text from a CMS, in <a
        href="#classless"><code>.ui-rich-text</code></a
      >.
    </li>
    <li slot="when">
      Text styles on elements in your own markup, with the <a
        href="#class-based">classes</a
      >, like <code>.ui-link</code>.
    </li>
    <li slot="when-not">
      Picking a heading level for its size. Use the level the outline needs, and
      a class like <code>.ui-h4</code> for the size.
    </li>
    <li slot="when-not">
      Spacing components. Rich text spaces text elements, so lay out components
      with the <DocLink href="/components/layout">Layout</DocLink> classes.
    </li>
  </Usage>

  <section id="class-based">
    <h2>Class-based</h2>
    <p>Utils that you can plop down wherever.</p>

    <h3 id="variants">Variants</h3>
    <AutoExample name="Variants" column />

    <h3 id="heading-group">Heading group</h3>
    <AutoExample name="HeadingGroupClass" column />

    <h3 id="blockquote">Blockquote</h3>
    <AutoExample name="Blockquote" />

    <h3 id="link">Link</h3>
    <p>
      Use <code>.ui-link</code> for links outside <code>.ui-rich-text</code>.
      Inside rich text, links get the same style without a class. On hover and
      focus the underline gets thicker, and the color darkens in light mode and
      lightens in dark mode.
    </p>
    <AutoExample name="Link" />

    <h3 id="code-block">Code block</h3>
    <AutoExample name="CodeBlock" column />

    <h3 id="icon">Icon</h3>
    <p>
      <code>.ui-icon</code> sizes an <code>svg</code> to <code
        >--ui-icon-size</code
      >
      and keeps it from shrinking next to text. <code>.ui-small</code> and <code
        >.ui-large</code
      > read <code>--ui-icon-size-small</code> and <code
        >--ui-icon-size-large</code
      >. Components size the icons they own, so the class is for icons in your
      own markup.
    </p>
    <AutoExample name="Icon" />

    <h3 id="swatch">Swatch</h3>
    <p>
      <code>.ui-swatch</code> is a small dot for a color legend. A severity class
      on it, such as <code>.ui-info</code>, paints it in that tone, and <code
        >--_swatch-bg-color</code
      > takes any other color. A status with a name is a <code>Chip</code> with a
      dot instead.
    </p>
    <AutoExample name="Swatch" />

    <h3 id="severity">Severity</h3>
    <p>
      The same severity class on <code>.ui-p</code>, <code>.ui-caption</code> or <code
        >.ui-overline</code
      > colors the text in that tone, for a change next to a stat or a "Verified"
      next to an email. The tone alone carries no meaning, so say it in words too.
    </p>
    <AutoExample name="Severity" />

    <h3 id="tabular-numbers">Tabular numbers</h3>
    <p>
      <code>.ui-tabular-nums</code> gives every digit the same width, so prices and
      stats line up in a column and a counter doesn't shift as it ticks.
    </p>
    <AutoExample name="TabularNumbers" />
  </section>

  <section id="inline-text-elements">
    <h2>Inline text elements</h2>
    <div class="ui-not-rich-text">
      <Table>
        <TableHead>
          <TableRow>
            <TableHeaderCell>Result</TableHeaderCell>
            <TableHeaderCell>Element</TableHeaderCell>
            <TableHeaderCell>Class</TableHeaderCell>
          </TableRow>
        </TableHead>
        <TableBody>
          <TableRow>
            <TableCell><a class="ui-link" href="#link">Link</a></TableCell>
            <TableCell><code>&lt;a href&gt;</code></TableCell>
            <TableCell><code>.ui-link</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell
              ><abbr class="ui-abbr" title="Abbreviation">Abbr.</abbr
              ></TableCell
            >
            <TableCell><code>&lt;abbr&gt;</code></TableCell>
            <TableCell><code>.ui-abbr</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><strong>Bold</strong></TableCell>
            <TableCell
              ><code>&lt;b&gt;</code>, <code>&lt;strong&gt;</code></TableCell
            >
            <TableCell>None</TableCell>
          </TableRow>
          <TableRow>
            <TableCell><cite class="ui-cite">Citation</cite></TableCell>
            <TableCell><code>&lt;cite&gt;</code></TableCell>
            <TableCell><code>.ui-cite</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><del class="ui-del">Deleted</del></TableCell>
            <TableCell><code>&lt;del&gt;</code></TableCell>
            <TableCell><code>.ui-del</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell
              ><dfn class="ui-dfn" title="Title">Definition</dfn></TableCell
            >
            <TableCell><code>&lt;dfn&gt;</code></TableCell>
            <TableCell><code>.ui-dfn</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><i>Italic</i></TableCell>
            <TableCell
              ><code>&lt;em&gt;</code>, <code>&lt;i&gt;</code></TableCell
            >
            <TableCell>None</TableCell>
          </TableRow>
          <TableRow>
            <TableCell><ins class="ui-ins">Inserted</ins></TableCell>
            <TableCell><code>&lt;ins&gt;</code></TableCell>
            <TableCell><code>.ui-ins</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><kbd class="ui-kbd">Ctrl + S</kbd></TableCell>
            <TableCell><code>&lt;kbd&gt;</code></TableCell>
            <TableCell><code>.ui-kbd</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><mark class="ui-mark">Highlight</mark></TableCell>
            <TableCell><code>&lt;mark&gt;</code></TableCell>
            <TableCell><code>.ui-mark</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><s class="ui-s">Strikethrough</s></TableCell>
            <TableCell><code>&lt;s&gt;</code></TableCell>
            <TableCell><code>.ui-s</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><samp class="ui-samp">sample output</samp></TableCell>
            <TableCell><code>&lt;samp&gt;</code></TableCell>
            <TableCell><code>.ui-samp</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><small class="ui-small">Small</small></TableCell>
            <TableCell><code>&lt;small&gt;</code></TableCell>
            <TableCell><code>.ui-small</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell>Text <sub class="ui-sub">Sub</sub></TableCell>
            <TableCell><code>&lt;sub&gt;</code></TableCell>
            <TableCell><code>.ui-sub</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell>Text <sup class="ui-sup">Sup</sup></TableCell>
            <TableCell><code>&lt;sup&gt;</code></TableCell>
            <TableCell><code>.ui-sup</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><u class="ui-u">Underline</u></TableCell>
            <TableCell><code>&lt;u&gt;</code></TableCell>
            <TableCell><code>.ui-u</code></TableCell>
          </TableRow>
          <TableRow>
            <TableCell><var class="ui-var">variable</var></TableCell>
            <TableCell><code>&lt;var&gt;</code></TableCell>
            <TableCell><code>.ui-var</code></TableCell>
          </TableRow>
        </TableBody>
      </Table>
    </div>
  </section>

  <section id="classless">
    <h2>Classless</h2>
    <p>
      Wrap your code in <code>.ui-rich-text</code> to add typographic styles to its
      children. It's extra handy when you can't control the contents yourself, like
      printing text from a CMS.
    </p>
    <p>
      Headings, lists and tables with a class keep their own styles, and
      components look the same inside rich text as outside it. Wrap a part in
      {" "}<code>.ui-not-rich-text</code> to end the rich text styles there.
    </p>
    <Code
      lang="html"
      code={`<article class="ui-rich-text">\n  <h2>Styled</h2>\n  <div class="ui-not-rich-text"><!-- not styled --></div>\n</article>`}
    />

    <h3 id="rich-text-showcase">Classless showcase</h3>
    <p>
      Let's put everything together and see how all elements look in a
      classless, rich-text context. It's plain HTML on every framework page, the
      way rich text arrives from a CMS.
    </p>
    <AutoExample name="Default" />
  </section>
  <Fragment slot="under-the-hood">
    <RhythmBuild />
    <FluidTypeBuild />
  </Fragment>
</Component>
