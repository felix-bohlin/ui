---
import Guide from "../../../layouts/Guide.astro"
import Code from "../../../components/Code.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    OPUI ships first-class Astro components. Install the package, import what
    you need, and you're set.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Fragment slot="install">
        <InstallCommand packages="astro@7" />
        <Code
          code={`---
// src/layouts/Layout.astro
import "opui-css/css/imports.css"
---`}
          lang="astro"
        />
      </Fragment>
      <Code
        slot="use"
        code={`---
import { Button } from "opui-css/astro"
---

<Button color="primary" variant="filled">Save</Button>`}
        lang="astro"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="css">
    <h2>Import only what you use</h2>
    <p>
      List the files in a CSS file, and import that file in the layout instead
      of <code>imports.css</code>:
    </p>
    <PickAndChoose file="src/styles/global.css" />
    <Code
      code={`---
// src/layouts/Layout.astro
import "../styles/global.css"
---`}
      lang="astro"
    />
  </section>

  <section id="usage">
    <h2>How to use</h2>
    <p>
      Containers take parts, such as <code>CardHeader</code> and
      <code>DialogFooter</code>. Other components take named slots for rich
      content, such as <code>end-text</code> on a <code>TextField</code>.
    </p>
  </section>

  <section id="server-runtime">
    <h2>Server runtime</h2>
    <p>
      The components pass settings to their parts with
      <code>AsyncLocalStorage</code> from <code>node:async_hooks</code>, so they
      run on Node, Deno and Bun. On Cloudflare, enable the
      <code>nodejs_compat</code> compatibility flag.
    </p>

    <h3 id="ids">Ids</h3>
    <p>
      Form fields, Tabs, ToggleGroup and the Dialog title read
      <code>Astro.locals.$id</code> when it exists and otherwise generate a
      random id per render. Components a trigger points at (Anchor, Copy,
      Dialog, Drawer, Menu, Toaster and Tooltip) need an <code>id</code> prop.
      For stable, per-request ids, useful for snapshot tests, define it in a
      middleware:
    </p>
    <Code
      code={`// src/middleware.ts
import { defineMiddleware } from "astro:middleware"

export const onRequest = defineMiddleware((context, next) => {
  const counts = new Map<string, number>()
  context.locals.$id = (prefix) => {
    const count = (counts.get(prefix) ?? 0) + 1
    counts.set(prefix, count)
    return \`\${prefix}-\${count}\`
  }
  return next()
})`}
      lang="ts"
    />
    <p>
      Add <code>/// &lt;reference types="opui-css/env.d.ts" /&gt;</code> to your
      <code>env.d.ts</code> to type <code>$id</code> and the
      <code>interestfor</code> attribute on <code>a</code> and
      <code>button</code>.
    </p>
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>
