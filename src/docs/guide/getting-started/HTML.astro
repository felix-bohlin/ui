---
import Guide from "../../../layouts/Guide.astro"
import {
  Accordion,
  AccordionContent,
  AccordionSummary,
  Card,
  CardContent,
  CardHeader,
} from "opui-css/astro"
import Code from "../../../components/Code.astro"
import DocLink from "../../../components/DocLink.astro"
import ScriptTable from "../../../components/ScriptTable.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"

const cdn = `<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/opui-css@6/dist/opui.css" />`

const installs = [
  {
    href: "#cdn",
    note: "One link with every component. No build step.",
    title: "CDN",
  },
  {
    href: "#manual-setup",
    note: "The files in your project, yours to change. No build step.",
    title: "Copy the files",
  },
  {
    href: "#installation",
    note: "Everything or only the parts you use, through your bundler.",
    title: "npm",
  },
]
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    Add the CSS from the CDN, from npm or by copying the files, then write the
    class names.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Code slot="install" code={cdn} lang="html" />
      <Code
        slot="use"
        code={`<button class="ui-button ui-filled ui-primary" type="button">
  Save
</button>`}
        lang="html"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="install">
    <h2>Pick an install</h2>
    <div class="install-picker">
      {installs.map((install) => <Card variant="outlined">
        <CardHeader>
          <h3>
            <a class="ui-card-link" href={install.href}>{install.title}</a>
          </h3>
        </CardHeader>
        <CardContent>
          <p>{install.note}</p>
        </CardContent>
      </Card>)}
    </div>
  </section>

  <section id="cdn">
    <h2>Install via CDN</h2>
    <p>
      The quickest way to get going. One file with the theme, the reset, every
      component and the utility classes, in the right cascade layers, plus Open
      Props for your own CSS.
    </p>
    <Code code={cdn} lang="html" />
    <p>
      It includes the
      <DocLink href="/guide/browser-support#compat">browser fallbacks</DocLink>.
      <code>dist/opui.no-compat.css</code> leaves them out, and
      <code>dist/opui.baseline-&lt;year&gt;.css</code> keeps only the ones that
      browsers of that Baseline year need.
    </p>
    <p>
      <code>@6</code> loads the newest 6.x release, so a new major version never
      changes your site. Pin an exact version, such as <code>@6.0.0</code>, for
      full control.
    </p>
  </section>

  <section id="manual-setup">
    <h2>Install manually</h2>
    <p>
      The most flexible way to use OPUI, and it works without a build step.
      Download the package (<code>npm pack opui-css</code>, or browse it on
      <a
        class="ui-link"
        target="_blank"
        href="https://cdn.jsdelivr.net/npm/opui-css@6/"
        >jsDelivr</a
      >), drop it into your project as <code>opui</code>, and import the files
      in your main CSS:
    </p>
    <Code
      code={`@import "./opui/css/layers.css";

@import "./opui/core/palette.css";
@import "./opui/css/theme.css";
@import "./opui/core/normalize.css";
@import "./opui/css/components.css";
@import "./opui/css/compat.css";
@import "./opui/core/utils.css";`}
      lang="css"
    />
    <p>
      If your own CSS reads Open Props, import <code>./opui/dist/op.css</code>
      right after <code>layers.css</code>.
    </p>
    <Accordion>
      <AccordionSummary>The files in the package</AccordionSummary>
      <AccordionContent>
        <Code
          code={`opui
├─ core
│  ├─ normalize.css
│  ├─ palette.css
│  └─ utils.css
├─ css
│  ├─ compat
│  │  ├─ avatar.css
│  │  └─ ...
│  ├─ components
│  │  ├─ accordion.css
│  │  └─ ...
│  ├─ js
│  │  ├─ checkbox.js
│  │  └─ range.js
│  ├─ compat.css
│  ├─ components.css
│  ├─ imports.css
│  ├─ layers.css
│  └─ theme.css
├─ dist
│  ├─ op.css
│  ├─ opui.baseline-2023.css
│  ├─ ...
│  ├─ opui.components.css
│  ├─ opui.css
│  └─ opui.no-compat.css
├─ elements
│  ├─ number-field.js
│  └─ ...
├─ themes
│  ├─ bootstrap.css
│  ├─ brutalist.css
│  ├─ m3.css
│  └─ shadcn.css
├─ open-props.css
└─ tokens.json`}
          lang="text"
        />
        <p>
          <code>dist/op.css</code> is Open Props, pre-bundled in the
          <code>openprops</code> layer, and <code>open-props.css</code> imports
          it from <code>node_modules</code> for bundlers. The components don't
          read it, so both are optional and only there for your own CSS.
          <code>dist/opui.css</code> is the CDN file. <code>themes/</code> holds
          the
          <DocLink href="/guide/customizing#example-themes"
            >example themes</DocLink
          >
          and <code>tokens.json</code> the
          <DocLink href="/guide/theme-tokens#tokens-json">design tokens</DocLink
          >.
        </p>
      </AccordionContent>
    </Accordion>
  </section>

  <section id="installation">
    <h2>Install via NPM</h2>
    <p>
      For when you have a bundler that resolves CSS <code>@import</code>s from
      <code>node_modules</code>, like Vite or webpack.
    </p>
    <InstallCommand />

    <h3 id="css">Import the CSS</h3>
    <p>Either import everything in your main CSS file:</p>
    <Code code={`@import "opui-css/css/imports.css";`} lang="css" />

    <p>Or pick and choose the parts you want to include:</p>
    <PickAndChoose />
  </section>

  <section id="scripts">
    <h2>Scripts</h2>
    <p>A few features need a script in plain HTML:</p>
    <ScriptTable />
    <p>
      The examples import them by package name, which a bundler resolves.
      Without one, add this import map to the <code>head</code>, before the
      first module script:
    </p>
    <Code
      code={`<script type="importmap">
  { "imports": { "opui-css/": "https://cdn.jsdelivr.net/npm/opui-css@6/" } }
</script>`}
      lang="html"
    />
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>

<style>
  .install-picker {
    display: grid;
    gap: var(--size-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin-block-start: var(--size-5);

    h3 {
      font-size: var(--ui-font-size-h6);
      margin: 0;
    }

    p {
      color: var(--ui-text);
      font-size: var(--ui-font-size-small);
      margin: 0;
    }
  }
</style>
