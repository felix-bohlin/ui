---
import Guide from "../../../layouts/Guide.astro"
import Code from "../../../components/Code.astro"
import Builds from "./partials/Builds.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"
import ServerSupport from "./partials/ServerSupport.astro"

export const keywords = ["install", "npm", "setup", "ssr"]
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    OPUI ships first-class React 19 components. Install the package, import what
    you need, and you're set.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Fragment slot="install">
        <InstallCommand packages="react@19 react-dom@19" />
        <Code
          code={`// src/main.tsx
import "opui-css/css/imports.css"`}
          lang="tsx"
        />
      </Fragment>
      <Code
        slot="use"
        code={`import { Button } from "opui-css/react"

export default function App() {
  return <Button color="primary" variant="filled">Save</Button>
}`}
        lang="tsx"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="css">
    <h2>Import only what you use</h2>
    <p>
      List the files in a CSS file, and import that file in your entry instead
      of <code>imports.css</code>:
    </p>
    <PickAndChoose file="src/styles/main.css" />
    <Code
      code={`// src/main.tsx
import "./styles/main.css"`}
      lang="tsx"
    />
  </section>

  <section id="builds">
    <h2>Builds</h2>
    <Builds tools={["next", "vite"]} />
  </section>

  <section id="usage">
    <h2>How to use</h2>
    <p>
      Slots are props: <code>children</code>, and camelCased names like
      <code>endText</code>.
    </p>
  </section>

  <section id="ssr">
    <h2>Server rendering</h2>
    <p>
      Every component renders full HTML on the server. Components with state or
      effects are marked <code>"use client"</code>, the rest are Server
      Components. The props in the last column need hydration.
    </p>
    <ServerSupport framework="react" />
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>
