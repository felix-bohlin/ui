---
import Guide from "../../../layouts/Guide.astro"
import Code from "../../../components/Code.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"
import ServerSupport from "./partials/ServerSupport.astro"
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    OPUI ships first-class React 19 components. Install the package, import what
    you need, and you're set.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Fragment slot="install">
        <InstallCommand packages="react@19 react-dom@19" />
        <Code
          code={`// src/main.tsx
import "opui-css/css/imports.css"`}
          lang="tsx"
        />
      </Fragment>
      <Code
        slot="use"
        code={`import { Button } from "opui-css/react"

export default function App() {
  return <Button color="primary" variant="filled">Save</Button>
}`}
        lang="tsx"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="css">
    <h2>Import only what you use</h2>
    <p>
      List the files in a CSS file, and import that file in your entry instead
      of <code>imports.css</code>:
    </p>
    <PickAndChoose file="src/styles/main.css" />
    <Code
      code={`// src/main.tsx
import "./styles/main.css"`}
      lang="tsx"
    />
  </section>

  <section id="usage">
    <h2>How to use</h2>
    <p>
      Containers take parts, such as <code>CardHeader</code> and
      <code>DialogFooter</code>. Other slots are props: the default slot is
      <code>children</code> and named slots are camelCased, such as
      <code>endText</code>. Form controls take the native <code>value</code> or
      <code>defaultValue</code>, <code>checked</code> or
      <code>defaultChecked</code>, and <code>onChange</code> props.
    </p>
  </section>

  <section id="ssr">
    <h2>Server rendering</h2>
    <p>
      Components that need context, state or effects are marked
      <code>"use client"</code>. The rest also render as React Server
      Components. Every component renders complete HTML on the server, and the
      native controls work and submit with their form. The props in the last
      column need hydration (<code>client:load</code> in Astro) or client
      rendering.
    </p>
    <ServerSupport framework="react" />
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>
