---
import Guide from "../../../layouts/Guide.astro"
import Code from "../../../components/Code.astro"
import Bindings from "./partials/Bindings.astro"
import Builds from "./partials/Builds.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"
import ServerSupport from "./partials/ServerSupport.astro"

export const keywords = ["install", "npm", "setup", "ssr"]
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    OPUI ships first-class components for Svelte 5.57 and later. Install the
    package, import what you need, and you're set.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Fragment slot="install">
        <InstallCommand packages="svelte@5" />
        <Code
          code={`<!-- src/routes/+layout.svelte -->
<script lang="ts">
  import "opui-css/css/imports.css"

  let { children } = $props()
</script>

{@render children()}`}
          lang="svelte"
        />
      </Fragment>
      <Code
        slot="use"
        code={`<script lang="ts">
  import { Button } from "opui-css/svelte"
</script>

<Button color="primary" variant="filled">Save</Button>`}
        lang="svelte"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="css">
    <h2>Import only what you use</h2>
    <p>
      List the files in a CSS file, and import that file in your layout instead
      of <code>imports.css</code>:
    </p>
    <PickAndChoose file="src/styles/main.css" />
    <Code
      code={`<!-- src/routes/+layout.svelte -->
<script lang="ts">
  import "../styles/main.css"

  let { children } = $props()
</script>

{@render children()}`}
      lang="svelte"
    />
  </section>

  <section id="builds">
    <h2>Builds</h2>
    <Builds tools={["vite"]} />
  </section>

  <section id="typescript">
    <h2>TypeScript</h2>
    <p>
      The types resolve with <code>moduleResolution</code> set to
      <code>"bundler"</code> or <code>"nodenext"</code>.
      <code>svelte-check</code> 4.7 runs on TypeScript 6. For TypeScript 7,
      install it next to TypeScript 6 and run <code>svelte-check --tsgo</code>:
    </p>
    <Code
      code="npm install -D typescript@6 @typescript/native@npm:typescript@7"
      lang="sh"
    />
    <p>
      The types need <code>skipLibCheck: true</code> in
      <code>tsconfig.json</code>, as the Svelte and SvelteKit templates set it.
      Without it, <code>svelte-check</code> reports a union type that is too
      complex to represent.
    </p>
  </section>

  <section id="usage">
    <h2>How to use</h2>
    <p>
      Slots are snippets: <code>children</code>, and camelCased names like
      <code>endText</code>. Form controls bind their value:
    </p>
    <Bindings />
  </section>

  <section id="ssr">
    <h2>Server rendering</h2>
    <p>
      Every component renders full HTML on the server. The props in the last
      column need hydration.
    </p>
    <ServerSupport framework="svelte" />
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>
