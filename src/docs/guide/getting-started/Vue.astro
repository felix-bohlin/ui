---
import Guide from "../../../layouts/Guide.astro"
import CodeGroup from "../../../components/CodeGroup.astro"
import { Code } from "astro-expressive-code/components"
import Theming from "./_theming.astro"
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>

  <section>
    <h2 id="installation">Install via NPM</h2>
    <CodeGroup
      tabs={[
        {
          title: "pnpm",
          code: "pnpm add opui-css open-props vue -S",
          lang: "sh",
        },
        {
          title: "npm",
          code: "npm install opui-css open-props vue -S",
          lang: "sh",
        },
      ]}
    />
  </section>

  <section>
    <h2 id="css">Import the CSS</h2>
    <p>
      Vue components ship markup only - the CSS still has to be imported in your
      app somehow. Import everything:
    </p>
    <Code code={`@import "opui-css/css/imports.css";`} lang="css" />
    <p>Or pick and choose:</p>
    <Code
      code={`@import "opui-css/open-props.css";
@import "opui-css/core/palette.css";
@import "opui-css/css/theme.css";
@import "opui-css/core/normalize.css";
@import "opui-css/css/components.css";
@import "opui-css/core/utils.css";`}
      lang="css"
    />
  </section>

  <section>
    <h2 id="usage">How to use</h2>
    <p>
      The components are <a href="https://vuejs.org/guide/extras/vapor-mode"
        >Vapor</a
      > components - no virtual DOM. Vue 3.6 or later is required.
    </p>
    <Code
      code={`<script setup vapor lang="ts">
import { Button } from "opui-css/vue"
</script>

<template>
  <Button variant="filled">Click me</Button>
</template>`}
      lang="vue"
    />
    <p>Mount your app with <code>createVaporApp</code>:</p>
    <Code
      code={`import { createVaporApp } from "vue"
import App from "./App.vue"

createVaporApp(App).mount("#app")`}
      lang="ts"
    />
  </section>

  <section>
    <h2 id="virtual-dom">Virtual DOM apps</h2>
    <p>
      Apps mounted with <code>createApp</code> need the
      <code>vaporInteropPlugin</code> to render Vapor components:
    </p>
    <Code
      code={`import { createApp, vaporInteropPlugin } from "vue"
import App from "./App.vue"

createApp(App).use(vaporInteropPlugin).mount("#app")`}
      lang="ts"
    />
    <p>
      In Astro, install the plugin through the <code>appEntrypoint</code> option of
      <code>@astrojs/vue</code>. The Vapor runtime is client-only, so skip it
      during SSR:
    </p>
    <CodeGroup
      tabs={[
        {
          title: "astro.config.mjs",
          code: `import { defineConfig } from "astro/config"
import vue from "@astrojs/vue"

export default defineConfig({
  integrations: [vue({ appEntrypoint: "/src/pages/_app" })],
})`,
          lang: "js",
        },
        {
          title: "src/pages/_app.ts",
          code: `import type { App } from "vue"
import * as vue from "vue"

export default (app: App) => {
  if (!import.meta.env.SSR) app.use(vue.vaporInteropPlugin)
}`,
          lang: "ts",
        },
      ]}
    />
  </section>

  <Theming />
</Guide>
