---
import Guide from "../../../layouts/Guide.astro"
import Code from "../../../components/Code.astro"
import CssFiles from "./partials/CssFiles.astro"
import InstallCommand from "./partials/InstallCommand.astro"
import NextSteps from "./partials/NextSteps.astro"
import PickAndChoose from "./partials/PickAndChoose.astro"
import QuickStart from "./partials/QuickStart.astro"
import ServerSupport from "./partials/ServerSupport.astro"
---

<Guide overline="Guide">
  <Fragment slot="title">Getting started</Fragment>
  <Fragment slot="preamble">
    OPUI ships first-class Vue components. Install the package, import what you
    need, and you're set.
  </Fragment>

  <section id="quick-start">
    <h2>Quick start</h2>
    <QuickStart>
      <Fragment slot="install">
        <InstallCommand packages="vue@3" />
        <Code
          code={`// src/main.ts
import { createApp } from "vue"
import "opui-css/css/imports.css"
import App from "./App.vue"

createApp(App).mount("#app")`}
          lang="ts"
        />
      </Fragment>
      <Code
        slot="use"
        code={`<script setup lang="ts">
import { Button } from "opui-css/vue"
</script>

<template>
  <Button color="primary" variant="filled">Save</Button>
</template>`}
        lang="vue"
      />
    </QuickStart>
  </section>

  <section id="whats-in-the-css">
    <h2>What's in the CSS</h2>
    <CssFiles />
  </section>

  <section id="css">
    <h2>Import only what you use</h2>
    <p>
      List the files in a CSS file, and import that file in <code>main.ts</code>
      instead of <code>imports.css</code>:
    </p>
    <PickAndChoose file="src/styles/main.css">
      <p>
        In Nuxt, add the file to <code>css</code> in <code>nuxt.config.ts</code>
        instead.
      </p>
    </PickAndChoose>
    <Code
      code={`// src/main.ts
import "./styles/main.css"`}
      lang="ts"
    />
  </section>

  <section id="usage">
    <h2>How to use</h2>
    <p>
      Containers take parts, such as <code>CardHeader</code> and
      <code>DialogFooter</code>. Other components take named slots for rich
      content, such as <code>end-text</code> on a <code>TextField</code>.
    </p>
  </section>

  <section id="ssr">
    <h2>Server rendering</h2>
    <p>
      Every component renders complete HTML on the server, and the native
      controls work and submit with their form. The props in the last column
      need hydration (<code>client:load</code> in Astro) or a client-rendered
      Vue app.
    </p>
    <ServerSupport framework="vue" />
    <p>
      When the page hydrates, as in Nuxt, a value or choice the user changed
      before it did (typed, picked, filled in by a password manager or restored
      by the browser) stays: the form controls take it from the element instead
      of resetting it, and a form reset still returns to what the server
      rendered.
    </p>
  </section>

  <section id="next-steps">
    <h2>Next steps</h2>
    <NextSteps />
  </section>
</Guide>
