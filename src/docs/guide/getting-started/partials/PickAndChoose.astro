---
import Code from "../../../../components/Code.astro"

type Props = {
  file?: string
}

const { file } = Astro.props

const css = `@import "opui-css/css/layers.css";
@import "opui-css/open-props.css";
@import "opui-css/core/palette.css";
@import "opui-css/css/theme.css";
@import "opui-css/core/normalize.css";
@import "opui-css/css/components/button.css";
@import "opui-css/css/components/choice.css";
@import "opui-css/css/components/checkbox.css";
@import "opui-css/core/utils.css";`
---

<Code code={file ? `/* ${file} */\n${css}` : css} lang="css" />
<p>
  Import <code>layers.css</code> first and <code>utils.css</code> last, it holds
  <code>.ui-sr-only</code> and the motion classes. Add <code>choice.css</code> with
  <code>checkbox.css</code>, <code>radio.css</code> or <code>switch.css</code>.
  Import <code>opui-css/css/components.css</code> instead of single component files
  to get every component.
</p>
<slot />
