---
import Code from "../../components/Code.astro"
import Guide from "../../layouts/Guide.astro"
import { compiledContent } from "../../../packages/opui/MIGRATING.md"
import { parseMigrating } from "../../utils/migrating"

const { intro, sections, title } = parseMigrating(await compiledContent())
const content = [
  intro,
  ...sections.map((section) => `<section>${section}</section>`),
].join("\n")

const CODE_BLOCK =
  /<pre><code(?: class="language-([\w-]+)")?>([\s\S]*?)<\/code><\/pre>/
const ENTITIES: Record<string, string> = {
  amp: "&",
  gt: ">",
  lt: "<",
  quot: '"',
}
const decode = (code: string) =>
  code.replace(/&(?:#x([\da-f]+)|(\w+));/gi, (entity, hex, name) =>
    hex ? String.fromCodePoint(parseInt(hex, 16)) : (ENTITIES[name] ?? entity),
  )
const segments = content.split(CODE_BLOCK)
---

<Guide overline="Guide">
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="preamble">
    The breaking changes in v6 and how to update your code, component by
    component.
  </Fragment>

  {
    segments.map((segment, index) =>
      index % 3 === 0 ? (
        <Fragment set:html={segment} />
      ) : (
        index % 3 === 2 && (
          <Code code={decode(segment)} lang={segments[index - 1]} />
        )
      ),
    )
  }

  <section>
    <h2 id="older-versions">Older versions</h2>
    <p>
      Coming from an older version? The notes for v3, v4 and v5 are in <a
        href="https://github.com/felix-bohlin/ui/blob/main/packages/opui/MIGRATING-legacy.md"
        target="_blank"
        rel="noopener noreferrer"><code>MIGRATING-legacy.md</code></a
      >. They use the names of those versions, and the renames above apply on
      top of them.
    </p>
  </section>
</Guide>
