---
import Code from "../../components/Code.astro"
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableColumnGroup,
  TableHead,
  TableHeaderCell,
  TableRow,
} from "opui-css/astro"
import DocLink from "../../components/DocLink.astro"
import Guide from "../../layouts/Guide.astro"
import { formatInline } from "../../utils/format-inline"
import { themeTokenDescriptions } from "../../utils/theme-token-descriptions"
import { parseThemeTokens } from "../../utils/theme-tokens"

const sections = parseThemeTokens().filter(
  (section) => section.tokens.length > 0,
)
const slug = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
---

<Guide overline="Guide">
  <Fragment slot="title">Theme tokens</Fragment>
  <Fragment slot="preamble">
    Every custom property that <code>theme.css</code> declares, with its default.
    Override any of them on <code>html</code>, or on a subtree, unlayered or in
    a layer after <code>utils</code>.
  </Fragment>

  <section>
    <h2 id="overriding">Overriding tokens</h2>
    <p>
      Tokens cascade like any custom property. Set them once on{" "}
      <code>html</code> for a whole site, or on an element to theme a part of the
      page. The <DocLink href="/guide/theme-generator">theme generator</DocLink
      >{" "}
      writes a <code>custom-theme.css</code> with the tokens you change.
    </p>
    <Code
      code={`@layer theme.custom {
  :where(html) {
    --ui-border-radius: var(--radius-3);
    --ui-duration: 0.15s;
    --ui-palette-hue: 30;
  }
}`}
      lang="css"
    />
    <p>
      <DocLink href="/guide/customizing#your-theme">Customizing</DocLink> explains
      the <code>theme.custom</code> layer and where to put your other styles.
    </p>
    <p>
      The same list ships as <code>opui-css/tokens.json</code>, in the <a
        href="https://www.designtokens.org/"
        class="ui-link">W3C design tokens</a
      > format, for Style Dictionary, design tools and AI assistants. It's also at
      <a href="/tokens.json" class="ui-link">/tokens.json</a>. Values are CSS,
      and each token carries its CSS variable and dark mode value under <code
        >$extensions.opui</code
      >. <DocLink href="/guide/theming">Theming</DocLink> explains the palette, density,
      spacing, corners, fonts, elevation, motion and contrast, and the classes that
      change them for one part of the page.
    </p>
  </section>

  {
    sections.map((section) => (
      <section>
        <h2 id={slug(section.title)}>{section.title}</h2>
        {section.note && (
          <p set:html={formatInline(section.note, Astro.locals.link)} />
        )}
        <div class="table-scroll wide">
          <Table>
            <TableColumnGroup>
              <TableColumn style="min-width: 220px" />
              <TableColumn style="min-width: 200px" />
              <TableColumn style="min-width: 300px" />
            </TableColumnGroup>
            <TableHead>
              <TableRow>
                <TableHeaderCell>Token</TableHeaderCell>
                <TableHeaderCell>Default</TableHeaderCell>
                <TableHeaderCell>Description</TableHeaderCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {section.tokens.map((token) => (
                <TableRow>
                  <TableCell>
                    <code>{token.name}</code>
                  </TableCell>
                  <TableCell>
                    {token.optional ? (
                      <Fragment>
                        Unset. For example <code>{token.value}</code>
                      </Fragment>
                    ) : (
                      <code>{token.value}</code>
                    )}
                    {token.dark && (
                      <Fragment>
                        <br />
                        <code>{token.dark}</code> in dark mode
                      </Fragment>
                    )}
                  </TableCell>
                  <TableCell
                    set:html={formatInline(
                      themeTokenDescriptions[token.name] ?? "",
                      Astro.locals.link,
                    )}
                  />
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </section>
    ))
  }
</Guide>
