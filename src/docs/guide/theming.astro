---
import Guide from "../../layouts/Guide.astro"
import Code from "../../components/Code.astro"
import DocLink from "../../components/DocLink.astro"
import Example from "../../components/Example/index"
import RoleSwatches from "../../components/RoleSwatches.astro"
import TokenFlow from "../../components/TokenFlow.astro"

const surfaceRoles = [
  { name: "--ui-surface", note: "The page" },
  {
    name: "--ui-surface-elevated",
    note: "Elevated cards and accordions, dialogs, drawers, menus",
  },
  { name: "--ui-surface-tonal", note: "Tonal variants" },
  { name: "--ui-surface-filled", note: "Lists, tracks, table headers" },
  { name: "--ui-surface-inverse", note: "Tooltips" },
  { name: "--ui-text-strong", note: "Headings, labels, values" },
  { name: "--ui-text", note: "Body copy" },
  { name: "--ui-border-color", note: "Dividers, outlined variants" },
  { name: "--ui-field-border-color", note: "Fields" },
]

export const keywords = [
  "brand color",
  "color scheme",
  "dark mode",
  "dark theme",
  "light mode",
  "radius",
  "shadows",
  "theme",
]
---

<Guide overline="Guide">
  <Fragment slot="title">Theming</Fragment>
  <Fragment slot="preamble">
    The knobs and roles behind colors, density, spacing, corners, fonts,
    elevation, motion and contrast, and the classes that scope them.
  </Fragment>

  <section>
    <p>
      A theme sets
      <DocLink href="/guide/concepts#token-tiers">knobs and roles</DocLink>, and
      every component reads the roles:
    </p>
    <TokenFlow />
    <p>
      Snippets go in
      <DocLink href="/guide/customizing#your-theme"
        ><code>@layer theme.custom</code></DocLink
      >. Every token is on
      <DocLink href="/guide/theme-tokens">Theme tokens</DocLink>.
    </p>
  </section>

  <section id="palette">
    <h2>Palette</h2>
    <p>One hue and chroma derive the 16 palette steps.</p>

    <Code
      code={`:where(html) {
  --ui-palette-chroma: 0.5;
  --ui-palette-hue: 222.8;
  --ui-palette-hue-rotate-by: 0;
}`}
      lang="css"
    />

    <ul>
      <li>
        <code>--ui-palette-chroma</code>: saturation, <code>0</code> to
        <code>1</code>.
      </li>
      <li><code>--ui-palette-hue</code>: a hue angle in degrees.</li>
      <li><code>--ui-palette-hue-rotate-by</code>: degrees of hue per step.</li>
    </ul>

    <p>
      Or set <code>--ui-palette-source</code> to any color. Recolor a severity
      scope through its intent token, like <code>--ui-warning</code>. The
      library's own rule:
    </p>

    <Code
      code={`:where(.ui-warning) {
  --ui-palette-source: oklch(from var(--ui-warning) 0.58 0.21 h);
  --ui-palette-hue-rotate-by: 1;
}`}
      lang="css"
    />
  </section>

  <section id="scopes">
    <h2>Scopes</h2>
    <p>A scope class re-themes an element and everything inside it:</p>
    <Example centered row>
      <section
        class="ui-palette scope-demo"
        style="
          --ui-palette-hue: 30;
          --ui-palette-source: oklch(
            58% calc(0.21 * var(--ui-palette-chroma)) var(--ui-palette-hue)
          );
          --ui-primary-source: light-dark(var(--ui-color-9), var(--ui-color-6));
        "
      >
        <p class="ui-caption">.ui-palette with --ui-palette-hue: 30</p>
        <button class="ui-button ui-filled ui-primary" type="button">
          Primary
        </button>
        <button class="ui-button ui-tonal ui-primary" type="button">
          Tonal
        </button>
      </section>
      <aside class="ui-dark scope-demo">
        <p class="ui-caption">.ui-dark</p>
        <button class="ui-button ui-filled ui-primary" type="button">
          Primary
        </button>
        <button class="ui-button ui-tonal ui-primary" type="button">
          Tonal
        </button>
      </aside>
      <section class="scope-demo">
        <p class="ui-caption">.ui-critical on each</p>
        <article class="ui-callout ui-critical">
          <div class="ui-content">Card declined</div>
        </article>
        <button class="ui-button ui-tonal ui-critical" type="button">
          Remove card
        </button>
      </section>
    </Example>
    <ul>
      <li>
        <code>.ui-palette</code>: re-derives every token from the knobs it sets.
      </li>
      <li>
        <code>.ui-critical</code> and the other severities: swap the palette for
        the intent color.
      </li>
      <li>
        <code>.ui-light</code> and <code>.ui-dark</code>: force a color scheme,
        except in print, which is always light. Builds that rewrite
        <code>light-dark()</code> only follow them on <code>html</code>, see the
        <a
          href="https://github.com/felix-bohlin/ui/blob/main/packages/opui/README.md#builds-that-rewrite-light-dark"
          >README</a
        >.
      </li>
    </ul>
  </section>

  <section id="surfaces">
    <h2>Surfaces</h2>
    <RoleSwatches roles={surfaceRoles} />
    <p>
      Set <code>--ui-border-color-on-raised</code> for borders inside raised
      components, and <code>--ui-border-color-raised</code> for their edge.
    </p>
  </section>

  <section id="density">
    <h2>Density</h2>
    <p>Use <code>--ui-density</code> to change the size of every control.</p>
    <Code
      code={`:where(html) {
  --ui-density: 0.875;
}`}
      lang="css"
    />
    <p>
      A <code>Button</code> in a field's start or end, and a checkbox, radio or
      switch whose label is hidden, stay at least
      <code>--ui-target-min-size</code> (24px, the minimum target size) at any
      density. At a compact density, an x-small field grows to fit its button.
    </p>
  </section>

  <section id="spacing">
    <h2>Spacing</h2>
    <p>
      Use <code>--ui-space-scale</code> to change spacing. Controls follow
      density instead.
    </p>
    <Code
      code={`:where(html) {
  --ui-space-scale: 1.25;
}

/* Or tie spacing to density */
:where(html) {
  --ui-density: 0.875;
  --ui-space-scale: var(--ui-density);
}`}
      lang="css"
    />
  </section>

  <section id="corners">
    <h2>Corners</h2>
    <p>Use <code>--ui-radius</code> to round every component.</p>
    <Code
      code={`:where(html) {
  --ui-radius: 0;
}`}
      lang="css"
    />
  </section>

  <section id="fonts">
    <h2>Fonts</h2>
    <p>Headings follow the body font until you set one.</p>
    <Code
      code={`:where(html) {
  --ui-font-body: "Inter", system-ui, sans-serif;
  --ui-font-code: "JetBrains Mono", ui-monospace, monospace;
  --ui-font-heading: "Fraunces", serif;
}`}
      lang="css"
    />
    <p>Pin a size role, or replace the scale:</p>
    <Code
      code={`:where(html, .ui-palette, .ui-contrast-more) {
  /* Pin one role */
  --ui-font-size-caption: 0.8125rem;
}

:where(html) {
  /* Or a modular scale: 1rem base, minor third */
  --ui-font-size-100: calc(1rem * pow(1.2, -2));
  --ui-font-size-200: calc(1rem * pow(1.2, -1));
  --ui-font-size-300: 1rem;
  --ui-font-size-400: calc(1rem * pow(1.2, 1));
  --ui-font-size-500: calc(1rem * pow(1.2, 2));
  --ui-font-size-600: calc(1rem * pow(1.2, 3));
  --ui-font-size-700: calc(1rem * pow(1.2, 4));
  --ui-font-size-800: calc(1rem * pow(1.2, 5));
  --ui-font-size-900: calc(1rem * pow(1.2, 6));
}`}
      lang="css"
    />
    <h3 id="fluid-headings">Fluid headings</h3>
    <p>
      Headings grow with the viewport. Move the window, reuse the ramp, or pin a
      heading:
    </p>
    <Code
      code={`:where(html) {
  /* Headings reach full size on wider screens */
  --ui-fluid-min-inline-size: 24rem;
  --ui-fluid-max-inline-size: 64rem;

  /* Tighter spacing on narrow screens, on the same ramp */
  --ui-space-scale: calc(0.875 + 0.125 * var(--ui-fluid-progress));
}

:where(html, .ui-palette, .ui-contrast-more) {
  /* Or pin a heading */
  --ui-font-size-h1: var(--ui-font-size-800);
}`}
      lang="css"
    />
  </section>

  <section id="elevation">
    <h2>Elevation</h2>
    <ul>
      <li><code>--ui-shadow-control</code>: controls. Off by default.</li>
      <li><code>--ui-shadow-elevated</code>: elevated cards and accordions.</li>
      <li>
        <code>--ui-shadow-overlay</code>: dialogs, drawers, menus, the select
        picker and toasts.
      </li>
      <li><code>--ui-shadow-scroll</code>: scrolled edges.</li>
      <li>
        <code>--ui-shadow-surface</code>: tonal and outlined surfaces. Off by
        default.
      </li>
      <li><code>--ui-shadow-selected</code>: the selected tab.</li>
      <li><code>--ui-shadow-color</code>: every shadow's base color.</li>
    </ul>
    <Code
      code={`:where(html, .ui-palette, .ui-contrast-more) {
  --ui-shadow-color: light-dark(oklch(0.28 0.055 290 / 2%), oklch(0 0 0 / 30%));
  --ui-shadow-elevated: none;
}`}
      lang="css"
    />
  </section>

  <section id="motion">
    <h2>Motion</h2>
    <p>
      <code>--ui-motion</code> multiplies every duration. It's <code>0</code>
      with reduced motion.
    </p>

    <h3 id="motion-global">Global classes</h3>
    <p>On <code>html</code>, these override the OS preference:</p>
    <ul>
      <li><code>.ui-motion-off</code>: sets <code>--ui-motion: 0</code>.</li>
      <li><code>.ui-motion-on</code>: sets <code>--ui-motion: 1</code>.</li>
      <li><code>.ui-motion-debug</code>: sets <code>--ui-motion: 10</code>.</li>
    </ul>
    <Code code={`<html lang="en" class="ui-motion-debug">`} lang="html" />

    <h3 id="motion-local">Local overrides</h3>
    <p>Use <code>--_motion</code> on one component:</p>
    <Code
      code={`<button class="ui-button" style="--_motion: 0" type="button">
  Instant interaction
</button>`}
      lang="html"
    />

    <h3 id="motion-personality">Springy movement</h3>
    <p>
      Off by default. Set <code>--ui-ease-move</code> and
      <code>--ui-press-scale</code> to turn them on.
    </p>
    <Code
      code={`:where(html) {
  --ui-ease-move: linear(0, 0.066, 0.218, 0.4, 0.578, 0.731, 0.852, 0.94, 0.998,
    1.031, 1.047, 1.05, 1.046, 1.038, 1.029, 1.02, 1.012, 1.007, 1.002, 1, 1);
  --ui-press-scale: 0.97;
}`}
      lang="css"
    />

    <p>To follow it in your own CSS:</p>
    <Code
      code={`transition: transform calc(var(--ui-duration) * var(--ui-motion)) var(--ui-ease);`}
      lang="css"
    />
  </section>

  <section id="contrast">
    <h2>Contrast</h2>
    <p>
      More contrast tightens the knobs, and every role follows. Their values are
      on <DocLink href="/guide/theme-tokens#contrast">Theme tokens</DocLink>.
    </p>
    <p>
      A role a theme pins stays pinned in every contrast mode. Hand it back with
      <code>revert-layer</code>:
    </p>
    <Code
      code={`@layer theme.custom {
  :where(html, .ui-palette, .ui-contrast-more) {
    --ui-border-color: oklch(0.95 0 0);
  }

  @media (prefers-contrast: more) {
    :where(
      html:not(.ui-contrast-normal),
      html:not(.ui-contrast-normal) .ui-palette
    ) {
      --ui-border-color: revert-layer;
    }
  }

  :where(.ui-contrast-more, .ui-contrast-more .ui-palette) {
    --ui-border-color: revert-layer;
  }
}`}
      lang="css"
    />
    <Example row showCode={false}>
      <div class="contrast-demo">
        <section>
          <p class="ui-caption">Default</p>
          <label class="ui-text-field">
            <span class="ui-label">Email</span>
            <span class="ui-field">
              <input type="email" placeholder="name@example.com" />
            </span>
            <span class="ui-end-text">We'll never share it.</span>
          </label>
          <button class="ui-button ui-primary ui-outlined" type="button">
            Subscribe
          </button>
        </section>
        <section class="ui-contrast-more">
          <p class="ui-caption">.ui-contrast-more</p>
          <label class="ui-text-field">
            <span class="ui-label">Email</span>
            <span class="ui-field">
              <input type="email" placeholder="name@example.com" />
            </span>
            <span class="ui-end-text">We'll never share it.</span>
          </label>
          <button class="ui-button ui-primary ui-outlined" type="button">
            Subscribe
          </button>
        </section>
      </div>
    </Example>

    <h3 id="contrast-classes">Classes</h3>
    <ul>
      <li>
        <code>.ui-contrast-more</code>: more contrast, on <code>html</code> or
        any element.
      </li>
      <li>
        <code>.ui-contrast-normal</code>: on <code>html</code>, ignores the OS
        preference.
      </li>
    </ul>
    <Code code={`<html lang="en" class="ui-contrast-more">`} lang="html" />

    <h3 id="contrast-custom">Custom values</h3>
    <p>
      Set the knobs under the media query and on <code>.ui-contrast-more</code>:
    </p>
    <Code
      code={`@layer theme.custom {
  @media (prefers-contrast: more) {
    :where(html:not(.ui-contrast-normal)) {
      --ui-border-strength-light: 70%;
      --ui-field-border-strength: 80%;
    }
  }

  :where(.ui-contrast-more) {
    --ui-border-strength-light: 70%;
    --ui-field-border-strength: 80%;
  }
}`}
      lang="css"
    />

    <h3 id="forced-colors">Forced colors</h3>
    <p>Handled by the components. Nothing to configure.</p>
  </section>
</Guide>

<style>
  .scope-demo {
    align-items: start;
    border-radius: var(--ui-radius);
    display: grid;
    gap: var(--ui-space-3);
    padding: var(--ui-space-4);

    .ui-caption {
      margin: 0;
    }
  }

  .contrast-demo {
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    inline-size: 100%;

    section {
      align-items: start;
      display: flex;
      flex-direction: column;
      gap: var(--ui-space-3);
    }

    .ui-text-field {
      inline-size: 100%;
    }
  }
</style>
