---
import Learn from "../../layouts/Learn.astro"
import DocLink from "../../components/DocLink.astro"
import {
  Chip,
  FieldLegend,
  Fieldset,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import { computeFeatureSupport } from "../../utils/browser-support"
import {
  componentName,
  levelOf,
  levels,
  posts,
  readingMinutes,
  series,
  seriesOf,
  topics,
  walkthroughs,
} from "../../utils/learn"

const { link } = Astro.locals

const icons = {
  buildUps:
    "M1 3.5C1 2.67 1.67 2 2.5 2h7c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5h-7A1.5 1.5 0 0 1 1 8.5zM2.5 3a.5.5 0 0 0-.5.5v5c0 .28.22.5.5.5h7a.5.5 0 0 0 .5-.5v-5a.5.5 0 0 0-.5-.5zm2.58 10c.21.58.77 1 1.42 1h3A5.5 5.5 0 0 0 15 8.5v-1c0-.65-.42-1.2-1-1.41V8.5A4.5 4.5 0 0 1 9.5 13zm-.58-1a1.5 1.5 0 0 1-1.42-1H9.5A2.5 2.5 0 0 0 12 8.5V4.09c.58.2 1 .76 1 1.41v3A3.5 3.5 0 0 1 9.5 12z",
  level:
    "M14 3.5a1.5 1.5 0 0 0-3 0v9a1.5 1.5 0 0 0 3 0zM12.5 3c.28 0 .5.22.5.5v9a.5.5 0 0 1-1 0v-9c0-.28.22-.5.5-.5M10 6.5a1.5 1.5 0 1 0-3 0v6a1.5 1.5 0 0 0 3 0zM8.5 6c.28 0 .5.22.5.5v6a.5.5 0 0 1-1 0v-6c0-.28.22-.5.5-.5m-4 2C5.33 8 6 8.67 6 9.5v3a1.5 1.5 0 0 1-3 0v-3C3 8.67 3.67 8 4.5 8M5 9.5a.5.5 0 0 0-1 0v3a.5.5 0 0 0 1 0z",
  readingTime:
    "M2 8a6 6 0 1 1 12 0A6 6 0 0 1 2 8m6-7a7 7 0 1 0 0 14A7 7 0 0 0 8 1m0 3.5a.5.5 0 0 0-1 0v4c0 .28.22.5.5.5h3a.5.5 0 0 0 0-1H8z",
  topics:
    "M11 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-8.41 4.14a2 2 0 0 1 0-2.83L7.33 2.6c.37-.37.88-.58 1.4-.59L12 2A2 2 0 0 1 14 4l-.02 3.37c0 .53-.22 1.03-.6 1.4l-4.66 4.65c-.78.77-2.05.77-2.84 0zm.7-2.12a1 1 0 0 0 0 1.41l3.3 3.28a1 1 0 0 0 1.42 0l4.67-4.65a1 1 0 0 0 .3-.7L13 4a1 1 0 0 0-1-1L8.73 3a1 1 0 0 0-.7.3z",
}

const buildCount = Object.keys(
  import.meta.glob("../../components/UnderTheHood/*Build.astro"),
).length

const labelOf = (list: { id: string; label: string }[], id: string) =>
  list.find((entry) => entry.id === id)?.label ?? id

const entries = posts
  .toSorted(
    (a, b) =>
      Number(!!a.component) - Number(!!b.component) ||
      (a.component ?? "").localeCompare(b.component ?? ""),
  )
  .map((post) => ({
    ...post,
    features: (post.features ?? []).map((id) => ({
      id,
      name: computeFeatureSupport(id).name,
    })),
    level: post.features && levelOf(post.features),
    minutes: readingMinutes(post.slug),
    series: seriesOf(post.slug),
  }))

const filters = [
  {
    id: "level",
    label: "Level",
    options: levels,
    rule: levels
      .map((level) => `${level.label}: ${level.description}.`)
      .join(" "),
  },
  { id: "topic", label: "Topic", options: topics },
]

const checked = (filter: string, value: string) =>
  `:has([name="learn-${filter}"][value="${value}"]:checked)`

const matches = (
  entry: (typeof entries)[number],
  level?: string,
  topic?: string,
) =>
  !!entry.level &&
  (!level || entry.level === level) &&
  (!topic || !!entry.topics?.includes(topic))

const filterCss = [
  ...levels.map(
    ({ id }) => `
.learn-browse${checked("level", id)} .learn-post[data-level]:not([data-level="${id}"]) {
  display: none;
}`,
  ),
  ...topics.map(
    ({ id }) => `
.learn-browse${checked("topic", id)} .learn-post[data-topics]:not([data-topics~="${id}"]) {
  display: none;
}`,
  ),
  ...[undefined, ...levels.map(({ id }) => id)].flatMap((level) =>
    [undefined, ...topics.map(({ id }) => id)]
      .filter(
        (topic) =>
          (level || topic) &&
          !entries.some((entry) => matches(entry, level, topic)),
      )
      .map(
        (topic) => `
.learn-browse${level ? checked("level", level) : ""}${topic ? checked("topic", topic) : ""} .learn-empty {
  display: block;
}`,
      ),
  ),
].join("\n")
---

<Learn
  description="How the components are made, one technique at a time."
  overline=""
  showToc={false}
  wide
>
  <Fragment slot="title">Learn</Fragment>

  <div class="learn-browse ui-not-rich-text">
    <div class="learn-filters">
      {
        filters.map((filter) => (
          <Fieldset>
            <FieldLegend>{filter.label}</FieldLegend>
            <ToggleGroup name={`learn-${filter.id}`} size="small">
              <ToggleButton checked value="">
                All
              </ToggleButton>
              {filter.options.map((option) => (
                <ToggleButton value={option.id}>{option.label}</ToggleButton>
              ))}
            </ToggleGroup>
            {"rule" in filter && <p class="ui-caption">{filter.rule}</p>}
          </Fieldset>
        ))
      }
    </div>

    <p class="learn-empty">No post matches this level and topic.</p>

    <ul class="learn-posts">
      {
        entries.map((post) => (
          <li
            class:list={[
              "learn-post",
              { "learn-post-featured": !post.component },
            ]}
            data-level={post.level}
            data-topics={post.topics?.join(" ")}
          >
            <article
              class:list={[
                "ui-card",
                post.component ? "ui-outlined" : "ui-tonal",
              ]}
            >
              <hgroup>
                <h2 style={`view-transition-name: learn-${post.slug}-title`}>
                  <DocLink href={`/learn/${post.slug}`}>{post.title}</DocLink>
                </h2>
                <p>{post.description}</p>
              </hgroup>
              <div class="ui-content">
                <ul aria-label="Tags" class="learn-chips">
                  {post.technique && (
                    <li>
                      <Chip size="small">
                        <code slot="label">{post.technique}</code>
                      </Chip>
                    </li>
                  )}
                  {post.component && (
                    <li>
                      <Chip
                        size="small"
                        variant="outlined"
                        label={componentName(post.component)}
                      />
                    </li>
                  )}
                  {post.series && (
                    <li>
                      <Chip size="small" variant="outlined">
                        <Fragment slot="label">
                          {post.series.label}
                          <span class="learn-chip-part">
                            {post.series.part}/{post.series.total}
                          </span>
                        </Fragment>
                      </Chip>
                    </li>
                  )}
                  {post.features.map((feature) => (
                    <li>
                      <Chip
                        size="small"
                        variant="outlined"
                        label={feature.name}
                      />
                    </li>
                  ))}
                </ul>
                <dl class="learn-meta">
                  {[
                    {
                      icon: icons.readingTime,
                      label: "Reading time",
                      value: `${post.minutes} min`,
                    },
                    post.level && {
                      icon: icons.level,
                      label: "Level",
                      value: labelOf(levels, post.level),
                    },
                    post.topics && {
                      icon: icons.topics,
                      label: "Topics",
                      value: post.topics
                        .map((topic) => labelOf(topics, topic))
                        .join(", "),
                    },
                    post.slug === "under-the-hood" && {
                      icon: icons.buildUps,
                      label: "Build-ups",
                      value: `${buildCount} build-ups`,
                    },
                  ]
                    .filter((item) => !!item)
                    .map((item) => (
                      <div>
                        <dt>
                          <svg aria-hidden="true" viewBox="0 0 16 16">
                            <path d={item.icon} />
                          </svg>
                          <span class="ui-sr-only">{item.label}</span>
                        </dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                </dl>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="learn-series-list">
    <h2 id="series">Series</h2>
    <p>Posts that build on each other, in reading order.</p>
    <div class="learn-series-grid ui-not-rich-text">
      {
        series.map((entry) => (
          <section>
            <h3 id={entry.id}>{entry.label}</h3>
            <ol>
              {entry.posts.map((slug) => (
                <li>
                  <DocLink href={`/learn/${slug}`}>
                    {posts.find((post) => post.slug === slug)!.title}
                  </DocLink>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <section>
    <h2 id="walkthrough-only">Walkthrough only</h2>
    <p>
      These components have a step-by-step build-up on the
      <DocLink href="/learn/under-the-hood">Under the hood</DocLink> page, but no
      post yet.
    </p>
    <ul aria-label="Walkthroughs" class="learn-chips ui-not-rich-text">
      {
        walkthroughs.map((slug) => (
          <li>
            <Chip
              href={link(`/learn/under-the-hood#${slug}`)}
              label={componentName(slug)}
              variant="outlined"
            />
          </li>
        ))
      }
    </ul>
  </section>
</Learn>

<style is:inline set:html={filterCss}></style>

<style>
  .learn-browse {
    display: grid;
    gap: var(--ui-space-4);
  }

  .learn-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-3) var(--ui-space-6);

    & .ui-fieldset {
      gap: 0;
    }

    & legend {
      font-size: var(--ui-font-size-caption);
      margin-block-end: var(--ui-space-1);
    }

    & .ui-caption {
      margin-block-start: var(--ui-space-1);
      max-inline-size: 48ch;
    }
  }

  .learn-empty {
    display: none;
    margin: 0;
  }

  .learn-posts {
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;

    @supports (display: grid-lanes) {
      display: grid-lanes;
    }
  }

  .learn-post {
    container-type: inline-size;
    display: grid;

    & .ui-card {
      gap: var(--ui-space-3);
      position: relative;
      transition: border-color 0.2s;

      &:has(a:hover) {
        border-color: var(--ui-primary);
      }

      &:has(a:focus-visible) {
        outline: var(--ui-focus-ring-width, 2px) solid
          var(--ui-focus-ring-color, var(--ui-primary));
        outline-offset: 2px;
      }
    }

    & hgroup {
      display: grid;
      gap: var(--ui-space-1);

      & > * {
        margin: 0;
      }

      & > * {
        inline-size: fit-content;
        view-transition-class: doc-heading;
      }

      & > p:last-child {
        view-transition-class: doc-heading doc-reflow;
      }

      & > p:last-child {
        color: var(--ui-text);
        font-size: clamp(0.8125rem, 0.75rem + 0.6cqi, 0.9375rem);
        line-height: 1.45;
        text-wrap: pretty;
      }
    }

    & h2 {
      color: var(--ui-text-strong);
      font-size: clamp(1rem, 0.8rem + 2.5cqi, 1.25rem);
      letter-spacing: -0.01em;
      line-height: 1.2;
      text-wrap: balance;
    }

    & .ui-content {
      display: grid;
      gap: var(--ui-space-3);
    }

    & h2 a {
      color: inherit;
      text-decoration: none;

      &::after {
        content: "";
        inset: 0;
        position: absolute;
      }

      &:focus-visible {
        outline: none;
      }
    }
  }

  .learn-post-featured {
    grid-column: 1 / -1;

    & h2 {
      font-size: clamp(1.25rem, 0.75rem + 2.5cqi, 1.875rem);
    }

    & hgroup > p:last-child {
      max-inline-size: 65ch;
    }
  }

  .learn-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-chip-part {
    opacity: 0.7;
  }

  .learn-series-grid {
    display: grid;
    gap: var(--ui-space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));

    & h3 {
      font-size: var(--ui-font-size-h5);
      margin-block: 0 var(--ui-space-2);
    }

    & ol {
      display: grid;
      gap: var(--ui-space-1);
      margin: 0;
      padding-inline-start: var(--ui-space-5);
    }
  }

  .learn-meta {
    display: flex;
    flex-wrap: wrap;
    font-size: var(--ui-font-size-caption);
    gap: var(--ui-space-1) var(--ui-space-4);
    line-height: 1.3;
    margin: 0;

    & div {
      align-items: center;
      display: flex;
      gap: var(--ui-space-1);
    }

    & dt {
      color: var(--ui-text);
      display: flex;
    }

    & svg {
      block-size: 1rem;
      fill: currentColor;
      inline-size: 1rem;
    }

    & dd {
      font-weight: 600;
      margin: 0;
    }
  }
</style>
