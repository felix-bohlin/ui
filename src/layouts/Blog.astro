---
import Document from "./Document.astro"
import {
  DEFAULT_FRAMEWORK,
  hrefFor,
  stripFrameworkPrefix,
  type FrameworkId,
} from "../utils/framework-routing"
import { categories, componentName, posts } from "../utils/blog"

type Props = {
  description?: string
  overline?: string
  showToc?: boolean
  title?: string
  wide?: boolean
}

const {
  description,
  overline = "Learn",
  showToc = true,
  title,
  wide,
} = Astro.props

const currentFramework = (Astro.currentLocale ??
  DEFAULT_FRAMEWORK) as FrameworkId

const canonicalPath = stripFrameworkPrefix(Astro.url.pathname).replace(
  /\/$/,
  "",
)

const linkTo = (href: string, label: string) => ({
  current: canonicalPath === href,
  href: hrefFor(currentFramework, href),
  label,
})

const groups = [
  { label: "Learn", links: [linkTo("/learn", "All posts")] },
  ...categories.map((category) => ({
    label: category.label,
    links: posts
      .filter((post) => post.category === category.id)
      .toSorted(
        (a, b) =>
          Number(!!a.component) - Number(!!b.component) ||
          (a.component ?? "").localeCompare(b.component ?? ""),
      )
      .map((post) =>
        linkTo(
          `/learn/${post.slug}`,
          post.navLabel ??
            (post.component ? componentName(post.component) : post.title),
        ),
      ),
  })),
]
---

<Document
  description={description}
  overline={overline}
  showToc={showToc}
  title={title}
  wide={wide}
>
  <nav slot="sidebar">
    {
      groups.map((group) => (
        <>
          <h3>{group.label}</h3>
          <menu class="blog-nav-list">
            {group.links.map((link) => (
              <li>
                <a
                  aria-current={link.current ? "page" : undefined}
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </menu>
        </>
      ))
    }
  </nav>

  <slot slot="title" name="title" />
  <slot slot="preamble" name="preamble" />
  <slot />
</Document>

<style is:global>
  .blog-nav-list + h3 {
    margin-block-start: var(--size-5);
  }

  .blog-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;

    & a {
      color: var(--text-muted);
      display: block;
      padding-block: var(--size-1);
      text-decoration: none;

      &:hover {
        color: var(--text-primary);
      }

      &[aria-current="page"] {
        color: var(--link);
        font-weight: var(--font-weight-6);
      }
    }
  }
</style>
