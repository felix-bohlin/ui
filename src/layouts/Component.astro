---
import Document from "./Document.astro"
import { componentsFor, componentHrefFor } from "../utils/components"
import FrameworkPicker from "../components/FrameworkPicker.astro"
import BrowserSupport from "../components/BrowserSupport.astro"
import BrowserSupportChips from "../components/BrowserSupportChips.astro"
import ComponentAPI, { type Apis } from "../components/ComponentAPI.astro"
import type { AstroInstance } from "astro"
import ComponentProperties from "../components/ComponentProperties.astro"
import HydrationChip from "../components/HydrationChip.astro"
import type { ComponentApi } from "../component-api/types"
import Installation, { type Tab } from "../components/Installation.astro"
import Pagination from "../components/Pagination.astro"
import {
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Chip,
  Divider,
  List,
  ListItem,
} from "opui-css/astro"
import { componentImports, packageFor } from "../utils/component-imports"
import {
  checkExports,
  reportProblems,
  shipped,
} from "../utils/component-source"
import {
  getComponentChangelog,
  type ChangelogPathEntry,
} from "../utils/changelog"
import { FRAMEWORKS, isHydratedFramework } from "../utils/framework"
import { posts } from "../utils/learn-posts"
import { isWhatsNewHighlighted, whatsNewFor } from "../utils/whats-new"

type Props = {
  title?: string
  description?: string
  image?: string
  overline?: string
  browserSupport?: string[]
  slug?: string
  apis?: Apis
  changelogPaths?: ChangelogPathEntry[]
  heroAnatomy?: boolean
  installationTabs?: Tab[]
  seeAlsoLinks?: { name: string; href: string }[]
  showToc?: boolean
}

const {
  apis: apisProp,
  browserSupport,
  changelogPaths,
  heroAnatomy,
  installationTabs,
  seeAlsoLinks,
  overline = "Components",
  showToc = true,
  slug: slugProp,
  title,
  description,
  image,
} = Astro.props

const currentFramework = Astro.locals.framework

const { link } = Astro.locals

const urlSlug = Astro.url.pathname
  .replace(/\/$/, "")
  .split("/")
  .filter(Boolean)
  .pop()

const currentSlug = slugProp ?? urlSlug
Astro.locals.componentSlug = currentSlug

const apiModules = import.meta.glob<AstroInstance>(
  "../component-api/**/*.astro",
  { eager: true },
)

const apiData = import.meta.glob<ComponentApi>("../component-api/*/api.ts", {
  eager: true,
  import: "default",
})

reportProblems(checkExports(Object.values(apiData)))

const autoApis = ((): Apis | null => {
  if (!currentSlug) return null
  const api = apiData[`../component-api/${currentSlug}/api.ts`]
  if (api) return [{ api }]
  const entries = FRAMEWORKS.map((f) => {
    const mod = apiModules[`../component-api/${currentSlug}/${f.label}.astro`]
    return [f.id, mod?.default] as const
  }).filter(([, mod]) => mod != null)
  return entries.length > 0 ? Object.fromEntries(entries) : null
})()

const apis = apisProp ?? autoApis

const hydrationFramework = isHydratedFramework(currentFramework)
  ? currentFramework
  : undefined
const hydrationApis = hydrationFramework
  ? [apis ?? []]
      .flat()
      .flatMap((entry) => ("api" in entry ? [entry.api] : []))
      .filter((api) => shipped(api, hydrationFramework))
  : []

const components = componentsFor(currentFramework)
const currentIndex = components.findIndex(
  (component) => component.slug === currentSlug,
)
const isComponentPage = currentIndex !== -1
const prevComponent = isComponentPage ? components[currentIndex - 1] : undefined
const nextComponent = isComponentPage ? components[currentIndex + 1] : undefined

const githubRepo = "https://github.com/felix-bohlin/ui"
const editUrl = `${githubRepo}/edit/main/src/docs/components/${currentSlug}.astro`

const whatsNew = currentSlug ? whatsNewFor(currentFramework, currentSlug) : []

const changelog = changelogPaths ? getComponentChangelog(changelogPaths) : []

const imports =
  currentSlug && currentFramework !== "html"
    ? {
        names: componentImports(currentFramework, currentSlug),
        package: packageFor(currentFramework),
      }
    : undefined

const learnPost = currentSlug
  ? posts.find((post) => post.component === currentSlug)
  : undefined
---

<Document
  overline={overline}
  showToc={showToc}
  sidebarGroups={[
    {
      label: "Components",
      links: components.map((component) => ({
        href: componentHrefFor(currentFramework, component.slug),
        isNew: isWhatsNewHighlighted(currentFramework, component.slug),
        label: component.name,
      })),
    },
  ]}
  title={title}
  description={description}
  image={image}
>
  <FrameworkPicker size="small" slot="sidebar" />

  <Divider variant="tonal" slot="sidebar" />

  <slot name="title" slot="title" />
  <slot name="preamble" slot="preamble" />

  {
    (browserSupport || hydrationApis.length > 0) && (
      <BrowserSupportChips ids={browserSupport ?? []}>
        {hydrationApis.length > 0 && (
          <HydrationChip apis={hydrationApis} framework={hydrationFramework!} />
        )}
      </BrowserSupportChips>
    )
  }

  {
    heroAnatomy && Astro.slots.has("anatomy") && (
      <section class="component-hero">
        <h2 id="anatomy" class="ui-sr-only">
          Anatomy
        </h2>
        <slot name="anatomy" />
      </section>
    )
  }

  <slot />

  {
    Astro.slots.has("accessibility") && (
      <section>
        <h2 id="accessibility">Accessibility</h2>
        <slot name="accessibility" />
      </section>
    )
  }

  {
    !heroAnatomy && Astro.slots.has("anatomy") && (
      <section>
        <h2 id="anatomy">Anatomy</h2>
        <slot name="anatomy" />
      </section>
    )
  }

  {apis && <ComponentAPI apis={apis} />}

  {currentSlug && <ComponentProperties slug={currentSlug} />}

  {
    Astro.slots.has("under-the-hood") && (
      <section>
        <h2 id="under-the-hood">Under the hood</h2>
        {learnPost && (
          <p>
            Read the post:
            <a href={link(`/learn/${learnPost.slug}`)}>{learnPost.title}</a>
          </p>
        )}
        <slot name="under-the-hood" />
      </section>
    )
  }

  {browserSupport && <BrowserSupport ids={browserSupport} />}

  {
    installationTabs ? (
      <Installation
        imports={imports}
        slug={currentSlug}
        tabs={installationTabs}
      >
        <slot name="installation" />
      </Installation>
    ) : (
      <slot name="installation" />
    )
  }

  {
    !!seeAlsoLinks?.length && (
      <section>
        <h2 id="see-also">See also</h2>
        <ul>
          {seeAlsoLinks.map((entry) => (
            <li>
              <a
                href={
                  entry.href.startsWith("/") ? link(entry.href) : entry.href
                }
              >
                {entry.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    (whatsNew.length > 0 || changelog.length > 0) && (
      <section>
        <h2 id="changelog">Changelog</h2>
        {whatsNew.length > 0 && (
          <Callout severity="info" variant="tonal" class="whats-new">
            <CalloutIcon />
            <CalloutContent>
              <h3>What's new</h3>
              <ul>
                {whatsNew.map((note) => (
                  <li set:html={note} />
                ))}
              </ul>
            </CalloutContent>
          </Callout>
        )}
        {changelog.length > 0 && (
          <div class="ui-not-rich-text">
            <List id="changelog-list" bordered flush variant="transparent">
              {changelog.map((entry, index) => (
                <ListItem
                  as="a"
                  class={index >= 5 ? "changelog-extra" : undefined}
                  href={`https://github.com/felix-bohlin/ui/commit/${entry.hash}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  label={entry.message}
                >
                  <time slot="end" datetime={entry.date}>
                    {entry.relativeDate}
                  </time>
                  {entry.types.length > 0 && (
                    <span class="changelog-types">
                      {entry.types.map((type) => (
                        <Chip label={type} variant="outlined" size="small" />
                      ))}
                    </span>
                  )}
                </ListItem>
              ))}
            </List>
            {changelog.length > 5 && (
              <Button
                id="changelog-toggle"
                variant="outlined"
                data-more-count={changelog.length - 5}
              >
                Show {changelog.length - 5} more
              </Button>
            )}
          </div>
        )}
      </section>
    )
  }

  <footer class="component-footer ui-not-rich-text">
    <hr class="ui-divider" />

    {
      isComponentPage && (
        <Button href={editUrl} target="_blank" size="small">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 32 32"
            width="1.2em"
            height="1.2em"
          >
            <path
              fill="currentColor"
              d="M28.565 3.434a4.89 4.89 0 0 0-6.915 0L4.357 20.73a3.7 3.7 0 0 0-1.002 1.84l-1.333 6.22a1 1 0 0 0 1.188 1.188l6.22-1.333a3.7 3.7 0 0 0 1.84-1.002l17.295-17.295a4.89 4.89 0 0 0 0-6.914m-5.5 1.414a2.89 2.89 0 0 1 4.085 4.086l-.9.9l-4.086-4.085zm-2.316 2.315l4.086 4.086L9.857 26.23a1.7 1.7 0 0 1-.846.46L4.3 27.7l1.01-4.71a1.7 1.7 0 0 1 .46-.846z"
            />
          </svg>
          <span>Edit page</span>
        </Button>
      )
    }

    <Pagination
      label="Component pages"
      next={nextComponent && {
        href: componentHrefFor(currentFramework, nextComponent.slug),
        label: nextComponent.name,
      }}
      prev={prevComponent && {
        href: componentHrefFor(currentFramework, prevComponent.slug),
        label: prevComponent.name,
      }}
    />
  </footer>

  <style>
    .component-hero {
      --anatomy-hero: 1;
    }

    .component-hero > h2 {
      margin: 0;
      position: absolute;
    }

    .component-footer {
      display: grid;
      gap: var(--size-4);
      margin-block-start: var(--size-8);

      hr {
        margin: 0;
      }

      .ui-button {
        inline-size: fit-content;
      }
    }
  </style>

  <style>
    #changelog-toggle {
      margin-block-start: var(--size-3);
    }

    .changelog-types {
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-1);
      margin-block-start: var(--size-1);
    }

    :global(#changelog-list:not([data-expanded]) .changelog-extra) {
      display: none;
    }

    .whats-new {
      margin-block-end: var(--size-4);
    }
  </style>
</Document>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var btn = document.getElementById("changelog-toggle")
    var list = document.getElementById("changelog-list")
    if (!btn || !list) return
    btn.addEventListener("click", function () {
      var expanded = list.hasAttribute("data-expanded")
      list.toggleAttribute("data-expanded")
      btn.textContent = expanded
        ? "Show " + btn.dataset.moreCount + " more"
        : "Show less"
    })
  })
</script>
