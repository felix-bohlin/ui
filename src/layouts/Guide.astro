---
import Document from "./Document.astro"
import { canonicalPath, hrefFor } from "../utils/framework"
import { guidePages } from "../utils/guide"
import FrameworkPicker from "../components/FrameworkPicker.astro"
import Pagination from "../components/Pagination.astro"
import { Divider } from "opui-css/astro"

type Props = {
  title?: string
  description?: string
  image?: string
  overline?: string
  showToc?: boolean
}

const {
  overline = "Guide",
  showToc = true,
  title,
  description,
  image,
} = Astro.props

const currentFramework = Astro.locals.framework

const links = guidePages.map(({ label, slug }) => ({
  href: hrefFor(currentFramework, `/guide/${slug}`),
  label,
}))

const current = canonicalPath(Astro.url.pathname)
const currentIndex = links.findIndex(
  (link) => canonicalPath(link.href) === current,
)
---

<Document
  overline={overline}
  showToc={showToc}
  sidebarGroups={[{ label: "Guide", links }]}
  title={title}
  description={description}
  image={image}
>
  <FrameworkPicker size="small" slot="sidebar" />

  <Divider variant="tonal" slot="sidebar" />

  <slot slot="title" name="title" />
  <slot slot="preamble" name="preamble" />
  <slot />

  {
    currentIndex !== -1 && (
      <footer class="guide-footer ui-not-rich-text">
        <hr class="ui-divider" />

        <Pagination
          label="Guide pages"
          next={links[currentIndex + 1]}
          prev={links[currentIndex - 1]}
        />
      </footer>
    )
  }
</Document>

<style>
  .guide-footer {
    display: grid;
    gap: var(--size-4);
    margin-block-start: var(--size-8);

    hr {
      margin: 0;
    }
  }
</style>
