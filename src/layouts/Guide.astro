---
import Document from "./Document.astro"
import { canonicalPath, hrefFor } from "../utils/framework"
import FrameworkPicker from "../components/FrameworkPicker.astro"
import Pagination from "../components/Pagination.astro"
import { Divider } from "opui-css/astro"

type Props = {
  title?: string
  description?: string
  image?: string
  overline?: string
  showToc?: boolean
}

const {
  overline = "Guide",
  showToc = true,
  title,
  description,
  image,
} = Astro.props

const currentFramework = Astro.locals.framework

const links = [
  { href: "/guide/why-opui", label: "Why Open Props UI?" },
  { href: "/guide/getting-started", label: "Getting started" },
  { href: "/guide/concepts", label: "Concepts" },
  { href: "/guide/theming", label: "Theming" },
  { href: "/guide/theme-tokens", label: "Theme tokens" },
  { href: "/guide/theme-generator", label: "Theme generator" },
  { href: "/guide/customizing", label: "Customizing" },
  { href: "/guide/accessibility", label: "Accessibility" },
  { href: "/guide/browser-support", label: "Browser support" },
  { href: "/guide/migrating", label: "Migrating to v6" },
  { href: "/guide/acknowledgments", label: "Acknowledgments" },
].map((link) => ({
  ...link,
  href: hrefFor(currentFramework, link.href),
}))

const current = canonicalPath(Astro.url.pathname)
const currentIndex = links.findIndex(
  (link) => canonicalPath(link.href) === current,
)
---

<Document
  overline={overline}
  showToc={showToc}
  sidebarGroups={[{ label: "Guide", links }]}
  title={title}
  description={description}
  image={image}
>
  <FrameworkPicker size="small" slot="sidebar" />

  <Divider variant="tonal" slot="sidebar" />

  <slot slot="title" name="title" />
  <slot slot="preamble" name="preamble" />
  <slot />

  {
    currentIndex !== -1 && (
      <footer class="guide-footer ui-not-rich-text">
        <hr class="ui-divider" />

        <Pagination
          label="Guide pages"
          next={links[currentIndex + 1]}
          prev={links[currentIndex - 1]}
        />
      </footer>
    )
  }
</Document>

<style>
  .guide-footer {
    display: grid;
    gap: var(--size-4);
    margin-block-start: var(--size-8);

    hr {
      margin: 0;
    }
  }
</style>
