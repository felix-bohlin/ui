---
import "@opui/css/imports.css"
import "/src/styles/base.css"
import Footer from "../components/Footer.astro"
import { Font } from "astro:assets"
import { frameworkVariantsOf } from "../utils/framework"
import { markdownPath } from "../utils/markdown.js"
import checkboxJs from "@opui/css/js/checkbox.js?url"

type Props = {
  title?: string
  description?: string
  hasMarkdown?: boolean
  image?: string
}

const { title, description, hasMarkdown, image } = Astro.props
const pathname = Astro.url.pathname
const currentFramework = Astro.locals.framework

// Every route is mirrored across frameworks, so every page advertises its
// alternates. Each variant self-canonicalizes; rel=alternate covers the rest.
const variants = frameworkVariantsOf(pathname)
const normalize = (url: string) => url.replace(/\/+$/, "") || "/"
const currentNormalized = normalize(pathname)

const siteTitle = title ? `${title} - Open Props UI` : "Open Props UI"
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL(image || "/share-img.png", Astro.site)
const markdownUrl = hasMarkdown
  ? new URL(markdownPath(pathname), Astro.site)
  : null
---

<!doctype html>
<html lang="en" data-framework={currentFramework}>
  <head>
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      markdownUrl && (
        <link rel="alternate" type="text/markdown" href={markdownUrl} />
      )
    }
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={imageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />

    {
      variants
        .filter((v) => normalize(v.url) !== currentNormalized)
        .map((v) => (
          <link rel="alternate" href={v.url} data-framework={v.framework} />
        ))
    }
    <meta name="generator" content={Astro.generator} />
    <script
      is:inline
      type="importmap"
      set:html={JSON.stringify({
        imports: { "opui-css/css/js/checkbox.js": checkboxJs },
      })}
    />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>

<script>
  import {
    DEFAULT_FRAMEWORK,
    FRAMEWORK_STORAGE_KEY,
    frameworkPrefixPattern,
    hrefFor,
    isFrameworkFree,
    isFrameworkId,
    pathHasFramework,
    stripFrameworkPrefix,
  } from "../utils/framework"

  function rememberFramework() {
    const framework = location.pathname.match(frameworkPrefixPattern())?.[1]
    if (!isFrameworkId(framework)) return
    try {
      sessionStorage.setItem(FRAMEWORK_STORAGE_KEY, framework!)
    } catch (_) {}
  }

  function preferredFramework() {
    try {
      const last = sessionStorage.getItem(FRAMEWORK_STORAGE_KEY)
      if (isFrameworkId(last)) return last
      const saved = localStorage.getItem(FRAMEWORK_STORAGE_KEY)
      if (isFrameworkId(saved)) return saved
    } catch (_) {}
    return DEFAULT_FRAMEWORK
  }

  function relinkDocs() {
    if (!isFrameworkFree(location.pathname)) return
    const framework = preferredFramework()
    document.documentElement.dataset.framework = framework
    document
      .querySelectorAll<HTMLAnchorElement>('a[href^="/"]')
      .forEach((anchor) => {
        const href = anchor.getAttribute("href")!
        const match = href.match(frameworkPrefixPattern())
        if (!match || match[1] === framework) return
        const path = stripFrameworkPrefix(href.split(/[?#]/)[0])
        if (pathHasFramework(framework, path)) {
          anchor.setAttribute("href", hrefFor(framework, href))
        }
      })
  }

  rememberFramework()
  relinkDocs()
</script>
