---
import Document from "./Document.astro"
import { canonicalPath, hrefFor } from "../utils/framework"
import { categories, componentName, posts, walkthroughs } from "../utils/learn"

type Props = {
  description?: string
  overline?: string
  showToc?: boolean
  title?: string
  wide?: boolean
}

const {
  description,
  overline = "Learn",
  showToc = true,
  title,
  wide,
} = Astro.props

const currentFramework = Astro.locals.framework

const currentPost = posts.find(
  (post) => canonicalPath(Astro.url.pathname) === `/learn/${post.slug}`,
)

const linkTo = (href: string, label: string) => ({
  href: hrefFor(currentFramework, href),
  label,
})

const groups = [
  { label: "Learn", links: [linkTo("/learn", "All posts")] },
  ...categories.map((category) => ({
    label: category.label,
    links: posts
      .filter((post) => post.category === category.id)
      .toSorted(
        (a, b) =>
          Number(!!a.component) - Number(!!b.component) ||
          (a.component ?? "").localeCompare(b.component ?? ""),
      )
      .map((post) =>
        linkTo(
          `/learn/${post.slug}`,
          post.navLabel ??
            (post.component ? componentName(post.component) : post.title),
        ),
      ),
  })),
  {
    label: "Walkthrough only",
    links: walkthroughs.map((slug) =>
      linkTo(`/learn/under-the-hood#${slug}`, componentName(slug)),
    ),
  },
]
---

<Document
  description={description}
  overline={overline}
  showToc={showToc}
  sidebarGroups={groups}
  title={title}
  transitionName={currentPost && `learn-${currentPost.slug}`}
  wide={wide}
>
  <slot slot="title" name="title" />
  <slot slot="preamble" name="preamble" />
  <slot />
</Document>
