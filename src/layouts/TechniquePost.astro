---
import Learn from "./Learn.astro"
import ReadMore from "../components/UnderTheHood/ReadMore.astro"
import { references } from "../components/UnderTheHood/references"
import { formatInline } from "../utils/format-inline"
import { componentName, formatDate, posts } from "../utils/learn"
import {
  componentHasFramework,
  DEFAULT_FRAMEWORK,
  hrefFor,
} from "../utils/framework"

type Props = {
  slug: string
  topic?: keyof typeof references
}

const { slug, topic: topicProp } = Astro.props
const post = posts.find((entry) => entry.slug === slug)!
const component = post.component!
if (!post.before || !post.now) {
  throw new Error(`learn-posts.ts: ${slug} needs before and now`)
}

const { link } = Astro.locals

const currentFramework = Astro.locals.framework

const docsHref = hrefFor(
  componentHasFramework(currentFramework, component)
    ? currentFramework
    : DEFAULT_FRAMEWORK,
  `/components/${component}`,
)

const name = componentName(component)

const topic =
  topicProp ??
  (component in references ? (component as keyof typeof references) : undefined)
---

<Learn
  description={post.description}
  overline={formatDate(post.date)}
  title={post.title}
>
  <Fragment slot="title">{post.title}</Fragment>
  <Fragment slot="preamble">{post.description}</Fragment>

  <slot />

  <section>
    <h2 id="then-and-now">Then and now</h2>
    <dl>
      <dt>Then</dt>
      <dd set:html={formatInline(post.before, link)} />
      <dt>Now</dt>
      <dd set:html={formatInline(post.now, link)} />
    </dl>
  </section>

  <section>
    <h2 id="read-more">Read more</h2>
    <ul>
      <li><a href={docsHref}>{name} docs</a></li>
      <li>
        <a href={hrefFor(currentFramework, "/learn/under-the-hood")}
          >Every component, under the hood</a
        >
      </li>
    </ul>
    {topic && <ReadMore topic={topic} />}
  </section>
</Learn>
