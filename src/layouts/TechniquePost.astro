---
import Blog from "./Blog.astro"
import ReadMore from "../components/UnderTheHood/ReadMore.astro"
import { references } from "../components/UnderTheHood/references"
import { formatInline } from "../utils/format-inline"
import {
  componentHref,
  componentName,
  formatDate,
  posts,
  seriesOf,
} from "../utils/blog"
import { hrefFor } from "../utils/framework"

type Props = {
  slug: string
  topic?: keyof typeof references
}

const { slug, topic: topicProp } = Astro.props
const post = posts.find((entry) => entry.slug === slug)!
const { component } = post
if (component && (!post.before || !post.now)) {
  throw new Error(`blog-posts.ts: ${slug} needs before and now`)
}

const { link } = Astro.locals

const currentFramework = Astro.locals.framework

if (component) Astro.locals.componentSlug = component

const docsHref = component && componentHref(currentFramework, component)

const name = component && componentName(component)

const series = seriesOf(slug)

const topic =
  topicProp ??
  (component && component in references
    ? (component as keyof typeof references)
    : undefined)
---

<Blog
  description={post.description}
  overline={formatDate(post.date)}
  title={post.title}
>
  <Fragment slot="title">{post.title}</Fragment>
  <Fragment slot="preamble">{post.description}</Fragment>

  {
    series && (
      <nav aria-label="Series" class="blog-series ui-not-rich-text">
        <p>
          Part {series.part} of {series.total} in{" "}
          <a href={link(`/blog#${series.id}`)}>{series.label}</a>
        </p>
        <ul>
          {series.previous && (
            <li>
              <a href={link(`/blog/${series.previous.slug}`)} rel="prev">
                <span class="ui-caption">Previous</span>
                {series.previous.title}
              </a>
            </li>
          )}
          {series.next && (
            <li>
              <a href={link(`/blog/${series.next.slug}`)} rel="next">
                <span class="ui-caption">Next</span>
                {series.next.title}
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }

  <slot />

  {
    post.before && post.now && (
      <section>
        <h2 id="then-and-now">Then and now</h2>
        <dl>
          <dt>Then</dt>
          <dd set:html={formatInline(post.before, link)} />
          <dt>Now</dt>
          <dd set:html={formatInline(post.now, link)} />
        </dl>
      </section>
    )
  }

  {
    component && (
      <section>
        <h2 id="read-more">Read more</h2>
        <ul>
          <li>
            <a href={docsHref}>{name} docs</a>
          </li>
          <li>
            <a href={`${docsHref}#under-the-hood`}>{name}, under the hood</a>
          </li>
          <li>
            <a href={hrefFor(currentFramework, "/blog/under-the-hood")}>
              Every component, under the hood
            </a>
          </li>
        </ul>
        {topic && <ReadMore topic={topic} />}
      </section>
    )
  }
</Blog>

<style>
  .blog-series {
    display: grid;
    font-size: var(--ui-font-size-small);
    gap: var(--ui-space-2);
    margin-block-start: var(--ui-space-3);

    & p {
      margin: 0;
    }

    & ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ui-space-2);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    & li a {
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius);
      color: var(--ui-text-strong);
      display: grid;
      padding-block: var(--ui-space-1);
      padding-inline: var(--ui-space-3);
      text-decoration: none;

      &:hover {
        border-color: var(--ui-primary);
      }
    }

    & li:has([rel="next"]) a {
      text-align: end;
    }

    & .ui-caption {
      color: var(--ui-text);
    }
  }
</style>
