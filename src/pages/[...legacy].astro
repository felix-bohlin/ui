---
import { stressPages, stressSlug, testPagesEnabled } from "../utils/test-pages"
import { todoExamples } from "../utils/todo-examples"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [
    "checklist",
    "checks",
    "share-image",
    "tests",
    "todo",
    ...Object.keys(stressPages).map((path) => `tests/${stressSlug(path)}`),
    ...Object.keys(todoExamples).map((name) => `todo/example/${name}`),
  ]
    .toSorted()
    .map((legacy) => ({ params: { legacy } }))
}

const target = `/dev/${Astro.params.legacy}/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta content={`0;url=${target}`} http-equiv="refresh" />
    <title>{`Moved to ${target}`}</title>
    <script define:vars={{ target }} is:inline>
      location.replace(`${target}${location.search}${location.hash}`)
    </script>
  </head>
  <body>
    <a href={target}>{`Moved to ${target}`}</a>
  </body>
</html>
