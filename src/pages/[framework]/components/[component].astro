---
import type { AstroInstance } from "astro"
import {
  componentHasFramework,
  FRAMEWORK_IDS,
} from "../../../utils/framework-routing"

export const components = Object.fromEntries(
  Object.entries(
    import.meta.glob<AstroInstance>("../../../docs/components/*.astro", {
      eager: true,
    }),
  ).map(([path, module]) => [
    path.split("/").pop()!.replace(".astro", ""),
    module.default,
  ]),
)

export const getStaticPaths = () =>
  FRAMEWORK_IDS.flatMap((framework) =>
    Object.keys(components)
      .toSorted()
      .filter((slug) => componentHasFramework(framework, slug))
      .map((component) => ({ params: { component, framework } })),
  )

const Doc = components[Astro.params.component]
---

<Doc />
