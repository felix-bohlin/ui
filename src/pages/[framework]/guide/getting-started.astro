---
import type { AstroInstance } from "astro"
import { frameworkPaths, type FrameworkId } from "../../../utils/framework"

export const getStaticPaths = frameworkPaths

const framework = Astro.locals.framework

const modules = import.meta.glob<AstroInstance>(
  "../../../docs/guide/getting-started/*.astro",
  { eager: true },
)

const labelByFramework: Record<FrameworkId, string> = {
  astro: "Astro",
  html: "HTML",
  react: "React",
  svelte: "Svelte",
  vue: "Vue",
}

const label = labelByFramework[framework]
const entry = Object.entries(modules).find(([path]) =>
  path.endsWith(`/${label}.astro`),
)
const Page = entry?.[1].default
---

{Page && <Page />}
