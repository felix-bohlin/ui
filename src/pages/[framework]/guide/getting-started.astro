---
import type { AstroInstance } from "astro"
import { FRAMEWORKS, frameworkPaths } from "../../../utils/framework"

export const getStaticPaths = frameworkPaths

const modules = import.meta.glob<AstroInstance>(
  "../../../docs/guide/getting-started/*.astro",
  { eager: true },
)

const label = FRAMEWORKS.find((f) => f.id === Astro.locals.framework)!.label
const Page =
  modules[`../../../docs/guide/getting-started/${label}.astro`].default
---

<Page />
