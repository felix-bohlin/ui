---
import "@opui/css/imports.css"
import "@opui/open-props.css"
import "../../../styles/example-layout.css"
import {
  exampleModules,
  exampleSources,
  parseExamplePath,
} from "../../../utils/examples"
import { withoutCodeVariants } from "../../../utils/example-variants"
import { FRAMEWORK_IDS, type FrameworkId } from "../../../utils/framework"
import { importMap } from "../../../utils/import-map"
import { generateHydrationScript } from "@solidjs/web"
import { idPrefixOf } from "../../../components/Example/mount-examples"
import { renderHydratableReact } from "../../../components/Example/render-react"
import { renderHydratableSolid } from "../../../components/Example/render-solid"
import { renderHydratableSvelte } from "../../../components/Example/render-svelte"
import { renderHydratableVue } from "../../../components/Example/render-vue"
import { fixturePagesEnabled } from "../../../utils/test-pages"

const allExamples = Object.entries(exampleSources).map(([path, source]) => ({
  ...parseExamplePath(path),
  Component: exampleModules[path]?.default,
  source,
}))

const examplesFor = (framework: FrameworkId, slug: string) =>
  withoutCodeVariants(
    allExamples.filter(
      (example) => example.framework === framework && example.slug === slug,
    ),
  ).toSorted((a, b) => a.name.localeCompare(b.name))

export function getStaticPaths() {
  if (!fixturePagesEnabled()) return []

  const slugs = [
    ...new Set(
      Object.keys(exampleSources).map((path) => parseExamplePath(path).slug),
    ),
  ].toSorted()

  return FRAMEWORK_IDS.flatMap((framework) =>
    slugs.map((component) => ({ params: { component, framework } })),
  )
}

const { component, framework } = Astro.params as {
  component: string
  framework: FrameworkId
}
const examples = await Promise.all(
  examplesFor(framework, component).map(async (example) => {
    const Example = example.Component as never
    if (!Example) return example
    const idPrefix = idPrefixOf(`${component}/${example.name}`)
    if (example.framework === "react") {
      return {
        ...example,
        html: renderHydratableReact(Example, `${idPrefix}-`),
      }
    }
    if (example.framework === "solid") {
      const renderId = `${Astro.locals.$id("solid")}-`
      return {
        ...example,
        html: renderHydratableSolid(Example, renderId),
        renderId,
      }
    }
    if (example.framework === "svelte") {
      return { ...example, html: renderHydratableSvelte(Example, idPrefix) }
    }
    if (example.framework === "vue") {
      return { ...example, html: await renderHydratableVue(Example, idPrefix) }
    }
    return example
  }),
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{`${component} - ${framework}`}</title>
    <script is:inline type="importmap" set:html={importMap} />
    {framework === "solid" && <Fragment set:html={generateHydrationScript()} />}
  </head>
  <body>
    <main>
      {examples.map((example) => <section class="fixture">
        <h2>{example.name}</h2>
        <div class="fixture-preview" data-example={example.name}>
          {example.framework === "astro" && example.Component && (
            <example.Component />
          )}
          {example.framework === "html" && (
            <Fragment set:html={example.source} />
          )}
          {"html" in example && (
            <div
              class="preview-render"
              data-hydratable
              data-solid-render-id={"renderId" in example && example.renderId}
              set:html={example.html}
              {...{
                [`data-${example.framework}-example`]: `${component}/${example.name}`,
              }}
            />
          )}
        </div>
      </section>)}
    </main>
    <script>
      import "../../../components/Example/mount-react-examples"
      import "../../../components/Example/mount-solid-examples"
      import "../../../components/Example/mount-svelte-examples"
      import "../../../components/Example/mount-vue-examples"
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--size-4);
  }

  .fixture h2 {
    font-size: var(--font-size-1);
    margin-block: var(--size-4) var(--size-2);
  }

  .fixture-preview {
    display: grid;
    gap: var(--size-3);
    padding: var(--size-4);
  }

  .preview-render {
    display: contents;
  }
</style>
