---
import "@opui/css/imports.css"
import {
  exampleModules,
  exampleSources,
  parseExamplePath,
} from "../../../utils/examples"
import { FRAMEWORK_IDS, type FrameworkId } from "../../../utils/framework"
import { fixturePagesEnabled } from "../../../utils/test-pages"

const allExamples = Object.entries(exampleSources).map(([path, source]) => ({
  ...parseExamplePath(path),
  Component: exampleModules[path]?.default,
  source,
}))

const examplesFor = (framework: FrameworkId, slug: string) => {
  const examples = allExamples.filter(
    (example) => example.framework === framework && example.slug === slug,
  )
  const names = new Set(examples.map((example) => example.name))
  return examples
    .filter(
      ({ name }) => !(name.endsWith("Code") && names.has(name.slice(0, -4))),
    )
    .toSorted((a, b) => a.name.localeCompare(b.name))
}

export function getStaticPaths() {
  if (!fixturePagesEnabled()) return []

  const slugs = [
    ...new Set(
      Object.keys(exampleSources).map((path) => parseExamplePath(path).slug),
    ),
  ].toSorted()

  return FRAMEWORK_IDS.flatMap((framework) =>
    slugs.map((component) => ({ params: { component, framework } })),
  )
}

const { component, framework } = Astro.params as {
  component: string
  framework: FrameworkId
}
const examples = examplesFor(framework, component)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{`${component} - ${framework}`}</title>
  </head>
  <body>
    <main>
      {
        examples.map((example) => (
          <section class="fixture">
            <h2>{example.name}</h2>
            <div class="fixture-preview" data-example={example.name}>
              {example.framework === "astro" && example.Component && (
                <example.Component />
              )}
              {example.framework === "html" && (
                <Fragment set:html={example.source} />
              )}
              {example.framework === "react" && example.Component && (
                <div
                  class="preview-render"
                  data-react-example={`${component}/${example.name}`}
                >
                  <example.Component />
                </div>
              )}
              {example.framework === "svelte" && example.Component && (
                <div
                  class="preview-render"
                  data-svelte-example={`${component}/${example.name}`}
                >
                  <example.Component />
                </div>
              )}
              {example.framework === "vue" && example.Component && (
                <div
                  class="preview-render"
                  data-vue-example={`${component}/${example.name}`}
                >
                  <example.Component />
                </div>
              )}
            </div>
          </section>
        ))
      }
    </main>
    {
      component === "toast" && (
        <output
          aria-live="polite"
          id="toast-manager"
          popover="manual"
          role="status"
        />
      )
    }
    <script>
      import "../../../components/Example/mount-react-examples"
      import "../../../components/Example/mount-svelte-examples"
      import "../../../components/Example/mount-vue-examples"
      import { initToastManager } from "@opui/css/js/toast.js"

      initToastManager()
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--size-4);
  }

  .fixture h2 {
    font-size: var(--font-size-1);
    margin-block: var(--size-4) var(--size-2);
  }

  .fixture-preview {
    display: grid;
    gap: var(--size-3);
    padding: var(--size-4);
  }

  .preview-render {
    display: contents;
  }

  .example-column {
    display: grid;
    gap: var(--size-3);
  }

  .example-row {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: center;
  }

  .example-row.ui-spacious {
    gap: var(--size-6);
  }

  .example-compass {
    align-items: center;
    display: grid;
    gap: var(--size-3);
    grid-template-areas:
      ". block-start ."
      "inline-start . inline-end"
      ". block-end .";
    justify-content: center;
    justify-items: center;

    & > :nth-child(1) {
      grid-area: block-start;
    }

    & > :nth-child(2) {
      grid-area: inline-start;
    }

    & > :nth-child(3) {
      grid-area: inline-end;
    }

    & > :nth-child(4) {
      grid-area: block-end;
    }
  }
</style>
