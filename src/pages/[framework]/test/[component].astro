---
import "@opui/css/imports.css"
import type { AstroInstance } from "astro"
import type { ComponentType } from "react"
import type { DefineComponent } from "vue"
import { FRAMEWORK_IDS } from "../../../utils/framework"
import { fixturePagesEnabled } from "../../../utils/test-pages"

type Framework = (typeof FRAMEWORK_IDS)[number]

const astroModules = import.meta.glob<AstroInstance>(
  "../../../component-examples/*/*.astro",
  { eager: true },
)
const reactModules = import.meta.glob<{ default: ComponentType }>(
  "../../../component-examples/*/*.react.tsx",
  { eager: true },
)
const svelteModules = import.meta.glob<{
  default: (props: Record<string, never>) => unknown
}>("../../../component-examples/*/*.svelte", { eager: true })
const vueModules = import.meta.glob<{ default: DefineComponent }>(
  "../../../component-examples/*/*.vue",
  { eager: true },
)
const htmlSources = import.meta.glob<string>(
  "../../../component-examples/*/*.html",
  { eager: true, import: "default", query: "?raw" },
)

const parse = (path: string) => {
  const [, slug, name] = path.match(
    /component-examples\/([^/]+)\/([^/.]+)(?:\.react)?\.\w+$/,
  )!
  return { name, slug }
}

const entries = <F extends Framework, T>(
  framework: F,
  modules: Record<string, T>,
) =>
  Object.entries(modules).map(([path, module]) => ({
    ...parse(path),
    framework,
    module,
  }))

const allExamples = [
  ...entries("astro", astroModules),
  ...entries("html", htmlSources),
  ...entries("react", reactModules),
  ...entries("svelte", svelteModules),
  ...entries("vue", vueModules),
]

const examplesFor = (framework: Framework, slug: string) => {
  const examples = allExamples.filter(
    (example) => example.framework === framework && example.slug === slug,
  )
  const names = new Set(examples.map((example) => example.name))
  return examples
    .filter(
      ({ name }) => !(name.endsWith("Code") && names.has(name.slice(0, -4))),
    )
    .toSorted((a, b) => a.name.localeCompare(b.name))
}

export function getStaticPaths() {
  if (!fixturePagesEnabled()) return []

  const paths = import.meta.glob(
    "../../../component-examples/*/*.{astro,html,react.tsx,svelte,vue}",
  )
  const slugs = [
    ...new Set(
      Object.keys(paths).map(
        (path) => path.match(/component-examples\/([^/]+)\//)![1],
      ),
    ),
  ].toSorted()

  return FRAMEWORK_IDS.flatMap((framework) =>
    slugs.map((component) => ({ params: { component, framework } })),
  )
}

const { component, framework } = Astro.params as {
  component: string
  framework: Framework
}
const examples = examplesFor(framework, component)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{`${component} - ${framework}`}</title>
  </head>
  <body>
    <main>
      {
        examples.map((example) => (
          <section class="fixture">
            <h2>{example.name}</h2>
            <div class="fixture-preview" data-example={example.name}>
              {example.framework === "astro" && <example.module.default />}
              {example.framework === "html" && (
                <Fragment set:html={example.module} />
              )}
              {example.framework === "react" && (
                <div
                  class="preview-render"
                  data-react-example={`${component}/${example.name}`}
                >
                  <example.module.default />
                </div>
              )}
              {example.framework === "svelte" && (
                <div
                  class="preview-render"
                  data-svelte-example={`${component}/${example.name}`}
                >
                  <example.module.default />
                </div>
              )}
              {example.framework === "vue" && (
                <div
                  class="preview-render"
                  data-vue-example={`${component}/${example.name}`}
                >
                  <example.module.default />
                </div>
              )}
            </div>
          </section>
        ))
      }
    </main>
    {
      component === "toast" && (
        <output
          aria-live="polite"
          id="toast-manager"
          popover="manual"
          role="status"
        />
      )
    }
    <script>
      import "../../../components/Example/mount-react-examples"
      import "../../../components/Example/mount-svelte-examples"
      import "../../../components/Example/mount-vue-examples"
      import { initToastManager } from "@opui/css/js/toast.js"

      initToastManager()
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--size-4);
  }

  .fixture h2 {
    font-size: var(--font-size-1);
    margin-block: var(--size-4) var(--size-2);
  }

  .fixture-preview {
    display: grid;
    gap: var(--size-3);
    padding: var(--size-4);
  }

  .preview-render {
    display: contents;
  }

  .example-column {
    display: grid;
    gap: var(--size-3);
  }

  .example-row {
    align-items: start;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: center;
  }

  .example-row.ui-spacious {
    gap: var(--size-6);
  }

  .example-compass {
    align-items: center;
    display: grid;
    gap: var(--size-3);
    grid-template-areas:
      ". block-start ."
      "inline-start . inline-end"
      ". block-end .";
    justify-content: center;
    justify-items: center;

    & > :nth-child(1) {
      grid-area: block-start;
    }

    & > :nth-child(2) {
      grid-area: inline-start;
    }

    & > :nth-child(3) {
      grid-area: inline-end;
    }

    & > :nth-child(4) {
      grid-area: block-end;
    }
  }
</style>
