---
import "@opui/css/imports.css"
import { FRAMEWORK_IDS, type FrameworkId } from "../../utils/framework"
import { fixturePagesEnabled } from "../../utils/test-pages"

export function getStaticPaths() {
  if (!fixturePagesEnabled()) return []
  return FRAMEWORK_IDS.filter((framework) =>
    ["react", "solid", "svelte", "vue"].includes(framework),
  ).map((framework) => ({ params: { framework } }))
}

const { framework } = Astro.params as { framework: FrameworkId }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{`Updates - ${framework}`}</title>
  </head>
  <body>
    <main></main>
    <script>
      import "../../components/Example/mount-updates"
    </script>
  </body>
</html>
