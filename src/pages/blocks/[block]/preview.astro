---
import "@opui/css/imports.css"
import "@opui/open-props.css"
import ThemeBootstrap from "../../../components/ThemeBootstrap.astro"
import { allBlocks, isFullPage } from "../../../utils/blocks"
import { testPagesEnabled } from "../../../utils/test-pages"

export function getStaticPaths() {
  return allBlocks.map((block) => ({
    params: { block: block.slug },
    props: { block },
  }))
}

const { block } = Astro.props
const fullPage = isFullPage(block.source)
const themes = testPagesEnabled()
  ? Object.fromEntries(
      Object.entries(
        import.meta.glob<string>("../../../../packages/opui/themes/*.css", {
          eager: true,
          import: "default",
          query: "?raw",
        }),
      ).map(([path, css]) => [path.match(/themes\/([^/]+)\.css$/)![1], css]),
    )
  : {}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`${block.name} - Open Props UI blocks`}</title>
    <ThemeBootstrap />
    <script is:inline>
      {
        const root = document.documentElement
        let parentRoot
        try {
          if (window.parent !== window)
            parentRoot = window.parent.document.documentElement
        } catch {}

        const sync = () => {
          root.className = parentRoot.className
          root.style.cssText = parentRoot.style.cssText
          const exampleTheme = parentRoot.dataset.exampleTheme ?? null
          if (exampleTheme !== (root.dataset.exampleTheme ?? null))
            window.themeUtils.applyExampleTheme(exampleTheme)
        }

        if (parentRoot) {
          sync()
          new MutationObserver(sync).observe(parentRoot, {
            attributeFilter: ["class", "data-example-theme", "style"],
            attributes: true,
          })
        }
      }
    </script>
  </head>
  <body>
    {
      fullPage ? (
        <div class="block-preview" data-block={block.slug}>
          <Fragment set:html={block.source} />
        </div>
      ) : (
        <main class="block-preview" data-block={block.slug}>
          <Fragment set:html={block.source} />
        </main>
      )
    }
    <script is:inline define:vars={{ themes }}>
      const theme = new URLSearchParams(location.search).get("theme")
      if (theme && Object.hasOwn(themes, theme)) {
        const style = document.createElement("style")
        style.textContent = themes[theme]
        document.head.append(style)
        document.documentElement.dataset.theme = theme
      }
    </script>
  </body>
</html>

<style is:global>
  main.block-preview {
    padding-block: var(--ui-space-6);
  }
</style>
