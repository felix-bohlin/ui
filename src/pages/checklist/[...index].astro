---
import Checklist from "../../components/Checklist/Checklist.astro"
import Document from "../../layouts/Document.astro"
import { testPagesEnabled } from "../../utils/test-pages"
import source from "../../../docs/releases/6.0.0-checklist.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}
---

<Document
  description="What to polish before releasing 6.0: scope, library, components, docs, site, package and launch. Check items off, comment and add new ones."
  showToc
>
  <Fragment slot="title">Checklist</Fragment>
  <p slot="preamble">
    The 6.0 release checklist in <code>docs/releases/6.0.0-checklist.md</code>.
    Check items off, comment on the ones that need work and add what's missing
    at the end of a section, then copy at the bottom of the page and paste it to
    an agent, which writes it into the file. Until then, checks, comments and
    new items are saved in this browser. The manual browser and screen reader
    checks are on <a class="ui-link" href="/checks/">checks</a>.
  </p>

  <Checklist
    file="docs/releases/6.0.0-checklist.md"
    source={source}
    storageKey="opui-checklist"
  />
</Document>
