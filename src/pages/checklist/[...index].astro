---
import Checklist from "../../components/Checklist/Checklist.astro"
import ChecklistMap from "../../components/Checklist/ChecklistMap.astro"
import Document from "../../layouts/Document.astro"
import { testPagesEnabled } from "../../utils/test-pages"
import source from "../../../docs/releases/6.0.0-checklist.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}
---

<Document
  description="What to polish before releasing 6.0: scope, library, components, docs, site, package and launch. Check items off, comment and add new ones."
  showToc={false}
  wide
>
  <Fragment slot="title">Checklist</Fragment>
  <p slot="preamble">
    The 6.0 polish and launch work in
    <code>docs/releases/6.0.0-checklist.md</code>. Check items off, reply and
    add what's missing, then copy your changes for an agent, which writes them
    into the file.
  </p>
  <ChecklistMap class="checks-map-sidebar" slot="sidebar" source={source} />

  <Checklist
    file="docs/releases/6.0.0-checklist.md"
    replies={["Do it", "Start working on this", "After the release", "Skip"]}
    source={source}
    storageKey="opui-checklist"
  />
</Document>
