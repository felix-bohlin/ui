---
import Checklist from "../../components/Checklist/Checklist.astro"
import ProgressMap from "../../components/Review/ProgressMap.astro"
import Document from "../../layouts/Document.astro"
import { parseChecklist } from "../../utils/checklist"
import { testPagesEnabled } from "../../utils/test-pages"
import source from "../../../docs/releases/6.0.0.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}

const { sections } = parseChecklist(source)
---

<Document
  description="Manual checks before a release. Check them off and comment on the ones that need a fix."
  showToc={false}
  wide
>
  <Fragment slot="title">Checks</Fragment>
  <p slot="preamble">
    The manual checks in <code>docs/releases/6.0.0.md</code>. Check them off as
    you go and reply on anything that needs a fix, then copy your changes for an
    agent, which writes them into the file. The polish and launch work is on the
    <a class="ui-link" href="/checklist/">checklist</a>.
  </p>
  <ProgressMap
    class="checks-map-sidebar"
    complete={["done"]}
    label="done"
    sections={sections}
    slot="sidebar"
  />

  <Checklist
    file="docs/releases/6.0.0.md"
    previews
    replies={["Fix it", "Explain further", "Skip"]}
    source={source}
    storageKey="opui-checks"
  />
</Document>
