---
import {
  Button,
  Card,
  CardActions,
  CardContent,
  CardHeader,
} from "opui-css/astro"
import "../../components/Review/review.css"
import Document from "../../layouts/Document.astro"
import { parseChecklist } from "../../utils/checklist"
import { FRAMEWORKS } from "../../utils/framework"
import {
  fixturePagesEnabled,
  stressPages,
  stressSlug,
  testPagesEnabled,
} from "../../utils/test-pages"
import { parseTodo, replyOf } from "../../utils/todo"
import checklistSource from "../../../docs/releases/6.0.0-checklist.md?raw"
import checksSource from "../../../docs/releases/6.0.0.md?raw"
import todoSource from "../../../TODO.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}

const progressOf = (source: string) => {
  const items = parseChecklist(source).sections.flatMap(
    (section) => section.items,
  )
  const done = items.filter((item) => item.stage === "done").length
  return {
    done,
    ratio: items.length ? done / items.length : 0,
    total: items.length,
  }
}

const lists = [
  {
    description: "The polish and launch work before the release.",
    file: "docs/releases/6.0.0-checklist.md",
    href: "/dev/checklist/",
    title: "Checklist",
    ...progressOf(checklistSource),
  },
  {
    description: "Browser, device and screen reader checks before the release.",
    file: "docs/releases/6.0.0.md",
    href: "/dev/checks/",
    title: "Checks",
    ...progressOf(checksSource),
  },
]

const todo = parseTodo(todoSource)
const open = todo.sections.flatMap((section) => section.items)
const done = todo.done.flatMap((section) => section.items).length
const followUps = open.filter(
  (item) => replyOf(item.notes).state === "follow-up",
).length

const stress = Object.keys(stressPages).map(stressSlug).toSorted()
---

<Document
  description="The pages for working on the library and the release: TODO, the release checklists, the stress tests and the share image."
  showToc={false}
>
  <Fragment slot="title">Dev</Fragment>
  <p slot="preamble">
    Pages for working on the library and the release. They're built by
    <code>pnpm dev</code> and with <code>OPUI_TEST_PAGES=1</code>, never on the
    live site.
  </p>

  <div class="dev-grid ui-not-rich-text">
    <Card variant="outlined">
      <CardHeader>
        <h2>TODO</h2>
      </CardHeader>
      <CardContent>
        <p class="dev-figure">
          <strong>{open.length}</strong>
          {` open, ${followUps} with a follow-up, and ${done} done.`}
        </p>
        <p>
          Answer the items in <code>TODO.md</code> and copy the answers for
          <code>/todo-answers</code>.
        </p>
      </CardContent>
      <CardActions>
        <Button href="/dev/todo/" size="small" variant="filled">Open</Button>
        <Button href="/dev/todo/done/" size="small" variant="outlined"
          >Done</Button
        >
      </CardActions>
    </Card>

    {lists.map((list) => <Card variant="outlined">
      <CardHeader>
        <h2>{list.title}</h2>
      </CardHeader>
      <CardContent>
        <p class="dev-figure">
          <strong>{list.done}</strong>
          {` of ${list.total} done`}
        </p>
        <span
          aria-hidden="true"
          class="review-meter dev-meter"
          style={`--ratio: ${list.ratio}`}
        ></span>
        <p>{list.description} From <code>{list.file}</code>.</p>
      </CardContent>
      <CardActions>
        <Button href={list.href} size="small" variant="filled">Open</Button>
      </CardActions>
    </Card>)}

    <Card variant="outlined">
      <CardHeader>
        <h2>Stress tests</h2>
      </CardHeader>
      <CardContent>
        <p>
          {`${stress.length} pages that combine many components, from `}
          <code>src/stress-tests/</code>. Add <code>?theme=</code> or
          <code>?icons=</code> to try a theme or an icon set.
        </p>
        <ul class="dev-links">
          {stress.map((name) => <li>
            <a class="ui-link" href={`/dev/tests/${name}/`}>{name}</a>
          </li>)}
        </ul>
      </CardContent>
    </Card>

    <Card variant="outlined">
      <CardHeader>
        <h2>Share image</h2>
      </CardHeader>
      <CardContent>
        <p>
          The page that <code>scripts/build-site-images.mjs</code> screenshots
          into <code>public/share-img.png</code>.
        </p>
      </CardContent>
      <CardActions>
        <Button href="/dev/share-image/" size="small" variant="outlined"
          >Open</Button
        >
      </CardActions>
    </Card>

    <Card variant="outlined">
      <CardHeader>
        <h2>Fixture pages</h2>
      </CardHeader>
      <CardContent>
        <p>
          Every example of a component in one framework, for the e2e tests, at
          <code>/&lt;framework&gt;/test/&lt;component&gt;/</code>. They stay
          next to the framework's docs because the site reads the framework from
          the first part of the path.
        </p>
        {fixturePagesEnabled() ? (
          <ul class="dev-links">
            {FRAMEWORKS.map((framework) => <li>
              <a class="ui-link" href={`/${framework.id}/test/button/`}
                >{`${framework.label} Button`}</a
              >
            </li>)}
          </ul>
        ) : (
          <p>
            Only built with <code>OPUI_TEST_PAGES=1</code>, as in
            <code>pnpm test:e2e:serve</code>.
          </p>
        )}
      </CardContent>
    </Card>
  </div>
</Document>

<style>
  .dev-grid {
    display: grid;
    gap: var(--size-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));

    h2 {
      font-size: var(--ui-font-size-large);
      margin: 0;
    }

    p {
      margin: 0;
    }
  }

  .dev-figure {
    color: var(--ui-text);

    strong {
      color: var(--ui-text-strong);
      font-size: var(--ui-font-size-large);
    }
  }

  .dev-meter {
    display: block;
    margin-block: var(--size-2);
  }

  .dev-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1) var(--size-3);
    list-style: none;
    margin: var(--size-2) 0 0;
    padding: 0;
  }
</style>
