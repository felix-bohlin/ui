---
import "@opui/css/imports.css"
import { generateHydrationScript } from "@solidjs/web"
import type { Component } from "solid-js"
import NativeReact from "../../../../tests/apps/native/Native.react"
import NativeSolid from "../../../../tests/apps/native/Native.solid"
import NativeSvelte from "../../../../tests/apps/native/Native.svelte"
import NativeVue from "../../../../tests/apps/native/Native.vue"
import OpuiReact from "../../../../tests/apps/native/Opui.react"
import OpuiSolid from "../../../../tests/apps/native/Opui.solid"
import OpuiSvelte from "../../../../tests/apps/native/Opui.svelte"
import OpuiVue from "../../../../tests/apps/native/Opui.vue"
import { renderHydratableReact } from "../../../components/Example/render-react"
import { renderHydratableSolid } from "../../../components/Example/render-solid"
import { renderHydratableSvelte } from "../../../components/Example/render-svelte"
import { renderHydratableVue } from "../../../components/Example/render-vue"
import SolidRoots from "../../../fixtures/SolidRoots.solid"
import { FRAMEWORKS, isHydratedFramework } from "../../../utils/framework"
import { fixturePagesEnabled } from "../../../utils/test-pages"

export function getStaticPaths() {
  return fixturePagesEnabled()
    ? [
        ...FRAMEWORKS.filter(({ id }) => isHydratedFramework(id)).map(
          ({ id, label }) => ({
            params: { fixture: `${id}-models` },
            props: { title: `${label} models` },
          }),
        ),
        ...FRAMEWORKS.filter(({ id }) => isHydratedFramework(id)).map(
          ({ id, label }) => ({
            params: { fixture: `${id}-native` },
            props: { title: `${label} native comparison` },
          }),
        ),
        { params: { fixture: "solid-roots" }, props: { title: "Solid roots" } },
      ]
    : []
}

const { fixture } = Astro.params
const { title } = Astro.props
const roots =
  fixture === "solid-roots"
    ? ["first-", "second-"].map((renderId) => ({
        html: renderHydratableSolid(
          SolidRoots as unknown as Component,
          renderId,
        ),
        renderId,
      }))
    : []
const NATIVE: Record<
  string,
  (side: "Native" | "Opui") => string | Promise<string>
> = {
  "react-native": (side) =>
    renderHydratableReact(
      side === "Native" ? NativeReact : OpuiReact,
      `${side}-`,
    ),
  "solid-native": (side) =>
    renderHydratableSolid(
      (side === "Native" ? NativeSolid : OpuiSolid) as unknown as Component,
      `${side}-`,
    ),
  "svelte-native": (side) =>
    renderHydratableSvelte(side === "Native" ? NativeSvelte : OpuiSvelte, side),
  "vue-native": (side) =>
    renderHydratableVue(side === "Native" ? NativeVue : OpuiVue, side),
}
const render = NATIVE[fixture]
const sides = render
  ? await Promise.all(
      (["Native", "Opui"] as const).map(async (side) => ({
        html: await render(side),
        side,
      })),
    )
  : []
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {(roots.length > 0 || fixture === "solid-native") && (
      <Fragment set:html={generateHydrationScript()} />
    )}
  </head>
  <body data-fixture={fixture}>
    <main id={fixture}>
      {roots.map((root) => (
        <div data-solid-root={root.renderId} set:html={root.html} />
      ))}
      {sides.map(({ html, side }) => (
        <div data-example={`native/${side}`} set:html={html} />
      ))}
    </main>
    <script>
      import "../../../fixtures/mount"
    </script>
  </body>
</html>
