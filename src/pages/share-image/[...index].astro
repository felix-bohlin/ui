---
import "@opui/css/imports.css"
import "@opui/open-props.css"
import { Font } from "astro:assets"
import { Button, Chip, Range, Switch } from "opui-css/astro"
import AstroLogo from "../../components/AstroLogo.astro"
import Html5Logo from "../../components/Html5Logo.astro"
import ReactLogo from "../../components/ReactLogo.astro"
import SvelteLogo from "../../components/SvelteLogo.astro"
import VueLogo from "../../components/VueLogo.astro"
import { FRAMEWORKS } from "../../utils/framework"
import { releaseVersion } from "../../utils/release"
import { testPagesEnabled } from "../../utils/test-pages"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}

const LOGOS = {
  astro: AstroLogo,
  html: Html5Logo,
  react: ReactLogo,
  svelte: SvelteLogo,
  vue: VueLogo,
}

const version = releaseVersion.split(".").slice(0, 2).join(".")

const chip = ".subject-chip .ui-chip"
const toggle = ".subject-switch input"
const button = ".subject-button .ui-button"
const range = ".subject-range input"

const labels = [
  { of: button, property: "block-size", token: "--ui-button-size" },
  {
    of: chip,
    property: "border-start-start-radius",
    token: "--ui-chip-radius",
  },
  { of: chip, property: "block-size", token: "--ui-chip-size" },
  {
    color: true,
    of: button,
    property: "background-color",
    token: "--ui-primary",
  },
  {
    of: toggle,
    property: "inline-size",
    pseudo: "::after",
    token: "--ui-switch-thumb-size",
  },
  {
    of: toggle,
    property: "inline-size",
    token: "--ui-switch-track-inline-size",
  },
  {
    color: true,
    of: range,
    property: "--_track-bg-color",
    token: "--ui-track-bg-color",
  },
]
---

<!doctype html>
<html lang="en" class="ui-light">
  <head>
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>Share image - Open Props UI</title>
  </head>
  <body>
    <main class="card">
      <div class="frame" aria-hidden="true"></div>

      <div class="copy">
        <p class="version">{version}</p>
        <h1>Open Props UI</h1>
        <p class="tagline">Design system. Components. Modern HTML &amp; CSS.</p>
        <ul class="frameworks" aria-label="Frameworks">
          {FRAMEWORKS.map((framework) => {
            const Logo = LOGOS[framework.id]
            return <li>
              <Chip size="large" variant="outlined">
                <Logo size={22} slot="start" />
                <Fragment slot="label">{framework.label}</Fragment>
              </Chip>
            </li>
          })}
        </ul>
      </div>

      <figure
        class="drawing"
        aria-label="A Chip, a Switch, a Button and a Range with their theme tokens"
        inert
      >
        <div class="subject subject-chip">
          <Chip dot label="Stable" severity="success" variant="outlined" />
        </div>
        <div class="subject subject-switch">
          <Switch checked hideLabel label="Motion" />
        </div>
        <div class="subject subject-button">
          <Button variant="filled" color="primary">Get started</Button>
        </div>
        <div class="subject subject-range">
          <Range label="Volume" value="60" valueSuffix="%" variant="tonal" />
        </div>

        <span class="dimension dimension-chip" aria-hidden="true"></span>
        <span class="dimension dimension-switch" aria-hidden="true"></span>
        <span class="dimension dimension-button" aria-hidden="true"></span>
        <span class="leader leader-chip" aria-hidden="true"></span>
        <span class="leader leader-switch" aria-hidden="true"></span>
        <span class="leader leader-primary" aria-hidden="true"></span>
        <span class="leader leader-track" aria-hidden="true"></span>

        <dl class="labels">
          {labels.map((label) => <div
            class={`label label-${label.token.replace("--ui-", "")}`}
          >
            <dt>
              <code>{label.token}</code>
            </dt>
            <dd>
              {label.color && <span class="swatch" aria-hidden="true" />}
              <output
                data-color={label.color ? "" : undefined}
                data-of={label.of}
                data-property={label.property}
                data-pseudo={label.pseudo}
              ></output>
            </dd>
          </div>)}
        </dl>
      </figure>
    </main>
  </body>
</html>

<script>
  const round = (value: string, digits: number) =>
    value.replace(/-?\d*\.\d+/g, (number) =>
      String(Number(Number(number).toFixed(digits))),
    )

  const resolveColor = (element: Element, value: string) => {
    const probe = document.createElement("span")
    probe.hidden = true
    probe.style.color = value
    element.after(probe)
    const color = getComputedStyle(probe).color
    probe.remove()
    return color
  }

  const measure = () => {
    for (const output of document.querySelectorAll<HTMLOutputElement>(
      "output[data-of]",
    )) {
      const { color, of = "", property = "", pseudo } = output.dataset
      const element = document.querySelector(of)
      if (!element) continue
      const value = getComputedStyle(element, pseudo)
        .getPropertyValue(property)
        .trim()
      output.textContent =
        color === undefined
          ? round(value, 1)
          : round(resolveColor(element, value), 3)
      output.parentElement
        ?.querySelector<HTMLElement>(".swatch")
        ?.style.setProperty("background-color", output.textContent)
    }
    document.documentElement.dataset.ready = ""
  }

  document.fonts.ready.then(measure)
</script>

<style is:global>
  html {
    --blueprint-ink: var(--ui-color-11);
    --blueprint-line-major: oklch(from var(--ui-color-9) l c h / 18%);
    --blueprint-line-strong: oklch(from var(--ui-color-9) l c h / 55%);

    background-color: var(--ui-surface);
  }

  body {
    margin: 0;
  }
</style>

<style>
  .card {
    block-size: 630px;
    inline-size: 1200px;
    isolation: isolate;
    overflow: hidden;
    position: relative;

    &::before,
    &::after {
      content: "";
      inset: 0;
      pointer-events: none;
      position: absolute;
      z-index: -1;
    }

    &::before {
      background-image: radial-gradient(
        var(--ui-text) 1.45px,
        transparent 1.45px
      );
      background-size: 20px 20px;
      opacity: 0.07;
    }

    &::after {
      background: radial-gradient(
        60% 90% at 78% 100%,
        var(--ui-primary),
        transparent
      );
      opacity: 0.18;
    }
  }

  .frame {
    border: 1px solid var(--blueprint-line-major);
    inset: 20px;
    position: absolute;
  }

  .copy {
    align-content: center;
    display: grid;
    inline-size: 540px;
    inset-block: 56px;
    inset-inline-start: 64px;
    justify-items: start;
    position: absolute;
  }

  .version {
    color: var(--ui-primary);
    font-family: var(--font-bricolage-grotesque), sans-serif;
    font-size: 250px;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.8;
    margin: 0 0 24px -10px;
  }

  h1 {
    color: var(--ui-text-strong);
    font-family: var(--font-bricolage-grotesque), sans-serif;
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .tagline {
    color: var(--ui-text);
    font-size: 26px;
    line-height: 1.3;
    margin: 16px 0 0;
    text-wrap: balance;
  }

  .frameworks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .drawing {
    font-size: 15px;
    inset: 48px 48px 48px 600px;
    margin: 0;
    position: absolute;
  }

  .subject {
    position: absolute;

    > :global(*) {
      zoom: var(--zoom);
    }
  }

  .subject-chip {
    --zoom: 1.75;

    inset-block-start: 80px;
    inset-inline-start: 56px;

    .ui-chip {
      anchor-name: --chip;
    }
  }

  .subject-switch {
    --zoom: 1.75;

    inset-block-start: 88px;
    inset-inline-end: 48px;

    input {
      anchor-name: --switch;
    }
  }

  .subject-button {
    --zoom: 2;

    inset-block-start: 236px;
    inset-inline-start: 152px;

    .ui-button {
      anchor-name: --button;
      white-space: nowrap;
    }
  }

  .subject-range {
    --zoom: 1.6;

    inline-size: 448px;
    inset-block-start: 390px;
    inset-inline-start: 56px;

    input {
      anchor-name: --range;
    }
  }

  .dimension,
  .leader {
    color: var(--blueprint-ink);
    position: absolute;
  }

  .dimension-chip,
  .dimension-button {
    border-inline-start: 1px solid currentColor;

    &::before,
    &::after {
      border-block-start: 1px solid currentColor;
      content: "";
      inline-size: 12px;
      inset-inline-start: -6.5px;
      position: absolute;
    }

    &::before {
      inset-block-start: 0;
    }

    &::after {
      inset-block-end: 0;
    }
  }

  .dimension-chip {
    inset-block: anchor(--chip top) anchor(--chip bottom);
    inset-inline-start: calc(anchor(--chip right) + 16px);
  }

  .dimension-button {
    inset-block: anchor(--button top) anchor(--button bottom);
    inset-inline-start: calc(anchor(--button right) + 16px);
  }

  .dimension-switch {
    border-block-start: 1px solid currentColor;
    inset-block-start: calc(anchor(--switch bottom) + 14px);
    inset-inline: anchor(--switch left) anchor(--switch right);

    &::before,
    &::after {
      block-size: 12px;
      border-inline-start: 1px solid currentColor;
      content: "";
      inset-block-start: -6.5px;
      position: absolute;
    }

    &::before {
      inset-inline-start: 0;
    }

    &::after {
      inset-inline-end: 0;
    }
  }

  .leader {
    border-block-start: 1px solid currentColor;
    inline-size: var(--leader-length, 5rem);
    rotate: var(--leader-angle, 0deg);
    transform-origin: 0 0;

    &::before {
      background-color: currentColor;
      block-size: 5px;
      border-radius: 50%;
      content: "";
      inline-size: 5px;
      inset-block-start: -3px;
      inset-inline-start: -2px;
      position: absolute;
    }
  }

  .leader-chip {
    --leader-angle: -135deg;
    --leader-length: 36px;

    inset-block-start: calc(anchor(--chip top) + 4px);
    inset-inline-start: calc(anchor(--chip left) + 4px);
  }

  .leader-switch {
    --leader-angle: -50deg;
    --leader-length: 44px;

    inset-block-start: anchor(--switch center);
    inset-inline-start: calc(anchor(--switch right) - 21px);
  }

  .leader-primary {
    --leader-angle: 135deg;
    --leader-length: 40px;

    inset-block-start: calc(anchor(--button bottom) - 14px);
    inset-inline-start: calc(anchor(--button left) + 28px);
  }

  .leader-track {
    --leader-angle: 50deg;
    --leader-length: 44px;

    inset-block-start: anchor(--range center);
    inset-inline-start: calc(anchor(--range right) - 70px);
  }

  .labels {
    margin: 0;
  }

  .label {
    display: grid;
    gap: 2px;
    line-height: 1.3;
    position: absolute;
    white-space: nowrap;

    dt code {
      background: none;
      color: var(--ui-text-strong);
      font-size: 14px;
      padding: 0;
    }

    dd {
      align-items: center;
      color: var(--blueprint-ink);
      display: flex;
      font-size: 14px;
      gap: 8px;
      margin: 0;
    }

    .swatch {
      block-size: 14px;
      border: 1px solid var(--blueprint-ink);
      border-radius: 3px;
      flex: none;
      inline-size: 14px;
    }
  }

  .label-chip-radius {
    inset-block-end: calc(anchor(--chip top) + 30px);
    inset-inline-start: calc(anchor(--chip left) - 24px);
  }

  .label-chip-size {
    inset-block-start: anchor(--chip center);
    inset-inline-start: calc(anchor(--chip right) + 32px);
    translate: 0 -50%;
  }

  .label-switch-thumb-size {
    inset-block-end: calc(anchor(--switch top) + 22px);
    inset-inline-end: 0;
    text-align: end;

    dd {
      justify-content: end;
    }
  }

  .label-switch-track-inline-size {
    inset-block-start: calc(anchor(--switch bottom) + 30px);
    inset-inline-end: 0;
    text-align: end;

    dd {
      justify-content: end;
    }
  }

  .label-button-size {
    inset-block-start: anchor(--button center);
    inset-inline-start: calc(anchor(--button right) + 32px);
    translate: 0 -50%;
  }

  .label-primary {
    inset-block-start: calc(anchor(--button bottom) + 18px);
    inset-inline-end: calc(anchor(--button left) - 12px);
    text-align: end;

    dd {
      justify-content: end;
    }
  }

  .label-track-bg-color {
    inset-block-start: calc(anchor(--range center) + 40px);
    inset-inline-end: 0;
    text-align: end;

    dd {
      justify-content: end;
    }
  }
</style>
