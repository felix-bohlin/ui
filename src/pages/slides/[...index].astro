---
import "@opui/css/imports.css"
import "@opui/open-props.css"
import { execFileSync } from "node:child_process"
import { readdirSync, readFileSync } from "node:fs"
import { Font } from "astro:assets"
import { Chip } from "opui-css/astro"
import AstroLogo from "../../components/AstroLogo.astro"
import Html5Logo from "../../components/Html5Logo.astro"
import NunjucksLogo from "../../components/NunjucksLogo.astro"
import ReactLogo from "../../components/ReactLogo.astro"
import Ratchets from "../../components/Release/Ratchets.astro"
import SolidLogo from "../../components/SolidLogo.astro"
import SvelteLogo from "../../components/SvelteLogo.astro"
import TokenTiers from "../../components/TokenTiers.astro"
import VueLogo from "../../components/VueLogo.astro"
import { allBlocks, blockGroups } from "../../utils/blocks"
import { posts } from "../../utils/blog-posts"
import { addedComponents, changelogSections } from "../../utils/changelog-file"
import { parseChecklist } from "../../utils/checklist"
import { components } from "../../utils/components"
import { capitalized, inWords, listOf } from "../../utils/count-words"
import { EXAMPLE_THEMES } from "../../utils/example-themes"
import {
  EXAMPLE_EXTENSIONS,
  FRAMEWORKS,
  PACKAGE_FRAMEWORK_IDS,
  type FrameworkId,
} from "../../utils/framework"
import { releaseVersion } from "../../utils/release"
import { stressPages, testPagesEnabled } from "../../utils/test-pages"
import { themeTokens } from "../../utils/theme-tokens"
import { parseTodo } from "../../utils/todo"
import { DIAGNOSTICS } from "../../../scripts/component-diagnostics.mjs"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}

const LOGOS: Record<FrameworkId, typeof AstroLogo> = {
  astro: AstroLogo,
  html: Html5Logo,
  nunjucks: NunjucksLogo,
  react: ReactLogo,
  solid: SolidLogo,
  svelte: SvelteLogo,
  vue: VueLogo,
}

const read = (file: string) => readFileSync(file, "utf8")
const filesIn = (folder: string, pattern: RegExp) =>
  readdirSync(folder).filter((file) => pattern.test(file))
const foldersIn = (folder: string) =>
  readdirSync(folder, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
const format = (value: number) => value.toLocaleString("en")
const labelOf = (id: string) =>
  FRAMEWORKS.find((framework) => framework.id === id)?.label ?? id

const changelog = read("packages/opui/CHANGELOG.md")
const newComponents = addedComponents(changelog, releaseVersion).toSorted(
  (a, b) => a.localeCompare(b, "en"),
)
const entriesOf = (title: string) =>
  changelogSections(changelog, releaseVersion).find(
    (section) => section.title === title,
  )?.entries.length ?? 0
const releases = [
  ...changelog.matchAll(/^## (\d+)\.(\d+)\.(\d+) - ((\d{4}-\d{2})-\d{2})$/gm),
].map(([, major, minor, patch, date, month]) => ({
  date,
  major,
  month,
  version: `${major}.${minor}.${patch}`,
}))
const previous = releases[0]

const EARLIER_FRAMEWORKS = new Set(["astro", "html", "vue"])
const newFrameworks = listOf(
  FRAMEWORKS.filter((framework) => !EARLIER_FRAMEWORKS.has(framework.id)).map(
    (framework) => framework.label,
  ),
)
const targets = inWords(FRAMEWORKS.length)
const compiled = PACKAGE_FRAMEWORK_IDS.filter((id) => id !== "astro")

const contrastKnobs = (
  read("packages/opui/css/theme.css")
    .match(/:where\(\.ui-contrast-more\) \{([^}]*)\}/)?.[1]
    .match(/^\s*--ui-[\w-]+:/gm) ?? []
).filter((line) => line.trim() !== "--ui-contrast:").length

const todoSource = read("TODO.md")
const todo = parseTodo(todoSource)
const itemCount = (sections: typeof todo.done) =>
  sections.reduce((total, section) => total + section.items.length, 0)
const outcomes = ["Fixed", "Explained", "Removed", "Still open"].map(
  (outcome) => ({
    count:
      todoSource.match(new RegExp(`^\\s+- ${outcome}\\b`, "gm"))?.length ?? 0,
    outcome,
  }),
)

const progressOf = (file: string) => {
  const items = parseChecklist(read(file)).sections.flatMap(
    (section) => section.items,
  )
  const done = items.filter((item) => item.stage === "done").length
  return {
    done,
    ratio: items.length ? done / items.length : 0,
    total: items.length,
  }
}

const compilerLines = [
  "scripts/build-components.mjs",
  ...filesIn("scripts", /^component-.+\.mjs$/).map((file) => `scripts/${file}`),
].reduce((total, file) => total + read(file).split("\n").length, 0)
const astroComponents = readdirSync("packages/opui/components", {
  recursive: true,
}).filter((file) => /^[^/]+\/[^/]+\.astro$/.test(String(file))).length

const APP_LABELS = new Map([
  ["eleventy", "Eleventy"],
  ["next", "Next.js"],
  ["nuxt", "Nuxt"],
  ["solid-start", "SolidStart"],
  ["sveltekit", "SvelteKit"],
])
const appFolders = foldersIn("tests/apps").filter(
  (folder) => folder !== "native",
)
const viteStarters = appFolders.filter((folder) => folder.startsWith("vite-"))
const apps = listOf([
  ...appFolders
    .filter((folder) => !folder.startsWith("vite-"))
    .map((folder) => APP_LABELS.get(folder) ?? folder),
  `${inWords(viteStarters.length)} Vite starters`,
])

const stats = {
  agents: filesIn(".claude/agents", /\.md$/).map((file) =>
    file.replace(/\.md$/, ""),
  ),
  answers: todoSource.match(/^\s+> /gm)?.length ?? 0,
  blocks: allBlocks.length,
  blockGroups: blockGroups.length,
  breaking: entriesOf("Breaking"),
  checklist: progressOf("docs/releases/6.0.0-checklist.md"),
  checks: progressOf("docs/releases/6.0.0.md"),
  codes: Object.keys(DIAGNOSTICS).length,
  compiledFiles: astroComponents * compiled.length,
  compilerLines,
  components: components.length,
  doneTodos: itemCount(todo.done),
  e2e: filesIn("tests/e2e", /\.spec\.ts$/).length,
  elements: filesIn("packages/opui/elements", /\.js$/).length,
  guides: readdirSync(".", { recursive: true })
    .map(String)
    .filter(
      (file) =>
        file.endsWith("AGENTS.md") &&
        !/(^|\/)(node_modules|dist[^/]*)\//.test(file),
    )
    .toSorted(),
  handWritten: Object.keys(
    JSON.parse(read("scripts/hand-written-components.json")),
  ).length,
  openTodos: itemCount(todo.sections),
  posts: posts.length,
  referenceApps: foldersIn("tests/reference/apps").length,
  stress: Object.keys(stressPages).length,
  themes: EXAMPLE_THEMES.length,
  tokens: themeTokens().length,
  unit: filesIn("tests/unit", /\.test\.ts$/).length,
  workflows: filesIn(".github/workflows", /\.yml$/).length,
}

const git = (...args: string[]) =>
  execFileSync("git", args, {
    encoding: "utf8",
    maxBuffer: 1 << 28,
    stdio: "pipe",
  }).trim()

const tally = (values: string[]) =>
  values.reduce(
    (counts, value) => counts.set(value, (counts.get(value) ?? 0) + 1),
    new Map<string, number>(),
  )

const recorded = {
  asOf: "2026-11-27",
  busiestDay: 234,
  byBots: 181,
  byClaude: 2586,
  byMe: 168,
  commits: 2935,
  ledgerChanges: 27,
  monthly: new Map(
    Object.entries({
      "2024-04": 6,
      "2024-08": 32,
      "2024-09": 8,
      "2024-11": 239,
      "2024-12": 196,
      "2025-01": 171,
      "2025-02": 24,
      "2025-03": 31,
      "2025-04": 20,
      "2025-05": 19,
      "2025-06": 16,
      "2025-07": 20,
      "2025-08": 16,
      "2025-09": 6,
      "2025-10": 17,
      "2025-11": 12,
      "2025-12": 11,
      "2026-01": 2,
      "2026-02": 4,
      "2026-04": 1,
      "2026-05": 41,
      "2026-06": 20,
      "2026-07": 1,
      "2026-09": 122,
      "2026-10": 1237,
      "2026-11": 1577,
    }),
  ),
  sessions: 255,
  weeks: 10,
}

const fromGit = () => {
  try {
    if (git("rev-parse", "--is-shallow-repository") === "true") return
    const release = git(
      "log",
      `-S"version": "${previous.version}"`,
      "--format=%H",
      "--",
      "packages/opui/package.json",
    )
      .split("\n")
      .filter(Boolean)
      .at(-1)
    if (!release) return
    const range = `${release}..HEAD`
    const authors = git("log", "--format=%an", range).split("\n")
    const bodies = git("log", "--format=%b", range)
    const days = tally(
      git("log", "--format=%ad", "--date=short", range).split("\n"),
    )
    const day = 24 * 60 * 60 * 1000
    const dateOf = (ref: string) =>
      git("show", "-s", "--format=%ad", "--date=short", ref)
    return {
      asOf: dateOf("HEAD"),
      busiestDay: Math.max(...days.values()),
      byBots: authors.filter((author) => author.endsWith("[bot]")).length,
      byClaude: authors.filter((author) => author === "Claude").length,
      byMe: authors.filter(
        (author) => author !== "Claude" && !author.endsWith("[bot]"),
      ).length,
      commits: authors.length,
      ledgerChanges: bodies.match(/^Ledger-Change: intended$/gm)?.length ?? 0,
      monthly: tally(
        git("log", "--format=%ad", "--date=format:%Y-%m").split("\n"),
      ),
      sessions: new Set(bodies.match(/claude\.ai\/code\/session_\w+/g)).size,
      weeks: Math.round(
        (Date.parse(dateOf("HEAD")) - Date.parse(dateOf(release))) / (7 * day),
      ),
    }
  } catch {
    return
  }
}

const history = fromGit() ?? recorded
const claudeShare = Math.round((history.byClaude / history.commits) * 100)

const monthName = (month: string) =>
  new Date(`${month}-01T00:00:00Z`).toLocaleString("en", {
    month: "short",
    timeZone: "UTC",
    year: "numeric",
  })
const dayOf = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleString("en", {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
  })
const asOf = dayOf(history.asOf)
const months = (() => {
  const known = [...history.monthly.keys()].toSorted()
  const [year, month] = known[0].split("-").map(Number)
  const all: string[] = []
  for (
    let date = new Date(Date.UTC(year, month - 1));
    date.toISOString().slice(0, 7) <= known.at(-1)!;
    date.setUTCMonth(date.getUTCMonth() + 1)
  ) {
    all.push(date.toISOString().slice(0, 7))
  }
  return all.map((key) => [key, history.monthly.get(key) ?? 0] as const)
})()
const markers = new Map<string, string[]>()
const mark = (month: string, label: string) =>
  markers.set(month, [...(markers.get(month) ?? []), label])
for (const major of new Set(releases.map((release) => release.major))) {
  mark(
    releases.findLast((release) => release.major === major)!.month,
    `${major}.0`,
  )
}
mark(previous.month, previous.version)
const markerOf = (month: string) =>
  listOf(
    (markers.get(month) ?? []).toSorted((a, b) =>
      a.localeCompare(b, "en", { numeric: true }),
    ),
  )
const cycle = months.filter(([month]) => month >= previous.month)
const before = months.filter(([month]) => month < previous.month)
const peaks = new Set([
  before.toSorted((a, b) => b[1] - a[1])[0]?.[0],
  months.toSorted((a, b) => b[1] - a[1])[0][0],
])
const maxCommits = Math.max(...months.map(([, count]) => count))
const bars = months.map(([month, count], index) => ({
  count,
  cycle: month >= previous.month,
  label: monthName(month),
  peak: peaks.has(month),
  release: markerOf(month),
  year: month.endsWith("-01") || index === 0 ? month.slice(0, 4) : "",
}))

const themeFrames = [
  { label: "Default", src: "/dev/tests/forms/" },
  ...EXAMPLE_THEMES.map((theme) => ({
    label: theme.label,
    src: `/dev/tests/forms/?theme=${theme.name}`,
  })),
]

const flat = (source: string) =>
  source.replace(/\/\/.*$/gm, "").replace(/\s+/g, " ")
const CARD_ACTIONS: Record<string, { cells: string[]; note?: string }> = {
  astro: {
    cells: [
      "const { align, class: className, ...rest } = Astro.props",
      "class:list={[…]}",
      "{...rest}",
      "<slot />",
    ],
    note: "written by hand",
  },
  nunjucks: {
    cells: [
      "{% macro CardActions(props = {}) %}",
      'class="ui-actions {%- if …%}"',
      "{{- rest | opuiAttributes }}",
      "{{- caller() if caller -}}",
    ],
  },
  react: {
    cells: [
      "function CardActions({ align, className, children, ...rest }",
      "className={cx([…])}",
      "{...rest}",
      "{children}",
    ],
  },
  solid: {
    cells: [
      'const rest = omit(props, "align", "class", "children")',
      "class={[…]}",
      "{...rest}",
      "{props.children}",
    ],
  },
  svelte: {
    cells: [
      "let { align, class: className, children, ...rest }: Props = $props()",
      "class={[…]}",
      "{...rest}",
      "{@render children?.()}",
    ],
  },
  vue: {
    cells: [
      "const { align } = defineProps<Props>()",
      ':class="[…]"',
      "(falls through to the root)",
      "<slot></slot>",
    ],
  },
}
const outputs = PACKAGE_FRAMEWORK_IDS.map((id) => {
  const row = CARD_ACTIONS[id]
  if (!row) throw new Error(`slides: no CardActions row for ${id}`)
  const file = `packages/opui/components/Card/CardActions.${EXAMPLE_EXTENSIONS[id]}`
  const source = flat(read(file))
  for (const cell of row.cells) {
    if (cell.startsWith("(")) continue
    if (!source.includes(flat(cell.split("…")[0]))) {
      throw new Error(`slides: ${file} lacks ${cell}`)
    }
  }
  return { ...row, label: labelOf(id) }
})

const agentNotes: Record<string, string> = {
  a11y: "what axe can't catch",
  "api-docs": "api.ts against the props and the CSS",
  blog: "posts against the CSS they explain",
  "browser-support": "web-features ids on every page",
  changelog: "CHANGELOG, What's new, MIGRATING",
  css: "quality and modern CSS",
  examples: "coverage and consistency",
  "framework-idioms": "code an expert wouldn't write",
  "framework-parity": `${targets} targets in sync`,
}
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Open Props UI 6.0 - Slides</title>
  </head>
  <body>
    <span aria-hidden="true" class="deck-progress"></span>
    <main class="deck" aria-roledescription="slide deck">
      <section class="slide" aria-label="Title">
        <div class="stage">
          <div class="frame frame-title">
            <p class="eyebrow">opui.dev</p>
            <h1>Open Props UI <span class="accent">6.0</span></h1>
            <p class="lede">
              A design system for {targets} targets, and
              {format(history.commits)} commits with Claude Code
            </p>
            <ul class="logos" aria-label="Frameworks">
              {FRAMEWORKS.map((framework) => {
                const Logo = LOGOS[framework.id]
                return <li>
                  <Chip size="large" variant="outlined">
                    <Logo size={22} slot="start" />
                    <Fragment slot="label">{framework.label}</Fragment>
                  </Chip>
                </li>
              })}
            </ul>
            <p class="byline">Felix Bohlin</p>
            <p class="keys">
              <kbd>→</kbd> next <kbd>F</kbd> fullscreen <kbd>P</kbd> presenter
              window <kbd>N</kbd> notes <kbd>D</kbd> dark
            </p>
          </div>
        </div>
        <aside class="notes">
          <p>
            0:00. Hi. Two parts: a little background on what Open Props UI is,
            then most of the time on 6.0, and on how I built it with Claude
            Code.
          </p>
          <p>
            The second number on this slide is the real topic: almost all of
            those commits came out of Claude Code sessions in
            {inWords(history.weeks)} weeks.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="What is Open Props UI">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">Background</p>
            <h2>Design system. Components. Modern HTML &amp; CSS.</h2>
            <div class="columns">
              <div class="panel">
                <h3>CSS first</h3>
                <p>
                  A component is its stylesheet and the native HTML it styles.
                </p>
              </div>
              <div class="panel">
                <h3>HTML is a target</h3>
                <p>
                  Copy the markup, no framework needed. The frameworks are
                  bindings on top.
                </p>
              </div>
              <div class="panel">
                <h3>Feature first</h3>
                <p>
                  A new HTML or CSS feature is used as soon as one engine ships
                  it.
                </p>
              </div>
            </div>
            <p class="footnote">
              Built on Open Props. The shadcn model: grab it, make it yours.
            </p>
          </div>
        </div>
        <aside class="notes">
          <p>
            0:30. Open Props UI is a component library and design system where
            the CSS is the product.
          </p>
          <p>
            Three ideas from day one: CSS first, plain HTML as a real target,
            and feature first: use the new platform features as soon as one
            browser ships them.
          </p>
          <p>
            Like shadcn: I do the hard work, you take it and make it your own.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="Where it started">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">Background</p>
            <h2>Where it started</h2>
            <blockquote class="quote">
              <p>
                I wanted to build that library, learn all the cool tricks and
                techniques and ultimately pass them on.
              </p>
            </blockquote>
            <ul class="points">
              <li>Everything written by hand</li>
              <li>
                Pragmatic, readable CSS that anyone at any level could grasp and
                modify
              </li>
              <li>Inspiring at least one person was a win</li>
            </ul>
            <p class="kicker">That was then.</p>
          </div>
        </div>
        <aside class="notes">
          <p>
            2:00. The library that uses modern CSS and HTML didn't seem to
            exist, so I wanted to build it, and learn the tricks on the way.
          </p>
          <p>
            Readability was a hard rule: someone should be able to open a
            stylesheet and get it.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="Commits per month">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">Background</p>
            <h2>Commits per month since 2024</h2>
            <figure class="chart">
              <ol class="bars" style={`--max: ${maxCommits}`}>
                {bars.map((bar) => <li
                  class:list={["bar", { cycle: bar.cycle, peak: bar.peak }]}
                  data-tip={`${bar.label}: ${format(bar.count)}`}
                  style={`--n: ${bar.count}`}
                >
                  <span class="bar-fill"></span>
                  {bar.peak && <span aria-hidden="true" class="bar-value"
                    >{format(bar.count)}</span
                  >}
                  <span class="ui-sr-only"
                    >{`${bar.label}: ${format(bar.count)} commits`}</span
                  >
                  <span aria-hidden="true" class="bar-year">{bar.year}</span>
                  {bar.release && <span class="bar-release"
                    >{bar.release}</span
                  >}
                </li>)}
              </ol>
              <figcaption>
                <span class="cycle-label">The 6.0 cycle</span>
                {listOf(
                  cycle.map(
                    ([month, count]) =>
                      `${format(count)} in ${monthName(month)}`,
                  ),
                )}.
                Releases under the axis, counted to {asOf}.
              </figcaption>
            </figure>
          </div>
        </div>
        <aside class="notes">
          <p>
            3:00. Two and a half years in one picture. The first bump is the
            road to 1.0 at the end of 2024, a couple of hundred commits a month
            by hand.
          </p>
          <p>
            Then 2.0, 3.0, 4.0 and 5.0, all quiet months. And then the 6.0
            cycle: more than a thousand commits a month in October and November.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="The scope changed">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">6.0</p>
            <h2>The core stayed. The scope changed.</h2>
            <blockquote class="quote">
              <p>
                Since AI has gotten so good that writing anything by hand has
                become unnecessary, the core concepts stayed but the scope
                changed.
              </p>
            </blockquote>
            <p class="big">
              One CSS codebase flexible enough for shadcn, Material, Bootstrap
              or a brutalist experiment.
            </p>
            <p class="footnote">
              The CSS got less readable. The docs got a lot better to make up
              for it.
            </p>
          </div>
        </div>
        <aside class="notes">
          <p>
            4:30. I always had the 6.0 architecture in mind, but it didn't feel
            approachable, and I didn't think I could maintain it as a hobby.
          </p>
          <p>
            With agents doing the typing, I could go for the original vision: if
            one codebase can be shadcn, Material and brutalist, it can be your
            design too.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="6.0 at a glance">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">6.0</p>
            <h2>6.0 at a glance</h2>
            <ul class="tiles">
              <li>
                <strong>{FRAMEWORKS.length}</strong> targets:
                {listOf(FRAMEWORKS.map((framework) => framework.label))}
              </li>
              <li><strong>{stats.components}</strong> components</li>
              <li><strong>{newComponents.length}</strong> of them new</li>
              <li><strong>{stats.themes}</strong> example themes</li>
              <li><strong>{format(stats.tokens)}</strong> theme tokens</li>
              <li><strong>{stats.blocks}</strong> blocks</li>
              <li><strong>{stats.posts}</strong> blog posts</li>
              <li>
                <strong>{stats.breaking}</strong> breaking changelog entries
              </li>
            </ul>
          </div>
        </div>
        <aside class="notes">
          <p>
            5:30. The headline numbers. They're computed from the repo when the
            page builds.
          </p>
          <p>
            {newFrameworks} are new targets, next to HTML, Astro and Vue. It's
            the first major since 5.0, and a lot of the breaking entries are
            plain renames.
          </p>
        </aside>
      </section>

      <section class="slide" aria-label="Token tiers">
        <div class="stage">
          <div class="frame">
            <p class="eyebrow">6.0: a proper design system</p>
            <h2>Token tiers</h2>
            <div class="embed" style="--zoom: 0.66">
              <TokenTiers />
            </div>
          </div>
        </div>
        <aside class="notes">
          <p>
            6:30. Read a column top to bottom: a knob the theme sets, the role
            every component with that job reads, an optional component token,
