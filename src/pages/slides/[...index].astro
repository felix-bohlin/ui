<script>
  const deck = document.querySelector<HTMLElement>(".deck")!
  const slides = [...deck.querySelectorAll<HTMLElement>(".slide")]
  const count = document.querySelector<HTMLOutputElement>(".hud-count")!
  const next = document.querySelector<HTMLElement>(".hud-next")!
  const timer = document.querySelector<HTMLElement>(".hud-timer")!
  const channel = new BroadcastChannel("opui-slides")
  const root = document.documentElement
  const started = Date.now()
  let index = 0

  const titleOf = (slide?: HTMLElement) =>
    slide?.querySelector("h1, h2")?.textContent?.replace(/\s+/g, " ").trim() ??
    ""

  const clamp = (value: number) =>
    Math.min(slides.length - 1, Math.max(0, value))

  const update = () => {
    count.value = `${index + 1} / ${slides.length}`
    next.textContent = slides[index + 1]
      ? `Next: ${titleOf(slides[index + 1])}`
      : "Last slide"
    slides.forEach((slide, i) => {
      slide.inert = i !== index
    })
    history.replaceState(null, "", `${location.search}#${index + 1}`)
  }

  const show = (target: number, broadcast = true) => {
    index = clamp(target)
    deck.scrollTo({ left: index * deck.clientWidth })
    update()
    if (broadcast) channel.postMessage(index)
  }

  const setPresenter = (on: boolean) => {
    root.classList.toggle("presenter", on)
    timer.hidden = !on
    next.hidden = !on
    show(index, false)
  }

  deck.addEventListener("scrollend", () => {
    const settled = clamp(Math.round(deck.scrollLeft / deck.clientWidth))
    if (settled === index) return
    index = settled
    update()
    channel.postMessage(index)
  })

  channel.addEventListener("message", (event) => {
    if (typeof event.data === "number") show(event.data, false)
  })

  addEventListener("resize", () => show(index, false))

  addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey) return
    if ((event.target as Element).closest("input, select, textarea")) return
    const steps: Record<string, number> = {
      " ": event.shiftKey ? -1 : 1,
      ArrowDown: 1,
      ArrowLeft: -1,
      ArrowRight: 1,
      ArrowUp: -1,
      PageDown: 1,
      PageUp: -1,
    }
    const key = event.key.toLowerCase()
    if (event.key in steps) show(index + steps[event.key])
    else if (event.key === "Home") show(0)
    else if (event.key === "End") show(slides.length - 1)
    else if (key === "f") {
      if (document.fullscreenElement) document.exitFullscreen()
      else root.requestFullscreen()
    } else if (key === "n") setPresenter(!root.classList.contains("presenter"))
    else if (key === "p") {
      open(
        `${location.pathname}?presenter#${index + 1}`,
        "opui-slides-presenter",
      )
    } else if (key === "d") {
      const dark =
        root.classList.contains("ui-dark") ||
        (!root.classList.contains("ui-light") &&
          matchMedia("(prefers-color-scheme: dark)").matches)
      root.classList.toggle("ui-dark", !dark)
      root.classList.toggle("ui-light", dark)
    } else return
    event.preventDefault()
  })

  setInterval(() => {
    const seconds = Math.floor((Date.now() - started) / 1000)
    timer.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
  }, 1000)

  for (const shot of document.querySelectorAll<HTMLElement>(".shot")) {
    new ResizeObserver(([entry]) => {
      shot.style.setProperty("--scale", String(entry.contentRect.width / 1280))
    }).observe(shot)
  }

  index = clamp(Number(location.hash.slice(1)) - 1 || 0)
  setPresenter(new URLSearchParams(location.search).has("presenter"))
  deck.focus()
</script>

