---
import "@opui/css/imports.css"
import "@opui/open-props.css"
import {
  stressPages,
  stressSlug,
  testPagesEnabled,
} from "../../utils/test-pages"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }]
}

const pages = Object.keys(stressPages).map(stressSlug).toSorted()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Stress tests</title>
  </head>
  <body>
    <main class="ui-rich-text">
      <h1>Stress tests</h1>
      <ul>
        {
          pages.map((name) => (
            <li>
              <a href={`/tests/${name}/`}>{name}</a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: var(--size-4);
  }
</style>
