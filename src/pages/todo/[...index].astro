---
import {
  Accordion,
  AccordionContent,
  AccordionSummary,
  Button,
  Checkbox,
  Chip,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Radio,
  Select,
  ToggleButton,
} from "opui-css/astro"
import CommentField from "../../components/Todo/CommentField.astro"
import CopyFallback from "../../components/Todo/CopyFallback.astro"
import InlineText from "../../components/Todo/InlineText.astro"
import TodoNotes from "../../components/Todo/TodoNotes.astro"
import Document from "../../layouts/Document.astro"
import {
  actionValues,
  fixOptions,
  parseTodo,
  plainText,
  slugify,
  stressRefs,
} from "../../utils/todo"
import {
  stressPages,
  stressSlug,
  testPagesEnabled,
} from "../../utils/test-pages"
import { todoExamplesFor } from "../../utils/todo-examples"
import source from "../../../TODO.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }, { params: { index: "done" } }]
}

const showDone = Astro.params.index === "done"
const { done, sections: open } = parseTodo(source)
const sections = showDone ? done : open
const itemCount = (list: typeof done) =>
  list.reduce((total, section) => total + section.items.length, 0)
const stressExamples = Object.fromEntries(
  Object.entries(stressPages).map(([path, html]) => [
    stressSlug(path),
    new Set(
      [...html.matchAll(/data-example="([^"]+)"/g)].map(([, name]) => name),
    ),
  ]),
)

const examplesFor = (text: string) => {
  const scheme = /\bdark mode\b/i.test(text)
    ? "dark"
    : /\blight mode\b/i.test(text)
      ? "light"
      : undefined
  const query = scheme ? `scheme=${scheme}` : ""

  return [
    ...stressRefs(text)
      .filter(({ example, page }) => stressExamples[page]?.has(example))
      .map(({ example, page }) => ({
        label: `${page} ${example}`,
        scheme,
        src: `/tests/${page}/?example=${example}${query && `&${query}`}`,
      })),
    ...todoExamplesFor(text).map((name) => ({
      label: name,
      scheme,
      src: `/todo/example/${name}/${query && `?${query}`}`,
    })),
  ]
}

const chipSeverity = (severity = 0) =>
  severity >= 7
    ? "critical"
    : severity >= 4
      ? "warning"
      : severity === 3
        ? "info"
        : "neutral"

const todoSections = sections.map((section) => ({
  ...section,
  items: section.items
    .map((item) => ({
      ...item,
      ...fixOptions(item.notes),
      examples: examplesFor(item.text),
    }))
    .toSorted((a, b) => (b.severity ?? 0) - (a.severity ?? 0)),
}))

const components = [
  ...new Set(
    sections.flatMap((section) =>
      section.items.map((item) => item.component ?? "Other"),
    ),
  ),
].toSorted((a, b) => a.localeCompare(b))

const actions = ["None", ...actionValues]

const count = itemCount(sections)
---

<Document
  description={showDone
    ? "Check the fixed todos in TODO.md against their examples."
    : "Comment on the todos in TODO.md and copy them with your comments."}
  showToc
>
  <Fragment slot="title">{showDone ? "Done" : "TODO"}</Fragment>
  <p slot="preamble">
    {
      showDone ? (
        <a class="ui-link" href="/todo/">{`Open (${itemCount(open)})`}</a>
      ) : (
        <a class="ui-link" href="/todo/done/">{`Done (${itemCount(done)})`}</a>
      )
    }
  </p>

  <form class="todo-filters ui-not-rich-text" id="todo-filters">
    <Select
      id="todo-filter-section"
      items={[
        { label: "All sections", value: "" },
        ...sections.map((section) => ({
          label: section.title,
          value: slugify(section.title),
        })),
      ]}
      label="Section"
      size="small"
    />
    <Select
      id="todo-filter-severity"
      items={[
        { label: "All severities", value: "" },
        { label: "1", value: "1" },
        { label: "2", value: "2" },
        { label: "3", value: "3" },
        { label: "4 and up", value: "4" },
      ]}
      label="Severity"
      size="small"
    />
    <Select
      id="todo-filter-component"
      items={[
        { label: "All components", value: "" },
        ...components.map((component) => ({
          label: component,
          value: slugify(component),
        })),
      ]}
      label="Component"
      size="small"
    />
    <ToggleButton id="todo-filter-unanswered" size="small">
      Unanswered only
    </ToggleButton>
  </form>
  <p class="todo-shortcuts">
    <kbd>j</kbd>
    <kbd>k</kbd> next and previous todo, <kbd>n</kbd> next unanswered, <kbd
      >a</kbd
    > accept, <kbd>1</kbd> to <kbd>5</kbd> actions, <kbd>c</kbd> comment, <kbd
      >e</kbd
    > details.
  </p>

  {
    todoSections.map((section) => (
      <section
        data-todo-section={section.title}
        data-todo-section-slug={slugify(section.title)}
      >
        <h2 id={slugify(section.title)}>{section.title}</h2>
        <ol class="todo-list ui-not-rich-text">
          {section.items.map((item, index) => (
            <li
              class="todo-item"
              data-todo-component={slugify(item.component ?? "Other")}
              data-todo-key={slugify(item.text)}
              data-todo-line={item.line}
              data-todo-recommended={item.recommended?.action}
              data-todo-severity={item.severity}
            >
              <button class="todo-summary" type="button">
                <span class="todo-summary-text">
                  <InlineText text={item.summary ?? item.text} />
                </span>
                <span class="todo-summary-answer" />
              </button>
              <div class="todo-head" tabindex="-1">
                {item.severity && (
                  <Chip
                    class="todo-severity"
                    dot
                    label={`Severity ${item.severity}`}
                    severity={chipSeverity(item.severity)}
                    size="small"
                    variant="tonal"
                  />
                )}
                {item.component && (
                  <strong class="todo-component">{item.component}</strong>
                )}
                <span class="todo-headline">
                  <InlineText text={item.summary ?? item.headline} />
                </span>
              </div>
              {item.summary ? (
                <Accordion class="todo-details" variant="outlined">
                  <AccordionSummary>Details</AccordionSummary>
                  <AccordionContent>
                    <p class="todo-text">
                      <InlineText text={item.headline} />
                    </p>
                    <TodoNotes notes={item.notes} />
                    {item.files.length > 0 && (
                      <ul class="todo-files">
                        {item.files.map((file) => (
                          <li>
                            <code>{file}</code>
                          </li>
                        ))}
                      </ul>
                    )}
                  </AccordionContent>
                </Accordion>
              ) : (
                <TodoNotes notes={item.notes} />
              )}
              {item.examples.length > 0 && (
                <Accordion class="todo-examples" variant="outlined">
                  <AccordionSummary>
                    {item.examples.length === 1
                      ? "Example"
                      : `Examples (${item.examples.length})`}
                  </AccordionSummary>
                  <AccordionContent>
                    {item.examples.map((example) => (
                      <figure class="todo-example">
                        <figcaption>
                          <code>{example.label}</code>
                          <a
                            class="ui-link"
                            href={example.src}
                            rel="noopener"
                            target="_blank"
                          >
                            Open in a new tab
                          </a>
                        </figcaption>
                        <iframe
                          data-scheme={example.scheme}
                          data-src={example.src}
                          title={`${example.label} example`}
                        />
                      </figure>
                    ))}
                  </AccordionContent>
                </Accordion>
              )}
              {item.recommended && (
                <p class="todo-recommended">
                  <span>
                    Recommended:{" "}
                    <strong>
                      {`${item.recommended.action}${item.recommended.reason ? "." : ""}`}
                    </strong>
                    {item.recommended.reason && (
                      <InlineText text={item.recommended.reason} />
                    )}
                  </span>
                  <Button
                    class="todo-accept"
                    data-accept
                    size="small"
                    variant="outlined"
                  >
                    Accept
                  </Button>
                </p>
              )}
              <CommentField text={item.text} />
              <Fieldset class="todo-actions-field">
                <FieldLegend class="ui-sr-only">
                  {`Actions for: ${plainText(item.text)}`}
                </FieldLegend>
                <FieldGroup
                  class="todo-action-row"
                  orientation="horizontal"
                  name={`todo-action-${slugify(section.title)}-${index}`}
                >
                  {actions
                    .filter(
                      (action) => !item.options.length || action !== "Fix",
                    )
                    .map((action) => (
                      <ToggleButton
                        class="todo-action"
                        checked={action === "None"}
                        size="small"
                        type="radio"
                        value={action}
                      >
                        {action}
                        {item.recommended?.action === action && (
                          <span class="todo-mark">Recommended</span>
                        )}
                      </ToggleButton>
                    ))}
                </FieldGroup>
                {item.options.length > 0 && (
                  <Fieldset class="todo-fix-options">
                    <FieldLegend>{item.legend}</FieldLegend>
                    <FieldGroup
                      name={`todo-action-${slugify(section.title)}-${index}`}
                    >
                      {item.options.map((option) => (
                        <div
                          class:list={[
                            "todo-fix-option",
                            {
                              "is-recommended":
                                item.recommended?.action ===
                                `Fix with option ${option.id}`,
                            },
                          ]}
                        >
                          <Radio
                            class="todo-action"
                            size="small"
                            spread
                            value={`Fix with option ${option.id}`}
                          >
                            {option.note
                              ? `Option ${option.id} (${option.note})`
                              : `Option ${option.id}`}
                            {item.recommended?.action ===
                              `Fix with option ${option.id}` && (
                              <span class="todo-mark">Recommended</span>
                            )}
                            <Fragment slot="end-text">
                              <InlineText text={option.text} />
                            </Fragment>
                          </Radio>
                          <TodoNotes notes={option.notes} />
                        </div>
                      ))}
                    </FieldGroup>
                  </Fieldset>
                )}
              </Fieldset>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <h2 id="copy">Copy</h2>

  <section class="todo-copy ui-not-rich-text">
    <Checkbox checked id="todo-only-commented">Only answered todos</Checkbox>
    <Button id="todo-clear" variant="outlined">Clear all</Button>
    <CopyFallback label="Todos and comments" />
  </section>

  <div class="todo-dock ui-not-rich-text">
    <p class="todo-count" id="todo-count">
      {`0/${count}`}<span class="todo-count-label"> answered</span>
    </p>
    <p class="todo-status" id="todo-status" role="status"></p>
    <ToggleButton id="todo-hide-answered" size="small"
      >Hide answered</ToggleButton
    >
    <Button id="todo-next" size="small" variant="outlined">Next</Button>
    <Button id="todo-copy" size="small" variant="filled">Copy</Button>
  </div>
</Document>

<script>
  import { copyOrSelect, trackComments } from "../../components/Todo/comments"
  import { readStored, writeStored } from "../../utils/storage"

  const storageKey = "opui-todo-comments"
  const actionsKey = "opui-todo-actions"

  const readActions = () => readStored<Record<string, string>>(actionsKey, {})
  const writeActions = (actions: Record<string, string>) =>
    writeStored(actionsKey, actions)

  const items = [...document.querySelectorAll<HTMLElement>(".todo-item")]
  const keyOf = (item: HTMLElement) => item.dataset.todoKey!
  const headOf = (item: HTMLElement) =>
    item.querySelector<HTMLElement>(".todo-head")!
  const actionsOf = (item: HTMLElement) => [
    ...item.querySelectorAll<HTMLInputElement>(".todo-action input"),
  ]
  const checkedAction = (item: HTMLElement) => {
    const value = actionsOf(item).find((input) => input.checked)?.value
    return value === "None" ? undefined : value
  }
  const status = document.querySelector("#todo-status")!
  const onlyCommented = document.querySelector<HTMLInputElement>(
    "#todo-only-commented",
  )!

  let statusTimer = 0
  const setStatus = (text: string) => {
    clearTimeout(statusTimer)
    status.textContent = text
    statusTimer = window.setTimeout(() => (status.textContent = ""), 5000)
  }

  const notSaved = () =>
    setStatus(
      "Comments can't be saved in this browser. Copy them before leaving the page.",
    )

  const comments = trackComments({
    items,
    keyOf,
    onError: notSaved,
    storageKey,
  })

  const saveActions = (item: HTMLElement) => {
    const key = keyOf(item)
    const checked = checkedAction(item)
    const actions = readActions()
    if (checked) actions[key] = checked
    else delete actions[key]
    if (!writeActions(actions)) notSaved()
  }

  const answerOf = (item: HTMLElement) =>
    [checkedAction(item), comments.commentOf(item)].filter(Boolean).join(": ")

  const filters = {
    component: document.querySelector<HTMLSelectElement>(
      "#todo-filter-component",
    )!,
    section: document.querySelector<HTMLSelectElement>("#todo-filter-section")!,
    severity: document.querySelector<HTMLSelectElement>(
      "#todo-filter-severity",
    )!,
    unanswered: document.querySelector<HTMLInputElement>(
      "#todo-filter-unanswered",
    )!,
  }

  const matchesFilters = (item: HTMLElement) => {
    const section = item.closest<HTMLElement>("[data-todo-section-slug]")!
    const severity = Number(item.dataset.todoSeverity ?? 0)
    const wanted = Number(filters.severity.value)
    return (
      (!filters.section.value ||
        section.dataset.todoSectionSlug === filters.section.value) &&
      (!filters.severity.value ||
        (wanted >= 4 ? severity >= 4 : severity === wanted)) &&
      (!filters.component.value ||
        item.dataset.todoComponent === filters.component.value) &&
      (!filters.unanswered.checked || !answerOf(item))
    )
  }

  const visibleItems = () => items.filter((item) => !item.hidden)

  const answerCount = document.querySelector("#todo-count")!
  const countAnswered = () => {
    const visible = visibleItems()
    const answered = visible.filter(answerOf).length
    const hidden = items.length - visible.length
    const label = document.createElement("span")
    label.className = "todo-count-label"
    label.textContent = " answered"
    answerCount.replaceChildren(`${answered}/${visible.length}`, label)
    if (hidden) {
      const link = document.createElement("a")
      link.className = "ui-link"
      link.href = "#todo-filters"
      link.textContent = `${hidden} hidden`
      answerCount.append(", ", link)
    }
  }

  const applyFilters = () => {
    for (const item of items) item.hidden = !matchesFilters(item)
    for (const section of document.querySelectorAll<HTMLElement>(
      "[data-todo-section]",
    ))
      section.hidden = !section.querySelector(".todo-item:not([hidden])")
    countAnswered()
  }

  const syncFiltersToUrl = () => {
    const params = new URLSearchParams(location.search)
    for (const [name, control] of Object.entries(filters)) {
      const value =
        control instanceof HTMLInputElement
          ? control.checked
            ? "1"
            : ""
          : control.value
      if (value) params.set(name, value)
      else params.delete(name)
    }
    const query = params.toString()
    history.replaceState(
      null,
      "",
      `${location.pathname}${query ? `?${query}` : ""}${location.hash}`,
    )
  }

  const readFiltersFromUrl = () => {
    const params = new URLSearchParams(location.search)
    for (const [name, control] of Object.entries(filters)) {
      const value = params.get(name) ?? ""
      if (control instanceof HTMLInputElement) control.checked = value === "1"
      else if ([...control.options].some((option) => option.value === value))
        control.value = value
    }
  }

  for (const control of Object.values(filters))
    control.addEventListener("change", () => {
      syncFiltersToUrl()
      applyFilters()
    })

  const hideKey = "opui-todo-hide-answered"
  const hideAnswered = document.querySelector<HTMLInputElement>(
    "#todo-hide-answered",
  )!
  const collapseAnswered = () => {
    for (const item of items) {
      const answer = hideAnswered.checked ? answerOf(item) : ""
      item.classList.toggle("is-collapsed", Boolean(answer))
      item.querySelector(".todo-summary-answer")!.textContent = answer
    }
  }

  hideAnswered.checked = readStored(hideKey, false)
  hideAnswered.addEventListener("change", () => {
    writeStored(hideKey, hideAnswered.checked)
    collapseAnswered()
  })

  const expand = (item: HTMLElement) => {
    item.classList.remove("is-collapsed")
    headOf(item).focus({ preventScroll: true })
  }

  for (const item of items)
    item
      .querySelector(".todo-summary")!
      .addEventListener("click", () => expand(item))

  for (const item of items)
    item
      .querySelector("textarea")!
      .addEventListener("input", () => countAnswered())

  const savedActions = readActions()
  for (const item of items) {
    for (const input of actionsOf(item)) {
      input.checked = (savedActions[keyOf(item)] ?? "None") === input.value
      input.addEventListener("change", () => {
        saveActions(item)
        countAnswered()
      })
    }
  }

  const accept = (item: HTMLElement) => {
    const recommended = item.dataset.todoRecommended
    const input = actionsOf(item).find((input) => input.value === recommended)
    if (!input) return
    input.checked = true
    input.dispatchEvent(new Event("change", { bubbles: true }))
    collapseAnswered()
    setStatus(`Accepted: ${recommended}`)
  }

  for (const item of items)
    item
      .querySelector("[data-accept]")
      ?.addEventListener("click", () => accept(item))

  let lastItem: HTMLElement | undefined

  const currentItem = () =>
    document.activeElement?.closest<HTMLElement>(".todo-item") ??
    (lastItem && !lastItem.hidden ? lastItem : undefined)

  const goTo = (item: HTMLElement | undefined) => {
    if (!item) {
      setStatus("No unanswered todos.")
      return
    }
    lastItem = item
    item.classList.remove("is-collapsed")
    item.scrollIntoView({ block: "start" })
    headOf(item).focus({ preventScroll: true })
  }

  const nextUnanswered = () => {
    const candidates = visibleItems().filter((item) => !answerOf(item))
    const current = currentItem()
    const top = current ? current.getBoundingClientRect().top : 0
    goTo(
      candidates.find(
        (item) => item !== current && item.getBoundingClientRect().top > top,
      ) ?? candidates.find((item) => item !== current),
    )
  }

  const step = (direction: 1 | -1) => {
    const visible = visibleItems()
    const current = currentItem()
    const index = current ? visible.indexOf(current) : -1
    goTo(
      visible[
        index < 0 ? (direction > 0 ? 0 : visible.length - 1) : index + direction
      ],
    )
  }

  document.querySelector("#todo-next")!.addEventListener("click", () => {
    nextUnanswered()
  })

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement
    if (
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      document.querySelector("dialog[open]")
    )
      return
    const inField = target.closest("input, textarea, select, [contenteditable]")
    if (inField) {
      if (event.key === "Escape" && target.matches("textarea")) {
        const item = currentItem()
        if (item) headOf(item).focus({ preventScroll: true })
      }
      return
    }
    const item = currentItem()
    const pill = /^[1-5]$/.test(event.key) ? Number(event.key) : 0
    if (event.key === "j") step(1)
    else if (event.key === "k") step(-1)
    else if (event.key === "n") nextUnanswered()
    else if (event.key === "a" && item) accept(item)
    else if (event.key === "c" && item) {
      item.querySelector("textarea")!.focus()
      event.preventDefault()
    } else if (event.key === "e" && item) {
      const details = item.querySelector<HTMLDetailsElement>(".todo-details")
      if (details) details.open = !details.open
    } else if (pill && item) {
      const input = item.querySelectorAll<HTMLInputElement>(
        ".todo-action-row .todo-action input",
      )[pill - 1]
      if (!input) return
      input.checked = true
      input.dispatchEvent(new Event("change", { bubbles: true }))
    } else return
    event.preventDefault()
  })

  readFiltersFromUrl()
  applyFilters()
  collapseAnswered()

  const buildText = () => {
    const blocks: string[] = []
    let commented = 0

    for (const section of document.querySelectorAll<HTMLElement>(
      "[data-todo-section]",
    )) {
      const lines = [
        ...section.querySelectorAll<HTMLElement>(".todo-item"),
      ].flatMap((item) => {
        const comment = comments.commentOf(item)
        const checked = checkedAction(item)
        if (!comment && !checked && onlyCommented.checked) return []
        if (comment || checked) commented++
        return [
          item.dataset.todoLine!,
          ...(checked ? [`  > ${checked}`] : []),
          ...(comment
            ? comment.split("\n").map((line) => `  > ${line}`.trimEnd())
            : []),
        ]
      })
      if (lines.length)
        blocks.push(`## ${section.dataset.todoSection}`, "", ...lines, "")
    }

    return {
      commented,
      text: ["TODO.md with my comments", "", ...blocks].join("\n").trim(),
    }
  }

  const copyFallback = document.querySelector<HTMLDialogElement>(
    "[data-copy-fallback]",
  )!

  const syncScheme = (frame: HTMLIFrameElement) => {
    const root = frame.contentDocument?.documentElement
    if (!root || frame.dataset.scheme) return
    for (const scheme of ["dark", "light"])
      root.classList.toggle(
        `ui-${scheme}`,
        document.documentElement.classList.contains(`ui-${scheme}`),
      )
  }

  const frames = [
    ...document.querySelectorAll<HTMLIFrameElement>(".todo-example iframe"),
  ]

  for (const frame of frames) {
    frame.addEventListener("load", () => {
      const main = frame.contentDocument?.querySelector("main")
      if (!main) return
      syncScheme(frame)
      new ResizeObserver(() => {
        frame.style.blockSize = `${Math.ceil(main.getBoundingClientRect().height)}px`
      }).observe(main)
    })
  }

  for (const details of document.querySelectorAll<HTMLDetailsElement>(
    ".todo-examples",
  )) {
    details.addEventListener("toggle", () => {
      if (!details.open) return
      for (const frame of details.querySelectorAll<HTMLIFrameElement>(
        "iframe:not([src])",
      ))
        frame.src = frame.dataset.src!
    })
  }

  new MutationObserver(() => frames.forEach(syncScheme)).observe(
    document.documentElement,
    { attributeFilter: ["class"] },
  )

  document.querySelector("#todo-copy")!.addEventListener("click", async () => {
    const { commented, text } = buildText()
    if (onlyCommented.checked && !commented) {
      setStatus("No answers yet.")
      return
    }
    if (await copyOrSelect(text, copyFallback)) {
      setStatus(`Copied ${commented} ${commented === 1 ? "todo" : "todos"}.`)
      return
    }
    setStatus("This browser blocked copying.")
  })

  document.querySelector("#todo-clear")!.addEventListener("click", () => {
    if (!confirm("Clear all comments and actions?")) return
    comments.clear()
    for (const item of items)
      for (const input of actionsOf(item))
        input.checked = input.value === "None"
    writeActions({})
    applyFilters()
    collapseAnswered()
    setStatus("Comments and actions cleared.")
  })
</script>

<style>
  .todo-filters {
    align-items: end;
    display: grid;
    gap: var(--size-3);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin-block-end: var(--size-3);
  }

  .todo-shortcuts {
