---
import {
  Accordion,
  AccordionContent,
  AccordionSummary,
  Button,
  Checkbox,
  Chip,
  FieldGroup,
  FieldLegend,
  FieldSet,
  Radio,
  ToggleButton,
} from "opui-css/astro"
import CommentField from "../../components/Todo/CommentField.astro"
import CopyFallback from "../../components/Todo/CopyFallback.astro"
import InlineText from "../../components/Todo/InlineText.astro"
import TodoNotes from "../../components/Todo/TodoNotes.astro"
import Document from "../../layouts/Document.astro"
import {
  fixOptions,
  parseTodo,
  plainText,
  slugify,
  stressRefs,
} from "../../utils/todo"
import {
  stressPages,
  stressSlug,
  testPagesEnabled,
} from "../../utils/test-pages"
import { todoExamplesFor } from "../../utils/todo-examples"
import source from "../../../TODO.md?raw"

export function getStaticPaths() {
  if (!testPagesEnabled()) return []
  return [{ params: { index: undefined } }, { params: { index: "done" } }]
}

const showDone = Astro.params.index === "done"
const { done, sections: open } = parseTodo(source)
const sections = showDone ? done : open
const itemCount = (list: typeof done) =>
  list.reduce((total, section) => total + section.items.length, 0)
const stressExamples = Object.fromEntries(
  Object.entries(stressPages).map(([path, html]) => [
    stressSlug(path),
    new Set(
      [...html.matchAll(/data-example="([^"]+)"/g)].map(([, name]) => name),
    ),
  ]),
)

const examplesFor = (text: string) => {
  const scheme = /\bdark mode\b/i.test(text)
    ? "dark"
    : /\blight mode\b/i.test(text)
      ? "light"
      : undefined
  const query = scheme ? `scheme=${scheme}` : ""

  return [
    ...stressRefs(text)
      .filter(({ example, page }) => stressExamples[page]?.has(example))
      .map(({ example, page }) => ({
        label: `${page} ${example}`,
        scheme,
        src: `/tests/${page}/?example=${example}${query && `&${query}`}`,
      })),
    ...todoExamplesFor(text).map((name) => ({
      label: name,
      scheme,
      src: `/todo/example/${name}/${query && `?${query}`}`,
    })),
  ]
}

const todoSections = sections.map((section) => ({
  ...section,
  items: section.items.map((item) => ({
    ...item,
    ...fixOptions(item.notes),
    examples: examplesFor(item.text),
  })),
}))

const actions = [
  "None",
  "Explain further",
  "Explain further and provide an example",
  "Fix",
  "Remove issue",
]

const count = itemCount(sections)
---

<Document
  description={showDone
    ? "Check the fixed todos in TODO.md against their examples."
    : "Comment on the todos in TODO.md and copy them with your comments."}
  showToc
>
  <Fragment slot="title">{showDone ? "Done" : "TODO"}</Fragment>
  <p slot="preamble">
    {
      showDone ? (
        <a class="ui-link" href="/todo/">{`Open (${itemCount(open)})`}</a>
      ) : (
        <a class="ui-link" href="/todo/done/">{`Done (${itemCount(done)})`}</a>
      )
    }
  </p>

  {
    todoSections.map((section) => (
      <section data-todo-section={section.title}>
        <h2 id={slugify(section.title)}>{section.title}</h2>
        <ol class="todo-list ui-not-rich-text">
          {section.items.map((item, index) => (
            <li
              class="todo-item"
              data-todo-key={slugify(item.text)}
              data-todo-line={item.line}
            >
              <div class="todo-text">
                {item.severity && (
                  <Chip
                    class="todo-severity"
                    label={`Severity ${item.severity}`}
                    size="small"
                    variant="tonal"
                  />
                )}
                <span>
                  <InlineText text={item.text} />
                </span>
              </div>
              <TodoNotes notes={item.notes} />
              {item.examples.length > 0 && (
                <Accordion class="todo-examples" variant="outlined">
                  <AccordionSummary>
                    {item.examples.length === 1
                      ? "Example"
                      : `Examples (${item.examples.length})`}
                  </AccordionSummary>
                  <AccordionContent>
                    {item.examples.map((example) => (
                      <figure class="todo-example">
                        <figcaption>
                          <code>{example.label}</code>
                          <a
                            class="ui-link"
                            href={example.src}
                            rel="noopener"
                            target="_blank"
                          >
                            Open in a new tab
                          </a>
                        </figcaption>
                        <iframe
                          data-scheme={example.scheme}
                          data-src={example.src}
                          title={`${example.label} example`}
                        />
                      </figure>
                    ))}
                  </AccordionContent>
                </Accordion>
              )}
              <CommentField text={item.text} />
              <FieldSet class="todo-actions-field">
                <FieldLegend class="ui-sr-only">
                  {`Actions for: ${plainText(item.text)}`}
                </FieldLegend>
                <FieldGroup
                  class="todo-action-row"
                  direction="row"
                  name={`todo-action-${slugify(section.title)}-${index}`}
                >
                  {actions
                    .filter(
                      (action) => !item.options.length || action !== "Fix",
                    )
                    .map((action) => (
                      <ToggleButton
                        class="todo-action"
                        pressed={action === "None"}
                        size="small"
                        type="radio"
                        value={action}
                      >
                        {action}
                      </ToggleButton>
                    ))}
                </FieldGroup>
                {item.options.length > 0 && (
                  <FieldSet class="todo-fix-options">
                    <FieldLegend>{item.legend}</FieldLegend>
                    <FieldGroup
                      name={`todo-action-${slugify(section.title)}-${index}`}
                    >
                      {item.options.map((option) => (
                        <div class="todo-fix-option">
                          <Radio
                            class="todo-action"
                            size="small"
                            spread
                            value={`Fix with option ${option.id}`}
                          >
                            {option.note
                              ? `Option ${option.id} (${option.note})`
                              : `Option ${option.id}`}
                            <Fragment slot="end-text">
                              <InlineText text={option.text} />
                            </Fragment>
                          </Radio>
                          <TodoNotes notes={option.notes} />
                        </div>
                      ))}
                    </FieldGroup>
                  </FieldSet>
                )}
              </FieldSet>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <h2 id="copy">Copy</h2>

  <section class="todo-dock ui-not-rich-text">
    <div class="todo-actions">
      <p class="todo-count" id="todo-count">{`0 of ${count} answered`}</p>
      <div class="todo-buttons">
        <Button id="todo-copy" variant="filled">Copy</Button>
        <Button class="todo-more" id="todo-clear" variant="outlined">
          Clear all
        </Button>
      </div>
      <Checkbox checked class="todo-more" id="todo-only-commented">
        Only answered todos
      </Checkbox>
      <p class="todo-status" id="todo-status" role="status"></p>
      <CopyFallback label="Todos and comments" />
    </div>
  </section>
</Document>

<script>
  import { copyOrSelect, trackComments } from "../../components/Todo/comments"
  import { readStored, writeStored } from "../../utils/storage"

  const storageKey = "opui-todo-comments"
  const actionsKey = "opui-todo-actions"

  const readActions = () => readStored<Record<string, string>>(actionsKey, {})
  const writeActions = (actions: Record<string, string>) =>
    writeStored(actionsKey, actions)

  const items = [...document.querySelectorAll<HTMLElement>(".todo-item")]
  const keyOf = (item: HTMLElement) => item.dataset.todoKey!
  const actionsOf = (item: HTMLElement) => [
    ...item.querySelectorAll<HTMLInputElement>(".todo-action input"),
  ]
  const checkedAction = (item: HTMLElement) => {
    const value = actionsOf(item).find((input) => input.checked)?.value
    return value === "None" ? undefined : value
  }
  const status = document.querySelector("#todo-status")!
  const onlyCommented = document.querySelector<HTMLInputElement>(
    "#todo-only-commented",
  )!

  const notSaved = () => {
    status.textContent =
      "Comments can't be saved in this browser. Copy them before leaving the page."
  }

  const comments = trackComments({
    items,
    keyOf,
    onError: notSaved,
    storageKey,
  })

  const saveActions = (item: HTMLElement) => {
    const key = keyOf(item)
    const checked = checkedAction(item)
    const actions = readActions()
    if (checked) actions[key] = checked
    else delete actions[key]
    if (!writeActions(actions)) notSaved()
  }

  const answerCount = document.querySelector("#todo-count")!
  const countAnswered = () => {
    const answered = items.filter(
      (item) => checkedAction(item) || comments.commentOf(item),
    ).length
    answerCount.textContent = `${answered} of ${items.length} answered`
  }

  for (const item of items)
    item
      .querySelector("textarea")!
      .addEventListener("input", () => countAnswered())

  const savedActions = readActions()
  for (const item of items) {
    for (const input of actionsOf(item)) {
      input.checked = (savedActions[keyOf(item)] ?? "None") === input.value
      input.addEventListener("change", () => {
        saveActions(item)
        countAnswered()
      })
    }
  }

  countAnswered()

  const buildText = () => {
    const blocks: string[] = []
    let commented = 0

    for (const section of document.querySelectorAll<HTMLElement>(
      "[data-todo-section]",
    )) {
      const lines = [
        ...section.querySelectorAll<HTMLElement>(".todo-item"),
      ].flatMap((item) => {
        const comment = comments.commentOf(item)
        const checked = checkedAction(item)
        if (!comment && !checked && onlyCommented.checked) return []
        if (comment || checked) commented++
        return [
          item.dataset.todoLine!,
          ...(checked ? [`  > ${checked}`] : []),
          ...(comment
            ? comment.split("\n").map((line) => `  > ${line}`.trimEnd())
            : []),
        ]
      })
      if (lines.length)
        blocks.push(`## ${section.dataset.todoSection}`, "", ...lines, "")
    }

    return {
      commented,
      text: ["TODO.md with my comments", "", ...blocks].join("\n").trim(),
    }
  }

  const copyFallback = document.querySelector<HTMLElement>(
    "[data-copy-fallback]",
  )!

  const syncScheme = (frame: HTMLIFrameElement) => {
    const root = frame.contentDocument?.documentElement
    if (!root || frame.dataset.scheme) return
    for (const scheme of ["dark", "light"])
      root.classList.toggle(
        `ui-${scheme}`,
        document.documentElement.classList.contains(`ui-${scheme}`),
      )
  }

  const frames = [
    ...document.querySelectorAll<HTMLIFrameElement>(".todo-example iframe"),
  ]

  for (const frame of frames) {
    frame.addEventListener("load", () => {
      const main = frame.contentDocument?.querySelector("main")
      if (!main) return
      syncScheme(frame)
      new ResizeObserver(() => {
        frame.style.blockSize = `${Math.ceil(main.getBoundingClientRect().height)}px`
      }).observe(main)
    })
  }

  for (const details of document.querySelectorAll<HTMLDetailsElement>(
    ".todo-examples",
  )) {
    details.addEventListener("toggle", () => {
      if (!details.open) return
      for (const frame of details.querySelectorAll<HTMLIFrameElement>(
        "iframe:not([src])",
      ))
        frame.src = frame.dataset.src!
    })
  }

  new MutationObserver(() => frames.forEach(syncScheme)).observe(
    document.documentElement,
    { attributeFilter: ["class"] },
  )

  document.querySelector("#todo-copy")!.addEventListener("click", async () => {
    const { commented, text } = buildText()
    if (onlyCommented.checked && !commented) {
      status.textContent = "No answers yet."
      return
    }
    if (await copyOrSelect(text, copyFallback)) {
      status.textContent = `Copied ${commented} answered ${commented === 1 ? "todo" : "todos"}.`
      return
    }
    status.textContent =
      "This browser blocked copying. The text is selected below: press and hold it, then copy."
  })

  document.querySelector("#todo-clear")!.addEventListener("click", () => {
    if (!confirm("Clear all comments and actions?")) return
    comments.clear()
    for (const item of items)
      for (const input of actionsOf(item))
        input.checked = input.value === "None"
    writeActions({})
    countAnswered()
    status.textContent = "Comments and actions cleared."
  })
</script>

<style>
  .todo-list {
    display: grid;
    gap: var(--size-4);
    list-style: none;
    margin: 0 0 var(--size-6);
    padding: 0;
  }

  .todo-item {
    border-block-end: var(--ui-border-width) solid var(--ui-border-color);
    display: grid;
    gap: var(--size-2);
    padding-block-end: var(--size-4);
  }

  .todo-text {
    :global(.todo-severity) {
      margin-inline-end: var(--size-2);
    }
  }

  .todo-example {
    display: grid;
    gap: var(--size-2);
    margin: 0;

    & + & {
      margin-block-start: var(--size-4);
    }

    figcaption {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      gap: var(--size-2) var(--size-3);
      justify-content: space-between;
    }

    iframe {
      background-color: var(--ui-surface-default);
      block-size: var(--size-13);
      border: var(--ui-border-width) solid var(--ui-border-color);
      border-radius: var(--ui-radius);
      inline-size: 100%;
      max-block-size: 80dvb;
    }
  }

  :global(.todo-actions-field) {
    gap: var(--size-4);
  }

  :global(.todo-action-row) {
    gap: var(--size-2);
  }

  :global(
    .todo-item:has(
      input:checked:not([value="None"]),
      textarea:not(:placeholder-shown)
    )
  ) {
    border-inline-start: var(--ui-border-width-thick) solid var(--ui-primary);
    padding-inline-start: var(--size-3);
  }

  .todo-fix-option {
    border: var(--ui-border-width) solid var(--ui-border-color);
    border-radius: var(--ui-radius);
    display: grid;

    @media (hover: hover) {
      &:hover {
        background-color: var(--ui-surface-tonal-hover);
      }
    }

    &:has(:checked) {
      background-color: var(--ui-primary-tonal);
      border-color: var(--ui-primary);
    }

    :global(.ui-radio) {
      cursor: pointer;
      padding: var(--size-3);
    }

    :global(.todo-notes) {
      padding: 0 var(--size-3) var(--size-3);
    }
  }

  .todo-dock {
    bottom: 0;
    container-type: scroll-state;
    position: sticky;
    z-index: 1;
  }

  .todo-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3);
    justify-content: space-between;

    > :not(.todo-count, .todo-buttons) {
      flex-basis: 100%;
    }

    @container scroll-state(stuck: bottom) {
      background-color: var(--ui-surface-elevated);
      border-block-start: var(--ui-border-width) solid var(--ui-border-color);
      box-shadow: var(--ui-shadow-elevated);
      margin-inline: calc(-1 * var(--size-3));
      padding: var(--size-2) var(--size-3);

      :global(.todo-more),
      .todo-status:empty {
        display: none;
      }
    }
  }

  .todo-count {
    color: var(--ui-text-muted);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .todo-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-2);
  }

  .todo-status {
    color: var(--ui-text-muted);
    margin: 0;
    min-block-size: 1lh;
  }
</style>
