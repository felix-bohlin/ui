---
import "opui-css/css/imports.css"
import { Button, Checkbox, TextField } from "opui-css/astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>opui-css Astro fixture</title>
  </head>
  <body>
    <form>
      <TextField label="Name" name="name" />
      <Checkbox name="subscribe">Subscribe</Checkbox>
      <Button type="submit" variant="filled" color="primary">Save</Button>
    </form>
    <button type="button" class="ui-button" interestfor="hint">Help</button>
    <p id="hint" popover="hint">Fill in your name.</p>
  </body>
</html>
