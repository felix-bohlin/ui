---
import { ICONS, type IconName } from "reference-shared"

const { name } = Astro.props as { name: IconName }
---

<svg
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"
  viewBox="0 0 24 24"
>
  <path d={ICONS[name]}></path>
</svg>
