---
import {
  Button,
  Card,
  CardActions,
  CardContent,
  CardHeader,
  Menu,
  ToggleButton,
  ToggleGroup,
} from "opui-css/astro"
import { photo, user, type Post } from "reference-shared"
import Icon from "./Icon.astro"
import UserAvatar from "./UserAvatar.astro"

const { post } = Astro.props as { post: Post }

const author = user(post.author)!
const photos = post.photos.map((id) => photo(id)!)
---

<Card
  aria-labelledby={`post-${post.id}-author`}
  as="article"
  data-post={post.id}
  variant="outlined"
>
  <CardHeader as="header">
    <UserAvatar link user={author} />
    <hgroup>
      <h2 id={`post-${post.id}-author`}>
        <a href={`/u/${author.handle}`}>{author.name}</a>
      </h2>
      <p><time datetime={post.datetime}>{post.time}</time></p>
    </hgroup>
    <Button
      aria-label={`Options for ${author.name}'s post`}
      command="toggle-popover"
      commandfor={`post-menu-${post.id}`}
    >
      <Icon name="more" />
    </Button>
  </CardHeader>
  <Menu
    align="end"
    id={`post-menu-${post.id}`}
    items={[
      { "data-post-action": "copy", label: "Copy link" },
      {
        "data-post-action": "save",
        form: `save-post-${post.id}`,
        label: "Save post",
        type: "submit",
      },
      { "data-post-action": "hide", label: "Hide post" },
    ]}
  />
  <form data-save-post={post.id} hidden id={`save-post-${post.id}`}></form>
  <CardContent>
    <p data-post-text>{post.text}</p>
    {photos.length > 0 && <div class="app-post-photos">
      {photos.map(({ alt, src }) => (
        <img alt={alt} src={src} />
      ))}
    </div>}
  </CardContent>
  <CardActions align="start">
    <ToggleGroup
      aria-label="Reactions"
      multiple
      name={`reactions-${post.id}`}
      size="small"
    >
      {post.reactions.map((reaction) => <ToggleButton value={reaction.value}>
        {reaction.label}{" "}
        <span data-count={reaction.count}>{reaction.count}</span>
      </ToggleButton>)}
    </ToggleGroup>
  </CardActions>
</Card>
