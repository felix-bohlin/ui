---
import { Avatar } from "opui-css/astro"
import type { User } from "reference-shared"

const {
  link = false,
  size,
  user,
} = Astro.props as { link?: boolean; size?: "large" | "small"; user: User }
---

{link ? (
  user.photo ? (
    <Avatar
      alt=""
      aria-hidden="true"
      href={`/u/${user.handle}`}
      size={size}
      src={user.photo}
      tabindex={-1}
    />
  ) : (
    <Avatar
      aria-hidden="true"
      href={`/u/${user.handle}`}
      size={size}
      tabindex={-1}
    >
      {user.initials}
    </Avatar>
  )
) : user.photo ? (
  <Avatar alt="" size={size} src={user.photo} />
) : (
  <Avatar aria-hidden="true" size={size}>
    {user.initials}
  </Avatar>
)}
