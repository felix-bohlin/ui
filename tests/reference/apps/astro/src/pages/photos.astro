---
import {
  Button,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
} from "opui-css/astro"
import { PHOTOS, user } from "reference-shared"
import Icon from "../components/Icon.astro"
import Layout from "../layouts/Layout.astro"

const first = PHOTOS[0]!
const viewer = PHOTOS.map(({ alt, by, src }) => ({
  alt,
  by: user(by)!.name,
  src,
}))
---

<Layout title="Photos">
  <div class="app-screen" data-screen="photos">
    <h1>Photos</h1>
    <ul aria-label="Photos" class="app-photo-grid">
      {PHOTOS.map(({ alt, src }, at) => <li>
        <button
          class="app-photo"
          command="show-modal"
          commandfor="photo-viewer"
          data-photo={at}
          type="button"
        >
          <img alt={alt} src={src} />
        </button>
      </li>)}
    </ul>
  </div>
  <Dialog
    aria-label="Photo viewer"
    class="app-viewer"
    closedby="any"
    data-photos={JSON.stringify(viewer)}
    id="photo-viewer"
  >
    <DialogHeader closeButton>
      <p aria-live="polite" data-viewer-count>Photo 1 of {PHOTOS.length}</p>
    </DialogHeader>
    <DialogContent class="app-viewer-body">
      <img alt={first.alt} src={first.src} />
      <p data-viewer-by>By {user(first.by)!.name}</p>
    </DialogContent>
    <DialogFooter>
      <Button data-step="-1" variant="outlined">
        <Icon name="previous" />
        <span class="ui-text">Previous</span>
      </Button>
      <Button data-step="1" variant="outlined">
        <span class="ui-text">Next</span>
        <Icon name="next" />
      </Button>
    </DialogFooter>
  </Dialog>
</Layout>

<script>
  import "../scripts/photos.ts"
</script>
