---
import {
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  OneTimeCode,
  Radio,
  Select,
  Switch,
  TextField,
} from "opui-css/astro"
import Layout from "../layouts/Layout.astro"
---

<Layout title="Settings">
  <div class="app-screen" data-screen="settings">
    <h1>Settings</h1>
    <Form aria-label="Settings" data-settings>
      <Fieldset>
        <FieldLegend>Account</FieldLegend>
        <FieldGroup>
          <TextField for="settings-display-name" label="Display name">
            <input id="settings-display-name" name="name" value="Sam Rivera" />
          </TextField>
          <TextField for="settings-email" label="Email">
            <input
              id="settings-email"
              name="email"
              required
              type="email"
              value="sam@example.com"
            />
          </TextField>
          <Select
            items={[
              { label: "Deutsch", value: "de" },
              { label: "English", value: "en" },
              { label: "Svenska", value: "sv" },
            ]}
            label="Language"
            name="language"
            value="en"
          />
        </FieldGroup>
      </Fieldset>
      <Fieldset>
        <FieldLegend>Who can see your posts</FieldLegend>
        <FieldGroup name="visibility">
          <Radio value="everyone">Everyone</Radio>
          <Radio checked value="friends">Friends</Radio>
          <Radio value="only-me">Only me</Radio>
        </FieldGroup>
      </Fieldset>
      <Fieldset>
        <FieldLegend>Notifications</FieldLegend>
        <FieldGroup>
          <Switch checked name="email-notifications"
            >Email notifications</Switch
          >
          <Switch name="push-notifications">Push notifications</Switch>
        </FieldGroup>
      </Fieldset>
      <div id="settings-status" role="status"></div>
      <FieldGroup>
        <Button type="submit" variant="filled">Save</Button>
      </FieldGroup>
    </Form>

    <section aria-labelledby="two-factor-title" class="app-screen">
      <h2 id="two-factor-title">Two-factor sign-in</h2>
      <Form aria-label="Two-factor sign-in" data-two-factor>
        <OneTimeCode for="settings-code" label="Code from your app">
          <input
            aria-describedby="settings-code-end-text"
            autocomplete="one-time-code"
            id="settings-code"
            inputmode="numeric"
            maxlength="6"
            name="code"
            pattern="[0-9]{6}"
            required
          />
          <span data-code-error slot="end-text"></span>
        </OneTimeCode>
        <div data-two-factor-status role="status"></div>
        <FieldGroup>
          <Button type="submit" variant="outlined">Verify</Button>
        </FieldGroup>
      </Form>
    </section>

    <section aria-labelledby="danger-title" class="app-screen">
      <h2 id="danger-title">Danger zone</h2>
      <div>
        <Button
          color="critical"
          command="show-modal"
          commandfor="delete-account"
          variant="outlined"
          >Delete account</Button
        >
      </div>
    </section>

    <template data-success>
      <Callout severity="success">
        <CalloutIcon />
        <CalloutContent><p></p></CalloutContent>
      </Callout>
    </template>
  </div>

  <Dialog id="delete-account">
    <DialogHeader>
      <DialogTitle>Delete your account?</DialogTitle>
    </DialogHeader>
    <DialogContent>
      <p>This removes your posts and photos.</p>
    </DialogContent>
    <DialogFooter>
      <Button command="close" commandfor="delete-account">Cancel</Button>
      <Button
        color="critical"
        command="close"
        commandfor="delete-account"
        data-delete-account
        variant="filled"
        >Delete</Button
      >
    </DialogFooter>
  </Dialog>
</Layout>

<script>
  import "../scripts/settings.ts"
</script>
