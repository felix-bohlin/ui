---
layout: layout.njk
title: Settings
---
{% from "opui/index.njk" import
  Button,
  Callout,
  CalloutContent,
  CalloutIcon,
  Dialog,
  DialogContent,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  Field,
  FieldGroup,
  FieldLegend,
  Fieldset,
  Form,
  OneTimeCode,
  Radio,
  SelectButton,
  Switch
%}
<div class="app-screen" data-screen="settings">
  <h1>Settings</h1>
  {% call Form({ "aria-label": "Settings", "data-settings": true }) %}
    {% call Fieldset() %}
      {% call FieldLegend() %}Account{% endcall %}
      {% call FieldGroup() %}
        {% call Field({ for: "settings-display-name", label: "Display name" }) %}
          <input id="settings-display-name" name="name" value="Sam Rivera" />
        {% endcall %}
        {% call Field({ for: "settings-email", label: "Email" }) %}
          <input
            id="settings-email"
            name="email"
            required
            type="email"
            value="sam@example.com"
          />
        {% endcall %}
        {% call Field({ for: "settings-language", label: "Language" }) %}
          <select id="settings-language" name="language">
            {{ SelectButton() }}
            <option value="de">Deutsch</option>
            <option selected value="en">English</option>
            <option value="sv">Svenska</option>
          </select>
        {% endcall %}
      {% endcall %}
    {% endcall %}
    {% call Fieldset() %}
      {% call FieldLegend() %}Who can see your posts{% endcall %}
      {% call FieldGroup({ name: "visibility" }) %}
        {% call Radio({ value: "everyone" }) %}Everyone{% endcall %}
        {% call Radio({ checked: true, value: "friends" }) %}Friends{% endcall %}
        {% call Radio({ value: "only-me" }) %}Only me{% endcall %}
      {% endcall %}
    {% endcall %}
    {% call Fieldset() %}
      {% call FieldLegend() %}Notifications{% endcall %}
      {% call FieldGroup() %}
        {% call Switch({ checked: true, name: "email-notifications" }) %}Email notifications{% endcall %}
        {% call Switch({ name: "push-notifications" }) %}Push notifications{% endcall %}
      {% endcall %}
    {% endcall %}
    <div id="settings-status" role="status"></div>
    {% call FieldGroup() %}
      {% call Button({ type: "submit", variant: "filled" }) %}Save{% endcall %}
    {% endcall %}
  {% endcall %}

  <section aria-labelledby="two-factor-title" class="app-screen">
    <h2 id="two-factor-title">Two-factor sign-in</h2>
    {% call Form({ "aria-label": "Two-factor sign-in", "data-two-factor": true }) %}
      {% set endText %}<span data-code-error></span>{% endset %}
      {% call OneTimeCode({
        for: "settings-code",
        label: "Code from your app",
        slots: { endText: endText }
      }) %}
        <input
          aria-describedby="settings-code-end-text"
          autocomplete="one-time-code"
          id="settings-code"
          inputmode="numeric"
          maxlength="6"
          name="code"
          pattern="[0-9]{6}"
          required
        />
      {% endcall %}
      <div data-two-factor-status role="status"></div>
      {% call FieldGroup() %}
        {% call Button({ type: "submit", variant: "outlined" }) %}Verify{% endcall %}
      {% endcall %}
    {% endcall %}
  </section>

  <section aria-labelledby="danger-title" class="app-screen">
    <h2 id="danger-title">Danger zone</h2>
    <div>
      {% call Button({
        color: "critical",
        command: "show-modal",
        commandfor: "delete-account",
        variant: "outlined"
      }) %}Delete account{% endcall %}
    </div>
  </section>

  <template data-success>
    {% call Callout({ severity: "success" }) %}
      {{ CalloutIcon() }}
      {% call CalloutContent() %}<p></p>{% endcall %}
    {% endcall %}
  </template>
</div>

{% call Dialog({ id: "delete-account" }) %}
  {% call DialogHeader() %}
    {% call DialogTitle() %}Delete your account?{% endcall %}
  {% endcall %}
  {% call DialogContent() %}
    <p>This removes your posts and photos.</p>
  {% endcall %}
  {% call DialogFooter() %}
    {% call Button({ command: "close", commandfor: "delete-account" }) %}Cancel{% endcall %}
    {% call Button({
      color: "critical",
      command: "close",
      commandfor: "delete-account",
      "data-delete-account": true,
      variant: "filled"
    }) %}Delete{% endcall %}
  {% endcall %}
{% endcall %}
