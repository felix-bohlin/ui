---
import Anchor from "../../../packages/opui/components/Anchor/Anchor.astro"
import AnchorContent from "../../../packages/opui/components/Anchor/AnchorContent.astro"

const { hover } = Astro.props
---

{hover ? (
  <Anchor id="card" trigger="hover">
    <a href="/repo" interestfor="card"> Repo </a>
    <AnchorContent id="own" popover="manual"> Card </AnchorContent>
  </Anchor>
) : (
  <Anchor>
    <button popovertarget="own">Repo</button>
    <AnchorContent id="own" popover="manual"> Card </AnchorContent>
  </Anchor>
)}
