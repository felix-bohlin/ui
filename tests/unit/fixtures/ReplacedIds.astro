---
import Dialog from "../../../packages/opui/components/Dialog/Dialog.astro"
import DialogTitle from "../../../packages/opui/components/Dialog/DialogTitle.astro"
import Drawer from "../../../packages/opui/components/Drawer/Drawer.astro"
import DrawerTitle from "../../../packages/opui/components/Drawer/DrawerTitle.astro"

const { labelledby } = Astro.props
---

<Dialog aria-labelledby={labelledby}>
  <DialogTitle id="own-dialog-title">Title</DialogTitle>
</Dialog>
<Drawer aria-labelledby={labelledby} id="drawer">
  <DrawerTitle id="own-title">Title</DrawerTitle>
</Drawer>
