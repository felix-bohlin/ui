{% macro Button(props = {}) %}
  {%- set rest = props | opuiOmit(["as", "class", "color", "disabled", "href", "round", "size", "variant", "slots"]) -%}
  {%- set Tag = "a" if opui.disabledLink(props.as, props.disabled) else props.as or ("a" if props.href else "button") -%}
  <{{ Tag | opuiTag }}{{ opui.merge(
    {
      class: [
        "ui-button",
        { "ui-round": props.round },
        props.color and "ui-" ~ props.color,
        props.size and props.size != "medium" and "ui-" ~ props.size,
        props.variant and props.variant != "transparent" and "ui-" ~ props.variant,
        props.class
      ] | opuiClass
    },
    opui.tagAttrs(Tag, props.disabled, props.href),
    opui.defined(rest)
  ) | opuiAttributes(Tag) }}>
    {{ caller() if caller }}
  </{{ Tag | opuiTag }}>
{%- endmacro %}
