{% from "opui/Button.njk" import Button %}

{% macro Callout(props = {}) %}
  {%- set rest = props | opuiRest("Callout") -%}
  {%- set closeLabel = props.closeLabel | default("Close") -%}
  {%- set ids = opui.ids("callout", props.id) -%}
  {%- set root = "opui-callout" if props.closeButton else "div" -%}
  {%- set rootId = ids() if props.closeButton else props.id -%}
  {%- set classes = [
    "ui-callout",
    props.severity and "ui-" ~ props.severity,
    props.variant and props.variant != "tonal" and "ui-" ~ props.variant,
    props.class
  ] | opuiClass -%}
  <{{ root | opuiTag }}{{ opui.merge({ class: classes, id: rootId }, opui.defined(rest)) | opuiAttributes(root) }}>
    {{- opui.provide("Callout", { severity: props.severity }, caller) }}{% if props.closeButton -%}
      {% call Button({
        "aria-label": closeLabel,
        command: "--dismiss",
        commandfor: rootId,
        round: true,
        size: "small"
      }) -%}
        {% if props.slots.closeIcon != none %}{{ props.slots.closeIcon | safe }}{% else %}<svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 32 32"></svg>{% endif %}
      {%- endcall %}
    {%- endif -%}
  </{{ root | opuiTag }}>
{%- endmacro %}
