{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "exclude": ["dist", "dist-test", "tests/apps/*/**", "tests/package/fixtures"],
  "include": [
    ".astro/types.d.ts",
    "packages/opui/components/**/*.solid.tsx",
    "packages/opui/components/**/context.solid.ts",
    "packages/opui/components/solid.ts",
    "packages/opui/env.d.ts",
    "packages/opui/solid/**/*.ts",
    "src/**/*.solid.tsx",
    "src/components/Example/*solid*.ts"
  ]
}
